type tie<class>
// compiler/tdzd.tie —— tiec --compress-data 子命令：td → zd 扁平数据
// ============================================================
// 目标（specs/2026-08-31-td-data-compiler-design.md）：读取 tie:data 文件
// （type tie<data>，正文为 tie 表字面量：裸表或可选表名 `name = [...]`，无 var），
// DFS 先序平铺为平行表（kind/key/value/child_count），供编码为 zd record。
//
// 复用 config 的 tie:data 表字面量解析（config.parse_data：剥离头部 + 可选表名）。
// 自包含约束同 config：**不 import 任何 std 库**（被 driver.tie 链式引入，
// 重复 import 会让 str 命名空间重复定义导致编译失败）。
//
// 平行表行语义（行序 = DFS 先序，每节点一行）：
//   d_kinds  0=表/数组 1=字符串 2=整数/bool 3=浮点
//   d_keys   键名（无键空串；表子元素为键名，数组子元素为空串）
//   d_vi64 / d_vf64 / d_vstr   标量值（按 kind 取对应列；bool 归整数 0/1）
//   d_child  表/数组的子元素数（消费者按此推进 DFS 遍历子树）

import "./config.tie"

// ---------- 平行表（模块级全局，DFS 累积） ----------
var d_kinds: table<i64>;
var d_keys: table<string>;
var d_vi64: table<i64>;
var d_vf64: table<f64>;
var d_vstr: table<string>;
var d_child: table<i64>;
var c_err: string = "";

namespace tdzd {

// 最近一次操作的错误消息（成功时为空串）。
pub func err_msg() -> string {
    return c_err
}

// reset：清空平行表。
func reset() {
    d_kinds = table_new_i64()
    d_keys = table_new_string()
    d_vi64 = table_new_i64()
    d_vf64 = table_new_f64()
    d_vstr = table_new_string()
    d_child = table_new_i64()
    c_err = ""
}

// emit：把一行（kind/key/三值列/child）写入全局平行表。独立小函数
//（规避编译器大函数寄存器分配缺陷：大函数内多分支 + 多调用 + 多 push 会损坏值）。
func emit(kind_v: i64, key: string, vi: i64, vf: f64, vs: string, child_v: i64) {
    table_push(d_kinds, kind_v)
    table_push(d_keys, key)
    table_push(d_vi64, vi)
    table_push(d_vf64, vf)
    table_push(d_vstr, vs)
    table_push(d_child, child_v)
}

// flatten：DFS 先序平铺 config 节点 root（迭代 + 显式栈，避免递归）。
func flatten(root: i64) {
    var st_nodes = table_new_i64()
    var st_keys = table_new_string()
    // 显式栈：top = 有效元素数；push 时若有空槽则原地复用（st[top]=x），
    // 否则 append（table_push）。pop = 读 st[top-1] 后 top--。
    table_push(st_nodes, root)
    table_push(st_keys, "")
    var top: i64 = 1
    while top > 0 {
        var n = st_nodes[top - 1]
        var key = st_keys[top - 1]
        top = top - 1
        var t = config.type_of(n)
        if t == 4 {
            // 字符串
            var sv = config.str_val(n)
            emit(1, key, 0, 0.0, sv, 0)
        } else if t == 2 || t == 1 {
            // 整数 / bool（bool 归整数 0/1）
            var iv = config.int_val(n)
            emit(2, key, iv, 0.0, "", 0)
        } else if t == 3 {
            // 浮点
            var fv = config.float_val(n)
            emit(3, key, 0, fv, "", 0)
        } else if t == 5 {
            // 数组：本节点 + 各元素（无键）；逆序压栈保证先序
            var cnt = config.arr_len(n)
            emit(0, key, 0, 0.0, "", cnt)
            var i: i64 = cnt - 1
            while i >= 0 {
                var en = config.arr_at(n, i)
                if top < len(st_nodes) {
                    st_nodes[top] = en
                    st_keys[top] = ""
                } else {
                    table_push(st_nodes, en)
                    table_push(st_keys, "")
                }
                top = top + 1
                i = i - 1
            }
        } else if t == 6 {
            // 表：本节点 + 各键值对（子元素键 = 键名）；逆序压栈保证先序
            var cnt2 = config.map_len(n)
            emit(0, key, 0, 0.0, "", cnt2)
            var j: i64 = cnt2 - 1
            while j >= 0 {
                var vn = config.map_val(n, j)
                var kn = config.map_key(n, j)
                if top < len(st_nodes) {
                    st_nodes[top] = vn
                    st_keys[top] = kn
                } else {
                    table_push(st_nodes, vn)
                    table_push(st_keys, kn)
                }
                top = top + 1
                j = j - 1
            }
        } else {
            // null / 其他：空容器节点
            emit(0, key, 0, 0.0, "", 0)
        }
    }
}

// parse：解析 data 文件 → DFS 平铺填充平行表。成功 0；失败 -1（c_err 携带）。
pub func parse(path: string) -> i64 {
    reset()
    var root = config.parse_data(path)
    if root < 0 {
        c_err = config.err_msg()
        return -1
    }
    flatten(root)
    return 0
}

// ---------- 访问器（供 zd 编码 / 探针用） ----------

pub func count() -> i64 {
    return len(d_kinds)
}

pub func kind(i: i64) -> i64 {
    return d_kinds[i]
}

pub func key(i: i64) -> string {
    return d_keys[i]
}

pub func vi64(i: i64) -> i64 {
    return d_vi64[i]
}

pub func vf64(i: i64) -> f64 {
    return d_vf64[i]
}

pub func vstr(i: i64) -> string {
    return d_vstr[i]
}

pub func child(i: i64) -> i64 {
    return d_child[i]
}

// 文本摘要（调试/探针用）：逐行 `i: k=<kind> key=<键> <值> c=<child>`。
pub func brief() -> string {
    var out: string = ""
    var n = count()
    var i: i64 = 0
    while i < n {
        var line: string = to_string(i) + ": k=" + to_string(kind(i)) + " key=" + key(i)
        if kind(i) == 1 {
            line = line + " s=" + vstr(i)
        } else if kind(i) == 2 {
            line = line + " i=" + to_string(vi64(i))
        } else if kind(i) == 3 {
            line = line + " f=" + to_string(vf64(i))
        }
        line = line + " c=" + to_string(child(i))
        if i > 0 {
            out = out + "\n"
        }
        out = out + line
        i = i + 1
    }
    return out
}

}
