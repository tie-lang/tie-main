type tie<class>
// compiler/backend/irgen_expr.tie —— 生成器 L3 表达式层 子模块
// ============================================================
// 从 irgen.tie 拆分而来：这是 irgen LLVM 风格分层重构的 S4（第四步）。
// 本文件承载 L3 表达式层：表达式主调度器 tig_expr、内置原语名判定
// is_builtin_name、巨型内置表达式生成器 builtin_expr（各 tag 表达式分发 /
// 内置调用 → tie_* 桥 / libc / 内联生成）。它们被上层语句/表达式生成层
// 裸名调用，是表达式求值的核心。L6 调用分派层（tig_runtime_call 等）
// 不属于本轮，留在 irgen.tie 主文件。
//
// 拆分范式：【同 namespace 跨文件】（文本内联）。
// 同 irgen_arith.tie（S3）/ irgen_builder.tie（S1）/ irgen_lit.tie（S2）。
// irgen.tie 顶层 import 本文件后，本文件被文本内联进同一编译单元，声明与
// irgen.tie 相同的 `namespace irgen`，同名 namespace 跨文件闭合并集：
//   - 同 namespace 函数可互相裸名调用（主文件照常裸名调用 tig_expr 等）；
//   - 可访问主文件顶层全局 var（g_cur_block/g_cur_func/node_types/s_tags 等）；
//   - 本文件只含函数与注释，不含顶层全局 var 声明、不含 import——
//     全局 var 与 import 树均留在 irgen.tie 主文件，避免重复定义。
namespace irgen {
// 表达式生成：返回结果值 id；-1 错误
func tig_expr(id: i64) -> i64 {
    var tag = s_tags[id]
    if tag == 0 {
        // IntLit：按推断类型生成常量（后缀字面量 i128/u128/窄整数 → 对应
        // 类型；默认 i64）。曾固定 tig_int_lit(i64)——`1i128 << 64` 左操作数
        // 落 i64，移位生成 trunc i128 %i64 类型错（批次 2 修复）。
        var lt = node_types[id]
        if lt >= 0 && lt != types.named(TK_I64) && types.is_int(lt) {
            return tig_int_lit_ty(s_vals[id], lt)
        }
        return tig_int_lit(s_vals[id])
    }
    if tag == 1 {
        // FloatLit：f64 常量（lexeme 文本存池，llvmgen 规范化输出）
        return tig_float_lit(s_names[id])
    }
    if tag == 2 {
        // StrLit
        return tig_str_lit(s_names[id])
    }
    if tag == 3 {
        // CharLit：'a' / 转义 → i32 码点常量（对齐 Rust CharLit → i32）
        return tig_char_lit(s_names[id])
    }
    if tag == 5 {
        // TritLit：zero → i8 0（true/false 走 BoolLit + trit 上下文改写）
        return tig_trit_lit(s_vals[id])
    }
    if tag == 6 {
        // Var
        var vnid6 = interner.intern(sstate.name_str(id))
        if scope_get_global(vnid6) >= 0 {
            return tig_var_ref(vnid6)
        }
        // S2.2 命名函数提升：变量未入作用域但语义类型是 fn 类型 → 命名函数名
        // 用作函数值（生成适配器 + 构造 {null, @adapt}）。节点类型由 sinfer
        // S_N_VAR 分支登记（fn_sig 命中 → fn 类型）。
        if node_types[id] >= 0 && types.is_fn(node_types[id]) {
            var full_nm = resolve_call_name(sstate.name_str(id))
            return tig_named_fn_value(id, full_nm, node_types[id])
        }
        return tig_var_ref(vnid6)
    }
    if tag == 9 {
        // Binary
        return tig_binary(s_vals[id], sstate.child(id, 0), sstate.child(id, 1))
    }
    if tag == 10 {
        // Ternary：cond ? then : else → cond_br + phi（对齐 Rust 三块短路结构）
        return tig_ternary(id)
    }
    if tag == 11 {
        // Range：for 迭代起点/终点
        return tig_expr(sstate.child(id, 0))
    }
    if tag == 7 {
        // Call：println/print / tie 运行时桥内置 / 字符串表数学内置 / 用户函数
        var nm = sstate.name_str(id)
        if nm == "" {
        }
        if nm == "println" || nm == "print" {
            return tig_println(id, nm == "println")
        }
        // S2.2 函数值调用：调用名是 fn 类型变量（闭包字面量/函数值参数/全局 fn）
        // → 间接调用 entry(env, args...)。语义层已校验（sinfer 函数值调用分支），
        // 此处先于 struct/enum/内置/用户函数解析——fn 变量名不可能与类型/函数重名。
        var fv_nid = interner.intern(nm)
        if scope_get_global(fv_nid) >= 0 && types.is_fn(g_lookup_ty) {
            return tig_call_indirect(id, nm)
        }
        // struct 构造调用：StructName(args...) → 聚合值（优先级高于内置/用户
        // 函数解析——构造名不可能与函数/内置重名，语义层已校验）
        if is_struct_name(nm) {
            return tig_struct_construct(id, nm)
        }
        // 枚举构造调用（防御路径：旧式点号名 `EnumName.Variant(...)` 若 parser
        // 产出 Call 则在此处理；现行 parser 对枚举构造产 FieldAccess/MethodCall，
        // 见 tag 15/tag 18 分支。nm 为点号全名时只取枚举段匹配。）
        if is_enum_name(nm) {
            return tig_enum_construct(sstate.bs_find(en_keys, interner.intern(nm)), "", id, sstate.slot_off(id))
        }
        // 内置（语言底座原语 → tie_* 桥或 libc）：非用户函数。
        // 名字命中内置集后失败必须传播（-1 保留原 sm_err_msg），绝不降级为
        // 用户调用——否则内置参数内的未支持表达式会连锁成"函数 X 无签名"
        // 误导错误（历史根因：table_push(j_fvals, 0.0) 曾报 table_push 无签名）
        if is_builtin_name(nm) {
            var br = builtin_expr(nm, id)
            if br >= 0 {
                return g_builtin_res
            }
            if str_len(sm_err_msg) == 0 {
                sm_err_msg = "内置调用 '" + nm + "' 生成失败（函数 " + g_cur_fn_name + "）"
            }
            return -1
        }
        // 用户函数：裸调用名解析（当前命名空间补全）
        var full = resolve_call_name(nm)
        // Call children = [泛型槽, 实参...] → 实参从 children[slot_off] 起
        var aoff = sstate.slot_off(id)
        // 兼容旧式点号名（历史 parser 曾对 `myns.add(...)` 生成 children=[接收者,
        // 实参...]；新 parser 不再产出，防御保留 +1 语义）
        if ig_find_char(nm, ".") >= 0 {
            aoff = aoff + 1
        }
        return tig_user_call_from(full, id, aoff)
    }
    if tag == 148 {
        // P2a 调用表达式 `t[0](5)`：被调者为 fn 值表达式 → 间接调用
        return tig_call_expr(id)
    }
    if tag == 4 {
        // BoolLit → i1 常量（trit 上下文 → i8：true=1 / false=-1，对齐 Rust）
        if node_types[id] == types.named(TK_TRIT) {
            var tv: i64 = -1
            if s_vals[id] == 1 {
                tv = 1
            }
            return tig_trit_lit(tv)
        }
        return tig_bool_lit(s_vals[id])
    }
    if tag == 8 {
        // Unary：0=Neg 1=Not（driver 树无 ++/--）
        var op = s_vals[id]
        var operand = sstate.child(id, 0)
        var ov = tig_expr(operand)
        if ov < 0 {
            return -1
        }
        var oty = node_types[operand]
        if op == 2 || op == 3 || op == 4 || op == 5 {
            // 自增/自减（M4）：2=++i 3=--i 4=i++ 5=i--；操作数必须是变量
            // （语义层保证），直接读写其槽：load → add/sub 1 → store；
            // 前缀返回新值，后缀返回旧值（对齐 Rust tig_inc_dec）
            return tig_inc_dec(op, operand)
        }
        if op == 0 {
            // Neg：整数 → sub 0, x；浮点 → fsub 0.0, x（对齐 Rust fneg 语义）。
            // 立即数 0 在浮点上下文必须为 0.0（LLVM：fsub double 0, %x 非法）
            if oty == types.named(TK_TRIT) {
                // trit 取反（-1↔1，0 保持）：i8 width，sub i8 0, x（与 Not 同款
                // 平衡三值；对齐 interp eval_unary op==0 的 T_TRIT 分支）
                var tneg = ir.new_inst(g_cur_block, 1, types.named(TK_I8))  // sub i8
                ir.add_operand(tneg, 0, 2)
                ir.add_operand(tneg, ov, 0)
                return ir.get_value(tneg)
            }
            if oty == types.named(TK_F64) || oty == types.named(TK_F32) {
                var zf = tig_float_lit(interner.intern("0.0"))
                var fneg = ir.new_inst(g_cur_block, 14, types.named(TK_F64))  // fsub
                ir.add_operand(fneg, zf, 0)
                ir.add_operand(fneg, ov, 0)
                return ir.get_value(fneg)
            }
            // S1.3 A1 窄整数取负：按操作数宽度生成 sub（i8 取负 → sub i8 0, x）
            var nty = types.named(TK_I64)
            if types.is_int(oty) {
                nty = oty
            }
            var inst = ir.new_inst(g_cur_block, 1, nty)  // sub
            ir.add_operand(inst, 0, 2)
            ir.add_operand(inst, ov, 0)
            return ir.get_value(inst)
        }
        if op == 1 {
            // Not：bool → xor i1 true；trit → sub i8 0, x（取反，-1↔1，0 保持）
            if oty == types.named(TK_TRIT) {
                var tnot = ir.new_inst(g_cur_block, 1, types.named(TK_I8))  // sub i8
                ir.add_operand(tnot, 0, 2)
                ir.add_operand(tnot, ov, 0)
                return ir.get_value(tnot)
            }
            var inst = ir.new_inst(g_cur_block, 8, types.named(TK_BOOL))  // xor
            ir.add_operand(inst, ov, 0)
            ir.add_operand(inst, 1, 2)
            return ir.get_value(inst)
        }
        return -1
    }
    if tag == 18 {
        // MethodCall：命名空间函数调用（receiver 路径 + 方法名）
        return tig_method_call(id)
    }
    if tag == 13 {
        // Index：t[i] 表下标读（动态表 → tie_table_at 桥）
        return tig_index_read(id)
    }
    if tag == 14 {
        // TupleLit：元组字面量 (a, b) → 聚合值（alloca + 逐字段 store + load）
        return tig_tuple_lit(id)
    }
    if tag == 15 {
        // FieldAccess：.q / .Item1 / .0 字段访问（元组/struct）→ 地址 + GEP + load。
        // 枚举变体常量探测（EnumName.Variant 无 payload）：base 是未绑定变量且
        // 命中 en_keys → 枚举构造（仿 sinfer FieldAccess 分支，必须先于
        // tig_field_access——否则枚举名被当变量查作用域报错）
        var base_node15 = sstate.child(id, 0)
        if s_tags[base_node15] == 6 {  // Var
            var bnm15 = sstate.name_str(base_node15)
            var eidx15 = sstate.bs_find(en_keys, interner.intern(bnm15))
            if eidx15 >= 0 {
                return tig_enum_construct(eidx15, sstate.name_str(id), id, -1)
            }
        }
        return tig_field_access(id)
    }
    if tag == 12 {
        // TableLit：动态表创建（仅 var 初始化/实参场景；直接求值 → 建表）
        return tig_table_lit(id)
    }
    if tag == 131 {
        // S1.2 I1 asm!：生成 inline_asm 指令（模板池 id + 操作数方向/值对）。
        // 第一个 out 操作数 → 结果类型（call 返回值）；其余 out 第一版忽略。
        // 任务17：平台条件编译——target("arch") 标注按当前编译目标分支：
        //   无 target 标注 → 始终发射（向后兼容）；
        //   有 target 标注 → 当前目标匹配任一 → 发射；全不匹配 → 明确报错。
        var nc = sstate.nchild(id)
        // ---------- 平台条件编译判定（任务17）----------
        var has_target: bool = false
        var matched: bool = false
        var listed = ""
        var kt: i64 = 0
        while kt < nc {
            var opx = sstate.child(id, kt)
            if s_vals[opx] == 3 {
                has_target = true
                // 平台名（带引号 lexeme 池 id）→ 去引号纯文本
                var arch = interner.lookup(str_unescape_quoted(s_names[opx]))
                if str_len(listed) > 0 {
                    listed = listed + "/"
                }
                listed = listed + arch
                if asm_target_matches(arch) {
                    matched = true
                }
            }
            kt = kt + 1
        }
        if has_target && !matched {
            sm_err_line = s_lines[id]
            sm_err_col = s_cols[id]
            var cur_t = g_asm_target
            if str_len(cur_t) == 0 {
                cur_t = "（未设置）"
            }
            sm_err_msg = "asm! 平台 target(" + listed + ") 与当前编译目标 " + cur_t + " 不匹配（无目标平台分支可编译）"
            return -1
        }
        var tmpl = s_names[id]
        var out_slot: i64 = -1
        var out_ty: i64 = -1
        var k: i64 = 0
        while k < nc {
            var op0 = sstate.child(id, k)
            if s_vals[op0] == 1 {  // out
                var e0 = sstate.child(op0, 0)
                if s_tags[e0] == 6 {  // Var
                    var nid0 = interner.intern(sstate.name_str(e0))
                    if scope_get_global(nid0) >= 0 {
                        out_slot = g_lookup_alloca
                        out_ty = g_lookup_ty
                    }
                }
                break
            }
            k = k + 1
        }
        var inst = ir.new_inst(g_cur_block, 65, out_ty)  // void（-1）或 out 类型
        ir.add_operand(inst, tmpl, 0)
        k = 0
        while k < nc {
            var op = sstate.child(id, k)
            var dir = s_vals[op]
            if dir == 3 {
                // target("arch") 平台标注（任务17）：不占 asm 操作数，跳过
                k = k + 1
                continue
            }
            var e = sstate.child(op, 0)
            if dir != 1 {
                // in/inout：求值入参（类型 IMM + 值）
                var ev = tig_expr(e)
                if ev < 0 {
                    return -1
                }
                var et2 = node_types[e]
                if et2 < 0 {
                    et2 = types.named(TK_I64)
                }
                ir.add_operand(inst, dir, 2)
                ir.add_operand(inst, et2, 2)
                ir.add_operand(inst, ev, 0)
            } else {
                // out：不占参数（call 返回值承载）；第一版只支持第一个 out
                ir.add_operand(inst, dir, 2)
                ir.add_operand(inst, types.named(TK_I64), 2)
                ir.add_operand(inst, 0, 2)
            }
            k = k + 1
        }
        if out_slot >= 0 {
            // 结果写回 out 变量槽
            var st = ir.new_inst(g_cur_block, 22, -1)
            ir.add_operand(st, out_ty, 2)
            ir.add_operand(st, ir.get_value(inst), 0)
            ir.add_operand(st, out_slot, 0)
        }
        return tig_int_lit(0)  // 哑值（asm 表达式无值）
    }
    if tag == 132 {
        // S2.2 闭包字面量（N_FN_LIT）：生成入口函数 + 构造闭包值 {env, entry}
        return tig_closure_lit(id)
    }
    if tag == 133 {
        // S2.3：`expr ?` 解包（N_TRY）：Result/Option 枚举——Err/None 提前
        // return，Ok/Some 解包 payload。语义由 sinfer.infer_try_unwrap 校验。
        return tig_try(id)
    }
    if tag == S_N_RUN_ACTOR {
        // 一期并发 A4（Step3）：`run <Actor>(...)` 分配 per-actor state（含初始化
        // OS 锁/条件变量）并返回真实句柄（record 指针 i64）。Step4 起在 record 上
        // 接线程消息循环（mailbox + dispatch + 同步 RPC）。
        return tig_actor_run(id)
    }
    if tag == S_N_GUARD_GET {
        // 三期 A 组 `unsafe.get(share)` 凭据获取（§7.1.1 + unsafe-model §13.4）：
        // guard<cap> 凭据运行期无操作（门禁在编译期语义层强制），LLVM 表示 = i64
        // 占位值 0。对象绑定表达式（children[1]）若存在先求值（取其地址语义由
        // 语义层定义，此处仅保证对象表达式编译通过）。
        var bind = sstate.child(id, 1)
        if bind >= 0 {
            var bv = tig_expr(bind)
            if bv < 0 {
                return -1
            }
        }
        return tig_int_lit(0)
    }
    // 其他表达式后续扩展
    sm_err_line = s_lines[id]
    sm_err_col = s_cols[id]
    sm_err_msg = "irgen 未支持的表达式（tag=" + to_string(tag) + "，函数 " + g_cur_fn_name + "）"
    return -1
}

// 内置原语名判定（builtin_expr 支持集；与 sbuitin 语义层原语表对齐）。
// 命中即内置——调用失败传播错误，不降级为用户函数路径。
func is_builtin_name(nm: string) -> bool {
    // ---------- S1.2 unsafe 指针/内存内置 ----------
    if nm == "addr_of" || nm == "addr_of_field" || nm == "deref" || nm == "deref_write" ||
        nm == "is_null" || nm == "ptr_add" || nm == "ptr_to_int" || nm == "int_to_ptr" ||
        nm == "alloc" || nm == "free" || nm == "memcpy" || nm == "memset" ||
        nm == "slice_of" || nm == "slice_len" || nm == "slice_index" ||
        nm == "volatile_load" || nm == "volatile_store" {
        return true
    }
    // ---------- S1.3 as_* 显式数值转换族 ----------
    if nm == "as_i8" || nm == "as_i16" || nm == "as_i32" || nm == "as_i64" ||
        nm == "as_u8" || nm == "as_u16" || nm == "as_u32" || nm == "as_u64" ||
        nm == "as_f32" || nm == "as_f64" ||
        nm == "as_i128" || nm == "as_u128" {
        return true
    }
    // ---------- S1.3 checked_* 溢出检测族 ----------
    if nm == "checked_add" || nm == "checked_sub" || nm == "checked_mul" ||
        nm == "checked_div" || nm == "checked_shl" || nm == "checked_shr" ||
        nm == "checked_neg" {
        return true
    }
    if nm == "exec_code" || nm == "time_now" || nm == "get_env" || nm == "exec_output" {
        return true
    }
    if nm == "str_len" || nm == "char_code" || nm == "str_char" || nm == "str_from_code" {
        return true
    }
    // ---------- S2.1 字符串 {ptr,len} 原语 ----------
    // 二进制安全字节访问（str_byte）、UTF-8 码点解码（utf8_seq_len/utf8_char_at）、
    // StringBuilder 句柄（string_builder/sb_append/sb_append_byte/sb_build）
    if nm == "str_byte" || nm == "utf8_seq_len" || nm == "utf8_char_at" ||
        nm == "string_builder" || nm == "sb_append" || nm == "sb_append_byte" ||
        nm == "sb_build" || nm == "sb_reset" || nm == "str_sub_bytes" ||
        nm == "sso_malloc_count" || nm == "catch_panic" || nm == "cb_ptr" {
        return true
    }
    // ---------- 网络原语（P0：std/net）----------
    if nm == "net_close" || nm == "net_tcp_accept" || nm == "net_tcp_connect" ||
        nm == "net_tcp_listen" || nm == "net_tcp_recv" || nm == "net_tcp_send" ||
        nm == "net_udp_bind" || nm == "net_udp_recv" || nm == "net_udp_send" ||
        nm == "net_tcp_recv_bytes" || nm == "net_tcp_send_bytes" {
        return true
    }
    if nm == "to_string" || nm == "parse_int" || nm == "parse_float" || nm == "parse_trit" ||
        nm == "to_trit" || nm == "trit_val" {
        return true
    }
    if nm == "bitcast_f64_i64" || nm == "bitcast_i64_f64" {
        return true
    }
    if nm == "len" {
        return true
    }
    // P2b：any 拆箱转换（运行时 tag 检查；不匹配 → 运行时错误）
    // P2d：as_table_* 拆箱为元素化表（tag = 精确表类型 id，须与装箱时一致）
    if nm == "as_i64" || nm == "as_f64" || nm == "as_bool" || nm == "as_string" || nm == "as_char" ||
        nm == "as_table_i64" || nm == "as_table_string" || nm == "as_table_bool" ||
        nm == "as_table_f64" || nm == "as_table_char" || nm == "as_table_any" {
        return true
    }
    // P2c：any 运行时辅助——any_tag(x) 读 {tag,payload} 的 tag 字段
    if nm == "any_tag" {
        return true
    }
    // P2d-D3：map 高阶——map_keys(m)/map_values(m)/map_contains(m, key)
    if nm == "map_keys" || nm == "map_values" || nm == "map_contains" {
        return true
    }
    if nm == "table_new_i64" || nm == "table_new_f64" || nm == "table_new_string" || nm == "table_new_bool" {
        return true
    }
    if nm == "table_push" || nm == "table_at" || nm == "exit" {
        return true
    }
    if nm == "arg_count" || nm == "arg_string" {
        return true
    }
    if nm == "file_read" || nm == "file_write" || nm == "file_append" || nm == "file_exists" || nm == "file_delete" {
        return true
    }
    // 完整 fs 元数据（UTF-8 桥）：大小 / 类型判定
    if nm == "file_size" || nm == "file_is_dir" || nm == "file_is_file" {
        return true
    }
    if nm == "print_err" || nm == "mkdir_all" || nm == "remove_dir_all" || nm == "regex_find_all" {
        return true
    }
    if nm == "regex_match" || nm == "regex_find" || nm == "regex_replace" || nm == "regex_group" {
        return true
    }
    if nm == "sqrt" || nm == "sin" || nm == "cos" || nm == "tan" ||
        nm == "exp" || nm == "log" || nm == "floor" || nm == "ceil" || nm == "round" || nm == "pow" {
        return true
    }
    if nm == "read_line" || nm == "cwd" || nm == "list_dir" || nm == "walk_dir" ||
        nm == "byte_read" || nm == "byte_write" || nm == "byte_concat" {
        return true
    }
    if nm == "bit_read" || nm == "bit_write" {
        return true
    }
    if nm == "path_basename" || nm == "path_dirname" || nm == "path_abs" ||
        nm == "path_normalize" || nm == "path_join" {
        return true
    }
    if nm == "http_get" || nm == "http_get_file" || nm == "untar_gz" || nm == "unzip" ||
        nm == "copy_dir" || nm == "file_copy" || nm == "file_move" {
        return true
    }
    if nm == "eval" || nm == "eval_call" || nm == "set_env" {
        return true
    }
    if nm == "msg_set_lang" || nm == "msg_get_lang" || nm == "msg_register" ||
        nm == "msg_t" || nm == "msg_t_lang" {
        return true
    }
    if nm == "rand_range" {
        return true
    }
    // ---------- trm-lite 轻量执行体原语（阶段1块2：spawn/yield/collect）----------
    if nm == "spawn" || nm == "yield" || nm == "collect" || nm == "gosched" {
        return true
    }
    // ---------- channel 原语（p.6.5.7：ch_open/ch_send/ch_recv/ch_close，静态链接 trm_lite.a）----------
    if nm == "ch_open" || nm == "ch_send" || nm == "ch_recv" || nm == "ch_close" {
        return true
    }
    return false
}

// 内置表达式调用分派：返回 0 已处理（g_builtin_res 携带结果值 id）；-1 失败
// （名字已由 is_builtin_name 判定命中——本函数内 -1 一律为真失败，调用方传播）。
func builtin_expr(nm: string, id: i64) -> i64 {
    // ---------- S1.2 unsafe 指针/内存内置 ----------
    // 全部要求 unsafe 上下文（语义层 infer 已拦截安全代码调用）。
    if nm == "addr_of" {
        // addr_of(x) → 变量槽地址（ptr<变量类型>）；非变量表达式 → 求值落
        // 内存后取地址（临时 alloca）
        var arg = call_arg(id, 0)
        var at = node_types[arg]
        if at < 0 {
            sm_err_msg = "addr_of() 实参类型未知（函数 " + g_cur_fn_name + "）"
            return -1
        }
        if s_tags[arg] == 6 {  // Var
            var nid = interner.intern(sstate.name_str(arg))
            if scope_get_global(nid) >= 0 {
                g_builtin_res = g_lookup_alloca
                return 0
            }
        }
        var v = tig_expr(arg)
        if v < 0 {
            return -1
        }
        var alloca = ir.new_inst(g_cur_block, 20, at)
        ir.add_operand(alloca, at, 2)
        var ap = ir.get_value(alloca)
        var st = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(st, at, 2)
        ir.add_operand(st, v, 0)
        ir.add_operand(st, ap, 0)
        g_builtin_res = ap
        return 0
    }
    if nm == "addr_of_field" {
        // addr_of_field(obj, "field") → 聚合字段地址（agg_gep）。
        // obj 为变量（槽地址）或表达式（落内存）。字段名是字符串字面量。
        var obj = call_arg(id, 0)
        var fname_node = call_arg(id, 1)
        var agg_ty = node_types[obj]
        if agg_ty < 0 {
            sm_err_msg = "addr_of_field() 对象类型未知（函数 " + g_cur_fn_name + "）"
            return -1
        }
        var fname = ""
        if s_tags[fname_node] == 2 {  // StrLit
            var raw = interner.lookup(s_names[fname_node])
            var rn = str_len(raw)
            if rn >= 2 && str_char(raw, 0) == "\"" && str_char(raw, rn - 1) == "\"" {
                fname = str_slice(raw, 1, rn - 1)
            }
        }
        if str_len(fname) == 0 {
            sm_err_msg = "addr_of_field() 字段名必须是字符串字面量（函数 " + g_cur_fn_name + "）"
            return -1
        }
        var fidx = agg_field_index(agg_ty, fname)
        if fidx < 0 {
            sm_err_msg = "addr_of_field() 字段 '" + fname + "' 不存在（函数 " + g_cur_fn_name + "）"
            return -1
        }
        var oaddr: i64 = -1
        if s_tags[obj] == 6 {
            var nid2 = interner.intern(sstate.name_str(obj))
            if scope_get_global(nid2) >= 0 {
                oaddr = g_lookup_alloca
            }
        }
        if oaddr < 0 {
            var ov = tig_expr(obj)
            if ov < 0 {
                return -1
            }
            var alloca2 = ir.new_inst(g_cur_block, 20, agg_ty)
            ir.add_operand(alloca2, agg_ty, 2)
            oaddr = ir.get_value(alloca2)
            var st2 = ir.new_inst(g_cur_block, 22, -1)
            ir.add_operand(st2, agg_ty, 2)
            ir.add_operand(st2, ov, 0)
            ir.add_operand(st2, oaddr, 0)
        }
        var gp = ir.new_inst(g_cur_block, 27, agg_ty)  // agg_gep
        ir.add_operand(gp, oaddr, 0)
        ir.add_operand(gp, fidx, 2)
        g_builtin_res = ir.get_value(gp)
        return 0
    }
    if nm == "deref" {
        // deref(p) → load 元素类型
        var p = tig_expr(call_arg(id, 0))
        if p < 0 {
            return -1
        }
        var pt = node_types[call_arg(id, 0)]
        var et = types.table_elem(pt)
        if et < 0 {
            sm_err_msg = "deref() 实参必须是指针类型（函数 " + g_cur_fn_name + "）"
            return -1
        }
        var ld = ir.new_inst(g_cur_block, 21, et)  // load
        ir.add_operand(ld, p, 0)
        g_builtin_res = ir.get_value(ld)
        return 0
    }
    if nm == "deref_write" {
        // deref_write(p, v) → store 元素类型
        var p = tig_expr(call_arg(id, 0))
        if p < 0 {
            return -1
        }
        var pt = node_types[call_arg(id, 0)]
        var et = types.table_elem(pt)
        if et < 0 {
            sm_err_msg = "deref_write() 第 1 实参必须是指针类型（函数 " + g_cur_fn_name + "）"
            return -1
        }
        var v = tig_expr(call_arg(id, 1))
        if v < 0 {
            return -1
        }
        var vt = node_types[call_arg(id, 1)]
        if vt >= 0 && vt != et && (types.is_int(vt) || types.is_float(vt)) {
            var cv = tig_coerce(v, vt, et)
            if cv < 0 {
                return -1
            }
            v = cv
        }
        var st = ir.new_inst(g_cur_block, 22, -1)  // store
        ir.add_operand(st, et, 2)
        ir.add_operand(st, v, 0)
        ir.add_operand(st, p, 0)
        g_builtin_res = tig_int_lit(0)
        return 0
    }
    if nm == "volatile_load" {
        // volatile_load(p) → load volatile 元素类型（任务15：MMIO/硬件寄存器读，
        // 发射 volatile 标志——LLVM 保证不被优化删除/合并/重排）。
        var p = tig_expr(call_arg(id, 0))
        if p < 0 {
            return -1
        }
        var pt = node_types[call_arg(id, 0)]
        var et = types.table_elem(pt)
        if et < 0 {
            sm_err_msg = "volatile_load() 实参必须是指针类型（函数 " + g_cur_fn_name + "）"
            return -1
        }
        var vl = ir.new_inst(g_cur_block, 71, et)  // volatile_load（op 71）
        ir.add_operand(vl, p, 0)
        g_builtin_res = ir.get_value(vl)
        return 0
    }
    if nm == "volatile_store" {
        // volatile_store(p, v) → store volatile 元素类型（任务15：MMIO/硬件寄存器写，
        // volatile 标志禁止优化删除/重排/合并）。
        var p = tig_expr(call_arg(id, 0))
        if p < 0 {
            return -1
        }
        var pt = node_types[call_arg(id, 0)]
        var et = types.table_elem(pt)
        if et < 0 {
            sm_err_msg = "volatile_store() 第 1 实参必须是指针类型（函数 " + g_cur_fn_name + "）"
            return -1
        }
        var v = tig_expr(call_arg(id, 1))
        if v < 0 {
            return -1
        }
        var vt = node_types[call_arg(id, 1)]
        if vt >= 0 && vt != et && (types.is_int(vt) || types.is_float(vt)) {
            var cv = tig_coerce(v, vt, et)
            if cv < 0 {
                return -1
            }
            v = cv
        }
        var vs = ir.new_inst(g_cur_block, 72, -1)  // volatile_store（op 72）
        ir.add_operand(vs, et, 2)  // 值类型 IMM
        ir.add_operand(vs, v, 0)   // 值
        ir.add_operand(vs, p, 0)   // 地址
        g_builtin_res = tig_int_lit(0)
        return 0
    }
    if nm == "is_null" {
        // is_null(p) → icmp eq p, null（llvmgen ptr 比较自动把 0 写 null；
        // 立即数 0 必须 IMM 操作数——值 0 会被当值 id 查定义）
        var p = tig_expr(call_arg(id, 0))
        if p < 0 {
            return -1
        }
        var ic = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))
        ir.add_operand(ic, p, 0)
        ir.add_operand(ic, 0, 2)  // IMM 0（llvmgen ptr 上下文 → null）
        ir.add_operand(ic, 0, 2)  // eq
        g_builtin_res = ir.get_value(ic)
        return 0
    }
    if nm == "ptr_add" {
        // ptr_add(p, n) → p + n 元素步长（gep 单索引）
        var p = tig_expr(call_arg(id, 0))
        if p < 0 {
            return -1
        }
        var pt = node_types[call_arg(id, 0)]
        var et = types.table_elem(pt)
        if et < 0 {
            sm_err_msg = "ptr_add() 第 1 实参必须是指针类型（函数 " + g_cur_fn_name + "）"
            return -1
        }
        var n = tig_expr(call_arg(id, 1))
        if n < 0 {
            return -1
        }
        var gp = ir.new_inst(g_cur_block, 23, et)  // gep（步长 = 元素大小）
        ir.add_operand(gp, p, 0)
        ir.add_operand(gp, n, 0)
        g_builtin_res = ir.get_value(gp)
        return 0
    }
    if nm == "ptr_to_int" {
        // ptr_to_int(p) → ptrtoint i64
        var p = tig_expr(call_arg(id, 0))
        if p < 0 {
            return -1
        }
        var pi = ir.new_inst(g_cur_block, 24, types.named(TK_I64))
        ir.add_operand(pi, p, 0)
        g_builtin_res = ir.get_value(pi)
        return 0
    }
    if nm == "int_to_ptr" {
        // int_to_ptr(i) → inttoptr ptr（字节指针 ptr<u8>）
        var i = tig_expr(call_arg(id, 0))
        if i < 0 {
            return -1
        }
        var ip = ir.new_inst(g_cur_block, 25, types.named(TK_STR))  // inttoptr → ptr
        ir.add_operand(ip, i, 0)
        g_builtin_res = ir.get_value(ip)
        return 0
    }
    if nm == "alloc" {
        // alloc(n) → 原始字节缓冲（ptr<u8>，LLVM ptr 直传）。
        // 修复（漏洞 A 类隐患）：裸 malloc 若标 TK_STR，llvmgen op36 会对它做
        // 字符串补头扫描（strlen + tie_sso_alloc + memcpy）——对**未初始化**
        // 堆缓冲 strlen 读的是垃圾，返回缓冲实际容量 = 垃圾长度：小则 4096 字节
        // 写入越界（SSO 静态池/堆损坏，多会话交错读写出现字节串线/丢失），
        // 大则扫描越界读未映射内存崩溃。故走 s21_raw_alloc_str（K_PTR 返回绕开
        // 扫描，ptrtoint+inttoptr 包回 TK_STR 值），与编译器内部原始分配同范式。
        var n = tig_expr(call_arg(id, 0))
        if n < 0 {
            return -1
        }
        g_builtin_res = s21_raw_alloc_str(n)
        return 0
    }
    if nm == "free" {
        // free(p) → libc free
        var p = tig_expr(call_arg(id, 0))
        if p < 0 {
            return -1
        }
        tig_ext_call1("free", p, types.named(TK_STR), -1)
        g_builtin_res = tig_int_lit(0)
        return 0
    }
    if nm == "memcpy" {
        // memcpy(dst, src, n) → libc @memcpy(ptr, ptr, i64)
        // 走 extern_call + extern_decl 映射（模块头不重复 declare）。
        // 曾用 llvm.memcpy.p0.p0.i64 内在：user_extern_decl 按调用签名重建
        // 声明 → 与模块头 4 参声明重复 → opt 报「invalid redefinition」。
        var dst = tig_expr(call_arg(id, 0))
        if dst < 0 {
            return -1
        }
        var src = tig_expr(call_arg(id, 1))
        if src < 0 {
            return -1
        }
        var n = tig_expr(call_arg(id, 2))
        if n < 0 {
            return -1
        }
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, types.named(TK_STR))
        table_push(avs, dst)
        table_push(ats, types.named(TK_STR))
        table_push(avs, src)
        table_push(ats, types.named(TK_I64))
        table_push(avs, n)
        tig_ext_call_typed("memcpy", ats, avs, -1)
        g_builtin_res = tig_int_lit(0)
        return 0
    }
    if nm == "memset" {
        // memset(p, val, n) → libc @memset(ptr, i8, i64)
        var p = tig_expr(call_arg(id, 0))
        if p < 0 {
            return -1
        }
        var val = tig_expr(call_arg(id, 1))
        if val < 0 {
            return -1
        }
        var n = tig_expr(call_arg(id, 2))
        if n < 0 {
            return -1
        }
        var val8 = s21_trunc_i8(val)  // val 为 i64 → trunc i8（@memset 第二参 i8）
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, types.named(TK_STR))
        table_push(avs, p)
        table_push(ats, types.named(TK_I8))
        table_push(avs, val8)
        table_push(ats, types.named(TK_I64))
        table_push(avs, n)
        tig_ext_call_typed("memset", ats, avs, -1)
        g_builtin_res = tig_int_lit(0)
        return 0
    }
    if nm == "slice_of" {
        // slice_of(obj, start, len) → slice<元素类型> 聚合：指针 + 长度。
        // 字符串路径：数据指针直接 + len（第一版）。
        // 动态表路径（任务16）：表 → 连续内存切片——alloc 连续缓冲 + 逐元素
        // tie_table_at_* 拷贝（全 .tie，无新增 Rust 桥；运行时表数据区在桥内）。
        var arr = call_arg(id, 0)
        var at2 = node_types[arr]
        if types.is_table(at2) {
            // ---------- 动态表 → 连续内存切片（任务16）----------
            // 元素类型：table_elem（typed table<T>）→ var_table_elem（table_new_i64
            // 等语义登记，裸 table 无元素信息）→ i64 兜底。
            var etab: i64 = types.named(TK_I64)
            var te2 = types.table_elem(at2)
            if te2 >= 0 {
                etab = te2
            } else if s_tags[arr] == 6 {
                var te3 = sinfer.var_table_elem(intern.intern(sstate.name_str(arr)))
                if te3 >= 0 {
                    etab = te3
                }
            }
            var tb = tig_expr(arr)
            if tb < 0 {
                return -1
            }
            var start = tig_expr(call_arg(id, 1))
            if start < 0 {
                return -1
            }
            var cnt = tig_expr(call_arg(id, 2))
            if cnt < 0 {
                return -1
            }
            // 分配连续缓冲：cnt * elem_size 字节（malloc 返回 ptr<u8>）
            var esz = elem_size(etab)
            var esz_v = tig_int_lit_ty(esz, types.named(TK_I64))
            var m = ir.new_inst(g_cur_block, 2, types.named(TK_I64))  // mul
            ir.add_operand(m, esz_v, 0)
            ir.add_operand(m, cnt, 0)
            var buf = s21_raw_alloc_str(ir.get_value(m))  // 原始缓冲：绕开 TK_STR 补头扫描（漏洞 A 类）
            // LLVM opaque ptr：malloc 结果 ptr 直接用于 gep（元素类型 = ins_ty，
            // 步长按 etab）；无需 bitcast。
            var bp = buf
            var suffix = bridge_suffix(etab)
            var ret_ty: i64 = types.named(TK_I64)
            if suffix == "string" {
                ret_ty = types.named(TK_STR)
            } else if suffix == "f64" {
                ret_ty = types.named(TK_F64)
            } else if suffix == "bool" {
                ret_ty = types.named(TK_BOOL)
            }
            // 运行时循环（cnt/start 是运行期值，不能用编译期展开）：计数器 i
            // alloca 0..cnt，body 每次迭代 tie_table_at 读 + 写连续缓冲。
            var i_a = ir.new_inst(g_cur_block, 20, types.named(TK_I64))  // alloca i64
            ir.add_operand(i_a, types.named(TK_I64), 2)
            var i_ptr = ir.get_value(i_a)
            var i_zero = tig_int_lit_ty(0, types.named(TK_I64))
            var st0 = ir.new_inst(g_cur_block, 22, -1)  // store 0 → i
            ir.add_operand(st0, types.named(TK_I64), 2)
            ir.add_operand(st0, i_zero, 0)
            ir.add_operand(st0, i_ptr, 0)
            var cond_blk = ir.new_block(g_cur_func, interner.intern("slc.cond"))
            var body_blk = ir.new_block(g_cur_func, interner.intern("slc.body"))
            var step_blk = ir.new_block(g_cur_func, interner.intern("slc.step"))
            var exit_blk = ir.new_block(g_cur_func, interner.intern("slc.exit"))
            var b0 = ir.new_inst(g_cur_block, 30, -1)  // br cond
            ir.add_operand(b0, cond_blk, 1)
            // cond 块：i < cnt → body，否则 exit
            g_cur_block = cond_blk
            var cur = ir.new_inst(g_cur_block, 21, types.named(TK_I64))  // load i
            ir.add_operand(cur, i_ptr, 0)
            var cur_v = ir.get_value(cur)
            var cnd = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))  // icmp slt
            ir.add_operand(cnd, cur_v, 0)
            ir.add_operand(cnd, cnt, 0)
            ir.add_operand(cnd, 2, 2)  // slt
            var cb = ir.new_inst(g_cur_block, 31, -1)  // cond_br
            ir.add_operand(cb, ir.get_value(cnd), 0)
            ir.add_operand(cb, body_blk, 1)
            ir.add_operand(cb, exit_blk, 1)
            // body 块：idx = start + i；读表元素；写缓冲 buf + i 元素步长
            g_cur_block = body_blk
            var cur2 = ir.new_inst(g_cur_block, 21, types.named(TK_I64))  // load i
            ir.add_operand(cur2, i_ptr, 0)
            var i_v = ir.get_value(cur2)
            var idx = ir.new_inst(g_cur_block, 0, types.named(TK_I64))  // add start + i
            ir.add_operand(idx, start, 0)
            ir.add_operand(idx, i_v, 0)
            var ok_slot = ir.new_inst(g_cur_block, 20, types.named(TK_I8))  // alloca i8
            ir.add_operand(ok_slot, types.named(TK_I8), 2)
            var val = s21_table_at(tb, ir.get_value(idx), ir.get_value(ok_slot), ret_ty)
            if val < 0 {
                return -1
            }
            // 写缓冲：buf + i 元素步长（gep 单索引，i 为运行期值）
            var gp = ir.new_inst(g_cur_block, 23, etab)
            ir.add_operand(gp, bp, 0)
            ir.add_operand(gp, i_v, 0)
            var st = ir.new_inst(g_cur_block, 22, -1)  // store
            ir.add_operand(st, etab, 2)
            ir.add_operand(st, val, 0)
            ir.add_operand(st, ir.get_value(gp), 0)
            var bb = ir.new_inst(g_cur_block, 30, -1)  // br step
            ir.add_operand(bb, step_blk, 1)
            // step 块：i += 1
            g_cur_block = step_blk
            var cur3 = ir.new_inst(g_cur_block, 21, types.named(TK_I64))  // load i
            ir.add_operand(cur3, i_ptr, 0)
            var i3 = ir.get_value(cur3)
            var one = tig_int_lit_ty(1, types.named(TK_I64))
            var inc = ir.new_inst(g_cur_block, 0, types.named(TK_I64))  // add i + 1
            ir.add_operand(inc, i3, 0)
            ir.add_operand(inc, one, 0)
            var st2 = ir.new_inst(g_cur_block, 22, -1)  // store i+1 → i
            ir.add_operand(st2, types.named(TK_I64), 2)
            ir.add_operand(st2, ir.get_value(inc), 0)
            ir.add_operand(st2, i_ptr, 0)
            var sb = ir.new_inst(g_cur_block, 30, -1)  // br cond
            ir.add_operand(sb, cond_blk, 1)
            // exit 块
            g_cur_block = exit_blk
            g_builtin_res = make_slice2(buf, cnt, etab)
            return 0
        }
        if at2 != TK_STR {
            sm_err_msg = "slice_of() 第一版只支持字符串或动态表（函数 " + g_cur_fn_name + "）"
            return -1
        }
        var et: i64 = types.named(TK_U8)
        var pv: i64 = -1
        if s_tags[arr] == 6 {
            var nid3 = interner.intern(sstate.name_str(arr))
            if scope_get_global(nid3) >= 0 {
                pv = g_lookup_alloca
            }
        }
        if pv < 0 {
            pv = tig_expr(arr)
            if pv < 0 {
                return -1
            }
            // 字符串字面量（const_str = i64 指针整数）→ inttoptr 转 ptr
            if s_tags[arr] == 2 {
                var ip = ir.new_inst(g_cur_block, 25, types.named(TK_STR))
                ir.add_operand(ip, pv, 0)
                pv = ir.get_value(ip)
            }
        }
        var start = tig_expr(call_arg(id, 1))
        if start < 0 {
            return -1
        }
        var cnt = tig_expr(call_arg(id, 2))
        if cnt < 0 {
            return -1
        }
        // 基址 + start 元素步长（u8 → 字节偏移）
        var gp2 = ir.new_inst(g_cur_block, 23, et)
        ir.add_operand(gp2, pv, 0)
        ir.add_operand(gp2, start, 0)
        var base = ir.get_value(gp2)
        g_builtin_res = make_slice2(base, cnt, et)
        return 0
    }
    if nm == "slice_len" {
        var s = tig_expr(call_arg(id, 0))
        if s < 0 {
            return -1
        }
        g_builtin_res = slice_field(s, 1)  // 长度字段
        return 0
    }
    if nm == "slice_index" {
        // slice_index(s, i) → s[i]：gep 元素步长 + load
        var s = tig_expr(call_arg(id, 0))
        if s < 0 {
            return -1
        }
        var st_ty = node_types[call_arg(id, 0)]
        var et = types.table_elem(st_ty)
        if et < 0 {
            sm_err_msg = "slice_index() 实参必须是切片类型（函数 " + g_cur_fn_name + "）"
            return -1
        }
        var i = tig_expr(call_arg(id, 1))
        if i < 0 {
            return -1
        }
        var sp = slice_field(s, 0)  // 指针字段
        var gp3 = ir.new_inst(g_cur_block, 23, et)
        ir.add_operand(gp3, sp, 0)
        ir.add_operand(gp3, i, 0)
        var ld2 = ir.new_inst(g_cur_block, 21, et)
        ir.add_operand(ld2, ir.get_value(gp3), 0)
        g_builtin_res = ir.get_value(ld2)
        return 0
    }
    // ---------- S1.3 as_* 显式数值转换族 ----------
    // as_i8/as_i16/as_i32/as_i64/as_u8/as_u16/as_u32/as_u64/as_f32/as_f64：
    // 任意数字 → 目标类型（数值转换：截断/饱和由 LLVM 指令映射——trunc/sext/
    // zext/fptosi/sitofp/fpext/fptrunc）。语义层已校验参数为数字。
    var as_dst: i64 = -1
    if nm == "as_i8" {
        as_dst = types.named(TK_I8)
    } else if nm == "as_i16" {
        as_dst = types.named(TK_I16)
    } else if nm == "as_i32" {
        as_dst = types.named(TK_I32)
    } else if nm == "as_i64" {
        as_dst = types.named(TK_I64)
    } else if nm == "as_u8" {
        as_dst = types.named(TK_U8)
    } else if nm == "as_u16" {
        as_dst = types.named(TK_U16)
    } else if nm == "as_u32" {
        as_dst = types.named(TK_U32)
    } else if nm == "as_u64" {
        as_dst = types.named(TK_U64)
    } else if nm == "as_f32" {
        as_dst = types.named(TK_F32)
    } else if nm == "as_f64" {
        as_dst = types.named(TK_F64)
    } else if nm == "as_i128" {
        as_dst = types.named(TK_I128)
    } else if nm == "as_u128" {
        as_dst = types.named(TK_U128)
    }
    if as_dst >= 0 {
        var av = tig_expr(call_arg(id, 0))
        if av < 0 {
            return -1
        }
        var at = node_types[call_arg(id, 0)]
        // P2b：as_i64/as_f64 重载——参数是 any → 拆箱（运行时 tag 检查，
        // 不匹配 → 运行时错误）；数字 → 下方数值转换
        if at == types.named(TK_ANY) {
            var ux = tig_unbox_any(av, as_dst, nm)
            if ux < 0 {
                return -1
            }
            g_builtin_res = ux
            return 0
        }
        if at >= 0 && at != as_dst && (types.is_int(at) || types.is_float(at)) {
            var cv = tig_coerce(av, at, as_dst)
            if cv < 0 {
                return -1
            }
            g_builtin_res = cv
        } else {
            g_builtin_res = av
        }
        return 0
    }
    // ---------- S1.3 checked_* 溢出检测族 ----------
    if nm == "checked_add" || nm == "checked_sub" || nm == "checked_mul" ||
        nm == "checked_div" || nm == "checked_shl" || nm == "checked_shr" ||
        nm == "checked_neg" {
        var cv2 = tig_checked(nm, id)
        if cv2 < 0 {
            return -1
        }
        g_builtin_res = cv2
        return 0
    }
    if nm == "exec_code" {
        // runtime.a 退役：内联到 libc system（返回 i64，RAX 零扩展保证同旧 tie_exec_code）
        var cv = tig_expr(call_arg(id, 0))
        if cv < 0 {
            return -1
        }
        g_builtin_res = tig_ext_call1("system", cv, types.named(TK_STR), types.named(TK_I64))
        return 0
    }
    if nm == "time_now" {
        // runtime.a 退役：内联到 libc time(0)（0 = NULL，返回 Unix 秒数）
        g_builtin_res = tig_ext_call1("time", tig_int_lit(0), types.named(TK_I64), types.named(TK_I64))
        return 0
    }
    if nm == "get_env" {
        // runtime.a 退役：内联到 libc getenv（返回 char* → 自动补头为 tie 串）
        var gv = tig_expr(call_arg(id, 0))
        if gv < 0 {
            return -1
        }
        g_builtin_res = tig_ext_call1("getenv", gv, types.named(TK_STR), types.named(TK_STR))
        return 0
    }
    if nm == "exec_output" {
        // p.6.4.6：内联 CreatePipe+CreateProcessW+ReadFile 捕获子进程 stdout（零 Rust 桥）。
        // 不再经 tig_runtime_call（g_used_interp 桥）→ 不置位，不链接 tie_interp.lib。
        var ev = tig_expr(call_arg(id, 0))
        if ev < 0 {
            return -1
        }
        g_builtin_res = tig_exec_output_inline(ev)
        return 0
    }
    if nm == "str_len" {
        // 去 Rust 桥（dev33 批次3 关联）：码点计数改为纯 tie 内联——
        // 复用 s21_utf8_seq_len 步进循环累加（等价 tie_str_len），不再链接
        // tie_interp.lib。返回码点数。
        var v = tig_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        // 计数槽（i64）：初值 0；字节位置槽：初值 0
        var cnt_a = ir.new_inst(g_cur_block, 20, types.named(TK_I64))
        ir.add_operand(cnt_a, types.named(TK_I64), 2)
        var cnt_ptr = ir.get_value(cnt_a)
        var pos_a = ir.new_inst(g_cur_block, 20, types.named(TK_I64))
        ir.add_operand(pos_a, types.named(TK_I64), 2)
        var pos_ptr = ir.get_value(pos_a)
        var zlit = tig_int_lit_ty(0, types.named(TK_I64))
        var st0 = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(st0, types.named(TK_I64), 2)
        ir.add_operand(st0, zlit, 0)
        ir.add_operand(st0, cnt_ptr, 0)
        var st0b = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(st0b, types.named(TK_I64), 2)
        ir.add_operand(st0b, zlit, 0)
        ir.add_operand(st0b, pos_ptr, 0)
        // 四块：cond / body / step / exit
        var cond_blk = ir.new_block(g_cur_func, interner.intern("sl.cond"))
        var body_blk = ir.new_block(g_cur_func, interner.intern("sl.body"))
        var step_blk = ir.new_block(g_cur_func, interner.intern("sl.step"))
        var exit_blk = ir.new_block(g_cur_func, interner.intern("sl.exit"))
        var b0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(b0, cond_blk, 1)
        // cond：pos < byte_len(s) → body，否则 exit
        g_cur_block = cond_blk
        var cur = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
        ir.add_operand(cur, pos_ptr, 0)
        var cur_v = ir.get_value(cur)
        var blen = s21_str_head_len(v)
        var ol = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))
        ir.add_operand(ol, cur_v, 0)
        ir.add_operand(ol, blen, 0)
        ir.add_operand(ol, 6, 2)  // ult
        var ol_v = ir.get_value(ol)
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, ol_v, 0)
        ir.add_operand(cb, body_blk, 1)
        ir.add_operand(cb, exit_blk, 1)
        // body：cnt = cnt + 1；pos += utf8_seq_len(s, pos)
        g_cur_block = body_blk
        var curc = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
        ir.add_operand(curc, cnt_ptr, 0)
        var curc_v = ir.get_value(curc)
        var inc = s21_bin(0, curc_v, tig_int_lit(1))
        var stc = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(stc, types.named(TK_I64), 2)
        ir.add_operand(stc, inc, 0)
        ir.add_operand(stc, cnt_ptr, 0)
        var cur2 = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
        ir.add_operand(cur2, pos_ptr, 0)
        var cur2_v = ir.get_value(cur2)
        var sl = s21_utf8_seq_len(v, cur2_v)
        var np = s21_bin(0, cur2_v, sl)
        var stp = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(stp, types.named(TK_I64), 2)
        ir.add_operand(stp, np, 0)
        ir.add_operand(stp, pos_ptr, 0)
        var bbr = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bbr, step_blk, 1)
        // step → cond（空 step，跳回 cond 即可；此处直接 br cond）
        g_cur_block = step_blk
        var sb2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(sb2, cond_blk, 1)
        // exit：结果 = cnt
        g_cur_block = exit_blk
        var ld = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
        ir.add_operand(ld, cnt_ptr, 0)
        g_builtin_res = ir.get_value(ld)
        return 0
    }
    if nm == "char_code" {
        // 去 Rust 桥（dev33 批次3 关联）：单字符 → 码点，用已内联的
        // s21_utf8_char_at(字符, 0)（等价 tie_char_code，纯 tie 生成，不再
        // 链接 tie_interp.lib）。语义：UTF-8 解码单字符首码点 = 该码点。
        var v = tig_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        var zlit = tig_int_lit_ty(0, types.named(TK_I64))
        g_builtin_res = s21_utf8_char_at(v, zlit)
        return 0
    }
    if nm == "str_char" {
        // 去 Rust 桥：取第 i 个码点字符，irgen 内联生成——字节位置循环跳过
        // i 个码点（s21_utf8_seq_len 步进）→ s21_utf8_char_at 解码码点 →
        // s21_codepoint_to_str 得单字符。不链接 tie_interp.lib。
        // p6.x 缺陷根治：字节定位循环原仅以 k < i 终止，无 pos 边界检查——
        // 调用方以 len(s)（字节数，O(1) 读头）为上界遍历含多字节 UTF-8
        // （中文等码点 < 字节）的串时，i 会超过实际码点数，pos 越过串尾
        // 继续读（s21_utf8_seq_len/s21_str_byte 越界 GEP+load → 0xC0000005，
        // jcc-pack extract 崩溃根因）。修复：cond 增补 pos < blen 终止，
        // 定位失败（pos >= blen）返回空串而非越界读。
        var v = tig_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        var i = tig_expr(call_arg(id, 1))
        if i < 0 {
            return -1
        }
        var blen = s21_str_head_len(v)
        // 位置槽（字节 pos）与步进计数器槽（已跳码点数）
        var pos_a = ir.new_inst(g_cur_block, 20, types.named(TK_I64))
        ir.add_operand(pos_a, types.named(TK_I64), 2)
        var pos_ptr = ir.get_value(pos_a)
        var k_a = ir.new_inst(g_cur_block, 20, types.named(TK_I64))
        ir.add_operand(k_a, types.named(TK_I64), 2)
        var k_ptr = ir.get_value(k_a)
        var zlit = tig_int_lit_ty(0, types.named(TK_I64))
        var stp = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(stp, types.named(TK_I64), 2)
        ir.add_operand(stp, zlit, 0)
        ir.add_operand(stp, pos_ptr, 0)
        var stk = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(stk, types.named(TK_I64), 2)
        ir.add_operand(stk, zlit, 0)
        ir.add_operand(stk, k_ptr, 0)
        // 五块：cond / body / exit 判定（after）/ ok / bad / merge
        // cond：k < i 且 pos < blen → body；否则 → after
        // after：pos < blen（定位到第 i 个码点）→ ok 解码；否则 → bad 空串
        var cond_blk = ir.new_block(g_cur_func, interner.intern("sc.cond"))
        var body_blk = ir.new_block(g_cur_func, interner.intern("sc.body"))
        var after_blk = ir.new_block(g_cur_func, interner.intern("sc.after"))
        var ok_blk = ir.new_block(g_cur_func, interner.intern("sc.ok"))
        var bad_blk = ir.new_block(g_cur_func, interner.intern("sc.bad"))
        var merge_blk = ir.new_block(g_cur_func, interner.intern("sc.merge"))
        var res_a = ir.new_inst(g_cur_block, 20, types.named(TK_STR))
        ir.add_operand(res_a, types.named(TK_STR), 2)
        var res_ptr = ir.get_value(res_a)
        var b0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(b0, cond_blk, 1)
        // cond：k < i 且 pos < blen → body，否则 after
        g_cur_block = cond_blk
        var ku = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
        ir.add_operand(ku, k_ptr, 0)
        var ku_v = ir.get_value(ku)
        var ok = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))  // icmp
        ir.add_operand(ok, ku_v, 0)
        ir.add_operand(ok, i, 0)
        ir.add_operand(ok, 2, 2)  // slt
        var ok_v = ir.get_value(ok)
        var pu = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
        ir.add_operand(pu, pos_ptr, 0)
        var pu_v = ir.get_value(pu)
        var inb = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))  // icmp
        ir.add_operand(inb, pu_v, 0)
        ir.add_operand(inb, blen, 0)
        ir.add_operand(inb, 6, 2)  // ult
        var inb_v = ir.get_value(inb)
        var both = tig_and_i1(ok_v, inb_v)
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, both, 0)
        ir.add_operand(cb, body_blk, 1)
        ir.add_operand(cb, after_blk, 1)
        // body：pos += utf8_seq_len(s, pos)；k += 1
        g_cur_block = body_blk
        var pu2 = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
        ir.add_operand(pu2, pos_ptr, 0)
        var pu2_v = ir.get_value(pu2)
        var sl = s21_utf8_seq_len(v, pu2_v)
        var np = s21_bin(0, pu2_v, sl)  // add
        var stp2 = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(stp2, types.named(TK_I64), 2)
        ir.add_operand(stp2, np, 0)
        ir.add_operand(stp2, pos_ptr, 0)
        var ku2 = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
        ir.add_operand(ku2, k_ptr, 0)
        var ku2_v = ir.get_value(ku2)
        var nk = s21_bin(0, ku2_v, tig_int_lit(1))
        var stk2 = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(stk2, types.named(TK_I64), 2)
        ir.add_operand(stk2, nk, 0)
        ir.add_operand(stk2, k_ptr, 0)
        var bbr = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bbr, cond_blk, 1)
        // after：pos < blen → ok（定位成功，解码），否则 bad（空串）
        g_cur_block = after_blk
        var pu3 = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
        ir.add_operand(pu3, pos_ptr, 0)
        var pu3_v = ir.get_value(pu3)
        var inb2 = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))  // icmp
        ir.add_operand(inb2, pu3_v, 0)
        ir.add_operand(inb2, blen, 0)
        ir.add_operand(inb2, 6, 2)  // ult
        var inb2_v = ir.get_value(inb2)
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, inb2_v, 0)
        ir.add_operand(cb2, ok_blk, 1)
        ir.add_operand(cb2, bad_blk, 1)
        // bad：定位失败（pos 越过串尾仍未到第 i 个码点）→ 空串
        g_cur_block = bad_blk
        var empty = tig_str_lit(interner.intern("\"\""))
        var stb = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(stb, types.named(TK_STR), 2)
        ir.add_operand(stb, empty, 0)
        ir.add_operand(stb, res_ptr, 0)
        var brb = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brb, merge_blk, 1)
        // ok：解码 pos 处码点 → 单字符字符串
        g_cur_block = ok_blk
        var pz = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
        ir.add_operand(pz, pos_ptr, 0)
        var pz_v = ir.get_value(pz)
        var cp = s21_utf8_char_at(v, pz_v)
        var cps = s21_codepoint_to_str(cp)
        var sto = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(sto, types.named(TK_STR), 2)
        ir.add_operand(sto, cps, 0)
        ir.add_operand(sto, res_ptr, 0)
        var bro = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bro, merge_blk, 1)
        // merge：结果 = res 槽
        g_cur_block = merge_blk
        g_builtin_res = s21_load(res_ptr, types.named(TK_STR))
        return 0
    }
    if nm == "str_from_code" {
        // 去 Rust 桥：码点 → 单字符 UTF-8 字符串，改 irgen 内联生成
        // s21_codepoint_to_str（纯 tie 内联，不链接 tie_interp.lib）。
        var v = tig_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        // 窄整数（trit/char/i8/i16/i32 等）先 sext 到 i64（s21 编码期望 i64）
        var vt = node_types[call_arg(id, 0)]
        var sv = v
        if vt >= 0 && vt != types.named(TK_I64) && vt != types.named(TK_U64) {
            var se = tig_sext(v, vt, types.named(TK_I64))
            if se < 0 {
                return -1
            }
            sv = se
        }
        g_builtin_res = s21_codepoint_to_str(sv)
        return 0
    }
    // ---------- S2.1 字符串 {ptr,len} 原语 ----------
    // 二进制安全字节访问 / UTF-8 码点解码 / StringBuilder（实现见文件尾 s21_* 组）。
    if nm == "str_byte" {
        // str_byte(s, i)：取第 i 字节（0 ≤ i < len(s)；越界未定义——调用方保证）
        var v = tig_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        var i = tig_expr(call_arg(id, 1))
        if i < 0 {
            return -1
        }
        g_builtin_res = s21_str_byte(v, i)
        return 0
    }
    if nm == "utf8_seq_len" {
        // utf8_seq_len(s, i)：字节 i 起的 UTF-8 序列长度（1-4，按首字节判定）
        var v = tig_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        var i = tig_expr(call_arg(id, 1))
        if i < 0 {
            return -1
        }
        g_builtin_res = s21_utf8_seq_len(v, i)
        return 0
    }
    if nm == "utf8_char_at" {
        // utf8_char_at(s, i)：字节 i 起的 UTF-8 码点值（分支按序列长度解码）
        var v = tig_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        var i = tig_expr(call_arg(id, 1))
        if i < 0 {
            return -1
        }
        g_builtin_res = s21_utf8_char_at(v, i)
        return 0
    }
    // SSO 短串池回退 malloc 累计次数（dev33 批次3 验收探针用：断言 = 0）
    if nm == "sso_malloc_count" {
        llvmgen.sso_enable()
        var cnt_id = interner.intern("@s21_sso_malloc_cnt")
        var ldc = ir.new_inst(g_cur_block, 21, types.named(TK_I64))  // load
        ir.add_operand(ldc, cnt_id, 3)  // OK_GLOBAL → @s21_sso_malloc_cnt
        g_builtin_res = ir.get_value(ldc)
        return 0
    }
    // 可捕获 panic（dev33 批次7 任务18）：catch_panic(f) -> bool
    if nm == "catch_panic" {
        var r = tig_catch_panic(id)
        if r < 0 {
            return -1
        }
        return 0
    }
    // 闭包 → C 回调函数指针（dev33 批次8 任务23）：cb_ptr(f) -> string
    if nm == "cb_ptr" {
        var r2 = tig_cb_ptr(id)
        if r2 < 0 {
            return -1
        }
        return 0
    }
    if nm == "string_builder" {
        // string_builder()：新建 StringBuilder 句柄（i64；两级指针 {cap,len,data}）
        g_builtin_res = s21_sb_new()
        return 0
    }
    if nm == "sb_append" {
        // sb_append(h, s)：原地追加字符串（容量不足自动倍增重分配）；返回 0
        var h = tig_expr(call_arg(id, 0))
        if h < 0 {
            return -1
        }
        var v = tig_expr(call_arg(id, 1))
        if v < 0 {
            return -1
        }
        s21_sb_append(h, v)
        g_builtin_res = tig_int_lit(0)
        return 0
    }
    if nm == "sb_append_byte" {
        // sb_append_byte(h, b)：原地追加单字节（0-255，二进制安全含 \0）；返回 0
        var h = tig_expr(call_arg(id, 0))
        if h < 0 {
            return -1
        }
        var b = tig_expr(call_arg(id, 1))
        if b < 0 {
            return -1
        }
        s21_sb_append_byte(h, b)
        g_builtin_res = tig_int_lit(0)
        return 0
    }
    if nm == "sb_build" {
        // sb_build(h)：一次性产出 string（{头, 数据, \0}；句柄仍有效可复用）
        var h = tig_expr(call_arg(id, 0))
        if h < 0 {
            return -1
        }
        g_builtin_res = s21_sb_build(h)
        return 0
    }
    if nm == "sb_reset" {
        // sb_reset(h)：清空复用（len=0，cap/data 缓冲保留；build 后续写必须 reset）
        var h = tig_expr(call_arg(id, 0))
        if h < 0 {
            return -1
        }
        g_builtin_res = s21_sb_reset(h)
        return 0
    }
    if nm == "str_sub_bytes" {
        // str_sub_bytes(s, lo, hi)：字节区间子串 [lo, hi)（clamp 越界；
        // 配合码点→字节偏移表实现 lexeme 切片零重扫）
        var v = tig_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        var lo = tig_expr(call_arg(id, 1))
        if lo < 0 {
            return -1
        }
        var hi = tig_expr(call_arg(id, 2))
        if hi < 0 {
            return -1
        }
        g_builtin_res = s21_str_sub_bytes(v, lo, hi)
        return 0
    }
    // ---------- 网络原语（P0：std/net）----------
    // 参数签名：i=整数（窄整数 sext 到 i64）、s=字符串（ptr 直传）；桥符号 tie_<name>；
    // net_close 返回 i8→bool（icmp ne），两个 recv 返回堆串（tig_stmt 统一 free），其余 i64。
    if nm == "net_close" || nm == "net_tcp_accept" || nm == "net_tcp_connect" ||
        nm == "net_tcp_listen" || nm == "net_tcp_recv" || nm == "net_tcp_send" ||
        nm == "net_udp_bind" || nm == "net_udp_recv" || nm == "net_udp_send" ||
        nm == "net_tcp_recv_bytes" || nm == "net_tcp_send_bytes" {
        // p.6.4.5：net_* 全部内联 Winsock2 直调（去 Rust 桥 tie_net_*）。
        // 置位 g_used_wsock → driver 链 ws2_32（详见 tig_net_* helper）。
        g_used_wsock = true
        if nm == "net_close" {
            // 单参句柄 → closesocket（0=成功）→ bool
            var h = tig_expr(call_arg(id, 0))
            if h < 0 {
                return -1
            }
            var ht = node_types[call_arg(id, 0)]
            if ht != types.named(TK_I64) && ht != types.named(TK_U64) && ht >= 0 {
                var sh = tig_sext(h, ht, types.named(TK_I64))
                if sh < 0 {
                    return -1
                }
                h = sh
            }
            g_builtin_res = tig_net_close(h)
            return 0
        }
        // 通用参值提取：i 整数（窄 sext→i64）、s 串/表（ptr 直传）
        var pat: table<string> = table_new_string()
        if nm == "net_udp_send" {
            table_push(pat, "i")
            table_push(pat, "s")
            table_push(pat, "i")
            table_push(pat, "s")
        } else if nm == "net_tcp_connect" {
            table_push(pat, "s")
            table_push(pat, "i")
        } else if nm == "net_tcp_send" || nm == "net_tcp_send_bytes" {
            table_push(pat, "i")
            table_push(pat, "s")
        } else if nm == "net_tcp_recv" || nm == "net_udp_recv" ||
            nm == "net_tcp_recv_bytes" {
            table_push(pat, "i")
            table_push(pat, "i")
        } else {
            // listen/accept/udp_bind：单 i 参（句柄/端口）
            table_push(pat, "i")
        }
        var avs: table<i64> = table_new_i64()
        var k: i64 = 0
        while k < len(pat) {
            var a = call_arg(id, k)
            var v = tig_expr(a)
            if v < 0 {
                return -1
            }
            if pat[k] == "i" {
                var vt = node_types[a]
                if vt != types.named(TK_I64) && vt != types.named(TK_U64) && vt >= 0 {
                    var sv = tig_sext(v, vt, types.named(TK_I64))
                    if sv < 0 {
                        return -1
                    }
                    v = sv
                }
            }
            table_push(avs, v)
            k = k + 1
        }
        // 按原语分派内联实现
        if nm == "net_tcp_listen" {
            g_builtin_res = tig_net_tcp_listen(avs[0])
        } else if nm == "net_tcp_accept" {
            g_builtin_res = tig_net_tcp_accept(avs[0])
        } else if nm == "net_tcp_connect" {
            g_builtin_res = tig_net_tcp_connect(avs[0], avs[1])
        } else if nm == "net_tcp_send" {
            g_builtin_res = tig_net_tcp_send(avs[0], avs[1])
        } else if nm == "net_tcp_recv" {
            g_builtin_res = tig_net_tcp_recv(avs[0], avs[1])
        } else if nm == "net_tcp_send_bytes" {
            g_builtin_res = tig_net_tcp_send_bytes(avs[0], avs[1])
        } else if nm == "net_tcp_recv_bytes" {
            g_builtin_res = tig_net_tcp_recv_bytes(avs[0], avs[1])
        } else if nm == "net_udp_bind" {
            g_builtin_res = tig_net_udp_bind(avs[0])
        } else if nm == "net_udp_send" {
            g_builtin_res = tig_net_udp_send(avs[0], avs[1], avs[2], avs[3])
        } else if nm == "net_udp_recv" {
            g_builtin_res = tig_net_udp_recv(avs[0], avs[1])
        } else {
            g_builtin_res = tig_net_close(avs[0])
        }
        return 0
    }
    if nm == "to_string" {
        var v = tig_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        // 实参类型：f64 → 用 i128 内联除数换成「浮点暂保留 Rust 桥」见下；
        // i64/u64 → tig_i64_to_str（去 Rust）；窄整数 sext → i64 后再内联。
        var vt = node_types[call_arg(id, 0)]
        if vt == types.named(TK_F64) || vt == types.named(TK_F32) {
            // p.6.4.4：去 Rust 桥（tie_to_string_f64）→ 内联 tig_f64_to_str
            //（CRT snprintf "%.17g" → 带头串；Rust 最短表示差异可接受）。
            var fv = v
            if vt == types.named(TK_F32) {
                fv = tig_coerce(v, types.named(TK_F32), types.named(TK_F64))  // fpext → f64
            }
            g_builtin_res = tig_f64_to_str(fv)
        } else if vt == types.named(TK_I128) || vt == types.named(TK_U128) {
            // 批次 2（i128/u128）：内联除法循环生成十进制串
            g_builtin_res = tig_i128_to_str(v, vt == types.named(TK_I128))
        } else if vt == types.named(TK_I64) {
            g_builtin_res = tig_i64_to_str(v, true)
        } else if vt == types.named(TK_U64) {
            g_builtin_res = tig_i64_to_str(v, false)
        } else if vt < 0 {
            g_builtin_res = tig_i64_to_str(v, false)
        } else {
            // 窄类型（trit/char/i8/i16/i32/u8/u16/u32 等）：sext → i64
            var sv = tig_sext(v, vt, types.named(TK_I64))
            if sv < 0 {
                return -1
            }
            g_builtin_res = tig_i64_to_str(sv, true)
        }
        return 0
    }
    if nm == "parse_int" {
        // 去 Rust 桥（批次A）：tig_parse_int 内联 IR 生成（字节循环累加），
        // 替代 Rust 桥 tie_parse_int。签名 (s, ok 出参槽) -> i64。不再置 g_used_interp。
        var v = tig_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        var pio = ir.new_inst(g_cur_block, 20, types.named(TK_I8))  // alloca i8 ok
        ir.add_operand(pio, types.named(TK_I8), 2)
        g_builtin_res = tig_parse_int(v, ir.get_value(pio))
        return 0
    }
    if nm == "parse_float" {
        // p.6.4.4：去 Rust 桥（tie_parse_float）→ 内联 tig_parse_float IR（字节循环
        // 十进制解析 + libm pow 指数缩放，有限精度）。签名 (s, ok 出参槽) -> f64。
        // 不再置 g_used_interp。
        var v = tig_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        var pfo = ir.new_inst(g_cur_block, 20, types.named(TK_I8))  // alloca i8
        ir.add_operand(pfo, types.named(TK_I8), 2)
        g_builtin_res = tig_parse_float(v, ir.get_value(pfo))
        return 0
    }
    if nm == "parse_trit" {
        // 去 Rust 桥（批次A）：tig_parse_trit 内联 IR 生成，替代桥 tie_parse_trit。
        // 返回 i8（值域 -1/0/1，语义类型标 TK_TRIT）。不再置 g_used_interp。
        var v = tig_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        var pto = ir.new_inst(g_cur_block, 20, types.named(TK_I8))  // alloca i8
        ir.add_operand(pto, types.named(TK_I8), 2)
        g_builtin_res = tig_parse_trit(v, ir.get_value(pto))
        return 0
    }
    if nm == "to_trit" {
        // i64 → 饱和钳制 trit（i8，值域 -1/0/1；对齐 interp_bin clamp_trit）：
        // lt = x< -1 → -1；gt = x>1 → 1；否则 x。clamp 后 trunc i8。
        var v = tig_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        var T64 = types.named(TK_I64)
        var lt = tig_icmp_c(v, tig_int_lit(-1), 2)          // x < -1 (slt)
        var c1 = tig_select_i(lt, tig_int_lit(-1), v, T64)  // c1 = clamp 下界
        var gt = tig_icmp_c(c1, tig_int_lit(1), 3)          // x > 1 (sgt)
        var c2 = tig_select_i(gt, tig_int_lit(1), c1, T64)  // c2 ∈ [-1,1]
        g_builtin_res = s21_trunc_i8(c2)                    // i64 → i8 trit
        return 0
    }
    if nm == "trit_val" {
        // trit（i8）→ i64：sext 符号扩展（-1/0/1 → i64）
        var v = tig_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        g_builtin_res = tig_sext(v, types.named(TK_I8), types.named(TK_I64))
        return 0
    }
    if nm == "len" {
        // S2.1：len(表) → tie_table_len；len(字符串) → 读 {ptr,len} 长度头（O(1)，
        // 不再 strlen 扫描——字符串值统一带头部（字面量 .rodata 头 / str_cat 头 /
        // 桥返回自动补头 / StringBuilder build 头）。行为与旧 strlen 一致（字节数）。
        var a = call_arg(id, 0)
        var at = node_types[a]
        if at == types.named(TK_STR) {
            // 字符串：读 ptr-8 的 i64 长度头（S2.1）
            var v = tig_expr(a)
            if v < 0 {
                return -1
            }
            g_builtin_res = s21_str_head_len(v)
            return 0
        }
        var v2 = tig_expr(a)
        if v2 < 0 {
            return -1
        }
        g_builtin_res = s21_table_len(v2)
        return 0
    }
    // P2b：any 拆箱（as_bool/as_string/as_char——仅 any 参数；as_i64/as_f64
    // 已在上方 as_dst 块重载处理）。P2d：as_table_* 拆箱为对应元素类型表
    //（返回表值 ptr，tag = 精确表类型 id，与装箱时的 tag 一致才匹配）。
    if nm == "as_bool" || nm == "as_string" || nm == "as_char" ||
        nm == "as_table_i64" || nm == "as_table_string" || nm == "as_table_bool" ||
        nm == "as_table_f64" || nm == "as_table_char" || nm == "as_table_any" {
        var a0 = call_arg(id, 0)
        var av = tig_expr(a0)
        if av < 0 {
            return -1
        }
        var rty: i64 = types.named(TK_I64)
        if nm == "as_f64" {
            rty = types.named(TK_F64)
        } else if nm == "as_bool" {
            rty = types.named(TK_BOOL)
        } else if nm == "as_string" {
            rty = types.named(TK_STR)
        } else if nm == "as_char" {
            rty = types.named(TK_CHAR)
        } else if nm == "as_table_i64" {
            rty = types.table_of(types.named(TK_I64))
        } else if nm == "as_table_string" {
            rty = types.table_of(types.named(TK_STR))
        } else if nm == "as_table_bool" {
            rty = types.table_of(types.named(TK_BOOL))
        } else if nm == "as_table_f64" {
            rty = types.table_of(types.named(TK_F64))
        } else if nm == "as_table_char" {
            rty = types.table_of(types.named(TK_CHAR))
        } else if nm == "as_table_any" {
            rty = types.table_of(types.named(TK_ANY))
        }
        var ux = tig_unbox_any(av, rty, nm)
        if ux < 0 {
            return -1
        }
        g_builtin_res = ux
        return 0
    }
    // P2c：any_tag(x) → 读 {tag,payload} 的 tag 字段（标量 0-4 / 复合类型 id）
    if nm == "any_tag" {
        var a1 = call_arg(id, 0)
        var av1 = tig_expr(a1)
        if av1 < 0 {
            return -1
        }
        var any_ty6 = types.named(TK_ANY)
        var slot6 = ir.new_inst(g_cur_block, 20, any_ty6)
        ir.add_operand(slot6, any_ty6, 2)
        var sp6 = ir.get_value(slot6)
        var st6 = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(st6, any_ty6, 2)
        ir.add_operand(st6, av1, 0)
        ir.add_operand(st6, sp6, 0)
        var g6 = ir.new_inst(g_cur_block, 27, any_ty6)
        ir.add_operand(g6, sp6, 0)
        ir.add_operand(g6, 0, 2)
        var ld6 = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
        ir.add_operand(ld6, ir.get_value(g6), 0)
        g_builtin_res = ir.get_value(ld6)
        return 0
    }
    // P2d-D3：map 高阶——map_keys(m)→table<string>；map_values(m)→table<V>
    //（V 从实参 map<string,V> 类型解码）；map_contains(m, key)→bool（不 raise）
    if nm == "map_keys" || nm == "map_values" {
        var m0 = call_arg(id, 0)
        var mv = tig_expr(m0)
        if mv < 0 {
            return -1
        }
        var m_vty: i64 = types.named(TK_I64)
        if nm == "map_values" {
            var m_arg_ty = node_types[m0]
            if types.is_map(m_arg_ty) {
                var lv = types.low(m_arg_ty)
                if lv > 0 {
                    m_vty = lv
                }
            }
        }
        g_builtin_res = s21_map_extract(mv, m_vty, nm == "map_keys")
        return 0
    }
    if nm == "map_contains" {
        var m1 = tig_expr(call_arg(id, 0))
        if m1 < 0 {
            return -1
        }
        var k1 = tig_expr(call_arg(id, 1))
        if k1 < 0 {
            return -1
        }
        g_builtin_res = s21_map_contains(m1, k1)
        return 0
    }
    if nm == "table_new_i64" || nm == "table_new_f64" || nm == "table_new_string" || nm == "table_new_bool" {
        var elem: i64 = types.named(TK_I64)
        if nm == "table_new_string" {
            elem = types.named(TK_STR)
        } else if nm == "table_new_bool" {
            elem = types.named(TK_BOOL)
        } else if nm == "table_new_f64" {
            elem = types.named(TK_F64)
        }
        var esz_v = tig_int_lit_ty(elem_size(elem), types.named(TK_I64))
        g_builtin_res = s21_table_new(esz_v)
        return 0
    }
    if nm == "table_push" {
        // 第 1 参数 = 表变量（语义已保证）；元素类型查 lv_telem/gb_telem
        var tname_node = call_arg(id, 0)
        var tname = sstate.name_str(tname_node)
        var elem: i64 = types.named(TK_I64)
        // 优先 irgen 作用域完整类型（table_new_f64() 初始化的变量 scope 里是
        // table_of(f64) → 元素 f64）。var_table_elem 是语义层每函数重置的，
        // irgen 阶段只可靠查到最后一次登记——跨函数场景（parse_series 里
        // push parse_float 结果）会误判为 i64 导致 push_i64(double) 类型错
        var te: i64 = -1
        var tnid = interner.intern(tname)
        var tv_own = tblvar_get(tnid)
        if tv_own >= 0 {
            te = tv_own  // irgen 自维护登记（最可靠）
        } else if scope_get(tnid) >= 0 && types.is_table(g_lookup_ty) {
            var le = types.table_elem(g_lookup_ty)
            if le > 0 {
                te = le
            }
        }
        if te < 0 {
            te = sinfer.var_table_elem(tnid)
        }

        if te >= 0 {
            elem = te
        }
        var t = tig_expr(tname_node)
        if t < 0 {
            return -1
        }
        var x = tig_expr(call_arg(id, 1))
        if x < 0 {
            return -1
        }
        // 桥选择：按**值**的实际类型判定（嵌套表/字符串值 → push_string 存 ptr；
        // 浮点值 → push_f64；曾按声明元素类型选桥——parse_series 把 parse_float
        // 结果 push 进 i64 表会 push_i64(double) 类型错，Rust 按值类型选桥）
        var suffix = bridge_suffix(elem)
        var pty = types.named(TK_I64)
        var vt = node_types[call_arg(id, 1)]
        var ek = types.kind(elem)
        if ek == K_STRUCT || ek == K_ENUM || ek == K_FN || elem == types.named(TK_ANY) {
            // P2a/P2b 复合元素：槽类型 = 元素类型 id（多字元素类型化 store）
            pty = elem
        } else if vt >= 0 && (types.is_table(vt) || types.is_map(vt) || vt == types.named(TK_STR)) {
            suffix = "string"
            pty = types.named(TK_STR)
        } else if vt >= 0 && (vt == types.named(TK_F64) || vt == types.named(TK_F32)) {
            suffix = "f64"
            pty = types.named(TK_F64)
        } else if suffix == "string" {
            pty = types.named(TK_STR)
        } else if suffix == "bool" {
            pty = types.named(TK_BOOL)
        }
        if pty == types.named(TK_ANY) {
            // P2b 异构元素装箱：推入值 → any {tag, payload}
            var vt4 = node_types[call_arg(id, 1)]
            if vt4 >= 0 && vt4 != types.named(TK_ANY) {
                var bx = tig_box_any(x, vt4)
                if bx < 0 {
                    return -1
                }
                x = bx
            }
        }
        s21_table_push(t, pty, x)
        g_builtin_res = tig_int_lit(0)  // void 结果：哑值（调用方丢弃）
        return 0
    }
    if nm == "exit" {
        // 去 Rust 桥（dev33 批次3 关联）：exit 是 libc 符号（tig_ext_call1 经
        // is_libc 不置 interp），原误置 g_used_interp 把纯 libc 程序也拉进
        // tie_interp.lib。移除——link_exe 的 prefer_interp=false 时仅链 runtime.a。
        var v = tig_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        // C 运行时 exit() 自带 stdio flush，无需显式 fflush
        tig_ext_call1("exit", v, types.named(TK_I64), -1)
        g_builtin_res = tig_int_lit(0)  // exit 不返回：哑值
        return 0
    }
    if nm == "arg_count" {
        // p.6.4.1：内联 CommandLineToArgvW（shell32，非 interp 桥）
        g_builtin_res = tig_arg_count()
        return 0
    }
    if nm == "arg_string" {
        var i = tig_expr(call_arg(id, 0))
        if i < 0 {
            return -1
        }
        g_builtin_res = tig_arg_string(i)
        return 0
    }
    if nm == "file_read" {
        var p = tig_expr(call_arg(id, 0))
        if p < 0 {
            return -1
        }
        g_builtin_res = tig_read_file(p)
        return 0
    }
    if nm == "file_write" || nm == "file_append" {
        var p = tig_expr(call_arg(id, 0))
        if p < 0 {
            return -1
        }
        var c = tig_expr(call_arg(id, 1))
        if c < 0 {
            return -1
        }
        g_builtin_res = tig_write_file(p, c, nm == "file_append")
        return 0
    }
    if nm == "file_size" {
        var p = tig_expr(call_arg(id, 0))
        if p < 0 {
            return -1
        }
        g_builtin_res = tig_size_inline(p)
        return 0
    }
    if nm == "file_is_dir" || nm == "file_is_file" {
        var p = tig_expr(call_arg(id, 0))
        if p < 0 {
            return -1
        }
        if nm == "file_is_dir" {
            g_builtin_res = tig_is_dir_inline(p)
        } else {
            g_builtin_res = tig_is_file_inline(p)
        }
        return 0
    }
    if nm == "file_exists" {
        var p = tig_expr(call_arg(id, 0))
        if p < 0 {
            return -1
        }
        g_builtin_res = tig_exists_inline(p)
        return 0
    }
    if nm == "file_delete" {
        var p = tig_expr(call_arg(id, 0))
        if p < 0 {
            return -1
        }
        g_builtin_res = tig_delete_inline(p)
        return 0
    }
    if nm == "print_err" {
        var v = tig_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        tig_print_err(v)  // CRT _write fd=2（p.6.4.1，零 Rust 桥）
        g_builtin_res = tig_int_lit(0)  // void：哑值
        return 0
    }
    if nm == "mkdir_all" {
        var p = tig_expr(call_arg(id, 0))
        if p < 0 {
            return -1
        }
        g_builtin_res = tig_mkdir_all(p)
        return 0
    }
    if nm == "regex_find_all" {
        // p.6.4.8：内联纯 tie 最小正则引擎（不再经 Rust tie_interp 桥）
        return tig_regex_find_all(id)
    }
    // ---------- M4/M6 补齐：系统能力内置（对齐 Rust ir.rs 同名单分支）----------
    // 数学库（libm，llvmgen 无条件 declare；f64 → f64）。
    // 整数实参（sqrt(4)）→ sitofp 提升为 f64（LLVM 类型必须匹配）
    if nm == "sqrt" || nm == "sin" || nm == "cos" || nm == "tan" ||
        nm == "exp" || nm == "log" || nm == "floor" || nm == "ceil" || nm == "round" {
        var mv = tig_expr(call_arg(id, 0))
        if mv < 0 {
            return -1
        }
        var mvt = node_types[call_arg(id, 0)]
        var mf = tig_to_f64(mv, mvt)
        if mf < 0 {
            return -1
        }
        g_builtin_res = tig_ext_call1(nm, mf, types.named(TK_F64), types.named(TK_F64))
        return 0
    }
    // f64↔i64 位重解释（bitcast opcode 26，同宽 64 位直读；zd v2 §4.2）。
    // 操作数 [0]=源类型 IMM，[1]=值；目标类型 = ins_ty。
    if nm == "bitcast_f64_i64" || nm == "bitcast_i64_f64" {
        var bv = tig_expr(call_arg(id, 0))
        if bv < 0 {
            return -1
        }
        var dst_ty: i64 = types.named(TK_F64)
        var src_ty: i64 = types.named(TK_I64)
        if nm == "bitcast_f64_i64" {
            dst_ty = types.named(TK_I64)
            src_ty = types.named(TK_F64)
        }
        var bc = ir.new_inst(g_cur_block, 26, dst_ty)
        ir.add_operand(bc, src_ty, 2)  // 源类型 IMM
        ir.add_operand(bc, bv, 0)
        g_builtin_res = ir.get_value(bc)
        return 0
    }
    if nm == "pow" {
        var pv1 = tig_expr(call_arg(id, 0))
        if pv1 < 0 {
            return -1
        }
        var pv2 = tig_expr(call_arg(id, 1))
        if pv2 < 0 {
            return -1
        }
        var p1t = node_types[call_arg(id, 0)]
        var p2t = node_types[call_arg(id, 1)]
        var pf1 = tig_to_f64(pv1, p1t)
        var pf2 = tig_to_f64(pv2, p2t)
        if pf1 < 0 || pf2 < 0 {
            return -1
        }
        g_builtin_res = tig_ext_call2("pow", pf1, types.named(TK_F64), pf2, types.named(TK_F64), types.named(TK_F64))
        return 0
    }
    // read_line：零参数 → string（p.6.4.10 内联 GetStdHandle(STD_INPUT_HANDLE) +
    // ReadFile 逐字节读到 \n/EOF，去 Rust 桥 tie_read_line，**不置 g_used_interp**。
    // 支持无缓冲管道（脚本交互）：`echo hello | probe` 读到 "hello"；\r\n 规整、
    // \n 去除；EOF（管道关闭 / Ctrl-Z）返回已收集串或空串。
    if nm == "read_line" {
        g_builtin_res = tig_read_line()
        return 0
    }
    if nm == "cwd" {
        // p.6.4.1：内联 GetCurrentDirectoryW + UTF-16→UTF-8（非 interp 桥）
        g_builtin_res = tig_cwd()
        return 0
    }
    // 单字符串参数 → ptr 返回（previously list_dir/walk_dir 亦走此处；现已内联）；
    // path_*/http_get/msg_t 仍走 tie_* 桥（path_* 留待 p.6.4.10，http 属 p.6.4.9）
    if nm == "list_dir" || nm == "walk_dir" {
        var sv = tig_expr(call_arg(id, 0))
        if sv < 0 {
            return -1
        }
        if nm == "list_dir" {
            g_builtin_res = tig_list_dir(sv)
        } else {
            g_builtin_res = tig_walk_dir(sv)
        }
        return 0
    }
    if nm == "http_get" {
        // p.6.4.9：http_get 内联 HTTP/1.1（去 Rust 桥 tie_http_get）——URL 解析 +
        // 连接 + GET + 读响应体；仅 http://，失败返回空串。置位 g_used_wsock。
        g_used_wsock = true
        var sv = tig_expr(call_arg(id, 0))
        if sv < 0 {
            return -1
        }
        g_builtin_res = tig_http_get(sv)
        return 0
    }
    // path_* 原语：p.6.4.10 内联纯 tie IR 生成（tig_path_*，见 irgen_path.tie），
    // 去 Rust tie_path_* 桥，不再置 g_used_interp（p.6.4 残留桥清零）。
    if nm == "path_basename" {
        return tig_path_basename(id)
    }
    if nm == "path_dirname" {
        return tig_path_dirname(id)
    }
    if nm == "path_abs" {
        return tig_path_abs(id)
    }
    if nm == "path_normalize" {
        return tig_path_normalize(id)
    }
    if nm == "eval" {
        // p.6.4.10：eval 降级——tie:script 解释器未内嵌（完整实现=内嵌解释器，
        // 工作量巨大，留待 p.6.6 后补）。保留签名但语义降级：返回空串，**不置
        // g_used_interp**（不再经 tie_eval_expr Rust 桥，不链 tie_interp.lib）。
        // 原语义（docs/tie-script.md：eval 注册模块顶层定义）在纯 tie 解释器
        // compiler/interp（interp.eval）中已实现；builtin eval/eval_call 仅被
        // examples/script_demo.tie / repl/repl.tie（demo）使用。
        g_builtin_res = tig_str_lit(interner.intern("\"\""))
        return 0
    }
    // 双字符串参数 → ptr 返回（path_join：p.6.4.10 仍留 tie_path_join Rust 桥，
    // path_* 系列待后续去桥；eval_call：p.6.4.10 降级不置 g_used_interp）
    if nm == "eval_call" {
        // p.6.4.10：eval_call 降级——同 eval（tie:script 解释器未内嵌，留待
        // p.6.6 后补）。保留签名但返回空串，**不置 g_used_interp**（去 tie_eval_call
        // Rust 桥，不链 tie_interp.lib）。原语义见 docs/tie-script.md。
        g_builtin_res = tig_str_lit(interner.intern("\"\""))
        return 0
    }
    // path_join：p.6.4.10 内联纯 tie IR 生成（同 basename/dirname 系列）
    if nm == "path_join" {
        return tig_path_join(id)
    }
    // regex_find：p.6.4.8 内联纯 tie 最小正则引擎
    if nm == "regex_find" {
        return tig_regex_find(id)
    }
    // regex_replace：p.6.4.8 内联纯 tie 最小正则引擎
    if nm == "regex_replace" {
        return tig_regex_replace(id)
    }
    // regex_group：p.6.4.8 内联纯 tie 最小正则引擎
    if nm == "regex_group" {
        return tig_regex_group(id)
    }
    // regex_match：p.6.4.8 内联纯 tie 最小正则引擎
    if nm == "regex_match" {
        return tig_regex_match(id)
    }
    // 单字符串参数 i8 返回 → bool（file_exists 已有；remove_dir_all/mkdir_all 已有
    // mkdir_all；此处补 remove_dir_all）
    if nm == "remove_dir_all" {
        var rv = tig_expr(call_arg(id, 0))
        if rv < 0 {
            return -1
        }
        g_builtin_res = tig_remove_dir_all(rv)
        return 0
    }
    // file_copy/file_move/copy_dir：内联 CopyFileW/MoveFileW/SHFileOperationW
    if nm == "file_copy" || nm == "file_move" || nm == "copy_dir" {
        var f1 = tig_expr(call_arg(id, 0))
        if f1 < 0 {
            return -1
        }
        var f2 = tig_expr(call_arg(id, 1))
        if f2 < 0 {
            return -1
        }
        if nm == "file_copy" {
            g_builtin_res = tig_copy_file(f1, f2)
        } else if nm == "file_move" {
            g_builtin_res = tig_move_file(f1, f2)
        } else {
            g_builtin_res = tig_copy_dir(f1, f2)
        }
        return 0
    }
    // 双字符串参数 i8 返回 → bool（untar_gz/unzip/http_get_file：p.6.4.9 内联，
    // 不再走 tie_* 桥）
    if nm == "untar_gz" || nm == "unzip" || nm == "http_get_file" {
        var f1 = tig_expr(call_arg(id, 0))
        if f1 < 0 {
            return -1
        }
        var f2 = tig_expr(call_arg(id, 1))
        if f2 < 0 {
            return -1
        }
        if nm == "http_get_file" {
            g_used_wsock = true
            g_builtin_res = tig_http_get_file(f1, f2)
        } else if nm == "untar_gz" {
            g_builtin_res = tig_untar_gz(f1, f2)
        } else {
            g_builtin_res = tig_unzip(f1, f2)
        }
        return 0
    }
    // byte_read：读文件为字节表（tig_byte_read 原生 libc 实现，失败 exit(1)）
    if nm == "byte_read" {
        var pv = tig_expr(call_arg(id, 0))
        if pv < 0 {
            return -1
        }
        g_builtin_res = tig_byte_read(pv)
        return 0
    }
    // byte_write：路径 + 字节表 → bool（tig_byte_write 原生 libc 实现）
    if nm == "byte_write" {
        var w1 = tig_expr(call_arg(id, 0))
        if w1 < 0 {
            return -1
        }
        var w2 = tig_expr(call_arg(id, 1))
        if w2 < 0 {
            return -1
        }
        g_builtin_res = tig_byte_write(w1, w2)
        return 0
    }
    // bit_read：字节表 + 位置 → i64（tig_bit_read 原生实现，越界 0）
    if nm == "bit_read" {
        var b1 = tig_expr(call_arg(id, 0))
        if b1 < 0 {
            return -1
        }
        var b2 = tig_expr(call_arg(id, 1))
        if b2 < 0 {
            return -1
        }
        g_builtin_res = tig_bit_read(b1, b2)
        return 0
    }
    // bit_write：字节表 + 位置 + 位 → bool（tig_bit_write 原生实现，越界 false）
    if nm == "bit_write" {
        var bw1 = tig_expr(call_arg(id, 0))
        if bw1 < 0 {
            return -1
        }
        var bw2 = tig_expr(call_arg(id, 1))
        if bw2 < 0 {
            return -1
        }
        var bw3 = tig_expr(call_arg(id, 2))
        if bw3 < 0 {
            return -1
        }
        g_builtin_res = tig_bit_write(bw1, bw2, bw3)
        return 0
    }
    // byte_concat：字节表 + 字节表 → 字节表（tig_byte_concat 原生实现）
    if nm == "byte_concat" {
        var c1 = tig_expr(call_arg(id, 0))
        if c1 < 0 {
            return -1
        }
        var c2 = tig_expr(call_arg(id, 1))
        if c2 < 0 {
            return -1
        }
        g_builtin_res = tig_byte_concat(c1, c2)
        return 0
    }
    // set_env：内联 SetEnvironmentVariableW（UTF-16 桥）；msg_set_lang：单参 void
    if nm == "set_env" {
        var e1 = tig_expr(call_arg(id, 0))
        if e1 < 0 {
            return -1
        }
        var e2 = tig_expr(call_arg(id, 1))
        if e2 < 0 {
            return -1
        }
        tig_set_env(e1, e2)
        g_builtin_res = tig_int_lit(0)  // void：哑值
        return 0
    }
    // ---------- p.6.4.7 消息系统原语（纯 tie：运行期全局表内联查表） ----------
    // 不再走 tie_msg_* Rust 桥（g_used_interp=false）。状态 = 运行期程序全局槽
    // @__msg_lang / @__msg_keys / @__msg_langs / @__msg_texts（惰性登记 + 惰性建表，
    // 见 tig_msg_reg_globals / tig_msg_ensure）。
    if nm == "msg_set_lang" {
        tig_msg_reg_globals()
        var e1 = tig_expr(call_arg(id, 0))
        if e1 < 0 {
            return -1
        }
        tig_msg_gstore("__msg_lang", types.named(TK_STR), e1)
        g_builtin_res = tig_int_lit(0)  // void：哑值
        return 0
    }
    if nm == "msg_get_lang" {
        tig_msg_reg_globals()
        g_builtin_res = tig_msg_gload("__msg_lang", types.named(TK_STR))
        return 0
    }
    if nm == "msg_register" {
        var q1 = tig_expr(call_arg(id, 0))
        if q1 < 0 {
            return -1
        }
        var q2 = tig_expr(call_arg(id, 1))
        if q2 < 0 {
            return -1
        }
        var q3 = tig_expr(call_arg(id, 2))
        if q3 < 0 {
            return -1
        }
        tig_msg_register(q1, q2, q3)
        g_builtin_res = tig_int_lit(0)  // void：哑值
        return 0
    }
    if nm == "msg_t" {
        tig_msg_reg_globals()
        var s1 = tig_expr(call_arg(id, 0))
        if s1 < 0 {
            return -1
        }
        // 当前语言查表；未命中回退 key 本身
        g_builtin_res = tig_msg_find(s1, tig_msg_gload("__msg_lang", types.named(TK_STR)), s1)
        return 0
    }
    if nm == "msg_t_lang" {
        tig_msg_reg_globals()
        var a1 = tig_expr(call_arg(id, 0))
        if a1 < 0 {
            return -1
        }
        var a2 = tig_expr(call_arg(id, 1))
        if a2 < 0 {
            return -1
        }
        // 指定语言查表；未命中返空串（对齐 Rust 桥原语义，ext/log 回退链 lookup 依赖）
        g_builtin_res = tig_msg_find(a1, a2, tig_str_lit(interner.intern("\"\"")))
        return 0
    }
    // rand_range：i64 半开区间 [min,max)；内联 libc rand()（非密码学安全）
    if nm == "rand_range" {
        var d1 = tig_expr(call_arg(id, 0))
        if d1 < 0 {
            return -1
        }
        var d2 = tig_expr(call_arg(id, 1))
        if d2 < 0 {
            return -1
        }
        g_builtin_res = tig_rand_range(d1, d2)
        return 0
    }
    // table_at：表 + 下标 → 元素（与 t[i] 同语义；元素类型 fallback 判定）
    if nm == "table_at" {
        var tb = tig_expr(call_arg(id, 0))
        if tb < 0 {
            return -1
        }
        var ti = tig_expr(call_arg(id, 1))
        if ti < 0 {
            return -1
        }
        // 元素类型：语义节点类型（表实参的 node_types 可能是 TK_TABLE——元素类型
        // 按 var_table_elem 尽力推断，失败 fallback i64）
        var elem: i64 = types.named(TK_I64)
        var tn = call_arg(id, 0)
        if s_tags[tn] == 6 {
            var te = sinfer.var_table_elem(intern.intern(sstate.name_str(tn)))
            if te >= 0 {
                elem = te
            }
        }
        var suffix = bridge_suffix(elem)
        var ret_ty = types.named(TK_I64)
        var ek2 = types.kind(elem)
        if ek2 == K_STRUCT || ek2 == K_ENUM || ek2 == K_FN {
            // P2a 复合元素：返回类型 = 元素类型 id（多字元素类型化 load）
            ret_ty = elem
        } else if suffix == "string" {
            ret_ty = types.named(TK_STR)
        } else if suffix == "f64" {
            // f64 表元素：返回类型 double（曾落默认 i64 → `call i64 @tie_table_at_f64`
            // 与 declare 的 double 返回不匹配，opt 报类型错）
            ret_ty = types.named(TK_F64)
        } else if suffix == "bool" {
            ret_ty = types.named(TK_BOOL)
        }
        var ok_slot = ir.new_inst(g_cur_block, 20, types.named(TK_I8))  // alloca i8
        ir.add_operand(ok_slot, types.named(TK_I8), 2)
        var ok_addr = ir.get_value(ok_slot)
        g_builtin_res = s21_table_at(tb, ti, ok_addr, ret_ty)
        return 0
    }
    // ---------- trm-lite 轻量执行体原语（阶段1块2：spawn/yield/collect）----------
    if nm == "spawn" {
        // spawn(f) → i64 任务 id。f 为 fn() -> i64 / fn() -> void 闭包：提取
        // env(槽0)/entry(槽1)，调 trm_lite_sched$spawn_task 入队轻量执行体
        //（trm_lite.a 静态链接，用户无需 import）。返回任务 id。
        g_used_trmlite = true
        // 替代路径检测：当前模块已 import trm-lite（同名运行时函数已定义）→ 报错。
        // 内置与 import 是替代运行时路径，混用会导致 extern declare 与 define 冲突。
        // p.6.5.1 扩展：复杂形态汇总库（tl_runtime_ctx::ctx_*，独立命名空间）亦为
        // 替代路径——import 复杂形态（import 即选择）后使用内置 spawn → 明确报错。
        if sstate.fn_def_node("trm_lite_sched::spawn_task") >= 0 ||
            sstate.fn_def_node("tl_runtime_ctx::ctx_spawn") >= 0 {
            sm_err_msg = "spawn 内置与 import trm-lite 冲突：内置与 import 是替代运行时路径，不能混用（函数 " + g_cur_fn_name + "）"
            return -1
        }
        var fn_node = call_arg(id, 0)
        var fv = tig_expr(fn_node)
        if fv < 0 {
            return -1
        }
        var fty = node_types[fn_node]
        if fty < 0 || !types.is_fn(fty) {
            sm_err_msg = "spawn 参数必须是函数值（fn() -> i64 / fn() -> void），函数 " + g_cur_fn_name
            return -1
        }
        var fret = types.fn_ret_ty(fty)
        var rcode: i64 = 0
        if fret == types.named(TK_VOID) {
            rcode = 1
        } else if fret != types.named(TK_I64) {
            sm_err_msg = "spawn 暂只支持返回 i64/void 的闭包（当前 " + types.type_name(fret) + "），函数 " + g_cur_fn_name
            return -1
        }
        // f 落 alloca 聚合，提取 env（槽0）/ entry（槽1）
        var fa = ir.new_inst(g_cur_block, 20, fty)
        ir.add_operand(fa, fty, 2)
        var fap = ir.get_value(fa)
        var st0 = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(st0, fty, 2)
        ir.add_operand(st0, fv, 0)
        ir.add_operand(st0, fap, 0)
        var g0 = ir.new_inst(g_cur_block, 27, fty)  // agg_gep 0（env）
        ir.add_operand(g0, fap, 0)
        ir.add_operand(g0, 0, 2)
        var ld0 = ir.new_inst(g_cur_block, 21, types.named(TK_STR))
        ir.add_operand(ld0, ir.get_value(g0), 0)
        var env_v = ir.get_value(ld0)
        var g1 = ir.new_inst(g_cur_block, 27, fty)  // agg_gep 1（entry）
        ir.add_operand(g1, fap, 0)
        ir.add_operand(g1, 1, 2)
        var ld1 = ir.new_inst(g_cur_block, 21, types.named(TK_STR))
        ir.add_operand(ld1, ir.get_value(g1), 0)
        var entry_v = ir.get_value(ld1)
        // env/entry → i64（ptrtoint；trm-lite 队列以 i64 承载指针）
        var pe = ir.new_inst(g_cur_block, 24, types.named(TK_I64))
        ir.add_operand(pe, env_v, 0)
        var env_i = ir.get_value(pe)
        var pn = ir.new_inst(g_cur_block, 24, types.named(TK_I64))
        ir.add_operand(pn, entry_v, 0)
        var entry_i = ir.get_value(pn)
        var rc = tig_int_lit_ty(rcode, types.named(TK_I64))
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, types.named(TK_I64)); table_push(avs, entry_i)
        table_push(ats, types.named(TK_I64)); table_push(avs, env_i)
        table_push(ats, types.named(TK_I64)); table_push(avs, rc)
        g_builtin_res = tig_trmlite_call("trm_lite_sched$spawn_task", ats, avs, types.named(TK_I64))
        // p.6.7.6 S-pool：首个 spawn 置池闸后，发常驻 worker 线程（CreateThread × P）
        // 并行抢执行；后续 spawn 闸=0 直接复用已建线程（常驻，不随 drain 终止）。
        tig_s_pool_start()
        return 0
    }
    if nm == "yield" {
        // yield() → p.6.7.6 重定义为**同步点**：等 S-pool 全部已入队任务完成
        //（任务由常驻 worker 线程并行执行；yield 不再手动排空）。返回哑值 0。
        // 与 actor 等待循环统一走 trm_lite_sched$yield_wait。
        g_used_trmlite = true
        if sstate.fn_def_node("trm_lite_sched::queued_count") >= 0 ||
            sstate.fn_def_node("tl_runtime_ctx::ctx_drain") >= 0 {
            sm_err_msg = "yield 内置与 import trm-lite 冲突：内置与 import 是替代运行时路径，不能混用（函数 " + g_cur_fn_name + "）"
            return -1
        }
        var T64y = types.named(TK_I64)
        tig_trmlite_call("trm_lite_sched$yield_wait", tig_empty_types(), tig_empty_vals(), T64y)
        g_builtin_res = tig_int_lit(0)
        return 0
    }
    if nm == "gosched" {
        // gosched() → p.6.7.10 协作抢占：显式让出点（纯让出不等待）。
        // 双形态统一：简单形态（无 import）调 trm_lite_sched$gosched；复杂形态
        // （import tl_runtime_ctx / trm_lite_ws）调 trm_lite_ws$gosched（同语义，
        // 与简单形态互为替代运行时路径——编译期按模块内形状分派，不互斥报错）。
        g_used_trmlite = true
        var T64s = types.named(TK_I64)
        var sym: string = "trm_lite_sched$gosched"
        if sstate.fn_def_node("trm_lite_ws::sync_cs") >= 0 ||
            sstate.fn_def_node("tl_runtime_ctx::ctx_gosched") >= 0 {
            sym = "trm_lite_ws$gosched"
        }
        tig_trmlite_call(sym, tig_empty_types(), tig_empty_vals(), T64s)
        g_builtin_res = tig_int_lit(0)
        return 0
    }
    if nm == "collect" {
        // collect() → i64（本轮回收对象数）：调 trm_lite_gc$collect
        //（stop-the-world mark-sweep，trm_lite.a 静态链接）。
        g_used_trmlite = true
        if sstate.fn_def_node("trm_lite_gc::collect") >= 0 ||
            sstate.fn_def_node("tl_runtime_ctx::ctx_collect") >= 0 {
            sm_err_msg = "collect 内置与 import trm-lite 冲突：内置与 import 是替代运行时路径，不能混用（函数 " + g_cur_fn_name + "）"
            return -1
        }
        var T64 = types.named(TK_I64)
        g_builtin_res = tig_trmlite_call("trm_lite_gc$collect", tig_empty_types(), tig_empty_vals(), T64)
        return 0
    }
    // ---------- channel 原语（p.6.5.7：mailbox 承载，静态链接 trm_lite.a）----------
    // ch_open() → i64 新通道句柄；入队前初始化各平行数组/环形缓冲（trm_lite.a 内部完成）。
    if nm == "ch_open" {
        g_used_trmlite = true
        // 复杂形态汇总结构冲突检测：import trm_lite_chan / tl_runtime_ctx 后使用内置 → 报错。
        if sstate.fn_def_node("trm_lite_chan::ch_open") >= 0 ||
            sstate.fn_def_node("tl_runtime_ctx::ctx_ch_open") >= 0 {
            sm_err_msg = "ch_open 内置与 import trm-lite 冲突：内置与 import 是替代运行时路径，不能混用（函数 " + g_cur_fn_name + "）"
            return -1
        }
        var T64ch = types.named(TK_I64)
        g_builtin_res = tig_trmlite_call("trm_lite_chan$ch_open", tig_empty_types(), tig_empty_vals(), T64ch)
        return 0
    }
    // ch_send(ch, v) → i64（0=入队成功 1=失败：通道关闭或队列满）。
    if nm == "ch_send" {
        g_used_trmlite = true
        if sstate.fn_def_node("trm_lite_chan::ch_send") >= 0 ||
            sstate.fn_def_node("tl_runtime_ctx::ctx_ch_send") >= 0 {
            sm_err_msg = "ch_send 内置与 import trm-lite 冲突：内置与 import 是替代运行时路径，不能混用（函数 " + g_cur_fn_name + "）"
            return -1
        }
        var T64s = types.named(TK_I64)
        var c_nd = call_arg(id, 0)
        var c_v = tig_expr(c_nd)
        if c_v < 0 {
            return -1
        }
        var v_nd = call_arg(id, 1)
        var v_v = tig_expr(v_nd)
        if v_v < 0 {
            return -1
        }
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, T64s); table_push(avs, c_v)
        table_push(ats, T64s); table_push(avs, v_v)
        g_builtin_res = tig_trmlite_call("trm_lite_chan$ch_send", ats, avs, T64s)
        return 0
    }
    // ch_recv(ch) → i64（消息值；0=空未关；-1=已关闭且空）。
    if nm == "ch_recv" {
        g_used_trmlite = true
        if sstate.fn_def_node("trm_lite_chan::ch_recv") >= 0 ||
            sstate.fn_def_node("tl_runtime_ctx::ctx_ch_recv") >= 0 {
            sm_err_msg = "ch_recv 内置与 import trm-lite 冲突：内置与 import 是替代运行时路径，不能混用（函数 " + g_cur_fn_name + "）"
            return -1
        }
        var T64r = types.named(TK_I64)
        var c_nd2 = call_arg(id, 0)
        var c_v2 = tig_expr(c_nd2)
        if c_v2 < 0 {
            return -1
        }
        var ats2: table<i64> = table_new_i64()
        var avs2: table<i64> = table_new_i64()
        table_push(ats2, T64r); table_push(avs2, c_v2)
        g_builtin_res = tig_trmlite_call("trm_lite_chan$ch_recv", ats2, avs2, T64r)
        return 0
    }
    // ch_close(ch) → void：置关闭位（幂等）；唤醒等待者。trm_lite_chan$ch_close。
    if nm == "ch_close" {
        g_used_trmlite = true
        if sstate.fn_def_node("trm_lite_chan::ch_close") >= 0 ||
            sstate.fn_def_node("tl_runtime_ctx::ctx_ch_close") >= 0 {
            sm_err_msg = "ch_close 内置与 import trm-lite 冲突：内置与 import 是替代运行时路径，不能混用（函数 " + g_cur_fn_name + "）"
            return -1
        }
        var T64cc = types.named(TK_I64)
        var c_nd3 = call_arg(id, 0)
        var c_v3 = tig_expr(c_nd3)
        if c_v3 < 0 {
            return -1
        }
        var ats3: table<i64> = table_new_i64()
        var avs3: table<i64> = table_new_i64()
        table_push(ats3, T64cc); table_push(avs3, c_v3)
        tig_trmlite_call("trm_lite_chan$ch_close", ats3, avs3, -1)  // void 桥
        g_builtin_res = tig_int_lit(0)
        return 0
    }
    return -1  // 非内置
}

    // ==================== 去 Rust 桥：to_string(f64) / parse_float（p.6.4.4） ====================
    // f64 → 十进制字符串，替代 Rust 桥 tie_to_string_f64。**避免 CRT snprintf/printf 式变参**：
    // Windows 的 clang 对**手写 IR 的 FP 变参调用**（snprintf(buf,32,"%.17g",double)）在 x64
    // 阴影区传参会错位（实测 double 落错误槽 → 格式化出 1e-322 垃圾），故改用**非变参** CRT
    // `char* _gcvt(double value, int digits, char *buffer)`：把 %g 风格数字直接写入给定缓冲
    //（17 位有效数字；科学计数阈值对齐 libc）。有限精度对齐 Rust 最短表示差异可接受
    //（3.14→"3.1400000000000001" 含 "3.14"、1e100→"1.e+100" 含 "e+100"、1.0→去尾点"1"）。
    // 签名 v:f64 → 带头字符串数据指针 {len头,数据,\0}。全直线式（无块图 → 无重编号风险）。
    func tig_f64_to_str(v: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var T8 = types.named(TK_I8)
        var I32 = types.named(TK_I32)
        var F64 = types.named(TK_F64)
        var P8 = types.ptr_of(T8)
        var cdot = tig_int_lit_ty(46, T64)
        var one64 = tig_int_lit_ty(1, T64)
        // 1. raw 缓冲 64B（K_PTR 返回绕 op36 对 TK_STR 的 strlen 扫描——漏洞 A 类隐患）
        var buf = s21_raw_alloc_str(tig_int_lit(64))
        // 2. _gcvt(v, 17, buf) → %g 风格写入 buf（返回 char* 忽略；非变参，参数直传正确）
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, F64); table_push(avs, v)
        table_push(ats, I32); table_push(avs, tig_int_lit_ty(17, I32))
        table_push(ats, types.named(TK_STR)); table_push(avs, buf)
        tig_ext_call_typed("_gcvt", ats, avs, P8)
        // 3. 长度 = strlen(buf)（_gcvt 输出 NUL 结尾）
        var len = tig_ext_call1("strlen", buf, types.named(TK_STR), T64)
        // 4. 去尾点：_gcvt 对整数给 "1." / "0." → 若末字节 '.' 则长度 -1（%g 亦如此）
        var lastp = s21_gep(buf, s21_bin(1, len, one64), false)  // buf + len - 1
        var lastb = s21_zext(s21_load(lastp, T8), T8)
        var isdot = tig_icmp_c(lastb, cdot, 0)  // eq '.'
        var len2 = tig_select_i(isdot, s21_bin(1, len, one64), len, T64)
        // 5. 构造带头串：SSO 分配 len2、写头、拷数据、尾 \0
        var out = s21_sso_alloc(len2)
        s21_store(s21_gep(out, 0, true), len2, T64)  // 长度头
        var d0 = s21_gep(out, 8, true)
        s21_memcpy_if(d0, buf, len2)
        s21_store(s21_gep(d0, len2, false), tig_int_lit_ty(0, T8), T8)  // 尾 \0
        var pi = ir.new_inst(g_cur_block, 24, T64)  // ptrtoint
        ir.add_operand(pi, d0, 0)
        var ip = ir.new_inst(g_cur_block, 25, types.named(TK_STR))  // inttoptr → ptr
        ir.add_operand(ip, ir.get_value(pi), 0)
        return ir.get_value(ip)
    }

    // 字符串 → f64，替代 Rust 桥 tie_parse_float。签名 s:string + ok 出参槽（caller
    // alloca i8 出参，语义与 tig_parse_int 一致：无效 → ok=0 返回 0.0）。
    // 有限精度实现：逐位十进制 i64 尾数累积 + libm pow(10.0, e) 缩放。尾数最多累计
    // 18 位（>18：整数段折叠计数计入指数 big_slot（×10），小数段丢弃——精度 <1e-18
    // 可忽略），不保证完全对齐 Rust str::parse 最短舍入，但覆盖常见 "3.14" / "-2.5e3" /
    // "0.5" / "1e10" 及绝大多数值。合法输入 [±]int[.frac][(e|E)[±]exp] 且整数或小数
    // 至少一位数字；其余（空串/仅符号/"1e"无指数数字等）→ fail。
    // 结果 = mant × 10^(exp_total)，exp_total = (±exp) - fracn + big。
    // 控制流：entry→sign→int 循环→dot→frac 循环→have→exp→(succ/fail)→exit。
    // 全部跨块状态落内存槽；结果 f64 落 rs_slot，exit 统一写 ok 槽返回。
    func tig_parse_float(s: i64, ok_ptr: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var T8 = types.named(TK_I8)
        var F64 = types.named(TK_F64)
        var z64 = tig_int_lit_ty(0, T64)
        var one = tig_int_lit_ty(1, T64)
        var ten = tig_int_lit_ty(10, T64)
        var c48 = tig_int_lit_ty(48, T64)
        var c57 = tig_int_lit_ty(57, T64)
        var cpl = tig_int_lit_ty(43, T64)   // '+'
        var cmi = tig_int_lit_ty(45, T64)   // '-'
        var cdot = tig_int_lit_ty(46, T64)  // '.'
        var ce2 = tig_int_lit_ty(101, T64)  // 'e'
        var cE2 = tig_int_lit_ty(69, T64)   // 'E'
        var CLIM = tig_int_lit_ty(100000000000000000, T64)  // 1e17 尾数累积上限
        var n = s21_str_head_len(s)
        // 状态槽（跨块内存）：i / neg / dig / digf / mant / fracn / exps /
        // expneg / expdig / big / et / ok / 结果 f64 rs
        var i_a = ir.new_inst(g_cur_block, 20, T64); ir.add_operand(i_a, T64, 2); var i_ptr = ir.get_value(i_a)
        var ng_a = ir.new_inst(g_cur_block, 20, T64); ir.add_operand(ng_a, T64, 2); var ng_ptr = ir.get_value(ng_a)
        var dg_a = ir.new_inst(g_cur_block, 20, T64); ir.add_operand(dg_a, T64, 2); var dg_ptr = ir.get_value(dg_a)
        var df_a = ir.new_inst(g_cur_block, 20, T64); ir.add_operand(df_a, T64, 2); var df_ptr = ir.get_value(df_a)
        var mnt_a = ir.new_inst(g_cur_block, 20, T64); ir.add_operand(mnt_a, T64, 2); var mnt_ptr = ir.get_value(mnt_a)
        var frc_a = ir.new_inst(g_cur_block, 20, T64); ir.add_operand(frc_a, T64, 2); var frc_ptr = ir.get_value(frc_a)
        var esp_a = ir.new_inst(g_cur_block, 20, T64); ir.add_operand(esp_a, T64, 2); var esp_ptr = ir.get_value(esp_a)
        var enp_a = ir.new_inst(g_cur_block, 20, T64); ir.add_operand(enp_a, T64, 2); var enp_ptr = ir.get_value(enp_a)
        var edg_a = ir.new_inst(g_cur_block, 20, T64); ir.add_operand(edg_a, T64, 2); var edg_ptr = ir.get_value(edg_a)
        var big_a = ir.new_inst(g_cur_block, 20, T64); ir.add_operand(big_a, T64, 2); var big_ptr = ir.get_value(big_a)
        var et_a = ir.new_inst(g_cur_block, 20, T64); ir.add_operand(et_a, T64, 2); var et_ptr = ir.get_value(et_a)
        var ok_a = ir.new_inst(g_cur_block, 20, T64); ir.add_operand(ok_a, T64, 2); var ok2_ptr = ir.get_value(ok_a)
        var rs_a = ir.new_inst(g_cur_block, 20, F64); ir.add_operand(rs_a, F64, 2); var rs_ptr = ir.get_value(rs_a)
        // 初始化
        s21_store(i_ptr, z64, T64)
        s21_store(ng_ptr, z64, T64)
        s21_store(dg_ptr, z64, T64)
        s21_store(df_ptr, z64, T64)
        s21_store(mnt_ptr, z64, T64)
        s21_store(frc_ptr, z64, T64)
        s21_store(esp_ptr, z64, T64)
        s21_store(enp_ptr, z64, T64)
        s21_store(edg_ptr, z64, T64)
        s21_store(big_ptr, z64, T64)
        s21_store(et_ptr, z64, T64)
        s21_store(ok2_ptr, z64, T64)
        s21_store(rs_ptr, tig_float_lit(interner.intern("0.0")), F64)
        // 块
        var sign_blk = ir.new_block(g_cur_func, interner.intern("pf.sign"))
        var ic_blk = ir.new_block(g_cur_func, interner.intern("pf.ic"))
        var ib_blk = ir.new_block(g_cur_func, interner.intern("pf.ib"))
        var iv_blk = ir.new_block(g_cur_func, interner.intern("pf.iv"))
        var ia_blk = ir.new_block(g_cur_func, interner.intern("pf.ia"))
        var ibig_blk = ir.new_block(g_cur_func, interner.intern("pf.ig"))
        var is_blk = ir.new_block(g_cur_func, interner.intern("pf.is"))
        var dot_t = ir.new_block(g_cur_func, interner.intern("pf.dt"))
        var dot_c = ir.new_block(g_cur_func, interner.intern("pf.dc"))
        var dc_blk = ir.new_block(g_cur_func, interner.intern("pf.dd"))
        var fc_blk = ir.new_block(g_cur_func, interner.intern("pf.fc"))
        var fb_blk = ir.new_block(g_cur_func, interner.intern("pf.fb"))
        var fv_blk = ir.new_block(g_cur_func, interner.intern("pf.fv"))
        var fa_blk = ir.new_block(g_cur_func, interner.intern("pf.fa"))
        var fsk_blk = ir.new_block(g_cur_func, interner.intern("pf.fk"))
        var fs_blk = ir.new_block(g_cur_func, interner.intern("pf.fs"))
        var hv_blk = ir.new_block(g_cur_func, interner.intern("pf.hv"))
        var esc_blk = ir.new_block(g_cur_func, interner.intern("pf.e"))
        var ec_blk = ir.new_block(g_cur_func, interner.intern("pf.ec"))
        var esg_blk = ir.new_block(g_cur_func, interner.intern("pf.es"))
        var esb_blk = ir.new_block(g_cur_func, interner.intern("pf.esb"))
        var ebc_blk = ir.new_block(g_cur_func, interner.intern("pf.eb"))
        var ebd_blk = ir.new_block(g_cur_func, interner.intern("pf.ed"))
        var eac_blk = ir.new_block(g_cur_func, interner.intern("pf.ea"))
        var eend_blk = ir.new_block(g_cur_func, interner.intern("pf.ee"))
        var eff_blk = ir.new_block(g_cur_func, interner.intern("pf.ef"))
        var okb_blk = ir.new_block(g_cur_func, interner.intern("pf.ok"))
        var use_blk = ir.new_block(g_cur_func, interner.intern("pf.use"))
        var pow_blk = ir.new_block(g_cur_func, interner.intern("pf.pow"))
        var ngb_blk = ir.new_block(g_cur_func, interner.intern("pf.ngb"))
        var ngy_blk = ir.new_block(g_cur_func, interner.intern("pf.ngy"))
        var fin_blk = ir.new_block(g_cur_func, interner.intern("pf.fin"))
        var fail_blk = ir.new_block(g_cur_func, interner.intern("pf.fail"))
        var exit_blk = ir.new_block(g_cur_func, interner.intern("pf.exit"))
        // entry：n==0 → fail；否则 sign
        var c_empty = tig_icmp_c(n, z64, 0)
        var cb0 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb0, c_empty, 0)
        ir.add_operand(cb0, fail_blk, 1)
        ir.add_operand(cb0, sign_blk, 1)
        // sign：i = has_sign?1:0；neg = is_minus；→ ic
        g_cur_block = sign_blk
        var b0 = s21_str_byte(s, z64)
        var is_plus = tig_icmp_c(b0, cpl, 0)
        var is_minus = tig_icmp_c(b0, cmi, 0)
        var has_sign = tig_or_i1(is_plus, is_minus)
        s21_store(i_ptr, tig_select_i(has_sign, one, z64, T64), T64)
        s21_store(ng_ptr, tig_select_i(is_minus, one, z64, T64), T64)
        var bsign = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bsign, ic_blk, 1)
        // ic：i<n → ib；否则 dot_t
        g_cur_block = ic_blk
        var c_i1 = tig_icmp_c(s21_load(i_ptr, T64), n, 6)  // ult
        var cb1 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb1, c_i1, 0)
        ir.add_operand(cb1, ib_blk, 1)
        ir.add_operand(cb1, dot_t, 1)
        // ib：字节数字？→ iv；否则 dot_t
        g_cur_block = ib_blk
        var bv2 = s21_str_byte(s, s21_load(i_ptr, T64))
        var isd2 = tig_and_i1(tig_icmp_c(bv2, c48, 5), tig_icmp_c(bv2, c57, 4))
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, isd2, 0)
        ir.add_operand(cb2, iv_blk, 1)
        ir.add_operand(cb2, dot_t, 1)
        // iv：dig=1；mant<CLIM → ia（累积）else ibig（折计入指数）
        g_cur_block = iv_blk
        s21_store(dg_ptr, one, T64)
        var mlt3 = tig_icmp_c(s21_load(mnt_ptr, T64), CLIM, 2)  // slt
        var cb3 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb3, mlt3, 0)
        ir.add_operand(cb3, ia_blk, 1)
        ir.add_operand(cb3, ibig_blk, 1)
        // ia：mant = mant*10 + (b-48)；→ is
        g_cur_block = ia_blk
        var bv4 = s21_str_byte(s, s21_load(i_ptr, T64))  // 先 load 再来 new_inst（防操作数段交错）
        var cm4 = s21_load(mnt_ptr, T64)
        var m4 = ir.new_inst(g_cur_block, 2, T64)  // mul
        ir.add_operand(m4, cm4, 0)
        ir.add_operand(m4, ten, 0)
        var d4 = s21_bin(1, bv4, c48)                       // sub b-48
        var nm4 = s21_bin(0, ir.get_value(m4), d4)          // add
        s21_store(mnt_ptr, nm4, T64)
        var bia = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bia, is_blk, 1)
        // ibig：big = big+1；→ is
        g_cur_block = ibig_blk
        s21_store(big_ptr, s21_bin(0, s21_load(big_ptr, T64), one), T64)
        var bib = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bib, is_blk, 1)
        // is：i = i+1；→ ic
        g_cur_block = is_blk
        s21_store(i_ptr, s21_bin(0, s21_load(i_ptr, T64), one), T64)
        var bis = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bis, ic_blk, 1)
        // dot_t：i<n → dot_c（复核 '.')；否则 hv
        g_cur_block = dot_t
        var c_i5 = tig_icmp_c(s21_load(i_ptr, T64), n, 6)
        var cb5 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb5, c_i5, 0)
        ir.add_operand(cb5, dot_c, 1)
        ir.add_operand(cb5, hv_blk, 1)
        // dot_c：byte=='.' → dc（消费）else hv
        g_cur_block = dot_c
        var bv5 = s21_str_byte(s, s21_load(i_ptr, T64))
        var isdot = tig_icmp_c(bv5, cdot, 0)
        var cb5b = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb5b, isdot, 0)
        ir.add_operand(cb5b, dc_blk, 1)
        ir.add_operand(cb5b, hv_blk, 1)
        // dc：i = i+1；→ fc
        g_cur_block = dc_blk
        s21_store(i_ptr, s21_bin(0, s21_load(i_ptr, T64), one), T64)
        var bdc = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bdc, fc_blk, 1)
        // fc：i<n → fb；否则 hv
        g_cur_block = fc_blk
        var c_i6 = tig_icmp_c(s21_load(i_ptr, T64), n, 6)
        var cb6 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb6, c_i6, 0)
        ir.add_operand(cb6, fb_blk, 1)
        ir.add_operand(cb6, hv_blk, 1)
        // fb：字节数字？→ fv；否则 hv
        g_cur_block = fb_blk
        var bv6 = s21_str_byte(s, s21_load(i_ptr, T64))
        var isd6 = tig_and_i1(tig_icmp_c(bv6, c48, 5), tig_icmp_c(bv6, c57, 4))
        var cb7 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb7, isd6, 0)
        ir.add_operand(cb7, fv_blk, 1)
        ir.add_operand(cb7, hv_blk, 1)
        // fv：mant<CLIM → fa（累积）else fsk（丢弃小数位）
        g_cur_block = fv_blk
        var mlt7 = tig_icmp_c(s21_load(mnt_ptr, T64), CLIM, 2)
        var cb8 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb8, mlt7, 0)
        ir.add_operand(cb8, fa_blk, 1)
        ir.add_operand(cb8, fsk_blk, 1)
        // fa：mant=mant*10+d；fracn++；digf=1；→ fs
        g_cur_block = fa_blk
        var bv7 = s21_str_byte(s, s21_load(i_ptr, T64))
        var cm7 = s21_load(mnt_ptr, T64)
        var m7 = ir.new_inst(g_cur_block, 2, T64)  // mul
        ir.add_operand(m7, cm7, 0)
        ir.add_operand(m7, ten, 0)
        var d7 = s21_bin(1, bv7, c48)
        var nm7 = s21_bin(0, ir.get_value(m7), d7)
        s21_store(mnt_ptr, nm7, T64)
        s21_store(frc_ptr, s21_bin(0, s21_load(frc_ptr, T64), one), T64)
        s21_store(df_ptr, one, T64)
        var bfa = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bfa, fs_blk, 1)
        // fsk：digf=1（有效但超 18 位丢弃）；→ fs
        g_cur_block = fsk_blk
        s21_store(df_ptr, one, T64)
        var bfk = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bfk, fs_blk, 1)
        // fs：i = i+1；→ fc
        g_cur_block = fs_blk
        s21_store(i_ptr, s21_bin(0, s21_load(i_ptr, T64), one), T64)
        var bfs = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bfs, fc_blk, 1)
        // hv：dig||digf → esc；否则 fail
        g_cur_block = hv_blk
        var hasd = tig_or_i1(tig_icmp_c(s21_load(dg_ptr, T64), z64, 1), tig_icmp_c(s21_load(df_ptr, T64), z64, 1))
        var cbh = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cbh, hasd, 0)
        ir.add_operand(cbh, esc_blk, 1)
        ir.add_operand(cbh, fail_blk, 1)
        // esc：i<n 且 byte==e/E → ec；否则 eff（无指数）
        g_cur_block = esc_blk
        var c_i8 = tig_icmp_c(s21_load(i_ptr, T64), n, 6)
        var ebd_t8 = ir.new_block(g_cur_func, interner.intern("pf.escan"))
        var cb9 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb9, c_i8, 0)
        ir.add_operand(cb9, ebd_t8, 1)
        ir.add_operand(cb9, eff_blk, 1)
        // esd：byte==e||E → ec else eff
        g_cur_block = ebd_t8
        var bv8 = s21_str_byte(s, s21_load(i_ptr, T64))
        var ise = tig_or_i1(tig_icmp_c(bv8, ce2, 0), tig_icmp_c(bv8, cE2, 0))
        var cb9b = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb9b, ise, 0)
        ir.add_operand(cb9b, ec_blk, 1)
        ir.add_operand(cb9b, eff_blk, 1)
        // ec：i = i+1（消费 e/E）；→ esg
        g_cur_block = ec_blk
        s21_store(i_ptr, s21_bin(0, s21_load(i_ptr, T64), one), T64)
        var bec = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bec, esg_blk, 1)
        // esg：i<n → esb；否则 fail（裸 "1e"）
        g_cur_block = esg_blk
        var c_ie = tig_icmp_c(s21_load(i_ptr, T64), n, 6)
        var cbe = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cbe, c_ie, 0)
        ir.add_operand(cbe, esb_blk, 1)
        ir.add_operand(cbe, fail_blk, 1)
        // esb：可选 +/-：expneg=is_minus；若有符号 i++；→ ebc
        g_cur_block = esb_blk
        var bv9 = s21_str_byte(s, s21_load(i_ptr, T64))
        var e_plus = tig_icmp_c(bv9, cpl, 0)
        var e_minus = tig_icmp_c(bv9, cmi, 0)
        var e_sign = tig_or_i1(e_plus, e_minus)
        s21_store(enp_ptr, tig_select_i(e_minus, one, z64, T64), T64)
        var i_adj = tig_select_i(e_sign, one, z64, T64)
        s21_store(i_ptr, s21_bin(0, s21_load(i_ptr, T64), i_adj), T64)
        var besb = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(besb, ebc_blk, 1)
        // ebc：i<n → ebd；否则 eend
        g_cur_block = ebc_blk
        var c_ie2 = tig_icmp_c(s21_load(i_ptr, T64), n, 6)
        var cbe2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cbe2, c_ie2, 0)
        ir.add_operand(cbe2, ebd_blk, 1)
        ir.add_operand(cbe2, eend_blk, 1)
        // ebd：字节数字？→ eac；否则 eend
        g_cur_block = ebd_blk
        var bve = s21_str_byte(s, s21_load(i_ptr, T64))
        var isd_e = tig_and_i1(tig_icmp_c(bve, c48, 5), tig_icmp_c(bve, c57, 4))
        var cbde = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cbde, isd_e, 0)
        ir.add_operand(cbde, eac_blk, 1)
        ir.add_operand(cbde, eend_blk, 1)
        // eac：exps=exps*10+d；expdig=1；i++；→ ebc
        g_cur_block = eac_blk
        var bve2 = s21_str_byte(s, s21_load(i_ptr, T64))
        var cme = s21_load(esp_ptr, T64)
        var me = ir.new_inst(g_cur_block, 2, T64)  // mul
        ir.add_operand(me, cme, 0)
        ir.add_operand(me, ten, 0)
        var de = s21_bin(1, bve2, c48)
        var nme = s21_bin(0, ir.get_value(me), de)
        s21_store(esp_ptr, nme, T64)
        s21_store(edg_ptr, one, T64)
        s21_store(i_ptr, s21_bin(0, s21_load(i_ptr, T64), one), T64)
        var beac = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(beac, ebc_blk, 1)
        // eend：expdig!=0 → eff（指数有效）；否则 fail（"1e"/"1e+" 无数字）
        g_cur_block = eend_blk
        var ed_c = tig_icmp_c(s21_load(edg_ptr, T64), z64, 1)  // ne
        var cbed = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cbed, ed_c, 0)
        ir.add_operand(cbed, eff_blk, 1)
        ir.add_operand(cbed, fail_blk, 1)
        // eff：exptot = (±exps) - fracn + big；→ okb
        g_cur_block = eff_blk
        var esv = s21_load(esp_ptr, T64)
        var enpv = s21_load(enp_ptr, T64)
        var is_en = tig_icmp_c(enpv, z64, 1)  // ne
        var esub = ir.new_inst(g_cur_block, 1, T64)  // sub 0 - esv
        ir.add_operand(esub, z64, 0)
        ir.add_operand(esub, esv, 0)
        var ev = tig_select_i(is_en, ir.get_value(esub), esv, T64)
        var t1 = s21_bin(1, ev, s21_load(frc_ptr, T64))           // ev - fracn
        var etot = s21_bin(0, t1, s21_load(big_ptr, T64))         // + big
        s21_store(et_ptr, etot, T64)
        var beff = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(beff, okb_blk, 1)
        // okb：ok=1；fmant = sitofp(mant)；et==0 → use else pow
        g_cur_block = okb_blk
        s21_store(ok2_ptr, one, T64)
        var fmant = tig_to_f64(s21_load(mnt_ptr, T64), T64)
        var ezero = tig_icmp_c(s21_load(et_ptr, T64), z64, 0)  // eq
        var cbok = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cbok, ezero, 0)
        ir.add_operand(cbok, use_blk, 1)
        ir.add_operand(cbok, pow_blk, 1)
        // use：rs = fmant；→ ngb
        g_cur_block = use_blk
        s21_store(rs_ptr, fmant, F64)
        var buse = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(buse, ngb_blk, 1)
        // pow：eF = sitofp(et)；p = pow(10.0, eF)；rs = fmant * p；→ ngb
        g_cur_block = pow_blk
        var eF = tig_to_f64(s21_load(et_ptr, T64), T64)
        var p = tig_ext_call2("pow", tig_float_lit(interner.intern("10.0")), F64, eF, F64, F64)
        var fm = ir.new_inst(g_cur_block, 15, F64)  // fmul
        ir.add_operand(fm, fmant, 0)
        ir.add_operand(fm, p, 0)
        s21_store(rs_ptr, ir.get_value(fm), F64)
        var bpow = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bpow, ngb_blk, 1)
        // ngb：neg!=0 → ngy else fin
        g_cur_block = ngb_blk
        var is_neg = tig_icmp_c(s21_load(ng_ptr, T64), z64, 1)  // ne
        var cbng = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cbng, is_neg, 0)
        ir.add_operand(cbng, ngy_blk, 1)
        ir.add_operand(cbng, fin_blk, 1)
        // ngy：rs = 0.0 - rs；→ fin
        g_cur_block = ngy_blk
        var fzero = tig_float_lit(interner.intern("0.0"))  // 先建常量再建 fsub（防操作数段交错）
        var rcv = s21_load(rs_ptr, F64)
        var fs2 = ir.new_inst(g_cur_block, 14, F64)  // fsub
        ir.add_operand(fs2, fzero, 0)
        ir.add_operand(fs2, rcv, 0)
        s21_store(rs_ptr, ir.get_value(fs2), F64)
        var bng = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bng, fin_blk, 1)
        // fin：→ exit
        g_cur_block = fin_blk
        var bfin = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bfin, exit_blk, 1)
        // fail：ok 保持 0，rs 保持 0.0；→ exit
        g_cur_block = fail_blk
        var bfail = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bfail, exit_blk, 1)
        // exit：写外部 ok 槽（trunc i8）；返回 rs（f64）
        g_cur_block = exit_blk
        var okv = s21_load(ok2_ptr, T64)
        s21_store(ok_ptr, s21_trunc_i8(okv), T8)
        return s21_load(rs_ptr, F64)
    }
    // 背景：byte_read/byte_write/byte_concat/bit_read/bit_write 原以 tie_interp Rust
    // 桥实现（tie_byte_*）。Rust 桥对**原生 32 字节表句柄**（s21 表布局
    // {cap,len,data,esz}）的 ABI 约定不匹配，运行即 0xC0000005 崩溃（与 871d65f
    // alloc 补头扫描同族）。此处改为 tie 内联 IR 全量重写，**零 Rust 依赖、跨
    // Unix/Windows**（文件 IO 走 libc fopen/fread/fwrite/fseek/ftell/fclose，CRT
    // 提供，无需任何系统头/链接库；路径 = tie 串数据指针 UTF-8 char*，Windows 下
    // libc fopen 按 ANSI 代码页解释 → 中文路径受限，与旧 fopen 立场一致）。
    // 表操作走原生句柄 + malloc/memcpy；位操作纯指令（shr/and/shl/or/xor）零依赖。

    // i1 取反（xor i1 v, true；位越界判定组合用）
    func tig_not_i1(v: i64) -> i64 {
        var one = tig_bool_lit(1)
        var x = ir.new_inst(g_cur_block, 8, types.named(TK_BOOL))  // xor
        ir.add_operand(x, v, 0)
        ir.add_operand(x, one, 0)
        return ir.get_value(x)
    }

    // 构件模式串（两字符，如 "rb"/"wb"）：sso 池分配块 {头, 数据, \0}，返回数据指针
    func tig_bt_mode2(c0: i64, c1: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I8 = types.named(TK_I8)
        var n = tig_int_lit(2)
        var mbuf = s21_sso_alloc(n)
        s21_store(s21_gep(mbuf, 0, true), n, T64)  // 长度头 = 2
        var md = s21_gep(mbuf, 8, true)
        s21_store(s21_gep(md, 0, true), tig_int_lit_ty(c0, I8), I8)
        s21_store(s21_gep(md, 1, true), tig_int_lit_ty(c1, I8), I8)
        s21_store(s21_gep(md, 2, true), tig_int_lit_ty(0, I8), I8)  // 尾 \0
        return md
    }

    // 失败输出：printf(fmt, path) + exit(1)（对齐 tig_panic 的 call_vararg 范式；
    // fmt 为字符串池 id，llvmgen collect_strings 会收集 op41 操作数 0）
    func tig_bt_fail(p: i64, fmt: i64) {
        var inst = ir.new_inst(g_cur_block, 41, types.named(TK_I32))  // call_vararg
        ir.add_operand(inst, fmt, 0)
        ir.add_operand(inst, p, 0)
        var one = tig_int_lit_ty(1, types.named(TK_I64))
        tig_ext_call1("exit", one, types.named(TK_I64), -1)
    }

    // libc 包装：fseek（返回值忽略，FILE* 以 ptr<i8> 类型传参）
    func tig_bt_fseek(f: i64, off: i64, whence: i64) {
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, types.ptr_of(types.named(TK_I8)))
        table_push(avs, f)
        table_push(ats, types.named(TK_I64))
        table_push(avs, off)
        table_push(ats, types.named(TK_I32))
        table_push(avs, whence)
        tig_ext_call_typed("fseek", ats, avs, types.named(TK_I32))
    }

    // fread(buf, n, f)：size=1, count=n；返回实际读到的元素数
    func tig_bt_fread(buf: i64, n: i64, f: i64) -> i64 {
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, types.ptr_of(types.named(TK_I8)))
        table_push(avs, buf)
        table_push(ats, types.named(TK_I64))
        table_push(avs, tig_int_lit(1))
        table_push(ats, types.named(TK_I64))
        table_push(avs, n)
        table_push(ats, types.ptr_of(types.named(TK_I8)))
        table_push(avs, f)
        return tig_ext_call_typed("fread", ats, avs, types.named(TK_I64))
    }

    // fwrite(buf, n, f)：size=1, count=n；返回实际写出的元素数
    func tig_bt_fwrite(buf: i64, n: i64, f: i64) -> i64 {
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, types.ptr_of(types.named(TK_I8)))
        table_push(avs, buf)
        table_push(ats, types.named(TK_I64))
        table_push(avs, tig_int_lit(1))
        table_push(ats, types.named(TK_I64))
        table_push(avs, n)
        table_push(ats, types.ptr_of(types.named(TK_I8)))
        table_push(avs, f)
        return tig_ext_call_typed("fwrite", ats, avs, types.named(TK_I64))
    }

    // fclose(f)：FILE* 关闭（返回值忽略）
    func tig_bt_fclose(f: i64) {
        tig_ext_call1("fclose", f, types.ptr_of(types.named(TK_I8)), types.named(TK_I32))
    }

    // byte_read(path)：读文件全部字节 → i64 字节表（元素 0..255；空文件 → 空表）。
    // 流程：fopen "rb" → fseek END → ftell 长度 → fseek SET → fread 全量到 u8 临时
    // 缓冲 → 逐字节零扩展为 i64 元素 → 组装 32 字节表句柄 {cap,len,data,esz}。
    // 失败（打不开 / 读不全，如目录路径）→ 打印路径并 exit(1)，保持 std/bytes
    // 文档语义「byte_read 失败由编译器运行时报错退出」。
    func tig_byte_read(p: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I8 = types.named(TK_I8)
        var P8 = types.ptr_of(I8)
        var f = tig_ext_call2("fopen", p, types.named(TK_STR),
            tig_bt_mode2(114, 98), types.named(TK_STR), P8)  // "rb"
        var ok = tig_cmp_zero(f, 1)  // f != null
        // 结果槽（表句柄 ptr 值；失败分支不可达，槽未初始化可接受）
        var slot = ir.new_inst(g_cur_block, 20, types.named(TK_STR))
        ir.add_operand(slot, types.named(TK_STR), 2)
        var sv = ir.get_value(slot)
        var bt = ir.new_block(g_cur_func, interner.intern("bt.r.ok"))
        var fl = ir.new_block(g_cur_func, interner.intern("bt.r.f"))
        var mg = ir.new_block(g_cur_func, interner.intern("bt.r.m"))
        var cb = ir.new_inst(g_cur_block, 31, -1)  // cond_br ok → bt / fl
        ir.add_operand(cb, ok, 0)
        ir.add_operand(cb, bt, 1)
        ir.add_operand(cb, fl, 1)
        // 失败：printf + exit(1) + 死 br（对齐 tig_panic 的双分支范式）
        g_cur_block = fl
        tig_bt_fail(p, interner.intern("byte_read: 打开/读取文件失败: %s\n"))
        var brf = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brf, mg, 1)
        // 成功：定位长度 → 全量读入 u8 临时缓冲
        g_cur_block = bt
        var z64 = tig_int_lit_ty(0, T64)
        var i32t = types.named(TK_I32)
        tig_bt_fseek(f, z64, tig_int_lit_ty(2, i32t))  // SEEK_END
        var size = tig_ext_call1("ftell", f, P8, T64)
        tig_bt_fseek(f, z64, tig_int_lit_ty(0, i32t))  // SEEK_SET
        var tmp = s21_raw_alloc_str(size)
        var cnt = tig_bt_fread(tmp, size, f)
        // 读不全 → 仍按失败处理（死 br 承接；实际 exit 不返回）
        var full = tig_icmp_c(cnt, size, 0)  // cnt == size
        var bt2 = ir.new_block(g_cur_func, interner.intern("bt.r.c"))
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, full, 0)
        ir.add_operand(cb2, bt2, 1)
        ir.add_operand(cb2, fl, 1)
        // 转换：u8 临时缓冲逐字节零扩展 → i64 元素缓冲 tb[i*8]。
        // 注意：不能写 `while k < size`（k/size 是 IR 值 id，编译期数值比较无
        // 意义，循环体不会生成）——必须手排 运行时循环（k 存槽 + cond_br 回边）。
        g_cur_block = bt2
        var e8 = tig_int_lit(8)
        var tb = s21_raw_alloc_str(s21_bin(2, size, e8))
        var kslot = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(kslot, T64, 2)
        var ksv = ir.get_value(kslot)  // 槽值 id（不能直接用 inst id，否则 def/use 编号错位）
        s21_store(ksv, tig_int_lit(0), T64)  // k = 0（槽初始）
        var hd = ir.new_block(g_cur_func, interner.intern("bt.r.h"))
        var bd = ir.new_block(g_cur_func, interner.intern("bt.r.lb"))
        var ex = ir.new_block(g_cur_func, interner.intern("bt.r.le"))
        var brh = ir.new_inst(g_cur_block, 30, -1)  // br hd
        ir.add_operand(brh, hd, 1)
        g_cur_block = hd
        var kc = tig_icmp_c(s21_load(ksv, T64), size, 2)  // k < size（运行时）
        var cbl = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cbl, kc, 0)
        ir.add_operand(cbl, bd, 1)
        ir.add_operand(cbl, ex, 1)
        g_cur_block = bd
        var kv = s21_load(ksv, T64)
        var bv = s21_load(s21_gep(tmp, kv, false), I8)
        var ev = s21_zext(bv, I8)
        s21_store(s21_gep(tb, s21_bin(2, kv, e8), false), ev, T64)
        s21_store(ksv, s21_bin(0, kv, tig_int_lit(1)), T64)  // k++
        var brb = ir.new_inst(g_cur_block, 30, -1)  // 回边 br hd
        ir.add_operand(brb, hd, 1)
        g_cur_block = ex
        tig_bt_fclose(f)
        tig_ext_call1("free", tmp, types.named(TK_STR), -1)
        var h = s21_raw_alloc_str(tig_int_lit(32))
        s21_store(s21_gep(h, 0, true), size, T64)    // cap
        s21_store(s21_gep(h, 8, true), size, T64)    // len
        s21_store(s21_gep(h, 16, true), tb, types.named(TK_STR))  // data
        s21_store(s21_gep(h, 24, true), e8, T64)     // esz = 8
        s21_store(sv, h, types.named(TK_STR))
        var brm = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brm, mg, 1)
        g_cur_block = mg
        return s21_load(sv, types.named(TK_STR))
    }

    // byte_write(path, t)：字节表覆盖写文件（"wb"）。成功 true / 失败 false。
    // 数据缓冲元素为 i64（0..255），逐元素截取低字节（& 0xFF）转 u8 缓冲再整块
    // fwrite——写出的正是 len 个字节，与 byte_read 读回往返一致（元素高字节不落盘）。
    func tig_byte_write(p: i64, t: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I8 = types.named(TK_I8)
        var P8 = types.ptr_of(I8)
        var len = s21_load(s21_gep(t, 8, true), T64)
        var data = t21_data(t)
        var esz = t21_esz(t)
        // i64 元素 → u8 连续缓冲（低字节 & 0xFF 截断）。运行时循环（槽 + 回边），
        // 不能写 `while k < len`（k/len 是 IR 值 id，编译期比较无意义，见 byte_read）
        var nbuf = s21_raw_alloc_str(len)
        var kslot = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(kslot, T64, 2)
        var ksv = ir.get_value(kslot)  // 槽值 id（不能用 inst id）
        s21_store(ksv, tig_int_lit(0), T64)  // k = 0
        var hd = ir.new_block(g_cur_func, interner.intern("bt.w.h"))
        var bd = ir.new_block(g_cur_func, interner.intern("bt.w.lb"))
        var ex = ir.new_block(g_cur_func, interner.intern("bt.w.le"))
        var brh = ir.new_inst(g_cur_block, 30, -1)  // br hd
        ir.add_operand(brh, hd, 1)
        g_cur_block = hd
        var kc = tig_icmp_c(s21_load(ksv, T64), len, 2)  // k < len
        var cbl = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cbl, kc, 0)
        ir.add_operand(cbl, bd, 1)
        ir.add_operand(cbl, ex, 1)
        g_cur_block = bd
        var kv = s21_load(ksv, T64)
        var el = s21_load(s21_gep(data, s21_bin(2, kv, esz), false), T64)
        var lo = s21_bin(6, el, tig_int_lit(255))  // & 0xFF（and）
        s21_store(s21_gep(nbuf, kv, false), s21_trunc_i8(lo), I8)
        s21_store(ksv, s21_bin(0, kv, tig_int_lit(1)), T64)  // k++
        var brb = ir.new_inst(g_cur_block, 30, -1)  // 回边
        ir.add_operand(brb, hd, 1)
        g_cur_block = ex
        var f = tig_ext_call2("fopen", p, types.named(TK_STR),
            tig_bt_mode2(119, 98), types.named(TK_STR), P8)  // "wb"
        var okf = tig_cmp_zero(f, 1)  // f != null
        // 布尔结果槽（i8 0/1）
        var slot = ir.new_inst(g_cur_block, 20, I8)
        ir.add_operand(slot, I8, 2)
        var sv = ir.get_value(slot)
        var wb = ir.new_block(g_cur_func, interner.intern("bt.w.b"))
        var wf = ir.new_block(g_cur_func, interner.intern("bt.w.f"))
        var wm = ir.new_block(g_cur_func, interner.intern("bt.w.m"))
        var cw = ir.new_inst(g_cur_block, 31, -1)  // cond_br okf → wb / wf
        ir.add_operand(cw, okf, 0)
        ir.add_operand(cw, wb, 1)
        ir.add_operand(cw, wf, 1)
        // 写路径：fwrite 全量（空表 len=0 → 计数 0==0 → true）+ fclose
        g_cur_block = wb
        var cnt = tig_bt_fwrite(nbuf, len, f)
        var okw = tig_icmp_c(cnt, len, 0)  // 写满 == len
        s21_store(sv, s21_trunc_i8(s21_zext(okw, types.named(TK_BOOL))), I8)
        tig_bt_fclose(f)
        tig_ext_call1("free", nbuf, types.named(TK_STR), -1)
        var brwp = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brwp, wm, 1)
        // 失败：fopen 失败 → false
        g_cur_block = wf
        s21_store(sv, tig_int_lit_ty(0, I8), I8)
        tig_ext_call1("free", nbuf, types.named(TK_STR), -1)
        var brwf = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brwf, wm, 1)
        g_cur_block = wm
        var r8 = s21_load(sv, I8)
        return tig_cmp_zero(r8, 1)  // ne 0 → bool
    }

    // bit_read(t, pos)：LSB 序（第 pos 位 = 第 pos/8 字节第 pos%8 位）→ 0/1。
    // 越界（pos<0 或 pos/8 ≥ 表长）→ 0（std/bytes 文档语义；避免越界加载）。
    func tig_bit_read(t: i64, pos: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var len = s21_load(s21_gep(t, 8, true), T64)
        var e8 = tig_int_lit(8)
        var bidx = s21_bin(3, pos, e8)  // sdiv pos/8
        var pneg = tig_icmp_c(pos, tig_int_lit(0), 2)  // pos < 0
        var bidx_u = tig_icmp_c(bidx, len, 6)          // bidx ult len（unsigned 负防漏）
        var valid = tig_and_i1(tig_not_i1(pneg), bidx_u)
        // 结果槽（i64）
        var slot = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(slot, T64, 2)
        var sv = ir.get_value(slot)
        var bt = ir.new_block(g_cur_func, interner.intern("bt.b.ok"))
        var be = ir.new_block(g_cur_func, interner.intern("bt.b.oob"))
        var mg = ir.new_block(g_cur_func, interner.intern("bt.b.m"))
        var cb = ir.new_inst(g_cur_block, 31, -1)  // cond_br valid → bt / be
        ir.add_operand(cb, valid, 0)
        ir.add_operand(cb, bt, 1)
        ir.add_operand(cb, be, 1)
        // 越界 → 0（不加载）
        g_cur_block = be
        s21_store(sv, tig_int_lit(0), T64)
        var br2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br2, mg, 1)
        // 命中：elt >> (pos%8) & 1（elt 0..255，ashr/lshr 等价）
        g_cur_block = bt
        var elt = s21_load(s21_gep(t21_data(t), s21_bin(2, bidx, e8), false), T64)
        var bitn = s21_bin(4, pos, e8)  // srem pos%8
        var sh = ir.new_inst(g_cur_block, 11, T64)  // shr
        ir.add_operand(sh, elt, 0)
        ir.add_operand(sh, bitn, 0)
        var bv = s21_bin(6, ir.get_value(sh), tig_int_lit(1))  // & 1
        s21_store(sv, bv, T64)
        var br1 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br1, mg, 1)
        g_cur_block = mg
        return s21_load(sv, T64)
    }

    // bit_write(t, pos, bit)：写第 pos 位为 bit（0/1），就地改表；成功 true，
    // 越界（pos<0 或 pos/8 ≥ 表长）返回 false 且不改表。
    // 位改写：mask = 1 << bitn；newv = (elt & ~mask) | ((bit & 1) << bitn)。
    func tig_bit_write(t: i64, pos: i64, bit: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I8 = types.named(TK_I8)
        var len = s21_load(s21_gep(t, 8, true), T64)
        var e8 = tig_int_lit(8)
        var bidx = s21_bin(3, pos, e8)
        var pneg = tig_icmp_c(pos, tig_int_lit(0), 2)
        var bidx_u = tig_icmp_c(bidx, len, 6)
        var valid = tig_and_i1(tig_not_i1(pneg), bidx_u)
        // 布尔结果槽（i8 0/1）
        var slot = ir.new_inst(g_cur_block, 20, I8)
        ir.add_operand(slot, I8, 2)
        var sv = ir.get_value(slot)
        var bt = ir.new_block(g_cur_func, interner.intern("bt.w2.ok"))
        var be = ir.new_block(g_cur_func, interner.intern("bt.w2.oob"))
        var mg = ir.new_block(g_cur_func, interner.intern("bt.w2.m"))
        var cb = ir.new_inst(g_cur_block, 31, -1)  // cond_br valid → bt / be
        ir.add_operand(cb, valid, 0)
        ir.add_operand(cb, bt, 1)
        ir.add_operand(cb, be, 1)
        // 越界 → false（不改表）
        g_cur_block = be
        s21_store(sv, tig_int_lit_ty(0, I8), I8)
        var br2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br2, mg, 1)
        // 命中：读改写位
        g_cur_block = bt
        var od = s21_gep(t21_data(t), s21_bin(2, bidx, e8), false)
        var elt = s21_load(od, T64)
        var bitn = s21_bin(4, pos, e8)  // srem pos%8
        var one = tig_int_lit(1)
        var mask = s21_bin(10, one, bitn)        // shl 1<<bitn
        var bitv0 = s21_bin(6, bit, one)         // bit & 1
        var bitv = s21_bin(10, bitv0, bitn)      // shl（bit 位值移位）
        var notm = s21_bin(8, mask, tig_int_lit(-1))  // xor ~mask
        var cleared = s21_bin(6, elt, notm)      // and 清位
        var nv = s21_bin(7, cleared, bitv)       // or 置位
        s21_store(od, nv, T64)
        s21_store(sv, tig_int_lit_ty(1, I8), I8)
        var br1 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br1, mg, 1)
        g_cur_block = mg
        var r8 = s21_load(sv, I8)
        return tig_cmp_zero(r8, 1)  // ne 0 → bool
    }

    // byte_concat(a, b)：拼接两个字节表 → 新表（a 元素在前 b 在后，不动入参）。
    // 纯内存：新数据缓冲 = malloc((len_a+len_b)*esz) + 两段 memcpy；零外部依赖。
    func tig_byte_concat(a: i64, b: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var la = s21_load(s21_gep(a, 8, true), T64)
        var lb = s21_load(s21_gep(b, 8, true), T64)
        var da = t21_data(a)
        var db = t21_data(b)
        var esz = t21_esz(a)
        var n = s21_bin(0, la, lb)
        var ab = s21_bin(2, la, esz)
        var buf = s21_raw_alloc_str(s21_bin(2, n, esz))
        s21_memcpy_if(buf, da, ab)                     // 段 A（la 元素，空表 data null 保护）
        s21_memcpy_if(s21_gep(buf, ab, false), db, s21_bin(2, lb, esz))  // 段 B
        var h = s21_raw_alloc_str(tig_int_lit(32))
        s21_store(s21_gep(h, 0, true), n, T64)    // cap
        s21_store(s21_gep(h, 8, true), n, T64)    // len
        s21_store(s21_gep(h, 16, true), buf, types.named(TK_STR))  // data
        s21_store(s21_gep(h, 24, true), esz, T64)  // esz
        return h
    }
    // ============ p.6.4.1 内联基础原语 + UTF-16 宽字符桥 ============
    // 新基础设施：UTF-16 宽字符转换（Windows 系统调用面）。tie 字符串为 UTF-8
    //（{8 字节长度头}{数据}{\0}）；SetEnvironmentVariableW / CommandLineToArgvW /
    // GetCurrentDirectoryW 等需要 UTF-16LE（wchar_t*）。编译器后端不能 import
    // std/utf.tie，故在 IR 层手排「码点解码 + 代理对编码」（本组辅助全部生成普通
    // tie-IR 指令；零 Rust 桥、零 tie_interp.lib；UTF-8 逐字节序列判定复用
    // s21_utf8_seq_len / s21_utf8_char_at，代理对编码按 Unicode 规范）。

    func tig_w16_append(hv: i64, u: i64) {
        var lo = s21_bin(6, u, tig_int_lit(0xFF))  // u & 0xFF
        s21_sb_append_byte(hv, lo)
        var hi = s21_bin(6, s21_bin(11, u, tig_int_lit(8)), tig_int_lit(0xFF))  // (u>>8)&0xFF
        s21_sb_append_byte(hv, hi)
    }

    func tig_w16_append_cp(hv: i64, cp: i64) {
        var T64 = types.named(TK_I64)
        var is_sup = tig_cmp_const(cp, 3, 0xFFFF, T64)   // cp > 0xFFFF
        var b_s = ir.new_block(g_cur_func, interner.intern("w16.cp.s"))
        var b_b = ir.new_block(g_cur_func, interner.intern("w16.cp.b"))
        var b_m = ir.new_block(g_cur_func, interner.intern("w16.cp.m"))
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, is_sup, 0)
        ir.add_operand(cb, b_s, 1)
        ir.add_operand(cb, b_b, 1)
        g_cur_block = b_s
        var cp2 = s21_bin(1, cp, tig_int_lit(0x10000))  // sub
        var hi_s = s21_bin(7, tig_int_lit(0xD800), s21_bin(6, s21_bin(11, cp2, tig_int_lit(10)), tig_int_lit(0x3FF)))
        var lo_s = s21_bin(7, tig_int_lit(0xDC00), s21_bin(6, cp2, tig_int_lit(0x3FF)))
        tig_w16_append(hv, hi_s)
        tig_w16_append(hv, lo_s)
        var br1 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br1, b_m, 1)
        g_cur_block = b_b
        tig_w16_append(hv, cp)
        var br2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br2, b_m, 1)
        g_cur_block = b_m
    }

    func tig_wide16(s: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var blen = s21_str_head_len(s)
        var hv = s21_sb_new()
        var pa = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(pa, T64, 2)
        var pp = ir.get_value(pa)
        s21_store(pp, tig_int_lit(0), T64)   // pos（UTF-8 字节偏移）
        var hd = ir.new_block(g_cur_func, interner.intern("w16.h"))
        var bd = ir.new_block(g_cur_func, interner.intern("w16.b"))
        var ex = ir.new_block(g_cur_func, interner.intern("w16.x"))
        var br0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br0, hd, 1)
        g_cur_block = hd
        var pv = s21_load(pp, T64)
        var pc = tig_icmp_c(pv, blen, 2)     // pos < blen
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, pc, 0)
        ir.add_operand(cb, bd, 1)
        ir.add_operand(cb, ex, 1)
        g_cur_block = bd
        var p2 = s21_load(pp, T64)
        var seql = s21_utf8_seq_len(s, p2)
        var cp = s21_utf8_char_at(s, p2)
        tig_w16_append_cp(hv, cp)
        s21_store(pp, s21_bin(0, p2, seql), T64)   // pos += 序列长度
        var brb = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brb, hd, 1)
        g_cur_block = ex
        tig_w16_append(hv, tig_int_lit(0))   // u16 NUL 终止符
        return s21_sb_build(hv)
    }
    func tig_cp_utf8_append(hv: i64, cp: i64) {
        var T64 = types.named(TK_I64)
        var l1 = ir.new_block(g_cur_func, interner.intern("u8.l1"))
        var l2c = ir.new_block(g_cur_func, interner.intern("u8.2c"))
        var l2 = ir.new_block(g_cur_func, interner.intern("u8.l2"))
        var l3c = ir.new_block(g_cur_func, interner.intern("u8.3c"))
        var l3 = ir.new_block(g_cur_func, interner.intern("u8.l3"))
        var l4 = ir.new_block(g_cur_func, interner.intern("u8.l4"))
        var mg = ir.new_block(g_cur_func, interner.intern("u8.m"))
        var c1 = tig_cmp_const(cp, 4, 0x7F, T64)   // cp <= 0x7F
        var cb1 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb1, c1, 0)
        ir.add_operand(cb1, l1, 1)
        ir.add_operand(cb1, l2c, 1)
        g_cur_block = l1
        s21_sb_append_byte(hv, cp)
        var br1 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br1, mg, 1)
        g_cur_block = l2c
        var c2 = tig_cmp_const(cp, 4, 0x7FF, T64)
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, c2, 0)
        ir.add_operand(cb2, l2, 1)
        ir.add_operand(cb2, l3c, 1)
        g_cur_block = l2
        s21_sb_append_byte(hv, s21_bin(7, tig_int_lit(0xC0), s21_bin(6, s21_bin(11, cp, tig_int_lit(6)), tig_int_lit(0x1F))))
        s21_sb_append_byte(hv, s21_bin(7, tig_int_lit(0x80), s21_bin(6, cp, tig_int_lit(0x3F))))
        var br2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br2, mg, 1)
        g_cur_block = l3c
        var c3 = tig_cmp_const(cp, 4, 0xFFFF, T64)
        var cb3 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb3, c3, 0)
        ir.add_operand(cb3, l3, 1)
        ir.add_operand(cb3, l4, 1)
        g_cur_block = l3
        s21_sb_append_byte(hv, s21_bin(7, tig_int_lit(0xE0), s21_bin(6, s21_bin(11, cp, tig_int_lit(12)), tig_int_lit(0x0F))))
        s21_sb_append_byte(hv, s21_bin(7, tig_int_lit(0x80), s21_bin(6, s21_bin(11, cp, tig_int_lit(6)), tig_int_lit(0x3F))))
        s21_sb_append_byte(hv, s21_bin(7, tig_int_lit(0x80), s21_bin(6, cp, tig_int_lit(0x3F))))
        var br3 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br3, mg, 1)
        g_cur_block = l4
        s21_sb_append_byte(hv, s21_bin(7, tig_int_lit(0xF0), s21_bin(6, s21_bin(11, cp, tig_int_lit(18)), tig_int_lit(0x07))))
        s21_sb_append_byte(hv, s21_bin(7, tig_int_lit(0x80), s21_bin(6, s21_bin(11, cp, tig_int_lit(12)), tig_int_lit(0x3F))))
        s21_sb_append_byte(hv, s21_bin(7, tig_int_lit(0x80), s21_bin(6, s21_bin(11, cp, tig_int_lit(6)), tig_int_lit(0x3F))))
        s21_sb_append_byte(hv, s21_bin(7, tig_int_lit(0x80), s21_bin(6, cp, tig_int_lit(0x3F))))
        var br4 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br4, mg, 1)
        g_cur_block = mg
    }

    func tig_from_wide16(w: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I8 = types.named(TK_I8)
        var hv = s21_sb_new()
        var ia = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(ia, T64, 2)
        var ip = ir.get_value(ia)
        s21_store(ip, tig_int_lit(0), T64)   // u16 码元索引 i（字节偏移 = 2*i）
        var hd = ir.new_block(g_cur_func, interner.intern("w2o.h"))
        var chk = ir.new_block(g_cur_func, interner.intern("w2o.hi"))
        var pl = ir.new_block(g_cur_func, interner.intern("w2o.pl"))
        var ex = ir.new_block(g_cur_func, interner.intern("w2o.x"))
        var b_cb = ir.new_block(g_cur_func, interner.intern("w2o.cb"))
        var b_ff = ir.new_block(g_cur_func, interner.intern("w2o.ff"))
        var b_mh = ir.new_block(g_cur_func, interner.intern("w2o.mh"))
        var br0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br0, hd, 1)
        g_cur_block = hd
        var iv = s21_load(ip, T64)
        var off = s21_bin(2, iv, tig_int_lit(2))
        var lo = s21_zext(s21_load(s21_gep(w, off, false), I8), I8)
        var hi_b = s21_zext(s21_load(s21_gep(w, s21_bin(0, off, tig_int_lit(1)), false), I8), I8)
        var u = s21_bin(7, lo, s21_bin(10, hi_b, tig_int_lit(8)))   // u16 码元
        var nul = tig_cmp_zero(u, 0)              // u == 0 → 串结束
        var cb_n = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb_n, nul, 0)
        ir.add_operand(cb_n, ex, 1)
        ir.add_operand(cb_n, chk, 1)
        g_cur_block = chk   // 非 NUL：判定高代理（u>=0xD800 && u<=0xDBFF）
        var ge_h = tig_icmp_c(u, tig_int_lit(0xD800), 5)
        var le_h = tig_icmp_c(u, tig_int_lit(0xDBFF), 4)
        var is_high = tig_and_i1(ge_h, le_h)
        var hi2 = ir.new_block(g_cur_func, interner.intern("w2o.hi2"))
        var cb_high = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb_high, is_high, 0)
        ir.add_operand(cb_high, hi2, 1)   // 高代理 → hi2（读次码元 u2）
        ir.add_operand(cb_high, pl, 1)
        g_cur_block = pl   // 普通 BMP 码元
        tig_cp_utf8_append(hv, u)
        s21_store(ip, s21_bin(0, iv, tig_int_lit(1)), T64)
        var br1 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br1, b_mh, 1)
        g_cur_block = hi2   // 高代理：读次 u2；低代理 → 组合；否则 U+FFFD
        var iv2 = s21_load(ip, T64)
        var off2 = s21_bin(2, iv2, tig_int_lit(2))
        var lo2 = s21_zext(s21_load(s21_gep(w, off2, false), I8), I8)
        var hi2b = s21_zext(s21_load(s21_gep(w, s21_bin(0, off2, tig_int_lit(1)), false), I8), I8)
        var u2 = s21_bin(7, lo2, s21_bin(10, hi2b, tig_int_lit(8)))
        var ge_l = tig_icmp_c(u2, tig_int_lit(0xDC00), 5)
        var le_l = tig_icmp_c(u2, tig_int_lit(0xDFFF), 4)
        var is_low = tig_and_i1(ge_l, le_l)
        var cb_l = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb_l, is_low, 0)
        ir.add_operand(cb_l, b_cb, 1)
        ir.add_operand(cb_l, b_ff, 1)
        g_cur_block = b_cb   // 组合：cp = 0x10000 + ((u-0xD800)<<10 | (u2-0xDC00))
        var cu = s21_bin(1, u, tig_int_lit(0xD800))
        var cu2 = s21_bin(1, u2, tig_int_lit(0xDC00))
        var comb = s21_bin(0, tig_int_lit(0x10000), s21_bin(7, s21_bin(10, cu, tig_int_lit(10)), cu2))
        tig_cp_utf8_append(hv, comb)
        s21_store(ip, s21_bin(0, iv2, tig_int_lit(2)), T64)   // i += 2
        var br2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br2, b_mh, 1)
        g_cur_block = b_ff   // 孤立代理 → 替换符；i += 1
        tig_cp_utf8_append(hv, tig_int_lit(0xFFFD))
        s21_store(ip, s21_bin(0, iv2, tig_int_lit(1)), T64)
        var br3 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br3, b_mh, 1)
        g_cur_block = b_mh
        var br4 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br4, hd, 1)
        g_cur_block = ex
        return s21_sb_build(hv)
    }

    // ==================== p.6.4.6 进程捕获：exec_output 内联 ====================
    // exec_output(cmd) → 捕获子进程 stdout 到 EOF 返回（失败返回 ""）。从 Rust 桥
    // （tie_exec_output，g_used_interp 置位）改为编译器内联 IR 直调 Win32 管道：
    //   CreatePipe（读端父用 + 写端设可继承）→ SetHandleInformation → CreateProcessW
    //   （宽 cmd 经 tig_wide16；STARTUPINFOW 手工 alloc 填 offset）→ CloseHandle(写端)
    //   → 循环 ReadFile 读端到 EOF（tig_bytes_to_tie + StringBuilder 拼接）→
    //   CloseHandle(读端/进程/线程) → 返回输出串。
    // 全 kernel32 符号（is_libc_sym 免 interp 链接），零 Rust 桥、零 g_used_interp。
    // 结构体布局（对齐 trm platform_win32 repo 先例，repr(C) 64 位）：
    //   STARTUPINFOW sizeof=104：cb@0、dwFlags@60、hStdInput@80、hStdOutput@88、hStdError@96
    //   PROCESS_INFORMATION sizeof=24：hProcess@0、hThread@8、dwProcessId@16、dwThreadId@20
    func tig_exec_output_inline(cmd: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var I8 = types.named(TK_I8)
        var P8 = types.ptr_of(I8)
        var nulp = tig_null_ptr()
        // 结果槽（string，默认空串）
        var rs = ir.new_inst(g_cur_block, 20, types.named(TK_STR))
        ir.add_operand(rs, types.named(TK_STR), 2)
        var rp = ir.get_value(rs)
        s21_store(rp, tig_str_lit(interner.intern("\"\"")), types.named(TK_STR))
        // 句柄/读计数槽 + 缓冲
        var hr_a = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(hr_a, T64, 2)
        var hrp = ir.get_value(hr_a)
        var hw_a = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(hw_a, T64, 2)
        var hwp = ir.get_value(hw_a)
        var rc_a = ir.new_inst(g_cur_block, 20, I32)
        ir.add_operand(rc_a, I32, 2)
        var rcp = ir.get_value(rc_a)
        var buf = s21_raw_alloc_str(tig_int_lit(4096))
        var si = s21_raw_alloc_str(tig_int_lit(104))
        var pi = s21_raw_alloc_str(tig_int_lit(24))
        var wcmd = tig_wide16(cmd)
        var sb = s21_sb_new()
        // CreatePipe(&hr, &hw, NULL, 0)
        var ats0: table<i64> = table_new_i64()
        var avs0: table<i64> = table_new_i64()
        table_push(ats0, P8);  table_push(avs0, hrp)
        table_push(ats0, P8);  table_push(avs0, hwp)
        table_push(ats0, P8);  table_push(avs0, nulp)
        table_push(ats0, I32); table_push(avs0, tig_int_lit_ty(0, I32))
        var cp = tig_ext_call_typed("CreatePipe", ats0, avs0, I32)
        var okp = tig_win_ok(cp)
        var b_bad0 = ir.new_block(g_cur_func, interner.intern("eo.bad0"))
        var b_ppipe = ir.new_block(g_cur_func, interner.intern("eo.pipe"))
        var b_m = ir.new_block(g_cur_func, interner.intern("eo.m"))
        var cb0 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb0, okp, 0)
        ir.add_operand(cb0, b_ppipe, 1)
        ir.add_operand(cb0, b_bad0, 1)
        // 失败（CreatePipe）：free 缓冲 → merge（结果保持空串）
        g_cur_block = b_bad0
        tig_ext_call1("free", buf, types.named(TK_STR), -1)
        tig_ext_call1("free", si, types.named(TK_STR), -1)
        tig_ext_call1("free", pi, types.named(TK_STR), -1)
        var br0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br0, b_m, 1)
        // 建管成功：置可继承位，填 STARTUPINFOW，CreateProcessW
        g_cur_block = b_ppipe
        var hv_hr = s21_load(hrp, T64)
        var hv_hw = s21_load(hwp, T64)
        var ats1: table<i64> = table_new_i64()
        var avs1: table<i64> = table_new_i64()
        table_push(ats1, T64); table_push(avs1, hv_hw)
        table_push(ats1, I32); table_push(avs1, tig_int_lit_ty(1, I32))
        table_push(ats1, I32); table_push(avs1, tig_int_lit_ty(1, I32))
        tig_ext_call_typed("SetHandleInformation", ats1, avs1, I32)
        // 填 STARTUPINFOW：cb@0=104、dwFlags@60=0x100、hStdOutput@88、hStdError@96
        var atsm: table<i64> = table_new_i64()
        var avsm: table<i64> = table_new_i64()
        table_push(atsm, P8); table_push(avsm, si)
        table_push(atsm, I8); table_push(avsm, tig_int_lit_ty(0, I8))
        table_push(atsm, T64); table_push(avsm, tig_int_lit(104))
        tig_ext_call_typed("memset", atsm, avsm, -1)
        s21_store(s21_gep(si, 0, true), tig_int_lit_ty(104, I32), I32)    // cb
        s21_store(s21_gep(si, 60, true), tig_int_lit_ty(0x100, I32), I32) // dwFlags
        s21_store(s21_gep(si, 80, true), tig_int_lit_ty(0, T64), T64)  // hStdInput=0（占位）
        s21_store(s21_gep(si, 88, true), hv_hw, T64)   // hStdOutput
        s21_store(s21_gep(si, 96, true), hv_hw, T64)   // hStdError
        // CreateProcessW(NULL, wcmd, NULL, NULL, TRUE, 0, NULL, NULL, &si, &pi)
        var ats2: table<i64> = table_new_i64()
        var avs2: table<i64> = table_new_i64()
        table_push(ats2, P8);  table_push(avs2, nulp)
        table_push(ats2, P8);  table_push(avs2, wcmd)
        table_push(ats2, P8);  table_push(avs2, nulp)
        table_push(ats2, P8);  table_push(avs2, nulp)
        table_push(ats2, I32); table_push(avs2, tig_int_lit_ty(1, I32))   // bInheritHandles
        table_push(ats2, I32); table_push(avs2, tig_int_lit_ty(0, I32))   // dwCreationFlags
        table_push(ats2, P8);  table_push(avs2, nulp)
        table_push(ats2, P8);  table_push(avs2, nulp)
        table_push(ats2, P8);  table_push(avs2, si)
        table_push(ats2, P8);  table_push(avs2, pi)
        var cw = tig_ext_call_typed("CreateProcessW", ats2, avs2, I32)
        var okw = tig_win_ok(cw)
        var b_bad2 = ir.new_block(g_cur_func, interner.intern("eo.bad2"))
        var b_loop = ir.new_block(g_cur_func, interner.intern("eo.lp"))
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, okw, 0)
        ir.add_operand(cb2, b_loop, 1)
        ir.add_operand(cb2, b_bad2, 1)
        // 失败（CreateProcessW）：关句柄 + free → merge
        g_cur_block = b_bad2
        tig_ext_call1("CloseHandle", hv_hr, T64, I32)
        tig_ext_call1("CloseHandle", hv_hw, T64, I32)
        tig_ext_call1("free", buf, types.named(TK_STR), -1)
        tig_ext_call1("free", si, types.named(TK_STR), -1)
        tig_ext_call1("free", pi, types.named(TK_STR), -1)
        var br2b = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br2b, b_m, 1)
        // 启动成功：父关写端 → 循环读 stdout 到 EOF
        g_cur_block = b_loop
        tig_ext_call1("CloseHandle", hv_hw, T64, I32)
        var b_rd = ir.new_block(g_cur_func, interner.intern("eo.rd"))
        var b_ap = ir.new_block(g_cur_func, interner.intern("eo.ap"))
        var b_x = ir.new_block(g_cur_func, interner.intern("eo.x"))
        // 读循环头（b_loop 即循环体起点，回边到自身）：
        s21_store(rcp, tig_int_lit_ty(0, I32), I32)
        var ats3: table<i64> = table_new_i64()
        var avs3: table<i64> = table_new_i64()
        table_push(ats3, T64); table_push(avs3, hv_hr)
        table_push(ats3, P8);  table_push(avs3, buf)
        table_push(ats3, I32); table_push(avs3, tig_int_lit_ty(4096, I32))
        table_push(ats3, P8);  table_push(avs3, rcp)
        table_push(ats3, P8);  table_push(avs3, nulp)
        var rf = tig_ext_call_typed("ReadFile", ats3, avs3, I32)
        var okr = tig_win_ok(rf)
        var cb3 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb3, okr, 0)
        ir.add_operand(cb3, b_rd, 1)
        ir.add_operand(cb3, b_x, 1)
        // b_rd：ReadFile 成功 → 判读计数
        g_cur_block = b_rd
        var cnt = s21_zext(s21_load(rcp, I32), I32)
        var c0 = tig_cmp_zero(cnt, 0)
        var cb4 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb4, c0, 0)
        ir.add_operand(cb4, b_x, 1)
        ir.add_operand(cb4, b_ap, 1)
        // b_ap：拼接本块字节 → 回边到 b_loop
        g_cur_block = b_ap
        s21_sb_append(sb, tig_bytes_to_tie(buf, cnt))
        var brl = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brl, b_loop, 1)
        // b_x：EOF/出错收尾：关读端 + 等进程退出 + 关进程/线程句柄 + free + 产物
        g_cur_block = b_x
        tig_ext_call1("CloseHandle", hv_hr, T64, I32)
        var ph = s21_load(pi, T64)             // pi.hProcess@0
        var th = s21_load(s21_gep(pi, 8, true), T64)  // pi.hThread@8
        var ats4: table<i64> = table_new_i64()
        var avs4: table<i64> = table_new_i64()
        table_push(ats4, T64); table_push(avs4, ph)
        table_push(ats4, I32); table_push(avs4, tig_int_lit_ty(-1, I32))  // INFINITE (0xFFFFFFFF)
        tig_ext_call_typed("WaitForSingleObject", ats4, avs4, I32)
        tig_ext_call1("CloseHandle", ph, T64, I32)
        tig_ext_call1("CloseHandle", th, T64, I32)
        tig_ext_call1("free", buf, types.named(TK_STR), -1)
        tig_ext_call1("free", si, types.named(TK_STR), -1)
        tig_ext_call1("free", pi, types.named(TK_STR), -1)
        s21_store(rp, s21_sb_build(sb), types.named(TK_STR))
        var brx = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brx, b_m, 1)
        // merge：返回结果槽
        g_cur_block = b_m
        return s21_load(rp, types.named(TK_STR))
    }
    func tig_arg_count() -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var P8 = types.ptr_of(types.named(TK_I8))
        var ats0: table<i64> = table_new_i64()
        var avs0: table<i64> = table_new_i64()
        var cmd = tig_ext_call_typed("GetCommandLineW", ats0, avs0, P8)  // LPCWSTR（零参）
        var na = ir.new_inst(g_cur_block, 20, I32)
        ir.add_operand(na, I32, 2)
        var n_addr = ir.get_value(na)                                    // int* pNumArgs
        var argv = tig_ext_call2("CommandLineToArgvW", cmd, P8, n_addr, P8, P8)  // LPWSTR*
        var n = s21_zext(s21_load(n_addr, I32), I32)                     // argc（含程序名）
        var uc = s21_bin(1, n, tig_int_lit(1))                           // 用户参数 = argc-1
        var uc_neg = tig_cmp_zero(uc, 2)                                 // uc < 0（极端）
        var res = tig_select_i(uc_neg, tig_int_lit(0), uc, T64)
        tig_ext_call1("LocalFree", argv, P8, P8)                         // 释放 LPWSTR*
        return res
    }

    func tig_arg_string(i: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var P8 = types.ptr_of(types.named(TK_I8))
        var ats0: table<i64> = table_new_i64()
        var avs0: table<i64> = table_new_i64()
        var cmd = tig_ext_call_typed("GetCommandLineW", ats0, avs0, P8)
        var na = ir.new_inst(g_cur_block, 20, I32)
        ir.add_operand(na, I32, 2)
        var n_addr = ir.get_value(na)
        var argv = tig_ext_call2("CommandLineToArgvW", cmd, P8, n_addr, P8, P8)
        var n = s21_zext(s21_load(n_addr, I32), I32)                     // 总 argc
        var uc = s21_bin(1, n, tig_int_lit(1))                           // 用户参数个数
        var slot = ir.new_inst(g_cur_block, 20, types.named(TK_STR))
        ir.add_operand(slot, types.named(TK_STR), 2)
        var sv = ir.get_value(slot)
        var empty = tig_str_lit(interner.intern("\"\""))
        s21_store(sv, empty, types.named(TK_STR))                        // 默认空串
        var i_neg = tig_cmp_zero(i, 2)                                   // i < 0
        var i_oob = tig_icmp_c(i, uc, 5)                                 // i >= uc（sge）
        var bad = tig_or_i1(i_neg, i_oob)
        var bt = ir.new_block(g_cur_func, interner.intern("ags.bad"))
        var be = ir.new_block(g_cur_func, interner.intern("ags.ok"))
        var mg = ir.new_block(g_cur_func, interner.intern("ags.m"))
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, bad, 0)
        ir.add_operand(cb, bt, 1)
        ir.add_operand(cb, be, 1)
        g_cur_block = bt
        var br1 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br1, mg, 1)
        g_cur_block = be   // 越界已排除，idx = i+1 ∈ [1, n) 安全
        var idx = s21_bin(0, i, tig_int_lit(1))
        var waddr = s21_gep(argv, s21_bin(2, idx, tig_int_lit(8)), false)  // LPWSTR*[idx]
        var w = s21_load(waddr, types.named(TK_STR))                     // UTF-16LE 串
        var rs = tig_from_wide16(w)
        s21_store(sv, rs, types.named(TK_STR))
        var br2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br2, mg, 1)
        g_cur_block = mg
        tig_ext_call1("LocalFree", argv, P8, P8)
        return s21_load(sv, types.named(TK_STR))
    }

    func tig_cwd() -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var P8 = types.ptr_of(types.named(TK_I8))
        var cap = tig_int_lit(16384)
        var cap32 = tig_int_lit_ty(16384, I32)
        var buf = s21_raw_alloc_str(s21_bin(2, cap, tig_int_lit(2)))     // 2*cap 字节
        tig_ext_call2("GetCurrentDirectoryW", cap32, I32, buf, P8, I32)
        var res = tig_from_wide16(buf)
        tig_ext_call1("free", buf, types.named(TK_STR), -1)
        return res
    }

    func tig_set_env(k: i64, v: i64) {
        var I32 = types.named(TK_I32)
        var P8 = types.ptr_of(types.named(TK_I8))
        var kw = tig_wide16(k)
        var vw = tig_wide16(v)
        tig_ext_call2("SetEnvironmentVariableW", kw, P8, vw, P8, I32)  // BOOL；忽略
    }

    func tig_print_err(v: i64) {
        var I32 = types.named(TK_I32)
        var len = s21_str_head_len(v)
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, I32)
        table_push(avs, tig_int_lit_ty(2, I32))   // fd = stderr
        table_push(ats, types.named(TK_STR))
        table_push(avs, v)
        table_push(ats, types.named(TK_I64))
        table_push(avs, len)                      // 字节数（低 32 位被 _write 读取）
        tig_ext_call_typed("_write", ats, avs, -1)  // void（返回写入字节数，忽略）
    }

    // ==================== p.6.4.10 read_line 内联（stdin 行读取，去 Rust 桥） ====================
    // read_line() -> string：GetStdHandle(STD_INPUT_HANDLE=-10) + ReadFile 逐字节读到
    // \n（单独）或 EOF（返回已收集串，无输入时空串）。Windows 控制台 ReadFile 也会把
    // 回车 \r\n 带进缓冲，此处规整：\r（13）跳过、\n（10）终结；支持管道（无缓冲）输入
    // 脚本交互（`echo hello | probe` → "hello"）。全 kernel32 符号（is_libc_sym 免
    // interp 链接），零 Rust 桥、零 g_used_interp。
    func tig_read_line() -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var I8 = types.named(TK_I8)
        var P8 = types.ptr_of(types.named(TK_I8))
        var nulp = tig_null_ptr()
        // 结果槽：默认空串（EOF/无输入）
        var rs = ir.new_inst(g_cur_block, 20, types.named(TK_STR))
        ir.add_operand(rs, types.named(TK_STR), 2)
        var rp = ir.get_value(rs)
        s21_store(rp, tig_str_lit(interner.intern("\"\"")), types.named(TK_STR))
        // stdin 句柄 + 单字节缓冲 + 读计数槽 + 行构建器
        var h = tig_ext_call1("GetStdHandle", tig_int_lit_ty(-10, I32), I32, P8)
        var ba = ir.new_inst(g_cur_block, 20, I8)
        ir.add_operand(ba, I8, 2)
        var bp = ir.get_value(ba)
        var ra = ir.new_inst(g_cur_block, 20, I32)
        ir.add_operand(ra, I32, 2)
        var rcp = ir.get_value(ra)
        var sb = s21_sb_new()
        // 读循环：ReadFile(h, &c, 1, &nread, NULL)
        var b_lp = ir.new_block(g_cur_func, interner.intern("rl.lp"))
        var b_rd = ir.new_block(g_cur_func, interner.intern("rl.rd"))
        var b_ch = ir.new_block(g_cur_func, interner.intern("rl.ch"))
        var b_cr = ir.new_block(g_cur_func, interner.intern("rl.cr"))
        var b_ap = ir.new_block(g_cur_func, interner.intern("rl.ap"))
        var b_ex = ir.new_block(g_cur_func, interner.intern("rl.ex"))
        var b_mg = ir.new_block(g_cur_func, interner.intern("rl.m"))
        var b0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(b0, b_lp, 1)
        g_cur_block = b_lp
        s21_store(rcp, tig_int_lit_ty(0, I32), I32)
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, P8);  table_push(avs, h)
        table_push(ats, P8);  table_push(avs, bp)
        table_push(ats, I32); table_push(avs, tig_int_lit_ty(1, I32))
        table_push(ats, P8);  table_push(avs, rcp)
        table_push(ats, P8);  table_push(avs, nulp)
        var rf = tig_ext_call_typed("ReadFile", ats, avs, I32)
        var okr = tig_win_ok(rf)
        var cb0 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb0, okr, 0)
        ir.add_operand(cb0, b_rd, 1)
        ir.add_operand(cb0, b_ex, 1)   // ReadFile 失败 → EOF 收尾
        // 成功：判读计数（0=EOF → 收尾；否则检查字节）
        g_cur_block = b_rd
        var c0 = tig_cmp_zero(s21_zext(s21_load(rcp, I32), I32), 0)
        var cb1 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb1, c0, 0)
        ir.add_operand(cb1, b_ex, 1)
        ir.add_operand(cb1, b_ch, 1)
        // 判字节：\n(10) → 收尾；\r(13) → 跳过回边；其余追加
        g_cur_block = b_ch
        var c = s21_zext(s21_load(bp, I8), I8)
        var isnl = tig_icmp_c(c, tig_int_lit(10), 0)
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, isnl, 0)
        ir.add_operand(cb2, b_ex, 1)
        ir.add_operand(cb2, b_cr, 1)
        g_cur_block = b_cr
        var iscr = tig_icmp_c(c, tig_int_lit(13), 0)
        var cb3 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb3, iscr, 0)
        ir.add_operand(cb3, b_lp, 1)
        ir.add_operand(cb3, b_ap, 1)
        g_cur_block = b_ap
        s21_sb_append_byte(sb, c)
        var brl = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brl, b_lp, 1)
        // 收尾：行构建器 → 结果槽
        g_cur_block = b_ex
        s21_store(rp, s21_sb_build(sb), types.named(TK_STR))
        var brx = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brx, b_mg, 1)
        g_cur_block = b_mg
        return s21_load(rp, types.named(TK_STR))
    }

    // ==================== p.6.4.7 消息系统原语（纯 tie，运行期全局表） ====================
    // 原 tie_msg_* Rust 桥（g_used_interp=true）改为编译器内联：状态 = 运行期程序
    // 全局槽（惰性登记，仅含 msg_* 的程序才生成；对齐「编译器给用户程序建全局变量」）：
    //   @__msg_lang  : string        当前语言（默认 ""，对齐原 Rust 桥初始态）
    //   @__msg_keys  : table<string> 键平行表
    //   @__msg_langs : table<string> 语言平行表
    //   @__msg_texts : table<string> 文本平行表
    // 语义：msg_register(key,lang,text) 线性扫 (key,lang) 命中覆盖 texts[i] 未命中
    // 三表 append；msg_t(key) 按当前语言查未命中返 key；msg_t_lang(key,lang) 按指定
    // 语言查未命中返空串 ""（对齐 Rust 桥原语义，ext/log 回退链 lookup 依赖）。
    // msg_set_lang/msg_get_lang 读写 @__msg_lang。
    // 模块级惰性登记标记 g_msg_reg_done 声明见 irgen.tie（文件顶层，每模块一次重置）。

    // 惰性登记 msg 全局槽（首次 msg_* 调用时；幂等）
    func tig_msg_reg_globals() {
        if g_msg_reg_done == 1 {
            return
        }
        g_msg_reg_done = 1
        llvmgen.global_scalar_reg("__msg_lang", types.named(TK_STR))
        llvmgen.global_table_reg("__msg_keys")
        llvmgen.global_table_reg("__msg_langs")
        llvmgen.global_table_reg("__msg_texts")
    }

    // 读全局槽（load，OK_GLOBAL 3；标量/表指针共用）
    func tig_msg_gload(nm: string, ty: i64) -> i64 {
        var addr = interner.intern("@" + nm)
        var inst = ir.new_inst(g_cur_block, 21, ty)
        ir.add_operand(inst, addr, 3)
        return ir.get_value(inst)
    }

    // 写全局槽（store，opnd：ty / val / OK_GLOBAL）
    func tig_msg_gstore(nm: string, ty: i64, v: i64) {
        var addr = interner.intern("@" + nm)
        var st = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(st, ty, 2)
        ir.add_operand(st, v, 0)
        ir.add_operand(st, addr, 3)
    }

    // 惰性建表 guard：@__msg_keys 为 null → 三表各建一次；返回 keys 表 ptr（非空）。
    // 每次 msg 操作入口调用（循环内冗余但正确；msg 使用稀少，开销可忽略）。
    func tig_msg_ensure() -> i64 {
        var TS = types.named(TK_STR)
        var T64 = types.named(TK_I64)
        var cur = tig_msg_gload("__msg_keys", TS)
        var isnull = tig_cmp_zero(cur, 0)  // icmp eq ptr, null
        var initb = ir.new_block(g_cur_func, interner.intern("msg.i"))
        var useb = ir.new_block(g_cur_func, interner.intern("msg.u"))
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, isnull, 0)
        ir.add_operand(cb, initb, 1)
        ir.add_operand(cb, useb, 1)
        g_cur_block = initb
        var esz = tig_int_lit_ty(elem_size(TS), T64)
        var k = s21_table_new(esz)
        tig_msg_gstore("__msg_keys", TS, k)
        var l = s21_table_new(esz)
        tig_msg_gstore("__msg_langs", TS, l)
        var t = s21_table_new(esz)
        tig_msg_gstore("__msg_texts", TS, t)
        var b1 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(b1, useb, 1)
        g_cur_block = useb
        return tig_msg_gload("__msg_keys", TS)
    }

    // strcmp(a, b) == 0 → i1
    func tig_msg_str_eq(a: i64, b: i64) -> i64 {
        var cmp = tig_ext_call2("strcmp", a, types.named(TK_STR), b, types.named(TK_STR), types.named(TK_I32))
        var eq = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))
        ir.add_operand(eq, cmp, 0)
        ir.add_operand(eq, 0, 2)  // IMM 0（i32 宽度与 strcmp 结果一致）
        ir.add_operand(eq, 0, 2)  // cc eq
        return ir.get_value(eq)
    }

    // msg_register(key, lang, content)：线性扫 (key, lang) 命中覆盖 texts[i]，未命中三表 append。
    func tig_msg_register(key: i64, lang: i64, content: i64) {
        tig_msg_reg_globals()
        var TS = types.named(TK_STR)
        var T64 = types.named(TK_I64)
        var keys = tig_msg_ensure()
        var langs = tig_msg_gload("__msg_langs", TS)
        var texts = tig_msg_gload("__msg_texts", TS)
        var n = s21_table_len(keys)
        // 槽：i / found（-1=未命中）/ ok（table_at 出参）
        var i_s = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(i_s, T64, 2)
        var i_p = ir.get_value(i_s)
        s21_store(i_p, tig_int_lit(0), T64)
        var f_s = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(f_s, T64, 2)
        var f_p = ir.get_value(f_s)
        s21_store(f_p, tig_int_lit(-1), T64)
        var ok_s = ir.new_inst(g_cur_block, 20, types.named(TK_I8))
        ir.add_operand(ok_s, types.named(TK_I8), 2)
        var ok_p = ir.get_value(ok_s)
        // 循环：cond → body → (hit|nxt) → cond；exit 汇合
        var cond = ir.new_block(g_cur_func, interner.intern("mrg.c"))
        var body = ir.new_block(g_cur_func, interner.intern("mrg.b"))
        var hit = ir.new_block(g_cur_func, interner.intern("mrg.h"))
        var nxt = ir.new_block(g_cur_func, interner.intern("mrg.n"))
        var exit = ir.new_block(g_cur_func, interner.intern("mrg.x"))
        var b0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(b0, cond, 1)
        g_cur_block = cond
        var ilt = tig_icmp_c(s21_load(i_p, T64), n, 2)  // i < n
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, ilt, 0)
        ir.add_operand(cb, body, 1)
        ir.add_operand(cb, exit, 1)
        g_cur_block = body
        var iv = s21_load(i_p, T64)
        var kk = s21_table_at(keys, iv, ok_p, TS)
        var ll = s21_table_at(langs, iv, ok_p, TS)
        var both = tig_and_i1(tig_msg_str_eq(kk, key), tig_msg_str_eq(ll, lang))
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, both, 0)
        ir.add_operand(cb2, hit, 1)
        ir.add_operand(cb2, nxt, 1)
        g_cur_block = hit
        s21_store(f_p, iv, T64)
        var bh = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bh, exit, 1)
        g_cur_block = nxt
        s21_store(i_p, s21_bin(0, iv, tig_int_lit(1)), T64)
        var bn = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bn, cond, 1)
        // exit：found != -1 → 覆盖 texts[f]；否则三表 append
        g_cur_block = exit
        var fv = s21_load(f_p, T64)
        var isf = tig_icmp_c(fv, tig_int_lit(-1), 1)  // != -1
        var fb = ir.new_block(g_cur_func, interner.intern("mrg.f"))
        var ab = ir.new_block(g_cur_func, interner.intern("mrg.a"))
        var fin = ir.new_block(g_cur_func, interner.intern("mrg.d"))
        var cb3 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb3, isf, 0)
        ir.add_operand(cb3, fb, 1)
        ir.add_operand(cb3, ab, 1)
        g_cur_block = fb
        s21_table_set(texts, fv, TS, content)
        var bf = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bf, fin, 1)
        g_cur_block = ab
        s21_table_push(texts, TS, content)
        s21_table_push(langs, TS, lang)
        s21_table_push(keys, TS, key)
        var ba = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(ba, fin, 1)
        g_cur_block = fin
    }

    // msg_t / msg_t_lang 查表：按 (key, lang) 线性扫，命中返 texts[i]，未命中返 fallback。
    func tig_msg_find(key: i64, lang: i64, fallback: i64) -> i64 {
        tig_msg_reg_globals()
        var TS = types.named(TK_STR)
        var T64 = types.named(TK_I64)
        var keys = tig_msg_ensure()
        var langs = tig_msg_gload("__msg_langs", TS)
        var texts = tig_msg_gload("__msg_texts", TS)
        var n = s21_table_len(keys)
        // 结果槽（默认 fallback）/ i 槽 / ok 槽
        var r_s = ir.new_inst(g_cur_block, 20, TS)
        ir.add_operand(r_s, TS, 2)
        var r_p = ir.get_value(r_s)
        s21_store(r_p, fallback, TS)
        var i_s = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(i_s, T64, 2)
        var i_p = ir.get_value(i_s)
        s21_store(i_p, tig_int_lit(0), T64)
        var ok_s = ir.new_inst(g_cur_block, 20, types.named(TK_I8))
        ir.add_operand(ok_s, types.named(TK_I8), 2)
        var ok_p = ir.get_value(ok_s)
        var cond = ir.new_block(g_cur_func, interner.intern("msgt.c"))
        var body = ir.new_block(g_cur_func, interner.intern("msgt.b"))
        var hit = ir.new_block(g_cur_func, interner.intern("msgt.h"))
        var nxt = ir.new_block(g_cur_func, interner.intern("msgt.n"))
        var exit = ir.new_block(g_cur_func, interner.intern("msgt.x"))
        var b0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(b0, cond, 1)
        g_cur_block = cond
        var ilt = tig_icmp_c(s21_load(i_p, T64), n, 2)  // i < n
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, ilt, 0)
        ir.add_operand(cb, body, 1)
        ir.add_operand(cb, exit, 1)
        g_cur_block = body
        var iv = s21_load(i_p, T64)
        var kk = s21_table_at(keys, iv, ok_p, TS)
        var ll = s21_table_at(langs, iv, ok_p, TS)
        var both = tig_and_i1(tig_msg_str_eq(kk, key), tig_msg_str_eq(ll, lang))
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, both, 0)
        ir.add_operand(cb2, hit, 1)
        ir.add_operand(cb2, nxt, 1)
        g_cur_block = hit
        var tt = s21_table_at(texts, iv, ok_p, TS)
        s21_store(r_p, tt, TS)
        var bh = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bh, exit, 1)
        g_cur_block = nxt
        s21_store(i_p, s21_bin(0, iv, tig_int_lit(1)), T64)
        var bn = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bn, cond, 1)
        g_cur_block = exit
        return s21_load(r_p, TS)
    }

    // rand_range：i64 半开区间 [min,max)。p.6.4.10 修复——原内联经 CRT rand()
    //（RAND_MAX=32767），span>32768 时上端不可达；改用 **64 位 LCG**（MMIX 常量
    // state*6364136223846793005 + 1442695040888963407，mul/add 天然模 2^64 环绕，
    // 无需移位、无逻辑右移偏差），状态存运行期程序全局槽 @__rng_state（惰性登记，
    // 送 std/random.tie 的 rnd 语义——原 Rust 桥 tie_rand_range 即系统时间播种，两次
    // 运行不同序列）。首调 @__rng_state==0 时用 time(NULL)|1 播种。span 用 64 位
    // urem（无符号取模），任意 span 全区间均匀覆盖。非密码学安全。
    func tig_rng_reg() {
        if g_rng_reg_done == 1 {
            return
        }
        g_rng_reg_done = 1
        llvmgen.global_scalar_reg("__rng_state", types.named(TK_I64))
    }

    func tig_rand_range(min: i64, max: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var P8 = types.ptr_of(types.named(TK_I8))
        tig_rng_reg()
        var span = s21_bin(1, max, min)           // max - min
        var bad = tig_icmp_c(span, tig_int_lit(1), 2)   // span < 1（≤0 → 退化）
        var slot = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(slot, T64, 2)
        var sv = ir.get_value(slot)
        var bt = ir.new_block(g_cur_func, interner.intern("rr.b"))
        var be = ir.new_block(g_cur_func, interner.intern("rr.ok"))
        var mg = ir.new_block(g_cur_func, interner.intern("rr.m"))
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, bad, 0)
        ir.add_operand(cb, bt, 1)
        ir.add_operand(cb, be, 1)
        g_cur_block = bt
        s21_store(sv, min, T64)
        var br1 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br1, mg, 1)
        g_cur_block = be
        var nulp = tig_null_ptr()
        // 种子槽：@__rng_state==0 → time(NULL)|1 播种；否则沿用既有状态
        var st_a = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(st_a, T64, 2)
        var st_p = ir.get_value(st_a)
        var cur = tig_msg_gload("__rng_state", T64)
        var isz = tig_icmp_c(cur, tig_int_lit(0), 0)   // eq 0（未播种）
        var b_sd = ir.new_block(g_cur_func, interner.intern("rr.sd"))
        var b_cu = ir.new_block(g_cur_func, interner.intern("rr.cu"))
        var b_mg = ir.new_block(g_cur_func, interner.intern("rr.mu"))
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, isz, 0)
        ir.add_operand(cb2, b_sd, 1)
        ir.add_operand(cb2, b_cu, 1)
        g_cur_block = b_sd
        var tt = tig_ext_call1("time", nulp, P8, T64)  // time(NULL) 厘秒（time_t）
        var seed = s21_bin(7, tt, tig_int_lit(1))       // time | 1（保证非零/奇）
        s21_store(st_p, seed, T64)
        var brs = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brs, b_mg, 1)
        g_cur_block = b_cu
        s21_store(st_p, cur, T64)
        var brc = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brc, b_mg, 1)
        // 推进 64 位 LCG 并取 [0, span)
        g_cur_block = b_mg
        var state = s21_load(st_p, T64)
        var MUL = tig_int_lit(6364136223846793005)
        var INC = tig_int_lit(1442695040888963407)
        var st2 = s21_bin(0, s21_bin(2, state, MUL), INC)   // state*MUL + INC（回绕）
        tig_msg_gstore("__rng_state", T64, st2)
        var rmod = s21_urem(st2, span)                        // 无符号取模 → [0, span)
        var rres = s21_bin(0, min, rmod)                      // min + rmod
        s21_store(sv, rres, T64)
        var br2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br2, mg, 1)
        g_cur_block = mg
        return s21_load(sv, T64)
    }

    // ==================== p.6.4.2 / p.6.4.3 文件系统原语内联（UTF-16 安全 Win32） ====================
    func tig_trunc_i32(v: i64) -> i64 {
        var t = ir.new_inst(g_cur_block, 37, types.named(TK_I32))
        ir.add_operand(t, types.named(TK_I64), 2)
        ir.add_operand(t, v, 0)
        return ir.get_value(t)
    }
    func tig_win_ok(r: i64) -> i64 {
        return tig_cmp_zero(r, 1)
    }
    func tig_p2i(p: i64) -> i64 {
        var pi = ir.new_inst(g_cur_block, 24, types.named(TK_I64))  // ptrtoint
        ir.add_operand(pi, p, 0)
        return ir.get_value(pi)
    }
    func tig_null_ptr() -> i64 {
        var ea = ir.new_inst(g_cur_block, 20, types.named(TK_STR))  // alloca ptr
        ir.add_operand(ea, types.named(TK_STR), 2)
        var eap = ir.get_value(ea)
        var nv = tig_int_lit(0)
        var stn = ir.new_inst(g_cur_block, 22, -1)  // store ptr null
        ir.add_operand(stn, types.named(TK_STR), 2)
        ir.add_operand(stn, nv, 0)
        ir.add_operand(stn, eap, 0)
        var ldn = ir.new_inst(g_cur_block, 21, types.named(TK_STR))  // load ptr
        ir.add_operand(ldn, eap, 0)
        return ir.get_value(ldn)
    }
    func tig_bytes_to_tie(buf: i64, len: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I8 = types.named(TK_I8)
        var s = s21_sso_alloc(len)
        s21_store(s21_gep(s, 0, true), len, T64)  // 长度头
        var d0 = s21_gep(s, 8, true)
        s21_memcpy_if(d0, buf, len)
        s21_store(s21_gep(d0, len, false), tig_int_lit_ty(0, I8), I8)  // 尾 \0
        return d0
    }
    func tig_wildpath(dir: i64) -> i64 {
        var hv = s21_sb_new()
        s21_sb_append(hv, dir)
        s21_sb_append_byte(hv, tig_int_lit(92))  // '\'
        s21_sb_append_byte(hv, tig_int_lit(42))  // '*'
        return s21_sb_build(hv)
    }
    func tig_join_path(dir: i64, name: i64) -> i64 {
        var hv = s21_sb_new()
        s21_sb_append(hv, dir)
        s21_sb_append_byte(hv, tig_int_lit(92))  // '\'
        s21_sb_append(hv, name)
        return s21_sb_build(hv)
    }
    func tig_fill_table(dat: i64, n: i64, lenn: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var th = s21_raw_alloc_str(tig_int_lit(32))
        s21_store(s21_gep(th, 0, true), n, T64)
        s21_store(s21_gep(th, 8, true), lenn, T64)
        s21_store(s21_gep(th, 16, true), dat, types.named(TK_STR))
        s21_store(s21_gep(th, 24, true), tig_int_lit(8), T64)
        return th
    }

    // ==================== p.6.4.5 网络原语内联（Winsock2 直调，去 Rust 桥） ====================
    // 一次性 WSAStartup：模块级 @g_wsock_init 全局（i64）标志，首调初始化并置 1，
    // 后续幂等跳过。LPWSADATA 传 408 字节 raw 缓冲（WSAStartup 填充后即丢弃）。
    func tig_wsa_init() {
        llvmgen.wsock_enable()  // 置位：llvmgen 据此输出 @g_wsock_init 私有全局
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var I16 = types.named(TK_I16)
        var P8 = types.ptr_of(types.named(TK_I8))
        var fl = ir.new_inst(g_cur_block, 21, T64)  // load @g_wsock_init
        ir.add_operand(fl, interner.intern("@g_wsock_init"), 3)
        var fv = ir.get_value(fl)
        var need = tig_icmp_c(fv, tig_int_lit(0), 0)  // eq 0（未初始化）
        var bIn = ir.new_block(g_cur_func, interner.intern("wsa.in"))
        var bDo = ir.new_block(g_cur_func, interner.intern("wsa.do"))
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, need, 0)
        ir.add_operand(cb, bIn, 1)
        ir.add_operand(cb, bDo, 1)
        g_cur_block = bIn
        var wsdata = s21_raw_alloc_str(tig_int_lit(408))
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, I16)
        table_push(avs, tig_int_lit_ty(0x0202, I16))  // MAKEWORD(2,2)
        table_push(ats, P8)
        table_push(avs, wsdata)
        tig_ext_call_typed("WSAStartup", ats, avs, I32)
        tig_ext_call1("free", wsdata, types.named(TK_STR), -1)
        // 注：全局操作数（kind 3）须在 add_operand 序列前先把常量生成入变量，
        // 否则「常量生成穿插在操作数序列中间再 push 全局段」会段交错（编译器防险）。
        var onev = tig_int_lit(1)
        var gid = interner.intern("@g_wsock_init")
        var st = ir.new_inst(g_cur_block, 22, -1)  // store @g_wsock_init = 1
        ir.add_operand(st, T64, 2)
        ir.add_operand(st, onev, 0)
        ir.add_operand(st, gid, 3)
        var br = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br, bDo, 1)
        g_cur_block = bDo
    }

    // 构建 16 字节 sockaddr_in（小端写入）：sin_family=AF_INET(2)、
    // sin_port=htons(port)（高字节先）、sin_addr.s_addr=网络序 u32（saddr 为 I32
    // 值，小端存 4 字节即线上字节序）、sin_zero 清零。返回 raw 缓冲指针。
    func tig_wsa_addr(pt: i64, saddr: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var I8 = types.named(TK_I8)
        var sa = s21_raw_alloc_str(tig_int_lit(16))
        s21_store(s21_gep(sa, 0, true), tig_int_lit_ty(2, I8), I8)   // family lo
        s21_store(s21_gep(sa, 1, true), tig_int_lit_ty(0, I8), I8)   // family hi
        var ph = s21_bin(6, s21_bin(11, pt, tig_int_lit(8)), tig_int_lit(255))  // (port>>8)&0xFF
        var pl = s21_bin(6, pt, tig_int_lit(255))                              // port&0xFF
        s21_store(s21_gep(sa, 2, true), s21_trunc_i8(ph), I8)   // port 高字节（网络序）
        s21_store(s21_gep(sa, 3, true), s21_trunc_i8(pl), I8)   // port 低字节
        s21_store(s21_gep(sa, 4, true), saddr, I32)             // sin_addr.s_addr
        s21_store(s21_gep(sa, 8, true), tig_int_lit(0), T64)    // sin_zero[8..16]
        return sa
    }

    // socket(AF_INET, stype, 0) → SOCKET(i64)；stype=1 TCP(SOCK_STREAM)/2 UDP(SOCK_DGRAM)
    func tig_net_socket(stype: i64) -> i64 {
        var I32 = types.named(TK_I32)
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, I32)
        table_push(avs, tig_int_lit_ty(2, I32))       // AF_INET
        table_push(ats, I32)
        table_push(avs, tig_trunc_i32(stype))
        table_push(ats, I32)
        table_push(avs, tig_int_lit_ty(0, I32))       // proto
        return tig_ext_call_typed("socket", ats, avs, types.named(TK_I64))
    }

    // gethostbyname(host) → 网络序 u32 s_addr（i64）；失败返回 -1。
    // host 先做 NUL 终止拷贝（tie 串数据指针不保证 NUL 结尾）。
    // hostent 布局（x64）：h_name(8)+h_aliases(8)+h_addrtype(2)+h_length(2)+pad(4)
    // +h_addr_list(offset24)；取 h_addr_list[0] 的 4 字节 in_addr，小端读 u32。
    func tig_net_resolve(host: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var I8 = types.named(TK_I8)
        var P8 = types.ptr_of(types.named(TK_I8))
        var hl = s21_str_head_len(host)
        var z = s21_raw_alloc_str(s21_bin(0, hl, tig_int_lit(1)))
        s21_memcpy_if(z, host, hl)
        s21_store(s21_gep(z, hl, false), tig_int_lit_ty(0, I8), I8)
        var he = tig_ext_call1("gethostbyname", z, types.named(TK_STR), P8)
        var sv = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(sv, T64, 2)
        var svv = ir.get_value(sv)
        s21_store(svv, tig_int_lit(-1), T64)   // 默认失败
        var fail = tig_cmp_zero(he, 0)         // he == null
        var bOk = ir.new_block(g_cur_func, interner.intern("rs.ok"))
        var bFail = ir.new_block(g_cur_func, interner.intern("rs.f"))
        var bM = ir.new_block(g_cur_func, interner.intern("rs.m"))
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, fail, 0)
        ir.add_operand(cb, bFail, 1)
        ir.add_operand(cb, bOk, 1)
        g_cur_block = bFail
        tig_ext_call1("free", z, types.named(TK_STR), -1)
        var brf = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brf, bM, 1)
        g_cur_block = bOk
        var hlist = s21_load(s21_gep(he, 24, true), P8)   // char** h_addr_list
        var hp0 = s21_load(s21_gep(hlist, 0, true), P8)   // char* 首个 in_addr
        var saddrv = s21_load(s21_gep(hp0, 0, true), I32) // in_addr.s_addr (u32 网络序)
        s21_store(svv, s21_zext(saddrv, I32), T64)
        tig_ext_call1("free", z, types.named(TK_STR), -1)
        var brk = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brk, bM, 1)
        g_cur_block = bM
        return s21_load(svv, T64)
    }

    // 通用结果槽（i64，默认 -1）
    func tig_slot64(init: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var sv = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(sv, T64, 2)
        var svv = ir.get_value(sv)
        s21_store(svv, tig_int_lit(init), T64)
        return svv
    }

    // ---- TCP ----
    // net_tcp_listen(port) -> i64：socket(STREAM)+bind(0.0.0.0:port)+listen(8)
    func tig_net_tcp_listen(pt: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var ST = types.named(TK_STR)
        tig_wsa_init()
        var fd = tig_net_socket(tig_int_lit(1))       // SOCK_STREAM
        var svv = tig_slot64(-1)
        var bad = tig_icmp_c(fd, tig_int_lit(-1), 0)  // socket 失败
        var bE = ir.new_block(g_cur_func, interner.intern("ls.e"))
        var bS = ir.new_block(g_cur_func, interner.intern("ls.s"))
        var bM = ir.new_block(g_cur_func, interner.intern("ls.m"))
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, bad, 0)
        ir.add_operand(cb, bE, 1)
        ir.add_operand(cb, bS, 1)
        g_cur_block = bE
        var brE = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brE, bM, 1)
        g_cur_block = bS
        var sa = tig_wsa_addr(pt, tig_int_lit_ty(0, I32))  // INADDR_ANY
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, T64);  table_push(avs, fd)
        table_push(ats, ST);   table_push(avs, sa)
        table_push(ats, I32);  table_push(avs, tig_int_lit_ty(16, I32))
        var brc = tig_ext_call_typed("bind", ats, avs, I32)
        var bbad = tig_icmp_c(brc, tig_int_lit_ty(0, I32), 1)  // != 0 → fail
        var bBf = ir.new_block(g_cur_func, interner.intern("ls.bf"))
        var bBs = ir.new_block(g_cur_func, interner.intern("ls.bs"))
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, bbad, 0)
        ir.add_operand(cb2, bBf, 1)
        ir.add_operand(cb2, bBs, 1)
        g_cur_block = bBf
        tig_ext_call1("closesocket", fd, T64, I32)
        var brBf = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brBf, bM, 1)
        g_cur_block = bBs
        var ats2: table<i64> = table_new_i64()
        var avs2: table<i64> = table_new_i64()
        table_push(ats2, T64);  table_push(avs2, fd)
        table_push(ats2, I32);  table_push(avs2, tig_int_lit_ty(8, I32))  // backlog 8
        var lrc = tig_ext_call_typed("listen", ats2, avs2, I32)
        var lbad = tig_icmp_c(lrc, tig_int_lit_ty(0, I32), 1)
        var bLf = ir.new_block(g_cur_func, interner.intern("ls.lf"))
        var bLs = ir.new_block(g_cur_func, interner.intern("ls.ls"))
        var cb3 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb3, lbad, 0)
        ir.add_operand(cb3, bLf, 1)
        ir.add_operand(cb3, bLs, 1)
        g_cur_block = bLf
        tig_ext_call1("closesocket", fd, T64, I32)
        var brLf = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brLf, bM, 1)
        g_cur_block = bLs
        s21_store(svv, fd, T64)   // 成功：返回监听句柄
        var brLs = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brLs, bM, 1)
        g_cur_block = bM
        return s21_load(svv, T64)
    }

    // net_tcp_accept(h) -> i64：accept → 连接句柄（失败 -1）
    func tig_net_tcp_accept(h: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var P8 = types.ptr_of(types.named(TK_I8))
        tig_wsa_init()
        var nullp = tig_null_ptr()
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, T64); table_push(avs, h)
        table_push(ats, P8);  table_push(avs, nullp)
        table_push(ats, P8);  table_push(avs, nullp)
        return tig_ext_call_typed("accept", ats, avs, T64)  // SOCKET（-1 即失败）
    }

    // net_tcp_connect(host, port) -> i64：socket(STREAM)+resolve+connect
    func tig_net_tcp_connect(host: i64, pt: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var ST = types.named(TK_STR)
        tig_wsa_init()
        var saddr = tig_net_resolve(host)
        var svv = tig_slot64(-1)
        var rbad = tig_icmp_c(saddr, tig_int_lit(-1), 0)  // 解析失败
        var bRe = ir.new_block(g_cur_func, interner.intern("ct.re"))
        var bRS = ir.new_block(g_cur_func, interner.intern("ct.rs"))
        var bM = ir.new_block(g_cur_func, interner.intern("ct.m"))
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, rbad, 0)
        ir.add_operand(cb, bRe, 1)
        ir.add_operand(cb, bRS, 1)
        g_cur_block = bRe
        var brE = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brE, bM, 1)
        g_cur_block = bRS
        var fd = tig_net_socket(tig_int_lit(1))
        var fbad = tig_icmp_c(fd, tig_int_lit(-1), 0)
        var bFe = ir.new_block(g_cur_func, interner.intern("ct.fe"))
        var bFS = ir.new_block(g_cur_func, interner.intern("ct.fs"))
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, fbad, 0)
        ir.add_operand(cb2, bFe, 1)
        ir.add_operand(cb2, bFS, 1)
        g_cur_block = bFe
        var brF = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brF, bM, 1)
        g_cur_block = bFS
        var sa = tig_wsa_addr(pt, tig_trunc_i32(saddr))
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, T64); table_push(avs, fd)
        table_push(ats, ST);  table_push(avs, sa)
        table_push(ats, I32); table_push(avs, tig_int_lit_ty(16, I32))
        var crc = tig_ext_call_typed("connect", ats, avs, I32)
        var cbad = tig_icmp_c(crc, tig_int_lit_ty(0, I32), 1)
        var bCf = ir.new_block(g_cur_func, interner.intern("ct.cf"))
        var bCs = ir.new_block(g_cur_func, interner.intern("ct.cs"))
        var cb3 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb3, cbad, 0)
        ir.add_operand(cb3, bCf, 1)
        ir.add_operand(cb3, bCs, 1)
        g_cur_block = bCf
        tig_ext_call1("closesocket", fd, T64, I32)
        var brC = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brC, bM, 1)
        g_cur_block = bCs
        s21_store(svv, fd, T64)   // 成功
        var brCs = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brCs, bM, 1)
        g_cur_block = bM
        return s21_load(svv, T64)
    }

    // net_tcp_send(h, data:串) -> i64：send 按 UTF-8 字节发送（到串数据指针）
    func tig_net_tcp_send(h: i64, data: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var ST = types.named(TK_STR)
        tig_wsa_init()
        var dlen = s21_str_head_len(data)
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, T64); table_push(avs, h)
        table_push(ats, ST);  table_push(avs, data)
        table_push(ats, I32); table_push(avs, tig_trunc_i32(dlen))
        table_push(ats, I32); table_push(avs, tig_int_lit_ty(0, I32))  // flags
        var r = tig_ext_call_typed("send", ats, avs, I32)
        return tig_sext(r, I32, T64)
    }

    // net_tcp_recv(h, max) -> string（仅 ASCII 安全；二进制请用 recv_bytes）
    func tig_net_tcp_recv(h: i64, max: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var ST = types.named(TK_STR)
        tig_wsa_init()
        var buf = s21_raw_alloc_str(max)
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, T64); table_push(avs, h)
        table_push(ats, ST);  table_push(avs, buf)
        table_push(ats, I32); table_push(avs, tig_trunc_i32(max))
        table_push(ats, I32); table_push(avs, tig_int_lit_ty(0, I32))
        var r = tig_ext_call_typed("recv", ats, avs, I32)
        var rgt0 = tig_icmp_c(r, tig_int_lit_ty(0, I32), 3)  // sgt
        var r64 = tig_sext(r, I32, T64)
        var nr = tig_select_i(rgt0, r64, tig_int_lit(0), T64)  // <0/0 → 空串哨兵
        return tig_bytes_to_tie(buf, nr)
    }

    // ---- 字节版（p.6.6.1 TLS 用）----
    // net_tcp_send_bytes(h, data:表<i64>) -> i64：逐元素取低字节拼字节缓冲后 send
    func tig_net_tcp_send_bytes(h: i64, data: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var I8 = types.named(TK_I8)
        var ST = types.named(TK_STR)
        tig_wsa_init()
        var dlen = s21_load(s21_gep(data, 8, true), T64)    // 表 len
        var dptr = s21_load(s21_gep(data, 16, true), ST)    // 表 data 段
        var nytes = s21_raw_alloc_str(dlen)
        // i 槽（i64）
        var i_slot = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(i_slot, T64, 2)
        var iv = ir.get_value(i_slot)
        s21_store(iv, tig_int_lit(0), T64)
        var bCond = ir.new_block(g_cur_func, interner.intern("sb.c"))
        var bBody = ir.new_block(g_cur_func, interner.intern("sb.b"))
        var bExit = ir.new_block(g_cur_func, interner.intern("sb.e"))
        var b0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(b0, bCond, 1)
        g_cur_block = bCond
        var ci = s21_load(iv, T64)
        var cond = tig_icmp_c(ci, dlen, 2)   // i < len
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, cond, 0)
        ir.add_operand(cb, bBody, 1)
        ir.add_operand(cb, bExit, 1)
        g_cur_block = bBody
        var ci2 = s21_load(iv, T64)
        var elem = s21_load(s21_gep(dptr, s21_bin(10, ci2, tig_int_lit(3)), false), T64)  // data[i*8]
        var byt = s21_bin(6, elem, tig_int_lit(255))          // & 0xFF
        s21_store(s21_gep(nytes, ci2, false), s21_trunc_i8(byt), I8)
        s21_store(iv, s21_bin(0, ci2, tig_int_lit(1)), T64)   // i += 1
        var brb = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brb, bCond, 1)
        g_cur_block = bExit
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, T64); table_push(avs, h)
        table_push(ats, ST);  table_push(avs, nytes)
        table_push(ats, I32); table_push(avs, tig_trunc_i32(dlen))
        table_push(ats, I32); table_push(avs, tig_int_lit_ty(0, I32))
        var r = tig_ext_call_typed("send", ats, avs, I32)
        var rs = tig_sext(r, I32, T64)
        tig_ext_call1("free", nytes, ST, -1)
        return rs
    }

    // net_tcp_recv_bytes(h, max) -> 表<i64>：recv 原始字节 → 逐字节装入 i64 元素表
    //（cap=max, len=实收, data=8×max 元素缓冲, esz=8——仿 tig_byte_read 表格式）
    func tig_net_tcp_recv_bytes(h: i64, max: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var I8 = types.named(TK_I8)
        var ST = types.named(TK_STR)
        tig_wsa_init()
        var rawB = s21_raw_alloc_str(max)
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, T64); table_push(avs, h)
        table_push(ats, ST);  table_push(avs, rawB)
        table_push(ats, I32); table_push(avs, tig_trunc_i32(max))
        table_push(ats, I32); table_push(avs, tig_int_lit_ty(0, I32))
        var r = tig_ext_call_typed("recv", ats, avs, I32)
        var rgt0 = tig_icmp_c(r, tig_int_lit_ty(0, I32), 3)
        var r64 = tig_sext(r, I32, T64)
        var nr = tig_select_i(rgt0, r64, tig_int_lit(0), T64)
        var edata = s21_raw_alloc_str(s21_bin(10, max, tig_int_lit(3)))  // max*8 字节
        var i_slot = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(i_slot, T64, 2)
        var iv = ir.get_value(i_slot)
        s21_store(iv, tig_int_lit(0), T64)
        var bCond = ir.new_block(g_cur_func, interner.intern("rb.c"))
        var bBody = ir.new_block(g_cur_func, interner.intern("rb.b"))
        var bExit = ir.new_block(g_cur_func, interner.intern("rb.e"))
        var b0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(b0, bCond, 1)
        g_cur_block = bCond
        var ci = s21_load(iv, T64)
        var cond = tig_icmp_c(ci, nr, 2)   // i < nr
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, cond, 0)
        ir.add_operand(cb, bBody, 1)
        ir.add_operand(cb, bExit, 1)
        g_cur_block = bBody
        var ci2 = s21_load(iv, T64)
        var bval = s21_zext(s21_load(s21_gep(rawB, ci2, false), I8), I8)  // 原始字节 → i64
        s21_store(s21_gep(edata, s21_bin(10, ci2, tig_int_lit(3)), false), bval, T64)  // edata[i*8]
        s21_store(iv, s21_bin(0, ci2, tig_int_lit(1)), T64)
        var brb = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brb, bCond, 1)
        g_cur_block = bExit
        tig_ext_call1("free", rawB, ST, -1)
        return tig_fill_table(edata, max, nr)
    }

    // ---- UDP ----
    // net_udp_bind(port) -> i64：socket(DGRAM)+bind
    func tig_net_udp_bind(pt: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var ST = types.named(TK_STR)
        tig_wsa_init()
        var fd = tig_net_socket(tig_int_lit(2))       // SOCK_DGRAM
        var svv = tig_slot64(-1)
        var bad = tig_icmp_c(fd, tig_int_lit(-1), 0)
        var bE = ir.new_block(g_cur_func, interner.intern("ub.e"))
        var bS = ir.new_block(g_cur_func, interner.intern("ub.s"))
        var bM = ir.new_block(g_cur_func, interner.intern("ub.m"))
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, bad, 0)
        ir.add_operand(cb, bE, 1)
        ir.add_operand(cb, bS, 1)
        g_cur_block = bE
        var brE = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brE, bM, 1)
        g_cur_block = bS
        var sa = tig_wsa_addr(pt, tig_int_lit_ty(0, I32))  // INADDR_ANY
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, T64); table_push(avs, fd)
        table_push(ats, ST);  table_push(avs, sa)
        table_push(ats, I32); table_push(avs, tig_int_lit_ty(16, I32))
        var brc = tig_ext_call_typed("bind", ats, avs, I32)
        var bbad = tig_icmp_c(brc, tig_int_lit_ty(0, I32), 1)
        var bBf = ir.new_block(g_cur_func, interner.intern("ub.bf"))
        var bBs = ir.new_block(g_cur_func, interner.intern("ub.bs"))
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, bbad, 0)
        ir.add_operand(cb2, bBf, 1)
        ir.add_operand(cb2, bBs, 1)
        g_cur_block = bBf
        tig_ext_call1("closesocket", fd, T64, I32)
        var brBf = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brBf, bM, 1)
        g_cur_block = bBs
        s21_store(svv, fd, T64)
        var brBs = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brBs, bM, 1)
        g_cur_block = bM
        return s21_load(svv, T64)
    }

    // net_udp_send(h, host, port, data) -> i64：resolve + sendto
    func tig_net_udp_send(h: i64, host: i64, pt: i64, data: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var ST = types.named(TK_STR)
        tig_wsa_init()
        var dlen = s21_str_head_len(data)
        var saddr = tig_net_resolve(host)
        var svv = tig_slot64(-1)
        var rbad = tig_icmp_c(saddr, tig_int_lit(-1), 0)
        var bE = ir.new_block(g_cur_func, interner.intern("us.e"))
        var bS = ir.new_block(g_cur_func, interner.intern("us.s"))
        var bM = ir.new_block(g_cur_func, interner.intern("us.m"))
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, rbad, 0)
        ir.add_operand(cb, bE, 1)
        ir.add_operand(cb, bS, 1)
        g_cur_block = bE
        var brE = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brE, bM, 1)
        g_cur_block = bS
        var sa = tig_wsa_addr(pt, tig_trunc_i32(saddr))
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, T64); table_push(avs, h)
        table_push(ats, ST);  table_push(avs, data)
        table_push(ats, I32); table_push(avs, tig_trunc_i32(dlen))
        table_push(ats, I32); table_push(avs, tig_int_lit_ty(0, I32))
        table_push(ats, ST);  table_push(avs, sa)
        table_push(ats, I32); table_push(avs, tig_int_lit_ty(16, I32))
        var r = tig_ext_call_typed("sendto", ats, avs, I32)
        var rs = tig_sext(r, I32, T64)
        s21_store(svv, rs, T64)
        var brS = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brS, bM, 1)
        g_cur_block = bM
        return s21_load(svv, T64)
    }

    // net_udp_recv(h, max) -> string：recvfrom（ASCII 安全）
    func tig_net_udp_recv(h: i64, max: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var ST = types.named(TK_STR)
        var P8 = types.ptr_of(types.named(TK_I8))
        tig_wsa_init()
        var buf = s21_raw_alloc_str(max)
        var nullp = tig_null_ptr()
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, T64); table_push(avs, h)
        table_push(ats, ST);  table_push(avs, buf)
        table_push(ats, I32); table_push(avs, tig_trunc_i32(max))
        table_push(ats, I32); table_push(avs, tig_int_lit_ty(0, I32))
        table_push(ats, P8);  table_push(avs, nullp)   // sockaddr*
        table_push(ats, P8);  table_push(avs, nullp)   // socklen_t*
        var r = tig_ext_call_typed("recvfrom", ats, avs, I32)
        var rgt0 = tig_icmp_c(r, tig_int_lit_ty(0, I32), 3)
        var r64 = tig_sext(r, I32, T64)
        var nr = tig_select_i(rgt0, r64, tig_int_lit(0), T64)
        return tig_bytes_to_tie(buf, nr)
    }

    // net_close(h) -> bool：closesocket 返回 0 = 成功
    func tig_net_close(h: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        tig_wsa_init()
        var r = tig_ext_call1("closesocket", h, T64, I32)
        return tig_icmp_c(r, tig_int_lit_ty(0, I32), 0)   // rc == 0 → true
    }

    func tig_create_file_w(pw: i64, access: i64, disp: i64) -> i64 {
        var I32 = types.named(TK_I32)
        var P8 = types.ptr_of(types.named(TK_I8))
        var nullsa = tig_null_ptr()
        var nulltm = tig_null_ptr()
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, P8);  table_push(avs, pw)
        table_push(ats, I32); table_push(avs, access)
        table_push(ats, I32); table_push(avs, tig_int_lit_ty(3, I32))
        table_push(ats, P8);  table_push(avs, nullsa)
        table_push(ats, I32); table_push(avs, disp)
        table_push(ats, I32); table_push(avs, tig_int_lit_ty(0x80, I32))
        table_push(ats, P8);  table_push(avs, nulltm)
        return tig_ext_call_typed("CreateFileW", ats, avs, P8)
    }
    func tig_file_attr_w(p: i64) -> i64 {
        var P8 = types.ptr_of(types.named(TK_I8))
        var pw = tig_wide16(p)
        return tig_ext_call1("GetFileAttributesW", pw, P8, types.named(TK_I32))
    }
    func tig_mkdir_w(pw: i64) {
        var I32 = types.named(TK_I32)
        var P8 = types.ptr_of(types.named(TK_I8))
        var nullsa = tig_null_ptr()
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, P8); table_push(avs, pw)
        table_push(ats, P8); table_push(avs, nullsa)
        tig_ext_call_typed("CreateDirectoryW", ats, avs, I32)
    }
    func tig_find_first_w(pw: i64, fd: i64) -> i64 {
        var P8 = types.ptr_of(types.named(TK_I8))
        return tig_ext_call2("FindFirstFileW", pw, P8, fd, P8, P8)
    }
    func tig_find_next_w(hf: i64, fd: i64) -> i64 {
        var P8 = types.ptr_of(types.named(TK_I8))
        return tig_ext_call2("FindNextFileW", hf, P8, fd, P8, types.named(TK_I32))
    }
    func tig_find_close(hf: i64) {
        var P8 = types.ptr_of(types.named(TK_I8))
        tig_ext_call1("FindClose", hf, P8, types.named(TK_I32))
    }
    func tig_is_dotname(n: i64) -> i64 {
        var l = s21_str_head_len(n)
        var e1 = tig_icmp_c(l, tig_int_lit(1), 0)
        var b0 = s21_str_byte(n, tig_int_lit(0))
        var d0c = tig_icmp_c(b0, tig_int_lit(0x2E), 0)
        var d1 = tig_and_i1(e1, d0c)
        var e2 = tig_icmp_c(l, tig_int_lit(2), 0)
        var b1 = s21_str_byte(n, tig_int_lit(1))
        var d1c = tig_icmp_c(b1, tig_int_lit(0x2E), 0)
        var d2 = tig_and_i1(e2, tig_and_i1(d0c, d1c))
        return tig_or_i1(d1, d2)
    }
    func tig_wide16_dbl(s: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I8 = types.named(TK_I8)
        var w = tig_wide16(s)
        var wlen = s21_str_head_len(w)
        var buf = s21_raw_alloc_str(s21_bin(0, wlen, tig_int_lit(1)))  // wlen+1（补第二个 NUL）
        s21_memcpy_if(buf, w, wlen)
        s21_store(s21_gep(buf, wlen, false), tig_int_lit_ty(0, I8), I8)
        return buf
    }
    func tig_sh_op(funcCode: i64, fromS: i64, toS: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var I8 = types.named(TK_I8)
        var P8 = types.ptr_of(I8)
        var fw = tig_wide16_dbl(fromS)
        var tw = tig_wide16_dbl(toS)
        var sb = s21_raw_alloc_str(tig_int_lit(56))
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, P8);  table_push(avs, sb)
        table_push(ats, I8);  table_push(avs, tig_int_lit_ty(0, I8))
        table_push(ats, T64); table_push(avs, tig_int_lit(56))
        tig_ext_call_typed("memset", ats, avs, -1)
        s21_store(s21_gep(sb, 8, true), tig_int_lit_ty(funcCode, I32), I32)
        s21_store(s21_gep(sb, 16, true), fw, types.named(TK_STR))
        s21_store(s21_gep(sb, 24, true), tw, types.named(TK_STR))
        s21_store(s21_gep(sb, 32, true), tig_int_lit_ty(0x614, I32), I32)  // SILENT|NOCONFIRM|NOCONFIRMMKDIR|NOERRORUI
        var ats2: table<i64> = table_new_i64()
        var avs2: table<i64> = table_new_i64()
        table_push(ats2, P8); table_push(avs2, sb)
        var rc = tig_ext_call_typed("SHFileOperationW", ats2, avs2, I32)
        tig_ext_call1("free", sb, types.named(TK_STR), -1)
        tig_ext_call1("free", fw, types.named(TK_STR), -1)
        tig_ext_call1("free", tw, types.named(TK_STR), -1)
        return tig_cmp_zero(rc, 0)
    }

    func tig_read_file(p: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var I8 = types.named(TK_I8)
        var P8 = types.ptr_of(I8)
        var pw = tig_wide16(p)
        var rslt = ir.new_inst(g_cur_block, 20, types.named(TK_STR))
        ir.add_operand(rslt, types.named(TK_STR), 2)
        var sv = ir.get_value(rslt)
        s21_store(sv, tig_str_lit(interner.intern("\"\"")), types.named(TK_STR))
        var h = tig_create_file_w(pw, tig_int_lit_ty(0x120089, I32), tig_int_lit_ty(3, I32))
        var szb = s21_raw_alloc_str(tig_int_lit(8))
        var ok1 = tig_ext_call2("GetFileSizeEx", h, P8, szb, P8, I32)
        var okb = tig_win_ok(ok1)
        var bOk = ir.new_block(g_cur_func, interner.intern("rd.ok"))
        var bFail = ir.new_block(g_cur_func, interner.intern("rd.f"))
        var bM = ir.new_block(g_cur_func, interner.intern("rd.m"))
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, okb, 0)
        ir.add_operand(cb, bOk, 1)
        ir.add_operand(cb, bFail, 1)
        g_cur_block = bFail
        tig_ext_call1("CloseHandle", h, P8, I32)
        var brf = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brf, bM, 1)
        g_cur_block = bOk
        var size = s21_load(szb, T64)
        var big = tig_cmp_const(size, 3, 0x7FFFFFFF, T64)
        var toread = tig_select_i(big, tig_int_lit(0x7FFFFFFF), size, T64)
        var buf = s21_raw_alloc_str(toread)
        var nrb = s21_raw_alloc_str(tig_int_lit(4))
        s21_store(s21_gep(nrb, 0, true), tig_int_lit_ty(0, I32), I32)
        var nullov = tig_null_ptr()
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, P8);  table_push(avs, h)
        table_push(ats, P8);  table_push(avs, buf)
        table_push(ats, I32); table_push(avs, tig_trunc_i32(toread))
        table_push(ats, P8);  table_push(avs, nrb)
        table_push(ats, P8);  table_push(avs, nullov)
        tig_ext_call_typed("ReadFile", ats, avs, I32)
        var nr = s21_zext(s21_load(nrb, I32), I32)
        s21_store(sv, tig_bytes_to_tie(buf, nr), types.named(TK_STR))
        tig_ext_call1("CloseHandle", h, P8, I32)
        tig_ext_call1("free", buf, types.named(TK_STR), -1)
        tig_ext_call1("free", nrb, types.named(TK_STR), -1)
        tig_ext_call1("free", szb, types.named(TK_STR), -1)
        var brk = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brk, bM, 1)
        g_cur_block = bM
        return s21_load(sv, types.named(TK_STR))
    }
    func tig_write_file(p: i64, c: i64, append: bool) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var P8 = types.ptr_of(types.named(TK_I8))
        var pw = tig_wide16(p)
        var acc = tig_int_lit_ty(0x120116, I32)   // FILE_GENERIC_WRITE
        var dsp = tig_int_lit_ty(2, I32)          // CREATE_ALWAYS
        if append {
            acc = tig_int_lit_ty(0x0004, I32)     // FILE_APPEND_DATA
            dsp = tig_int_lit_ty(4, I32)          // OPEN_ALWAYS
        }
        var slt = ir.new_inst(g_cur_block, 20, I32)
        ir.add_operand(slt, I32, 2)
        var rsv = ir.get_value(slt)
        s21_store(rsv, tig_int_lit_ty(0, I32), I32)
        var h = tig_create_file_w(pw, acc, dsp)
        var hok = tig_icmp_c(tig_p2i(h), tig_int_lit(-1), 1)
        var bOk = ir.new_block(g_cur_func, interner.intern("wr.ok"))
        var bFail = ir.new_block(g_cur_func, interner.intern("wr.f"))
        var bM = ir.new_block(g_cur_func, interner.intern("wr.m"))
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, hok, 0)
        ir.add_operand(cb, bOk, 1)
        ir.add_operand(cb, bFail, 1)
        g_cur_block = bFail
        var brf = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brf, bM, 1)
        g_cur_block = bOk
        var dlen = s21_str_head_len(c)
        var data = c
        var nwb = s21_raw_alloc_str(tig_int_lit(4))
        s21_store(s21_gep(nwb, 0, true), tig_int_lit_ty(0, I32), I32)
        var nullov = tig_null_ptr()
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, P8);  table_push(avs, h)
        table_push(ats, P8);  table_push(avs, data)
        table_push(ats, I32); table_push(avs, tig_trunc_i32(dlen))
        table_push(ats, P8);  table_push(avs, nwb)
        table_push(ats, P8);  table_push(avs, nullov)
        var wr = tig_ext_call_typed("WriteFile", ats, avs, I32)
        tig_ext_call1("CloseHandle", h, P8, I32)
        tig_ext_call1("free", nwb, types.named(TK_STR), -1)
        s21_store(rsv, wr, I32)
        var brw = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brw, bM, 1)
        g_cur_block = bM
        return tig_win_ok(s21_load(rsv, I32))
    }

    func tig_attr_invalid(a: i64) -> i64 {
        var I32 = types.named(TK_I32)
        return tig_icmp_c(a, tig_int_lit_ty(-1, I32), 0)
    }
    func tig_exists_inline(p: i64) -> i64 {
        return tig_not_i1(tig_attr_invalid(tig_file_attr_w(p)))
    }
    func tig_is_dir_inline(p: i64) -> i64 {
        var I32 = types.named(TK_I32)
        var a = tig_file_attr_w(p)
        var a6 = s21_zext(a, I32)
        var dirf = tig_icmp_c(s21_bin(6, a6, tig_int_lit(0x10)), tig_int_lit(0), 1)
        return tig_and_i1(tig_not_i1(tig_attr_invalid(a)), dirf)
    }
    func tig_is_file_inline(p: i64) -> i64 {
        var I32 = types.named(TK_I32)
        var a = tig_file_attr_w(p)
        var a6 = s21_zext(a, I32)
        var dirf = tig_icmp_c(s21_bin(6, a6, tig_int_lit(0x10)), tig_int_lit(0), 1)
        return tig_and_i1(tig_not_i1(tig_attr_invalid(a)), tig_not_i1(dirf))
    }
    func tig_size_inline(p: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var P8 = types.ptr_of(types.named(TK_I8))
        var pw = tig_wide16(p)
        var h = tig_create_file_w(pw, tig_int_lit_ty(0x120089, I32), tig_int_lit_ty(3, I32))
        var szb = s21_raw_alloc_str(tig_int_lit(8))
        var ok1 = tig_ext_call2("GetFileSizeEx", h, P8, szb, P8, I32)
        var okb = tig_win_ok(ok1)
        var slt = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(slt, T64, 2)
        var sv = ir.get_value(slt)
        s21_store(sv, tig_int_lit(-1), T64)
        var bOk = ir.new_block(g_cur_func, interner.intern("sz.ok"))
        var bFail = ir.new_block(g_cur_func, interner.intern("sz.f"))
        var bM = ir.new_block(g_cur_func, interner.intern("sz.m"))
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, okb, 0)
        ir.add_operand(cb, bOk, 1)
        ir.add_operand(cb, bFail, 1)
        g_cur_block = bFail
        tig_ext_call1("CloseHandle", h, P8, I32)
        var brf = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brf, bM, 1)
        g_cur_block = bOk
        s21_store(sv, s21_load(szb, T64), T64)
        tig_ext_call1("CloseHandle", h, P8, I32)
        var brk = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brk, bM, 1)
        g_cur_block = bM
        tig_ext_call1("free", szb, types.named(TK_STR), -1)
        return s21_load(sv, T64)
    }
    func tig_delete_inline(p: i64) -> i64 {
        var I32 = types.named(TK_I32)
        var P8 = types.ptr_of(types.named(TK_I8))
        var pw = tig_wide16(p)
        return tig_win_ok(tig_ext_call1("DeleteFileW", pw, P8, I32))
    }
    func tig_copy_file(a: i64, b: i64) -> i64 {
        var I32 = types.named(TK_I32)
        var P8 = types.ptr_of(types.named(TK_I8))
        var aw = tig_wide16(a)
        var bw = tig_wide16(b)
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, P8);  table_push(avs, aw)
        table_push(ats, P8);  table_push(avs, bw)
        table_push(ats, I32); table_push(avs, tig_int_lit_ty(0, I32))  // bFailIfExists=0
        var r = tig_ext_call_typed("CopyFileW", ats, avs, I32)
        return tig_win_ok(r)
    }
    func tig_move_file(a: i64, b: i64) -> i64 {
        var I32 = types.named(TK_I32)
        var P8 = types.ptr_of(types.named(TK_I8))
        var aw = tig_wide16(a)
        var bw = tig_wide16(b)
        return tig_win_ok(tig_ext_call2("MoveFileW", aw, P8, bw, P8, I32))
    }
    func tig_mkdir_all(p: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var pn = s21_str_head_len(p)
        var islt = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(islt, T64, 2)
        var isv = ir.get_value(islt)
        s21_store(isv, tig_int_lit(0), T64)
        var hd = ir.new_block(g_cur_func, interner.intern("mk.h"))
        var bd2 = ir.new_block(g_cur_func, interner.intern("mk.b"))
        var ex = ir.new_block(g_cur_func, interner.intern("mk.x"))
        var br0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br0, hd, 1)
        g_cur_block = hd
        var ic = tig_icmp_c(s21_load(isv, T64), pn, 2)
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, ic, 0)
        ir.add_operand(cb, bd2, 1)
        ir.add_operand(cb, ex, 1)
        g_cur_block = bd2
        var iv = s21_load(isv, T64)
        var b = s21_str_byte(p, iv)
        var issep = tig_or_i1(tig_icmp_c(b, tig_int_lit(0x2F), 0), tig_icmp_c(b, tig_int_lit(0x5C), 0))
        var bSep = ir.new_block(g_cur_func, interner.intern("mk.sep"))
        var bNo = ir.new_block(g_cur_func, interner.intern("mk.no"))
        var bInc = ir.new_block(g_cur_func, interner.intern("mk.inc"))
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, issep, 0)
        ir.add_operand(cb2, bSep, 1)
        ir.add_operand(cb2, bNo, 1)
        g_cur_block = bSep
        var pref = s21_str_sub_bytes(p, tig_int_lit(0), iv)
        var pf = tig_icmp_c(s21_str_head_len(pref), tig_int_lit(0), 3)
        var bP = ir.new_block(g_cur_func, interner.intern("mk.p"))
        var bPe = ir.new_block(g_cur_func, interner.intern("mk.pe"))
        var cb3 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb3, pf, 0)
        ir.add_operand(cb3, bP, 1)
        ir.add_operand(cb3, bPe, 1)
        g_cur_block = bP
        tig_mkdir_w(tig_wide16(pref))
        var brp = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brp, bPe, 1)
        g_cur_block = bPe
        var brs = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brs, bInc, 1)
        g_cur_block = bNo
        var brn = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brn, bInc, 1)
        g_cur_block = bInc
        s21_store(isv, s21_bin(0, iv, tig_int_lit(1)), T64)
        var brb = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brb, hd, 1)
        g_cur_block = ex
        tig_mkdir_w(tig_wide16(p))
        return tig_bool_lit(1)
    }
    func tig_remove_dir_all(p: i64) -> i64 {
        return tig_sh_op(3, p, p)
    }

    // copy_dir(src, dst)：迭代式递归复制（src/dst 成对工作清单，无递归函数）。
    // 每个目录：先建 dst 目录，遍历 src 直接条目——文件 CopyFileW，子目录建目并
    // 压入工作清单继续。UTF-16 路径安全。整体成功 → i1 true。
    func tig_copy_dir(a: i64, b: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var I8 = types.named(TK_I8)
        var P8 = types.ptr_of(I8)
        // src/dst 成对工作清单（增长式字符串数组）
        var srcW = s21_raw_alloc_str(tig_int_lit(24))
        s21_store(s21_gep(srcW, 0, true), tig_int_lit(0), T64)
        s21_store(s21_gep(srcW, 8, true), tig_int_lit(0), T64)
        s21_store(s21_gep(srcW, 16, true), tig_int_lit(0), types.named(TK_STR))
        var dstW = s21_raw_alloc_str(tig_int_lit(24))
        s21_store(s21_gep(dstW, 0, true), tig_int_lit(0), T64)
        s21_store(s21_gep(dstW, 8, true), tig_int_lit(0), T64)
        s21_store(s21_gep(dstW, 16, true), tig_int_lit(0), types.named(TK_STR))
        tig_blob_push(srcW, a)
        tig_blob_push(dstW, b)
        tig_mkdir_w(tig_wide16(b))  // 根 dst 目录
        // 外层循环：while srcW.len > 0
        var hd = ir.new_block(g_cur_func, interner.intern("cd.h"))
        var bd4 = ir.new_block(g_cur_func, interner.intern("cd.b"))
        var ex = ir.new_block(g_cur_func, interner.intern("cd.x"))
        var br0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br0, hd, 1)
        g_cur_block = hd
        var sl0 = s21_load(s21_gep(srcW, 8, true), T64)
        var sgt = tig_icmp_c(sl0, tig_int_lit(0), 3)
        var cb0 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb0, sgt, 0)
        ir.add_operand(cb0, bd4, 1)
        ir.add_operand(cb0, ex, 1)
        // body：弹出成对 (s, d)
        g_cur_block = bd4
        var sl1 = s21_load(s21_gep(srcW, 8, true), T64)
        var srcs = s21_load(s21_gep(srcW, 16, true), types.named(TK_STR))
        var s = s21_load(s21_gep(srcs, s21_bin(2, s21_bin(1, sl1, tig_int_lit(1)), tig_int_lit(8)), false), types.named(TK_STR))
        s21_store(s21_gep(srcW, 8, true), s21_bin(1, sl1, tig_int_lit(1)), T64)
        var dl1 = s21_load(s21_gep(dstW, 8, true), T64)
        var dsts = s21_load(s21_gep(dstW, 16, true), types.named(TK_STR))
        var d = s21_load(s21_gep(dsts, s21_bin(2, s21_bin(1, dl1, tig_int_lit(1)), tig_int_lit(8)), false), types.named(TK_STR))
        s21_store(s21_gep(dstW, 8, true), s21_bin(1, dl1, tig_int_lit(1)), T64)
        // 创建当前 dst 目录（已存在则忽略）
        tig_mkdir_w(tig_wide16(d))
        // 遍历 src 目录条目
        var pw = tig_wide16(tig_wildpath(s))
        var fd = s21_raw_alloc_str(tig_int_lit(592))
        var hf = tig_find_first_w(pw, fd)
        var inv = tig_icmp_c(tig_p2i(hf), tig_int_lit(-1), 0)
        var bInv2 = ir.new_block(g_cur_func, interner.intern("cd.iv"))
        var bMv2 = ir.new_block(g_cur_func, interner.intern("cd.mv"))
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, inv, 0)
        ir.add_operand(cb, bInv2, 1)
        ir.add_operand(cb, bMv2, 1)
        g_cur_block = bInv2
        tig_ext_call1("free", fd, types.named(TK_STR), -1)
        var brb = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brb, hd, 1)
        // 内层循环
        g_cur_block = bMv2
        var top = ir.new_block(g_cur_func, interner.intern("cd.t"))
        var bri = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bri, top, 1)
        g_cur_block = top
        var name = tig_from_wide16(s21_gep(fd, 44, true))
        var ndw = tig_not_i1(tig_is_dotname(name))
        var bPr2 = ir.new_block(g_cur_func, interner.intern("cd.pr"))
        var bSk2 = ir.new_block(g_cur_func, interner.intern("cd.sp"))
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, ndw, 0)
        ir.add_operand(cb2, bPr2, 1)
        ir.add_operand(cb2, bSk2, 1)
        g_cur_block = bPr2
        var sItem = tig_join_path(s, name)
        var dItem = tig_join_path(d, name)
        var attr = s21_zext(s21_load(s21_gep(fd, 0, true), I32), I32)
        var dirf = tig_icmp_c(s21_bin(6, attr, tig_int_lit(0x10)), tig_int_lit(0), 1)
        var bAd3 = ir.new_block(g_cur_func, interner.intern("cd.ad"))
        var bDir = ir.new_block(g_cur_func, interner.intern("cd.dr"))
        var bFil = ir.new_block(g_cur_func, interner.intern("cd.fl"))
        var cb3 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb3, dirf, 0)
        ir.add_operand(cb3, bDir, 1)
        ir.add_operand(cb3, bFil, 1)
        // 子目录：建 dst 子目录 + 压入工作清单
        g_cur_block = bDir
        tig_mkdir_w(tig_wide16(dItem))
        tig_blob_push(srcW, sItem)
        tig_blob_push(dstW, dItem)
        var brd = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brd, bAd3, 1)
        // 文件：CopyFileW(sItem, dItem, 0)
        g_cur_block = bFil
        var sw = tig_wide16(sItem)
        var dw = tig_wide16(dItem)
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, P8);  table_push(avs, sw)
        table_push(ats, P8);  table_push(avs, dw)
        table_push(ats, I32); table_push(avs, tig_int_lit_ty(0, I32))
        tig_ext_call_typed("CopyFileW", ats, avs, I32)
        var brf2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brf2, bAd3, 1)
        g_cur_block = bSk2
        var brs = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brs, bAd3, 1)
        // adv + 推进
        g_cur_block = bAd3
        var cont = tig_win_ok(tig_find_next_w(hf, fd))
        var bEnd = ir.new_block(g_cur_func, interner.intern("cd.en"))
        var cb4 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb4, cont, 0)
        ir.add_operand(cb4, top, 1)
        ir.add_operand(cb4, bEnd, 1)
        g_cur_block = bEnd
        tig_find_close(hf)
        tig_ext_call1("free", fd, types.named(TK_STR), -1)
        var brh = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brh, hd, 1)
        // 完成：整体成功
        g_cur_block = ex
        return tig_bool_lit(1)
    }

    func tig_list_dir(p: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var P8 = types.ptr_of(types.named(TK_I8))
        var pw = tig_wide16(tig_wildpath(p))
        var fd = s21_raw_alloc_str(tig_int_lit(592))
        var hf = tig_find_first_w(pw, fd)
        var inv = tig_icmp_c(tig_p2i(hf), tig_int_lit(-1), 0)
        var rslt = ir.new_inst(g_cur_block, 20, types.named(TK_STR))
        ir.add_operand(rslt, types.named(TK_STR), 2)
        var sv = ir.get_value(rslt)
        s21_store(sv, tig_fill_table(s21_raw_alloc_str(tig_int_lit(8)), tig_int_lit(0), tig_int_lit(0)), types.named(TK_STR))
        var bBad = ir.new_block(g_cur_func, interner.intern("ls.bad"))
        var bC = ir.new_block(g_cur_func, interner.intern("ls.c"))
        var bM = ir.new_block(g_cur_func, interner.intern("ls.m"))
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, inv, 0)
        ir.add_operand(cb, bBad, 1)
        ir.add_operand(cb, bC, 1)
        g_cur_block = bBad
        tig_ext_call1("free", fd, types.named(TK_STR), -1)
        var brb = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brb, bM, 1)
        g_cur_block = bC
        var cnt = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(cnt, T64, 2)
        var cslot = ir.get_value(cnt)
        s21_store(cslot, tig_int_lit(0), T64)
        var top = ir.new_block(g_cur_func, interner.intern("ls.t"))
        var brc = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brc, top, 1)
        g_cur_block = top
        var nm = tig_from_wide16(s21_gep(fd, 44, true))
        var ndv = tig_not_i1(tig_is_dotname(nm))
        var bInc = ir.new_block(g_cur_func, interner.intern("ls.inc"))
        var bSkip = ir.new_block(g_cur_func, interner.intern("ls.sk"))
        var bAdv = ir.new_block(g_cur_func, interner.intern("ls.adv"))
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, ndv, 0)
        ir.add_operand(cb2, bInc, 1)
        ir.add_operand(cb2, bSkip, 1)
        g_cur_block = bInc
        s21_store(cslot, s21_bin(0, s21_load(cslot, T64), tig_int_lit(1)), T64)
        var bri = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bri, bAdv, 1)
        g_cur_block = bSkip
        var brs = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brs, bAdv, 1)
        g_cur_block = bAdv
        var cont = tig_win_ok(tig_find_next_w(hf, fd))
        var bDone = ir.new_block(g_cur_func, interner.intern("ls.done"))
        var cb3 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb3, cont, 0)
        ir.add_operand(cb3, top, 1)
        ir.add_operand(cb3, bDone, 1)
        g_cur_block = bDone
        var n = s21_load(cslot, T64)
        var data = s21_raw_alloc_str(s21_bin(2, n, tig_int_lit(8)))
        tig_find_close(hf)
        var hf2 = tig_find_first_w(pw, fd)
        var idx = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(idx, T64, 2)
        var islot = ir.get_value(idx)
        s21_store(islot, tig_int_lit(0), T64)
        var top2 = ir.new_block(g_cur_func, interner.intern("ls.t2"))
        var brc2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brc2, top2, 1)
        g_cur_block = top2
        var nm2 = tig_from_wide16(s21_gep(fd, 44, true))
        var nd2 = tig_not_i1(tig_is_dotname(nm2))
        var bFill = ir.new_block(g_cur_func, interner.intern("ls.fil"))
        var bSkp = ir.new_block(g_cur_func, interner.intern("ls.s2"))
        var bAd2 = ir.new_block(g_cur_func, interner.intern("ls.a2"))
        var cb4 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb4, nd2, 0)
        ir.add_operand(cb4, bFill, 1)
        ir.add_operand(cb4, bSkp, 1)
        g_cur_block = bFill
        var iv2 = s21_load(islot, T64)
        s21_store(s21_gep(data, s21_bin(2, iv2, tig_int_lit(8)), false), nm2, types.named(TK_STR))
        s21_store(islot, s21_bin(0, iv2, tig_int_lit(1)), T64)
        var brf2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brf2, bAd2, 1)
        g_cur_block = bSkp
        var brj = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brj, bAd2, 1)
        g_cur_block = bAd2
        var cont2 = tig_win_ok(tig_find_next_w(hf2, fd))
        var bMat = ir.new_block(g_cur_func, interner.intern("ls.mt"))
        var cb5 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb5, cont2, 0)
        ir.add_operand(cb5, top2, 1)
        ir.add_operand(cb5, bMat, 1)
        g_cur_block = bMat
        s21_store(sv, tig_fill_table(data, n, s21_load(islot, T64)), types.named(TK_STR))
        tig_find_close(hf2)
        tig_ext_call1("free", fd, types.named(TK_STR), -1)
        var brd = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brd, bM, 1)
        g_cur_block = bM
        return s21_load(sv, types.named(TK_STR))
    }

    func tig_blob_push(bhp: i64, sp: i64) {
        var T64 = types.named(TK_I64)
        var cap = s21_load(s21_gep(bhp, 0, true), T64)
        var lenn = s21_load(s21_gep(bhp, 8, true), T64)
        var data = s21_load(s21_gep(bhp, 16, true), types.named(TK_STR))
        var need = s21_bin(0, lenn, tig_int_lit(1))
        var gc = tig_icmp_c(need, cap, 3)
        var gt = ir.new_block(g_cur_func, interner.intern("bp.gt"))
        var ge = ir.new_block(g_cur_func, interner.intern("bp.ge"))
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, gc, 0)
        ir.add_operand(cb, gt, 1)
        ir.add_operand(cb, ge, 1)
        g_cur_block = gt
        var nc = tig_select_i(tig_cmp_zero(cap, 0), tig_int_lit(4), s21_bin(2, cap, tig_int_lit(2)), T64)
        var c_lt = tig_icmp_c(nc, need, 2)
        var newcap = tig_select_i(c_lt, need, nc, T64)
        var nd = s21_raw_alloc_str(s21_bin(2, newcap, tig_int_lit(8)))
        s21_memcpy_if(nd, data, s21_bin(2, lenn, tig_int_lit(8)))
        tig_ext_call1("free", data, types.named(TK_STR), -1)
        s21_store(s21_gep(bhp, 16, true), nd, types.named(TK_STR))
        s21_store(s21_gep(bhp, 0, true), newcap, T64)
        var brg = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brg, ge, 1)
        g_cur_block = ge
        var data2 = s21_load(s21_gep(bhp, 16, true), types.named(TK_STR))
        var l2 = s21_load(s21_gep(bhp, 8, true), T64)
        s21_store(s21_gep(data2, s21_bin(2, l2, tig_int_lit(8)), false), sp, types.named(TK_STR))
        s21_store(s21_gep(bhp, 8, true), need, T64)
    }

    func tig_walk_dir(p: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var I8 = types.named(TK_I8)
        var P8 = types.ptr_of(I8)
        var rslt = ir.new_inst(g_cur_block, 20, types.named(TK_STR))
        ir.add_operand(rslt, types.named(TK_STR), 2)
        var sv = ir.get_value(rslt)
        // 结果表 blob（增长式字符串指针数组）
        var rbh = s21_raw_alloc_str(tig_int_lit(24))
        s21_store(s21_gep(rbh, 0, true), tig_int_lit(0), T64)
        s21_store(s21_gep(rbh, 8, true), tig_int_lit(0), T64)
        s21_store(s21_gep(rbh, 16, true), tig_int_lit(0), types.named(TK_STR))
        // 目录工作清单 blob（迭代式 DFS，避免生成中途嵌套递归函数）
        var wbh = s21_raw_alloc_str(tig_int_lit(24))
        s21_store(s21_gep(wbh, 0, true), tig_int_lit(0), T64)
        s21_store(s21_gep(wbh, 8, true), tig_int_lit(0), T64)
        s21_store(s21_gep(wbh, 16, true), tig_int_lit(0), types.named(TK_STR))
        tig_blob_push(wbh, p)  // 种子：根目录
        // 外层循环：while work.len > 0
        var hd = ir.new_block(g_cur_func, interner.intern("wk.h"))
        var bd3 = ir.new_block(g_cur_func, interner.intern("wk.b"))
        var ex = ir.new_block(g_cur_func, interner.intern("wk.x"))
        var br0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br0, hd, 1)
        g_cur_block = hd
        var wl = s21_load(s21_gep(wbh, 8, true), T64)
        var wgt = tig_icmp_c(wl, tig_int_lit(0), 3)  // wl > 0
        var cb0 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb0, wgt, 0)
        ir.add_operand(cb0, bd3, 1)
        ir.add_operand(cb0, ex, 1)
        // body：弹出工作清单栈顶目录
        g_cur_block = bd3
        var wld = s21_load(s21_gep(wbh, 8, true), T64)
        var wdat = s21_load(s21_gep(wbh, 16, true), types.named(TK_STR))
        var popdir = s21_load(s21_gep(wdat, s21_bin(2, s21_bin(1, wld, tig_int_lit(1)), tig_int_lit(8)), false), types.named(TK_STR))
        s21_store(s21_gep(wbh, 8, true), s21_bin(1, wld, tig_int_lit(1)), T64)
        // 列出该目录的直接条目
        var pw = tig_wide16(tig_wildpath(popdir))
        var fd = s21_raw_alloc_str(tig_int_lit(592))
        var hf = tig_find_first_w(pw, fd)
        var inv = tig_icmp_c(tig_p2i(hf), tig_int_lit(-1), 0)
        var bInvb = ir.new_block(g_cur_func, interner.intern("wk.iv"))
        var bMv = ir.new_block(g_cur_func, interner.intern("wk.mv"))
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, inv, 0)
        ir.add_operand(cb, bInvb, 1)
        ir.add_operand(cb, bMv, 1)
        g_cur_block = bInvb
        tig_ext_call1("free", fd, types.named(TK_STR), -1)
        var brb = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brb, hd, 1)  // 空目录 → 回外层循环
        // 内层循环：遍历条目
        g_cur_block = bMv
        var top = ir.new_block(g_cur_func, interner.intern("wk.t"))
        var bri = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bri, top, 1)
        g_cur_block = top
        var name = tig_from_wide16(s21_gep(fd, 44, true))
        var ndw = tig_not_i1(tig_is_dotname(name))
        var bProc = ir.new_block(g_cur_func, interner.intern("wk.pr"))
        var bSkp = ir.new_block(g_cur_func, interner.intern("wk.sp"))
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, ndw, 0)
        ir.add_operand(cb2, bProc, 1)
        ir.add_operand(cb2, bSkp, 1)
        g_cur_block = bProc
        var full = tig_join_path(popdir, name)
        tig_blob_push(rbh, full)
        var attr = s21_zext(s21_load(s21_gep(fd, 0, true), I32), I32)
        var dirf = tig_icmp_c(s21_bin(6, attr, tig_int_lit(0x10)), tig_int_lit(0), 1)
        var bPush2 = ir.new_block(g_cur_func, interner.intern("wk.ps"))
        var bAd = ir.new_block(g_cur_func, interner.intern("wk.ad"))
        var cb3 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb3, dirf, 0)
        ir.add_operand(cb3, bPush2, 1)
        ir.add_operand(cb3, bAd, 1)
        g_cur_block = bPush2
        tig_blob_push(wbh, full)  // 子目录压入工作清单
        var brp = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brp, bAd, 1)
        g_cur_block = bSkp
        var brs = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brs, bAd, 1)
        g_cur_block = bAd
        var cont = tig_win_ok(tig_find_next_w(hf, fd))
        var bEnd = ir.new_block(g_cur_func, interner.intern("wk.en"))
        var cb4 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb4, cont, 0)
        ir.add_operand(cb4, top, 1)
        ir.add_operand(cb4, bEnd, 1)
        g_cur_block = bEnd
        tig_find_close(hf)
        tig_ext_call1("free", fd, types.named(TK_STR), -1)
        var brh = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brh, hd, 1)  // 该目录遍历完 → 回外层循环
        // 外层循环结束：组装结果表
        g_cur_block = ex
        var cap = s21_load(s21_gep(rbh, 0, true), T64)
        var lenn = s21_load(s21_gep(rbh, 8, true), T64)
        var dat = s21_load(s21_gep(rbh, 16, true), types.named(TK_STR))
        s21_store(sv, tig_fill_table(dat, cap, lenn), types.named(TK_STR))
        return s21_load(sv, types.named(TK_STR))
    }

    // ==================== p.6.4.9 HTTP 原语内联（Winsock + HTTP/1.1） ====================
    // http_get / http_get_file 从 Rust 桥（tie_http_get/tie_http_get_file，g_used_interp
    // 置位）改为编译器内联 IR：URL 解析 → gethostbyname/connect → GET 请求 →
    // 响应头/体解析。零 Rust 桥（仅复用 p.6.4.5 net_* 内联）。
    // 仅 http://（https 需 TLS，p.6.6.1 再做，本任务 https 返回空串/失败）。
    // 协议：GET + Host + Connection: close → 读全部到 EOF（服务端因 Connection: close
    // 会关闭连接）；解析头找 Content-Length 截取 body；无 Content-Length 读到 EOF。
    // 局限：http_get 返回 tie string，body 含 ≥0x80 字节会破坏 UTF-8 语义（真正二进制
    // 走 p.6.6.1 TLS 后的字节版）；连接/解析/非 2xx 均返回空串。
    // 全部辅助生成内联 tie-IR（零新 opcode、零 tie_interp 桥调用）。

    // 前缀匹配：s 是否以 p（带头串）开头（逐字节；s 短则 false）
    func tig_str_starts_with(s: i64, p: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var TB = types.named(TK_BOOL)
        var sn = s21_str_head_len(s)
        var pn = s21_str_head_len(p)
        var short_c = tig_icmp_c(sn, pn, 2)  // sn < pn
        var rs = ir.new_inst(g_cur_block, 20, TB)
        ir.add_operand(rs, TB, 2)
        var rp = ir.get_value(rs)
        s21_store(rp, tig_bool_lit(0), TB)
        var bOk = ir.new_block(g_cur_func, interner.intern("sw.ok"))
        var bSh = ir.new_block(g_cur_func, interner.intern("sw.sh"))
        var bM = ir.new_block(g_cur_func, interner.intern("sw.m"))
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, short_c, 0)
        ir.add_operand(cb, bSh, 1)
        ir.add_operand(cb, bOk, 1)
        g_cur_block = bSh
        var brs = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brs, bM, 1)
        // 逐字节比较
        g_cur_block = bOk
        var ia = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(ia, T64, 2)
        var ip = ir.get_value(ia)
        var ka = ir.new_inst(g_cur_block, 20, TB)
        ir.add_operand(ka, TB, 2)
        var kp = ir.get_value(ka)
        s21_store(ip, tig_int_lit(0), T64)
        s21_store(kp, tig_bool_lit(1), TB)
        var hd = ir.new_block(g_cur_func, interner.intern("sw.h"))
        var bd = ir.new_block(g_cur_func, interner.intern("sw.b"))
        var ex = ir.new_block(g_cur_func, interner.intern("sw.x"))
        var br0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br0, hd, 1)
        g_cur_block = hd
        var iv = s21_load(ip, T64)
        var ic = tig_icmp_c(iv, pn, 2)
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, ic, 0)
        ir.add_operand(cb2, bd, 1)
        ir.add_operand(cb2, ex, 1)
        g_cur_block = bd
        var iv2 = s21_load(ip, T64)
        var bs = s21_str_byte(s, iv2)
        var bp = s21_str_byte(p, iv2)
        var eq = tig_icmp_c(bs, bp, 0)
        var kv = s21_load(kp, TB)
        s21_store(kp, tig_and_i1(kv, eq), TB)
        s21_store(ip, s21_bin(0, iv2, tig_int_lit(1)), T64)
        var brb = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brb, hd, 1)
        g_cur_block = ex
        var kv2 = s21_load(kp, TB)
        s21_store(rp, kv2, TB)
        var brk = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brk, bM, 1)
        g_cur_block = bM
        return s21_load(rp, TB)
    }

    // ASCII 大小写折叠（'A'-'Z' → +32）：HTTP 头名大小写不敏感匹配
    func tig_tolower_b(b: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var is_upper = tig_and_i1(tig_icmp_c(b, tig_int_lit(65), 5), tig_icmp_c(b, tig_int_lit(90), 4))
        return tig_select_i(is_upper, s21_bin(0, b, tig_int_lit(32)), b, T64)
    }

    // 原始字节缓冲 buf[0..blen) 中查找模式 pat（带头串）从 start 起；
    // ci=大小写不敏感。返回首个匹配下标（-1 未找到）。
    func tig_bfind(buf: i64, blen: i64, pat: i64, plen: i64, start: i64, ci: bool) -> i64 {
        var T64 = types.named(TK_I64)
        var I8 = types.named(TK_I8)
        var rs = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(rs, T64, 2)
        var rp = ir.get_value(rs)
        s21_store(rp, tig_int_lit(-1), T64)
        var ia = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(ia, T64, 2)
        var ip = ir.get_value(ia)
        s21_store(ip, start, T64)
        var last = s21_bin(1, s21_bin(0, blen, tig_int_lit(1)), plen)  // blen+1-plen（i 上限）
        var hd = ir.new_block(g_cur_func, interner.intern("bf.h"))
        var bd = ir.new_block(g_cur_func, interner.intern("bf.b"))
        var ex = ir.new_block(g_cur_func, interner.intern("bf.x"))
        var br0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br0, hd, 1)
        g_cur_block = hd
        var iv = s21_load(ip, T64)
        var ic = tig_icmp_c(iv, last, 2)
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, ic, 0)
        ir.add_operand(cb, bd, 1)
        ir.add_operand(cb, ex, 1)
        // body：内层 j 循环匹配
        g_cur_block = bd
        var ja = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(ja, T64, 2)
        var jp = ir.get_value(ja)
        var ma = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(ma, T64, 2)
        var mp = ir.get_value(ma)
        s21_store(jp, tig_int_lit(0), T64)
        s21_store(mp, tig_int_lit(1), T64)
        var jh = ir.new_block(g_cur_func, interner.intern("bf.jh"))
        var jb = ir.new_block(g_cur_func, interner.intern("bf.jb"))
        var jx = ir.new_block(g_cur_func, interner.intern("bf.jx"))
        var brj = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brj, jh, 1)
        g_cur_block = jh
        var jv = s21_load(jp, T64)
        var jc = tig_icmp_c(jv, plen, 2)
        var cbj = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cbj, jc, 0)
        ir.add_operand(cbj, jb, 1)
        ir.add_operand(cbj, jx, 1)
        g_cur_block = jb
        var j2 = s21_load(jp, T64)
        var iv2 = s21_load(ip, T64)
        var bb = s21_zext(s21_load(s21_gep(buf, s21_bin(0, iv2, j2), false), I8), I8)
        var pb = s21_zext(s21_load(s21_gep(pat, j2, false), I8), I8)
        if ci {
            bb = tig_tolower_b(bb)
            pb = tig_tolower_b(pb)
        }
        var eq = tig_icmp_c(bb, pb, 0)
        var m1 = s21_load(mp, T64)
        s21_store(mp, tig_select_i(eq, m1, tig_int_lit(0), T64), T64)
        s21_store(jp, s21_bin(0, j2, tig_int_lit(1)), T64)
        var brjb = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brjb, jh, 1)
        // jx：匹配 → 写结果并退出；否则 i++ 继续
        g_cur_block = jx
        var mv = s21_load(mp, T64)
        var ism = tig_icmp_c(mv, tig_int_lit(1), 0)
        var bGot = ir.new_block(g_cur_func, interner.intern("bf.g"))
        var bNxt = ir.new_block(g_cur_func, interner.intern("bf.n"))
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, ism, 0)
        ir.add_operand(cb2, bGot, 1)
        ir.add_operand(cb2, bNxt, 1)
        g_cur_block = bGot
        s21_store(rp, s21_load(ip, T64), T64)
        var brg = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brg, ex, 1)
        g_cur_block = bNxt
        s21_store(ip, s21_bin(0, s21_load(ip, T64), tig_int_lit(1)), T64)
        var brn = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brn, hd, 1)
        g_cur_block = ex
        return s21_load(rp, T64)
    }

    // 解析 buf[lo..hi) 十进制 ASCII 数字 → i64
    func tig_parse_dec(buf: i64, lo: i64, hi: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I8 = types.named(TK_I8)
        var aa = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(aa, T64, 2)
        var ap = ir.get_value(aa)
        var ka = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(ka, T64, 2)
        var kp = ir.get_value(ka)
        s21_store(ap, tig_int_lit(0), T64)
        s21_store(kp, lo, T64)
        var hd = ir.new_block(g_cur_func, interner.intern("pd.h"))
        var bd = ir.new_block(g_cur_func, interner.intern("pd.b"))
        var ex = ir.new_block(g_cur_func, interner.intern("pd.x"))
        var br0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br0, hd, 1)
        g_cur_block = hd
        var kv = s21_load(kp, T64)
        var kc = tig_icmp_c(kv, hi, 2)
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, kc, 0)
        ir.add_operand(cb, bd, 1)
        ir.add_operand(cb, ex, 1)
        g_cur_block = bd
        var kv2 = s21_load(kp, T64)
        var b = s21_zext(s21_load(s21_gep(buf, kv2, false), I8), I8)
        var av = s21_load(ap, T64)
        var tenv = tig_int_lit(10)
        var mul = ir.new_inst(g_cur_block, 2, T64)
        ir.add_operand(mul, av, 0)
        ir.add_operand(mul, tenv, 0)
        var nv = s21_bin(0, ir.get_value(mul), s21_bin(1, b, tig_int_lit(48)))
        s21_store(ap, nv, T64)
        s21_store(kp, s21_bin(0, kv2, tig_int_lit(1)), T64)
        var brb = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brb, hd, 1)
        g_cur_block = ex
        return s21_load(ap, T64)
    }

    // 解析 HTTP Content-Length 头值：cpos = "content-length:" 位置；跳过其后
    // 空格/制表，扫描十进制数字；写 clenp（无数字 → -1）。body_off 为头结束位置。
    func tig_parse_clen(rdata: i64, rlen: i64, cpos: i64, body_off: i64, clenp: i64) {
        var T64 = types.named(TK_I64)
        var I8 = types.named(TK_I8)
        s21_store(clenp, tig_int_lit(-1), T64)
        var pa = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(pa, T64, 2)
        var pap = ir.get_value(pa)
        var ds = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(ds, T64, 2)
        var dsp = ir.get_value(ds)
        var hd = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(hd, T64, 2)
        var hdp = ir.get_value(hd)
        s21_store(pap, s21_bin(0, cpos, tig_int_lit(15)), T64)
        s21_store(dsp, tig_int_lit(0), T64)
        s21_store(hdp, tig_int_lit(0), T64)
        var ch = ir.new_block(g_cur_func, interner.intern("cl.h"))
        var cb2 = ir.new_block(g_cur_func, interner.intern("cl.b"))
        var cx = ir.new_block(g_cur_func, interner.intern("cl.x"))
        var bDo = ir.new_block(g_cur_func, interner.intern("cl.do"))
        var bSp = ir.new_block(g_cur_func, interner.intern("cl.sp"))
        var bStop = ir.new_block(g_cur_func, interner.intern("cl.st"))
        var bFst = ir.new_block(g_cur_func, interner.intern("cl.f"))
        var bNf = ir.new_block(g_cur_func, interner.intern("cl.n"))
        var bHv = ir.new_block(g_cur_func, interner.intern("cl.hv"))
        var bNo = ir.new_block(g_cur_func, interner.intern("cl.no"))
        var bM = ir.new_block(g_cur_func, interner.intern("cl.m"))
        var br0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br0, ch, 1)
        g_cur_block = ch
        var pv = s21_load(pap, T64)
        var pvl = tig_icmp_c(pv, body_off, 2)
        var cb3 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb3, pvl, 0)
        ir.add_operand(cb3, cb2, 1)
        ir.add_operand(cb3, cx, 1)
        g_cur_block = cb2
        var pv2 = s21_load(pap, T64)
        var b = s21_str_byte(rdata, pv2)
        var g48 = tig_icmp_c(b, tig_int_lit(48), 5)
        var l57 = tig_icmp_c(b, tig_int_lit(57), 4)
        var isd = tig_and_i1(g48, l57)
        var sp1 = tig_icmp_c(b, tig_int_lit(32), 0)
        var sp2 = tig_icmp_c(b, tig_int_lit(9), 0)
        var issp = tig_or_i1(sp1, sp2)
        var cb4 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb4, isd, 0)
        ir.add_operand(cb4, bDo, 1)
        ir.add_operand(cb4, bSp, 1)
        // 空格：仅首数字前跳过（已见数字则停止）
        g_cur_block = bSp
        var hv = s21_load(hdp, T64)
        var hvn = tig_icmp_c(hv, tig_int_lit(0), 1)
        var cb5 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb5, hvn, 0)
        ir.add_operand(cb5, bStop, 1)
        ir.add_operand(cb5, bDo, 1)
        g_cur_block = bStop
        var brs = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brs, cx, 1)
        // 数字：记录起点（首次）后前进
        g_cur_block = bDo
        var pv3 = s21_load(pap, T64)
        var hv2 = s21_load(hdp, T64)
        var hz = tig_icmp_c(hv2, tig_int_lit(0), 0)
        var cb6 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb6, hz, 0)
        ir.add_operand(cb6, bFst, 1)
        ir.add_operand(cb6, bNf, 1)
        g_cur_block = bFst
        s21_store(dsp, pv3, T64)
        s21_store(hdp, tig_int_lit(1), T64)
        var brf = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brf, bNf, 1)
        g_cur_block = bNf
        var pv4 = s21_load(pap, T64)
        s21_store(pap, s21_bin(0, pv4, tig_int_lit(1)), T64)
        var brn = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brn, ch, 1)
        // 扫描毕：有数字 → parse_dec
        g_cur_block = cx
        var hv3 = s21_load(hdp, T64)
        var hzn = tig_icmp_c(hv3, tig_int_lit(0), 1)
        var cb7 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb7, hzn, 0)
        ir.add_operand(cb7, bHv, 1)
        ir.add_operand(cb7, bNo, 1)
        g_cur_block = bHv
        var clv = tig_parse_dec(rdata, s21_load(dsp, T64), s21_load(pap, T64))
        s21_store(clenp, clv, T64)
        var brh = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brh, bM, 1)
        g_cur_block = bNo
        var brno = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brno, bM, 1)
        g_cur_block = bM
    }
    // URL 解析：http://host[:port]/path → host/port/path（okf_slot=1 成功）。
    // 仅 http://；https 或非法 → okf=0（host/path 未定义）。
    func tig_url_parse(url: i64, host_slot: i64, port_slot: i64, path_slot: i64, okf_slot: i64) {
        var T64 = types.named(TK_I64)
        var I8 = types.named(TK_I8)
        var ST = types.named(TK_STR)
        var TB = types.named(TK_BOOL)
        var ulen = s21_str_head_len(url)
        s21_store(okf_slot, tig_bool_lit(0), TB)
        s21_store(port_slot, tig_int_lit(80), T64)
        s21_store(path_slot, tig_str_lit(interner.intern("\"/\"")), ST)
        var is_https = tig_str_starts_with(url, tig_str_lit(interner.intern("\"https://\"")))
        var is_http = tig_str_starts_with(url, tig_str_lit(interner.intern("\"http://\"")))
        var pre_ok = tig_and_i1(is_http, tig_not_i1(is_https))
        var bBad = ir.new_block(g_cur_func, interner.intern("up.bad"))
        var bParse = ir.new_block(g_cur_func, interner.intern("up.p"))
        var bM = ir.new_block(g_cur_func, interner.intern("up.m"))
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, pre_ok, 0)
        ir.add_operand(cb, bParse, 1)
        ir.add_operand(cb, bBad, 1)
        g_cur_block = bBad
        var brb = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brb, bM, 1)
        // 扫描 host：i 从 7 到 ':' 或 '/' 或串尾
        g_cur_block = bParse
        var ia = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(ia, T64, 2)
        var ip = ir.get_value(ia)
        s21_store(ip, tig_int_lit(7), T64)
        var hh = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(hh, T64, 2)
        var hp = ir.get_value(hh)
        s21_store(hp, tig_int_lit(7), T64)
        var hh2 = ir.new_block(g_cur_func, interner.intern("up.hh"))
        var hb2 = ir.new_block(g_cur_func, interner.intern("up.hb"))
        var hx = ir.new_block(g_cur_func, interner.intern("up.hx"))
        var hs = ir.new_block(g_cur_func, interner.intern("up.hs"))
        var hc = ir.new_block(g_cur_func, interner.intern("up.hc"))
        var brh = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brh, hh2, 1)
        g_cur_block = hh2
        var iv = s21_load(ip, T64)
        var ilt = tig_icmp_c(iv, ulen, 2)
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, ilt, 0)
        ir.add_operand(cb2, hb2, 1)
        ir.add_operand(cb2, hx, 1)
        g_cur_block = hb2
        var iv2 = s21_load(ip, T64)
        var b1 = s21_str_byte(url, iv2)
        var isc = tig_icmp_c(b1, tig_int_lit(58), 0)  // ':'
        var iss = tig_icmp_c(b1, tig_int_lit(47), 0)  // '/'
        var stop = tig_or_i1(isc, iss)
        var cb3 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb3, stop, 0)
        ir.add_operand(cb3, hx, 1)
        ir.add_operand(cb3, hs, 1)
        g_cur_block = hs
        s21_store(ip, s21_bin(0, iv2, tig_int_lit(1)), T64)
        var brs = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brs, hh2, 1)
        g_cur_block = hx
        var hiv = s21_load(ip, T64)
        s21_store(hp, hiv, T64)
        // host 非空检查（hh > 7）
        var host_empty = tig_icmp_c(hiv, tig_int_lit(7), 4)  // hh <= 7
        var bHe = ir.new_block(g_cur_func, interner.intern("up.he"))
        var bPs = ir.new_block(g_cur_func, interner.intern("up.ps"))
        var cb4 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb4, host_empty, 0)
        ir.add_operand(cb4, bHe, 1)
        ir.add_operand(cb4, bPs, 1)
        g_cur_block = bHe
        var brhe = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brhe, bM, 1)
        // 提取 host
        g_cur_block = bPs
        var host_s = s21_str_sub_bytes(url, tig_int_lit(7), hiv)
        s21_store(host_slot, host_s, ST)
        // 端口：若 i < ulen 且 byte==':' → 解析数字
        var i3 = s21_load(ip, T64)
        var in_ul = tig_icmp_c(i3, ulen, 2)
        var b_c = s21_str_byte(url, i3)
        var iscol = tig_icmp_c(b_c, tig_int_lit(58), 0)
        var has_port = tig_and_i1(in_ul, iscol)
        var bP = ir.new_block(g_cur_func, interner.intern("up.po"))
        var bNoP = ir.new_block(g_cur_func, interner.intern("up.np"))
        var bPa = ir.new_block(g_cur_func, interner.intern("up.pa"))
        var cb5 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb5, has_port, 0)
        ir.add_operand(cb5, bP, 1)
        ir.add_operand(cb5, bNoP, 1)
        g_cur_block = bP
        s21_store(ip, s21_bin(0, i3, tig_int_lit(1)), T64)  // i = i+1
        var plo = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(plo, T64, 2)
        var plop = ir.get_value(plo)
        s21_store(plop, s21_load(ip, T64), T64)
        // 扫描数字
        var pdh = ir.new_block(g_cur_func, interner.intern("up.pdh"))
        var pdb = ir.new_block(g_cur_func, interner.intern("up.pdb"))
        var pdx = ir.new_block(g_cur_func, interner.intern("up.pdx"))
        var pds = ir.new_block(g_cur_func, interner.intern("up.pds"))
        var brp = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brp, pdh, 1)
        g_cur_block = pdh
        var ivp = s21_load(ip, T64)
        var iltp = tig_icmp_c(ivp, ulen, 2)
        var cb6 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb6, iltp, 0)
        ir.add_operand(cb6, pdb, 1)
        ir.add_operand(cb6, pdx, 1)
        g_cur_block = pdb
        var ivp2 = s21_load(ip, T64)
        var bd1 = s21_str_byte(url, ivp2)
        var ge48 = tig_icmp_c(bd1, tig_int_lit(48), 5)
        var le57 = tig_icmp_c(bd1, tig_int_lit(57), 4)
        var is_dig = tig_and_i1(ge48, le57)
        var cb7 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb7, is_dig, 0)
        ir.add_operand(cb7, pds, 1)
        ir.add_operand(cb7, pdx, 1)
        g_cur_block = pds
        s21_store(ip, s21_bin(0, ivp2, tig_int_lit(1)), T64)
        var brps = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brps, pdh, 1)
        g_cur_block = pdx
        var pv = s21_load(ip, T64)
        var plov = s21_load(plop, T64)
        var no_digit = tig_icmp_c(pv, plov, 4)  // i <= plo → 无数字
        var bPd = ir.new_block(g_cur_func, interner.intern("up.pd"))
        var bPk = ir.new_block(g_cur_func, interner.intern("up.pk"))
        var cb8 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb8, no_digit, 0)
        ir.add_operand(cb8, bPd, 1)
        ir.add_operand(cb8, bPk, 1)
        g_cur_block = bPd
        var brpd = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brpd, bM, 1)
        g_cur_block = bPk
        var portv = tig_parse_dec(url, plov, pv)
        s21_store(port_slot, portv, T64)
        var brpk = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brpk, bPa, 1)
        g_cur_block = bNoP
        var brnp = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brnp, bPa, 1)
        // 路径：i < ulen 且 '/' → url[i..ulen]；否则 "/"
        g_cur_block = bPa
        var i5 = s21_load(ip, T64)
        var in_ul2 = tig_icmp_c(i5, ulen, 2)
        var b2 = s21_str_byte(url, i5)
        var iss2 = tig_icmp_c(b2, tig_int_lit(47), 0)
        var has_path = tig_and_i1(in_ul2, iss2)
        var bPath = ir.new_block(g_cur_func, interner.intern("up.pth"))
        var bNoPath = ir.new_block(g_cur_func, interner.intern("up.np2"))
        var bPf = ir.new_block(g_cur_func, interner.intern("up.pf"))
        var cb9 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb9, has_path, 0)
        ir.add_operand(cb9, bPath, 1)
        ir.add_operand(cb9, bNoPath, 1)
        g_cur_block = bPath
        var i6 = s21_load(ip, T64)
        var path_s = s21_str_sub_bytes(url, i6, ulen)
        s21_store(path_slot, path_s, ST)
        var brp2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brp2, bPf, 1)
        g_cur_block = bNoPath
        s21_store(path_slot, tig_str_lit(interner.intern("\"/\"")), ST)
        var brn2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brn2, bPf, 1)
        g_cur_block = bPf
        s21_store(okf_slot, tig_bool_lit(1), TB)
        var brf = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brf, bM, 1)
        g_cur_block = bM
    }

    // HTTP GET 抓取：URL 解析 → 连接 → 请求 → 读全部响应到 EOF。
    // 输出 rdata_slot/rlen_slot（原始响应缓冲）+ ok_slot（bool 成功）。
    // 不检查状态码（2xx/4xx 均返回体）；仅连接/协议/解析失败 → ok=false。
    func tig_http_fetch(url: i64, rdata_slot: i64, rlen_slot: i64, ok_slot: i64) {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var I8 = types.named(TK_I8)
        var ST = types.named(TK_STR)
        var TB = types.named(TK_BOOL)
        // 结果槽
        var hs = ir.new_inst(g_cur_block, 20, ST)
        ir.add_operand(hs, ST, 2)
        var hsp = ir.get_value(hs)
        var ps = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(ps, T64, 2)
        var psp = ir.get_value(ps)
        var pth = ir.new_inst(g_cur_block, 20, ST)
        ir.add_operand(pth, ST, 2)
        var pthp = ir.get_value(pth)
        var okf = ir.new_inst(g_cur_block, 20, TB)
        ir.add_operand(okf, TB, 2)
        var okfp = ir.get_value(okf)
        s21_store(ok_slot, tig_bool_lit(0), TB)
        tig_url_parse(url, hsp, psp, pthp, okfp)
        // 解析成功 → 连接
        var uok = ir.new_inst(g_cur_block, 20, TB)
        ir.add_operand(uok, TB, 2)
        var uokp = ir.get_value(uok)
        s21_store(uokp, s21_load(okfp, TB), TB)
        var bGo = ir.new_block(g_cur_func, interner.intern("hf.go"))
        var bAbort = ir.new_block(g_cur_func, interner.intern("hf.ab"))
        var bM1 = ir.new_block(g_cur_func, interner.intern("hf.m1"))
        var ok_cond = s21_load(okfp, TB)
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, ok_cond, 0)
        ir.add_operand(cb, bGo, 1)
        ir.add_operand(cb, bAbort, 1)
        g_cur_block = bAbort
        var brab = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brab, bM1, 1)
        // 连接
        g_cur_block = bGo
        var fd = tig_net_tcp_connect(s21_load(hsp, ST), s21_load(psp, T64))
        var fdbad = tig_icmp_c(fd, tig_int_lit(-1), 0)
        var bCbad = ir.new_block(g_cur_func, interner.intern("hf.cb"))
        var bCok = ir.new_block(g_cur_func, interner.intern("hf.ck"))
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, fdbad, 0)
        ir.add_operand(cb2, bCbad, 1)
        ir.add_operand(cb2, bCok, 1)
        g_cur_block = bCbad
        var brc = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brc, bM1, 1)
        // 构建请求
        g_cur_block = bCok
        var req = s21_sb_new()
        s21_sb_append(req, tig_str_lit(interner.intern("\"GET \"")))
        s21_sb_append(req, s21_load(pthp, ST))
        s21_sb_append(req, tig_str_lit(interner.intern("\" HTTP/1.1\r\nHost: \"")))
        s21_sb_append(req, s21_load(hsp, ST))
        var pv = s21_load(psp, T64)
        var is80 = tig_icmp_c(pv, tig_int_lit(80), 0)
        var bP80 = ir.new_block(g_cur_func, interner.intern("hf.p80"))
        var bPnp = ir.new_block(g_cur_func, interner.intern("hf.pnp"))
        var bPh = ir.new_block(g_cur_func, interner.intern("hf.ph"))
        var cb3 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb3, is80, 0)
        ir.add_operand(cb3, bP80, 1)
        ir.add_operand(cb3, bPnp, 1)
        g_cur_block = bPnp
        s21_sb_append(req, tig_str_lit(interner.intern("\":\"")))
        s21_sb_append(req, tig_i64_to_str(s21_load(psp, T64), false))
        var brp = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brp, bPh, 1)
        g_cur_block = bP80
        var brp2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brp2, bPh, 1)
        g_cur_block = bPh
        s21_sb_append(req, tig_str_lit(interner.intern("\"\r\nConnection: close\r\n\r\n\"")))
        var reqs = s21_sb_build(req)
        tig_net_tcp_send(fd, reqs)
        // 读全部到 EOF
        var resp = s21_sb_new()
        var rch = ir.new_block(g_cur_func, interner.intern("hf.rh"))
        var rcb2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(rcb2, rch, 1)
        g_cur_block = rch
        var chunk = tig_net_tcp_recv(fd, tig_int_lit(65536))
        var cl = s21_str_head_len(chunk)
        var cz = tig_icmp_c(cl, tig_int_lit(0), 0)  // cl == 0 → EOF
        var bRd = ir.new_block(g_cur_func, interner.intern("hf.rd"))
        var bRdone = ir.new_block(g_cur_func, interner.intern("hf.rx"))
        var cb4 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb4, cz, 0)
        ir.add_operand(cb4, bRdone, 1)
        ir.add_operand(cb4, bRd, 1)
        g_cur_block = bRd
        s21_sb_append(resp, chunk)
        var brr = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brr, rch, 1)
        g_cur_block = bRdone
        tig_net_close(fd)
        // 输出
        s21_store(rdata_slot, tig_sb_data(resp), ST)
        s21_store(rlen_slot, tig_sb_len(resp), T64)
        s21_store(ok_slot, tig_bool_lit(1), TB)
        var brk = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brk, bM1, 1)
        g_cur_block = bM1
    }

    // http_get(url) → body string（成功）；失败返回空串。
    func tig_http_get(url: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I8 = types.named(TK_I8)
        var ST = types.named(TK_STR)
        var TB = types.named(TK_BOOL)
        var rslt = ir.new_inst(g_cur_block, 20, ST)
        ir.add_operand(rslt, ST, 2)
        var rv = ir.get_value(rslt)
        s21_store(rv, tig_str_lit(interner.intern("\"\"")), ST)
        var ds = ir.new_inst(g_cur_block, 20, ST)
        ir.add_operand(ds, ST, 2)
        var dsp = ir.get_value(ds)
        var ls = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(ls, T64, 2)
        var lsp = ir.get_value(ls)
        var ok = ir.new_inst(g_cur_block, 20, TB)
        ir.add_operand(ok, TB, 2)
        var okp = ir.get_value(ok)
        s21_store(okp, tig_bool_lit(0), TB)
        tig_http_fetch(url, dsp, lsp, okp)
        // ok → 解析头/体
        var bGo = ir.new_block(g_cur_func, interner.intern("hg.go"))
        var bAb = ir.new_block(g_cur_func, interner.intern("hg.ab"))
        var bM = ir.new_block(g_cur_func, interner.intern("hg.m"))
        var ok_cond = s21_load(okp, TB)
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, ok_cond, 0)
        ir.add_operand(cb, bGo, 1)
        ir.add_operand(cb, bAb, 1)
        g_cur_block = bAb
        var brb = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brb, bM, 1)
        // 头结束 = 找 "\r\n\r\n"
        g_cur_block = bGo
        var rdata = s21_load(dsp, ST)
        var rlen = s21_load(lsp, T64)
        var he = tig_bfind(rdata, rlen, tig_str_lit(interner.intern("\"\r\n\r\n\"")), tig_int_lit(4), tig_int_lit(0), false)
        var hebad = tig_icmp_c(he, tig_int_lit(0), 2)  // he < 0
        var bHb = ir.new_block(g_cur_func, interner.intern("hg.hb"))
        var bHk = ir.new_block(g_cur_func, interner.intern("hg.hk"))
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, hebad, 0)
        ir.add_operand(cb2, bHb, 1)
        ir.add_operand(cb2, bHk, 1)
        g_cur_block = bHb
        var brh = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brh, bM, 1)
        // Content-Length 查找（大小写不敏感）
        g_cur_block = bHk
        var body_off = s21_bin(0, he, tig_int_lit(4))
        var clen_s = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(clen_s, T64, 2)
        var clenp = ir.get_value(clen_s)
        s21_store(clenp, tig_int_lit(-1), T64)
        var cpos = tig_bfind(rdata, rlen, tig_str_lit(interner.intern("\"content-length:\"")), tig_int_lit(15), tig_int_lit(0), true)
        var cge = tig_icmp_c(cpos, tig_int_lit(0), 5)  // cpos >= 0
        var bCl = ir.new_block(g_cur_func, interner.intern("hg.cl"))
        var bCn = ir.new_block(g_cur_func, interner.intern("hg.cn"))
        var bCd = ir.new_block(g_cur_func, interner.intern("hg.cd"))
        var cb3 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb3, cge, 0)
        ir.add_operand(cb3, bCl, 1)
        ir.add_operand(cb3, bCn, 1)
        // 扫描数字（跳过 ":" 后空格/制表；记录首个数字起点）
        g_cur_block = bCl
        tig_parse_clen(rdata, rlen, cpos, body_off, clenp)
        var brcl = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brcl, bCd, 1)
        g_cur_block = bCn
        var brcn = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brcn, bCd, 1)
        // body 长度：有 CL → min(CL, rlen-body_off)；无 → rlen-body_off
        g_cur_block = bCd
        var avail = s21_bin(1, rlen, body_off)
        var cv = s21_load(clenp, T64)
        var hascl = tig_icmp_c(cv, tig_int_lit(0), 5)  // cv >= 0
        var cav = tig_select_i(hascl, cv, avail, T64)
        var cgt = tig_icmp_c(cav, avail, 3)  // cav > avail
        var bodylen = tig_select_i(cgt, avail, cav, T64)
        var blneg = tig_icmp_c(bodylen, tig_int_lit(0), 2)  // bodylen < 0
        var bodylen2 = tig_select_i(blneg, tig_int_lit(0), bodylen, T64)
        var body = tig_bytes_to_tie(s21_gep(rdata, body_off, false), bodylen2)
        s21_store(rv, body, ST)
        var brk = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brk, bM, 1)
        g_cur_block = bM
        return s21_load(rv, ST)
    }

    // http_get_file(url, path) → bool：GET 并把 body 写文件（成功 true 失败 false）。
    func tig_http_get_file(url: i64, path: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I8 = types.named(TK_I8)
        var ST = types.named(TK_STR)
        var TB = types.named(TK_BOOL)
        var rslt = ir.new_inst(g_cur_block, 20, TB)
        ir.add_operand(rslt, TB, 2)
        var rv = ir.get_value(rslt)
        s21_store(rv, tig_bool_lit(0), TB)
        var ds = ir.new_inst(g_cur_block, 20, ST)
        ir.add_operand(ds, ST, 2)
        var dsp = ir.get_value(ds)
        var ls = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(ls, T64, 2)
        var lsp = ir.get_value(ls)
        var ok = ir.new_inst(g_cur_block, 20, TB)
        ir.add_operand(ok, TB, 2)
        var okp = ir.get_value(ok)
        s21_store(okp, tig_bool_lit(0), TB)
        tig_http_fetch(url, dsp, lsp, okp)
        var bGo = ir.new_block(g_cur_func, interner.intern("hgf.go"))
        var bAb = ir.new_block(g_cur_func, interner.intern("hgf.ab"))
        var bM = ir.new_block(g_cur_func, interner.intern("hgf.m"))
        var ok_cond = s21_load(okp, TB)
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, ok_cond, 0)
        ir.add_operand(cb, bGo, 1)
        ir.add_operand(cb, bAb, 1)
        g_cur_block = bAb
        var brb = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brb, bM, 1)
        g_cur_block = bGo
        var rdata = s21_load(dsp, ST)
        var rlen = s21_load(lsp, T64)
        var he = tig_bfind(rdata, rlen, tig_str_lit(interner.intern("\"\r\n\r\n\"")), tig_int_lit(4), tig_int_lit(0), false)
        var hebad = tig_icmp_c(he, tig_int_lit(0), 2)
        var bHb = ir.new_block(g_cur_func, interner.intern("hgf.hb"))
        var bHk = ir.new_block(g_cur_func, interner.intern("hgf.hk"))
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, hebad, 0)
        ir.add_operand(cb2, bHb, 1)
        ir.add_operand(cb2, bHk, 1)
        g_cur_block = bHb
        var brh = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brh, bM, 1)
        g_cur_block = bHk
        var body_off = s21_bin(0, he, tig_int_lit(4))
        var clen_s = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(clen_s, T64, 2)
        var clenp = ir.get_value(clen_s)
        s21_store(clenp, tig_int_lit(-1), T64)
        var cpos = tig_bfind(rdata, rlen, tig_str_lit(interner.intern("\"content-length:\"")), tig_int_lit(15), tig_int_lit(0), true)
        var cge = tig_icmp_c(cpos, tig_int_lit(0), 5)
        var bCl = ir.new_block(g_cur_func, interner.intern("hgf.cl"))
        var bCn = ir.new_block(g_cur_func, interner.intern("hgf.cn"))
        var bCd = ir.new_block(g_cur_func, interner.intern("hgf.cd"))
        var cb3 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb3, cge, 0)
        ir.add_operand(cb3, bCl, 1)
        ir.add_operand(cb3, bCn, 1)
        g_cur_block = bCl
        tig_parse_clen(rdata, rlen, cpos, body_off, clenp)
        var brcl = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brcl, bCd, 1)
        g_cur_block = bCn
        var brcn = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brcn, bCd, 1)
        g_cur_block = bCd
        var avail = s21_bin(1, rlen, body_off)
        var cv = s21_load(clenp, T64)
        var hascl = tig_icmp_c(cv, tig_int_lit(0), 5)
        var cav = tig_select_i(hascl, cv, avail, T64)
        var cgt = tig_icmp_c(cav, avail, 3)
        var bodylen = tig_select_i(cgt, avail, cav, T64)
        var blneg = tig_icmp_c(bodylen, tig_int_lit(0), 2)
        var bodylen2 = tig_select_i(blneg, tig_int_lit(0), bodylen, T64)
        var wr = tig_write_region(path, rdata, body_off, bodylen2)
        s21_store(rv, wr, TB)
        var brk = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brk, bM, 1)
        g_cur_block = bM
        return s21_load(rv, TB)
    }

    // 写原始字节区 [src+off, src+off+n) 到 UTF-16 路径文件（CreateFileW+WriteFile）
    func tig_write_region(p: i64, src: i64, off: i64, n: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var P8 = types.ptr_of(types.named(TK_I8))
        var TB = types.named(TK_BOOL)
        var pw = tig_wide16(p)
        var h = tig_create_file_w(pw, tig_int_lit_ty(0x120116, I32), tig_int_lit_ty(2, I32))  // GENERIC_WRITE + CREATE_ALWAYS
        var hok = tig_icmp_c(tig_p2i(h), tig_int_lit(-1), 1)  // h != -1
        var rs = ir.new_inst(g_cur_block, 20, TB)
        ir.add_operand(rs, TB, 2)
        var rp = ir.get_value(rs)
        s21_store(rp, tig_bool_lit(0), TB)
        var bOk = ir.new_block(g_cur_func, interner.intern("wreg.ok"))
        var bFail = ir.new_block(g_cur_func, interner.intern("wreg.f"))
        var bM = ir.new_block(g_cur_func, interner.intern("wreg.m"))
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, hok, 0)
        ir.add_operand(cb, bOk, 1)
        ir.add_operand(cb, bFail, 1)
        g_cur_block = bFail
        var brf = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brf, bM, 1)
        g_cur_block = bOk
        var nwb = s21_raw_alloc_str(tig_int_lit(4))
        s21_store(s21_gep(nwb, 0, true), tig_int_lit_ty(0, I32), I32)
        var nullov = tig_null_ptr()
        var sp = s21_gep(src, off, false)
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, P8);  table_push(avs, h)
        table_push(ats, P8);  table_push(avs, sp)
        table_push(ats, I32); table_push(avs, tig_trunc_i32(n))
        table_push(ats, P8);  table_push(avs, nwb)
        table_push(ats, P8);  table_push(avs, nullov)
        tig_ext_call_typed("WriteFile", ats, avs, I32)
        var nrb = s21_zext(s21_load(nwb, I32), I32)
        var full = tig_icmp_c(nrb, n, 0)  // 写满 n 字节
        tig_ext_call1("CloseHandle", h, P8, I32)
        tig_ext_call1("free", nwb, types.named(TK_STR), -1)
        s21_store(rp, full, TB)
        var brk = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brk, bM, 1)
        g_cur_block = bM
        return s21_load(rp, TB)
    }

    // ==================== p.6.4.9 通用 inflate 引擎（DEFLATE，纯 tie IR） ====================
    // 编译器内联 DEFLATE inflate：RFC 1951（存储块/固定 Huffman/动态 Huffman + LZ77）。
    // 供 untar_gz（gzip RFC 1952）与 unzip（raw DEFLATE）共用；也是后续 p.6.6 图像 PNG
    //（zlib inflate）的可复用底座。零 Rust 桥、零系统依赖（纯算法）。
    // 数据结构约定：
    //   inflate 状态 st = 32B {src ptr@0, srclen@8, bitpos@16, status@24}（status!=0=失败）
    //   Huffman 表 huff = {counts[16]@0, first[16]@128, offset[16]@256, symbol[n]@384}（i64 槽）
    //   lengths = n 字节 i8 缓冲（码长数组）；输出走 StringBuilder（out_hv）。

    // StringBuilder 句柄（i64）→ 长度/数据
    func tig_sb_len(hv: i64) -> i64 {
        return s21_load(s21_gep(s21_sb_ptr(hv), 8, true), types.named(TK_I64))
    }
    func tig_sb_data(hv: i64) -> i64 {
        return s21_load(s21_gep(s21_sb_ptr(hv), 16, true), types.named(TK_STR))
    }

    // 读 1 位（LSB-first）：越界 → status=1 且返回 0（不越内存访问）
    func tig_ib_read1(st: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I8 = types.named(TK_I8)
        var ST = types.named(TK_STR)
        var src = s21_load(s21_gep(st, 0, true), ST)
        var bp = s21_load(s21_gep(st, 16, true), T64)
        var lim = s21_bin(10, s21_load(s21_gep(st, 8, true), T64), tig_int_lit(3))  // srclen*8
        var oob = tig_icmp_c(bp, lim, 5)  // bp >= lim
        var rs = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(rs, T64, 2)
        var rp = ir.get_value(rs)
        s21_store(rp, tig_int_lit(0), T64)
        var bOk = ir.new_block(g_cur_func, interner.intern("ib.ok"))
        var bBad = ir.new_block(g_cur_func, interner.intern("ib.b"))
        var bM = ir.new_block(g_cur_func, interner.intern("ib.m"))
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, oob, 0)
        ir.add_operand(cb, bBad, 1)
        ir.add_operand(cb, bOk, 1)
        g_cur_block = bBad
        s21_store(s21_gep(st, 24, true), tig_int_lit(1), T64)
        var brb = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brb, bM, 1)
        g_cur_block = bOk
        var bidx = s21_bin(11, bp, tig_int_lit(3))       // bp>>3
        var sh = s21_bin(6, bp, tig_int_lit(7))          // bp&7
        var byte = s21_zext(s21_load(s21_gep(src, bidx, false), I8), I8)
        var bit = s21_bin(6, s21_bin(11, byte, sh), tig_int_lit(1))
        s21_store(rp, bit, T64)
        s21_store(s21_gep(st, 16, true), s21_bin(0, bp, tig_int_lit(1)), T64)
        var brk = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brk, bM, 1)
        g_cur_block = bM
        return s21_load(rp, T64)
    }

    // 读 n 位（LSB-first，n ≤ 13）：v = Σ bit_k << k；结果写 rp（调用方 alloca i64）
    func tig_ib_readn(st: i64, n: i64, rp: i64) {
        var T64 = types.named(TK_I64)
        s21_store(rp, tig_int_lit(0), T64)
        var ka = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(ka, T64, 2)
        var kp = ir.get_value(ka)
        s21_store(kp, tig_int_lit(0), T64)
        var hd = ir.new_block(g_cur_func, interner.intern("ibn.h"))
        var bd = ir.new_block(g_cur_func, interner.intern("ibn.b"))
        var ex = ir.new_block(g_cur_func, interner.intern("ibn.x"))
        var br0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br0, hd, 1)
        g_cur_block = hd
        var kv = s21_load(kp, T64)
        var kc = tig_icmp_c(kv, n, 2)
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, kc, 0)
        ir.add_operand(cb, bd, 1)
        ir.add_operand(cb, ex, 1)
        g_cur_block = bd
        var k2 = s21_load(kp, T64)
        var b = tig_ib_read1(st)
        var v = s21_load(rp, T64)
        var nv = s21_bin(7, v, s21_bin(10, b, k2))  // v | (b << k)
        s21_store(rp, nv, T64)
        s21_store(kp, s21_bin(0, k2, tig_int_lit(1)), T64)
        var brb = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brb, hd, 1)
        g_cur_block = ex
    }

    // 读 8 位（一个字节，LSB-first）
    func tig_ib_read8(st: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var rs = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(rs, T64, 2)
        var rp = ir.get_value(rs)
        tig_ib_readn(st, tig_int_lit(8), rp)
        return s21_load(rp, T64)
    }

    // 由码长数组 lengths[0..n) 构建规范 Huffman 表（canonical；失败置 ok 槽 0）
    func tig_huff_build(n: i64, lengths: i64, huff: i64, ok_p: i64) {
        var T64 = types.named(TK_I64)
        var I8 = types.named(TK_I8)
        // 清零 counts/first/offset（16 槽各，编译期展开）
        var z: i64 = 0
        while z < 48 {
            s21_store(s21_gep(huff, z*8, true), tig_int_lit(0), T64)
            z = z + 1
        }
        // 清零 symbol[0..n)（运行时循环）
        var za = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(za, T64, 2)
        var zp = ir.get_value(za)
        s21_store(zp, tig_int_lit(0), T64)
        var zh = ir.new_block(g_cur_func, interner.intern("hb.zh"))
        var zb = ir.new_block(g_cur_func, interner.intern("hb.zb"))
        var zx = ir.new_block(g_cur_func, interner.intern("hb.zx"))
        var brz = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brz, zh, 1)
        g_cur_block = zh
        var zv = s21_load(zp, T64)
        var zc = tig_icmp_c(zv, n, 2)
        var cbz = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cbz, zc, 0)
        ir.add_operand(cbz, zb, 1)
        ir.add_operand(cbz, zx, 1)
        g_cur_block = zb
        var zv2 = s21_load(zp, T64)
        s21_store(s21_gep(huff, s21_bin(0, s21_bin(2, zv2, tig_int_lit(8)), tig_int_lit(384)), false), tig_int_lit(0), T64)
        s21_store(zp, s21_bin(0, zv2, tig_int_lit(1)), T64)
        var brzb = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brzb, zh, 1)
        // counts[l]++（运行时循环 i）
        g_cur_block = zx
        var ia = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(ia, T64, 2)
        var ip = ir.get_value(ia)
        s21_store(ip, tig_int_lit(0), T64)
        var hd = ir.new_block(g_cur_func, interner.intern("hb.h"))
        var bd = ir.new_block(g_cur_func, interner.intern("hb.b"))
        var ex = ir.new_block(g_cur_func, interner.intern("hb.x"))
        var br0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br0, hd, 1)
        g_cur_block = hd
        var iv = s21_load(ip, T64)
        var ic = tig_icmp_c(iv, n, 2)
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, ic, 0)
        ir.add_operand(cb, bd, 1)
        ir.add_operand(cb, ex, 1)
        g_cur_block = bd
        var iv2 = s21_load(ip, T64)
        var l = s21_zext(s21_load(s21_gep(lengths, iv2, false), I8), I8)
        var gtz = tig_icmp_c(l, tig_int_lit(0), 3)
        var bDo = ir.new_block(g_cur_func, interner.intern("hb.do"))
        var bSk = ir.new_block(g_cur_func, interner.intern("hb.sk"))
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, gtz, 0)
        ir.add_operand(cb2, bDo, 1)
        ir.add_operand(cb2, bSk, 1)
        g_cur_block = bDo
        var caddr = s21_gep(huff, s21_bin(2, l, tig_int_lit(8)), false)   // counts[l]
        var cv = s21_load(caddr, T64)
        s21_store(caddr, s21_bin(0, cv, tig_int_lit(1)), T64)
        var brd = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brd, bSk, 1)
        g_cur_block = bSk
        s21_store(ip, s21_bin(0, iv2, tig_int_lit(1)), T64)
        var brb = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brb, hd, 1)
        // 规范 first/offset（编译期展开；first[1]=offset[1]=0 已清零）
        g_cur_block = ex
        var L: i64 = 2
        while L < 16 {
            var cprev = s21_load(s21_gep(huff, (L-1)*8, true), T64)
            var fprev = s21_load(s21_gep(huff, 128+(L-1)*8, true), T64)
            s21_store(s21_gep(huff, 128+L*8, true), s21_bin(10, s21_bin(0, fprev, cprev), tig_int_lit(1)), T64)
            var oprev = s21_load(s21_gep(huff, 256+(L-1)*8, true), T64)
            s21_store(s21_gep(huff, 256+L*8, true), s21_bin(0, oprev, cprev), T64)
            L = L + 1
        }
        // pos 槽 = offset[l]（编译期初始化）
        var posb = s21_raw_alloc_str(tig_int_lit(128))  // 16 i64
        var L2: i64 = 0
        while L2 < 16 {
            s21_store(s21_gep(posb, L2*8, true), s21_load(s21_gep(huff, 256+L2*8, true), T64), T64)
            L2 = L2 + 1
        }
        // symbol 填充（运行时循环 j）
        var ja = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(ja, T64, 2)
        var jp = ir.get_value(ja)
        s21_store(jp, tig_int_lit(0), T64)
        var jh = ir.new_block(g_cur_func, interner.intern("hb.jh"))
        var jb = ir.new_block(g_cur_func, interner.intern("hb.jb"))
        var jx = ir.new_block(g_cur_func, interner.intern("hb.jx"))
        var brj = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brj, jh, 1)
        g_cur_block = jh
        var jv = s21_load(jp, T64)
        var jc = tig_icmp_c(jv, n, 2)
        var cbj = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cbj, jc, 0)
        ir.add_operand(cbj, jb, 1)
        ir.add_operand(cbj, jx, 1)
        g_cur_block = jb
        var jv2 = s21_load(jp, T64)
        var l2 = s21_zext(s21_load(s21_gep(lengths, jv2, false), I8), I8)
        var gtz2 = tig_icmp_c(l2, tig_int_lit(0), 3)
        var bD2 = ir.new_block(g_cur_func, interner.intern("hb.d2"))
        var bS2 = ir.new_block(g_cur_func, interner.intern("hb.s2"))
        var cb3 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb3, gtz2, 0)
        ir.add_operand(cb3, bD2, 1)
        ir.add_operand(cb3, bS2, 1)
        g_cur_block = bD2
        var paddr = s21_gep(posb, s21_bin(2, l2, tig_int_lit(8)), false)   // pos[l2]
        var pv = s21_load(paddr, T64)
        s21_store(s21_gep(huff, s21_bin(0, s21_bin(2, pv, tig_int_lit(8)), tig_int_lit(384)), false), jv2, T64)  // symbol[pos]=j
        s21_store(paddr, s21_bin(0, pv, tig_int_lit(1)), T64)
        var brd2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brd2, bS2, 1)
        g_cur_block = bS2
        s21_store(jp, s21_bin(0, jv2, tig_int_lit(1)), T64)
        var brjb = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brjb, jh, 1)
        g_cur_block = jx
        s21_store(ok_p, tig_int_lit(1), T64)
    }

    // 规范 Huffman 解码 1 符号：逐长度尝试（1..15 位，位按 LSB-first 读入后高位拼接）。
    // 返回符号；15 位内未命中（无效码）→ -1。
    func tig_huff_decode(huff: i64, st: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var rs = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(rs, T64, 2)
        var rp = ir.get_value(rs)
        s21_store(rp, tig_int_lit(-1), T64)
        var ca = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(ca, T64, 2)
        var cp = ir.get_value(ca)
        s21_store(cp, tig_int_lit(0), T64)
        var ex = ir.new_block(g_cur_func, interner.intern("hd.x"))
        var L: i64 = 1
        while L < 16 {
            var blk = ir.new_block(g_cur_func, interner.intern("hd.l"))
            var br = ir.new_inst(g_cur_block, 30, -1)
            ir.add_operand(br, blk, 1)
            g_cur_block = blk
            var cde = s21_load(cp, T64)
            var b = tig_ib_read1(st)
            var cde2 = s21_bin(7, s21_bin(10, cde, tig_int_lit(1)), b)
            s21_store(cp, cde2, T64)
            var cnt = s21_load(s21_gep(huff, L*8, true), T64)
            var fst = s21_load(s21_gep(huff, 128+L*8, true), T64)
            var diff = s21_bin(1, cde2, fst)
            var cgt = tig_icmp_c(cnt, tig_int_lit(0), 3)   // cnt > 0
            var ge0 = tig_icmp_c(diff, tig_int_lit(0), 5)  // diff >= 0
            var ltc = tig_icmp_c(diff, cnt, 2)             // diff < cnt
            var hit = tig_and_i1(tig_and_i1(cgt, ge0), ltc)
            var bHit = ir.new_block(g_cur_func, interner.intern("hd.hit"))
            var bNxt = ir.new_block(g_cur_func, interner.intern("hd.n"))
            var cb = ir.new_inst(g_cur_block, 31, -1)
            ir.add_operand(cb, hit, 0)
            ir.add_operand(cb, bHit, 1)
            ir.add_operand(cb, bNxt, 1)
            g_cur_block = bHit
            var offL = s21_load(s21_gep(huff, 256+L*8, true), T64)
            var idx = s21_bin(0, offL, diff)
            var sym = s21_load(s21_gep(huff, s21_bin(0, s21_bin(2, idx, tig_int_lit(8)), tig_int_lit(384)), false), T64)
            s21_store(rp, sym, T64)
            var brh = ir.new_inst(g_cur_block, 30, -1)
            ir.add_operand(brh, ex, 1)
            g_cur_block = bNxt
            L = L + 1
        }
        var brx = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brx, ex, 1)
        g_cur_block = ex
        return s21_load(rp, T64)
    }

    // DEFLATE inflate 主循环：解压 src[0..srclen) → 输出到 sb out_hv；ok_p 槽写 1/0。
    func tig_inflate_raw(src: i64, srclen: i64, out_hv: i64, ok_p: i64) {
        var T64 = types.named(TK_I64)
        var I8 = types.named(TK_I8)
        var ST = types.named(TK_STR)
        var TB = types.named(TK_BOOL)
        // ---- 常量表（编译期；运行时展开存 i64 槽）----
        var LB: table<i64> = table_new_i64()
        table_push(LB, 3); table_push(LB, 4); table_push(LB, 5); table_push(LB, 6)
        table_push(LB, 7); table_push(LB, 8); table_push(LB, 9); table_push(LB, 10)
        table_push(LB, 11); table_push(LB, 13); table_push(LB, 15); table_push(LB, 17)
        table_push(LB, 19); table_push(LB, 23); table_push(LB, 27); table_push(LB, 31)
        table_push(LB, 35); table_push(LB, 43); table_push(LB, 51); table_push(LB, 59)
        table_push(LB, 67); table_push(LB, 83); table_push(LB, 99); table_push(LB, 115)
        table_push(LB, 131); table_push(LB, 163); table_push(LB, 195); table_push(LB, 227)
        table_push(LB, 258)
        var LE: table<i64> = table_new_i64()
        table_push(LE, 0); table_push(LE, 0); table_push(LE, 0); table_push(LE, 0)
        table_push(LE, 0); table_push(LE, 0); table_push(LE, 0); table_push(LE, 0)
        table_push(LE, 1); table_push(LE, 1); table_push(LE, 1); table_push(LE, 1)
        table_push(LE, 2); table_push(LE, 2); table_push(LE, 2); table_push(LE, 2)
        table_push(LE, 3); table_push(LE, 3); table_push(LE, 3); table_push(LE, 3)
        table_push(LE, 4); table_push(LE, 4); table_push(LE, 4); table_push(LE, 4)
        table_push(LE, 5); table_push(LE, 5); table_push(LE, 5); table_push(LE, 5)
        table_push(LE, 0)
        var DB: table<i64> = table_new_i64()
        table_push(DB, 1); table_push(DB, 2); table_push(DB, 3); table_push(DB, 4)
        table_push(DB, 5); table_push(DB, 7); table_push(DB, 9); table_push(DB, 13)
        table_push(DB, 17); table_push(DB, 25); table_push(DB, 33); table_push(DB, 49)
        table_push(DB, 65); table_push(DB, 97); table_push(DB, 129); table_push(DB, 193)
        table_push(DB, 257); table_push(DB, 385); table_push(DB, 513); table_push(DB, 769)
        table_push(DB, 1025); table_push(DB, 1537); table_push(DB, 2049); table_push(DB, 3073)
        table_push(DB, 4097); table_push(DB, 6145); table_push(DB, 8193); table_push(DB, 12289)
        table_push(DB, 16385); table_push(DB, 24577)
        var DE: table<i64> = table_new_i64()
        table_push(DE, 0); table_push(DE, 0); table_push(DE, 0); table_push(DE, 0)
        table_push(DE, 1); table_push(DE, 1); table_push(DE, 2); table_push(DE, 2)
        table_push(DE, 3); table_push(DE, 3); table_push(DE, 4); table_push(DE, 4)
        table_push(DE, 5); table_push(DE, 5); table_push(DE, 6); table_push(DE, 6)
        table_push(DE, 7); table_push(DE, 7); table_push(DE, 8); table_push(DE, 8)
        table_push(DE, 9); table_push(DE, 9); table_push(DE, 10); table_push(DE, 10)
        table_push(DE, 11); table_push(DE, 11); table_push(DE, 12); table_push(DE, 12)
        table_push(DE, 13); table_push(DE, 13)
        var CO: table<i64> = table_new_i64()
        table_push(CO, 16); table_push(CO, 17); table_push(CO, 18); table_push(CO, 0)
        table_push(CO, 8); table_push(CO, 7); table_push(CO, 9); table_push(CO, 6)
        table_push(CO, 10); table_push(CO, 5); table_push(CO, 11); table_push(CO, 4)
        table_push(CO, 12); table_push(CO, 3); table_push(CO, 13); table_push(CO, 2)
        table_push(CO, 14); table_push(CO, 1); table_push(CO, 15)
        // ---- 缓冲 ----
        var st = s21_raw_alloc_str(tig_int_lit(32))
        var hlit = s21_raw_alloc_str(tig_int_lit(384 + 288*8))
        var hdist = s21_raw_alloc_str(tig_int_lit(384 + 30*8))
        var hcl = s21_raw_alloc_str(tig_int_lit(384 + 19*8))
        var lenbase = s21_raw_alloc_str(tig_int_lit(29*8))
        var lenextra = s21_raw_alloc_str(tig_int_lit(29*8))
        var distbase = s21_raw_alloc_str(tig_int_lit(30*8))
        var distextra = s21_raw_alloc_str(tig_int_lit(30*8))
        var lengths = s21_raw_alloc_str(tig_int_lit(320))
        var clpos = s21_raw_alloc_str(tig_int_lit(19*8))
        s21_store(s21_gep(st, 0, true), src, ST)
        s21_store(s21_gep(st, 8, true), srclen, T64)
        s21_store(s21_gep(st, 16, true), tig_int_lit(0), T64)
        s21_store(s21_gep(st, 24, true), tig_int_lit(0), T64)
        // 常量表展开
        var k: i64 = 0
        while k < 29 {
            s21_store(s21_gep(lenbase, k*8, true), tig_int_lit(LB[k]), T64)
            s21_store(s21_gep(lenextra, k*8, true), tig_int_lit(LE[k]), T64)
            k = k + 1
        }
        k = 0
        while k < 30 {
            s21_store(s21_gep(distbase, k*8, true), tig_int_lit(DB[k]), T64)
            s21_store(s21_gep(distextra, k*8, true), tig_int_lit(DE[k]), T64)
            k = k + 1
        }
        k = 0
        while k < 19 {
            s21_store(s21_gep(clpos, k*8, true), tig_int_lit(CO[k]), T64)
            k = k + 1
        }
        // 固定 Huffman 表：字面 0-143→8, 144-255→9, 256-279→7, 280-287→8；距离全 5
        k = 0
        while k < 288 {
            var l: i64 = 8
            if k >= 144 && k <= 255 {
                l = 9
            }
            if k >= 256 && k <= 279 {
                l = 7
            }
            s21_store(s21_gep(lengths, k, true), tig_int_lit_ty(l, I8), I8)
            k = k + 1
        }
        tig_huff_build(tig_int_lit(288), lengths, hlit, ok_p)
        k = 0
        while k < 30 {
            s21_store(s21_gep(lengths, k, true), tig_int_lit_ty(5, I8), I8)
            k = k + 1
        }
        tig_huff_build(tig_int_lit(30), lengths, hdist, ok_p)
        // ---- 结果/状态槽 ----
        var bfa = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(bfa, T64, 2)
        var bfp = ir.get_value(bfa)
        s21_store(bfp, tig_int_lit(0), T64)
        s21_store(ok_p, tig_int_lit(0), T64)
        // ---- 块结构 ----
        var bFail = ir.new_block(g_cur_func, interner.intern("inf.f"))
        var bSucc = ir.new_block(g_cur_func, interner.intern("inf.s"))
        var bExit = ir.new_block(g_cur_func, interner.intern("inf.e"))
        var bOuter = ir.new_block(g_cur_func, interner.intern("inf.o"))
        var bStored = ir.new_block(g_cur_func, interner.intern("inf.st"))
        var bFixed = ir.new_block(g_cur_func, interner.intern("inf.fx"))
        var bDyn = ir.new_block(g_cur_func, interner.intern("inf.dy"))
        var bSymLoop = ir.new_block(g_cur_func, interner.intern("inf.sl"))
        var bSymLit = ir.new_block(g_cur_func, interner.intern("inf.li"))
        var bSymEnd = ir.new_block(g_cur_func, interner.intern("inf.se"))
        var bSymLen = ir.new_block(g_cur_func, interner.intern("inf.le"))
        var bBlockDone = ir.new_block(g_cur_func, interner.intern("inf.bd"))
        var br0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br0, bOuter, 1)
        // ---- 外层循环：读块头 ----
        g_cur_block = bOuter
        var stv = s21_load(s21_gep(st, 24, true), T64)
        var stbad = tig_icmp_c(stv, tig_int_lit(0), 1)  // status != 0
        var bStB = ir.new_block(g_cur_func, interner.intern("inf.sb"))
        var bStO = ir.new_block(g_cur_func, interner.intern("inf.so"))
        var cb1 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb1, stbad, 0)
        ir.add_operand(cb1, bFail, 1)
        ir.add_operand(cb1, bStO, 1)
        g_cur_block = bStO
        var bf = tig_ib_read1(st)
        s21_store(bfp, bf, T64)
        var t0 = tig_ib_read1(st)
        var t1 = tig_ib_read1(st)
        var btype = s21_bin(7, t0, s21_bin(10, t1, tig_int_lit(1)))
        var eq0 = tig_icmp_c(btype, tig_int_lit(0), 0)
        var eq1 = tig_icmp_c(btype, tig_int_lit(1), 0)
        var eq2 = tig_icmp_c(btype, tig_int_lit(2), 0)
        var bT1 = ir.new_block(g_cur_func, interner.intern("inf.t1"))
        var bT2 = ir.new_block(g_cur_func, interner.intern("inf.t2"))
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, eq0, 0)
        ir.add_operand(cb2, bStored, 1)
        ir.add_operand(cb2, bT1, 1)
        g_cur_block = bT1
        var cb3 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb3, eq1, 0)
        ir.add_operand(cb3, bFixed, 1)
        ir.add_operand(cb3, bT2, 1)
        g_cur_block = bT2
        var cb4 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb4, eq2, 0)
        ir.add_operand(cb4, bDyn, 1)
        ir.add_operand(cb4, bFail, 1)
        // ---- 存储块：字节对齐 + 读 LEN + 拷贝 ----
        g_cur_block = bStored
        var bpv = s21_load(s21_gep(st, 16, true), T64)
        var nalign = s21_bin(6, s21_bin(0, bpv, tig_int_lit(7)), tig_int_lit(-8))  // (bp+7)&~7
        s21_store(s21_gep(st, 16, true), nalign, T64)
        var l0 = tig_ib_read8(st)
        var l1 = tig_ib_read8(st)
        var lenv = s21_bin(7, l0, s21_bin(10, l1, tig_int_lit(8)))
        var srcoff = s21_bin(11, s21_load(s21_gep(st, 16, true), T64), tig_int_lit(3))  // bitpos>>3
        var srcp = s21_load(s21_gep(st, 0, true), ST)
        var ja = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(ja, T64, 2)
        var jp = ir.get_value(ja)
        s21_store(jp, tig_int_lit(0), T64)
        var jh = ir.new_block(g_cur_func, interner.intern("inf.stj"))
        var jb = ir.new_block(g_cur_func, interner.intern("inf.stb"))
        var jx = ir.new_block(g_cur_func, interner.intern("inf.stx"))
        var brj = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brj, jh, 1)
        g_cur_block = jh
        var jv = s21_load(jp, T64)
        var jc = tig_icmp_c(jv, lenv, 2)
        var cbj = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cbj, jc, 0)
        ir.add_operand(cbj, jb, 1)
        ir.add_operand(cbj, jx, 1)
        g_cur_block = jb
        var jv2 = s21_load(jp, T64)
        var sbyte = s21_zext(s21_load(s21_gep(srcp, s21_bin(0, srcoff, jv2), false), I8), I8)
        s21_sb_append_byte(out_hv, sbyte)
        s21_store(jp, s21_bin(0, jv2, tig_int_lit(1)), T64)
        var brjb = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brjb, jh, 1)
        g_cur_block = jx
        var bp2 = s21_load(s21_gep(st, 16, true), T64)
        s21_store(s21_gep(st, 16, true), s21_bin(0, bp2, s21_bin(10, lenv, tig_int_lit(3))), T64)  // bitpos += len*8
        var brs = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brs, bOuter, 1)
        // ---- 固定块：直接符号循环 ----
        g_cur_block = bFixed
        var brf = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brf, bSymLoop, 1)
        // ---- 符号循环 ----
        g_cur_block = bSymLoop
        var stv2 = s21_load(s21_gep(st, 24, true), T64)
        var stbad2 = tig_icmp_c(stv2, tig_int_lit(0), 1)
        var bSb = ir.new_block(g_cur_func, interner.intern("inf.sb2"))
        var bSo = ir.new_block(g_cur_func, interner.intern("inf.so2"))
        var cb5 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb5, stbad2, 0)
        ir.add_operand(cb5, bFail, 1)
        ir.add_operand(cb5, bSo, 1)
        g_cur_block = bSo
        var sym = tig_huff_decode(hlit, st)
        var sm1 = tig_icmp_c(sym, tig_int_lit(-1), 0)
        var bSm1 = ir.new_block(g_cur_func, interner.intern("inf.m1"))
        var bSmOk = ir.new_block(g_cur_func, interner.intern("inf.mk"))
        var cb6 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb6, sm1, 0)
        ir.add_operand(cb6, bFail, 1)
        ir.add_operand(cb6, bSmOk, 1)
        g_cur_block = bSmOk
        var lt256 = tig_icmp_c(sym, tig_int_lit(256), 2)   // sym < 256
        var bSm2 = ir.new_block(g_cur_func, interner.intern("inf.m2"))
        var cb7 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb7, lt256, 0)
        ir.add_operand(cb7, bSymLit, 1)
        ir.add_operand(cb7, bSm2, 1)
        // sym >= 256：判 256 → end，否则 len
        g_cur_block = bSm2
        var eq256 = tig_icmp_c(sym, tig_int_lit(256), 0)   // sym == 256
        var cb8 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb8, eq256, 0)
        ir.add_operand(cb8, bSymEnd, 1)
        ir.add_operand(cb8, bSymLen, 1)
        // 字面：输出字节
        g_cur_block = bSymLit
        s21_sb_append_byte(out_hv, sym)
        var brl = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brl, bSymLoop, 1)
        // 长度码：base + 附加位
        g_cur_block = bSymLen
        var idx = s21_bin(1, sym, tig_int_lit(257))
        var iob = tig_icmp_c(idx, tig_int_lit(28), 3)  // idx > 28 → 非法
        var bIo = ir.new_block(g_cur_func, interner.intern("inf.io"))
        var cb9 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb9, iob, 0)
        ir.add_operand(cb9, bFail, 1)
        ir.add_operand(cb9, bIo, 1)
        g_cur_block = bIo
        var lbv = s21_load(s21_gep(lenbase, s21_bin(2, idx, tig_int_lit(8)), false), T64)
        var lev = s21_load(s21_gep(lenextra, s21_bin(2, idx, tig_int_lit(8)), false), T64)
        var lslot = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(lslot, T64, 2)
        var lsp = ir.get_value(lslot)
        tig_ib_readn(st, lev, lsp)
        var length = s21_bin(0, lbv, s21_load(lsp, T64))
        var dsym = tig_huff_decode(hdist, st)
        var dm1 = tig_icmp_c(dsym, tig_int_lit(-1), 0)
        var dob = tig_icmp_c(dsym, tig_int_lit(29), 3)
        var dbad = tig_or_i1(dm1, dob)
        var bDb = ir.new_block(g_cur_func, interner.intern("inf.db"))
        var cb10 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb10, dbad, 0)
        ir.add_operand(cb10, bFail, 1)
        ir.add_operand(cb10, bDb, 1)
        g_cur_block = bDb
        var dbv = s21_load(s21_gep(distbase, s21_bin(2, dsym, tig_int_lit(8)), false), T64)
        var dev = s21_load(s21_gep(distextra, s21_bin(2, dsym, tig_int_lit(8)), false), T64)
        var dslot = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(dslot, T64, 2)
        var dsp = ir.get_value(dslot)
        tig_ib_readn(st, dev, dsp)
        var dist = s21_bin(0, dbv, s21_load(dsp, T64))
        // LZ77 拷贝：out[outlen + j - dist]
        var outlen = tig_sb_len(out_hv)
        var dist_oob = tig_icmp_c(dist, outlen, 3)  // dist > outlen → 非法
        var bDo2 = ir.new_block(g_cur_func, interner.intern("inf.do"))
        var cb11 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb11, dist_oob, 0)
        ir.add_operand(cb11, bFail, 1)
        ir.add_operand(cb11, bDo2, 1)
        g_cur_block = bDo2
        var cja = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(cja, T64, 2)
        var cjp = ir.get_value(cja)
        s21_store(cjp, tig_int_lit(0), T64)
        var cjh = ir.new_block(g_cur_func, interner.intern("inf.cjh"))
        var cjb = ir.new_block(g_cur_func, interner.intern("inf.cjb"))
        var cjx = ir.new_block(g_cur_func, interner.intern("inf.cjx"))
        var brcj = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brcj, cjh, 1)
        g_cur_block = cjh
        var cjv = s21_load(cjp, T64)
        var cjc = tig_icmp_c(cjv, length, 2)
        var cbc = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cbc, cjc, 0)
        ir.add_operand(cbc, cjb, 1)
        ir.add_operand(cbc, cjx, 1)
        g_cur_block = cjb
        var cjv2 = s21_load(cjp, T64)
        var sp2 = s21_bin(1, s21_bin(0, outlen, cjv2), dist)  // outlen + j - dist
        var odata = tig_sb_data(out_hv)
        var ob = s21_zext(s21_load(s21_gep(odata, sp2, false), I8), I8)
        s21_sb_append_byte(out_hv, ob)
        s21_store(cjp, s21_bin(0, cjv2, tig_int_lit(1)), T64)
        var brcjb = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brcjb, cjh, 1)
        g_cur_block = cjx
        var brcl = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brcl, bSymLoop, 1)
        // 块结束
        g_cur_block = bSymEnd
        var brse = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brse, bBlockDone, 1)
        g_cur_block = bBlockDone
        var bfv = s21_load(bfp, T64)
        var bfnz = tig_icmp_c(bfv, tig_int_lit(0), 1)
        var bBd = ir.new_block(g_cur_func, interner.intern("inf.bd2"))
        var cb12 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb12, bfnz, 0)
        ir.add_operand(cb12, bSucc, 1)
        ir.add_operand(cb12, bBd, 1)
        g_cur_block = bBd
        var brbd = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brbd, bOuter, 1)
        // ---- 动态块 ----
        g_cur_block = bDyn
        var h5 = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(h5, T64, 2)
        var h5p = ir.get_value(h5)
        var d5 = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(d5, T64, 2)
        var d5p = ir.get_value(d5)
        var c4 = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(c4, T64, 2)
        var c4p = ir.get_value(c4)
        tig_ib_readn(st, tig_int_lit(5), h5p)
        tig_ib_readn(st, tig_int_lit(5), d5p)
        tig_ib_readn(st, tig_int_lit(4), c4p)
        var hlitn = s21_bin(0, s21_load(h5p, T64), tig_int_lit(257))
        var hdistn = s21_bin(0, s21_load(d5p, T64), tig_int_lit(1))
        var hclen = s21_bin(0, s21_load(c4p, T64), tig_int_lit(4))
        // 读 HCLEN 个 3 位码长（按 CL_ORDER 散落到 lengths[0..19)）
        var cia = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(cia, T64, 2)
        var cip = ir.get_value(cia)
        var c3s = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(c3s, T64, 2)
        var c3p = ir.get_value(c3s)
        s21_store(cip, tig_int_lit(0), T64)
        var cih = ir.new_block(g_cur_func, interner.intern("inf.cih"))
        var cib = ir.new_block(g_cur_func, interner.intern("inf.cib"))
        var cix = ir.new_block(g_cur_func, interner.intern("inf.cix"))
        var brci = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brci, cih, 1)
        g_cur_block = cih
        var civ = s21_load(cip, T64)
        var cic = tig_icmp_c(civ, hclen, 2)
        var cbci = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cbci, cic, 0)
        ir.add_operand(cbci, cib, 1)
        ir.add_operand(cbci, cix, 1)
        g_cur_block = cib
        var civ2 = s21_load(cip, T64)
        tig_ib_readn(st, tig_int_lit(3), c3p)
        var clpos_v = s21_load(s21_gep(clpos, s21_bin(2, civ2, tig_int_lit(8)), false), T64)
        s21_store(s21_gep(lengths, clpos_v, false), s21_trunc_i8(s21_load(c3p, T64)), I8)
        s21_store(cip, s21_bin(0, civ2, tig_int_lit(1)), T64)
        var brcib = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brcib, cih, 1)
        g_cur_block = cix
        tig_huff_build(tig_int_lit(19), lengths, hcl, ok_p)
        // 读 HLIT+HDIST 码长（含 16/17/18 重复码）
        var ii = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(ii, T64, 2)
        var iip = ir.get_value(ii)
        var pv2 = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(pv2, T64, 2)
        var pvp = ir.get_value(pv2)
        s21_store(iip, tig_int_lit(0), T64)
        s21_store(pvp, tig_int_lit(0), T64)
        var total = s21_bin(0, hlitn, hdistn)
        var lh = ir.new_block(g_cur_func, interner.intern("inf.llh"))
        var lb2 = ir.new_block(g_cur_func, interner.intern("inf.llb"))
        var lx = ir.new_block(g_cur_func, interner.intern("inf.llx"))
        var lsm = ir.new_block(g_cur_func, interner.intern("inf.lsm"))
        var l16 = ir.new_block(g_cur_func, interner.intern("inf.l16"))
        var l17 = ir.new_block(g_cur_func, interner.intern("inf.l17"))
        var l18 = ir.new_block(g_cur_func, interner.intern("inf.l18"))
        var lrep = ir.new_block(g_cur_func, interner.intern("inf.lrp"))
        var lrepb = ir.new_block(g_cur_func, interner.intern("inf.lrb"))
        var lrepx = ir.new_block(g_cur_func, interner.intern("inf.lrx"))
        var brl2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brl2, lh, 1)
        g_cur_block = lh
        var iiv = s21_load(iip, T64)
        var iic = tig_icmp_c(iiv, total, 2)
        var cbl = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cbl, iic, 0)
        ir.add_operand(cbl, lb2, 1)
        ir.add_operand(cbl, lx, 1)
        g_cur_block = lb2
        var csym = tig_huff_decode(hcl, st)
        var cs1 = tig_icmp_c(csym, tig_int_lit(-1), 0)
        var bCsm = ir.new_block(g_cur_func, interner.intern("inf.csm"))
        var bCsOk = ir.new_block(g_cur_func, interner.intern("inf.csk"))
        var cbcs = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cbcs, cs1, 0)
        ir.add_operand(cbcs, bFail, 1)
        ir.add_operand(cbcs, bCsOk, 1)
        g_cur_block = bCsOk
        // 16/17/18 共享槽：fillv/repv 在 l16/l17/l18 三支分派前分配，
        // 供合并块 lrep 使用（若只放 l16 会破坏支配关系 → alloca 不支配其用）。
        var fvs = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(fvs, T64, 2)
        var fvp = ir.get_value(fvs)
        var rvs = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(rvs, T64, 2)
        var rvp = ir.get_value(rvs)
        var lt16 = tig_icmp_c(csym, tig_int_lit(16), 2)  // csym < 16
        var bCs2 = ir.new_block(g_cur_func, interner.intern("inf.cs2"))
        var bCs3 = ir.new_block(g_cur_func, interner.intern("inf.cs3"))
        var e16 = tig_icmp_c(csym, tig_int_lit(16), 0)
        var e17 = tig_icmp_c(csym, tig_int_lit(17), 0)
        var cbll = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cbll, lt16, 0)
        ir.add_operand(cbll, lsm, 1)
        ir.add_operand(cbll, bCs2, 1)
        g_cur_block = bCs2
        var cbll2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cbll2, e16, 0)
        ir.add_operand(cbll2, l16, 1)
        ir.add_operand(cbll2, bCs3, 1)
        g_cur_block = bCs3
        var cbll3 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cbll3, e17, 0)
        ir.add_operand(cbll3, l17, 1)
        ir.add_operand(cbll3, l18, 1)
        // 小符号：直接写
        g_cur_block = lsm
        var iiv2 = s21_load(iip, T64)
        s21_store(s21_gep(lengths, iiv2, false), s21_trunc_i8(csym), I8)
        s21_store(pvp, csym, T64)
        s21_store(iip, s21_bin(0, iiv2, tig_int_lit(1)), T64)
        var brls = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brls, lh, 1)
        // 16/17/18：读重复次数（fillv/repv 用共享槽——l16/l17/l18 运行时互斥可达 lrep）
        g_cur_block = l16
        var rs2 = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(rs2, T64, 2)
        var rs2p = ir.get_value(rs2)
        var rv16 = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(rv16, T64, 2)
        var rv16p = ir.get_value(rv16)
        tig_ib_readn(st, tig_int_lit(2), rs2p)
        s21_store(rv16p, s21_load(pvp, T64), T64)   // 重复前一码长
        s21_store(fvp, s21_load(rv16p, T64), T64)
        s21_store(rvp, s21_bin(0, s21_load(rs2p, T64), tig_int_lit(3)), T64)  // rep = 读2位+3
        var br16 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br16, lrep, 1)
        g_cur_block = l17
        var rs3 = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(rs3, T64, 2)
        var rs3p = ir.get_value(rs3)
        tig_ib_readn(st, tig_int_lit(3), rs3p)
        s21_store(fvp, tig_int_lit(0), T64)
        s21_store(rvp, s21_bin(0, s21_load(rs3p, T64), tig_int_lit(3)), T64)  // rep = 读3位+3
        var br17 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br17, lrep, 1)
        g_cur_block = l18
        var rs7 = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(rs7, T64, 2)
        var rs7p = ir.get_value(rs7)
        tig_ib_readn(st, tig_int_lit(7), rs7p)
        s21_store(fvp, tig_int_lit(0), T64)
        s21_store(rvp, s21_bin(0, s21_load(rs7p, T64), tig_int_lit(11)), T64)  // rep = 读7位+11
        var br18 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br18, lrep, 1)
        // 重复循环：r in [0, repv) 且 ii < total
        g_cur_block = lrep
        var ra = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(ra, T64, 2)
        var rap = ir.get_value(ra)
        s21_store(rap, tig_int_lit(0), T64)
        var brlrep = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brlrep, lrepb, 1)
        g_cur_block = lrepb
        var rv = s21_load(rap, T64)
        var rc1 = tig_icmp_c(rv, s21_load(rvp, T64), 2)
        var iic2 = tig_icmp_c(s21_load(iip, T64), total, 2)
        var rc2 = tig_and_i1(rc1, iic2)
        var cbrp = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cbrp, rc2, 0)
        ir.add_operand(cbrp, lrepx, 1)
        ir.add_operand(cbrp, lh, 1)   // 重复完毕 → 回主码长循环
        g_cur_block = lrepx
        var iv3 = s21_load(iip, T64)
        s21_store(s21_gep(lengths, iv3, false), s21_trunc_i8(s21_load(fvp, T64)), I8)
        s21_store(iip, s21_bin(0, iv3, tig_int_lit(1)), T64)
        s21_store(rap, s21_bin(0, rv, tig_int_lit(1)), T64)
        var brrpb = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brrpb, lrepb, 1)
        // 码长读毕：构建字面表 + 距离表
        g_cur_block = lx
        tig_huff_build(hlitn, lengths, hlit, ok_p)
        var ma = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(ma, T64, 2)
        var msp = ir.get_value(ma)
        s21_store(msp, tig_int_lit(0), T64)
        var mh = ir.new_block(g_cur_func, interner.intern("inf.mh"))
        var mb = ir.new_block(g_cur_func, interner.intern("inf.mb"))
        var mx = ir.new_block(g_cur_func, interner.intern("inf.mx"))
        var brm = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brm, mh, 1)
        g_cur_block = mh
        var mv = s21_load(msp, T64)
        var mc = tig_icmp_c(mv, hdistn, 2)
        var cbm = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cbm, mc, 0)
        ir.add_operand(cbm, mb, 1)
        ir.add_operand(cbm, mx, 1)
        g_cur_block = mb
        var mv2 = s21_load(msp, T64)
        var src_l = s21_load(s21_gep(lengths, s21_bin(0, hlitn, mv2), false), I8)
        s21_store(s21_gep(lengths, mv2, false), src_l, I8)
        s21_store(msp, s21_bin(0, mv2, tig_int_lit(1)), T64)
        var brmb = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brmb, mh, 1)
        g_cur_block = mx
        tig_huff_build(hdistn, lengths, hdist, ok_p)
        var brd2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brd2, bSymLoop, 1)
        // ---- 失败/成功/退出 ----
        g_cur_block = bFail
        s21_store(ok_p, tig_int_lit(0), T64)
        var brf2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brf2, bExit, 1)
        g_cur_block = bSucc
        s21_store(ok_p, tig_int_lit(1), T64)
        var brs2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brs2, bExit, 1)
        g_cur_block = bExit
    }

    // ==================== p.6.4.9 untar_gz / unzip 内联（gzip+tar / zip 容器解析） ====================
    // untar_gz：gzip（RFC 1952）解压 → tar（ustar 512B 头）逐条目提取；
    // unzip：EOCD + 中央目录 + 本地头解析，stored/deflate 条目提取。
    // 两者共用 tig_inflate_raw（raw DEFLATE）。失败返回 false。路径 UTF-16 安全。

    // tar 数据块 512 字节对齐填充
    func tig_pad512(size: i64) -> i64 {
        var T64 = types.named(TK_I64)
        return s21_bin(2, s21_bin(3, s21_bin(0, size, tig_int_lit(511)), tig_int_lit(512)), tig_int_lit(512))
    }

    // 解析 tar 八进制数字段（buf[off..off+n)，遇 NUL/空格/非八进制停止）
    func tig_parse_octal(buf: i64, off: i64, n: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I8 = types.named(TK_I8)
        var aa = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(aa, T64, 2)
        var ap = ir.get_value(aa)
        var ka = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(ka, T64, 2)
        var kp = ir.get_value(ka)
        var sa = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(sa, T64, 2)
        var sp = ir.get_value(sa)
        s21_store(ap, tig_int_lit(0), T64)
        s21_store(kp, tig_int_lit(0), T64)
        s21_store(sp, tig_int_lit(0), T64)
        var hd = ir.new_block(g_cur_func, interner.intern("po.h"))
        var bd = ir.new_block(g_cur_func, interner.intern("po.b"))
        var ex = ir.new_block(g_cur_func, interner.intern("po.x"))
        var br0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br0, hd, 1)
        g_cur_block = hd
        var stp = s21_load(sp, T64)
        var stz = tig_icmp_c(stp, tig_int_lit(0), 0)  // stop == 0
        var kv = s21_load(kp, T64)
        var klt = tig_icmp_c(kv, n, 2)
        var cont = tig_and_i1(stz, klt)
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, cont, 0)
        ir.add_operand(cb, bd, 1)
        ir.add_operand(cb, ex, 1)
        g_cur_block = bd
        var kv2 = s21_load(kp, T64)
        var b = s21_zext(s21_load(s21_gep(buf, s21_bin(0, off, kv2), false), I8), I8)
        var nz = tig_icmp_c(b, tig_int_lit(0), 0)
        var nsp = tig_icmp_c(b, tig_int_lit(32), 0)
        var nlo = tig_icmp_c(b, tig_int_lit(48), 2)
        var nhi = tig_icmp_c(b, tig_int_lit(55), 3)
        var bad = tig_or_i1(tig_or_i1(nz, nsp), tig_or_i1(nlo, nhi))
        var bDo = ir.new_block(g_cur_func, interner.intern("po.do"))
        var bSk = ir.new_block(g_cur_func, interner.intern("po.sk"))
        var bInc = ir.new_block(g_cur_func, interner.intern("po.ic"))
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, bad, 0)
        ir.add_operand(cb2, bSk, 1)
        ir.add_operand(cb2, bDo, 1)
        g_cur_block = bDo
        var av = s21_load(ap, T64)
        var eightv = tig_int_lit(8)
        var mul = ir.new_inst(g_cur_block, 2, T64)
        ir.add_operand(mul, av, 0)
        ir.add_operand(mul, eightv, 0)
        s21_store(ap, s21_bin(0, ir.get_value(mul), s21_bin(1, b, tig_int_lit(48))), T64)
        var brd = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brd, bInc, 1)
        g_cur_block = bSk
        s21_store(sp, tig_int_lit(1), T64)
        var brs = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brs, bInc, 1)
        g_cur_block = bInc
        s21_store(kp, s21_bin(0, kv2, tig_int_lit(1)), T64)
        var brb = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brb, hd, 1)
        g_cur_block = ex
        return s21_load(ap, T64)
    }

    // NUL 终止串长度：buf[off..off+maxn) 内首个 0 的偏移（无 NUL → maxn）
    func tig_cstr_len(buf: i64, off: i64, maxn: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I8 = types.named(TK_I8)
        var rs = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(rs, T64, 2)
        var rp = ir.get_value(rs)
        var ka = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(ka, T64, 2)
        var kp = ir.get_value(ka)
        s21_store(rp, maxn, T64)
        s21_store(kp, tig_int_lit(0), T64)
        var hd = ir.new_block(g_cur_func, interner.intern("cs.h"))
        var bd = ir.new_block(g_cur_func, interner.intern("cs.b"))
        var ex = ir.new_block(g_cur_func, interner.intern("cs.x"))
        var br0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br0, hd, 1)
        g_cur_block = hd
        var kv = s21_load(kp, T64)
        var klt = tig_icmp_c(kv, maxn, 2)
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, klt, 0)
        ir.add_operand(cb, bd, 1)
        ir.add_operand(cb, ex, 1)
        g_cur_block = bd
        var kv2 = s21_load(kp, T64)
        var b = s21_zext(s21_load(s21_gep(buf, s21_bin(0, off, kv2), false), I8), I8)
        var nz = tig_icmp_c(b, tig_int_lit(0), 0)
        var bF = ir.new_block(g_cur_func, interner.intern("cs.f"))
        var bI = ir.new_block(g_cur_func, interner.intern("cs.i"))
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, nz, 0)
        ir.add_operand(cb2, bF, 1)
        ir.add_operand(cb2, bI, 1)
        g_cur_block = bF
        s21_store(rp, kv2, T64)
        var brf = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brf, ex, 1)
        g_cur_block = bI
        s21_store(kp, s21_bin(0, kv2, tig_int_lit(1)), T64)
        var brb = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brb, hd, 1)
        g_cur_block = ex
        return s21_load(rp, T64)
    }

    // 从原始字节区 buf[off..off+n) 构造带头 tie 串
    func tig_bytes_sub(buf: i64, off: i64, n: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I8 = types.named(TK_I8)
        var s = s21_sso_alloc(n)
        s21_store(s21_gep(s, 0, true), n, T64)
        var d0 = s21_gep(s, 8, true)
        s21_memcpy_if(d0, s21_gep(buf, off, false), n)
        s21_store(s21_gep(d0, n, false), tig_int_lit_ty(0, I8), I8)
        return d0
    }

    // a + "/" + b（路径拼接，'/' 兼容 Windows）
    func tig_join_slash(a: i64, b: i64) -> i64 {
        var hv = s21_sb_new()
        s21_sb_append(hv, a)
        s21_sb_append_byte(hv, tig_int_lit(47))
        s21_sb_append(hv, b)
        return s21_sb_build(hv)
    }

    // 取目录名：p 中最后一个 '/' 或 '\' 之前的子串（无分隔符 → ""）
    func tig_dirname(p: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I8 = types.named(TK_I8)
        var ST = types.named(TK_STR)
        var n = s21_str_head_len(p)
        var rs = ir.new_inst(g_cur_block, 20, ST)
        ir.add_operand(rs, ST, 2)
        var rp = ir.get_value(rs)
        s21_store(rp, tig_str_lit(interner.intern("\"\"")), ST)
        var ia = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(ia, T64, 2)
        var ip = ir.get_value(ia)
        s21_store(ip, s21_bin(1, n, tig_int_lit(1)), T64)  // n-1
        var hd = ir.new_block(g_cur_func, interner.intern("dn.h"))
        var bd = ir.new_block(g_cur_func, interner.intern("dn.b"))
        var ex = ir.new_block(g_cur_func, interner.intern("dn.x"))
        var br0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br0, hd, 1)
        g_cur_block = hd
        var iv = s21_load(ip, T64)
        var ige = tig_icmp_c(iv, tig_int_lit(0), 5)
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, ige, 0)
        ir.add_operand(cb, bd, 1)
        ir.add_operand(cb, ex, 1)
        g_cur_block = bd
        var iv2 = s21_load(ip, T64)
        var b = s21_str_byte(p, iv2)
        var s1 = tig_icmp_c(b, tig_int_lit(47), 0)
        var s2 = tig_icmp_c(b, tig_int_lit(92), 0)
        var issep = tig_or_i1(s1, s2)
        var bF = ir.new_block(g_cur_func, interner.intern("dn.f"))
        var bI = ir.new_block(g_cur_func, interner.intern("dn.i"))
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, issep, 0)
        ir.add_operand(cb2, bF, 1)
        ir.add_operand(cb2, bI, 1)
        g_cur_block = bF
        s21_store(rp, s21_str_sub_bytes(p, tig_int_lit(0), iv2), ST)
        var brf = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brf, ex, 1)
        g_cur_block = bI
        s21_store(ip, s21_bin(1, iv2, tig_int_lit(1)), T64)  // i--
        var brb = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brb, hd, 1)
        g_cur_block = ex
        return s21_load(rp, ST)
    }

    // gzip 头跳过（RFC 1952）：magic 1f 8b + CM=8；解析可选字段（FEXTRA bit2 /
    // FNAME bit3 / FCOMMENT bit4 / FHCRC bit1）返回 DEFLATE 数据偏移。
    // 无分支（select 折算游标前进量）；srclen 约束 cstr_len 读界。游标槽 psp。
    func tig_gzip_skip_header(src: i64, srclen: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I8 = types.named(TK_I8)
        var ps = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(ps, T64, 2)
        var psp = ir.get_value(ps)
        s21_store(psp, tig_int_lit(10), T64)
        // FLG = src[3]（固定头 10 字节：ID1 ID2 CM FLG MTIME[4] XFL OS）
        var flg = s21_zext(s21_load(s21_gep(src, 3, true), I8), I8)
        // FEXTRA（bit2）：u16 XLEN@10；跳过 2+XLEN（无该位时读出值被 select 丢弃）
        var hasExtra = tig_icmp_c(s21_bin(6, flg, tig_int_lit(4)), tig_int_lit(0), 1)
        var xlen = tig_le_u16(src, tig_int_lit(10))
        var skipE = tig_select_i(hasExtra, s21_bin(0, tig_int_lit(2), xlen), tig_int_lit(0), T64)
        var pos1 = s21_load(psp, T64)
        s21_store(psp, s21_bin(0, pos1, skipE), T64)
        // FNAME（bit3）：NUL 终止串；跳过 len+1
        var hasName = tig_icmp_c(s21_bin(6, flg, tig_int_lit(8)), tig_int_lit(0), 1)
        var pos2 = s21_load(psp, T64)
        var max2 = s21_bin(1, srclen, pos2)  // srclen - pos2（读界）
        var nlen = tig_cstr_len(src, pos2, max2)
        var skipN = tig_select_i(hasName, s21_bin(0, nlen, tig_int_lit(1)), tig_int_lit(0), T64)
        s21_store(psp, s21_bin(0, pos2, skipN), T64)
        // FCOMMENT（bit4）：NUL 终止串；跳过 len+1
        var hasCmt = tig_icmp_c(s21_bin(6, flg, tig_int_lit(16)), tig_int_lit(0), 1)
        var pos3 = s21_load(psp, T64)
        var max3 = s21_bin(1, srclen, pos3)
        var clen = tig_cstr_len(src, pos3, max3)
        var skipC = tig_select_i(hasCmt, s21_bin(0, clen, tig_int_lit(1)), tig_int_lit(0), T64)
        s21_store(psp, s21_bin(0, pos3, skipC), T64)
        // FHCRC（bit1）：2 字节 CRC16
        var hasCrc = tig_icmp_c(s21_bin(6, flg, tig_int_lit(2)), tig_int_lit(0), 1)
        var pos4 = s21_load(psp, T64)
        var skipH = tig_select_i(hasCrc, tig_int_lit(2), tig_int_lit(0), T64)
        s21_store(psp, s21_bin(0, pos4, skipH), T64)
        return s21_load(psp, T64)
    }

    // tar（ustar）容器解析：data[0..dlen) 逐 512B 头；结果 i1 写 rs_p。
    // 支持 typeflag：'0'/'\0' 文件、'5' 目录、'L' GNU 长名、其它跳过。
    func tig_tar_extract(data: i64, dlen: i64, dest: i64, rs_p: i64) {
        var T64 = types.named(TK_I64)
        var I8 = types.named(TK_I8)
        var ST = types.named(TK_STR)
        var TB = types.named(TK_BOOL)
        s21_store(rs_p, tig_bool_lit(0), TB)
        tig_mkdir_all(dest)
        var os = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(os, T64, 2)
        var osp = ir.get_value(os)
        var ps = ir.new_inst(g_cur_block, 20, ST)
        ir.add_operand(ps, ST, 2)
        var psp = ir.get_value(ps)
        var hp = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(hp, T64, 2)
        var hpp = ir.get_value(hp)
        var ns = ir.new_inst(g_cur_block, 20, ST)
        ir.add_operand(ns, ST, 2)
        var nsp = ir.get_value(ns)
        s21_store(osp, tig_int_lit(0), T64)
        s21_store(psp, tig_int_lit(0), ST)
        s21_store(hpp, tig_int_lit(0), T64)
        s21_store(nsp, tig_str_lit(interner.intern("\"\"")), ST)
        var hd = ir.new_block(g_cur_func, interner.intern("tx.h"))
        var bd = ir.new_block(g_cur_func, interner.intern("tx.b"))
        var ex = ir.new_block(g_cur_func, interner.intern("tx.x"))
        var bProc = ir.new_block(g_cur_func, interner.intern("tx.p"))
        var bL = ir.new_block(g_cur_func, interner.intern("tx.l"))
        var bNotL = ir.new_block(g_cur_func, interner.intern("tx.nl"))
        var bUseP = ir.new_block(g_cur_func, interner.intern("tx.up"))
        var bUseH = ir.new_block(g_cur_func, interner.intern("tx.uh"))
        var bName = ir.new_block(g_cur_func, interner.intern("tx.nm"))
        var bPf = ir.new_block(g_cur_func, interner.intern("tx.pf"))
        var bNoPf = ir.new_block(g_cur_func, interner.intern("tx.np"))
        var bDir = ir.new_block(g_cur_func, interner.intern("tx.d"))
        var bNotDir = ir.new_block(g_cur_func, interner.intern("tx.nd"))
        var bFile = ir.new_block(g_cur_func, interner.intern("tx.f"))
        var bSkip = ir.new_block(g_cur_func, interner.intern("tx.s"))
        var bAdv = ir.new_block(g_cur_func, interner.intern("tx.a"))
        var br0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br0, hd, 1)
        g_cur_block = hd
        var ov = s21_load(osp, T64)
        var room = tig_icmp_c(s21_bin(0, ov, tig_int_lit(512)), dlen, 4)  // off+512 <= dlen
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, room, 0)
        ir.add_operand(cb, bd, 1)
        ir.add_operand(cb, ex, 1)
        g_cur_block = bd
        var ov2 = s21_load(osp, T64)
        var nb = s21_zext(s21_load(s21_gep(data, ov2, false), I8), I8)
        var zflag = tig_icmp_c(nb, tig_int_lit(0), 0)
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, zflag, 0)
        ir.add_operand(cb2, ex, 1)
        ir.add_operand(cb2, bProc, 1)
        // 处理头
        g_cur_block = bProc
        var ov3 = s21_load(osp, T64)
        var tf = s21_zext(s21_load(s21_gep(data, s21_bin(0, ov3, tig_int_lit(156)), false), I8), I8)
        var size = tig_parse_octal(data, s21_bin(0, ov3, tig_int_lit(124)), tig_int_lit(12))
        var data_off = s21_bin(0, ov3, tig_int_lit(512))
        var isL = tig_icmp_c(tf, tig_int_lit(76), 0)  // 'L'
        var cb3 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb3, isL, 0)
        ir.add_operand(cb3, bL, 1)
        ir.add_operand(cb3, bNotL, 1)
        // 'L'：读长名
        g_cur_block = bL
        var nmlen = tig_cstr_len(data, data_off, size)
        var longname = tig_bytes_sub(data, data_off, nmlen)
        s21_store(psp, longname, ST)
        s21_store(hpp, tig_int_lit(1), T64)
        var padl = tig_pad512(size)
        s21_store(osp, s21_bin(0, s21_bin(0, ov3, tig_int_lit(512)), padl), T64)
        var brl = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brl, hd, 1)
        // 非 'L'：名字来源
        g_cur_block = bNotL
        var hv = s21_load(hpp, T64)
        var hasp = tig_icmp_c(hv, tig_int_lit(0), 1)
        var cb4 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb4, hasp, 0)
        ir.add_operand(cb4, bUseP, 1)
        ir.add_operand(cb4, bUseH, 1)
        g_cur_block = bUseP
        s21_store(nsp, s21_load(psp, ST), ST)
        s21_store(hpp, tig_int_lit(0), T64)
        var bru = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bru, bName, 1)
        g_cur_block = bUseH
        var pfxlen = tig_cstr_len(data, s21_bin(0, ov3, tig_int_lit(345)), tig_int_lit(155))
        var nm0 = tig_cstr_len(data, ov3, tig_int_lit(100))
        var hdrname = tig_bytes_sub(data, ov3, nm0)
        var pfx = tig_bytes_sub(data, s21_bin(0, ov3, tig_int_lit(345)), pfxlen)
        var pfxgt = tig_icmp_c(pfxlen, tig_int_lit(0), 3)
        var cb5 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb5, pfxgt, 0)
        ir.add_operand(cb5, bPf, 1)
        ir.add_operand(cb5, bNoPf, 1)
        g_cur_block = bPf
        s21_store(nsp, tig_join_slash(pfx, hdrname), ST)
        var brp = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brp, bName, 1)
        g_cur_block = bNoPf
        s21_store(nsp, hdrname, ST)
        var brn2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brn2, bName, 1)
        // 名字就绪：构造 dest/name，按 typeflag 处理
        g_cur_block = bName
        var nmv = s21_load(nsp, ST)
        var full = tig_join_slash(dest, nmv)
        var isdir = tig_icmp_c(tf, tig_int_lit(53), 0)  // '5'
        var cb6 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb6, isdir, 0)
        ir.add_operand(cb6, bDir, 1)
        ir.add_operand(cb6, bNotDir, 1)
        g_cur_block = bDir
        tig_mkdir_all(full)
        var brd2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brd2, bAdv, 1)
        g_cur_block = bNotDir
        var isf0 = tig_icmp_c(tf, tig_int_lit(48), 0)  // '0'
        var isfn = tig_icmp_c(tf, tig_int_lit(0), 0)   // '\0'
        var isfile = tig_or_i1(isf0, isfn)
        var cb7 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb7, isfile, 0)
        ir.add_operand(cb7, bFile, 1)
        ir.add_operand(cb7, bSkip, 1)
        g_cur_block = bFile
        var parent = tig_dirname(full)
        tig_mkdir_all(parent)
        tig_write_region(full, data, data_off, size)
        var brf5 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brf5, bAdv, 1)
        g_cur_block = bSkip
        var brs2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brs2, bAdv, 1)
        // 推进
        g_cur_block = bAdv
        var pad = tig_pad512(size)
        s21_store(osp, s21_bin(0, s21_bin(0, ov3, tig_int_lit(512)), pad), T64)
        var bra = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bra, hd, 1)
        g_cur_block = ex
        s21_store(rs_p, tig_bool_lit(1), TB)
    }

    // untar_gz(tar_gz_path, dest_dir) → bool：gzip 解压 + tar 提取。
    // 流程：读文件 → 检 gzip magic（1f 8b）→ gzip 则跳过头 + inflate_raw →
    // tar_extract 解出数据；非 gzip 则按未压缩 tar 兜底直解。成功 true 失败 false。
    func tig_untar_gz(tar_path: i64, dest: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I8 = types.named(TK_I8)
        var ST = types.named(TK_STR)
        var TB = types.named(TK_BOOL)
        var rslt = ir.new_inst(g_cur_block, 20, TB)
        ir.add_operand(rslt, TB, 2)
        var rv = ir.get_value(rslt)
        s21_store(rv, tig_bool_lit(0), TB)
        var fdata = tig_read_file(tar_path)
        var flen = s21_str_head_len(fdata)
        // 空文件/读取失败 → false（保持失败返回语义）
        var nz = tig_icmp_c(flen, tig_int_lit(0), 3)  // flen > 0
        var bNz = ir.new_block(g_cur_func, interner.intern("ut.nz"))
        var bEm = ir.new_block(g_cur_func, interner.intern("ut.em"))
        var bM = ir.new_block(g_cur_func, interner.intern("ut.m"))
        var cb0 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb0, nz, 0)
        ir.add_operand(cb0, bNz, 1)
        ir.add_operand(cb0, bEm, 1)
        g_cur_block = bEm
        s21_store(rv, tig_bool_lit(0), TB)
        var brE = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brE, bM, 1)
        g_cur_block = bNz
        // gzip magic：b0==0x1F && b1==0x8B
        var b0 = s21_zext(s21_load(s21_gep(fdata, 0, true), I8), I8)
        var b1 = s21_zext(s21_load(s21_gep(fdata, 1, true), I8), I8)
        var m0 = tig_icmp_c(b0, tig_int_lit(31), 0)   // 0x1F
        var m1 = tig_icmp_c(b1, tig_int_lit(139), 0)  // 0x8B
        var isgz = tig_and_i1(m0, m1)
        var bGz = ir.new_block(g_cur_func, interner.intern("ut.gz"))
        var bTar = ir.new_block(g_cur_func, interner.intern("ut.tar"))
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, isgz, 0)
        ir.add_operand(cb, bGz, 1)
        ir.add_operand(cb, bTar, 1)
        // ---- gzip 路径：跳过头 → inflate_raw → tar_extract ----
        g_cur_block = bGz
        var dstart = tig_gzip_skip_header(fdata, flen)
        var dlen = s21_bin(1, s21_bin(1, flen, tig_int_lit(8)), dstart)  // flen-8-dstart（尾 CRC32+ISIZE）
        var osb = s21_sb_new()
        var ok = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(ok, T64, 2)
        var okp = ir.get_value(ok)
        s21_store(okp, tig_int_lit(0), T64)
        tig_inflate_raw(s21_gep(fdata, dstart, false), dlen, osb, okp)
        var okv = s21_load(okp, T64)
        var oknz = tig_icmp_c(okv, tig_int_lit(0), 1)
        var bIok = ir.new_block(g_cur_func, interner.intern("ut.io"))
        var bIbad = ir.new_block(g_cur_func, interner.intern("ut.ib"))
        var bTx = ir.new_block(g_cur_func, interner.intern("ut.tx"))
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, oknz, 0)
        ir.add_operand(cb2, bIok, 1)
        ir.add_operand(cb2, bIbad, 1)
        // inflate 成功：解出数据 → tar 提取
        g_cur_block = bIok
        var outs = s21_sb_build(osb)
        var olen = s21_str_head_len(outs)
        var okr = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(okr, T64, 2)
        var okrp = ir.get_value(okr)
        s21_store(okrp, tig_int_lit(0), T64)
        tig_tar_extract(outs, olen, dest, okrp)
        var okrv = s21_load(okrp, T64)
        var okrnz = tig_icmp_c(okrv, tig_int_lit(0), 1)
        s21_store(rv, okrnz, TB)
        var brI = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brI, bTx, 1)
        // inflate 失败：false
        g_cur_block = bIbad
        s21_store(rv, tig_bool_lit(0), TB)
        var brB = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brB, bTx, 1)
        g_cur_block = bTx
        var brTx = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brTx, bM, 1)
        // ---- tar 兜底路径（非 gzip：未压缩 tar 直解）----
        g_cur_block = bTar
        var okr2 = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(okr2, T64, 2)
        var okr2p = ir.get_value(okr2)
        s21_store(okr2p, tig_int_lit(0), T64)
        tig_tar_extract(fdata, flen, dest, okr2p)
        var okr2v = s21_load(okr2p, T64)
        var okr2nz = tig_icmp_c(okr2v, tig_int_lit(0), 1)
        s21_store(rv, okr2nz, TB)
        var brB2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brB2, bM, 1)
        // ---- 结束 ----
        g_cur_block = bM
        return s21_load(rv, TB)
    }

    // 小端 u16 / u32
    func tig_le_u16(buf: i64, off: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I8 = types.named(TK_I8)
        var b0 = s21_zext(s21_load(s21_gep(buf, off, false), I8), I8)
        var b1 = s21_zext(s21_load(s21_gep(buf, s21_bin(0, off, tig_int_lit(1)), false), I8), I8)
        return s21_bin(7, b0, s21_bin(10, b1, tig_int_lit(8)))
    }
    func tig_le_u32(buf: i64, off: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I8 = types.named(TK_I8)
        var b0 = s21_zext(s21_load(s21_gep(buf, off, false), I8), I8)
        var b1 = s21_zext(s21_load(s21_gep(buf, s21_bin(0, off, tig_int_lit(1)), false), I8), I8)
        var b2 = s21_zext(s21_load(s21_gep(buf, s21_bin(0, off, tig_int_lit(2)), false), I8), I8)
        var b3 = s21_zext(s21_load(s21_gep(buf, s21_bin(0, off, tig_int_lit(3)), false), I8), I8)
        var v1 = s21_bin(7, b0, s21_bin(10, b1, tig_int_lit(8)))
        var v2 = s21_bin(7, v1, s21_bin(10, b2, tig_int_lit(16)))
        return s21_bin(7, v2, s21_bin(10, b3, tig_int_lit(24)))
    }

    // 从文件尾部向前找 EOCD 签名 "PK\x05\x06"；返回偏移（-1 未找到）
    func tig_zip_find_eocd(data: i64, dlen: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I8 = types.named(TK_I8)
        var rs = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(rs, T64, 2)
        var rp = ir.get_value(rs)
        var ia = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(ia, T64, 2)
        var ip = ir.get_value(ia)
        s21_store(rp, tig_int_lit(-1), T64)
        s21_store(ip, s21_bin(1, dlen, tig_int_lit(22)), T64)  // dlen-22
        var hd = ir.new_block(g_cur_func, interner.intern("ze.h"))
        var bd = ir.new_block(g_cur_func, interner.intern("ze.b"))
        var ex = ir.new_block(g_cur_func, interner.intern("ze.x"))
        var br0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br0, hd, 1)
        g_cur_block = hd
        var iv = s21_load(ip, T64)
        var ige = tig_icmp_c(iv, tig_int_lit(0), 5)
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, ige, 0)
        ir.add_operand(cb, bd, 1)
        ir.add_operand(cb, ex, 1)
        g_cur_block = bd
        var iv2 = s21_load(ip, T64)
        var s0 = tig_icmp_c(s21_zext(s21_load(s21_gep(data, iv2, false), I8), I8), tig_int_lit(80), 0)  // 'P'
        var s1 = tig_icmp_c(s21_zext(s21_load(s21_gep(data, s21_bin(0, iv2, tig_int_lit(1)), false), I8), I8), tig_int_lit(75), 0)  // 'K'
        var s2 = tig_icmp_c(s21_zext(s21_load(s21_gep(data, s21_bin(0, iv2, tig_int_lit(2)), false), I8), I8), tig_int_lit(5), 0)
        var s3 = tig_icmp_c(s21_zext(s21_load(s21_gep(data, s21_bin(0, iv2, tig_int_lit(3)), false), I8), I8), tig_int_lit(6), 0)
        var sig = tig_and_i1(tig_and_i1(tig_and_i1(s0, s1), s2), s3)
        var bF = ir.new_block(g_cur_func, interner.intern("ze.f"))
        var bI = ir.new_block(g_cur_func, interner.intern("ze.i"))
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, sig, 0)
        ir.add_operand(cb2, bF, 1)
        ir.add_operand(cb2, bI, 1)
        g_cur_block = bF
        s21_store(rp, iv2, T64)
        var brf = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brf, ex, 1)
        g_cur_block = bI
        s21_store(ip, s21_bin(1, iv2, tig_int_lit(1)), T64)
        var brb = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brb, hd, 1)
        g_cur_block = ex
        return s21_load(rp, T64)
    }

    // unzip(zip_path, dest_dir) → bool：EOCD + 中央目录 + 本地头；stored/deflate 提取
    func tig_unzip(zip_path: i64, dest: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I8 = types.named(TK_I8)
        var ST = types.named(TK_STR)
        var TB = types.named(TK_BOOL)
        var rslt = ir.new_inst(g_cur_block, 20, TB)
        ir.add_operand(rslt, TB, 2)
        var rv = ir.get_value(rslt)
        s21_store(rv, tig_bool_lit(0), TB)
        var fdata = tig_read_file(zip_path)
        var flen = s21_str_head_len(fdata)
        var eocd = tig_zip_find_eocd(fdata, flen)
        var eok = tig_icmp_c(eocd, tig_int_lit(0), 5)
        var bOk = ir.new_block(g_cur_func, interner.intern("uz.ok"))
        var bBad = ir.new_block(g_cur_func, interner.intern("uz.b"))
        var bM = ir.new_block(g_cur_func, interner.intern("uz.m"))
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, eok, 0)
        ir.add_operand(cb, bOk, 1)
        ir.add_operand(cb, bBad, 1)
        g_cur_block = bBad
        var brb = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brb, bM, 1)
        // 解析中央目录
        g_cur_block = bOk
        var cd_off = tig_le_u32(fdata, s21_bin(0, eocd, tig_int_lit(16)))
        var entries = tig_le_u16(fdata, s21_bin(0, eocd, tig_int_lit(10)))
        tig_mkdir_all(dest)
        var ef = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(ef, T64, 2)
        var efp = ir.get_value(ef)
        var cp = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(cp, T64, 2)
        var cpp = ir.get_value(cp)
        var ki = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(ki, T64, 2)
        var kip = ir.get_value(ki)
        s21_store(efp, tig_int_lit(0), T64)
        s21_store(cpp, cd_off, T64)
        s21_store(kip, tig_int_lit(0), T64)
        var hd = ir.new_block(g_cur_func, interner.intern("uz.h"))
        var bd = ir.new_block(g_cur_func, interner.intern("uz.b2"))
        var ex = ir.new_block(g_cur_func, interner.intern("uz.x"))
        var bDir = ir.new_block(g_cur_func, interner.intern("uz.d"))
        var bND = ir.new_block(g_cur_func, interner.intern("uz.nd"))
        var bSt = ir.new_block(g_cur_func, interner.intern("uz.st"))
        var bNst = ir.new_block(g_cur_func, interner.intern("uz.ns"))
        var bDf = ir.new_block(g_cur_func, interner.intern("uz.df"))
        var bUn = ir.new_block(g_cur_func, interner.intern("uz.un"))
        var bDo = ir.new_block(g_cur_func, interner.intern("uz.do"))
        var bDff = ir.new_block(g_cur_func, interner.intern("uz.df2"))
        var bDfd = ir.new_block(g_cur_func, interner.intern("uz.dd"))
        var bAdv = ir.new_block(g_cur_func, interner.intern("uz.a"))
        var br0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br0, hd, 1)
        g_cur_block = hd
        var kv = s21_load(kip, T64)
        var klt = tig_icmp_c(kv, entries, 2)
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, klt, 0)
        ir.add_operand(cb2, bd, 1)
        ir.add_operand(cb2, ex, 1)
        g_cur_block = bd
        var pos = s21_load(cpp, T64)
        var method = tig_le_u16(fdata, s21_bin(0, pos, tig_int_lit(10)))
        var csize = tig_le_u32(fdata, s21_bin(0, pos, tig_int_lit(20)))
        var fname_len = tig_le_u16(fdata, s21_bin(0, pos, tig_int_lit(28)))
        var extra_len = tig_le_u16(fdata, s21_bin(0, pos, tig_int_lit(30)))
        var comment_len = tig_le_u16(fdata, s21_bin(0, pos, tig_int_lit(32)))
        var local_off = tig_le_u32(fdata, s21_bin(0, pos, tig_int_lit(42)))
        var lfname_len = tig_le_u16(fdata, s21_bin(0, local_off, tig_int_lit(26)))
        var lextra_len = tig_le_u16(fdata, s21_bin(0, local_off, tig_int_lit(28)))
        var nm = tig_bytes_sub(fdata, s21_bin(0, local_off, tig_int_lit(30)), lfname_len)
        var data_off = s21_bin(0, s21_bin(0, s21_bin(0, local_off, tig_int_lit(30)), lfname_len), lextra_len)
        var nlen = s21_str_head_len(nm)
        var ngt = tig_icmp_c(nlen, tig_int_lit(0), 3)
        var lastb = s21_str_byte(nm, s21_bin(1, nlen, tig_int_lit(1)))
        var issl = tig_icmp_c(lastb, tig_int_lit(47), 0)
        var isdir = tig_and_i1(ngt, issl)
        var full = tig_join_slash(dest, nm)
        var cb3 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb3, isdir, 0)
        ir.add_operand(cb3, bDir, 1)
        ir.add_operand(cb3, bND, 1)
        g_cur_block = bDir
        tig_mkdir_all(full)
        var brd = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brd, bAdv, 1)
        g_cur_block = bND
        var parent = tig_dirname(full)
        tig_mkdir_all(parent)
        var m0 = tig_icmp_c(method, tig_int_lit(0), 0)
        var cb4 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb4, m0, 0)
        ir.add_operand(cb4, bSt, 1)
        ir.add_operand(cb4, bNst, 1)
        g_cur_block = bSt
        tig_write_region(full, fdata, data_off, csize)
        var brs = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brs, bAdv, 1)
        g_cur_block = bNst
        var m8 = tig_icmp_c(method, tig_int_lit(8), 0)
        var cb5 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb5, m8, 0)
        ir.add_operand(cb5, bDf, 1)
        ir.add_operand(cb5, bUn, 1)
        g_cur_block = bUn
        s21_store(efp, tig_int_lit(1), T64)
        var bru = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bru, bAdv, 1)
        // deflate 条目
        g_cur_block = bDf
        var osb = s21_sb_new()
        var ok = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(ok, T64, 2)
        var okp = ir.get_value(ok)
        s21_store(okp, tig_int_lit(0), T64)
        tig_inflate_raw(s21_gep(fdata, data_off, false), csize, osb, okp)
        var okv = s21_load(okp, T64)
        var oknz = tig_icmp_c(okv, tig_int_lit(0), 1)
        var cb6 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb6, oknz, 0)
        ir.add_operand(cb6, bDo, 1)
        ir.add_operand(cb6, bDff, 1)
        g_cur_block = bDo
        var outs = s21_sb_build(osb)
        tig_write_file(full, outs, false)
        var brd2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brd2, bDfd, 1)
        g_cur_block = bDff
        s21_store(efp, tig_int_lit(1), T64)
        var brdf = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brdf, bDfd, 1)
        g_cur_block = bDfd
        var brdd = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brdd, bAdv, 1)
        // 推进
        g_cur_block = bAdv
        var npos = s21_bin(0, s21_bin(0, s21_bin(0, s21_bin(0, pos, tig_int_lit(46)), fname_len), extra_len), comment_len)
        s21_store(cpp, npos, T64)
        var kk = s21_load(kip, T64)
        s21_store(kip, s21_bin(0, kk, tig_int_lit(1)), T64)
        var bra = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bra, hd, 1)
        // 结束
        g_cur_block = ex
        var efv = s21_load(efp, T64)
        var okall = tig_icmp_c(efv, tig_int_lit(0), 0)
        s21_store(rv, okall, TB)
        var brx = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brx, bM, 1)
        g_cur_block = bM
        return s21_load(rv, TB)
    }
}













