            if pat[k] == "i" {
                var vt = node_types[a]
                if vt != types.named(TK_I64) && vt != types.named(TK_U64) && vt >= 0 {
                    var sv = tig_sext(v, vt, types.named(TK_I64))
                    if sv < 0 {
                        return -1
                    }
                    v = sv
                }
            }
            table_push(avs, v)
            k = k + 1
        }
        // 按原语分派内联实现
        if nm == "net_tcp_listen" {
            g_builtin_res = tig_net_tcp_listen(avs[0])
        } else if nm == "net_tcp_accept" {
            g_builtin_res = tig_net_tcp_accept(avs[0])
        } else if nm == "net_tcp_connect" {
            g_builtin_res = tig_net_tcp_connect(avs[0], avs[1])
        } else if nm == "net_tcp_send" {
            g_builtin_res = tig_net_tcp_send(avs[0], avs[1])
        } else if nm == "net_tcp_recv" {
            g_builtin_res = tig_net_tcp_recv(avs[0], avs[1])
        } else if nm == "net_tcp_send_bytes" {
            g_builtin_res = tig_net_tcp_send_bytes(avs[0], avs[1])
        } else if nm == "net_tcp_recv_bytes" {
            g_builtin_res = tig_net_tcp_recv_bytes(avs[0], avs[1])
        } else if nm == "net_udp_bind" {
            g_builtin_res = tig_net_udp_bind(avs[0])
        } else if nm == "net_udp_send" {
            g_builtin_res = tig_net_udp_send(avs[0], avs[1], avs[2], avs[3])
        } else if nm == "net_udp_recv" {
            g_builtin_res = tig_net_udp_recv(avs[0], avs[1])
        } else {
            g_builtin_res = tig_net_close(avs[0])
        }
        return 0
    }
    if nm == "to_string" {
        var v = tig_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        // 实参类型：f64 → 用 i128 内联除数换成「浮点暂保留 Rust 桥」见下；
        // i64/u64 → tig_i64_to_str（去 Rust）；窄整数 sext → i64 后再内联。
        var vt = node_types[call_arg(id, 0)]
        if vt == types.named(TK_F64) || vt == types.named(TK_F32) {
            // p.6.4.4：去 Rust 桥（tie_to_string_f64）→ 内联 tig_f64_to_str
            //（CRT snprintf "%.17g" → 带头串；Rust 最短表示差异可接受）。
            var fv = v
            if vt == types.named(TK_F32) {
                fv = tig_coerce(v, types.named(TK_F32), types.named(TK_F64))  // fpext → f64
            }
            g_builtin_res = tig_f64_to_str(fv)
        } else if vt == types.named(TK_I128) || vt == types.named(TK_U128) {
            // 批次 2（i128/u128）：内联除法循环生成十进制串
            g_builtin_res = tig_i128_to_str(v, vt == types.named(TK_I128))
        } else if vt == types.named(TK_I64) {
            g_builtin_res = tig_i64_to_str(v, true)
        } else if vt == types.named(TK_U64) {
            g_builtin_res = tig_i64_to_str(v, false)
        } else if vt < 0 {
            g_builtin_res = tig_i64_to_str(v, false)
        } else {
            // 窄类型（trit/char/i8/i16/i32/u8/u16/u32 等）：sext → i64
            var sv = tig_sext(v, vt, types.named(TK_I64))
            if sv < 0 {
                return -1
            }
            g_builtin_res = tig_i64_to_str(sv, true)
        }
        return 0
    }
    if nm == "parse_int" {
        // 去 Rust 桥（批次A）：tig_parse_int 内联 IR 生成（字节循环累加），
        // 替代 Rust 桥 tie_parse_int。签名 (s, ok 出参槽) -> i64。不再置 g_used_interp。
        var v = tig_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        var pio = ir.new_inst(g_cur_block, 20, types.named(TK_I8))  // alloca i8 ok
        ir.add_operand(pio, types.named(TK_I8), 2)
        g_builtin_res = tig_parse_int(v, ir.get_value(pio))
        return 0
    }
    if nm == "parse_float" {
        // p.6.4.4：去 Rust 桥（tie_parse_float）→ 内联 tig_parse_float IR（字节循环
        // 十进制解析 + libm pow 指数缩放，有限精度）。签名 (s, ok 出参槽) -> f64。
        // 不再置 g_used_interp。
        var v = tig_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        var pfo = ir.new_inst(g_cur_block, 20, types.named(TK_I8))  // alloca i8
        ir.add_operand(pfo, types.named(TK_I8), 2)
        g_builtin_res = tig_parse_float(v, ir.get_value(pfo))
        return 0
    }
    if nm == "parse_trit" {
        // 去 Rust 桥（批次A）：tig_parse_trit 内联 IR 生成，替代桥 tie_parse_trit。
        // 返回 i8（值域 -1/0/1，语义类型标 TK_TRIT）。不再置 g_used_interp。
        var v = tig_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        var pto = ir.new_inst(g_cur_block, 20, types.named(TK_I8))  // alloca i8
        ir.add_operand(pto, types.named(TK_I8), 2)
        g_builtin_res = tig_parse_trit(v, ir.get_value(pto))
        return 0
    }
    if nm == "to_trit" {
        // i64 → 饱和钳制 trit（i8，值域 -1/0/1；对齐 interp_bin clamp_trit）：
        // lt = x< -1 → -1；gt = x>1 → 1；否则 x。clamp 后 trunc i8。
        var v = tig_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        var T64 = types.named(TK_I64)
        var lt = tig_icmp_c(v, tig_int_lit(-1), 2)          // x < -1 (slt)
        var c1 = tig_select_i(lt, tig_int_lit(-1), v, T64)  // c1 = clamp 下界
        var gt = tig_icmp_c(c1, tig_int_lit(1), 3)          // x > 1 (sgt)
        var c2 = tig_select_i(gt, tig_int_lit(1), c1, T64)  // c2 ∈ [-1,1]
        g_builtin_res = s21_trunc_i8(c2)                    // i64 → i8 trit
        return 0
    }
    if nm == "trit_val" {
        // trit（i8）→ i64：sext 符号扩展（-1/0/1 → i64）
        var v = tig_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        g_builtin_res = tig_sext(v, types.named(TK_I8), types.named(TK_I64))
        return 0
    }
    if nm == "len" {
        // S2.1：len(表) → tie_table_len；len(字符串) → 读 {ptr,len} 长度头（O(1)，
        // 不再 strlen 扫描——字符串值统一带头部（字面量 .rodata 头 / str_cat 头 /
        // 桥返回自动补头 / StringBuilder build 头）。行为与旧 strlen 一致（字节数）。
        var a = call_arg(id, 0)
        var at = node_types[a]
        if at == types.named(TK_STR) {
            // 字符串：读 ptr-8 的 i64 长度头（S2.1）
            var v = tig_expr(a)
            if v < 0 {
                return -1
            }
            g_builtin_res = s21_str_head_len(v)
            return 0
        }
        var v2 = tig_expr(a)
        if v2 < 0 {
            return -1
        }
        g_builtin_res = s21_table_len(v2)
        return 0
    }
    // P2b：any 拆箱（as_bool/as_string/as_char——仅 any 参数；as_i64/as_f64
    // 已在上方 as_dst 块重载处理）。P2d：as_table_* 拆箱为对应元素类型表
    //（返回表值 ptr，tag = 精确表类型 id，与装箱时的 tag 一致才匹配）。
    if nm == "as_bool" || nm == "as_string" || nm == "as_char" ||
        nm == "as_table_i64" || nm == "as_table_string" || nm == "as_table_bool" ||
        nm == "as_table_f64" || nm == "as_table_char" || nm == "as_table_any" {
        var a0 = call_arg(id, 0)
        var av = tig_expr(a0)
        if av < 0 {
            return -1
        }
        var rty: i64 = types.named(TK_I64)
        if nm == "as_f64" {
            rty = types.named(TK_F64)
        } else if nm == "as_bool" {
            rty = types.named(TK_BOOL)
        } else if nm == "as_string" {
            rty = types.named(TK_STR)
        } else if nm == "as_char" {
            rty = types.named(TK_CHAR)
        } else if nm == "as_table_i64" {
            rty = types.table_of(types.named(TK_I64))
        } else if nm == "as_table_string" {
            rty = types.table_of(types.named(TK_STR))
        } else if nm == "as_table_bool" {
            rty = types.table_of(types.named(TK_BOOL))
        } else if nm == "as_table_f64" {
            rty = types.table_of(types.named(TK_F64))
        } else if nm == "as_table_char" {
            rty = types.table_of(types.named(TK_CHAR))
        } else if nm == "as_table_any" {
            rty = types.table_of(types.named(TK_ANY))
        }
        var ux = tig_unbox_any(av, rty, nm)
        if ux < 0 {
            return -1
        }
        g_builtin_res = ux
        return 0
    }
    // P2c：any_tag(x) → 读 {tag,payload} 的 tag 字段（标量 0-4 / 复合类型 id）
    if nm == "any_tag" {
        var a1 = call_arg(id, 0)
        var av1 = tig_expr(a1)
        if av1 < 0 {
            return -1
        }
        var any_ty6 = types.named(TK_ANY)
        var slot6 = ir.new_inst(g_cur_block, 20, any_ty6)
        ir.add_operand(slot6, any_ty6, 2)
        var sp6 = ir.get_value(slot6)
        var st6 = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(st6, any_ty6, 2)
        ir.add_operand(st6, av1, 0)
        ir.add_operand(st6, sp6, 0)
        var g6 = ir.new_inst(g_cur_block, 27, any_ty6)
        ir.add_operand(g6, sp6, 0)
        ir.add_operand(g6, 0, 2)
        var ld6 = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
        ir.add_operand(ld6, ir.get_value(g6), 0)
        g_builtin_res = ir.get_value(ld6)
        return 0
    }
    // P2d-D3：map 高阶——map_keys(m)→table<string>；map_values(m)→table<V>
    //（V 从实参 map<string,V> 类型解码）；map_contains(m, key)→bool（不 raise）
    if nm == "map_keys" || nm == "map_values" {
        var m0 = call_arg(id, 0)
        var mv = tig_expr(m0)
        if mv < 0 {
            return -1
        }
        var m_vty: i64 = types.named(TK_I64)
        if nm == "map_values" {
            var m_arg_ty = node_types[m0]
            if types.is_map(m_arg_ty) {
                var lv = types.low(m_arg_ty)
                if lv > 0 {
                    m_vty = lv
                }
            }
        }
        g_builtin_res = s21_map_extract(mv, m_vty, nm == "map_keys")
        return 0
    }
    if nm == "map_contains" {
        var m1 = tig_expr(call_arg(id, 0))
        if m1 < 0 {
            return -1
        }
        var k1 = tig_expr(call_arg(id, 1))
        if k1 < 0 {
            return -1
        }
        g_builtin_res = s21_map_contains(m1, k1)
        return 0
    }
    if nm == "table_new_i64" || nm == "table_new_f64" || nm == "table_new_string" || nm == "table_new_bool" {
        var elem: i64 = types.named(TK_I64)
        if nm == "table_new_string" {
            elem = types.named(TK_STR)
        } else if nm == "table_new_bool" {
            elem = types.named(TK_BOOL)
        } else if nm == "table_new_f64" {
            elem = types.named(TK_F64)
        }
        var esz_v = tig_int_lit_ty(elem_size(elem), types.named(TK_I64))
        g_builtin_res = s21_table_new(esz_v)
        return 0
    }
    if nm == "table_push" {
        // 第 1 参数 = 表变量（语义已保证）；元素类型查 lv_telem/gb_telem
        var tname_node = call_arg(id, 0)
        var tname = sstate.name_str(tname_node)
        var elem: i64 = types.named(TK_I64)
        // 优先 irgen 作用域完整类型（table_new_f64() 初始化的变量 scope 里是
        // table_of(f64) → 元素 f64）。var_table_elem 是语义层每函数重置的，
        // irgen 阶段只可靠查到最后一次登记——跨函数场景（parse_series 里
        // push parse_float 结果）会误判为 i64 导致 push_i64(double) 类型错
        var te: i64 = -1
        var tnid = interner.intern(tname)
        var tv_own = tblvar_get(tnid)
        if tv_own >= 0 {
            te = tv_own  // irgen 自维护登记（最可靠）
        } else if scope_get(tnid) >= 0 && types.is_table(g_lookup_ty) {
            var le = types.table_elem(g_lookup_ty)
            if le > 0 {
                te = le
            }
        }
        if te < 0 {
            te = sinfer.var_table_elem(tnid)
        }

        if te >= 0 {
            elem = te
        }
        var t = tig_expr(tname_node)
        if t < 0 {
            return -1
        }
        var x = tig_expr(call_arg(id, 1))
        if x < 0 {
            return -1
        }
        // 桥选择：按**值**的实际类型判定（嵌套表/字符串值 → push_string 存 ptr；
        // 浮点值 → push_f64；曾按声明元素类型选桥——parse_series 把 parse_float
        // 结果 push 进 i64 表会 push_i64(double) 类型错，Rust 按值类型选桥）
        var suffix = bridge_suffix(elem)
        var pty = types.named(TK_I64)
        var vt = node_types[call_arg(id, 1)]
        var ek = types.kind(elem)
        if ek == K_STRUCT || ek == K_ENUM || ek == K_FN || elem == types.named(TK_ANY) {
            // P2a/P2b 复合元素：槽类型 = 元素类型 id（多字元素类型化 store）
            pty = elem
        } else if vt >= 0 && (types.is_table(vt) || types.is_map(vt) || vt == types.named(TK_STR)) {
            suffix = "string"
            pty = types.named(TK_STR)
        } else if vt >= 0 && (vt == types.named(TK_F64) || vt == types.named(TK_F32)) {
            suffix = "f64"
            pty = types.named(TK_F64)
        } else if suffix == "string" {
            pty = types.named(TK_STR)
        } else if suffix == "bool" {
            pty = types.named(TK_BOOL)
        }
        if pty == types.named(TK_ANY) {
            // P2b 异构元素装箱：推入值 → any {tag, payload}
            var vt4 = node_types[call_arg(id, 1)]
            if vt4 >= 0 && vt4 != types.named(TK_ANY) {
                var bx = tig_box_any(x, vt4)
                if bx < 0 {
                    return -1
                }
                x = bx
            }
        }
        s21_table_push(t, pty, x)
        g_builtin_res = tig_int_lit(0)  // void 结果：哑值（调用方丢弃）
        return 0
    }
    if nm == "exit" {
        // 去 Rust 桥（dev33 批次3 关联）：exit 是 libc 符号（tig_ext_call1 经
        // is_libc 不置 interp），原误置 g_used_interp 把纯 libc 程序也拉进
        // tie_interp.lib。移除——link_exe 的 prefer_interp=false 时仅链 runtime.a。
        var v = tig_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        // C 运行时 exit() 自带 stdio flush，无需显式 fflush
        tig_ext_call1("exit", v, types.named(TK_I64), -1)
        g_builtin_res = tig_int_lit(0)  // exit 不返回：哑值
        return 0
    }
    if nm == "arg_count" {
        // p.6.4.1：内联 CommandLineToArgvW（shell32，非 interp 桥）
        g_builtin_res = tig_arg_count()
        return 0
    }
    if nm == "arg_string" {
        var i = tig_expr(call_arg(id, 0))
        if i < 0 {
            return -1
        }
        g_builtin_res = tig_arg_string(i)
        return 0
    }
    if nm == "file_read" {
        var p = tig_expr(call_arg(id, 0))
        if p < 0 {
            return -1
        }
        g_builtin_res = tig_read_file(p)
        return 0
    }
    if nm == "file_write" || nm == "file_append" {
        var p = tig_expr(call_arg(id, 0))
        if p < 0 {
            return -1
        }
        var c = tig_expr(call_arg(id, 1))
        if c < 0 {
            return -1
        }
        g_builtin_res = tig_write_file(p, c, nm == "file_append")
        return 0
    }
    if nm == "file_size" {
        var p = tig_expr(call_arg(id, 0))
        if p < 0 {
            return -1
        }
        g_builtin_res = tig_size_inline(p)
        return 0
    }
    if nm == "file_is_dir" || nm == "file_is_file" {
        var p = tig_expr(call_arg(id, 0))
        if p < 0 {
            return -1
        }
        if nm == "file_is_dir" {
            g_builtin_res = tig_is_dir_inline(p)
        } else {
            g_builtin_res = tig_is_file_inline(p)
        }
        return 0
    }
    if nm == "file_exists" {
        var p = tig_expr(call_arg(id, 0))
        if p < 0 {
            return -1
        }
        g_builtin_res = tig_exists_inline(p)
        return 0
    }
    if nm == "file_delete" {
        var p = tig_expr(call_arg(id, 0))
        if p < 0 {
            return -1
        }
        g_builtin_res = tig_delete_inline(p)
        return 0
    }
    if nm == "print_err" {
        var v = tig_expr(call_arg(id, 0))
        if v < 0 {
            return -1
        }
        tig_print_err(v)  // CRT _write fd=2（p.6.4.1，零 Rust 桥）
        g_builtin_res = tig_int_lit(0)  // void：哑值
        return 0
    }
    if nm == "mkdir_all" {
        var p = tig_expr(call_arg(id, 0))
        if p < 0 {
            return -1
        }
        g_builtin_res = tig_mkdir_all(p)
        return 0
    }
    if nm == "regex_find_all" {
        g_used_interp = true
        var s = tig_expr(call_arg(id, 0))
        if s < 0 {
            return -1
        }
        var p = tig_expr(call_arg(id, 1))
        if p < 0 {
            return -1
        }
        g_builtin_res = tig_ext_call2("tie_regex_find_all", s, types.named(TK_STR), p, types.named(TK_STR), types.named(TK_STR))
        return 0
    }
    // ---------- M4/M6 补齐：系统能力内置（对齐 Rust ir.rs 同名单分支）----------
    // 数学库（libm，llvmgen 无条件 declare；f64 → f64）。
    // 整数实参（sqrt(4)）→ sitofp 提升为 f64（LLVM 类型必须匹配）
    if nm == "sqrt" || nm == "sin" || nm == "cos" || nm == "tan" ||
        nm == "exp" || nm == "log" || nm == "floor" || nm == "ceil" || nm == "round" {
        var mv = tig_expr(call_arg(id, 0))
        if mv < 0 {
            return -1
        }
        var mvt = node_types[call_arg(id, 0)]
        var mf = tig_to_f64(mv, mvt)
        if mf < 0 {
            return -1
        }
        g_builtin_res = tig_ext_call1(nm, mf, types.named(TK_F64), types.named(TK_F64))
        return 0
    }
    // f64↔i64 位重解释（bitcast opcode 26，同宽 64 位直读；zd v2 §4.2）。
    // 操作数 [0]=源类型 IMM，[1]=值；目标类型 = ins_ty。
    if nm == "bitcast_f64_i64" || nm == "bitcast_i64_f64" {
        var bv = tig_expr(call_arg(id, 0))
        if bv < 0 {
            return -1
        }
        var dst_ty: i64 = types.named(TK_F64)
        var src_ty: i64 = types.named(TK_I64)
        if nm == "bitcast_f64_i64" {
            dst_ty = types.named(TK_I64)
            src_ty = types.named(TK_F64)
        }
        var bc = ir.new_inst(g_cur_block, 26, dst_ty)
        ir.add_operand(bc, src_ty, 2)  // 源类型 IMM
        ir.add_operand(bc, bv, 0)
        g_builtin_res = ir.get_value(bc)
        return 0
    }
    if nm == "pow" {
        var pv1 = tig_expr(call_arg(id, 0))
        if pv1 < 0 {
            return -1
        }
        var pv2 = tig_expr(call_arg(id, 1))
        if pv2 < 0 {
            return -1
        }
        var p1t = node_types[call_arg(id, 0)]
        var p2t = node_types[call_arg(id, 1)]
        var pf1 = tig_to_f64(pv1, p1t)
        var pf2 = tig_to_f64(pv2, p2t)
        if pf1 < 0 || pf2 < 0 {
            return -1
        }
        g_builtin_res = tig_ext_call2("pow", pf1, types.named(TK_F64), pf2, types.named(TK_F64), types.named(TK_F64))
        return 0
    }
    // read_line / msg_get_lang：零参数 → ptr 返回（cwd 已内联 UTF-16 桥）
    if nm == "read_line" || nm == "msg_get_lang" {
        g_used_interp = true
        var zero_v = tig_int_lit_ty(0, types.named(TK_I64))
        g_builtin_res = tig_ext_call1("tie_" + nm, zero_v, types.named(TK_I64), types.named(TK_STR))
        return 0
    }
    if nm == "cwd" {
        // p.6.4.1：内联 GetCurrentDirectoryW + UTF-16→UTF-8（非 interp 桥）
        g_builtin_res = tig_cwd()
        return 0
    }
    // 单字符串参数 → ptr 返回（previously list_dir/walk_dir 亦走此处；现已内联）；
    // path_*/http_get/msg_t 仍走 tie_* 桥（path_* 留待 p.6.4.10，http 属 p.6.4.9）
    if nm == "list_dir" || nm == "walk_dir" {
        var sv = tig_expr(call_arg(id, 0))
        if sv < 0 {
            return -1
        }
        if nm == "list_dir" {
            g_builtin_res = tig_list_dir(sv)
        } else {
            g_builtin_res = tig_walk_dir(sv)
        }
        return 0
    }
    if nm == "path_basename" || nm == "path_dirname" || nm == "path_abs" ||
        nm == "path_normalize" || nm == "http_get" || nm == "msg_t" {
        g_used_interp = true
        var sv = tig_expr(call_arg(id, 0))
        if sv < 0 {
            return -1
        }
        g_builtin_res = tig_ext_call1("tie_" + nm, sv, types.named(TK_STR), types.named(TK_STR))
        return 0
    }
    if nm == "eval" {
        // eval：桥名 tie_eval_expr（非 tie_eval——C ABI 桥签名 (ptr) -> ptr）
        g_used_interp = true
        var sv = tig_expr(call_arg(id, 0))
        if sv < 0 {
            return -1
        }
        g_builtin_res = tig_ext_call1("tie_eval_expr", sv, types.named(TK_STR), types.named(TK_STR))
        return 0
    }
    // 双字符串参数 → ptr 返回（path_join/msg_t_lang/eval_call/regex_find）
    if nm == "path_join" || nm == "msg_t_lang" || nm == "eval_call" || nm == "regex_find" {
        g_used_interp = true
        var a1 = tig_expr(call_arg(id, 0))
        if a1 < 0 {
            return -1
        }
        var a2 = tig_expr(call_arg(id, 1))
        if a2 < 0 {
            return -1
        }
        g_builtin_res = tig_ext_call2("tie_" + nm, a1, types.named(TK_STR), a2, types.named(TK_STR), types.named(TK_STR))
        return 0
    }
    // 三字符串参数 → ptr（regex_replace：s, pattern, replacement）
    if nm == "regex_replace" {
        g_used_interp = true
        var r1 = tig_expr(call_arg(id, 0))
        if r1 < 0 {
            return -1
        }
        var r2 = tig_expr(call_arg(id, 1))
        if r2 < 0 {
            return -1
        }
        var r3 = tig_expr(call_arg(id, 2))
        if r3 < 0 {
            return -1
        }
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, types.named(TK_STR))
        table_push(avs, r1)
        table_push(ats, types.named(TK_STR))
        table_push(avs, r2)
        table_push(ats, types.named(TK_STR))
        table_push(avs, r3)
        g_builtin_res = tig_ext_call_typed("tie_regex_replace", ats, avs, types.named(TK_STR))
        return 0
    }
    // regex_group：字符串 + 字符串 + i64 → ptr
    if nm == "regex_group" {
        g_used_interp = true
        var g1 = tig_expr(call_arg(id, 0))
        if g1 < 0 {
            return -1
        }
        var g2 = tig_expr(call_arg(id, 1))
        if g2 < 0 {
            return -1
        }
        var g3 = tig_expr(call_arg(id, 2))
        if g3 < 0 {
            return -1
        }
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, types.named(TK_STR))
        table_push(avs, g1)
        table_push(ats, types.named(TK_STR))
        table_push(avs, g2)
        table_push(ats, types.named(TK_I64))
        table_push(avs, g3)
        g_builtin_res = tig_ext_call_typed("tie_regex_group", ats, avs, types.named(TK_STR))
        return 0
    }
    // regex_match：字符串 + 字符串 + ok 出参 → i8 → bool
    if nm == "regex_match" {
        g_used_interp = true
        var m1 = tig_expr(call_arg(id, 0))
        if m1 < 0 {
            return -1
        }
        var m2 = tig_expr(call_arg(id, 1))
        if m2 < 0 {
            return -1
        }
        var mo = ir.new_inst(g_cur_block, 20, types.named(TK_I8))  // alloca i8 ok
        ir.add_operand(mo, types.named(TK_I8), 2)
        var mats: table<i64> = table_new_i64()
        var mavs: table<i64> = table_new_i64()
        table_push(mats, types.named(TK_STR))
        table_push(mavs, m1)
        table_push(mats, types.named(TK_STR))
        table_push(mavs, m2)
        table_push(mats, types.named(TK_STR))
        table_push(mavs, ir.get_value(mo))
        var mr = tig_ext_call_typed("tie_regex_match", mats, mavs, types.named(TK_I8))
        if mr < 0 {
            return -1
        }
        var mi = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))  // icmp ne 0
        ir.add_operand(mi, mr, 0)
        ir.add_operand(mi, 0, 2)
        ir.add_operand(mi, 1, 2)
        g_builtin_res = ir.get_value(mi)
        return 0
    }
    // 单字符串参数 i8 返回 → bool（file_exists 已有；remove_dir_all/mkdir_all 已有
    // mkdir_all；此处补 remove_dir_all）
    if nm == "remove_dir_all" {
        var rv = tig_expr(call_arg(id, 0))
        if rv < 0 {
            return -1
        }
        g_builtin_res = tig_remove_dir_all(rv)
        return 0
    }
    // file_copy/file_move/copy_dir：内联 CopyFileW/MoveFileW/SHFileOperationW
    if nm == "file_copy" || nm == "file_move" || nm == "copy_dir" {
        var f1 = tig_expr(call_arg(id, 0))
        if f1 < 0 {
            return -1
        }
        var f2 = tig_expr(call_arg(id, 1))
        if f2 < 0 {
            return -1
        }
        if nm == "file_copy" {
            g_builtin_res = tig_copy_file(f1, f2)
        } else if nm == "file_move" {
            g_builtin_res = tig_move_file(f1, f2)
        } else {
            g_builtin_res = tig_copy_dir(f1, f2)
        }
        return 0
    }
    // 双字符串参数 i8 返回 → bool（untar_gz/unzip/http_get_file 仍走 tie_* 桥）
    if nm == "untar_gz" || nm == "unzip" || nm == "http_get_file" {
        g_used_interp = true
        var f1 = tig_expr(call_arg(id, 0))
        if f1 < 0 {
            return -1
        }
        var f2 = tig_expr(call_arg(id, 1))
        if f2 < 0 {
            return -1
        }
        g_builtin_res = tig_bool_bridge2("tie_" + nm, f1, f2)
        return 0
    }
    // byte_read：读文件为字节表（tig_byte_read 原生 libc 实现，失败 exit(1)）
    if nm == "byte_read" {
        var pv = tig_expr(call_arg(id, 0))
        if pv < 0 {
            return -1
        }
        g_builtin_res = tig_byte_read(pv)
        return 0
    }
    // byte_write：路径 + 字节表 → bool（tig_byte_write 原生 libc 实现）
    if nm == "byte_write" {
        var w1 = tig_expr(call_arg(id, 0))
        if w1 < 0 {
            return -1
        }
        var w2 = tig_expr(call_arg(id, 1))
        if w2 < 0 {
            return -1
        }
        g_builtin_res = tig_byte_write(w1, w2)
        return 0
    }
    // bit_read：字节表 + 位置 → i64（tig_bit_read 原生实现，越界 0）
    if nm == "bit_read" {
        var b1 = tig_expr(call_arg(id, 0))
        if b1 < 0 {
            return -1
        }
        var b2 = tig_expr(call_arg(id, 1))
        if b2 < 0 {
            return -1
        }
        g_builtin_res = tig_bit_read(b1, b2)
        return 0
    }
    // bit_write：字节表 + 位置 + 位 → bool（tig_bit_write 原生实现，越界 false）
    if nm == "bit_write" {
        var bw1 = tig_expr(call_arg(id, 0))
        if bw1 < 0 {
            return -1
        }
        var bw2 = tig_expr(call_arg(id, 1))
        if bw2 < 0 {
            return -1
        }
        var bw3 = tig_expr(call_arg(id, 2))
        if bw3 < 0 {
            return -1
        }
        g_builtin_res = tig_bit_write(bw1, bw2, bw3)
        return 0
    }
    // byte_concat：字节表 + 字节表 → 字节表（tig_byte_concat 原生实现）
    if nm == "byte_concat" {
        var c1 = tig_expr(call_arg(id, 0))
        if c1 < 0 {
            return -1
        }
        var c2 = tig_expr(call_arg(id, 1))
        if c2 < 0 {
            return -1
        }
        g_builtin_res = tig_byte_concat(c1, c2)
        return 0
    }
    // set_env：内联 SetEnvironmentVariableW（UTF-16 桥）；msg_set_lang：单参 void
    if nm == "set_env" {
        var e1 = tig_expr(call_arg(id, 0))
        if e1 < 0 {
            return -1
        }
        var e2 = tig_expr(call_arg(id, 1))
        if e2 < 0 {
            return -1
        }
        tig_set_env(e1, e2)
        g_builtin_res = tig_int_lit(0)  // void：哑值
        return 0
    }
    if nm == "msg_set_lang" {
        g_used_interp = true
        var e1 = tig_expr(call_arg(id, 0))
        if e1 < 0 {
            return -1
        }
        tig_ext_call1("tie_msg_set_lang", e1, types.named(TK_STR), -1)
        g_builtin_res = tig_int_lit(0)  // void：哑值
        return 0
    }
    if nm == "msg_register" {
        g_used_interp = true
        var q1 = tig_expr(call_arg(id, 0))
        if q1 < 0 {
            return -1
        }
        var q2 = tig_expr(call_arg(id, 1))
        if q2 < 0 {
            return -1
        }
        var q3 = tig_expr(call_arg(id, 2))
        if q3 < 0 {
            return -1
        }
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, types.named(TK_STR))
        table_push(avs, q1)
        table_push(ats, types.named(TK_STR))
        table_push(avs, q2)
        table_push(ats, types.named(TK_STR))
        table_push(avs, q3)
        tig_ext_call_typed("tie_msg_register", ats, avs, -1)
        g_builtin_res = tig_int_lit(0)  // void：哑值
        return 0
    }
    // rand_range：i64 半开区间 [min,max)；内联 libc rand()（非密码学安全）
    if nm == "rand_range" {
        var d1 = tig_expr(call_arg(id, 0))
        if d1 < 0 {
            return -1
        }
        var d2 = tig_expr(call_arg(id, 1))
        if d2 < 0 {
            return -1
        }
        g_builtin_res = tig_rand_range(d1, d2)
        return 0
    }
    // table_at：表 + 下标 → 元素（与 t[i] 同语义；元素类型 fallback 判定）
    if nm == "table_at" {
        var tb = tig_expr(call_arg(id, 0))
        if tb < 0 {
            return -1
        }
        var ti = tig_expr(call_arg(id, 1))
        if ti < 0 {
            return -1
        }
        // 元素类型：语义节点类型（表实参的 node_types 可能是 TK_TABLE——元素类型
        // 按 var_table_elem 尽力推断，失败 fallback i64）
        var elem: i64 = types.named(TK_I64)
        var tn = call_arg(id, 0)
        if s_tags[tn] == 6 {
            var te = sinfer.var_table_elem(intern.intern(sstate.name_str(tn)))
            if te >= 0 {
                elem = te
            }
        }
        var suffix = bridge_suffix(elem)
        var ret_ty = types.named(TK_I64)
        var ek2 = types.kind(elem)
        if ek2 == K_STRUCT || ek2 == K_ENUM || ek2 == K_FN {
            // P2a 复合元素：返回类型 = 元素类型 id（多字元素类型化 load）
            ret_ty = elem
        } else if suffix == "string" {
            ret_ty = types.named(TK_STR)
        } else if suffix == "f64" {
            // f64 表元素：返回类型 double（曾落默认 i64 → `call i64 @tie_table_at_f64`
            // 与 declare 的 double 返回不匹配，opt 报类型错）
            ret_ty = types.named(TK_F64)
        } else if suffix == "bool" {
            ret_ty = types.named(TK_BOOL)
        }
        var ok_slot = ir.new_inst(g_cur_block, 20, types.named(TK_I8))  // alloca i8
        ir.add_operand(ok_slot, types.named(TK_I8), 2)
        var ok_addr = ir.get_value(ok_slot)
        g_builtin_res = s21_table_at(tb, ti, ok_addr, ret_ty)
        return 0
    }
    // ---------- trm-lite 轻量执行体原语（阶段1块2：spawn/yield/collect）----------
    if nm == "spawn" {
        // spawn(f) → i64 任务 id。f 为 fn() -> i64 / fn() -> void 闭包：提取
        // env(槽0)/entry(槽1)，调 trm_lite_sched$spawn_task 入队轻量执行体
        //（trm_lite.a 静态链接，用户无需 import）。返回任务 id。
        g_used_trmlite = true
        // 替代路径检测：当前模块已 import trm-lite（同名运行时函数已定义）→ 报错。
        // 内置与 import 是替代运行时路径，混用会导致 extern declare 与 define 冲突。
        if sstate.fn_def_node("trm_lite_sched::spawn_task") >= 0 {
            sm_err_msg = "spawn 内置与 import trm-lite 冲突：内置与 import 是替代运行时路径，不能混用（函数 " + g_cur_fn_name + "）"
            return -1
        }
        var fn_node = call_arg(id, 0)
        var fv = tig_expr(fn_node)
        if fv < 0 {
            return -1
        }
        var fty = node_types[fn_node]
        if fty < 0 || !types.is_fn(fty) {
            sm_err_msg = "spawn 参数必须是函数值（fn() -> i64 / fn() -> void），函数 " + g_cur_fn_name
            return -1
        }
        var fret = types.fn_ret_ty(fty)
        var rcode: i64 = 0
        if fret == types.named(TK_VOID) {
            rcode = 1
        } else if fret != types.named(TK_I64) {
            sm_err_msg = "spawn 暂只支持返回 i64/void 的闭包（当前 " + types.type_name(fret) + "），函数 " + g_cur_fn_name
            return -1
        }
        // f 落 alloca 聚合，提取 env（槽0）/ entry（槽1）
        var fa = ir.new_inst(g_cur_block, 20, fty)
        ir.add_operand(fa, fty, 2)
        var fap = ir.get_value(fa)
        var st0 = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(st0, fty, 2)
        ir.add_operand(st0, fv, 0)
        ir.add_operand(st0, fap, 0)
        var g0 = ir.new_inst(g_cur_block, 27, fty)  // agg_gep 0（env）
        ir.add_operand(g0, fap, 0)
        ir.add_operand(g0, 0, 2)
        var ld0 = ir.new_inst(g_cur_block, 21, types.named(TK_STR))
        ir.add_operand(ld0, ir.get_value(g0), 0)
        var env_v = ir.get_value(ld0)
        var g1 = ir.new_inst(g_cur_block, 27, fty)  // agg_gep 1（entry）
        ir.add_operand(g1, fap, 0)
        ir.add_operand(g1, 1, 2)
        var ld1 = ir.new_inst(g_cur_block, 21, types.named(TK_STR))
        ir.add_operand(ld1, ir.get_value(g1), 0)
        var entry_v = ir.get_value(ld1)
        // env/entry → i64（ptrtoint；trm-lite 队列以 i64 承载指针）
        var pe = ir.new_inst(g_cur_block, 24, types.named(TK_I64))
        ir.add_operand(pe, env_v, 0)
        var env_i = ir.get_value(pe)
        var pn = ir.new_inst(g_cur_block, 24, types.named(TK_I64))
        ir.add_operand(pn, entry_v, 0)
        var entry_i = ir.get_value(pn)
        var rc = tig_int_lit_ty(rcode, types.named(TK_I64))
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, types.named(TK_I64)); table_push(avs, entry_i)
        table_push(ats, types.named(TK_I64)); table_push(avs, env_i)
        table_push(ats, types.named(TK_I64)); table_push(avs, rc)
        g_builtin_res = tig_trmlite_call("trm_lite_sched$spawn_task", ats, avs, types.named(TK_I64))
        return 0
    }
    if nm == "yield" {
        // yield() → 协作式让出：排空 trm-lite 就绪任务队列（每个轻量执行体经
        // call_indirect 一次跑完；无栈迁移，任务体运行期不续跑）。返回哑值 0。
        // 与 actor 等待循环共用 tig_yield_drain。
        g_used_trmlite = true
        if sstate.fn_def_node("trm_lite_sched::queued_count") >= 0 {
            sm_err_msg = "yield 内置与 import trm-lite 冲突：内置与 import 是替代运行时路径，不能混用（函数 " + g_cur_fn_name + "）"
            return -1
        }
        tig_yield_drain()
        g_builtin_res = tig_int_lit(0)
        return 0
    }
    if nm == "collect" {
        // collect() → i64（本轮回收对象数）：调 trm_lite_gc$collect
        //（stop-the-world mark-sweep，trm_lite.a 静态链接）。
        g_used_trmlite = true
        if sstate.fn_def_node("trm_lite_gc::collect") >= 0 {
            sm_err_msg = "collect 内置与 import trm-lite 冲突：内置与 import 是替代运行时路径，不能混用（函数 " + g_cur_fn_name + "）"
            return -1
        }
        var T64 = types.named(TK_I64)
        g_builtin_res = tig_trmlite_call("trm_lite_gc$collect", tig_empty_types(), tig_empty_vals(), T64)
        return 0
    }
    return -1  // 非内置
}

    // ==================== 去 Rust 桥：to_string(f64) / parse_float（p.6.4.4） ====================
    // f64 → 十进制字符串，替代 Rust 桥 tie_to_string_f64。**避免 CRT snprintf/printf 式变参**：
    // Windows 的 clang 对**手写 IR 的 FP 变参调用**（snprintf(buf,32,"%.17g",double)）在 x64
    // 阴影区传参会错位（实测 double 落错误槽 → 格式化出 1e-322 垃圾），故改用**非变参** CRT
    // `char* _gcvt(double value, int digits, char *buffer)`：把 %g 风格数字直接写入给定缓冲
    //（17 位有效数字；科学计数阈值对齐 libc）。有限精度对齐 Rust 最短表示差异可接受
    //（3.14→"3.1400000000000001" 含 "3.14"、1e100→"1.e+100" 含 "e+100"、1.0→去尾点"1"）。
    // 签名 v:f64 → 带头字符串数据指针 {len头,数据,\0}。全直线式（无块图 → 无重编号风险）。
    func tig_f64_to_str(v: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var T8 = types.named(TK_I8)
        var I32 = types.named(TK_I32)
        var F64 = types.named(TK_F64)
        var P8 = types.ptr_of(T8)
        var cdot = tig_int_lit_ty(46, T64)
        var one64 = tig_int_lit_ty(1, T64)
        // 1. raw 缓冲 64B（K_PTR 返回绕 op36 对 TK_STR 的 strlen 扫描——漏洞 A 类隐患）
        var buf = s21_raw_alloc_str(tig_int_lit(64))
        // 2. _gcvt(v, 17, buf) → %g 风格写入 buf（返回 char* 忽略；非变参，参数直传正确）
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, F64); table_push(avs, v)
        table_push(ats, I32); table_push(avs, tig_int_lit_ty(17, I32))
        table_push(ats, types.named(TK_STR)); table_push(avs, buf)
        tig_ext_call_typed("_gcvt", ats, avs, P8)
        // 3. 长度 = strlen(buf)（_gcvt 输出 NUL 结尾）
        var len = tig_ext_call1("strlen", buf, types.named(TK_STR), T64)
        // 4. 去尾点：_gcvt 对整数给 "1." / "0." → 若末字节 '.' 则长度 -1（%g 亦如此）
        var lastp = s21_gep(buf, s21_bin(1, len, one64), false)  // buf + len - 1
        var lastb = s21_zext(s21_load(lastp, T8), T8)
        var isdot = tig_icmp_c(lastb, cdot, 0)  // eq '.'
        var len2 = tig_select_i(isdot, s21_bin(1, len, one64), len, T64)
        // 5. 构造带头串：SSO 分配 len2、写头、拷数据、尾 \0
        var out = s21_sso_alloc(len2)
        s21_store(s21_gep(out, 0, true), len2, T64)  // 长度头
        var d0 = s21_gep(out, 8, true)
        s21_memcpy_if(d0, buf, len2)
        s21_store(s21_gep(d0, len2, false), tig_int_lit_ty(0, T8), T8)  // 尾 \0
        var pi = ir.new_inst(g_cur_block, 24, T64)  // ptrtoint
        ir.add_operand(pi, d0, 0)
        var ip = ir.new_inst(g_cur_block, 25, types.named(TK_STR))  // inttoptr → ptr
        ir.add_operand(ip, ir.get_value(pi), 0)
        return ir.get_value(ip)
    }

    // 字符串 → f64，替代 Rust 桥 tie_parse_float。签名 s:string + ok 出参槽（caller
    // alloca i8 出参，语义与 tig_parse_int 一致：无效 → ok=0 返回 0.0）。
    // 有限精度实现：逐位十进制 i64 尾数累积 + libm pow(10.0, e) 缩放。尾数最多累计
    // 18 位（>18：整数段折叠计数计入指数 big_slot（×10），小数段丢弃——精度 <1e-18
    // 可忽略），不保证完全对齐 Rust str::parse 最短舍入，但覆盖常见 "3.14" / "-2.5e3" /
    // "0.5" / "1e10" 及绝大多数值。合法输入 [±]int[.frac][(e|E)[±]exp] 且整数或小数
    // 至少一位数字；其余（空串/仅符号/"1e"无指数数字等）→ fail。
    // 结果 = mant × 10^(exp_total)，exp_total = (±exp) - fracn + big。
    // 控制流：entry→sign→int 循环→dot→frac 循环→have→exp→(succ/fail)→exit。
    // 全部跨块状态落内存槽；结果 f64 落 rs_slot，exit 统一写 ok 槽返回。
    func tig_parse_float(s: i64, ok_ptr: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var T8 = types.named(TK_I8)
        var F64 = types.named(TK_F64)
        var z64 = tig_int_lit_ty(0, T64)
        var one = tig_int_lit_ty(1, T64)
        var ten = tig_int_lit_ty(10, T64)
        var c48 = tig_int_lit_ty(48, T64)
        var c57 = tig_int_lit_ty(57, T64)
        var cpl = tig_int_lit_ty(43, T64)   // '+'
        var cmi = tig_int_lit_ty(45, T64)   // '-'
        var cdot = tig_int_lit_ty(46, T64)  // '.'
        var ce2 = tig_int_lit_ty(101, T64)  // 'e'
        var cE2 = tig_int_lit_ty(69, T64)   // 'E'
        var CLIM = tig_int_lit_ty(100000000000000000, T64)  // 1e17 尾数累积上限
        var n = s21_str_head_len(s)
        // 状态槽（跨块内存）：i / neg / dig / digf / mant / fracn / exps /
        // expneg / expdig / big / et / ok / 结果 f64 rs
        var i_a = ir.new_inst(g_cur_block, 20, T64); ir.add_operand(i_a, T64, 2); var i_ptr = ir.get_value(i_a)
        var ng_a = ir.new_inst(g_cur_block, 20, T64); ir.add_operand(ng_a, T64, 2); var ng_ptr = ir.get_value(ng_a)
        var dg_a = ir.new_inst(g_cur_block, 20, T64); ir.add_operand(dg_a, T64, 2); var dg_ptr = ir.get_value(dg_a)
        var df_a = ir.new_inst(g_cur_block, 20, T64); ir.add_operand(df_a, T64, 2); var df_ptr = ir.get_value(df_a)
        var mnt_a = ir.new_inst(g_cur_block, 20, T64); ir.add_operand(mnt_a, T64, 2); var mnt_ptr = ir.get_value(mnt_a)
        var frc_a = ir.new_inst(g_cur_block, 20, T64); ir.add_operand(frc_a, T64, 2); var frc_ptr = ir.get_value(frc_a)
        var esp_a = ir.new_inst(g_cur_block, 20, T64); ir.add_operand(esp_a, T64, 2); var esp_ptr = ir.get_value(esp_a)
        var enp_a = ir.new_inst(g_cur_block, 20, T64); ir.add_operand(enp_a, T64, 2); var enp_ptr = ir.get_value(enp_a)
        var edg_a = ir.new_inst(g_cur_block, 20, T64); ir.add_operand(edg_a, T64, 2); var edg_ptr = ir.get_value(edg_a)
        var big_a = ir.new_inst(g_cur_block, 20, T64); ir.add_operand(big_a, T64, 2); var big_ptr = ir.get_value(big_a)
        var et_a = ir.new_inst(g_cur_block, 20, T64); ir.add_operand(et_a, T64, 2); var et_ptr = ir.get_value(et_a)
        var ok_a = ir.new_inst(g_cur_block, 20, T64); ir.add_operand(ok_a, T64, 2); var ok2_ptr = ir.get_value(ok_a)
        var rs_a = ir.new_inst(g_cur_block, 20, F64); ir.add_operand(rs_a, F64, 2); var rs_ptr = ir.get_value(rs_a)
        // 初始化
        s21_store(i_ptr, z64, T64)
        s21_store(ng_ptr, z64, T64)
        s21_store(dg_ptr, z64, T64)
        s21_store(df_ptr, z64, T64)
        s21_store(mnt_ptr, z64, T64)
        s21_store(frc_ptr, z64, T64)
        s21_store(esp_ptr, z64, T64)
        s21_store(enp_ptr, z64, T64)
        s21_store(edg_ptr, z64, T64)
        s21_store(big_ptr, z64, T64)
        s21_store(et_ptr, z64, T64)
        s21_store(ok2_ptr, z64, T64)
        s21_store(rs_ptr, tig_float_lit(interner.intern("0.0")), F64)
        // 块
        var sign_blk = ir.new_block(g_cur_func, interner.intern("pf.sign"))
        var ic_blk = ir.new_block(g_cur_func, interner.intern("pf.ic"))
        var ib_blk = ir.new_block(g_cur_func, interner.intern("pf.ib"))
        var iv_blk = ir.new_block(g_cur_func, interner.intern("pf.iv"))
        var ia_blk = ir.new_block(g_cur_func, interner.intern("pf.ia"))
        var ibig_blk = ir.new_block(g_cur_func, interner.intern("pf.ig"))
        var is_blk = ir.new_block(g_cur_func, interner.intern("pf.is"))
        var dot_t = ir.new_block(g_cur_func, interner.intern("pf.dt"))
        var dot_c = ir.new_block(g_cur_func, interner.intern("pf.dc"))
        var dc_blk = ir.new_block(g_cur_func, interner.intern("pf.dd"))
        var fc_blk = ir.new_block(g_cur_func, interner.intern("pf.fc"))
        var fb_blk = ir.new_block(g_cur_func, interner.intern("pf.fb"))
        var fv_blk = ir.new_block(g_cur_func, interner.intern("pf.fv"))
        var fa_blk = ir.new_block(g_cur_func, interner.intern("pf.fa"))
        var fsk_blk = ir.new_block(g_cur_func, interner.intern("pf.fk"))
        var fs_blk = ir.new_block(g_cur_func, interner.intern("pf.fs"))
        var hv_blk = ir.new_block(g_cur_func, interner.intern("pf.hv"))
        var esc_blk = ir.new_block(g_cur_func, interner.intern("pf.e"))
        var ec_blk = ir.new_block(g_cur_func, interner.intern("pf.ec"))
        var esg_blk = ir.new_block(g_cur_func, interner.intern("pf.es"))
        var esb_blk = ir.new_block(g_cur_func, interner.intern("pf.esb"))
        var ebc_blk = ir.new_block(g_cur_func, interner.intern("pf.eb"))
        var ebd_blk = ir.new_block(g_cur_func, interner.intern("pf.ed"))
        var eac_blk = ir.new_block(g_cur_func, interner.intern("pf.ea"))
        var eend_blk = ir.new_block(g_cur_func, interner.intern("pf.ee"))
        var eff_blk = ir.new_block(g_cur_func, interner.intern("pf.ef"))
        var okb_blk = ir.new_block(g_cur_func, interner.intern("pf.ok"))
        var use_blk = ir.new_block(g_cur_func, interner.intern("pf.use"))
        var pow_blk = ir.new_block(g_cur_func, interner.intern("pf.pow"))
        var ngb_blk = ir.new_block(g_cur_func, interner.intern("pf.ngb"))
        var ngy_blk = ir.new_block(g_cur_func, interner.intern("pf.ngy"))
        var fin_blk = ir.new_block(g_cur_func, interner.intern("pf.fin"))
        var fail_blk = ir.new_block(g_cur_func, interner.intern("pf.fail"))
        var exit_blk = ir.new_block(g_cur_func, interner.intern("pf.exit"))
        // entry：n==0 → fail；否则 sign
        var c_empty = tig_icmp_c(n, z64, 0)
        var cb0 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb0, c_empty, 0)
        ir.add_operand(cb0, fail_blk, 1)
        ir.add_operand(cb0, sign_blk, 1)
        // sign：i = has_sign?1:0；neg = is_minus；→ ic
        g_cur_block = sign_blk
        var b0 = s21_str_byte(s, z64)
        var is_plus = tig_icmp_c(b0, cpl, 0)
        var is_minus = tig_icmp_c(b0, cmi, 0)
        var has_sign = tig_or_i1(is_plus, is_minus)
        s21_store(i_ptr, tig_select_i(has_sign, one, z64, T64), T64)
        s21_store(ng_ptr, tig_select_i(is_minus, one, z64, T64), T64)
        var bsign = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bsign, ic_blk, 1)
        // ic：i<n → ib；否则 dot_t
        g_cur_block = ic_blk
        var c_i1 = tig_icmp_c(s21_load(i_ptr, T64), n, 6)  // ult
        var cb1 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb1, c_i1, 0)
        ir.add_operand(cb1, ib_blk, 1)
        ir.add_operand(cb1, dot_t, 1)
        // ib：字节数字？→ iv；否则 dot_t
        g_cur_block = ib_blk
        var bv2 = s21_str_byte(s, s21_load(i_ptr, T64))
        var isd2 = tig_and_i1(tig_icmp_c(bv2, c48, 5), tig_icmp_c(bv2, c57, 4))
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, isd2, 0)
        ir.add_operand(cb2, iv_blk, 1)
        ir.add_operand(cb2, dot_t, 1)
        // iv：dig=1；mant<CLIM → ia（累积）else ibig（折计入指数）
        g_cur_block = iv_blk
        s21_store(dg_ptr, one, T64)
        var mlt3 = tig_icmp_c(s21_load(mnt_ptr, T64), CLIM, 2)  // slt
        var cb3 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb3, mlt3, 0)
        ir.add_operand(cb3, ia_blk, 1)
        ir.add_operand(cb3, ibig_blk, 1)
        // ia：mant = mant*10 + (b-48)；→ is
        g_cur_block = ia_blk
        var bv4 = s21_str_byte(s, s21_load(i_ptr, T64))  // 先 load 再来 new_inst（防操作数段交错）
        var cm4 = s21_load(mnt_ptr, T64)
        var m4 = ir.new_inst(g_cur_block, 2, T64)  // mul
        ir.add_operand(m4, cm4, 0)
        ir.add_operand(m4, ten, 0)
        var d4 = s21_bin(1, bv4, c48)                       // sub b-48
        var nm4 = s21_bin(0, ir.get_value(m4), d4)          // add
        s21_store(mnt_ptr, nm4, T64)
        var bia = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bia, is_blk, 1)
        // ibig：big = big+1；→ is
        g_cur_block = ibig_blk
        s21_store(big_ptr, s21_bin(0, s21_load(big_ptr, T64), one), T64)
        var bib = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bib, is_blk, 1)
        // is：i = i+1；→ ic
        g_cur_block = is_blk
        s21_store(i_ptr, s21_bin(0, s21_load(i_ptr, T64), one), T64)
        var bis = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bis, ic_blk, 1)
        // dot_t：i<n → dot_c（复核 '.')；否则 hv
        g_cur_block = dot_t
        var c_i5 = tig_icmp_c(s21_load(i_ptr, T64), n, 6)
        var cb5 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb5, c_i5, 0)
        ir.add_operand(cb5, dot_c, 1)
        ir.add_operand(cb5, hv_blk, 1)
        // dot_c：byte=='.' → dc（消费）else hv
        g_cur_block = dot_c
        var bv5 = s21_str_byte(s, s21_load(i_ptr, T64))
        var isdot = tig_icmp_c(bv5, cdot, 0)
        var cb5b = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb5b, isdot, 0)
        ir.add_operand(cb5b, dc_blk, 1)
        ir.add_operand(cb5b, hv_blk, 1)
        // dc：i = i+1；→ fc
        g_cur_block = dc_blk
        s21_store(i_ptr, s21_bin(0, s21_load(i_ptr, T64), one), T64)
        var bdc = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bdc, fc_blk, 1)
        // fc：i<n → fb；否则 hv
        g_cur_block = fc_blk
        var c_i6 = tig_icmp_c(s21_load(i_ptr, T64), n, 6)
        var cb6 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb6, c_i6, 0)
        ir.add_operand(cb6, fb_blk, 1)
        ir.add_operand(cb6, hv_blk, 1)
        // fb：字节数字？→ fv；否则 hv
        g_cur_block = fb_blk
        var bv6 = s21_str_byte(s, s21_load(i_ptr, T64))
        var isd6 = tig_and_i1(tig_icmp_c(bv6, c48, 5), tig_icmp_c(bv6, c57, 4))
        var cb7 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb7, isd6, 0)
        ir.add_operand(cb7, fv_blk, 1)
        ir.add_operand(cb7, hv_blk, 1)
        // fv：mant<CLIM → fa（累积）else fsk（丢弃小数位）
        g_cur_block = fv_blk
        var mlt7 = tig_icmp_c(s21_load(mnt_ptr, T64), CLIM, 2)
        var cb8 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb8, mlt7, 0)
        ir.add_operand(cb8, fa_blk, 1)
        ir.add_operand(cb8, fsk_blk, 1)
        // fa：mant=mant*10+d；fracn++；digf=1；→ fs
        g_cur_block = fa_blk
        var bv7 = s21_str_byte(s, s21_load(i_ptr, T64))
        var cm7 = s21_load(mnt_ptr, T64)
        var m7 = ir.new_inst(g_cur_block, 2, T64)  // mul
        ir.add_operand(m7, cm7, 0)
        ir.add_operand(m7, ten, 0)
        var d7 = s21_bin(1, bv7, c48)
        var nm7 = s21_bin(0, ir.get_value(m7), d7)
        s21_store(mnt_ptr, nm7, T64)
        s21_store(frc_ptr, s21_bin(0, s21_load(frc_ptr, T64), one), T64)
        s21_store(df_ptr, one, T64)
        var bfa = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bfa, fs_blk, 1)
        // fsk：digf=1（有效但超 18 位丢弃）；→ fs
        g_cur_block = fsk_blk
        s21_store(df_ptr, one, T64)
        var bfk = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bfk, fs_blk, 1)
        // fs：i = i+1；→ fc
        g_cur_block = fs_blk
        s21_store(i_ptr, s21_bin(0, s21_load(i_ptr, T64), one), T64)
        var bfs = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bfs, fc_blk, 1)
        // hv：dig||digf → esc；否则 fail
        g_cur_block = hv_blk
        var hasd = tig_or_i1(tig_icmp_c(s21_load(dg_ptr, T64), z64, 1), tig_icmp_c(s21_load(df_ptr, T64), z64, 1))
        var cbh = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cbh, hasd, 0)
        ir.add_operand(cbh, esc_blk, 1)
        ir.add_operand(cbh, fail_blk, 1)
        // esc：i<n 且 byte==e/E → ec；否则 eff（无指数）
        g_cur_block = esc_blk
        var c_i8 = tig_icmp_c(s21_load(i_ptr, T64), n, 6)
        var ebd_t8 = ir.new_block(g_cur_func, interner.intern("pf.escan"))
        var cb9 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb9, c_i8, 0)
        ir.add_operand(cb9, ebd_t8, 1)
        ir.add_operand(cb9, eff_blk, 1)
        // esd：byte==e||E → ec else eff
        g_cur_block = ebd_t8
        var bv8 = s21_str_byte(s, s21_load(i_ptr, T64))
        var ise = tig_or_i1(tig_icmp_c(bv8, ce2, 0), tig_icmp_c(bv8, cE2, 0))
        var cb9b = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb9b, ise, 0)
        ir.add_operand(cb9b, ec_blk, 1)
        ir.add_operand(cb9b, eff_blk, 1)
        // ec：i = i+1（消费 e/E）；→ esg
        g_cur_block = ec_blk
        s21_store(i_ptr, s21_bin(0, s21_load(i_ptr, T64), one), T64)
        var bec = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bec, esg_blk, 1)
        // esg：i<n → esb；否则 fail（裸 "1e"）
        g_cur_block = esg_blk
        var c_ie = tig_icmp_c(s21_load(i_ptr, T64), n, 6)
        var cbe = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cbe, c_ie, 0)
        ir.add_operand(cbe, esb_blk, 1)
        ir.add_operand(cbe, fail_blk, 1)
        // esb：可选 +/-：expneg=is_minus；若有符号 i++；→ ebc
        g_cur_block = esb_blk
        var bv9 = s21_str_byte(s, s21_load(i_ptr, T64))
        var e_plus = tig_icmp_c(bv9, cpl, 0)
        var e_minus = tig_icmp_c(bv9, cmi, 0)
        var e_sign = tig_or_i1(e_plus, e_minus)
        s21_store(enp_ptr, tig_select_i(e_minus, one, z64, T64), T64)
        var i_adj = tig_select_i(e_sign, one, z64, T64)
        s21_store(i_ptr, s21_bin(0, s21_load(i_ptr, T64), i_adj), T64)
        var besb = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(besb, ebc_blk, 1)
        // ebc：i<n → ebd；否则 eend
        g_cur_block = ebc_blk
        var c_ie2 = tig_icmp_c(s21_load(i_ptr, T64), n, 6)
        var cbe2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cbe2, c_ie2, 0)
        ir.add_operand(cbe2, ebd_blk, 1)
        ir.add_operand(cbe2, eend_blk, 1)
        // ebd：字节数字？→ eac；否则 eend
        g_cur_block = ebd_blk
        var bve = s21_str_byte(s, s21_load(i_ptr, T64))
        var isd_e = tig_and_i1(tig_icmp_c(bve, c48, 5), tig_icmp_c(bve, c57, 4))
        var cbde = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cbde, isd_e, 0)
        ir.add_operand(cbde, eac_blk, 1)
        ir.add_operand(cbde, eend_blk, 1)
        // eac：exps=exps*10+d；expdig=1；i++；→ ebc
        g_cur_block = eac_blk
        var bve2 = s21_str_byte(s, s21_load(i_ptr, T64))
        var cme = s21_load(esp_ptr, T64)
        var me = ir.new_inst(g_cur_block, 2, T64)  // mul
        ir.add_operand(me, cme, 0)
        ir.add_operand(me, ten, 0)
        var de = s21_bin(1, bve2, c48)
        var nme = s21_bin(0, ir.get_value(me), de)
        s21_store(esp_ptr, nme, T64)
        s21_store(edg_ptr, one, T64)
        s21_store(i_ptr, s21_bin(0, s21_load(i_ptr, T64), one), T64)
        var beac = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(beac, ebc_blk, 1)
        // eend：expdig!=0 → eff（指数有效）；否则 fail（"1e"/"1e+" 无数字）
        g_cur_block = eend_blk
        var ed_c = tig_icmp_c(s21_load(edg_ptr, T64), z64, 1)  // ne
        var cbed = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cbed, ed_c, 0)
        ir.add_operand(cbed, eff_blk, 1)
        ir.add_operand(cbed, fail_blk, 1)
        // eff：exptot = (±exps) - fracn + big；→ okb
        g_cur_block = eff_blk
        var esv = s21_load(esp_ptr, T64)
        var enpv = s21_load(enp_ptr, T64)
        var is_en = tig_icmp_c(enpv, z64, 1)  // ne
        var esub = ir.new_inst(g_cur_block, 1, T64)  // sub 0 - esv
        ir.add_operand(esub, z64, 0)
        ir.add_operand(esub, esv, 0)
        var ev = tig_select_i(is_en, ir.get_value(esub), esv, T64)
        var t1 = s21_bin(1, ev, s21_load(frc_ptr, T64))           // ev - fracn
        var etot = s21_bin(0, t1, s21_load(big_ptr, T64))         // + big
        s21_store(et_ptr, etot, T64)
        var beff = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(beff, okb_blk, 1)
        // okb：ok=1；fmant = sitofp(mant)；et==0 → use else pow
        g_cur_block = okb_blk
        s21_store(ok2_ptr, one, T64)
        var fmant = tig_to_f64(s21_load(mnt_ptr, T64), T64)
        var ezero = tig_icmp_c(s21_load(et_ptr, T64), z64, 0)  // eq
        var cbok = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cbok, ezero, 0)
        ir.add_operand(cbok, use_blk, 1)
        ir.add_operand(cbok, pow_blk, 1)
        // use：rs = fmant；→ ngb
        g_cur_block = use_blk
        s21_store(rs_ptr, fmant, F64)
        var buse = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(buse, ngb_blk, 1)
        // pow：eF = sitofp(et)；p = pow(10.0, eF)；rs = fmant * p；→ ngb
        g_cur_block = pow_blk
        var eF = tig_to_f64(s21_load(et_ptr, T64), T64)
        var p = tig_ext_call2("pow", tig_float_lit(interner.intern("10.0")), F64, eF, F64, F64)
        var fm = ir.new_inst(g_cur_block, 15, F64)  // fmul
        ir.add_operand(fm, fmant, 0)
        ir.add_operand(fm, p, 0)
        s21_store(rs_ptr, ir.get_value(fm), F64)
        var bpow = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bpow, ngb_blk, 1)
        // ngb：neg!=0 → ngy else fin
        g_cur_block = ngb_blk
        var is_neg = tig_icmp_c(s21_load(ng_ptr, T64), z64, 1)  // ne
        var cbng = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cbng, is_neg, 0)
        ir.add_operand(cbng, ngy_blk, 1)
        ir.add_operand(cbng, fin_blk, 1)
        // ngy：rs = 0.0 - rs；→ fin
        g_cur_block = ngy_blk
        var fzero = tig_float_lit(interner.intern("0.0"))  // 先建常量再建 fsub（防操作数段交错）
        var rcv = s21_load(rs_ptr, F64)
        var fs2 = ir.new_inst(g_cur_block, 14, F64)  // fsub
        ir.add_operand(fs2, fzero, 0)
        ir.add_operand(fs2, rcv, 0)
        s21_store(rs_ptr, ir.get_value(fs2), F64)
        var bng = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bng, fin_blk, 1)
        // fin：→ exit
        g_cur_block = fin_blk
        var bfin = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bfin, exit_blk, 1)
        // fail：ok 保持 0，rs 保持 0.0；→ exit
        g_cur_block = fail_blk
        var bfail = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bfail, exit_blk, 1)
        // exit：写外部 ok 槽（trunc i8）；返回 rs（f64）
        g_cur_block = exit_blk
        var okv = s21_load(ok2_ptr, T64)
        s21_store(ok_ptr, s21_trunc_i8(okv), T8)
        return s21_load(rs_ptr, F64)
    }
    // 背景：byte_read/byte_write/byte_concat/bit_read/bit_write 原以 tie_interp Rust
    // 桥实现（tie_byte_*）。Rust 桥对**原生 32 字节表句柄**（s21 表布局
    // {cap,len,data,esz}）的 ABI 约定不匹配，运行即 0xC0000005 崩溃（与 871d65f
    // alloc 补头扫描同族）。此处改为 tie 内联 IR 全量重写，**零 Rust 依赖、跨
    // Unix/Windows**（文件 IO 走 libc fopen/fread/fwrite/fseek/ftell/fclose，CRT
    // 提供，无需任何系统头/链接库；路径 = tie 串数据指针 UTF-8 char*，Windows 下
    // libc fopen 按 ANSI 代码页解释 → 中文路径受限，与旧 fopen 立场一致）。
    // 表操作走原生句柄 + malloc/memcpy；位操作纯指令（shr/and/shl/or/xor）零依赖。

    // i1 取反（xor i1 v, true；位越界判定组合用）
    func tig_not_i1(v: i64) -> i64 {
        var one = tig_bool_lit(1)
        var x = ir.new_inst(g_cur_block, 8, types.named(TK_BOOL))  // xor
        ir.add_operand(x, v, 0)
        ir.add_operand(x, one, 0)
        return ir.get_value(x)
    }

    // 构件模式串（两字符，如 "rb"/"wb"）：sso 池分配块 {头, 数据, \0}，返回数据指针
    func tig_bt_mode2(c0: i64, c1: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I8 = types.named(TK_I8)
        var n = tig_int_lit(2)
        var mbuf = s21_sso_alloc(n)
        s21_store(s21_gep(mbuf, 0, true), n, T64)  // 长度头 = 2
        var md = s21_gep(mbuf, 8, true)
        s21_store(s21_gep(md, 0, true), tig_int_lit_ty(c0, I8), I8)
        s21_store(s21_gep(md, 1, true), tig_int_lit_ty(c1, I8), I8)
        s21_store(s21_gep(md, 2, true), tig_int_lit_ty(0, I8), I8)  // 尾 \0
        return md
    }

    // 失败输出：printf(fmt, path) + exit(1)（对齐 tig_panic 的 call_vararg 范式；
    // fmt 为字符串池 id，llvmgen collect_strings 会收集 op41 操作数 0）
    func tig_bt_fail(p: i64, fmt: i64) {
        var inst = ir.new_inst(g_cur_block, 41, types.named(TK_I32))  // call_vararg
        ir.add_operand(inst, fmt, 0)
        ir.add_operand(inst, p, 0)
        var one = tig_int_lit_ty(1, types.named(TK_I64))
        tig_ext_call1("exit", one, types.named(TK_I64), -1)
    }

    // libc 包装：fseek（返回值忽略，FILE* 以 ptr<i8> 类型传参）
    func tig_bt_fseek(f: i64, off: i64, whence: i64) {
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, types.ptr_of(types.named(TK_I8)))
        table_push(avs, f)
        table_push(ats, types.named(TK_I64))
        table_push(avs, off)
        table_push(ats, types.named(TK_I32))
        table_push(avs, whence)
        tig_ext_call_typed("fseek", ats, avs, types.named(TK_I32))
    }

    // fread(buf, n, f)：size=1, count=n；返回实际读到的元素数
    func tig_bt_fread(buf: i64, n: i64, f: i64) -> i64 {
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, types.ptr_of(types.named(TK_I8)))
        table_push(avs, buf)
        table_push(ats, types.named(TK_I64))
        table_push(avs, tig_int_lit(1))
        table_push(ats, types.named(TK_I64))
        table_push(avs, n)
        table_push(ats, types.ptr_of(types.named(TK_I8)))
        table_push(avs, f)
        return tig_ext_call_typed("fread", ats, avs, types.named(TK_I64))
    }

    // fwrite(buf, n, f)：size=1, count=n；返回实际写出的元素数
    func tig_bt_fwrite(buf: i64, n: i64, f: i64) -> i64 {
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, types.ptr_of(types.named(TK_I8)))
        table_push(avs, buf)
        table_push(ats, types.named(TK_I64))
        table_push(avs, tig_int_lit(1))
        table_push(ats, types.named(TK_I64))
        table_push(avs, n)
        table_push(ats, types.ptr_of(types.named(TK_I8)))
        table_push(avs, f)
        return tig_ext_call_typed("fwrite", ats, avs, types.named(TK_I64))
    }

    // fclose(f)：FILE* 关闭（返回值忽略）
    func tig_bt_fclose(f: i64) {
        tig_ext_call1("fclose", f, types.ptr_of(types.named(TK_I8)), types.named(TK_I32))
    }

    // byte_read(path)：读文件全部字节 → i64 字节表（元素 0..255；空文件 → 空表）。
    // 流程：fopen "rb" → fseek END → ftell 长度 → fseek SET → fread 全量到 u8 临时
    // 缓冲 → 逐字节零扩展为 i64 元素 → 组装 32 字节表句柄 {cap,len,data,esz}。
    // 失败（打不开 / 读不全，如目录路径）→ 打印路径并 exit(1)，保持 std/bytes
    // 文档语义「byte_read 失败由编译器运行时报错退出」。
    func tig_byte_read(p: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I8 = types.named(TK_I8)
        var P8 = types.ptr_of(I8)
        var f = tig_ext_call2("fopen", p, types.named(TK_STR),
            tig_bt_mode2(114, 98), types.named(TK_STR), P8)  // "rb"
        var ok = tig_cmp_zero(f, 1)  // f != null
        // 结果槽（表句柄 ptr 值；失败分支不可达，槽未初始化可接受）
        var slot = ir.new_inst(g_cur_block, 20, types.named(TK_STR))
        ir.add_operand(slot, types.named(TK_STR), 2)
        var sv = ir.get_value(slot)
        var bt = ir.new_block(g_cur_func, interner.intern("bt.r.ok"))
        var fl = ir.new_block(g_cur_func, interner.intern("bt.r.f"))
        var mg = ir.new_block(g_cur_func, interner.intern("bt.r.m"))
        var cb = ir.new_inst(g_cur_block, 31, -1)  // cond_br ok → bt / fl
        ir.add_operand(cb, ok, 0)
        ir.add_operand(cb, bt, 1)
        ir.add_operand(cb, fl, 1)
        // 失败：printf + exit(1) + 死 br（对齐 tig_panic 的双分支范式）
        g_cur_block = fl
        tig_bt_fail(p, interner.intern("byte_read: 打开/读取文件失败: %s\n"))
        var brf = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brf, mg, 1)
        // 成功：定位长度 → 全量读入 u8 临时缓冲
        g_cur_block = bt
        var z64 = tig_int_lit_ty(0, T64)
        var i32t = types.named(TK_I32)
        tig_bt_fseek(f, z64, tig_int_lit_ty(2, i32t))  // SEEK_END
        var size = tig_ext_call1("ftell", f, P8, T64)
        tig_bt_fseek(f, z64, tig_int_lit_ty(0, i32t))  // SEEK_SET
        var tmp = s21_raw_alloc_str(size)
        var cnt = tig_bt_fread(tmp, size, f)
        // 读不全 → 仍按失败处理（死 br 承接；实际 exit 不返回）
        var full = tig_icmp_c(cnt, size, 0)  // cnt == size
        var bt2 = ir.new_block(g_cur_func, interner.intern("bt.r.c"))
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, full, 0)
        ir.add_operand(cb2, bt2, 1)
        ir.add_operand(cb2, fl, 1)
        // 转换：u8 临时缓冲逐字节零扩展 → i64 元素缓冲 tb[i*8]。
        // 注意：不能写 `while k < size`（k/size 是 IR 值 id，编译期数值比较无
        // 意义，循环体不会生成）——必须手排 运行时循环（k 存槽 + cond_br 回边）。
        g_cur_block = bt2
        var e8 = tig_int_lit(8)
        var tb = s21_raw_alloc_str(s21_bin(2, size, e8))
        var kslot = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(kslot, T64, 2)
        var ksv = ir.get_value(kslot)  // 槽值 id（不能直接用 inst id，否则 def/use 编号错位）
        s21_store(ksv, tig_int_lit(0), T64)  // k = 0（槽初始）
        var hd = ir.new_block(g_cur_func, interner.intern("bt.r.h"))
        var bd = ir.new_block(g_cur_func, interner.intern("bt.r.lb"))
        var ex = ir.new_block(g_cur_func, interner.intern("bt.r.le"))
        var brh = ir.new_inst(g_cur_block, 30, -1)  // br hd
        ir.add_operand(brh, hd, 1)
        g_cur_block = hd
        var kc = tig_icmp_c(s21_load(ksv, T64), size, 2)  // k < size（运行时）
        var cbl = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cbl, kc, 0)
        ir.add_operand(cbl, bd, 1)
        ir.add_operand(cbl, ex, 1)
        g_cur_block = bd
        var kv = s21_load(ksv, T64)
        var bv = s21_load(s21_gep(tmp, kv, false), I8)
        var ev = s21_zext(bv, I8)
        s21_store(s21_gep(tb, s21_bin(2, kv, e8), false), ev, T64)
        s21_store(ksv, s21_bin(0, kv, tig_int_lit(1)), T64)  // k++
        var brb = ir.new_inst(g_cur_block, 30, -1)  // 回边 br hd
        ir.add_operand(brb, hd, 1)
        g_cur_block = ex
        tig_bt_fclose(f)
        tig_ext_call1("free", tmp, types.named(TK_STR), -1)
        var h = s21_raw_alloc_str(tig_int_lit(32))
        s21_store(s21_gep(h, 0, true), size, T64)    // cap
        s21_store(s21_gep(h, 8, true), size, T64)    // len
        s21_store(s21_gep(h, 16, true), tb, types.named(TK_STR))  // data
        s21_store(s21_gep(h, 24, true), e8, T64)     // esz = 8
        s21_store(sv, h, types.named(TK_STR))
        var brm = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brm, mg, 1)
        g_cur_block = mg
        return s21_load(sv, types.named(TK_STR))
    }

    // byte_write(path, t)：字节表覆盖写文件（"wb"）。成功 true / 失败 false。
    // 数据缓冲元素为 i64（0..255），逐元素截取低字节（& 0xFF）转 u8 缓冲再整块
    // fwrite——写出的正是 len 个字节，与 byte_read 读回往返一致（元素高字节不落盘）。
    func tig_byte_write(p: i64, t: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I8 = types.named(TK_I8)
        var P8 = types.ptr_of(I8)
        var len = s21_load(s21_gep(t, 8, true), T64)
        var data = t21_data(t)
        var esz = t21_esz(t)
        // i64 元素 → u8 连续缓冲（低字节 & 0xFF 截断）。运行时循环（槽 + 回边），
        // 不能写 `while k < len`（k/len 是 IR 值 id，编译期比较无意义，见 byte_read）
        var nbuf = s21_raw_alloc_str(len)
        var kslot = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(kslot, T64, 2)
        var ksv = ir.get_value(kslot)  // 槽值 id（不能用 inst id）
        s21_store(ksv, tig_int_lit(0), T64)  // k = 0
        var hd = ir.new_block(g_cur_func, interner.intern("bt.w.h"))
        var bd = ir.new_block(g_cur_func, interner.intern("bt.w.lb"))
        var ex = ir.new_block(g_cur_func, interner.intern("bt.w.le"))
        var brh = ir.new_inst(g_cur_block, 30, -1)  // br hd
        ir.add_operand(brh, hd, 1)
        g_cur_block = hd
        var kc = tig_icmp_c(s21_load(ksv, T64), len, 2)  // k < len
        var cbl = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cbl, kc, 0)
        ir.add_operand(cbl, bd, 1)
        ir.add_operand(cbl, ex, 1)
        g_cur_block = bd
        var kv = s21_load(ksv, T64)
        var el = s21_load(s21_gep(data, s21_bin(2, kv, esz), false), T64)
        var lo = s21_bin(6, el, tig_int_lit(255))  // & 0xFF（and）
        s21_store(s21_gep(nbuf, kv, false), s21_trunc_i8(lo), I8)
        s21_store(ksv, s21_bin(0, kv, tig_int_lit(1)), T64)  // k++
        var brb = ir.new_inst(g_cur_block, 30, -1)  // 回边
        ir.add_operand(brb, hd, 1)
        g_cur_block = ex
        var f = tig_ext_call2("fopen", p, types.named(TK_STR),
            tig_bt_mode2(119, 98), types.named(TK_STR), P8)  // "wb"
        var okf = tig_cmp_zero(f, 1)  // f != null
        // 布尔结果槽（i8 0/1）
        var slot = ir.new_inst(g_cur_block, 20, I8)
        ir.add_operand(slot, I8, 2)
        var sv = ir.get_value(slot)
        var wb = ir.new_block(g_cur_func, interner.intern("bt.w.b"))
        var wf = ir.new_block(g_cur_func, interner.intern("bt.w.f"))
        var wm = ir.new_block(g_cur_func, interner.intern("bt.w.m"))
        var cw = ir.new_inst(g_cur_block, 31, -1)  // cond_br okf → wb / wf
        ir.add_operand(cw, okf, 0)
        ir.add_operand(cw, wb, 1)
        ir.add_operand(cw, wf, 1)
        // 写路径：fwrite 全量（空表 len=0 → 计数 0==0 → true）+ fclose
        g_cur_block = wb
        var cnt = tig_bt_fwrite(nbuf, len, f)
        var okw = tig_icmp_c(cnt, len, 0)  // 写满 == len
        s21_store(sv, s21_trunc_i8(s21_zext(okw, types.named(TK_BOOL))), I8)
        tig_bt_fclose(f)
        tig_ext_call1("free", nbuf, types.named(TK_STR), -1)
        var brwp = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brwp, wm, 1)
        // 失败：fopen 失败 → false
        g_cur_block = wf
        s21_store(sv, tig_int_lit_ty(0, I8), I8)
        tig_ext_call1("free", nbuf, types.named(TK_STR), -1)
        var brwf = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brwf, wm, 1)
        g_cur_block = wm
        var r8 = s21_load(sv, I8)
        return tig_cmp_zero(r8, 1)  // ne 0 → bool
    }

    // bit_read(t, pos)：LSB 序（第 pos 位 = 第 pos/8 字节第 pos%8 位）→ 0/1。
    // 越界（pos<0 或 pos/8 ≥ 表长）→ 0（std/bytes 文档语义；避免越界加载）。
    func tig_bit_read(t: i64, pos: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var len = s21_load(s21_gep(t, 8, true), T64)
        var e8 = tig_int_lit(8)
        var bidx = s21_bin(3, pos, e8)  // sdiv pos/8
        var pneg = tig_icmp_c(pos, tig_int_lit(0), 2)  // pos < 0
        var bidx_u = tig_icmp_c(bidx, len, 6)          // bidx ult len（unsigned 负防漏）
        var valid = tig_and_i1(tig_not_i1(pneg), bidx_u)
        // 结果槽（i64）
        var slot = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(slot, T64, 2)
        var sv = ir.get_value(slot)
        var bt = ir.new_block(g_cur_func, interner.intern("bt.b.ok"))
        var be = ir.new_block(g_cur_func, interner.intern("bt.b.oob"))
        var mg = ir.new_block(g_cur_func, interner.intern("bt.b.m"))
        var cb = ir.new_inst(g_cur_block, 31, -1)  // cond_br valid → bt / be
        ir.add_operand(cb, valid, 0)
        ir.add_operand(cb, bt, 1)
        ir.add_operand(cb, be, 1)
        // 越界 → 0（不加载）
        g_cur_block = be
        s21_store(sv, tig_int_lit(0), T64)
        var br2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br2, mg, 1)
        // 命中：elt >> (pos%8) & 1（elt 0..255，ashr/lshr 等价）
        g_cur_block = bt
        var elt = s21_load(s21_gep(t21_data(t), s21_bin(2, bidx, e8), false), T64)
        var bitn = s21_bin(4, pos, e8)  // srem pos%8
        var sh = ir.new_inst(g_cur_block, 11, T64)  // shr
        ir.add_operand(sh, elt, 0)
        ir.add_operand(sh, bitn, 0)
        var bv = s21_bin(6, ir.get_value(sh), tig_int_lit(1))  // & 1
        s21_store(sv, bv, T64)
        var br1 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br1, mg, 1)
        g_cur_block = mg
        return s21_load(sv, T64)
    }

    // bit_write(t, pos, bit)：写第 pos 位为 bit（0/1），就地改表；成功 true，
    // 越界（pos<0 或 pos/8 ≥ 表长）返回 false 且不改表。
    // 位改写：mask = 1 << bitn；newv = (elt & ~mask) | ((bit & 1) << bitn)。
    func tig_bit_write(t: i64, pos: i64, bit: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I8 = types.named(TK_I8)
        var len = s21_load(s21_gep(t, 8, true), T64)
        var e8 = tig_int_lit(8)
        var bidx = s21_bin(3, pos, e8)
        var pneg = tig_icmp_c(pos, tig_int_lit(0), 2)
        var bidx_u = tig_icmp_c(bidx, len, 6)
        var valid = tig_and_i1(tig_not_i1(pneg), bidx_u)
        // 布尔结果槽（i8 0/1）
        var slot = ir.new_inst(g_cur_block, 20, I8)
        ir.add_operand(slot, I8, 2)
        var sv = ir.get_value(slot)
        var bt = ir.new_block(g_cur_func, interner.intern("bt.w2.ok"))
        var be = ir.new_block(g_cur_func, interner.intern("bt.w2.oob"))
        var mg = ir.new_block(g_cur_func, interner.intern("bt.w2.m"))
        var cb = ir.new_inst(g_cur_block, 31, -1)  // cond_br valid → bt / be
        ir.add_operand(cb, valid, 0)
        ir.add_operand(cb, bt, 1)
        ir.add_operand(cb, be, 1)
        // 越界 → false（不改表）
        g_cur_block = be
        s21_store(sv, tig_int_lit_ty(0, I8), I8)
        var br2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br2, mg, 1)
        // 命中：读改写位
        g_cur_block = bt
        var od = s21_gep(t21_data(t), s21_bin(2, bidx, e8), false)
        var elt = s21_load(od, T64)
        var bitn = s21_bin(4, pos, e8)  // srem pos%8
        var one = tig_int_lit(1)
        var mask = s21_bin(10, one, bitn)        // shl 1<<bitn
        var bitv0 = s21_bin(6, bit, one)         // bit & 1
        var bitv = s21_bin(10, bitv0, bitn)      // shl（bit 位值移位）
        var notm = s21_bin(8, mask, tig_int_lit(-1))  // xor ~mask
        var cleared = s21_bin(6, elt, notm)      // and 清位
        var nv = s21_bin(7, cleared, bitv)       // or 置位
        s21_store(od, nv, T64)
        s21_store(sv, tig_int_lit_ty(1, I8), I8)
        var br1 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br1, mg, 1)
        g_cur_block = mg
        var r8 = s21_load(sv, I8)
        return tig_cmp_zero(r8, 1)  // ne 0 → bool
    }

    // byte_concat(a, b)：拼接两个字节表 → 新表（a 元素在前 b 在后，不动入参）。
    // 纯内存：新数据缓冲 = malloc((len_a+len_b)*esz) + 两段 memcpy；零外部依赖。
    func tig_byte_concat(a: i64, b: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var la = s21_load(s21_gep(a, 8, true), T64)
        var lb = s21_load(s21_gep(b, 8, true), T64)
        var da = t21_data(a)
        var db = t21_data(b)
        var esz = t21_esz(a)
        var n = s21_bin(0, la, lb)
        var ab = s21_bin(2, la, esz)
        var buf = s21_raw_alloc_str(s21_bin(2, n, esz))
        s21_memcpy_if(buf, da, ab)                     // 段 A（la 元素，空表 data null 保护）
        s21_memcpy_if(s21_gep(buf, ab, false), db, s21_bin(2, lb, esz))  // 段 B
        var h = s21_raw_alloc_str(tig_int_lit(32))
        s21_store(s21_gep(h, 0, true), n, T64)    // cap
        s21_store(s21_gep(h, 8, true), n, T64)    // len
        s21_store(s21_gep(h, 16, true), buf, types.named(TK_STR))  // data
        s21_store(s21_gep(h, 24, true), esz, T64)  // esz
        return h
    }
    // ============ p.6.4.1 内联基础原语 + UTF-16 宽字符桥 ============
    // 新基础设施：UTF-16 宽字符转换（Windows 系统调用面）。tie 字符串为 UTF-8
    //（{8 字节长度头}{数据}{\0}）；SetEnvironmentVariableW / CommandLineToArgvW /
    // GetCurrentDirectoryW 等需要 UTF-16LE（wchar_t*）。编译器后端不能 import
    // std/utf.tie，故在 IR 层手排「码点解码 + 代理对编码」（本组辅助全部生成普通
    // tie-IR 指令；零 Rust 桥、零 tie_interp.lib；UTF-8 逐字节序列判定复用
    // s21_utf8_seq_len / s21_utf8_char_at，代理对编码按 Unicode 规范）。

    func tig_w16_append(hv: i64, u: i64) {
        var lo = s21_bin(6, u, tig_int_lit(0xFF))  // u & 0xFF
        s21_sb_append_byte(hv, lo)
        var hi = s21_bin(6, s21_bin(11, u, tig_int_lit(8)), tig_int_lit(0xFF))  // (u>>8)&0xFF
        s21_sb_append_byte(hv, hi)
    }

    func tig_w16_append_cp(hv: i64, cp: i64) {
        var T64 = types.named(TK_I64)
        var is_sup = tig_cmp_const(cp, 3, 0xFFFF, T64)   // cp > 0xFFFF
        var b_s = ir.new_block(g_cur_func, interner.intern("w16.cp.s"))
        var b_b = ir.new_block(g_cur_func, interner.intern("w16.cp.b"))
        var b_m = ir.new_block(g_cur_func, interner.intern("w16.cp.m"))
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, is_sup, 0)
        ir.add_operand(cb, b_s, 1)
        ir.add_operand(cb, b_b, 1)
        g_cur_block = b_s
        var cp2 = s21_bin(1, cp, tig_int_lit(0x10000))  // sub
        var hi_s = s21_bin(7, tig_int_lit(0xD800), s21_bin(6, s21_bin(11, cp2, tig_int_lit(10)), tig_int_lit(0x3FF)))
        var lo_s = s21_bin(7, tig_int_lit(0xDC00), s21_bin(6, cp2, tig_int_lit(0x3FF)))
        tig_w16_append(hv, hi_s)
        tig_w16_append(hv, lo_s)
        var br1 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br1, b_m, 1)
        g_cur_block = b_b
        tig_w16_append(hv, cp)
        var br2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br2, b_m, 1)
        g_cur_block = b_m
    }

    func tig_wide16(s: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var blen = s21_str_head_len(s)
        var hv = s21_sb_new()
        var pa = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(pa, T64, 2)
        var pp = ir.get_value(pa)
        s21_store(pp, tig_int_lit(0), T64)   // pos（UTF-8 字节偏移）
        var hd = ir.new_block(g_cur_func, interner.intern("w16.h"))
        var bd = ir.new_block(g_cur_func, interner.intern("w16.b"))
        var ex = ir.new_block(g_cur_func, interner.intern("w16.x"))
        var br0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br0, hd, 1)
        g_cur_block = hd
        var pv = s21_load(pp, T64)
        var pc = tig_icmp_c(pv, blen, 2)     // pos < blen
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, pc, 0)
        ir.add_operand(cb, bd, 1)
        ir.add_operand(cb, ex, 1)
        g_cur_block = bd
        var p2 = s21_load(pp, T64)
        var seql = s21_utf8_seq_len(s, p2)
        var cp = s21_utf8_char_at(s, p2)
        tig_w16_append_cp(hv, cp)
        s21_store(pp, s21_bin(0, p2, seql), T64)   // pos += 序列长度
        var brb = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brb, hd, 1)
        g_cur_block = ex
        tig_w16_append(hv, tig_int_lit(0))   // u16 NUL 终止符
        return s21_sb_build(hv)
    }
    func tig_cp_utf8_append(hv: i64, cp: i64) {
        var T64 = types.named(TK_I64)
        var l1 = ir.new_block(g_cur_func, interner.intern("u8.l1"))
        var l2c = ir.new_block(g_cur_func, interner.intern("u8.2c"))
        var l2 = ir.new_block(g_cur_func, interner.intern("u8.l2"))
        var l3c = ir.new_block(g_cur_func, interner.intern("u8.3c"))
        var l3 = ir.new_block(g_cur_func, interner.intern("u8.l3"))
        var l4 = ir.new_block(g_cur_func, interner.intern("u8.l4"))
        var mg = ir.new_block(g_cur_func, interner.intern("u8.m"))
        var c1 = tig_cmp_const(cp, 4, 0x7F, T64)   // cp <= 0x7F
        var cb1 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb1, c1, 0)
        ir.add_operand(cb1, l1, 1)
        ir.add_operand(cb1, l2c, 1)
        g_cur_block = l1
        s21_sb_append_byte(hv, cp)
        var br1 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br1, mg, 1)
        g_cur_block = l2c
        var c2 = tig_cmp_const(cp, 4, 0x7FF, T64)
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, c2, 0)
        ir.add_operand(cb2, l2, 1)
        ir.add_operand(cb2, l3c, 1)
        g_cur_block = l2
        s21_sb_append_byte(hv, s21_bin(7, tig_int_lit(0xC0), s21_bin(6, s21_bin(11, cp, tig_int_lit(6)), tig_int_lit(0x1F))))
        s21_sb_append_byte(hv, s21_bin(7, tig_int_lit(0x80), s21_bin(6, cp, tig_int_lit(0x3F))))
        var br2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br2, mg, 1)
        g_cur_block = l3c
        var c3 = tig_cmp_const(cp, 4, 0xFFFF, T64)
        var cb3 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb3, c3, 0)
        ir.add_operand(cb3, l3, 1)
        ir.add_operand(cb3, l4, 1)
        g_cur_block = l3
        s21_sb_append_byte(hv, s21_bin(7, tig_int_lit(0xE0), s21_bin(6, s21_bin(11, cp, tig_int_lit(12)), tig_int_lit(0x0F))))
        s21_sb_append_byte(hv, s21_bin(7, tig_int_lit(0x80), s21_bin(6, s21_bin(11, cp, tig_int_lit(6)), tig_int_lit(0x3F))))
        s21_sb_append_byte(hv, s21_bin(7, tig_int_lit(0x80), s21_bin(6, cp, tig_int_lit(0x3F))))
        var br3 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br3, mg, 1)
        g_cur_block = l4
        s21_sb_append_byte(hv, s21_bin(7, tig_int_lit(0xF0), s21_bin(6, s21_bin(11, cp, tig_int_lit(18)), tig_int_lit(0x07))))
        s21_sb_append_byte(hv, s21_bin(7, tig_int_lit(0x80), s21_bin(6, s21_bin(11, cp, tig_int_lit(12)), tig_int_lit(0x3F))))
        s21_sb_append_byte(hv, s21_bin(7, tig_int_lit(0x80), s21_bin(6, s21_bin(11, cp, tig_int_lit(6)), tig_int_lit(0x3F))))
        s21_sb_append_byte(hv, s21_bin(7, tig_int_lit(0x80), s21_bin(6, cp, tig_int_lit(0x3F))))
        var br4 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br4, mg, 1)
        g_cur_block = mg
    }

    func tig_from_wide16(w: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I8 = types.named(TK_I8)
        var hv = s21_sb_new()
        var ia = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(ia, T64, 2)
        var ip = ir.get_value(ia)
        s21_store(ip, tig_int_lit(0), T64)   // u16 码元索引 i（字节偏移 = 2*i）
        var hd = ir.new_block(g_cur_func, interner.intern("w2o.h"))
        var chk = ir.new_block(g_cur_func, interner.intern("w2o.hi"))
        var pl = ir.new_block(g_cur_func, interner.intern("w2o.pl"))
        var ex = ir.new_block(g_cur_func, interner.intern("w2o.x"))
        var b_cb = ir.new_block(g_cur_func, interner.intern("w2o.cb"))
        var b_ff = ir.new_block(g_cur_func, interner.intern("w2o.ff"))
        var b_mh = ir.new_block(g_cur_func, interner.intern("w2o.mh"))
        var br0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br0, hd, 1)
        g_cur_block = hd
        var iv = s21_load(ip, T64)
        var off = s21_bin(2, iv, tig_int_lit(2))
        var lo = s21_zext(s21_load(s21_gep(w, off, false), I8), I8)
        var hi_b = s21_zext(s21_load(s21_gep(w, s21_bin(0, off, tig_int_lit(1)), false), I8), I8)
        var u = s21_bin(7, lo, s21_bin(10, hi_b, tig_int_lit(8)))   // u16 码元
        var nul = tig_cmp_zero(u, 0)              // u == 0 → 串结束
        var cb_n = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb_n, nul, 0)
        ir.add_operand(cb_n, ex, 1)
        ir.add_operand(cb_n, chk, 1)
        g_cur_block = chk   // 非 NUL：判定高代理（u>=0xD800 && u<=0xDBFF）
        var ge_h = tig_icmp_c(u, tig_int_lit(0xD800), 5)
        var le_h = tig_icmp_c(u, tig_int_lit(0xDBFF), 4)
        var is_high = tig_and_i1(ge_h, le_h)
        var hi2 = ir.new_block(g_cur_func, interner.intern("w2o.hi2"))
        var cb_high = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb_high, is_high, 0)
        ir.add_operand(cb_high, hi2, 1)   // 高代理 → hi2（读次码元 u2）
        ir.add_operand(cb_high, pl, 1)
        g_cur_block = pl   // 普通 BMP 码元
        tig_cp_utf8_append(hv, u)
        s21_store(ip, s21_bin(0, iv, tig_int_lit(1)), T64)
        var br1 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br1, b_mh, 1)
        g_cur_block = hi2   // 高代理：读次 u2；低代理 → 组合；否则 U+FFFD
        var iv2 = s21_load(ip, T64)
        var off2 = s21_bin(2, iv2, tig_int_lit(2))
        var lo2 = s21_zext(s21_load(s21_gep(w, off2, false), I8), I8)
        var hi2b = s21_zext(s21_load(s21_gep(w, s21_bin(0, off2, tig_int_lit(1)), false), I8), I8)
        var u2 = s21_bin(7, lo2, s21_bin(10, hi2b, tig_int_lit(8)))
        var ge_l = tig_icmp_c(u2, tig_int_lit(0xDC00), 5)
        var le_l = tig_icmp_c(u2, tig_int_lit(0xDFFF), 4)
        var is_low = tig_and_i1(ge_l, le_l)
        var cb_l = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb_l, is_low, 0)
        ir.add_operand(cb_l, b_cb, 1)
        ir.add_operand(cb_l, b_ff, 1)
        g_cur_block = b_cb   // 组合：cp = 0x10000 + ((u-0xD800)<<10 | (u2-0xDC00))
        var cu = s21_bin(1, u, tig_int_lit(0xD800))
        var cu2 = s21_bin(1, u2, tig_int_lit(0xDC00))
        var comb = s21_bin(0, tig_int_lit(0x10000), s21_bin(7, s21_bin(10, cu, tig_int_lit(10)), cu2))
        tig_cp_utf8_append(hv, comb)
        s21_store(ip, s21_bin(0, iv2, tig_int_lit(2)), T64)   // i += 2
        var br2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br2, b_mh, 1)
        g_cur_block = b_ff   // 孤立代理 → 替换符；i += 1
        tig_cp_utf8_append(hv, tig_int_lit(0xFFFD))
        s21_store(ip, s21_bin(0, iv2, tig_int_lit(1)), T64)
        var br3 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br3, b_mh, 1)
        g_cur_block = b_mh
        var br4 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br4, hd, 1)
        g_cur_block = ex
        return s21_sb_build(hv)
    }

    // ==================== p.6.4.6 进程捕获：exec_output 内联 ====================
    // exec_output(cmd) → 捕获子进程 stdout 到 EOF 返回（失败返回 ""）。从 Rust 桥
    // （tie_exec_output，g_used_interp 置位）改为编译器内联 IR 直调 Win32 管道：
    //   CreatePipe（读端父用 + 写端设可继承）→ SetHandleInformation → CreateProcessW
    //   （宽 cmd 经 tig_wide16；STARTUPINFOW 手工 alloc 填 offset）→ CloseHandle(写端)
    //   → 循环 ReadFile 读端到 EOF（tig_bytes_to_tie + StringBuilder 拼接）→
    //   CloseHandle(读端/进程/线程) → 返回输出串。
    // 全 kernel32 符号（is_libc_sym 免 interp 链接），零 Rust 桥、零 g_used_interp。
    // 结构体布局（对齐 trm platform_win32 repo 先例，repr(C) 64 位）：
    //   STARTUPINFOW sizeof=104：cb@0、dwFlags@60、hStdInput@80、hStdOutput@88、hStdError@96
    //   PROCESS_INFORMATION sizeof=24：hProcess@0、hThread@8、dwProcessId@16、dwThreadId@20
    func tig_exec_output_inline(cmd: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var I8 = types.named(TK_I8)
        var P8 = types.ptr_of(I8)
        var nulp = tig_null_ptr()
        // 结果槽（string，默认空串）
        var rs = ir.new_inst(g_cur_block, 20, types.named(TK_STR))
        ir.add_operand(rs, types.named(TK_STR), 2)
        var rp = ir.get_value(rs)
        s21_store(rp, tig_str_lit(interner.intern("\"\"")), types.named(TK_STR))
        // 句柄/读计数槽 + 缓冲
        var hr_a = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(hr_a, T64, 2)
        var hrp = ir.get_value(hr_a)
        var hw_a = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(hw_a, T64, 2)
        var hwp = ir.get_value(hw_a)
        var rc_a = ir.new_inst(g_cur_block, 20, I32)
        ir.add_operand(rc_a, I32, 2)
        var rcp = ir.get_value(rc_a)
        var buf = s21_raw_alloc_str(tig_int_lit(4096))
        var si = s21_raw_alloc_str(tig_int_lit(104))
        var pi = s21_raw_alloc_str(tig_int_lit(24))
        var wcmd = tig_wide16(cmd)
        var sb = s21_sb_new()
        // CreatePipe(&hr, &hw, NULL, 0)
        var ats0: table<i64> = table_new_i64()
        var avs0: table<i64> = table_new_i64()
        table_push(ats0, P8);  table_push(avs0, hrp)
        table_push(ats0, P8);  table_push(avs0, hwp)
        table_push(ats0, P8);  table_push(avs0, nulp)
        table_push(ats0, I32); table_push(avs0, tig_int_lit_ty(0, I32))
        var cp = tig_ext_call_typed("CreatePipe", ats0, avs0, I32)
        var okp = tig_win_ok(cp)
        var b_bad0 = ir.new_block(g_cur_func, interner.intern("eo.bad0"))
        var b_ppipe = ir.new_block(g_cur_func, interner.intern("eo.pipe"))
        var b_m = ir.new_block(g_cur_func, interner.intern("eo.m"))
        var cb0 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb0, okp, 0)
        ir.add_operand(cb0, b_ppipe, 1)
        ir.add_operand(cb0, b_bad0, 1)
        // 失败（CreatePipe）：free 缓冲 → merge（结果保持空串）
        g_cur_block = b_bad0
        tig_ext_call1("free", buf, types.named(TK_STR), -1)
        tig_ext_call1("free", si, types.named(TK_STR), -1)
        tig_ext_call1("free", pi, types.named(TK_STR), -1)
        var br0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br0, b_m, 1)
        // 建管成功：置可继承位，填 STARTUPINFOW，CreateProcessW
        g_cur_block = b_ppipe
        var hv_hr = s21_load(hrp, T64)
        var hv_hw = s21_load(hwp, T64)
        var ats1: table<i64> = table_new_i64()
        var avs1: table<i64> = table_new_i64()
        table_push(ats1, T64); table_push(avs1, hv_hw)
        table_push(ats1, I32); table_push(avs1, tig_int_lit_ty(1, I32))
        table_push(ats1, I32); table_push(avs1, tig_int_lit_ty(1, I32))
        tig_ext_call_typed("SetHandleInformation", ats1, avs1, I32)
        // 填 STARTUPINFOW：cb@0=104、dwFlags@60=0x100、hStdOutput@88、hStdError@96
        var atsm: table<i64> = table_new_i64()
        var avsm: table<i64> = table_new_i64()
        table_push(atsm, P8); table_push(avsm, si)
        table_push(atsm, I8); table_push(avsm, tig_int_lit_ty(0, I8))
        table_push(atsm, T64); table_push(avsm, tig_int_lit(104))
        tig_ext_call_typed("memset", atsm, avsm, -1)
        s21_store(s21_gep(si, 0, true), tig_int_lit_ty(104, I32), I32)    // cb
        s21_store(s21_gep(si, 60, true), tig_int_lit_ty(0x100, I32), I32) // dwFlags
        s21_store(s21_gep(si, 80, true), tig_int_lit_ty(0, T64), T64)  // hStdInput=0（占位）
        s21_store(s21_gep(si, 88, true), hv_hw, T64)   // hStdOutput
        s21_store(s21_gep(si, 96, true), hv_hw, T64)   // hStdError
        // CreateProcessW(NULL, wcmd, NULL, NULL, TRUE, 0, NULL, NULL, &si, &pi)
        var ats2: table<i64> = table_new_i64()
        var avs2: table<i64> = table_new_i64()
        table_push(ats2, P8);  table_push(avs2, nulp)
        table_push(ats2, P8);  table_push(avs2, wcmd)
        table_push(ats2, P8);  table_push(avs2, nulp)
        table_push(ats2, P8);  table_push(avs2, nulp)
        table_push(ats2, I32); table_push(avs2, tig_int_lit_ty(1, I32))   // bInheritHandles
        table_push(ats2, I32); table_push(avs2, tig_int_lit_ty(0, I32))   // dwCreationFlags
        table_push(ats2, P8);  table_push(avs2, nulp)
        table_push(ats2, P8);  table_push(avs2, nulp)
        table_push(ats2, P8);  table_push(avs2, si)
        table_push(ats2, P8);  table_push(avs2, pi)
        var cw = tig_ext_call_typed("CreateProcessW", ats2, avs2, I32)
        var okw = tig_win_ok(cw)
        var b_bad2 = ir.new_block(g_cur_func, interner.intern("eo.bad2"))
        var b_loop = ir.new_block(g_cur_func, interner.intern("eo.lp"))
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, okw, 0)
        ir.add_operand(cb2, b_loop, 1)
        ir.add_operand(cb2, b_bad2, 1)
        // 失败（CreateProcessW）：关句柄 + free → merge
        g_cur_block = b_bad2
        tig_ext_call1("CloseHandle", hv_hr, T64, I32)
        tig_ext_call1("CloseHandle", hv_hw, T64, I32)
        tig_ext_call1("free", buf, types.named(TK_STR), -1)
        tig_ext_call1("free", si, types.named(TK_STR), -1)
        tig_ext_call1("free", pi, types.named(TK_STR), -1)
        var br2b = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br2b, b_m, 1)
        // 启动成功：父关写端 → 循环读 stdout 到 EOF
        g_cur_block = b_loop
        tig_ext_call1("CloseHandle", hv_hw, T64, I32)
        var b_rd = ir.new_block(g_cur_func, interner.intern("eo.rd"))
        var b_ap = ir.new_block(g_cur_func, interner.intern("eo.ap"))
        var b_x = ir.new_block(g_cur_func, interner.intern("eo.x"))
        // 读循环头（b_loop 即循环体起点，回边到自身）：
        s21_store(rcp, tig_int_lit_ty(0, I32), I32)
        var ats3: table<i64> = table_new_i64()
        var avs3: table<i64> = table_new_i64()
        table_push(ats3, T64); table_push(avs3, hv_hr)
        table_push(ats3, P8);  table_push(avs3, buf)
        table_push(ats3, I32); table_push(avs3, tig_int_lit_ty(4096, I32))
        table_push(ats3, P8);  table_push(avs3, rcp)
        table_push(ats3, P8);  table_push(avs3, nulp)
        var rf = tig_ext_call_typed("ReadFile", ats3, avs3, I32)
        var okr = tig_win_ok(rf)
        var cb3 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb3, okr, 0)
        ir.add_operand(cb3, b_rd, 1)
        ir.add_operand(cb3, b_x, 1)
        // b_rd：ReadFile 成功 → 判读计数
        g_cur_block = b_rd
        var cnt = s21_zext(s21_load(rcp, I32), I32)
        var c0 = tig_cmp_zero(cnt, 0)
        var cb4 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb4, c0, 0)
        ir.add_operand(cb4, b_x, 1)
        ir.add_operand(cb4, b_ap, 1)
        // b_ap：拼接本块字节 → 回边到 b_loop
        g_cur_block = b_ap
        s21_sb_append(sb, tig_bytes_to_tie(buf, cnt))
        var brl = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brl, b_loop, 1)
        // b_x：EOF/出错收尾：关读端 + 等进程退出 + 关进程/线程句柄 + free + 产物
        g_cur_block = b_x
        tig_ext_call1("CloseHandle", hv_hr, T64, I32)
        var ph = s21_load(pi, T64)             // pi.hProcess@0
        var th = s21_load(s21_gep(pi, 8, true), T64)  // pi.hThread@8
        var ats4: table<i64> = table_new_i64()
        var avs4: table<i64> = table_new_i64()
        table_push(ats4, T64); table_push(avs4, ph)
        table_push(ats4, I32); table_push(avs4, tig_int_lit_ty(-1, I32))  // INFINITE (0xFFFFFFFF)
        tig_ext_call_typed("WaitForSingleObject", ats4, avs4, I32)
        tig_ext_call1("CloseHandle", ph, T64, I32)
        tig_ext_call1("CloseHandle", th, T64, I32)
        tig_ext_call1("free", buf, types.named(TK_STR), -1)
        tig_ext_call1("free", si, types.named(TK_STR), -1)
        tig_ext_call1("free", pi, types.named(TK_STR), -1)
        s21_store(rp, s21_sb_build(sb), types.named(TK_STR))
        var brx = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brx, b_m, 1)
        // merge：返回结果槽
        g_cur_block = b_m
        return s21_load(rp, types.named(TK_STR))
    }
    func tig_arg_count() -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var P8 = types.ptr_of(types.named(TK_I8))
        var ats0: table<i64> = table_new_i64()
        var avs0: table<i64> = table_new_i64()
        var cmd = tig_ext_call_typed("GetCommandLineW", ats0, avs0, P8)  // LPCWSTR（零参）
        var na = ir.new_inst(g_cur_block, 20, I32)
        ir.add_operand(na, I32, 2)
        var n_addr = ir.get_value(na)                                    // int* pNumArgs
        var argv = tig_ext_call2("CommandLineToArgvW", cmd, P8, n_addr, P8, P8)  // LPWSTR*
        var n = s21_zext(s21_load(n_addr, I32), I32)                     // argc（含程序名）
        var uc = s21_bin(1, n, tig_int_lit(1))                           // 用户参数 = argc-1
        var uc_neg = tig_cmp_zero(uc, 2)                                 // uc < 0（极端）
        var res = tig_select_i(uc_neg, tig_int_lit(0), uc, T64)
        tig_ext_call1("LocalFree", argv, P8, P8)                         // 释放 LPWSTR*
        return res
    }

    func tig_arg_string(i: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var P8 = types.ptr_of(types.named(TK_I8))
        var ats0: table<i64> = table_new_i64()
        var avs0: table<i64> = table_new_i64()
        var cmd = tig_ext_call_typed("GetCommandLineW", ats0, avs0, P8)
        var na = ir.new_inst(g_cur_block, 20, I32)
        ir.add_operand(na, I32, 2)
        var n_addr = ir.get_value(na)
        var argv = tig_ext_call2("CommandLineToArgvW", cmd, P8, n_addr, P8, P8)
        var n = s21_zext(s21_load(n_addr, I32), I32)                     // 总 argc
        var uc = s21_bin(1, n, tig_int_lit(1))                           // 用户参数个数
        var slot = ir.new_inst(g_cur_block, 20, types.named(TK_STR))
        ir.add_operand(slot, types.named(TK_STR), 2)
        var sv = ir.get_value(slot)
        var empty = tig_str_lit(interner.intern("\"\""))
        s21_store(sv, empty, types.named(TK_STR))                        // 默认空串
        var i_neg = tig_cmp_zero(i, 2)                                   // i < 0
        var i_oob = tig_icmp_c(i, uc, 5)                                 // i >= uc（sge）
        var bad = tig_or_i1(i_neg, i_oob)
        var bt = ir.new_block(g_cur_func, interner.intern("ags.bad"))
        var be = ir.new_block(g_cur_func, interner.intern("ags.ok"))
        var mg = ir.new_block(g_cur_func, interner.intern("ags.m"))
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, bad, 0)
        ir.add_operand(cb, bt, 1)
        ir.add_operand(cb, be, 1)
        g_cur_block = bt
        var br1 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br1, mg, 1)
        g_cur_block = be   // 越界已排除，idx = i+1 ∈ [1, n) 安全
        var idx = s21_bin(0, i, tig_int_lit(1))
        var waddr = s21_gep(argv, s21_bin(2, idx, tig_int_lit(8)), false)  // LPWSTR*[idx]
        var w = s21_load(waddr, types.named(TK_STR))                     // UTF-16LE 串
        var rs = tig_from_wide16(w)
        s21_store(sv, rs, types.named(TK_STR))
        var br2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br2, mg, 1)
        g_cur_block = mg
        tig_ext_call1("LocalFree", argv, P8, P8)
        return s21_load(sv, types.named(TK_STR))
    }

    func tig_cwd() -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var P8 = types.ptr_of(types.named(TK_I8))
        var cap = tig_int_lit(16384)
        var cap32 = tig_int_lit_ty(16384, I32)
        var buf = s21_raw_alloc_str(s21_bin(2, cap, tig_int_lit(2)))     // 2*cap 字节
        tig_ext_call2("GetCurrentDirectoryW", cap32, I32, buf, P8, I32)
        var res = tig_from_wide16(buf)
        tig_ext_call1("free", buf, types.named(TK_STR), -1)
        return res
    }

    func tig_set_env(k: i64, v: i64) {
        var I32 = types.named(TK_I32)
        var P8 = types.ptr_of(types.named(TK_I8))
        var kw = tig_wide16(k)
        var vw = tig_wide16(v)
        tig_ext_call2("SetEnvironmentVariableW", kw, P8, vw, P8, I32)  // BOOL；忽略
    }

    func tig_print_err(v: i64) {
        var I32 = types.named(TK_I32)
        var len = s21_str_head_len(v)
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, I32)
        table_push(avs, tig_int_lit_ty(2, I32))   // fd = stderr
        table_push(ats, types.named(TK_STR))
        table_push(avs, v)
        table_push(ats, types.named(TK_I64))
        table_push(avs, len)                      // 字节数（低 32 位被 _write 读取）
        tig_ext_call_typed("_write", ats, avs, -1)  // void（返回写入字节数，忽略）
    }

    func tig_rand_range(min: i64, max: i64) -> i64 {
        // 注（p.6.4.4）：rand_range 当前经 CRT rand()（RAND_MAX=32767）→（r % span）
        //——当 span>32768 时上端不可达（rand 增量仅 0..RAND_MAX，取模后 min+RAND_MAX
        // 附近区段永不出现），且 rand 未被播种（恒同序列）。修复（用 xorshift 手写
        // 32 位随机 + 全局状态槽，span 用 64 位取模）会显著扩大 p.6.4.4 范围，故
        // **留待 p.6.4.10** 在此处实施；本任务仅记录该已知限制。
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var span = s21_bin(1, max, min)           // max - min
        var bad = tig_icmp_c(span, tig_int_lit(1), 2)   // span < 1（≤0 → 退化）
        var slot = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(slot, T64, 2)
        var sv = ir.get_value(slot)
        var bt = ir.new_block(g_cur_func, interner.intern("rr.b"))
        var be = ir.new_block(g_cur_func, interner.intern("rr.ok"))
        var mg = ir.new_block(g_cur_func, interner.intern("rr.m"))
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, bad, 0)
        ir.add_operand(cb, bt, 1)
        ir.add_operand(cb, be, 1)
        g_cur_block = bt
        s21_store(sv, min, T64)
        var br1 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br1, mg, 1)
        g_cur_block = be
        var ats0: table<i64> = table_new_i64()
        var avs0: table<i64> = table_new_i64()
        var r = tig_ext_call_typed("rand", ats0, avs0, I32)  // int rand()（零参）
        var r64 = s21_zext(r, I32)
        var rmod = s21_urem(r64, span)
        var rres = s21_bin(0, min, rmod)           // min + (r % span)
        s21_store(sv, rres, T64)
        var br2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br2, mg, 1)
        g_cur_block = mg
        return s21_load(sv, T64)
    }

    // ==================== p.6.4.2 / p.6.4.3 文件系统原语内联（UTF-16 安全 Win32） ====================
    func tig_trunc_i32(v: i64) -> i64 {
        var t = ir.new_inst(g_cur_block, 37, types.named(TK_I32))
        ir.add_operand(t, types.named(TK_I64), 2)
        ir.add_operand(t, v, 0)
        return ir.get_value(t)
    }
    func tig_win_ok(r: i64) -> i64 {
        return tig_cmp_zero(r, 1)
    }
    func tig_p2i(p: i64) -> i64 {
        var pi = ir.new_inst(g_cur_block, 24, types.named(TK_I64))  // ptrtoint
        ir.add_operand(pi, p, 0)
        return ir.get_value(pi)
    }
    func tig_null_ptr() -> i64 {
        var ea = ir.new_inst(g_cur_block, 20, types.named(TK_STR))  // alloca ptr
        ir.add_operand(ea, types.named(TK_STR), 2)
        var eap = ir.get_value(ea)
        var nv = tig_int_lit(0)
        var stn = ir.new_inst(g_cur_block, 22, -1)  // store ptr null
        ir.add_operand(stn, types.named(TK_STR), 2)
        ir.add_operand(stn, nv, 0)
        ir.add_operand(stn, eap, 0)
        var ldn = ir.new_inst(g_cur_block, 21, types.named(TK_STR))  // load ptr
        ir.add_operand(ldn, eap, 0)
        return ir.get_value(ldn)
    }
    func tig_bytes_to_tie(buf: i64, len: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I8 = types.named(TK_I8)
        var s = s21_sso_alloc(len)
        s21_store(s21_gep(s, 0, true), len, T64)  // 长度头
        var d0 = s21_gep(s, 8, true)
        s21_memcpy_if(d0, buf, len)
        s21_store(s21_gep(d0, len, false), tig_int_lit_ty(0, I8), I8)  // 尾 \0
        return d0
    }
    func tig_wildpath(dir: i64) -> i64 {
        var hv = s21_sb_new()
        s21_sb_append(hv, dir)
        s21_sb_append_byte(hv, tig_int_lit(92))  // '\'
        s21_sb_append_byte(hv, tig_int_lit(42))  // '*'
        return s21_sb_build(hv)
    }
    func tig_join_path(dir: i64, name: i64) -> i64 {
        var hv = s21_sb_new()
        s21_sb_append(hv, dir)
        s21_sb_append_byte(hv, tig_int_lit(92))  // '\'
        s21_sb_append(hv, name)
        return s21_sb_build(hv)
    }
    func tig_fill_table(dat: i64, n: i64, lenn: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var th = s21_raw_alloc_str(tig_int_lit(32))
        s21_store(s21_gep(th, 0, true), n, T64)
        s21_store(s21_gep(th, 8, true), lenn, T64)
        s21_store(s21_gep(th, 16, true), dat, types.named(TK_STR))
        s21_store(s21_gep(th, 24, true), tig_int_lit(8), T64)
        return th
    }

    // ==================== p.6.4.5 网络原语内联（Winsock2 直调，去 Rust 桥） ====================
    // 一次性 WSAStartup：模块级 @g_wsock_init 全局（i64）标志，首调初始化并置 1，
    // 后续幂等跳过。LPWSADATA 传 408 字节 raw 缓冲（WSAStartup 填充后即丢弃）。
    func tig_wsa_init() {
        llvmgen.wsock_enable()  // 置位：llvmgen 据此输出 @g_wsock_init 私有全局
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var I16 = types.named(TK_I16)
        var P8 = types.ptr_of(types.named(TK_I8))
        var fl = ir.new_inst(g_cur_block, 21, T64)  // load @g_wsock_init
        ir.add_operand(fl, interner.intern("@g_wsock_init"), 3)
        var fv = ir.get_value(fl)
        var need = tig_icmp_c(fv, tig_int_lit(0), 0)  // eq 0（未初始化）
        var bIn = ir.new_block(g_cur_func, interner.intern("wsa.in"))
        var bDo = ir.new_block(g_cur_func, interner.intern("wsa.do"))
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, need, 0)
        ir.add_operand(cb, bIn, 1)
        ir.add_operand(cb, bDo, 1)
        g_cur_block = bIn
        var wsdata = s21_raw_alloc_str(tig_int_lit(408))
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, I16)
        table_push(avs, tig_int_lit_ty(0x0202, I16))  // MAKEWORD(2,2)
        table_push(ats, P8)
        table_push(avs, wsdata)
        tig_ext_call_typed("WSAStartup", ats, avs, I32)
        tig_ext_call1("free", wsdata, types.named(TK_STR), -1)
        // 注：全局操作数（kind 3）须在 add_operand 序列前先把常量生成入变量，
        // 否则「常量生成穿插在操作数序列中间再 push 全局段」会段交错（编译器防险）。
        var onev = tig_int_lit(1)
        var gid = interner.intern("@g_wsock_init")
        var st = ir.new_inst(g_cur_block, 22, -1)  // store @g_wsock_init = 1
        ir.add_operand(st, T64, 2)
        ir.add_operand(st, onev, 0)
        ir.add_operand(st, gid, 3)
        var br = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br, bDo, 1)
        g_cur_block = bDo
    }

    // 构建 16 字节 sockaddr_in（小端写入）：sin_family=AF_INET(2)、
    // sin_port=htons(port)（高字节先）、sin_addr.s_addr=网络序 u32（saddr 为 I32
    // 值，小端存 4 字节即线上字节序）、sin_zero 清零。返回 raw 缓冲指针。
    func tig_wsa_addr(pt: i64, saddr: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var I8 = types.named(TK_I8)
        var sa = s21_raw_alloc_str(tig_int_lit(16))
        s21_store(s21_gep(sa, 0, true), tig_int_lit_ty(2, I8), I8)   // family lo
        s21_store(s21_gep(sa, 1, true), tig_int_lit_ty(0, I8), I8)   // family hi
        var ph = s21_bin(6, s21_bin(11, pt, tig_int_lit(8)), tig_int_lit(255))  // (port>>8)&0xFF
        var pl = s21_bin(6, pt, tig_int_lit(255))                              // port&0xFF
        s21_store(s21_gep(sa, 2, true), s21_trunc_i8(ph), I8)   // port 高字节（网络序）
        s21_store(s21_gep(sa, 3, true), s21_trunc_i8(pl), I8)   // port 低字节
        s21_store(s21_gep(sa, 4, true), saddr, I32)             // sin_addr.s_addr
        s21_store(s21_gep(sa, 8, true), tig_int_lit(0), T64)    // sin_zero[8..16]
        return sa
    }

    // socket(AF_INET, stype, 0) → SOCKET(i64)；stype=1 TCP(SOCK_STREAM)/2 UDP(SOCK_DGRAM)
    func tig_net_socket(stype: i64) -> i64 {
        var I32 = types.named(TK_I32)
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, I32)
        table_push(avs, tig_int_lit_ty(2, I32))       // AF_INET
        table_push(ats, I32)
        table_push(avs, tig_trunc_i32(stype))
        table_push(ats, I32)
        table_push(avs, tig_int_lit_ty(0, I32))       // proto
        return tig_ext_call_typed("socket", ats, avs, types.named(TK_I64))
    }

    // gethostbyname(host) → 网络序 u32 s_addr（i64）；失败返回 -1。
    // host 先做 NUL 终止拷贝（tie 串数据指针不保证 NUL 结尾）。
    // hostent 布局（x64）：h_name(8)+h_aliases(8)+h_addrtype(2)+h_length(2)+pad(4)
    // +h_addr_list(offset24)；取 h_addr_list[0] 的 4 字节 in_addr，小端读 u32。
    func tig_net_resolve(host: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var I8 = types.named(TK_I8)
        var P8 = types.ptr_of(types.named(TK_I8))
        var hl = s21_str_head_len(host)
        var z = s21_raw_alloc_str(s21_bin(0, hl, tig_int_lit(1)))
        s21_memcpy_if(z, host, hl)
        s21_store(s21_gep(z, hl, false), tig_int_lit_ty(0, I8), I8)
        var he = tig_ext_call1("gethostbyname", z, types.named(TK_STR), P8)
        var sv = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(sv, T64, 2)
        var svv = ir.get_value(sv)
        s21_store(svv, tig_int_lit(-1), T64)   // 默认失败
        var fail = tig_cmp_zero(he, 0)         // he == null
        var bOk = ir.new_block(g_cur_func, interner.intern("rs.ok"))
        var bFail = ir.new_block(g_cur_func, interner.intern("rs.f"))
        var bM = ir.new_block(g_cur_func, interner.intern("rs.m"))
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, fail, 0)
        ir.add_operand(cb, bFail, 1)
        ir.add_operand(cb, bOk, 1)
        g_cur_block = bFail
        tig_ext_call1("free", z, types.named(TK_STR), -1)
        var brf = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brf, bM, 1)
        g_cur_block = bOk
        var hlist = s21_load(s21_gep(he, 24, true), P8)   // char** h_addr_list
        var hp0 = s21_load(s21_gep(hlist, 0, true), P8)   // char* 首个 in_addr
        var saddrv = s21_load(s21_gep(hp0, 0, true), I32) // in_addr.s_addr (u32 网络序)
        s21_store(svv, s21_zext(saddrv, I32), T64)
        tig_ext_call1("free", z, types.named(TK_STR), -1)
        var brk = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brk, bM, 1)
        g_cur_block = bM
        return s21_load(svv, T64)
    }

    // 通用结果槽（i64，默认 -1）
    func tig_slot64(init: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var sv = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(sv, T64, 2)
        var svv = ir.get_value(sv)
        s21_store(svv, tig_int_lit(init), T64)
        return svv
    }

    // ---- TCP ----
    // net_tcp_listen(port) -> i64：socket(STREAM)+bind(0.0.0.0:port)+listen(8)
    func tig_net_tcp_listen(pt: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var ST = types.named(TK_STR)
        tig_wsa_init()
        var fd = tig_net_socket(tig_int_lit(1))       // SOCK_STREAM
        var svv = tig_slot64(-1)
        var bad = tig_icmp_c(fd, tig_int_lit(-1), 0)  // socket 失败
        var bE = ir.new_block(g_cur_func, interner.intern("ls.e"))
        var bS = ir.new_block(g_cur_func, interner.intern("ls.s"))
        var bM = ir.new_block(g_cur_func, interner.intern("ls.m"))
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, bad, 0)
        ir.add_operand(cb, bE, 1)
        ir.add_operand(cb, bS, 1)
        g_cur_block = bE
        var brE = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brE, bM, 1)
        g_cur_block = bS
        var sa = tig_wsa_addr(pt, tig_int_lit_ty(0, I32))  // INADDR_ANY
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, T64);  table_push(avs, fd)
        table_push(ats, ST);   table_push(avs, sa)
        table_push(ats, I32);  table_push(avs, tig_int_lit_ty(16, I32))
        var brc = tig_ext_call_typed("bind", ats, avs, I32)
        var bbad = tig_icmp_c(brc, tig_int_lit_ty(0, I32), 1)  // != 0 → fail
        var bBf = ir.new_block(g_cur_func, interner.intern("ls.bf"))
        var bBs = ir.new_block(g_cur_func, interner.intern("ls.bs"))
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, bbad, 0)
        ir.add_operand(cb2, bBf, 1)
        ir.add_operand(cb2, bBs, 1)
        g_cur_block = bBf
        tig_ext_call1("closesocket", fd, T64, I32)
        var brBf = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brBf, bM, 1)
        g_cur_block = bBs
        var ats2: table<i64> = table_new_i64()
        var avs2: table<i64> = table_new_i64()
        table_push(ats2, T64);  table_push(avs2, fd)
        table_push(ats2, I32);  table_push(avs2, tig_int_lit_ty(8, I32))  // backlog 8
        var lrc = tig_ext_call_typed("listen", ats2, avs2, I32)
        var lbad = tig_icmp_c(lrc, tig_int_lit_ty(0, I32), 1)
        var bLf = ir.new_block(g_cur_func, interner.intern("ls.lf"))
        var bLs = ir.new_block(g_cur_func, interner.intern("ls.ls"))
        var cb3 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb3, lbad, 0)
        ir.add_operand(cb3, bLf, 1)
        ir.add_operand(cb3, bLs, 1)
        g_cur_block = bLf
        tig_ext_call1("closesocket", fd, T64, I32)
        var brLf = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brLf, bM, 1)
        g_cur_block = bLs
        s21_store(svv, fd, T64)   // 成功：返回监听句柄
        var brLs = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brLs, bM, 1)
        g_cur_block = bM
        return s21_load(svv, T64)
    }

    // net_tcp_accept(h) -> i64：accept → 连接句柄（失败 -1）
    func tig_net_tcp_accept(h: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var P8 = types.ptr_of(types.named(TK_I8))
        tig_wsa_init()
        var nullp = tig_null_ptr()
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, T64); table_push(avs, h)
        table_push(ats, P8);  table_push(avs, nullp)
        table_push(ats, P8);  table_push(avs, nullp)
        return tig_ext_call_typed("accept", ats, avs, T64)  // SOCKET（-1 即失败）
    }

    // net_tcp_connect(host, port) -> i64：socket(STREAM)+resolve+connect
    func tig_net_tcp_connect(host: i64, pt: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var ST = types.named(TK_STR)
        tig_wsa_init()
        var saddr = tig_net_resolve(host)
        var svv = tig_slot64(-1)
        var rbad = tig_icmp_c(saddr, tig_int_lit(-1), 0)  // 解析失败
        var bRe = ir.new_block(g_cur_func, interner.intern("ct.re"))
        var bRS = ir.new_block(g_cur_func, interner.intern("ct.rs"))
        var bM = ir.new_block(g_cur_func, interner.intern("ct.m"))
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, rbad, 0)
        ir.add_operand(cb, bRe, 1)
        ir.add_operand(cb, bRS, 1)
        g_cur_block = bRe
        var brE = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brE, bM, 1)
        g_cur_block = bRS
        var fd = tig_net_socket(tig_int_lit(1))
        var fbad = tig_icmp_c(fd, tig_int_lit(-1), 0)
        var bFe = ir.new_block(g_cur_func, interner.intern("ct.fe"))
        var bFS = ir.new_block(g_cur_func, interner.intern("ct.fs"))
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, fbad, 0)
        ir.add_operand(cb2, bFe, 1)
        ir.add_operand(cb2, bFS, 1)
        g_cur_block = bFe
        var brF = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brF, bM, 1)
        g_cur_block = bFS
        var sa = tig_wsa_addr(pt, tig_trunc_i32(saddr))
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, T64); table_push(avs, fd)
        table_push(ats, ST);  table_push(avs, sa)
        table_push(ats, I32); table_push(avs, tig_int_lit_ty(16, I32))
        var crc = tig_ext_call_typed("connect", ats, avs, I32)
        var cbad = tig_icmp_c(crc, tig_int_lit_ty(0, I32), 1)
        var bCf = ir.new_block(g_cur_func, interner.intern("ct.cf"))
        var bCs = ir.new_block(g_cur_func, interner.intern("ct.cs"))
        var cb3 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb3, cbad, 0)
        ir.add_operand(cb3, bCf, 1)
        ir.add_operand(cb3, bCs, 1)
        g_cur_block = bCf
        tig_ext_call1("closesocket", fd, T64, I32)
        var brC = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brC, bM, 1)
        g_cur_block = bCs
        s21_store(svv, fd, T64)   // 成功
        var brCs = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brCs, bM, 1)
        g_cur_block = bM
        return s21_load(svv, T64)
    }

    // net_tcp_send(h, data:串) -> i64：send 按 UTF-8 字节发送（到串数据指针）
    func tig_net_tcp_send(h: i64, data: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var ST = types.named(TK_STR)
        tig_wsa_init()
        var dlen = s21_str_head_len(data)
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, T64); table_push(avs, h)
        table_push(ats, ST);  table_push(avs, data)
        table_push(ats, I32); table_push(avs, tig_trunc_i32(dlen))
        table_push(ats, I32); table_push(avs, tig_int_lit_ty(0, I32))  // flags
        var r = tig_ext_call_typed("send", ats, avs, I32)
        return tig_sext(r, I32, T64)
    }

    // net_tcp_recv(h, max) -> string（仅 ASCII 安全；二进制请用 recv_bytes）
    func tig_net_tcp_recv(h: i64, max: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var ST = types.named(TK_STR)
        tig_wsa_init()
        var buf = s21_raw_alloc_str(max)
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, T64); table_push(avs, h)
        table_push(ats, ST);  table_push(avs, buf)
        table_push(ats, I32); table_push(avs, tig_trunc_i32(max))
        table_push(ats, I32); table_push(avs, tig_int_lit_ty(0, I32))
        var r = tig_ext_call_typed("recv", ats, avs, I32)
        var rgt0 = tig_icmp_c(r, tig_int_lit_ty(0, I32), 3)  // sgt
        var r64 = tig_sext(r, I32, T64)
        var nr = tig_select_i(rgt0, r64, tig_int_lit(0), T64)  // <0/0 → 空串哨兵
        return tig_bytes_to_tie(buf, nr)
    }

    // ---- 字节版（p.6.6.1 TLS 用）----
    // net_tcp_send_bytes(h, data:表<i64>) -> i64：逐元素取低字节拼字节缓冲后 send
    func tig_net_tcp_send_bytes(h: i64, data: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var I8 = types.named(TK_I8)
        var ST = types.named(TK_STR)
        tig_wsa_init()
        var dlen = s21_load(s21_gep(data, 8, true), T64)    // 表 len
        var dptr = s21_load(s21_gep(data, 16, true), ST)    // 表 data 段
        var nytes = s21_raw_alloc_str(dlen)
        // i 槽（i64）
        var i_slot = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(i_slot, T64, 2)
        var iv = ir.get_value(i_slot)
        s21_store(iv, tig_int_lit(0), T64)
        var bCond = ir.new_block(g_cur_func, interner.intern("sb.c"))
        var bBody = ir.new_block(g_cur_func, interner.intern("sb.b"))
        var bExit = ir.new_block(g_cur_func, interner.intern("sb.e"))
        var b0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(b0, bCond, 1)
        g_cur_block = bCond
        var ci = s21_load(iv, T64)
        var cond = tig_icmp_c(ci, dlen, 2)   // i < len
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, cond, 0)
        ir.add_operand(cb, bBody, 1)
        ir.add_operand(cb, bExit, 1)
        g_cur_block = bBody
        var ci2 = s21_load(iv, T64)
        var elem = s21_load(s21_gep(dptr, s21_bin(10, ci2, tig_int_lit(3)), false), T64)  // data[i*8]
        var byt = s21_bin(6, elem, tig_int_lit(255))          // & 0xFF
        s21_store(s21_gep(nytes, ci2, false), s21_trunc_i8(byt), I8)
        s21_store(iv, s21_bin(0, ci2, tig_int_lit(1)), T64)   // i += 1
        var brb = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brb, bCond, 1)
        g_cur_block = bExit
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, T64); table_push(avs, h)
        table_push(ats, ST);  table_push(avs, nytes)
        table_push(ats, I32); table_push(avs, tig_trunc_i32(dlen))
        table_push(ats, I32); table_push(avs, tig_int_lit_ty(0, I32))
        var r = tig_ext_call_typed("send", ats, avs, I32)
        var rs = tig_sext(r, I32, T64)
        tig_ext_call1("free", nytes, ST, -1)
        return rs
    }

    // net_tcp_recv_bytes(h, max) -> 表<i64>：recv 原始字节 → 逐字节装入 i64 元素表
    //（cap=max, len=实收, data=8×max 元素缓冲, esz=8——仿 tig_byte_read 表格式）
    func tig_net_tcp_recv_bytes(h: i64, max: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var I8 = types.named(TK_I8)
        var ST = types.named(TK_STR)
        tig_wsa_init()
        var rawB = s21_raw_alloc_str(max)
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, T64); table_push(avs, h)
        table_push(ats, ST);  table_push(avs, rawB)
        table_push(ats, I32); table_push(avs, tig_trunc_i32(max))
        table_push(ats, I32); table_push(avs, tig_int_lit_ty(0, I32))
        var r = tig_ext_call_typed("recv", ats, avs, I32)
        var rgt0 = tig_icmp_c(r, tig_int_lit_ty(0, I32), 3)
        var r64 = tig_sext(r, I32, T64)
        var nr = tig_select_i(rgt0, r64, tig_int_lit(0), T64)
        var edata = s21_raw_alloc_str(s21_bin(10, max, tig_int_lit(3)))  // max*8 字节
        var i_slot = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(i_slot, T64, 2)
        var iv = ir.get_value(i_slot)
        s21_store(iv, tig_int_lit(0), T64)
        var bCond = ir.new_block(g_cur_func, interner.intern("rb.c"))
        var bBody = ir.new_block(g_cur_func, interner.intern("rb.b"))
        var bExit = ir.new_block(g_cur_func, interner.intern("rb.e"))
        var b0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(b0, bCond, 1)
        g_cur_block = bCond
        var ci = s21_load(iv, T64)
        var cond = tig_icmp_c(ci, nr, 2)   // i < nr
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, cond, 0)
        ir.add_operand(cb, bBody, 1)
        ir.add_operand(cb, bExit, 1)
        g_cur_block = bBody
        var ci2 = s21_load(iv, T64)
        var bval = s21_zext(s21_load(s21_gep(rawB, ci2, false), I8), I8)  // 原始字节 → i64
        s21_store(s21_gep(edata, s21_bin(10, ci2, tig_int_lit(3)), false), bval, T64)  // edata[i*8]
        s21_store(iv, s21_bin(0, ci2, tig_int_lit(1)), T64)
        var brb = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brb, bCond, 1)
        g_cur_block = bExit
        tig_ext_call1("free", rawB, ST, -1)
        return tig_fill_table(edata, max, nr)
    }

    // ---- UDP ----
    // net_udp_bind(port) -> i64：socket(DGRAM)+bind
    func tig_net_udp_bind(pt: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var ST = types.named(TK_STR)
        tig_wsa_init()
        var fd = tig_net_socket(tig_int_lit(2))       // SOCK_DGRAM
        var svv = tig_slot64(-1)
        var bad = tig_icmp_c(fd, tig_int_lit(-1), 0)
        var bE = ir.new_block(g_cur_func, interner.intern("ub.e"))
        var bS = ir.new_block(g_cur_func, interner.intern("ub.s"))
        var bM = ir.new_block(g_cur_func, interner.intern("ub.m"))
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, bad, 0)
        ir.add_operand(cb, bE, 1)
        ir.add_operand(cb, bS, 1)
        g_cur_block = bE
        var brE = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brE, bM, 1)
        g_cur_block = bS
        var sa = tig_wsa_addr(pt, tig_int_lit_ty(0, I32))  // INADDR_ANY
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, T64); table_push(avs, fd)
        table_push(ats, ST);  table_push(avs, sa)
        table_push(ats, I32); table_push(avs, tig_int_lit_ty(16, I32))
        var brc = tig_ext_call_typed("bind", ats, avs, I32)
        var bbad = tig_icmp_c(brc, tig_int_lit_ty(0, I32), 1)
        var bBf = ir.new_block(g_cur_func, interner.intern("ub.bf"))
        var bBs = ir.new_block(g_cur_func, interner.intern("ub.bs"))
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, bbad, 0)
        ir.add_operand(cb2, bBf, 1)
        ir.add_operand(cb2, bBs, 1)
        g_cur_block = bBf
        tig_ext_call1("closesocket", fd, T64, I32)
        var brBf = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brBf, bM, 1)
        g_cur_block = bBs
        s21_store(svv, fd, T64)
        var brBs = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brBs, bM, 1)
        g_cur_block = bM
        return s21_load(svv, T64)
    }

    // net_udp_send(h, host, port, data) -> i64：resolve + sendto
    func tig_net_udp_send(h: i64, host: i64, pt: i64, data: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var ST = types.named(TK_STR)
        tig_wsa_init()
        var dlen = s21_str_head_len(data)
        var saddr = tig_net_resolve(host)
        var svv = tig_slot64(-1)
        var rbad = tig_icmp_c(saddr, tig_int_lit(-1), 0)
        var bE = ir.new_block(g_cur_func, interner.intern("us.e"))
        var bS = ir.new_block(g_cur_func, interner.intern("us.s"))
        var bM = ir.new_block(g_cur_func, interner.intern("us.m"))
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, rbad, 0)
        ir.add_operand(cb, bE, 1)
        ir.add_operand(cb, bS, 1)
        g_cur_block = bE
        var brE = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brE, bM, 1)
        g_cur_block = bS
        var sa = tig_wsa_addr(pt, tig_trunc_i32(saddr))
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, T64); table_push(avs, h)
        table_push(ats, ST);  table_push(avs, data)
        table_push(ats, I32); table_push(avs, tig_trunc_i32(dlen))
        table_push(ats, I32); table_push(avs, tig_int_lit_ty(0, I32))
        table_push(ats, ST);  table_push(avs, sa)
        table_push(ats, I32); table_push(avs, tig_int_lit_ty(16, I32))
        var r = tig_ext_call_typed("sendto", ats, avs, I32)
        var rs = tig_sext(r, I32, T64)
        s21_store(svv, rs, T64)
        var brS = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brS, bM, 1)
        g_cur_block = bM
        return s21_load(svv, T64)
    }

    // net_udp_recv(h, max) -> string：recvfrom（ASCII 安全）
    func tig_net_udp_recv(h: i64, max: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var ST = types.named(TK_STR)
        var P8 = types.ptr_of(types.named(TK_I8))
        tig_wsa_init()
        var buf = s21_raw_alloc_str(max)
        var nullp = tig_null_ptr()
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, T64); table_push(avs, h)
        table_push(ats, ST);  table_push(avs, buf)
        table_push(ats, I32); table_push(avs, tig_trunc_i32(max))
        table_push(ats, I32); table_push(avs, tig_int_lit_ty(0, I32))
        table_push(ats, P8);  table_push(avs, nullp)   // sockaddr*
        table_push(ats, P8);  table_push(avs, nullp)   // socklen_t*
        var r = tig_ext_call_typed("recvfrom", ats, avs, I32)
        var rgt0 = tig_icmp_c(r, tig_int_lit_ty(0, I32), 3)
        var r64 = tig_sext(r, I32, T64)
        var nr = tig_select_i(rgt0, r64, tig_int_lit(0), T64)
        return tig_bytes_to_tie(buf, nr)
    }

    // net_close(h) -> bool：closesocket 返回 0 = 成功
    func tig_net_close(h: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        tig_wsa_init()
        var r = tig_ext_call1("closesocket", h, T64, I32)
        return tig_icmp_c(r, tig_int_lit_ty(0, I32), 0)   // rc == 0 → true
    }

    func tig_create_file_w(pw: i64, access: i64, disp: i64) -> i64 {
        var I32 = types.named(TK_I32)
        var P8 = types.ptr_of(types.named(TK_I8))
        var nullsa = tig_null_ptr()
        var nulltm = tig_null_ptr()
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, P8);  table_push(avs, pw)
        table_push(ats, I32); table_push(avs, access)
        table_push(ats, I32); table_push(avs, tig_int_lit_ty(3, I32))
        table_push(ats, P8);  table_push(avs, nullsa)
        table_push(ats, I32); table_push(avs, disp)
        table_push(ats, I32); table_push(avs, tig_int_lit_ty(0x80, I32))
        table_push(ats, P8);  table_push(avs, nulltm)
        return tig_ext_call_typed("CreateFileW", ats, avs, P8)
    }
    func tig_file_attr_w(p: i64) -> i64 {
        var P8 = types.ptr_of(types.named(TK_I8))
        var pw = tig_wide16(p)
        return tig_ext_call1("GetFileAttributesW", pw, P8, types.named(TK_I32))
    }
    func tig_mkdir_w(pw: i64) {
        var I32 = types.named(TK_I32)
        var P8 = types.ptr_of(types.named(TK_I8))
        var nullsa = tig_null_ptr()
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, P8); table_push(avs, pw)
        table_push(ats, P8); table_push(avs, nullsa)
        tig_ext_call_typed("CreateDirectoryW", ats, avs, I32)
    }
    func tig_find_first_w(pw: i64, fd: i64) -> i64 {
        var P8 = types.ptr_of(types.named(TK_I8))
        return tig_ext_call2("FindFirstFileW", pw, P8, fd, P8, P8)
    }
    func tig_find_next_w(hf: i64, fd: i64) -> i64 {
        var P8 = types.ptr_of(types.named(TK_I8))
        return tig_ext_call2("FindNextFileW", hf, P8, fd, P8, types.named(TK_I32))
    }
    func tig_find_close(hf: i64) {
        var P8 = types.ptr_of(types.named(TK_I8))
        tig_ext_call1("FindClose", hf, P8, types.named(TK_I32))
    }
    func tig_is_dotname(n: i64) -> i64 {
        var l = s21_str_head_len(n)
        var e1 = tig_icmp_c(l, tig_int_lit(1), 0)
        var b0 = s21_str_byte(n, tig_int_lit(0))
        var d0c = tig_icmp_c(b0, tig_int_lit(0x2E), 0)
        var d1 = tig_and_i1(e1, d0c)
        var e2 = tig_icmp_c(l, tig_int_lit(2), 0)
        var b1 = s21_str_byte(n, tig_int_lit(1))
        var d1c = tig_icmp_c(b1, tig_int_lit(0x2E), 0)
        var d2 = tig_and_i1(e2, tig_and_i1(d0c, d1c))
        return tig_or_i1(d1, d2)
    }
    func tig_wide16_dbl(s: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I8 = types.named(TK_I8)
        var w = tig_wide16(s)
        var wlen = s21_str_head_len(w)
        var buf = s21_raw_alloc_str(s21_bin(0, wlen, tig_int_lit(1)))  // wlen+1（补第二个 NUL）
        s21_memcpy_if(buf, w, wlen)
        s21_store(s21_gep(buf, wlen, false), tig_int_lit_ty(0, I8), I8)
        return buf
    }
    func tig_sh_op(funcCode: i64, fromS: i64, toS: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var I8 = types.named(TK_I8)
        var P8 = types.ptr_of(I8)
        var fw = tig_wide16_dbl(fromS)
        var tw = tig_wide16_dbl(toS)
        var sb = s21_raw_alloc_str(tig_int_lit(56))
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, P8);  table_push(avs, sb)
        table_push(ats, I8);  table_push(avs, tig_int_lit_ty(0, I8))
        table_push(ats, T64); table_push(avs, tig_int_lit(56))
        tig_ext_call_typed("memset", ats, avs, -1)
        s21_store(s21_gep(sb, 8, true), tig_int_lit_ty(funcCode, I32), I32)
        s21_store(s21_gep(sb, 16, true), fw, types.named(TK_STR))
        s21_store(s21_gep(sb, 24, true), tw, types.named(TK_STR))
        s21_store(s21_gep(sb, 32, true), tig_int_lit_ty(0x614, I32), I32)  // SILENT|NOCONFIRM|NOCONFIRMMKDIR|NOERRORUI
        var ats2: table<i64> = table_new_i64()
        var avs2: table<i64> = table_new_i64()
        table_push(ats2, P8); table_push(avs2, sb)
        var rc = tig_ext_call_typed("SHFileOperationW", ats2, avs2, I32)
        tig_ext_call1("free", sb, types.named(TK_STR), -1)
        tig_ext_call1("free", fw, types.named(TK_STR), -1)
        tig_ext_call1("free", tw, types.named(TK_STR), -1)
        return tig_cmp_zero(rc, 0)
    }

    func tig_read_file(p: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var I8 = types.named(TK_I8)
        var P8 = types.ptr_of(I8)
        var pw = tig_wide16(p)
        var rslt = ir.new_inst(g_cur_block, 20, types.named(TK_STR))
        ir.add_operand(rslt, types.named(TK_STR), 2)
        var sv = ir.get_value(rslt)
        s21_store(sv, tig_str_lit(interner.intern("\"\"")), types.named(TK_STR))
        var h = tig_create_file_w(pw, tig_int_lit_ty(0x120089, I32), tig_int_lit_ty(3, I32))
        var szb = s21_raw_alloc_str(tig_int_lit(8))
        var ok1 = tig_ext_call2("GetFileSizeEx", h, P8, szb, P8, I32)
        var okb = tig_win_ok(ok1)
        var bOk = ir.new_block(g_cur_func, interner.intern("rd.ok"))
        var bFail = ir.new_block(g_cur_func, interner.intern("rd.f"))
        var bM = ir.new_block(g_cur_func, interner.intern("rd.m"))
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, okb, 0)
        ir.add_operand(cb, bOk, 1)
        ir.add_operand(cb, bFail, 1)
        g_cur_block = bFail
        tig_ext_call1("CloseHandle", h, P8, I32)
        var brf = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brf, bM, 1)
        g_cur_block = bOk
        var size = s21_load(szb, T64)
        var big = tig_cmp_const(size, 3, 0x7FFFFFFF, T64)
        var toread = tig_select_i(big, tig_int_lit(0x7FFFFFFF), size, T64)
        var buf = s21_raw_alloc_str(toread)
        var nrb = s21_raw_alloc_str(tig_int_lit(4))
        s21_store(s21_gep(nrb, 0, true), tig_int_lit_ty(0, I32), I32)
        var nullov = tig_null_ptr()
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, P8);  table_push(avs, h)
        table_push(ats, P8);  table_push(avs, buf)
        table_push(ats, I32); table_push(avs, tig_trunc_i32(toread))
        table_push(ats, P8);  table_push(avs, nrb)
        table_push(ats, P8);  table_push(avs, nullov)
        tig_ext_call_typed("ReadFile", ats, avs, I32)
        var nr = s21_zext(s21_load(nrb, I32), I32)
        s21_store(sv, tig_bytes_to_tie(buf, nr), types.named(TK_STR))
        tig_ext_call1("CloseHandle", h, P8, I32)
        tig_ext_call1("free", buf, types.named(TK_STR), -1)
        tig_ext_call1("free", nrb, types.named(TK_STR), -1)
        tig_ext_call1("free", szb, types.named(TK_STR), -1)
        var brk = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brk, bM, 1)
        g_cur_block = bM
        return s21_load(sv, types.named(TK_STR))
    }
    func tig_write_file(p: i64, c: i64, append: bool) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var P8 = types.ptr_of(types.named(TK_I8))
        var pw = tig_wide16(p)
        var acc = tig_int_lit_ty(0x120116, I32)   // FILE_GENERIC_WRITE
        var dsp = tig_int_lit_ty(2, I32)          // CREATE_ALWAYS
        if append {
            acc = tig_int_lit_ty(0x0004, I32)     // FILE_APPEND_DATA
            dsp = tig_int_lit_ty(4, I32)          // OPEN_ALWAYS
        }
        var slt = ir.new_inst(g_cur_block, 20, I32)
        ir.add_operand(slt, I32, 2)
        var rsv = ir.get_value(slt)
        s21_store(rsv, tig_int_lit_ty(0, I32), I32)
        var h = tig_create_file_w(pw, acc, dsp)
        var hok = tig_icmp_c(tig_p2i(h), tig_int_lit(-1), 1)
        var bOk = ir.new_block(g_cur_func, interner.intern("wr.ok"))
        var bFail = ir.new_block(g_cur_func, interner.intern("wr.f"))
        var bM = ir.new_block(g_cur_func, interner.intern("wr.m"))
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, hok, 0)
        ir.add_operand(cb, bOk, 1)
        ir.add_operand(cb, bFail, 1)
        g_cur_block = bFail
        var brf = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brf, bM, 1)
        g_cur_block = bOk
        var dlen = s21_str_head_len(c)
        var data = c
        var nwb = s21_raw_alloc_str(tig_int_lit(4))
        s21_store(s21_gep(nwb, 0, true), tig_int_lit_ty(0, I32), I32)
        var nullov = tig_null_ptr()
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, P8);  table_push(avs, h)
        table_push(ats, P8);  table_push(avs, data)
        table_push(ats, I32); table_push(avs, tig_trunc_i32(dlen))
        table_push(ats, P8);  table_push(avs, nwb)
        table_push(ats, P8);  table_push(avs, nullov)
        var wr = tig_ext_call_typed("WriteFile", ats, avs, I32)
        tig_ext_call1("CloseHandle", h, P8, I32)
        tig_ext_call1("free", nwb, types.named(TK_STR), -1)
        s21_store(rsv, wr, I32)
        var brw = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brw, bM, 1)
        g_cur_block = bM
        return tig_win_ok(s21_load(rsv, I32))
    }

    func tig_attr_invalid(a: i64) -> i64 {
        var I32 = types.named(TK_I32)
        return tig_icmp_c(a, tig_int_lit_ty(-1, I32), 0)
    }
    func tig_exists_inline(p: i64) -> i64 {
        return tig_not_i1(tig_attr_invalid(tig_file_attr_w(p)))
    }
    func tig_is_dir_inline(p: i64) -> i64 {
        var I32 = types.named(TK_I32)
        var a = tig_file_attr_w(p)
        var a6 = s21_zext(a, I32)
        var dirf = tig_icmp_c(s21_bin(6, a6, tig_int_lit(0x10)), tig_int_lit(0), 1)
        return tig_and_i1(tig_not_i1(tig_attr_invalid(a)), dirf)
    }
    func tig_is_file_inline(p: i64) -> i64 {
        var I32 = types.named(TK_I32)
        var a = tig_file_attr_w(p)
        var a6 = s21_zext(a, I32)
        var dirf = tig_icmp_c(s21_bin(6, a6, tig_int_lit(0x10)), tig_int_lit(0), 1)
        return tig_and_i1(tig_not_i1(tig_attr_invalid(a)), tig_not_i1(dirf))
    }
    func tig_size_inline(p: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var P8 = types.ptr_of(types.named(TK_I8))
        var pw = tig_wide16(p)
        var h = tig_create_file_w(pw, tig_int_lit_ty(0x120089, I32), tig_int_lit_ty(3, I32))
        var szb = s21_raw_alloc_str(tig_int_lit(8))
        var ok1 = tig_ext_call2("GetFileSizeEx", h, P8, szb, P8, I32)
        var okb = tig_win_ok(ok1)
        var slt = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(slt, T64, 2)
        var sv = ir.get_value(slt)
        s21_store(sv, tig_int_lit(-1), T64)
        var bOk = ir.new_block(g_cur_func, interner.intern("sz.ok"))
        var bFail = ir.new_block(g_cur_func, interner.intern("sz.f"))
        var bM = ir.new_block(g_cur_func, interner.intern("sz.m"))
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, okb, 0)
        ir.add_operand(cb, bOk, 1)
        ir.add_operand(cb, bFail, 1)
        g_cur_block = bFail
        tig_ext_call1("CloseHandle", h, P8, I32)
        var brf = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brf, bM, 1)
        g_cur_block = bOk
        s21_store(sv, s21_load(szb, T64), T64)
        tig_ext_call1("CloseHandle", h, P8, I32)
        var brk = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brk, bM, 1)
        g_cur_block = bM
        tig_ext_call1("free", szb, types.named(TK_STR), -1)
        return s21_load(sv, T64)
    }
    func tig_delete_inline(p: i64) -> i64 {
        var I32 = types.named(TK_I32)
        var P8 = types.ptr_of(types.named(TK_I8))
        var pw = tig_wide16(p)
        return tig_win_ok(tig_ext_call1("DeleteFileW", pw, P8, I32))
    }
    func tig_copy_file(a: i64, b: i64) -> i64 {
        var I32 = types.named(TK_I32)
        var P8 = types.ptr_of(types.named(TK_I8))
        var aw = tig_wide16(a)
        var bw = tig_wide16(b)
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, P8);  table_push(avs, aw)
        table_push(ats, P8);  table_push(avs, bw)
        table_push(ats, I32); table_push(avs, tig_int_lit_ty(0, I32))  // bFailIfExists=0
        var r = tig_ext_call_typed("CopyFileW", ats, avs, I32)
        return tig_win_ok(r)
    }
    func tig_move_file(a: i64, b: i64) -> i64 {
        var I32 = types.named(TK_I32)
        var P8 = types.ptr_of(types.named(TK_I8))
        var aw = tig_wide16(a)
        var bw = tig_wide16(b)
        return tig_win_ok(tig_ext_call2("MoveFileW", aw, P8, bw, P8, I32))
    }
    func tig_mkdir_all(p: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var pn = s21_str_head_len(p)
        var islt = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(islt, T64, 2)
        var isv = ir.get_value(islt)
        s21_store(isv, tig_int_lit(0), T64)
        var hd = ir.new_block(g_cur_func, interner.intern("mk.h"))
        var bd2 = ir.new_block(g_cur_func, interner.intern("mk.b"))
        var ex = ir.new_block(g_cur_func, interner.intern("mk.x"))
        var br0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br0, hd, 1)
        g_cur_block = hd
        var ic = tig_icmp_c(s21_load(isv, T64), pn, 2)
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, ic, 0)
        ir.add_operand(cb, bd2, 1)
        ir.add_operand(cb, ex, 1)
        g_cur_block = bd2
        var iv = s21_load(isv, T64)
        var b = s21_str_byte(p, iv)
        var issep = tig_or_i1(tig_icmp_c(b, tig_int_lit(0x2F), 0), tig_icmp_c(b, tig_int_lit(0x5C), 0))
        var bSep = ir.new_block(g_cur_func, interner.intern("mk.sep"))
        var bNo = ir.new_block(g_cur_func, interner.intern("mk.no"))
        var bInc = ir.new_block(g_cur_func, interner.intern("mk.inc"))
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, issep, 0)
        ir.add_operand(cb2, bSep, 1)
        ir.add_operand(cb2, bNo, 1)
        g_cur_block = bSep
        var pref = s21_str_sub_bytes(p, tig_int_lit(0), iv)
        var pf = tig_icmp_c(s21_str_head_len(pref), tig_int_lit(0), 3)
        var bP = ir.new_block(g_cur_func, interner.intern("mk.p"))
        var bPe = ir.new_block(g_cur_func, interner.intern("mk.pe"))
        var cb3 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb3, pf, 0)
        ir.add_operand(cb3, bP, 1)
        ir.add_operand(cb3, bPe, 1)
        g_cur_block = bP
        tig_mkdir_w(tig_wide16(pref))
        var brp = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brp, bPe, 1)
        g_cur_block = bPe
        var brs = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brs, bInc, 1)
        g_cur_block = bNo
        var brn = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brn, bInc, 1)
        g_cur_block = bInc
        s21_store(isv, s21_bin(0, iv, tig_int_lit(1)), T64)
        var brb = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brb, hd, 1)
        g_cur_block = ex
        tig_mkdir_w(tig_wide16(p))
        return tig_bool_lit(1)
    }
    func tig_remove_dir_all(p: i64) -> i64 {
        return tig_sh_op(3, p, p)
    }

    // copy_dir(src, dst)：迭代式递归复制（src/dst 成对工作清单，无递归函数）。
    // 每个目录：先建 dst 目录，遍历 src 直接条目——文件 CopyFileW，子目录建目并
    // 压入工作清单继续。UTF-16 路径安全。整体成功 → i1 true。
    func tig_copy_dir(a: i64, b: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var I8 = types.named(TK_I8)
        var P8 = types.ptr_of(I8)
        // src/dst 成对工作清单（增长式字符串数组）
        var srcW = s21_raw_alloc_str(tig_int_lit(24))
        s21_store(s21_gep(srcW, 0, true), tig_int_lit(0), T64)
        s21_store(s21_gep(srcW, 8, true), tig_int_lit(0), T64)
        s21_store(s21_gep(srcW, 16, true), tig_int_lit(0), types.named(TK_STR))
        var dstW = s21_raw_alloc_str(tig_int_lit(24))
        s21_store(s21_gep(dstW, 0, true), tig_int_lit(0), T64)
        s21_store(s21_gep(dstW, 8, true), tig_int_lit(0), T64)
        s21_store(s21_gep(dstW, 16, true), tig_int_lit(0), types.named(TK_STR))
        tig_blob_push(srcW, a)
        tig_blob_push(dstW, b)
        tig_mkdir_w(tig_wide16(b))  // 根 dst 目录
        // 外层循环：while srcW.len > 0
        var hd = ir.new_block(g_cur_func, interner.intern("cd.h"))
        var bd4 = ir.new_block(g_cur_func, interner.intern("cd.b"))
        var ex = ir.new_block(g_cur_func, interner.intern("cd.x"))
        var br0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br0, hd, 1)
        g_cur_block = hd
        var sl0 = s21_load(s21_gep(srcW, 8, true), T64)
        var sgt = tig_icmp_c(sl0, tig_int_lit(0), 3)
        var cb0 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb0, sgt, 0)
        ir.add_operand(cb0, bd4, 1)
        ir.add_operand(cb0, ex, 1)
        // body：弹出成对 (s, d)
        g_cur_block = bd4
        var sl1 = s21_load(s21_gep(srcW, 8, true), T64)
        var srcs = s21_load(s21_gep(srcW, 16, true), types.named(TK_STR))
        var s = s21_load(s21_gep(srcs, s21_bin(2, s21_bin(1, sl1, tig_int_lit(1)), tig_int_lit(8)), false), types.named(TK_STR))
        s21_store(s21_gep(srcW, 8, true), s21_bin(1, sl1, tig_int_lit(1)), T64)
        var dl1 = s21_load(s21_gep(dstW, 8, true), T64)
        var dsts = s21_load(s21_gep(dstW, 16, true), types.named(TK_STR))
        var d = s21_load(s21_gep(dsts, s21_bin(2, s21_bin(1, dl1, tig_int_lit(1)), tig_int_lit(8)), false), types.named(TK_STR))
        s21_store(s21_gep(dstW, 8, true), s21_bin(1, dl1, tig_int_lit(1)), T64)
        // 创建当前 dst 目录（已存在则忽略）
        tig_mkdir_w(tig_wide16(d))
        // 遍历 src 目录条目
        var pw = tig_wide16(tig_wildpath(s))
        var fd = s21_raw_alloc_str(tig_int_lit(592))
        var hf = tig_find_first_w(pw, fd)
        var inv = tig_icmp_c(tig_p2i(hf), tig_int_lit(-1), 0)
        var bInv2 = ir.new_block(g_cur_func, interner.intern("cd.iv"))
        var bMv2 = ir.new_block(g_cur_func, interner.intern("cd.mv"))
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, inv, 0)
        ir.add_operand(cb, bInv2, 1)
        ir.add_operand(cb, bMv2, 1)
        g_cur_block = bInv2
        tig_ext_call1("free", fd, types.named(TK_STR), -1)
        var brb = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brb, hd, 1)
        // 内层循环
        g_cur_block = bMv2
        var top = ir.new_block(g_cur_func, interner.intern("cd.t"))
        var bri = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bri, top, 1)
        g_cur_block = top
        var name = tig_from_wide16(s21_gep(fd, 44, true))
        var ndw = tig_not_i1(tig_is_dotname(name))
        var bPr2 = ir.new_block(g_cur_func, interner.intern("cd.pr"))
        var bSk2 = ir.new_block(g_cur_func, interner.intern("cd.sp"))
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, ndw, 0)
        ir.add_operand(cb2, bPr2, 1)
        ir.add_operand(cb2, bSk2, 1)
        g_cur_block = bPr2
        var sItem = tig_join_path(s, name)
        var dItem = tig_join_path(d, name)
        var attr = s21_zext(s21_load(s21_gep(fd, 0, true), I32), I32)
        var dirf = tig_icmp_c(s21_bin(6, attr, tig_int_lit(0x10)), tig_int_lit(0), 1)
        var bAd3 = ir.new_block(g_cur_func, interner.intern("cd.ad"))
        var bDir = ir.new_block(g_cur_func, interner.intern("cd.dr"))
        var bFil = ir.new_block(g_cur_func, interner.intern("cd.fl"))
        var cb3 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb3, dirf, 0)
        ir.add_operand(cb3, bDir, 1)
        ir.add_operand(cb3, bFil, 1)
        // 子目录：建 dst 子目录 + 压入工作清单
        g_cur_block = bDir
        tig_mkdir_w(tig_wide16(dItem))
        tig_blob_push(srcW, sItem)
        tig_blob_push(dstW, dItem)
        var brd = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brd, bAd3, 1)
        // 文件：CopyFileW(sItem, dItem, 0)
        g_cur_block = bFil
        var sw = tig_wide16(sItem)
        var dw = tig_wide16(dItem)
        var ats: table<i64> = table_new_i64()
        var avs: table<i64> = table_new_i64()
        table_push(ats, P8);  table_push(avs, sw)
        table_push(ats, P8);  table_push(avs, dw)
        table_push(ats, I32); table_push(avs, tig_int_lit_ty(0, I32))
        tig_ext_call_typed("CopyFileW", ats, avs, I32)
        var brf2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brf2, bAd3, 1)
        g_cur_block = bSk2
        var brs = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brs, bAd3, 1)
        // adv + 推进
        g_cur_block = bAd3
        var cont = tig_win_ok(tig_find_next_w(hf, fd))
        var bEnd = ir.new_block(g_cur_func, interner.intern("cd.en"))
        var cb4 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb4, cont, 0)
        ir.add_operand(cb4, top, 1)
        ir.add_operand(cb4, bEnd, 1)
        g_cur_block = bEnd
        tig_find_close(hf)
        tig_ext_call1("free", fd, types.named(TK_STR), -1)
        var brh = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brh, hd, 1)
        // 完成：整体成功
        g_cur_block = ex
        return tig_bool_lit(1)
    }

    func tig_list_dir(p: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var P8 = types.ptr_of(types.named(TK_I8))
        var pw = tig_wide16(tig_wildpath(p))
        var fd = s21_raw_alloc_str(tig_int_lit(592))
        var hf = tig_find_first_w(pw, fd)
        var inv = tig_icmp_c(tig_p2i(hf), tig_int_lit(-1), 0)
        var rslt = ir.new_inst(g_cur_block, 20, types.named(TK_STR))
        ir.add_operand(rslt, types.named(TK_STR), 2)
        var sv = ir.get_value(rslt)
        s21_store(sv, tig_fill_table(s21_raw_alloc_str(tig_int_lit(8)), tig_int_lit(0), tig_int_lit(0)), types.named(TK_STR))
        var bBad = ir.new_block(g_cur_func, interner.intern("ls.bad"))
        var bC = ir.new_block(g_cur_func, interner.intern("ls.c"))
        var bM = ir.new_block(g_cur_func, interner.intern("ls.m"))
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, inv, 0)
        ir.add_operand(cb, bBad, 1)
        ir.add_operand(cb, bC, 1)
        g_cur_block = bBad
        tig_ext_call1("free", fd, types.named(TK_STR), -1)
        var brb = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brb, bM, 1)
        g_cur_block = bC
        var cnt = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(cnt, T64, 2)
        var cslot = ir.get_value(cnt)
        s21_store(cslot, tig_int_lit(0), T64)
        var top = ir.new_block(g_cur_func, interner.intern("ls.t"))
        var brc = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brc, top, 1)
        g_cur_block = top
        var nm = tig_from_wide16(s21_gep(fd, 44, true))
        var ndv = tig_not_i1(tig_is_dotname(nm))
        var bInc = ir.new_block(g_cur_func, interner.intern("ls.inc"))
        var bSkip = ir.new_block(g_cur_func, interner.intern("ls.sk"))
        var bAdv = ir.new_block(g_cur_func, interner.intern("ls.adv"))
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, ndv, 0)
        ir.add_operand(cb2, bInc, 1)
        ir.add_operand(cb2, bSkip, 1)
        g_cur_block = bInc
        s21_store(cslot, s21_bin(0, s21_load(cslot, T64), tig_int_lit(1)), T64)
        var bri = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bri, bAdv, 1)
        g_cur_block = bSkip
        var brs = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brs, bAdv, 1)
        g_cur_block = bAdv
        var cont = tig_win_ok(tig_find_next_w(hf, fd))
        var bDone = ir.new_block(g_cur_func, interner.intern("ls.done"))
        var cb3 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb3, cont, 0)
        ir.add_operand(cb3, top, 1)
        ir.add_operand(cb3, bDone, 1)
        g_cur_block = bDone
        var n = s21_load(cslot, T64)
        var data = s21_raw_alloc_str(s21_bin(2, n, tig_int_lit(8)))
        tig_find_close(hf)
        var hf2 = tig_find_first_w(pw, fd)
        var idx = ir.new_inst(g_cur_block, 20, T64)
        ir.add_operand(idx, T64, 2)
        var islot = ir.get_value(idx)
        s21_store(islot, tig_int_lit(0), T64)
        var top2 = ir.new_block(g_cur_func, interner.intern("ls.t2"))
        var brc2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brc2, top2, 1)
        g_cur_block = top2
        var nm2 = tig_from_wide16(s21_gep(fd, 44, true))
        var nd2 = tig_not_i1(tig_is_dotname(nm2))
        var bFill = ir.new_block(g_cur_func, interner.intern("ls.fil"))
        var bSkp = ir.new_block(g_cur_func, interner.intern("ls.s2"))
        var bAd2 = ir.new_block(g_cur_func, interner.intern("ls.a2"))
        var cb4 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb4, nd2, 0)
        ir.add_operand(cb4, bFill, 1)
        ir.add_operand(cb4, bSkp, 1)
        g_cur_block = bFill
        var iv2 = s21_load(islot, T64)
        s21_store(s21_gep(data, s21_bin(2, iv2, tig_int_lit(8)), false), nm2, types.named(TK_STR))
        s21_store(islot, s21_bin(0, iv2, tig_int_lit(1)), T64)
        var brf2 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brf2, bAd2, 1)
        g_cur_block = bSkp
        var brj = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brj, bAd2, 1)
        g_cur_block = bAd2
        var cont2 = tig_win_ok(tig_find_next_w(hf2, fd))
        var bMat = ir.new_block(g_cur_func, interner.intern("ls.mt"))
        var cb5 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb5, cont2, 0)
        ir.add_operand(cb5, top2, 1)
        ir.add_operand(cb5, bMat, 1)
        g_cur_block = bMat
        s21_store(sv, tig_fill_table(data, n, s21_load(islot, T64)), types.named(TK_STR))
        tig_find_close(hf2)
        tig_ext_call1("free", fd, types.named(TK_STR), -1)
        var brd = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brd, bM, 1)
        g_cur_block = bM
        return s21_load(sv, types.named(TK_STR))
    }

    func tig_blob_push(bhp: i64, sp: i64) {
        var T64 = types.named(TK_I64)
        var cap = s21_load(s21_gep(bhp, 0, true), T64)
        var lenn = s21_load(s21_gep(bhp, 8, true), T64)
        var data = s21_load(s21_gep(bhp, 16, true), types.named(TK_STR))
        var need = s21_bin(0, lenn, tig_int_lit(1))
        var gc = tig_icmp_c(need, cap, 3)
        var gt = ir.new_block(g_cur_func, interner.intern("bp.gt"))
        var ge = ir.new_block(g_cur_func, interner.intern("bp.ge"))
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, gc, 0)
        ir.add_operand(cb, gt, 1)
        ir.add_operand(cb, ge, 1)
        g_cur_block = gt
        var nc = tig_select_i(tig_cmp_zero(cap, 0), tig_int_lit(4), s21_bin(2, cap, tig_int_lit(2)), T64)
        var c_lt = tig_icmp_c(nc, need, 2)
        var newcap = tig_select_i(c_lt, need, nc, T64)
        var nd = s21_raw_alloc_str(s21_bin(2, newcap, tig_int_lit(8)))
        s21_memcpy_if(nd, data, s21_bin(2, lenn, tig_int_lit(8)))
        tig_ext_call1("free", data, types.named(TK_STR), -1)
        s21_store(s21_gep(bhp, 16, true), nd, types.named(TK_STR))
        s21_store(s21_gep(bhp, 0, true), newcap, T64)
        var brg = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brg, ge, 1)
        g_cur_block = ge
        var data2 = s21_load(s21_gep(bhp, 16, true), types.named(TK_STR))
        var l2 = s21_load(s21_gep(bhp, 8, true), T64)
        s21_store(s21_gep(data2, s21_bin(2, l2, tig_int_lit(8)), false), sp, types.named(TK_STR))
        s21_store(s21_gep(bhp, 8, true), need, T64)
    }

    func tig_walk_dir(p: i64) -> i64 {
        var T64 = types.named(TK_I64)
        var I32 = types.named(TK_I32)
        var I8 = types.named(TK_I8)
        var P8 = types.ptr_of(I8)
        var rslt = ir.new_inst(g_cur_block, 20, types.named(TK_STR))
        ir.add_operand(rslt, types.named(TK_STR), 2)
        var sv = ir.get_value(rslt)
        // 结果表 blob（增长式字符串指针数组）
        var rbh = s21_raw_alloc_str(tig_int_lit(24))
        s21_store(s21_gep(rbh, 0, true), tig_int_lit(0), T64)
        s21_store(s21_gep(rbh, 8, true), tig_int_lit(0), T64)
        s21_store(s21_gep(rbh, 16, true), tig_int_lit(0), types.named(TK_STR))
        // 目录工作清单 blob（迭代式 DFS，避免生成中途嵌套递归函数）
        var wbh = s21_raw_alloc_str(tig_int_lit(24))
        s21_store(s21_gep(wbh, 0, true), tig_int_lit(0), T64)
        s21_store(s21_gep(wbh, 8, true), tig_int_lit(0), T64)
        s21_store(s21_gep(wbh, 16, true), tig_int_lit(0), types.named(TK_STR))
        tig_blob_push(wbh, p)  // 种子：根目录
        // 外层循环：while work.len > 0
        var hd = ir.new_block(g_cur_func, interner.intern("wk.h"))
        var bd3 = ir.new_block(g_cur_func, interner.intern("wk.b"))
        var ex = ir.new_block(g_cur_func, interner.intern("wk.x"))
        var br0 = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(br0, hd, 1)
        g_cur_block = hd
        var wl = s21_load(s21_gep(wbh, 8, true), T64)
        var wgt = tig_icmp_c(wl, tig_int_lit(0), 3)  // wl > 0
        var cb0 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb0, wgt, 0)
        ir.add_operand(cb0, bd3, 1)
        ir.add_operand(cb0, ex, 1)
        // body：弹出工作清单栈顶目录
        g_cur_block = bd3
        var wld = s21_load(s21_gep(wbh, 8, true), T64)
        var wdat = s21_load(s21_gep(wbh, 16, true), types.named(TK_STR))
        var popdir = s21_load(s21_gep(wdat, s21_bin(2, s21_bin(1, wld, tig_int_lit(1)), tig_int_lit(8)), false), types.named(TK_STR))
        s21_store(s21_gep(wbh, 8, true), s21_bin(1, wld, tig_int_lit(1)), T64)
        // 列出该目录的直接条目
        var pw = tig_wide16(tig_wildpath(popdir))
        var fd = s21_raw_alloc_str(tig_int_lit(592))
        var hf = tig_find_first_w(pw, fd)
        var inv = tig_icmp_c(tig_p2i(hf), tig_int_lit(-1), 0)
        var bInvb = ir.new_block(g_cur_func, interner.intern("wk.iv"))
        var bMv = ir.new_block(g_cur_func, interner.intern("wk.mv"))
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, inv, 0)
        ir.add_operand(cb, bInvb, 1)
        ir.add_operand(cb, bMv, 1)
        g_cur_block = bInvb
        tig_ext_call1("free", fd, types.named(TK_STR), -1)
        var brb = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brb, hd, 1)  // 空目录 → 回外层循环
        // 内层循环：遍历条目
        g_cur_block = bMv
        var top = ir.new_block(g_cur_func, interner.intern("wk.t"))
        var bri = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(bri, top, 1)
        g_cur_block = top
        var name = tig_from_wide16(s21_gep(fd, 44, true))
        var ndw = tig_not_i1(tig_is_dotname(name))
        var bProc = ir.new_block(g_cur_func, interner.intern("wk.pr"))
        var bSkp = ir.new_block(g_cur_func, interner.intern("wk.sp"))
        var cb2 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb2, ndw, 0)
        ir.add_operand(cb2, bProc, 1)
        ir.add_operand(cb2, bSkp, 1)
        g_cur_block = bProc
        var full = tig_join_path(popdir, name)
        tig_blob_push(rbh, full)
        var attr = s21_zext(s21_load(s21_gep(fd, 0, true), I32), I32)
        var dirf = tig_icmp_c(s21_bin(6, attr, tig_int_lit(0x10)), tig_int_lit(0), 1)
        var bPush2 = ir.new_block(g_cur_func, interner.intern("wk.ps"))
        var bAd = ir.new_block(g_cur_func, interner.intern("wk.ad"))
        var cb3 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb3, dirf, 0)
        ir.add_operand(cb3, bPush2, 1)
        ir.add_operand(cb3, bAd, 1)
        g_cur_block = bPush2
        tig_blob_push(wbh, full)  // 子目录压入工作清单
        var brp = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brp, bAd, 1)
        g_cur_block = bSkp
        var brs = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brs, bAd, 1)
        g_cur_block = bAd
        var cont = tig_win_ok(tig_find_next_w(hf, fd))
        var bEnd = ir.new_block(g_cur_func, interner.intern("wk.en"))
        var cb4 = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb4, cont, 0)
        ir.add_operand(cb4, top, 1)
        ir.add_operand(cb4, bEnd, 1)
        g_cur_block = bEnd
        tig_find_close(hf)
        tig_ext_call1("free", fd, types.named(TK_STR), -1)
        var brh = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(brh, hd, 1)  // 该目录遍历完 → 回外层循环
        // 外层循环结束：组装结果表
        g_cur_block = ex
        var cap = s21_load(s21_gep(rbh, 0, true), T64)
        var lenn = s21_load(s21_gep(rbh, 8, true), T64)
        var dat = s21_load(s21_gep(rbh, 16, true), types.named(TK_STR))
        s21_store(sv, tig_fill_table(dat, cap, lenn), types.named(TK_STR))
        return s21_load(sv, types.named(TK_STR))
    }
}