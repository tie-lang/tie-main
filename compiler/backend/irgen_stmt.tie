type tie<class>
// compiler/backend/irgen_stmt.tie —— 生成器 L4 语句/控制流层 子模块
// ============================================================
// 从 irgen.tie 拆分而来：这是 irgen LLVM 风格分层重构的 S5（第五步）。
// 本文件承载 L4 语句/控制流层：语句主调度器 tig_stmt、switch（tig_switch）、
// for 遍历（tig_for_chars/tig_for_table）、索引读写（tig_index_read/
// tig_index_assign）、打印（tig_println）、块语句（tig_block_stmts）、
// 变量引用收集（find_var_refs/collect_var_refs）等。
//
// 拆分范式：【同 namespace 跨文件】（文本内联）。
// 同 irgen_arith.tie（S3）/ irgen_expr.tie（S4）。irgen.tie 顶层 import 本文件
// 后，本文件被文本内联进同一编译单元，声明与 irgen.tie 相同的 `namespace irgen`，
// 同名 namespace 跨文件闭合并集：
//   - 同 namespace 函数可互相裸名调用（主文件照常裸名调用 tig_stmt 等）；
//   - 可访问主文件顶层全局 var（g_cur_block/g_cur_func/node_types/s_tags 等）；
//   - 本文件只含函数与注释，不含顶层全局 var 声明、不含 import——
//     全局 var 与 import 树均留在 irgen.tie 主文件，避免重复定义。
namespace irgen {
// 表下标读取 t[i]：动态表 → tie_table_at_<suffix>(表指针, i64, ok)。
// 简化（阶段 A）：不生成越界检查块（driver 树索引均有 len 守卫）。
func tig_index_read(id: i64) -> i64 {
    var base = sstate.child(id, 0)
    var idx = sstate.child(id, 1)
    var t = tig_expr(base)
    if t < 0 {
        return -1
    }
    var iv = tig_expr(idx)
    if iv < 0 {
        return -1
    }
    // E3 键值表读取：m[key] → tie_map_get / tie_map_get_string（键为字符串 ptr）。
    // base 类型是 map（作用域变量类型优先，其次 node_types）→ 走 map 桥，
    // 与 Rust 基线 ir.rs tig_index_assign 的 map 分支同构（tie_map_* 专用桥）。
    var base_is_map: bool = false
    var map_val_ty: i64 = types.named(TK_I64)
    if s_tags[base] == 6 {
        var bn_rd = interner.intern(sstate.name_str(base))
        if scope_get(bn_rd) >= 0 && types.is_map(g_lookup_ty) {
            base_is_map = true
            map_val_ty = types.low(g_lookup_ty)
        }
    }
    if !base_is_map {
        var bt_m = node_types[base]
        if types.is_map(bt_m) {
            base_is_map = true
            map_val_ty = types.low(bt_m)
        }
    }
    if base_is_map {
        // 裸 map（id == BASE_MAP，low 解码为 0）默认 i64 值；map<string> → string 值
        if map_val_ty <= 0 {
            map_val_ty = types.named(TK_I64)
        }
        var mret = types.named(TK_I64)
        if map_val_ty == types.named(TK_STR) {
            mret = types.named(TK_STR)
        } else if map_val_ty == types.named(TK_ANY) {
            // P2c：map<any> 读——值槽存堆指针 → 读指针 → 从堆还原 {i64,i64} any
            var hp = s21_map_get(t, iv, types.named(TK_STR))
            return s21_load(hp, types.named(TK_ANY))
        }
        // 批次 7：内联二分/哈希读（替代 tie_map_get 桥）；缺失键 → 运行时错误
        return s21_map_get(t, iv, mret)
    }
    // 元素类型：base 是表变量 → 优先 irgen 作用域完整类型（参数/局部表变量），
    // 其次 node_types（semantic 持久节点类型），最后 var_table_elem
    //（sinfer.lv_telem 每函数重置，irgen 阶段只能查到最后一个函数——不可靠）
    var elem: i64 = types.named(TK_I64)
    if s_tags[base] == 6 {
        var bname = interner.intern(sstate.name_str(base))
        var matched: bool = false
        // irgen 自维护表变量元素类型（table_new_f64() 变量；语义层 lv_telem
        // 已过期）——最高优先级，f64 表读取必须选 at_f64 桥
        var tv0 = tblvar_get(bname)
        if tv0 >= 0 {
            elem = tv0
            matched = true
        }
        if !matched && scope_get(bname) >= 0 && types.is_table(g_lookup_ty) {
            var le = types.table_elem(g_lookup_ty)
            if le > 0 {
                elem = le
                matched = true
            }
        }
        if !matched {
            var bt2 = node_types[base]
            if types.is_table(bt2) {
                var le2 = types.table_elem(bt2)
                if le2 > 0 {
                    elem = le2
                    matched = true
                }
            }
        }
        if !matched {
            var te = sinfer.var_table_elem(bname)
            if te >= 0 {
                elem = te
                matched = true
            }
        }
        if !matched {
            // 最后 fallback：索引表达式的语义推断类型（裸 table 元素未知时，
            // semantic 按上下文推断——join 里 parts[i] 用于拼接 → TK_STR）
            var nt = node_types[id]
            if nt >= 0 && (nt == types.named(TK_STR) || types.is_int(nt) ||
                types.is_float(nt) || types.is_bool_like(nt)) {
                elem = nt
            }
        }
    } else {
        var bt = node_types[base]
        if types.is_table(bt) {
            var te2 = types.table_elem(bt)
            if te2 > 0 {
                elem = te2
            }
        }
    }
    var suffix = bridge_suffix(elem)
    var ret_ty = types.named(TK_I64)
    // P2a 复合元素（struct/enum/fn）：返回类型 = 元素类型 id（多字元素类型化
    // load，供字段访问/方法调用/整体使用）
    var ekind2 = types.kind(elem)
    if ekind2 == K_STRUCT || ekind2 == K_ENUM || ekind2 == K_FN || elem == types.named(TK_ANY) {
        ret_ty = elem
    } else if types.is_table(elem) || types.is_map(elem) || types.kind(elem) == K_PORT {
        suffix = "string"
        ret_ty = elem
    } else if suffix == "string" {
        ret_ty = types.named(TK_STR)
    } else if suffix == "f64" {
        // f64 表元素：返回类型 double（曾落默认 i64 → call i64 @tie_table_at_f64
        // 与 declare double 返回不匹配）
        ret_ty = types.named(TK_F64)
    } else if suffix == "bool" {
        ret_ty = types.named(TK_BOOL)
    }
    // ok 出参槽（越界标志；读越界置 ok=0 并返回元素零值）
    var ok_slot = ir.new_inst(g_cur_block, 20, types.named(TK_I8))  // alloca i8
    ir.add_operand(ok_slot, types.named(TK_I8), 2)
    var ok_addr = ir.get_value(ok_slot)
    return s21_table_at(t, iv, ok_addr, ret_ty)
}

// p.6.10.2 步2：表句柄引用计数插桩辅助——生成 tl_tbl$tbl_retain / tl_tbl$tbl_release
// 桥调用（trm_lite.a 静态链接；表变量赋值/覆盖时保持别名计数守恒，防悬垂与双释放）。
// 参数 hv = 表句柄指令值（LLVM ptr，表槽指针）。桥形参为 i64（x64 ABI 指针复用
// 整数 8 字节通道）——先 ptrtoint（opcode 24）转 i64 再按 TK_I64 发射实参，
// 保证 call void @tl_tbl$tbl_retain(i64 %N) 与符号签名类型匹配。
func tig_tbl_retain_call(hv: i64) -> i64 {
    g_used_trmlite = true
    var hv64 = ir.new_inst(g_cur_block, 24, types.named(TK_I64))
    ir.add_operand(hv64, hv, 0)
    var atys = table_new_i64()
    var avs = table_new_i64()
    table_push(atys, types.named(TK_I64))
    table_push(avs, ir.get_value(hv64))
    return tig_trmlite_call("tl_tbl$tbl_retain", atys, avs, -1)
}
func tig_tbl_release_call(hv: i64) -> i64 {
    g_used_trmlite = true
    var hv64 = ir.new_inst(g_cur_block, 24, types.named(TK_I64))
    ir.add_operand(hv64, hv, 0)
    var atys = table_new_i64()
    var avs = table_new_i64()
    table_push(atys, types.named(TK_I64))
    table_push(avs, ir.get_value(hv64))
    return tig_trmlite_call("tl_tbl$tbl_release", atys, avs, -1)
}

// 名称是否登记为参数（表参数借用语义：不析构、覆盖不 release——所有权在调用方）。
func tig_is_param(nid: i64) -> bool {
    var i: i64 = 0
    while i < len(g_param_nids) {
        if g_param_nids[i] == nid {
            return true
        }
        i = i + 1
    }
    return false
}

// p.6.10.3：函数出口析构——释放 entry 级局部表变量（候选 alloca 清单）。引用计数由
// 外传点（return/全局/赋值）retain 守恒，此处仅为收尾。仅 entry 级候选（循环/分支
// 内 var 排除：非 entry 块的 alloca 在出口块 load 不满足支配关系）。空槽由 tbl_release
// 空句柄守卫跳过。
func tig_tbl_exit_release() {
    var i: i64 = 0
    while i < len(g_tblcand_allocas) {
        var old = ir.new_inst(g_cur_block, 21, types.named(TK_STR))  // load ptr
        ir.add_operand(old, g_tblcand_allocas[i], 0)
        tig_tbl_release_call(ir.get_value(old))
        i = i + 1
    }
}

// p.6.10.4：循环/分支内表变量自遮蔽——非 entry 块声明的表变量，槽在回边重执行时被
// `store 新表` 覆盖上一迭代表 → 旧引用丢失泄漏。解法：每个此类声明配一个**零值全局**
// 哨兵（天然首值 0 / 由 global_scalar_init 归零），首次进入跳 release（槽未初始化，
// 直接 load 即崩）；回边重写时哨兵已置 1 → release 槽内上一轮表。**用 select 把 release
// 实参归零、不分裂控制流块**（tbl_release(0) 运行时守卫跳过）——避免块分裂破坏
// 支配关系（实测分裂块在大型自举代码中触发 LLVM「instruction does not dominate」）。
func tig_loopvar_release(av: i64) {
    g_tf_ctr = g_tf_ctr + 1
    var fname = "tl_loopf_" + to_string(g_tf_ctr)
    llvmgen.global_scalar_reg(fname, types.named(TK_I64))
    // 显式置零初值（llvmgen 标量默认 -1 哨兵，须归 0 让「首次」判定成立）
    llvmgen.global_scalar_init(fname, 0)
    var flag_addr = interner.intern("@" + fname)
    var fl = ir.new_inst(g_cur_block, 21, types.named(TK_I64))  // load 哨兵
    ir.add_operand(fl, flag_addr, 3)  // OK_GLOBAL 全局地址
    var condv = tig_cond_to_bool(ir.get_value(fl), types.named(TK_I64))  // i1 哨兵!=0
    var slot = ir.new_inst(g_cur_block, 21, types.named(TK_STR))  // load 槽当前 ptr
    ir.add_operand(slot, av, 0)
    var doomed = tig_select_i(condv, ir.get_value(slot), tig_null_ptr(), types.named(TK_STR))
    tig_tbl_release_call(doomed)
    // 哨兵置 1：下次回边重写时 release 槽内当前表
    var one = tig_int_lit(1)
    var fls = ir.new_inst(g_cur_block, 22, -1)  // store
    ir.add_operand(fls, types.named(TK_I64), 2)
    ir.add_operand(fls, one, 0)
    ir.add_operand(fls, flag_addr, 3)
}

// 表下标赋值 t[i] = v → tie_table_set_<suffix> 桥（void）。
// AST：IndexAssign[val=op, children=[目标(Index), 值]]。
func tig_index_assign(id: i64) -> i64 {
    var target = sstate.child(id, 0)
    var val = sstate.child(id, 1)
    var op = s_vals[id]  // 复合赋值码（-1 普通；0..17，对齐 B_*）
    // 目标必须是 Index：children=[base, index]
    var base = sstate.child(target, 0)
    var idx = sstate.child(target, 1)
    var t = tig_expr(base)
    if t < 0 {
        return -1
    }
    var iv = tig_expr(idx)
    if iv < 0 {
        return -1
    }
    // E3 键值表赋值：m[key] = v → tie_map_set / tie_map_set_string（键为字符串 ptr）。
    // base 类型是 map（作用域变量类型优先，其次 node_types）→ 走 map 桥，
    // 与 Rust 基线 ir.rs tig_index_assign 的 map 分支同构（含复合赋值读写回写）。
    var base_is_map: bool = false
    var map_val_ty: i64 = types.named(TK_I64)
    if s_tags[base] == 6 {
        var bn_as = interner.intern(sstate.name_str(base))
        if scope_get(bn_as) >= 0 && types.is_map(g_lookup_ty) {
            base_is_map = true
            map_val_ty = types.low(g_lookup_ty)
        }
    }
    if !base_is_map {
        var bt_m2 = node_types[base]
        if types.is_map(bt_m2) {
            base_is_map = true
            map_val_ty = types.low(bt_m2)
        }
    }
    if base_is_map {
        // 裸 map（low 解码为 0）默认 i64 值；map<string> → string 值
        if map_val_ty <= 0 {
            map_val_ty = types.named(TK_I64)
        }
        var is_str_m = map_val_ty == types.named(TK_STR)
        var pty_m = types.named(TK_I64)
        if is_str_m {
            pty_m = types.named(TK_STR)
        } else if map_val_ty == types.named(TK_ANY) {
            // P2c：map<any> 值槽存堆指针（any 16 字节放不进 8 字节值槽）
            pty_m = types.named(TK_STR)
        }
        // 复合赋值（m[k] += v）：先读旧值（s21_map_get，缺失 raise）→ 运算 → 写回
        var v_m: i64 = -1
        if op >= 0 {
            var old_m = s21_map_get(t, iv, pty_m)
            if old_m < 0 {
                return -1
            }
            var rv_m = tig_expr(val)
            if rv_m < 0 {
                return -1
            }
            v_m = tig_compound_assign(op, old_m, rv_m, pty_m)
            if v_m < 0 {
                sm_err_msg = "下标复合赋值运算失败（函数 " + g_cur_fn_name + "）"
                return -1
            }
        } else {
            v_m = tig_expr(val)
            if v_m < 0 {
                return -1
            }
        }
        // P2c：map<any> 值写入——装箱 + 堆拷贝，值槽存堆指针
        if map_val_ty == types.named(TK_ANY) {
            var vtm = node_types[val]
            var src_m: i64 = v_m
            if vtm >= 0 && vtm != types.named(TK_ANY) {
                var bxm = tig_box_any(v_m, vtm)
                if bxm < 0 {
                    return -1
                }
                src_m = bxm
            }
            var any_ty4 = types.named(TK_ANY)
            var hp2 = s21_raw_alloc_str(tig_int_lit(16))
            if hp2 < 0 {
                return -1
            }
            s21_store(hp2, src_m, any_ty4)
            v_m = hp2
            pty_m = types.named(TK_STR)  // 值槽存堆指针
        }
        s21_map_set(t, iv, v_m, pty_m)  // 批次 7：内联二分/哈希写（替代 tie_map_set 桥）
        return 0
    }
    // 元素类型：对齐 tig_index_read 的完整推断链（tblvar_get → 作用域类型 →
    // node_types → sinfer → 索引表达式类型 fallback）。曾为简化版只查 sinfer 与
    // node_types，导致 table<string> 等变量（存 string）元素类型推断为 i64，
    // 生成 tie_table_set_i64 传 string 值 → opt 类型错（pkg 编译失败根因）。
    var elem: i64 = types.named(TK_I64)
    if s_tags[base] == 6 {
        var bname = interner.intern(sstate.name_str(base))
        var matched: bool = false
        // irgen 自维护表变量元素类型（table_new_f64() 变量；语义层 lv_telem 已过期）
        var tv0 = tblvar_get(bname)
        if tv0 >= 0 {
            elem = tv0
            matched = true
        }
        if !matched && scope_get(bname) >= 0 && types.is_table(g_lookup_ty) {
            var le = types.table_elem(g_lookup_ty)
            if le > 0 {
                elem = le
                matched = true
            }
        }
        if !matched {
            var bt2 = node_types[base]
            if types.is_table(bt2) {
                var le2 = types.table_elem(bt2)
                if le2 > 0 {
                    elem = le2
                    matched = true
                }
            }
        }
        if !matched {
            var te = sinfer.var_table_elem(bname)
            if te >= 0 {
                elem = te
                matched = true
            }
        }
        if !matched {
            // 最后 fallback：索引表达式节点的语义推断类型（裸 table 元素未知时）
            var nt = node_types[id]
            if nt >= 0 && (nt == types.named(TK_STR) || types.is_int(nt) ||
                types.is_float(nt) || types.is_bool_like(nt)) {
                elem = nt
            }
        }
    } else {
        var bt = node_types[base]
        if types.is_table(bt) {
            var te2 = types.table_elem(bt)
            if te2 > 0 {
                elem = te2
            }
        }
    }
    var suffix = bridge_suffix(elem)
    var pty = types.named(TK_I64)
    // P2a 复合元素：槽类型 = 元素类型 id（多字元素类型化 store/load）
    var elem_k2 = types.kind(elem)
    if elem_k2 == K_STRUCT || elem_k2 == K_ENUM || elem_k2 == K_FN || elem == types.named(TK_ANY) {
        pty = elem
    } else if types.kind(elem) == K_PORT {
        // S2.4：port 对象元素（table<Drawable>）存 ptr → set_string 桥
        suffix = "string"
        pty = types.named(TK_STR)
    } else if suffix == "string" {
        pty = types.named(TK_STR)
    } else if suffix == "f64" {
        // f64 表元素：set 桥值参数 double（曾落默认 i64 →
        // tie_table_set_f64(..., i64 %double) 类型错）
        pty = types.named(TK_F64)
    } else if suffix == "bool" {
        pty = types.named(TK_BOOL)
    }
    // 复合赋值（t[i] += v）：先读旧值（s21_table_at 带越界判定）→ 运算 → 写回
    var v: i64 = -1
    if op >= 0 {
        var ok_r = ir.new_inst(g_cur_block, 20, types.named(TK_I8))  // alloca i8
        ir.add_operand(ok_r, types.named(TK_I8), 2)
        var old = s21_table_at(t, iv, ir.get_value(ok_r), pty)
        if old < 0 {
            return -1
        }
        var rv = tig_expr(val)
        if rv < 0 {
            return -1
        }
        v = tig_compound_assign(op, old, rv, pty)
        if v < 0 {
            sm_err_msg = "下标复合赋值运算失败（函数 " + g_cur_fn_name + "）"
            return -1
        }
    } else {
        v = tig_expr(val)
        if v < 0 {
            return -1
        }
    }
    // p.6.10.4：表下标写表值 t[i] = v（v 为表）→ retain——元素持有引用。
    // 仅表路径（base_is_map 分支已提前 return，map 值非 tl_tbl 表）。op < 0 为
    // 普通赋值，v 即表句柄（ptr）；复合赋值 op>=0 的 v 是运算结果（i64），且表
    // 元素复合赋值不合法，故仅普通写。须在 any 装箱之前 retain（装箱后 v 是
    // any 聚合盒，非表句柄——code 30，与 table_push 的 p.6.10.4 同构）。
    var ivt = node_types[val]
    if op < 0 && ivt >= 0 && types.is_table(ivt) {
        tig_tbl_retain_call(v)
    }
    // P2b 异构元素装箱：表<any> 下标写，值须 box 为 any
    if pty == types.named(TK_ANY) {
        var vt6 = node_types[val]
        if vt6 >= 0 && vt6 != types.named(TK_ANY) {
            var bx = tig_box_any(v, vt6)
            if bx < 0 {
                return -1
            }
            v = bx
        }
    }
    s21_table_set(t, iv, pty, v)  // 下标写：越界静默跳过（不追加）
    return 0
}

// Switch：driver 树仅字符串 subject（typekw_index）。逐 case strcmp 比较链：
//   cmp = strcmp(subj, case_val)；命中 → body；否则下一 case / default。
// AST：Switch[aux=ncases, children=[subject]+cases...+[default]]；
//   SwitchCase[children=[PatternList, when 或 -1, body]]。
func tig_switch(id: i64) -> i64 {
    var subject = sstate.child(id, 0)
    var sv = tig_expr(subject)
    if sv < 0 {
        return -1
    }
    // subject 类型分派：字符串 → strcmp 比较链；整数/char → icmp 比较链；
    // 枚举 → 提取 tag（槽 0）后与 case 的 tag 常量 icmp 比较；
    // any → 提取 tag（槽 0）后与 case 类型的装箱 tag icmp 比较（P2b-T4）
    var subj_is_str = node_types[subject] == types.named(TK_STR)
    var subj_ty = node_types[subject]
    var subj_is_enum = types.kind(subj_ty) == K_ENUM
    var subj_is_any = subj_ty == types.named(TK_ANY)
    var enum_tag_v: i64 = -1
    if subj_is_enum {
        // 枚举 subject：tig_agg_addr(subject) → agg_gep 下标 0 → load i64（tag）
        var eaddr = tig_agg_addr(subject, subj_ty)
        if eaddr < 0 {
            return -1
        }
        var egp = ir.new_inst(g_cur_block, 27, subj_ty)
        ir.add_operand(egp, eaddr, 0)
        ir.add_operand(egp, 0, 2)
        var egpp = ir.get_value(egp)
        var eld = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
        ir.add_operand(eld, egpp, 0)
        enum_tag_v = ir.get_value(eld)
    }
    var any_tag_v: i64 = -1
    if subj_is_any {
        // any subject：同样提取 tag@[0]（对齐枚举；tag 约定见 tig_box_any）
        var aaddr = tig_agg_addr(subject, subj_ty)
        if aaddr < 0 {
            return -1
        }
        var agp = ir.new_inst(g_cur_block, 27, subj_ty)
        ir.add_operand(agp, aaddr, 0)
        ir.add_operand(agp, 0, 2)
        var agpp = ir.get_value(agp)
        var ald = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
        ir.add_operand(ald, agpp, 0)
        any_tag_v = ir.get_value(ald)
    }
    var ncases = s_aux[id]
    var exit_blk = ir.new_block(g_cur_func, interner.intern("sw.exit"))
    // 逐个 case：PatternList 多模式（任一命中 → body；含 Range 范围模式）
    var k: i64 = 0
    while k < ncases {
        var case_node = sstate.child(id, 1 + k)
        var pl = sstate.child(case_node, 0)
        var body = sstate.child(case_node, 2)
        var body_blk = ir.new_block(g_cur_func, interner.intern("sw.body"))
        var next_blk = ir.new_block(g_cur_func, interner.intern("sw.next"))
        var npat = sstate.nchild(pl)
        // 逐个模式比较链：eq → body；ne → 下一模式块
        var i: i64 = 0
        while i < npat {
            var pat = sstate.child(pl, i)
            var eq_v: i64 = -1
            // P2c：struct 绑定标记（case Point(p): → 命中后提取 payload 绑定）
            var pat_is_bind: bool = false
            if subj_is_any && s_tags[pat] == S_N_TYPE_LIT {
                // P2b-T4：any 主体类型匹配——case 类型 → 装箱 tag 常量，与提取的
                // subject tag icmp eq（scheck 已校验可装箱）。body 内用 as_<T>(x)
                // 取用（tag 已匹配，as_* 不会触发运行时错误）
                var tynode = sstate.child(pat, 0)
                var cmt = types.named(s_vals[tynode])  // N_NAMED_TYPE val = typekw 索引
                var exp_tag2: i64 = -1
                if types.is_int(cmt) {
                    exp_tag2 = 0  // 整数族统一 tag 0（窄整数装箱已 zext 进 i64）
                } else if types.is_float(cmt) {
                    exp_tag2 = 1
                } else if cmt == types.named(TK_BOOL) {
                    exp_tag2 = 2
                } else if cmt == types.named(TK_STR) {
                    exp_tag2 = 3
                } else if cmt == types.named(TK_CHAR) {
                    exp_tag2 = 4
                }
                if exp_tag2 < 0 {
                    sm_err_msg = "case 类型匹配（" + types.type_name(cmt) + "）不是可装箱类型（函数 " + g_cur_fn_name + "）"
                    return -1
                }
                var pv3 = tig_int_lit_ty(exp_tag2, types.named(TK_I64))
                var is_eq3 = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))
                ir.add_operand(is_eq3, any_tag_v, 0)
                ir.add_operand(is_eq3, pv3, 0)
                ir.add_operand(is_eq3, 0, 2)  // eq
                eq_v = ir.get_value(is_eq3)
            } else if subj_is_any && (s_tags[pat] == S_N_VAR || s_tags[pat] == N_CASE_BIND) {
                // P2c：struct 匹配/绑定——case Point: / case Point(p):
                //（scheck 已校验是 struct 名）。tag = struct 类型 id 常量。
                var sref = pat
                if s_tags[pat] == N_CASE_BIND {
                    sref = sstate.child(pat, 0)
                    pat_is_bind = true
                }
                var sname2 = sstate.name_str(sref)
                var sidx2 = sstate.bs_find(st_keys, interner.intern(sname2))
                if sidx2 < 0 {
                    sm_err_msg = "case 值 '" + sname2 + "' 不是 struct（函数 " + g_cur_fn_name + "）"
                    return -1
                }
                var s_ty2 = types.struct_of(st_vals[sidx2])
                var pv4 = tig_int_lit_ty(s_ty2, types.named(TK_I64))
                var is_eq4 = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))
                ir.add_operand(is_eq4, any_tag_v, 0)
                ir.add_operand(is_eq4, pv4, 0)
                ir.add_operand(is_eq4, 0, 2)  // eq
                eq_v = ir.get_value(is_eq4)
            } else if subj_is_enum {
                // 枚举 case：模式 = FieldAccess(Enum.Variant) → 解析为 tag 常量，
                // 与提取出的 subject tag icmp eq（scheck 已校验变体合法）。
                // 不可用 tig_expr(pat)——FieldAccess 枚举分支会构造聚合值。
                var ptag = enum_case_tag(pat, subj_ty)
                if ptag < 0 {
                    sm_err_line = s_lines[id]
                    sm_err_col = s_cols[id]
                    sm_err_msg = "case 值不是枚举 '" + types.type_name(subj_ty) + "' 的变体引用（函数 " + g_cur_fn_name + "）"
                    return -1
                }
                var pv2 = tig_int_lit_ty(ptag, types.named(TK_I64))
                var is_eq2 = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))
                ir.add_operand(is_eq2, enum_tag_v, 0)
                ir.add_operand(is_eq2, pv2, 0)
                ir.add_operand(is_eq2, 0, 2)  // eq
                eq_v = ir.get_value(is_eq2)
            } else if s_tags[pat] == 11 {
                // Range 模式（case 3..7 → sv >= 3 && sv < 7）
                var rs = tig_expr(sstate.child(pat, 0))
                if rs < 0 {
                    return -1
                }
                var re = tig_expr(sstate.child(pat, 1))
                if re < 0 {
                    return -1
                }
                var ge = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))  // icmp sge
                ir.add_operand(ge, sv, 0)
                ir.add_operand(ge, rs, 0)
                ir.add_operand(ge, 5, 2)  // sge
                var ge_v = ir.get_value(ge)
                var lt = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))  // icmp slt
                ir.add_operand(lt, sv, 0)
                ir.add_operand(lt, re, 0)
                ir.add_operand(lt, 2, 2)  // slt
                var lt_v = ir.get_value(lt)
                var and = ir.new_inst(g_cur_block, 6, types.named(TK_BOOL))  // and i1
                ir.add_operand(and, ge_v, 0)
                ir.add_operand(and, lt_v, 0)
                eq_v = ir.get_value(and)
            } else {
                var pv = tig_expr(pat)
                if pv < 0 {
                    return -1
                }
                if subj_is_str {
                    // 字符串比较：strcmp(sv, pv) == 0
                    var cmp = tig_ext_call2("strcmp", sv, types.named(TK_STR), pv, types.named(TK_STR), types.named(TK_I32))
                    if cmp < 0 {
                        return -1
                    }
                    var is_eq = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))
                    ir.add_operand(is_eq, cmp, 0)
                    ir.add_operand(is_eq, 0, 2)
                    ir.add_operand(is_eq, 0, 2)  // eq
                    eq_v = ir.get_value(is_eq)
                } else {
                    // 整数/char 比较：icmp eq（值可能为 i64 整数或 i32 char——
                    // 以 sv 定义类型为准，llvmgen icmp 按 lhs 定义类型选宽度）
                    var is_eq = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))
                    ir.add_operand(is_eq, sv, 0)
                    ir.add_operand(is_eq, pv, 0)
                    ir.add_operand(is_eq, 0, 2)  // eq
                    eq_v = ir.get_value(is_eq)
                }
            }
            var np_blk = ir.new_block(g_cur_func, interner.intern("sw.np"))
            if subj_is_enum && s_tags[pat] == N_CASE_BIND {
                // 批次 7：枚举变体解构——命中 → 绑定块（提取 payload → 绑定变量）→ body
                var bind_blk = ir.new_block(g_cur_func, interner.intern("sw.bind"))
                var cb = ir.new_inst(g_cur_block, 31, -1)
                ir.add_operand(cb, eq_v, 0)
                ir.add_operand(cb, bind_blk, 1)
                ir.add_operand(cb, np_blk, 1)
                // 绑定块：payload 提取 + 变量绑定（tig_case_bind_body）
                g_cur_block = bind_blk
                var bb2 = tig_case_bind_body(subject, subj_ty, pat)
                if bb2 < 0 {
                    return -1
                }
                var brb = ir.new_inst(g_cur_block, 30, -1)  // br body
                ir.add_operand(brb, body_blk, 1)
                g_cur_block = np_blk
            } else if subj_is_any && pat_is_bind {
                // P2c：struct 解构——case Point(p): 命中 → 绑定块（从堆 any 盒
                // 提取 struct → 绑定变量）→ body
                var sbind_blk = ir.new_block(g_cur_func, interner.intern("sw.sbind"))
                var cb2 = ir.new_inst(g_cur_block, 31, -1)
                ir.add_operand(cb2, eq_v, 0)
                ir.add_operand(cb2, sbind_blk, 1)
                ir.add_operand(cb2, np_blk, 1)
                g_cur_block = sbind_blk
                var sb2 = tig_case_struct_bind_body(subject, subj_ty, pat)
                if sb2 < 0 {
                    return -1
                }
                var brb2 = ir.new_inst(g_cur_block, 30, -1)  // br body
                ir.add_operand(brb2, body_blk, 1)
                g_cur_block = np_blk
            } else {
                var cb = ir.new_inst(g_cur_block, 31, -1)
                ir.add_operand(cb, eq_v, 0)
                ir.add_operand(cb, body_blk, 1)
                ir.add_operand(cb, np_blk, 1)
                g_cur_block = np_blk
            }
            i = i + 1
        }
        // 所有模式未命中 → next case
        if !block_terminated() {
            var bnx = ir.new_inst(g_cur_block, 30, -1)  // br next
            ir.add_operand(bnx, next_blk, 1)
        }
        // body 块
        g_cur_block = body_blk
        var bb = tig_block_stmts(body)
        if bb < 0 {
            return -1
        }
        if !block_terminated() {
            var br1 = ir.new_inst(g_cur_block, 30, -1)  // br exit
            ir.add_operand(br1, exit_blk, 1)
        }
        // next 块
        g_cur_block = next_blk
        k = k + 1
    }
    // default 体（最后一个 child）
    var default_list = sstate.child(id, 1 + ncases)
    if default_list >= 0 && sstate.nchild(default_list) > 0 {
        var db = tig_block_stmts(default_list)
        if db < 0 {
            return -1
        }
    }
    if !block_terminated() {
        var br2 = ir.new_inst(g_cur_block, 30, -1)  // br exit
        ir.add_operand(br2, exit_blk, 1)
    }
    g_cur_block = exit_blk
    return 0
}

// println/print 生成：printf 调用（格式串 + 参数）
// 最小集：空 → "\n"；字符串 → "%s\n" + ptr；整数 → "%lld\n" + i64
// 格式串用真实文本（tie 字符串中 % 原样、\n 为换行），llvmgen 端转义为 c"...\00"
func tig_println(id: i64, newline: bool) -> i64 {
    // Call children = [泛型槽, 实参...]：`println()` 槽占位 → 实参数 = nchild-1
    var nc = sstate.nchild(id) - sstate.slot_off(id)
    var nl = "\n"
    if !newline {
        nl = ""
    }
    if nc == 0 {
        // 空 println → 换行
        var fmt = interner.intern(nl)
        // call_vararg（printf）结果：llvmgen 生成 `%N = call i32 (ptr, ...)`——
        // 必须有结果寄存器，ty 用 i32（TK_I32）
        var inst = ir.new_inst(g_cur_block, 41, types.named(TK_I32))  // call_vararg
        ir.add_operand(inst, fmt, 0)  // OK_VALUE 格式串池 id
        return ir.get_value(inst)
    }
    // 实参 = children[slot_off]（children[0] 是泛型槽）
    var arg = sstate.child(id, sstate.slot_off(id))
    var atag = s_tags[arg]
    if atag == 2 {
        // 字符串参数：格式 "%s\n" + 字符串指针
        var sval = tig_str_lit(s_names[arg])
        var fmt = interner.intern("%s" + nl)
        var inst = ir.new_inst(g_cur_block, 41, types.named(TK_I32))  // call_vararg
        ir.add_operand(inst, fmt, 0)
        ir.add_operand(inst, sval, 0)
        return ir.get_value(inst)
    }
    if atag == 6 && scope_get(s_names[arg]) >= 0 && g_lookup_ty == types.named(TK_STR) {
        // T4.5：字符串类型变量（如 `var p: string = get_env("PATH")`）→ "%s\n" + ptr
        var sval = tig_var_ref(s_names[arg])
        if sval < 0 {
            return -1
        }
        var fmt = interner.intern("%s" + nl)
        var inst = ir.new_inst(g_cur_block, 41, types.named(TK_I32))  // call_vararg
        ir.add_operand(inst, fmt, 0)
        ir.add_operand(inst, sval, 0)
        return ir.get_value(inst)
    }
    // 字符串表达式（str_cat 拼接 / 返回 string 的调用等）：node_types 推断为
    // TK_STR → "%s\n" + ptr。曾漏此分支：拼接结果走 %lld 打印指针值（乱码）
    if node_types[arg] == types.named(TK_STR) {
        var sval2 = tig_expr(arg)
        if sval2 < 0 {
            return -1
        }
        var fmt2 = interner.intern("%s" + nl)
        var inst2 = ir.new_inst(g_cur_block, 41, types.named(TK_I32))  // call_vararg
        ir.add_operand(inst2, fmt2, 0)
        ir.add_operand(inst2, sval2, 0)
        return ir.get_value(inst2)
    }
    // P2c：any 参数 → 运行时分派打印（tig_print_any 按 tag 逐分支）
    if node_types[arg] == types.named(TK_ANY) {
        var av3 = tig_expr(arg)
        if av3 < 0 {
            return -1
        }
        return tig_print_any(av3, nl)
    }
    // 批次 7：键值表（map）参数 → s21_map_to_string 内联（键升序 {k: v, k2: v2}，
    // 替代旧 %lld 打印指针值）。检测对齐 tig_index_read 的 map 分支（作用域类型
    // 优先，其次 node_types）。
    var m_is_map: bool = false
    var m_vty: i64 = types.named(TK_I64)
    if atag == 6 {
        var mn = interner.intern(sstate.name_str(arg))
        if scope_get(mn) >= 0 && types.is_map(g_lookup_ty) {
            m_is_map = true
            m_vty = types.low(g_lookup_ty)
        }
    }
    if !m_is_map {
        var mt = node_types[arg]
        if types.is_map(mt) {
            m_is_map = true
            m_vty = types.low(mt)
        }
    }
    if m_is_map {
        if m_vty <= 0 {
            m_vty = types.named(TK_I64)
        }
        var mv = tig_expr(arg)
        if mv < 0 {
            return -1
        }
        var ms = s21_map_to_string(mv, m_vty)
        var fm = interner.intern("%s" + nl)
        var im = ir.new_inst(g_cur_block, 41, types.named(TK_I32))  // call_vararg
        ir.add_operand(im, fm, 0)
        ir.add_operand(im, ms, 0)
        return ir.get_value(im)
    }
    // 浮点参数（f64/f32）：格式 "%f"（printf 变参要求 double，f32 需 fpext 提升——
    // 语义层 f32 场景罕见，按 f64 处理；f32 值经 fpext 指令提升）
    // num 宽类型变量（语义 node_types=TK_NUM）按槽类型补判——`var b: num = 3.14`
    // 归约后槽是 f64，node_types 仍是 TK_NUM（曾误走 %lld 打印指针值）
    var f_is_f = node_types[arg] == types.named(TK_F64) || node_types[arg] == types.named(TK_F32)
    if !f_is_f && node_types[arg] == types.named(TK_NUM) && s_tags[arg] == 6 {
        var fnid = interner.intern(sstate.name_str(arg))
        if scope_get(fnid) >= 0 && types.is_float(g_lookup_ty) {
            f_is_f = true
        }
    }
    if f_is_f {
        var fv = tig_expr(arg)
        if fv < 0 {
            return -1
        }
        var fref: i64 = fv
        if node_types[arg] == types.named(TK_F32) {
            // f32 → f64 提升（printf 变参提升规则；fpext 无专用 opcode，
            // 用 fsub 0.0 保留值不可行——f32 值作为 f64 操作数需转换指令。
            // 简化：tie 语义层 f32 推断均落 f64，防御性按 double 直传）
        }
        var fmt = interner.intern("%f" + nl)
        var inst = ir.new_inst(g_cur_block, 41, types.named(TK_I32))  // call_vararg
        ir.add_operand(inst, fmt, 0)
        ir.add_operand(inst, fref, 0)
        return ir.get_value(inst)
    }
    // 字符参数（char）：格式 "%c"（i32 值，直传）
    if node_types[arg] == types.named(TK_CHAR) {
        var cv = tig_expr(arg)
        if cv < 0 {
            return -1
        }
        var fmt = interner.intern("%c" + nl)
        var inst = ir.new_inst(g_cur_block, 41, types.named(TK_I32))  // call_vararg
        ir.add_operand(inst, fmt, 0)
        ir.add_operand(inst, cv, 0)
        return ir.get_value(inst)
    }
    // trit 参数：格式 "%d"（i8 → sext i32，printf 变参提升；对齐 Rust i8/i16 分支）
    if node_types[arg] == types.named(TK_TRIT) {
        var tv = tig_expr(arg)
        if tv < 0 {
            return -1
        }
        var sext = ir.new_inst(g_cur_block, 19, types.named(TK_I32))  // sext i8→i32
        ir.add_operand(sext, types.named(TK_I8), 2)
        ir.add_operand(sext, tv, 0)
        var sv = ir.get_value(sext)
        var fmt = interner.intern("%d" + nl)
        var inst = ir.new_inst(g_cur_block, 41, types.named(TK_I32))  // call_vararg
        ir.add_operand(inst, fmt, 0)
        ir.add_operand(inst, sv, 0)
        return ir.get_value(inst)
    }
    // i128/u128 参数（批次 2）：内联除法循环生成十进制字符串 → "%s\n" + ptr。
    // 不能直传 printf（变参 i128 与 %lld 类型不匹配，opt 报类型错）。
    if node_types[arg] == types.named(TK_I128) || node_types[arg] == types.named(TK_U128) {
        var av = tig_expr(arg)
        if av < 0 {
            return -1
        }
        var sv = tig_i128_to_str(av, node_types[arg] == types.named(TK_I128))
        var fmt = interner.intern("%s" + nl)
        var inst = ir.new_inst(g_cur_block, 41, types.named(TK_I32))  // call_vararg
        ir.add_operand(inst, fmt, 0)
        ir.add_operand(inst, sv, 0)
        return ir.get_value(inst)
    }
    // 整数参数（i64）：格式 "%lld\n"
    var av = tig_expr(arg)
    if av < 0 {
        return -1
    }
    var fmt = interner.intern("%lld" + nl)
    var inst = ir.new_inst(g_cur_block, 41, types.named(TK_I32))  // call_vararg
    ir.add_operand(inst, fmt, 0)
    ir.add_operand(inst, av, 0)
    return ir.get_value(inst)
}

// P2c：println(any) 运行时分派——按 tag 打印包含值（标量 0-4 / 复合 kind）。
//   tag0(i64) %lld | tag1(f64) %f | tag2(bool) %lld | tag3(string) %s |
//   tag4(char) %c | 复合（tag = 类型 id，≥ BASE_STRUCT）→ <struct>/<enum>/<fn>
// 结构：any 落 alloca → 读 tag → 比较链逐分支 printf + br exit。
func tig_print_any(v: i64, nl: string) -> i64 {
    var any_ty = types.named(TK_ANY)
    var T64 = types.named(TK_I64)
    var slot = ir.new_inst(g_cur_block, 20, any_ty)
    ir.add_operand(slot, any_ty, 2)
    var sp = ir.get_value(slot)
    var st = ir.new_inst(g_cur_block, 22, -1)
    ir.add_operand(st, any_ty, 2)
    ir.add_operand(st, v, 0)
    ir.add_operand(st, sp, 0)
    var g0 = ir.new_inst(g_cur_block, 27, any_ty)
    ir.add_operand(g0, sp, 0)
    ir.add_operand(g0, 0, 2)
    var ld0 = ir.new_inst(g_cur_block, 21, T64)  // load tag
    ir.add_operand(ld0, ir.get_value(g0), 0)
    var tag_v = ir.get_value(ld0)
    var g1 = ir.new_inst(g_cur_block, 27, any_ty)
    ir.add_operand(g1, sp, 0)
    ir.add_operand(g1, 1, 2)
    var g1p = ir.get_value(g1)
    var exit = ir.new_block(g_cur_func, interner.intern("pa.x"))
    // 标量 tag 0-4：逐 tag 比较链
    var tag_id: i64 = 0
    while tag_id < 5 {
        var nxt = ir.new_block(g_cur_func, interner.intern("pa.n" + to_string(tag_id)))
        var pv = tig_int_lit_ty(tag_id, T64)
        var eq = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))
        ir.add_operand(eq, tag_v, 0)
        ir.add_operand(eq, pv, 0)
        ir.add_operand(eq, 0, 2)  // eq
        var body = ir.new_block(g_cur_func, interner.intern("pa.b" + to_string(tag_id)))
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, ir.get_value(eq), 0)
        ir.add_operand(cb, body, 1)
        ir.add_operand(cb, nxt, 1)
        // 该 tag 分支：printf + br exit
        g_cur_block = body
        var fmt_s: string = "<unknown>"
        var pty_p: i64 = T64
        if tag_id == 0 {
            fmt_s = "%lld" + nl
        } else if tag_id == 1 {
            fmt_s = "%f" + nl
            pty_p = types.named(TK_F64)
        } else if tag_id == 2 {
            fmt_s = "%lld" + nl
        } else if tag_id == 3 {
            fmt_s = "%s" + nl
            pty_p = types.named(TK_STR)
        } else if tag_id == 4 {
            fmt_s = "%c" + nl
        }
        var ld = ir.new_inst(g_cur_block, 21, pty_p)  // load payload
        ir.add_operand(ld, g1p, 0)
        var pv2 = ir.get_value(ld)
        var pi = ir.new_inst(g_cur_block, 41, types.named(TK_I32))  // call_vararg
        ir.add_operand(pi, interner.intern(fmt_s), 0)
        ir.add_operand(pi, pv2, 0)
        var be = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(be, exit, 1)
        g_cur_block = nxt
        tag_id = tag_id + 1
    }
    // 复合：tag ≥ BASE_STRUCT → <struct>/<enum>/<fn>（按段阈值）
    var cs_b = tig_int_lit_ty(BASE_STRUCT, T64)
    var cs = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))  // icmp sge
    ir.add_operand(cs, tag_v, 0)
    ir.add_operand(cs, cs_b, 0)
    ir.add_operand(cs, 5, 2)  // sge
    var cblk = ir.new_block(g_cur_func, interner.intern("pa.c"))
    var unk = ir.new_block(g_cur_func, interner.intern("pa.u"))
    var cb2 = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cb2, ir.get_value(cs), 0)
    ir.add_operand(cb2, cblk, 1)
    ir.add_operand(cb2, unk, 1)
    // cblk：按段判 kind
    g_cur_block = cblk
    var ce_b = tig_int_lit_ty(BASE_ENUM, T64)
    var ce = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))  // icmp sge BASE_ENUM
    ir.add_operand(ce, tag_v, 0)
    ir.add_operand(ce, ce_b, 0)
    ir.add_operand(ce, 5, 2)  // sge
    var enblk = ir.new_block(g_cur_func, interner.intern("pa.e"))
    var stblk = ir.new_block(g_cur_func, interner.intern("pa.s"))
    var cb3 = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cb3, ir.get_value(ce), 0)
    ir.add_operand(cb3, enblk, 1)
    ir.add_operand(cb3, stblk, 1)
    g_cur_block = stblk
    var psi = ir.new_inst(g_cur_block, 41, types.named(TK_I32))
    ir.add_operand(psi, interner.intern("<struct>" + nl), 0)
    var bse = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(bse, exit, 1)
    g_cur_block = enblk
    var cf_b = tig_int_lit_ty(BASE_FN, T64)
    var cf = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))  // icmp sge BASE_FN
    ir.add_operand(cf, tag_v, 0)
    ir.add_operand(cf, cf_b, 0)
    ir.add_operand(cf, 5, 2)  // sge
    var fnblk = ir.new_block(g_cur_func, interner.intern("pa.f"))
    var en2 = ir.new_block(g_cur_func, interner.intern("pa.e2"))
    var cb4 = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cb4, ir.get_value(cf), 0)
    ir.add_operand(cb4, fnblk, 1)
    ir.add_operand(cb4, en2, 1)
    g_cur_block = en2
    var pei = ir.new_inst(g_cur_block, 41, types.named(TK_I32))
    ir.add_operand(pei, interner.intern("<enum>" + nl), 0)
    var bee = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(bee, exit, 1)
    g_cur_block = fnblk
    var pfi = ir.new_inst(g_cur_block, 41, types.named(TK_I32))
    ir.add_operand(pfi, interner.intern("<fn>" + nl), 0)
    var bfe = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(bfe, exit, 1)
    // unk：<unknown>
    g_cur_block = unk
    var pui = ir.new_inst(g_cur_block, 41, types.named(TK_I32))
    ir.add_operand(pui, interner.intern("<unknown>" + nl), 0)
    var bue = ir.new_inst(g_cur_block, 30, -1)
    ir.add_operand(bue, exit, 1)
    // 汇合（后续代码在此继续）
    g_cur_block = exit
    return tig_int_lit(0)
}

// 语句生成：0 成功 / -1 错误
func tig_stmt(id: i64) -> i64 {
    var tag = s_tags[id]
    if tag == 100 {
        // VarDecl：children=[ty 或 -1, init]
        var nm = s_names[id]
        var ty_node = sstate.child(id, 0)
        var init = sstate.child(id, 1)
        var ty: i64 = types.named(3)  // 默认 i64
        if ty_node >= 0 {
            ty = sgen.parse_generic_type_node(ty_node)
            if ty < 0 {
                return -1
            }
            // 宽类型归约：num/text/misc 是宽类型框（对齐 Rust 语义层展开），
            // llvm_ty 无映射（兜底 ptr）——按 init 的实际推断类型定槽型：
            //   num + 整数 → i64；num + 浮点 → f64；text + 字符串 → ptr；
            //   misc + bool → i1
            if init >= 0 && (ty == types.named(TK_NUM) || ty == types.named(TK_TEXT) ||
                ty == types.named(TK_MISC)) {
                var wt = node_types[init]
                if wt >= 0 {
                    ty = wt
                }
            }
        } else if init >= 0 {
            // 无类型标注：按初始化表达式的推断类型定槽型。
            // 表/映射/字符串 → TK_STR（ptr 槽：表指针 / 字符串指针统一 ptr，
            // 与 llvmgen store 的 to_ptr 转换配套）；bool → TK_BOOL（i1 槽，
            // icmp 结果是 i1——曾默认 i64 槽导致 store i64 %i1 类型错）；
            // 元组/struct → 聚合类型 id（alloca {..} 聚合槽）；
            // 其余默认 i64。
            var it = node_types[init]
            if it >= 0 && (types.is_table(it) || types.is_map(it) || it == types.named(TK_STR)) {
                ty = types.named(TK_STR)
            } else if it == types.named(TK_TRIT) {
                // trit：i8 槽（compare() 返回 trit 变量——曾落入 is_bool_like
                // 判为 i1 槽，store i8 %i1 类型错）
                ty = types.named(TK_TRIT)
            } else if it == types.named(TK_ANY) {
                // P2c：any 推断 → {i64,i64} 聚合槽（异构值存储；init 已是 any
                // 或下方统一装箱）
                ty = it
            } else if it >= 0 && types.is_bool_like(it) {
                ty = types.named(TK_BOOL)
            } else if it >= 0 && types.is_float(it) {
                // 浮点推断（f64/f32）：mean(...) 返回 f64 → alloca double 槽
                //（曾落默认 i64 → store i64 %double 类型错）
                ty = it
            } else if it >= 0 && types.is_int(it) {
                // S1.3 窄整数推断（后缀字面量 `var a = 42i32`）：窄槽
                //（语义类型 i32 与槽型须一致，否则 load i64 被按 i32 sext 类型错）
                ty = it
            } else if it >= 0 && types.is_unsafe_ty(it) {
                // S1.2：指针/切片/原子类型推断（`var p = addr_of(x)`）→
                // 对应槽（alloca ptr / alloca {ptr,i64} / alloca 元素型）
                ty = it
            } else if it >= 0 && types.kind(it) == K_ACTOR {
                // 一期并发：actor 句柄变量推断 → 保留句柄类型（LLVM=i64 槽，
                // 但须保留 K_ACTOR 供方法转发 scope 查类型）
                ty = it
            } else if it >= 0 && types.kind(it) == K_GUARD {
                // 三期 A 组：guard<cap> 凭据变量推断 → i64 槽（凭据运行期占位）
                ty = it
            } else if it >= 0 && (types.kind(it) == K_TUPLE || types.kind(it) == K_STRUCT || types.kind(it) == K_ENUM || types.kind(it) == K_FN || types.kind(it) == K_PORT) {
                // 聚合变量：alloca 聚合槽，init（构造调用/元组字面量/返回）求聚合值
                // （K_ENUM 2026-08-15：枚举变量同 struct——alloca %enum.X 槽，
                // init 的 FieldAccess/MethodCall 构造求聚合值，store 类型匹配；
                // K_FN S2.2：闭包字面量/函数值参数 → alloca %fn.X 槽；
                // K_PORT S2.4：port 对象（ptr 表示）→ alloca ptr 槽）
                ty = it
            }
        }
        // alloca + store
        var alloca = ir.new_inst(g_cur_block, 20, ty)  // alloca
        ir.add_operand(alloca, ty, 2)  // 类型立即数（占位）
        var av = ir.get_value(alloca)
        if init >= 0 {
            // S2.4：port 对象变量初始化——提升（struct → port 打包）或
            // port 拷贝（ptr 复制）。见 tig_port_coerce 注释。
            if types.kind(ty) == K_PORT {
                var it4 = node_types[init]
                var pv: i64 = -1
                if it4 >= 0 && types.kind(it4) == K_STRUCT {
                    pv = tig_port_coerce(init, ty)
                } else {
                    pv = tig_expr(init)
                }
                if pv < 0 {
                    return -1
                }
                var store = ir.new_inst(g_cur_block, 22, -1)  // store
                ir.add_operand(store, ty, 2)
                ir.add_operand(store, pv, 0)
                ir.add_operand(store, av, 0)
                scope_put(nm, av, ty)
                return 0
            }
            // DEBUG 临时
            // IntLit 初始化：按声明类型生成常量（i32 变量存 i32 值，否则
            // llvmgen 的 store i32 %N 会因 %N 是 i64 const_i 而类型不匹配）；
            // 其余表达式走 tig_expr（结果恒 i64，与 llvmgen store 的 vty 匹配
            // 需初始化类型为 i64——非 i64 初始化目前仅支持整数常量）。
            var iv: i64 = -1
            if s_tags[init] == 4 && ty == types.named(TK_TRIT) {
                // BoolLit 适配 trit（语义层 node_types 仍标 TK_BOOL，但标注类型
                // trit 需生成 i8 值：true→1 / false→-1——否则 store i8 %i1 类型错）
                var tv: i64 = -1
                if s_vals[init] == 1 {
                    tv = 1
                }
                iv = tig_trit_lit(tv)
            } else if s_tags[init] == 1 && ty == types.named(TK_F32) {
                // FloatLit 适配 f32 声明：按 f32 生成常量（S1.3，默认 f64）
                iv = tig_float_lit_ty(s_names[init], types.named(TK_F32))
            } else if s_tags[init] == 0 {
                // P2b：any 声明的整数字面量先按 i64 生成，装箱在后续统一处理
                var lit_ty = ty
                if lit_ty == types.named(TK_ANY) {
                    lit_ty = types.named(TK_I64)
                }
                iv = tig_int_lit_ty(s_vals[init], lit_ty)
            } else if s_tags[init] == 14 && types.kind(ty) == K_TUPLE {
                // 元组字面量 + 元组类型标注：按目标类型构造（(i32,i64) 标注 +
                // (7,8) 字面量——语义层推断字面量为 (i64,i64)，不按目标类型
                // 构造会 store {i64,i64} 到 {i32,i64} 槽，LLVM 类型不匹配）
                iv = tig_tuple_lit_typed(init, ty)
            } else {
                iv = tig_expr(init)
                // S1.3 C2：表达式类型 ≠ 声明类型（数字族）→ 转换。
                // IntLit/FloatLit 已按类型生成（tig_int_lit_ty / 浮点常量），
                // 变量/运算结果按语义层拓宽规则转换（i16 变量 → i64 声明）。
                if iv >= 0 {
                    var it3 = node_types[init]
                    if it3 >= 0 && (types.is_int(it3) || types.is_float(it3)) &&
                        (types.is_int(ty) || types.is_float(ty)) && it3 != ty {
                        var cv2 = tig_coerce(iv, it3, ty)
                        if cv2 < 0 {
                            return -1
                        }
                        iv = cv2
                    }
                }
            }
            if iv < 0 {
                return -1
            }
            // P2b any 装箱：声明类型 any 且初始化值是具体类型 → box 为 {tag,payload}
            if ty == types.named(TK_ANY) {
                var it5 = node_types[init]
                if it5 >= 0 && it5 != types.named(TK_ANY) {
                    var bx = tig_box_any(iv, it5)
                    if bx < 0 {
                        return -1
                    }
                    iv = bx
                }
            }
            // p.6.10.3：VarDecl 表引用接管——init 是表表达式（非 table_new_* 构造、
            // 非函数调用返回——后者已在 callee 的 return 处 retain）→ retain（槽接收
            // 引用，出口析构与之守恒）。
            if iv >= 0 && init >= 0 {
                var iv4 = node_types[init]
                if iv4 >= 0 && types.is_table(iv4) && s_tags[init] != 7 {
                    tig_tbl_retain_call(iv)
                }
            }
            // p.6.10.3：entry 级析构候选登记——表变量且在 entry 块创建（循环/分支内
            // var 的 alloca 在非 entry 块，出口析构 load 会触发「not dominate」）。
            if g_cur_block == g_entry_block && types.is_table(ty) {
                table_push(g_tblcand_allocas, av)
            }
            // p.6.10.4：循环/分支内表变量自遮蔽——非 entry 块声明的表变量，槽在回边
            // 重执行时被 `store 新表` 覆盖旧值 → 旧表引用丢失泄漏。store 前须 release
            // 槽内当前持有，但**首次**进入该声明时槽未初始化（load 即崩）。用零值全局
            // 哨兵 + select 归零实参区分首次（跳过 release）与回边重写（release 上一轮
            // 表），内存有界且安全。entry 级表变量由 p.6.10.3 出口析构覆盖，不在此列。
            var ivla = node_types[init]
            if g_cur_block != g_entry_block && ivla >= 0 && types.is_table(ivla) {
                tig_loopvar_release(av)
            }
            var store = ir.new_inst(g_cur_block, 22, -1)  // store
            ir.add_operand(store, ty, 2)
            ir.add_operand(store, iv, 0)
            ir.add_operand(store, av, 0)
        } else {
            // p.6.10.2 步2：无 init 的表类型变量 → 槽预置空句柄（null）——赋值插桩的
            // 旧值 release 依赖槽初值确定（避免释放未初始化的垃圾句柄）。
            if types.is_table(ty) {
                var nv0 = tig_null_ptr()
                var st0 = ir.new_inst(g_cur_block, 22, -1)  // store
                ir.add_operand(st0, ty, 2)
                ir.add_operand(st0, nv0, 0)
                ir.add_operand(st0, av, 0)
            }
        }
        scope_put(nm, av, ty)
        // 表变量元素类型登记（table_push/table_at 选桥用）：
        // init 是 table<T>（含 table_new_* 调用）→ 记录元素类型。语义层
        // var_table_elem 已过期（per-function），table_new_f64() 返回裸 table
        // 无法从 node_types 得知元素类型。
        if init >= 0 {
            var tv_te: i64 = -1
            var it2 = node_types[init]
            if types.is_table(it2) && types.table_elem(it2) > 0 {
                tv_te = types.table_elem(it2)
            } else if s_tags[init] == 7 {
                var init_nm = sstate.name_str(init)
                if init_nm == "table_new_f64" {
                    tv_te = types.named(TK_F64)
                } else if init_nm == "table_new_string" {
                    tv_te = types.named(TK_STR)
                } else if init_nm == "table_new_bool" {
                    tv_te = types.named(TK_BOOL)
                } else if init_nm == "table_new_i64" {
                    tv_te = types.named(TK_I64)
                }
            }
            if tv_te >= 0 {
                // 键统一用 interner.intern（s_names[id] 是 parser 的 intern 池，
                // 与 table_push 的 interner.intern(tname) 不同池，id 不可比）
                tblvar_put(interner.intern(sstate.name_str(id)), tv_te)

            }
        }
        return 0
    }
    if tag == 102 {
        // ExprStmt。语句级宏（dev33 批次10 任务28）：`$body` 插值块形式 code
        // 值后，子节点可能是块形式 N_CODE_LIT（val=1）/嵌套 StmtList——
        // 按语句序列生成而非表达式。
        var e = sstate.child(id, 0)
        if e >= 0 {
            var et = s_tags[e]
            if et == 136 && s_vals[e] == 1 {
                var inner = sstate.child(e, 0)
                if inner >= 0 {
                    return tig_stmtlist_as_stmt(inner)
                }
            }
            if et == 122 {
                return tig_stmtlist_as_stmt(e)
            }
        }
        return tig_expr(e)
    }
    if tag == 130 {
        // S1.2 U3 unsafe 块：语义层已校验块内操作合法（unsafe 上下文），
        // irgen 只遍历子 StmtList 生成（无额外安全检查）
        var blk = sstate.child(id, 0)
        if blk < 0 {
            return 0
        }
        var n = sstate.nchild(blk)
        var i: i64 = 0
        while i < n {
            var r = tig_stmt(sstate.child(blk, i))
            if r < 0 {
                return -1
            }
            i = i + 1
        }
        return 0
    }
    if tag == 104 {
        // Return：children=[expr 或 -1]。ret 类型 = 表达式语义类型（i64/f64/
        // 聚合/字符串 ptr——曾硬编码 i64，元组/浮点返回会类型不匹配）。
        // BoolLit 适配 trit：返回 trit 的函数里 `return false/true` → i8
        var v = sstate.child(id, 0)
        if v >= 0 {
            var rv: i64 = -1
            if s_tags[v] == 4 && g_cur_ret_ty == types.named(TK_TRIT) {
                var tv: i64 = -1
                if s_vals[v] == 1 {
                    tv = 1
                }
                rv = tig_trit_lit(tv)
            } else {
                rv = tig_expr(v)
            }
            if rv < 0 {
                return -1
            }
            var rty = node_types[v]
            if rty < 0 {
                rty = types.named(TK_I64)
            }
            // S1.3 C2：返回值类型 ≠ 函数返回类型（数字族）→ 转换
            // （窄返回类型函数：`return i64 表达式` → trunc 到返回宽度）
            if g_cur_ret_ty >= 0 && (types.is_int(rty) || types.is_float(rty)) &&
                (types.is_int(g_cur_ret_ty) || types.is_float(g_cur_ret_ty)) &&
                rty != g_cur_ret_ty {
                var cr = tig_coerce(rv, rty, g_cur_ret_ty)
                if cr < 0 {
                    return -1
                }
                rv = cr
                rty = g_cur_ret_ty
            }
            // P2c：any 返回类型装箱——`func f() -> any { return 42 }` → box 为
            // {tag,payload}（对齐 var 声明装箱；返回值已是 any 则跳过）
            if g_cur_ret_ty == types.named(TK_ANY) && rty != types.named(TK_ANY) {
                var bx2 = tig_box_any(rv, rty)
                if bx2 < 0 {
                    return -1
                }
                rv = bx2
                rty = types.named(TK_ANY)
            }
            // p.6.10.3：返回表值 → retain（返回值接管归调用方；出口析构会减回——net 0，
            // 调用方持有返回表）；随后析构本函数非参数局部表。须在 ret（terminator）之前。
            if rty >= 0 && types.is_table(rty) {
                tig_tbl_retain_call(rv)
            }
            tig_tbl_exit_release()
            var ret = ir.new_inst(g_cur_block, 32, rty)  // ret
            ir.add_operand(ret, rv, 0)
        } else {
            // void 无值 return：main 特判 ret i32 0（CRT 退出码正确性，对齐 Rust 侧
            // tig_stmt 的 void main return 处理——define i32 @main 与 ret void 不匹配）；
            // 其余 void 函数 ret void。
            tig_tbl_exit_release()   // p.6.10.3：无值返回前同样析构非参数局部表
            if g_cur_fn_name == "main" {
                var ret = ir.new_inst(g_cur_block, 32, types.named(TK_I32))  // ret i32 0
                ir.add_operand(ret, 0, 2)
            } else {
                var ret = ir.new_inst(g_cur_block, 32, -1)  // ret void
            }
        }
        return 0
    }
    if tag == 105 {
        // If：children=[cond, then, else]
        var cond_nid = sstate.child(id, 0)
        var cond = tig_expr(cond_nid)
        if cond < 0 {
            return -1
        }
        // p.6.5.2：条件归一化 i1（`if x` x:i64 / 整型字面量 → icmp ne 0）
        cond = tig_cond_to_bool(cond, node_types[cond_nid])
        var then_blk = ir.new_block(g_cur_func, interner.intern("if.then"))
        var else_blk = ir.new_block(g_cur_func, interner.intern("if.else"))
        var merge_blk = ir.new_block(g_cur_func, interner.intern("if.merge"))
        // cond_br：条件 + then + else
        var cbr = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cbr, cond, 0)
        ir.add_operand(cbr, then_blk, 1)
        ir.add_operand(cbr, else_blk, 1)
        // then 分支
        g_cur_block = then_blk
        var then_list = sstate.child(id, 1)
        var t = tig_block_stmts(then_list)
        if t < 0 {
            return -1
        }
        if !block_terminated() {
            var br1 = ir.new_inst(g_cur_block, 30, -1)  // br merge
            ir.add_operand(br1, merge_blk, 1)
        }
        // else 分支
        g_cur_block = else_blk
        var else_list = sstate.child(id, 2)
        if else_list >= 0 {
            var e = tig_block_stmts(else_list)
            if e < 0 {
                return -1
            }
        }
        if !block_terminated() {
            var br2 = ir.new_inst(g_cur_block, 30, -1)
            ir.add_operand(br2, merge_blk, 1)
        }
        // merge
        g_cur_block = merge_blk
        return 0
    }
    if tag == 107 {
        // For：name=迭代变量, children=[iter, body]
        // 范围 0..N 最小集；表遍历 `for item in arr`（iter 为 Var 表变量）；
        // 字符串码点迭代 `for c in s.chars()`（dev33 批次4，iter 为 MethodCall）。
        var iter = sstate.child(id, 0)
        var body = sstate.child(id, 1)
        var iter_tag = s_tags[iter]
        if iter_tag == 18 {
            // 字符串码点迭代器 `.chars()`：走 UTF-8 码点步进循环
            if is_chars_method(iter) {
                var fc = tig_for_chars(id, iter, body)
                if fc < 0 {
                    return -1
                }
                return 0
            }
        }
        if iter_tag != 11 {
            // for-in 表迭代（动态表）：计数器 0..len(t) + tie_table_at 读取
            var fr = tig_for_table(id, iter, body)
            if fr < 0 {
                return -1
            }
            return 0
        }
        var start = tig_expr(sstate.child(iter, 0))
        if start < 0 {
            return -1
        }
        var end = tig_expr(sstate.child(iter, 1))
        if end < 0 {
            return -1
        }
        // 循环变量 alloca + 初始值
        var var_alloca = ir.new_inst(g_cur_block, 20, types.named(3))
        ir.add_operand(var_alloca, types.named(3), 2)
        var va = ir.get_value(var_alloca)
        var sv = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(sv, types.named(3), 2)
        ir.add_operand(sv, start, 0)
        ir.add_operand(sv, va, 0)
        scope_put(s_names[id], va, types.named(3))
        // cond/body/step/exit 块
        var cond_blk = ir.new_block(g_cur_func, interner.intern("for.cond"))
        var body_blk = ir.new_block(g_cur_func, interner.intern("for.body"))
        var step_blk = ir.new_block(g_cur_func, interner.intern("for.step"))
        var exit_blk = ir.new_block(g_cur_func, interner.intern("for.exit"))
        // 循环上下文：continue → step（自增后），break → exit
        loop_push(s_aux[id], exit_blk, step_blk)
        var b0 = ir.new_inst(g_cur_block, 30, -1)  // br cond
        ir.add_operand(b0, cond_blk, 1)
        // cond 块：cur < end → body，否则 exit
        g_cur_block = cond_blk
        var cur = ir.new_inst(g_cur_block, 21, types.named(3))
        ir.add_operand(cur, va, 0)
        var cur_v = ir.get_value(cur)
        var cmp = ir.new_inst(g_cur_block, 12, types.named(10))  // icmp, i1
        ir.add_operand(cmp, cur_v, 0)
        ir.add_operand(cmp, end, 0)
        ir.add_operand(cmp, 2, 2)  // lt
        var cmp_v = ir.get_value(cmp)
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, cmp_v, 0)
        ir.add_operand(cb, body_blk, 1)
        ir.add_operand(cb, exit_blk, 1)
        // body 块
        g_cur_block = body_blk
        var bb = tig_block_stmts(body)
        if bb < 0 {
            return -1
        }
        if !block_terminated() {
            var bb2 = ir.new_inst(g_cur_block, 30, -1)  // br step
            ir.add_operand(bb2, step_blk, 1)
        }
        // step 块：cur + 1 → store → br cond
        g_cur_block = step_blk
        var add1 = ir.new_inst(g_cur_block, 0, types.named(3))  // add
        ir.add_operand(add1, cur_v, 0)
        ir.add_operand(add1, 1, 2)  // 立即数 1
        var add_v = ir.get_value(add1)
        var st = ir.new_inst(g_cur_block, 22, -1)
        ir.add_operand(st, types.named(3), 2)
        ir.add_operand(st, add_v, 0)
        ir.add_operand(st, va, 0)
        var sb = ir.new_inst(g_cur_block, 30, -1)  // br cond
        ir.add_operand(sb, cond_blk, 1)
        // exit 块
        g_cur_block = exit_blk
        loop_pop()
        return 0
    }
    if tag == 106 {
        // While：children=[cond, body]。cond_br 回边 + 循环上下文
        var cond = sstate.child(id, 0)
        var body = sstate.child(id, 1)
        var label = s_names[id]
        // p.6.1.4：预扫循环体找可提升的字符串自加变量（静态核对后挂 sb）。
        // sb 以「out 循环前值」为起始段——提升从空 sb 开始，若循环前 out
        // 已有值（前一循环结果/初始精），必须保留（否则多循环链丢结果）。
        var cands = sb_scan(body, cond)
        var cix: i64 = 0
        while cix < len(cands) {
            table_push(g_sb_keys, cands[cix])
            var h_sb2 = s21_sb_new()
            if scope_get(cands[cix]) >= 0 {
                var pre_ld = ir.new_inst(g_cur_block, 21, types.named(TK_STR))  // load 旧值
                ir.add_operand(pre_ld, g_lookup_alloca, 0)
                s21_sb_append(h_sb2, ir.get_value(pre_ld))
            }
            table_push(g_sb_hv, h_sb2)
            cix = cix + 1
        }
        // p.6.1.4：字节表自加提升——循环前拷贝 t → 私有累积表 acc（唯一引用）
        var cbs_cands = cbs_scan(body, cond)
        var ccix: i64 = 0
        while ccix < len(cbs_cands) {
            table_push(g_cbs_keys, cbs_cands[ccix])
            if scope_get(cbs_cands[ccix]) >= 0 {
                var t_ld = ir.new_inst(g_cur_block, 21, types.named(TK_STR))  // load 表句柄值
                ir.add_operand(t_ld, g_lookup_alloca, 0)
                var acc_t = cbs_copy(ir.get_value(t_ld))
                table_push(g_cbs_acc, acc_t)
            } else {
                table_push(g_cbs_acc, 0)
            }
            ccix = ccix + 1
        }
        var cond_blk = ir.new_block(g_cur_func, interner.intern("while.cond"))
        var body_blk = ir.new_block(g_cur_func, interner.intern("while.body"))
        var exit_blk = ir.new_block(g_cur_func, interner.intern("while.exit"))
        loop_push(label, exit_blk, cond_blk)
        var b0 = ir.new_inst(g_cur_block, 30, -1)  // br cond
        ir.add_operand(b0, cond_blk, 1)
        // cond 块：条件 → body / exit
        g_cur_block = cond_blk
        var cv = tig_expr(cond)
        if cv < 0 {
            return -1
        }
        // p.6.5.2：条件归一化 i1（`while 1` / 整型条件 → icmp ne 0；
        // 旧实现把 i64 直接喂 cond_br，LLVM 校验失败）
        cv = tig_cond_to_bool(cv, node_types[cond])
        var cb = ir.new_inst(g_cur_block, 31, -1)
        ir.add_operand(cb, cv, 0)
        ir.add_operand(cb, body_blk, 1)
        ir.add_operand(cb, exit_blk, 1)
        // body 块
        g_cur_block = body_blk
        var bb = tig_block_stmts(body)
        if bb < 0 {
            return -1
        }
        if !block_terminated() {
            var bb2 = ir.new_inst(g_cur_block, 30, -1)  // br cond
            ir.add_operand(bb2, cond_blk, 1)
        }
        // exit 块
        g_cur_block = exit_blk
        // p.6.1.4：提升候选在循环出口 build 回写 out 槽（break/条件 false 全部汇入
        // exit_blk → 任一出口都拿到最终拼接串；sb 登记同步移除）
        var bix: i64 = 0
        while bix < len(cands) {
            var cnid = cands[bix]
            var hix = sb_find(cnid)
            if hix >= 0 {
                var bs = s21_sb_build(g_sb_hv[hix])
                if scope_get(cnid) >= 0 {
                    s21_store(g_lookup_alloca, bs, types.named(TK_STR))
                }
                sb_remove(cnid)
            }
            bix = bix + 1
        }
        // p.6.1.4：字节表候选 → acc 写回 t 槽（表句柄 ptr)，移除登记
        var cbx: i64 = 0
        while cbx < len(cbs_cands) {
            var cid2 = cbs_cands[cbx]
            var aiy = cbs_find(cid2)
            if aiy >= 0 {
                if scope_get(cid2) >= 0 {
                    s21_store(g_lookup_alloca, g_cbs_acc[aiy], types.named(TK_STR))
                }
                cbs_remove(cid2)
            }
            cbx = cbx + 1
        }
        loop_pop()
        return 0
    }
    if tag == 108 {
        // Break：br 到循环 exit 块
        var tgt = loop_find_break(s_names[id])
        if tgt < 0 {
            return -1
        }
        var b = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(b, tgt, 1)
        return 0
    }
    if tag == 109 {
        // Continue：br 到循环 cond/step 块
        var tgt = loop_find_cont(s_names[id])
        if tgt < 0 {
            return -1
        }
        var b = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(b, tgt, 1)
        return 0
    }
    if tag == 143 {
        // 三期 goto 标签（§7.1.5）：`#[tag.x]` → 目标基本块起点。
        // 标签块 = 跳转目标：创建（或复用 goto 预登记的占位块）并作为当前块
        // 的「新起点」——标签后的语句落入该块。前一条语句自然流到标签处，
        // 若当前块未 terminated，补 br 到标签块（标签 = 块内跳转点）。
        var lname = s_names[id]
        var lblk = goto_label_block(g_cur_func, lname)
        // 当前块未 terminated（有前置语句/空块首）→ br 到标签块；已 terminated
        // （如 goto/return 后）则标签块仅由 goto br 可达，无需补 br
        if !block_terminated() {
            var b = ir.new_inst(g_cur_block, 30, -1)
            ir.add_operand(b, lblk, 1)
        }
        g_cur_block = lblk
        return 0
    }
    if tag == 144 {
        // 三期 goto（§7.1.5）：`unsafe goto #x` → 无条件 br 到目标标签块。
        // 语义层已做 R1/R2/R3；标签块可能在前（已登记）或后（预登记占位——
        // LLVM 允许 br 引用后文标签）。goto 后的语句是死代码（opt DCE 清），
        // 由 tig_block_stmts 的 block_terminated 承接新块。
        var gname = s_names[id]
        var gblk = goto_label_block(g_cur_func, gname)
        var b = ir.new_inst(g_cur_block, 30, -1)
        ir.add_operand(b, gblk, 1)
        return 0
    }
    if tag == 146 {
        // 三期 A 组 `unsafe use g { ... }` 持证越界块（§7.1.1 + unsafe-model §13.4）：
        // 凭据运行期无操作（编译期门禁已由语义层强制），块体正常生成。
        return tig_stmtlist_as_stmt(sstate.child(id, 0))
    }
    if tag == 147 {
        // 三期 A 组 `unsafe with(share) { ... }` 临时凭据块：同上，块体正常生成。
        return tig_stmtlist_as_stmt(sstate.child(id, 1))
    }
    if tag == 103 {
        // Assign：name=目标名, val=op（-1 普通；0..17 复合赋值码，对齐 B_*），
        // children=[值]。复合赋值：load 旧值 → 运算 → store（对齐 Rust 同路径）。
        // 注意：目标槽（g_lookup_alloca）必须**先保存**——tig_expr(val) 求值会
        // 覆盖全局槽（x = y 时 y 的 scope_get 覆盖 g_lookup_alloca），曾导致
        // store 存错目标（a &= b 把结果存进 b）。
        var nm = sstate.name_str(id)
        var val = sstate.child(id, 0)
        var op = s_vals[id]
        var nid = interner.intern(nm)
        // p.6.1.4：循环内字符串自加提升——sb 挂起中且为 `out = out + seg...` 形态
        // → 段表达式逐个 sb_append（跳过 str_cat 全拷贝与 store；循环出口统一 build）。
        // 前提由 sb_scan 静态核对（局部 string、引用纯净、无其它写/goto）。
        if op < 0 && sb_find(nid) >= 0 && sb_is_self_add(val, nid) {
            var hv_sb = g_sb_hv[sb_find(nid)]
            var segs2 = sb_split_segs(val, nid)
            var si2: i64 = 0
            while si2 < len(segs2) {
                var sv2 = tig_expr(segs2[si2])
                if sv2 < 0 {
                    return -1
                }
                s21_sb_append(hv_sb, sv2)
                si2 = si2 + 1
            }
            return 0
        }
        // p.6.1.4：循环内字节表自加提升——cbs 挂起中且为 `t = byte_concat(t, seg)`
        // → 段就地追加到私有累积表（跳过整表拷贝+旧表泄漏；t 槽循环后写回）。
        if op < 0 && cbs_find(nid) >= 0 && cbs_is_self_concat(val, nid) {
            var cix2 = cbs_find(nid)
            var acc_h = g_cbs_acc[cix2]
            var coff = sstate.slot_off(val)
            var seg_n = sstate.child(val, coff + 1)
            var cseg = tig_expr(seg_n)
            if cseg < 0 {
                return -1
            }
            cbs_append(acc_h, cseg)
            return 0
        }
        if scope_get_global(nid) < 0 {
            sm_err_msg = "赋值目标 '" + nm + "' 未入作用域（函数 " + g_cur_fn_name + "）"
            return -1
        }
        var tgt_alloca = g_lookup_alloca
        var tgt_global = g_lookup_is_global
        var tgt_ty = g_lookup_ty
        var vv: i64 = -1
        if op >= 0 {
            // 复合赋值：先 load 旧值
            var cur = ir.new_inst(g_cur_block, 21, tgt_ty)  // load
            if tgt_global > 0 {
                ir.add_operand(cur, tgt_alloca, 3)
            } else {
                ir.add_operand(cur, tgt_alloca, 0)
            }
            var cur_v = ir.get_value(cur)
            var rv = tig_expr(val)
            if rv < 0 {
                return -1
            }
            vv = tig_compound_assign(op, cur_v, rv, tgt_ty)
            if vv < 0 {
                sm_err_msg = "复合赋值运算失败（变量 " + nm + "，函数 " + g_cur_fn_name + "）"
                return -1
            }
        } else {
            if s_tags[val] == 4 && tgt_ty == types.named(TK_TRIT) {
                // BoolLit 适配 trit（t = true 且 t 是 trit 变量 → i8 1）
                var tv: i64 = -1
                if s_vals[val] == 1 {
                    tv = 1
                }
                vv = tig_trit_lit(tv)
            } else {
                vv = tig_expr(val)
            }
            if vv < 0 {
                return -1
            }
        }
        // S1.3 C2/C3：赋值值类型 ≠ 目标槽类型（数字族）→ 转换（拓宽/缩窄）
        var vt = node_types[val]
        if op < 0 && vt >= 0 && (types.is_int(vt) || types.is_float(vt)) &&
            (types.is_int(tgt_ty) || types.is_float(tgt_ty)) && vt != tgt_ty {
            var cv = tig_coerce(vv, vt, tgt_ty)
            if cv < 0 {
                return -1
            }
            vv = cv
        }
        // p.6.10.2/3：表变量赋值引用计数插桩——仅普通赋值（非复合）、RHS 表类型。
        //  retain(新)：局部槽/全局槽接收引用时 +1；RHS 为 table_new_* 直接构造则
        //  免（新表所有权已转移给槽）。
        //  release(旧)：局部**非参数**目标覆盖前 -1（参数借用不回收调用方所有权；
        //  全局目标永驻不 release）。空句柄由 tl_tbl.tbl_release 守卫跳过。
        var assign_is_tbl: bool = false
        var assign_new_tbl: bool = false
        if op < 0 {
            var vt3 = node_types[val]
            if vt3 >= 0 && types.is_table(vt3) {
                assign_is_tbl = true
                if s_tags[val] == 7 {
                    var cnm4 = sstate.name_str(val)
                    if cnm4 == "table_new_i64" || cnm4 == "table_new_f64" ||
                        cnm4 == "table_new_string" || cnm4 == "table_new_bool" {
                        assign_new_tbl = true
                    }
                }
            }
        }
        if assign_is_tbl && !assign_new_tbl {
            tig_tbl_retain_call(vv)
        }
        var st = ir.new_inst(g_cur_block, 22, -1)  // store
        ir.add_operand(st, tgt_ty, 2)
        ir.add_operand(st, vv, 0)
        if tgt_global > 0 {
            ir.add_operand(st, tgt_alloca, 3)  // OK_GLOBAL 全局地址（池 id）
        } else {
            ir.add_operand(st, tgt_alloca, 0)  // 本地 alloca
        }
        if assign_is_tbl && tgt_global <= 0 && !tig_is_param(nid) {
            var old = ir.new_inst(g_cur_block, 21, tgt_ty)  // load 旧值
            ir.add_operand(old, tgt_alloca, 0)
            var old_v = ir.get_value(old)
            tig_tbl_release_call(old_v)
        }
        return 0
    }
    if tag == 110 {
        // Switch：字符串比较链（driver 树仅 typekw_index 一处，字符串 subject）
        return tig_switch(id)
    }
    if tag == 116 {
        // IndexAssign：t[i] = v → tie_table_set 桥
        return tig_index_assign(id)
    }
    if tag == 115 {
        // FieldAssign：obj.field = v（元组/struct 字段赋值；复合赋值 op ≥ 0）
        return tig_field_assign(id)
    }
    if tag == 134 {
        // S2.3：`panic("消息")` 不可恢复错误语句（N_PANIC）→ printf + exit(1)
        return tig_panic(id)
    }
    if tag == 122 {
        // N_STMTLIST 作语句：逐子语句生成（语句位置宏 `$body` 插值块后残留的
        // 嵌套语句列表——dev33 批次10 任务28 语句级宏）。
        return tig_stmtlist_as_stmt(id)
    }
    if tag == 136 {
        // N_CODE_LIT 块形式（val=1）作语句：展开内部 StmtList（`$body` 插值
        // 块形式 code 值后残留；表达式形式 val=0 在表达式层报错）。
        if s_vals[id] == 1 {
            var inner = sstate.child(id, 0)
            if inner >= 0 {
                return tig_stmtlist_as_stmt(inner)
            }
        }
        sm_err_line = s_lines[id]
        sm_err_col = s_cols[id]
        sm_err_msg = "irgen 不支持 code 字面量作语句（tag=136，函数 " + g_cur_fn_name + "）"
        return -1
    }
    sm_err_line = s_lines[id]
    sm_err_col = s_cols[id]
    sm_err_msg = "irgen 未支持的语句（tag=" + to_string(tag) + "，函数 " + g_cur_fn_name + "）"
    return -1  // 其他语句后续扩展
}

// N_STMTLIST 作语句（dev33 批次10 任务28）：嵌套语句列表逐子语句生成。
// 语句级宏展开结果可能含 StmtList-in-StmtList（`$body` 插值块后），后端
// 直接展开为序列——与语义层 smove 处理一致。
func tig_stmtlist_as_stmt(id: i64) -> i64 {
    var n = sstate.nchild(id)
    var k: i64 = 0
    while k < n {
        var c = sstate.child(id, k)
        if c >= 0 {
            if tig_stmt(c) < 0 {
                return -1
            }
        }
        k = k + 1
    }
    return 0
}

// 判定 for 迭代对象是否为字符串码点迭代器调用 `s.chars()`（MethodCall）。
// 结构：方法名 == "chars"，接收者（child[slot_off]）为 string 值。仅 for-in
// 路径识别（tig_stmt tag==107 在进 tig_for_table 前探测），与 --prep 探针协调。
func is_chars_method(iter: i64) -> bool {
    if s_tags[iter] != 18 {
        return false
    }
    if sstate.name_str(iter) != "chars" {
        return false
    }
    var recv = sstate.child(iter, sstate.slot_off(iter))
    var rt = node_types[recv]
    if rt < 0 || rt != types.named(TK_STR) {
        return false
    }
    return true
}

// for-in 字符串码点迭代：`for c in s.chars()`（dev33 批次4 语法糖）。
// 布局：循环变量 alloca（TK_STR，单字符）+ 字节位置计数器 alloca（i64）；
// cond 块：字节位置 < str_len(s) 终结（s21_str_head_len O(1)）；body 块每次
// 迭代 s21_utf8_char_at 解码码点 → s21_codepoint_to_str 得单字符字符串 → store
// 到循环变量；step 块：位置 += s21_utf8_seq_len（字节步进）。continue → step，
// break → exit。等价手写 while + utf8_seq_len/utf8_char_at 组合。
func tig_for_chars(id: i64, iter: i64, body: i64) -> i64 {
    // 接收者字符串值（s.chars() 的 s）
    var recv = sstate.child(iter, sstate.slot_off(iter))
    var s = tig_expr(recv)
    if s < 0 {
        return -1
    }
    // 记录当前块（tig_expr 可能切块），循环开始处用。
    // 循环变量 alloca（TK_STR）+ 字节位置计数器 alloca（i64）
    var item_a = ir.new_inst(g_cur_block, 20, types.named(TK_STR))  // alloca string
    ir.add_operand(item_a, types.named(TK_STR), 2)
    var item_ptr = ir.get_value(item_a)
    var pos_a = ir.new_inst(g_cur_block, 20, types.named(TK_I64))  // alloca i64
    ir.add_operand(pos_a, types.named(TK_I64), 2)
    var pos_ptr = ir.get_value(pos_a)
    var pos_zero = tig_int_lit_ty(0, types.named(TK_I64))
    var st0 = ir.new_inst(g_cur_block, 22, -1)  // store 0 → pos
    ir.add_operand(st0, types.named(TK_I64), 2)
    ir.add_operand(st0, pos_zero, 0)
    ir.add_operand(st0, pos_ptr, 0)
    // 四块：cond / body / step / exit
    var cond_blk = ir.new_block(g_cur_func, interner.intern("for.cond"))
    var body_blk = ir.new_block(g_cur_func, interner.intern("for.body"))
    var step_blk = ir.new_block(g_cur_func, interner.intern("for.step"))
    var exit_blk = ir.new_block(g_cur_func, interner.intern("for.exit"))
    loop_push(s_aux[id], exit_blk, step_blk)
    var b0 = ir.new_inst(g_cur_block, 30, -1)  // br cond
    ir.add_operand(b0, cond_blk, 1)
    // cond 块：pos < byte_len(s) → body，否则 exit
    g_cur_block = cond_blk
    var cur = ir.new_inst(g_cur_block, 21, types.named(TK_I64))  // load pos
    ir.add_operand(cur, pos_ptr, 0)
    var cur_v = ir.get_value(cur)
    var blen = s21_str_head_len(s)
    var ol = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))  // icmp ult
    ir.add_operand(ol, cur_v, 0)
    ir.add_operand(ol, blen, 0)
    ir.add_operand(ol, 6, 2)  // ult
    var ol_v = ir.get_value(ol)
    var cb = ir.new_inst(g_cur_block, 31, -1)  // cond_br
    ir.add_operand(cb, ol_v, 0)
    ir.add_operand(cb, body_blk, 1)
    ir.add_operand(cb, exit_blk, 1)
    // body 块：cp = utf8_char_at(s, pos) → 单字符 = str_from_code(cp) → store
    g_cur_block = body_blk
    // 重新 load pos（body 块内 SSA）
    var cur2 = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
    ir.add_operand(cur2, pos_ptr, 0)
    var cur2_v = ir.get_value(cur2)
    var cp = s21_utf8_char_at(s, cur2_v)
    // 码点 → 单字符字符串（去 Rust 桥：s21_codepoint_to_str 内联，不链 tie_interp.lib）
    var ch = s21_codepoint_to_str(cp)
    var ist = ir.new_inst(g_cur_block, 22, -1)  // store 单字符 → 循环变量
    ir.add_operand(ist, types.named(TK_STR), 2)
    ir.add_operand(ist, ch, 0)
    ir.add_operand(ist, item_ptr, 0)
    scope_put(s_names[id], item_ptr, types.named(TK_STR))
    var bb = tig_block_stmts(body)
    if bb < 0 {
        return -1
    }
    scope_pop()
    if !block_terminated() {
        var bb2 = ir.new_inst(g_cur_block, 30, -1)  // br step
        ir.add_operand(bb2, step_blk, 1)
    }
    // step 块：pos += utf8_seq_len(s, pos) → store → br cond
    g_cur_block = step_blk
    var cur3 = ir.new_inst(g_cur_block, 21, types.named(TK_I64))
    ir.add_operand(cur3, pos_ptr, 0)
    var cur3_v = ir.get_value(cur3)
    var slen = s21_utf8_seq_len(s, cur3_v)
    var np = s21_bin(0, cur3_v, slen)  // add
    var st2 = ir.new_inst(g_cur_block, 22, -1)
    ir.add_operand(st2, types.named(TK_I64), 2)
    ir.add_operand(st2, np, 0)
    ir.add_operand(st2, pos_ptr, 0)
    var sb = ir.new_inst(g_cur_block, 30, -1)  // br cond
    ir.add_operand(sb, cond_blk, 1)
    // exit 块
    g_cur_block = exit_blk
    loop_pop()
    return 0
}

// for-in 表迭代：`for item in t`（t 为动态表变量/表达式）。
// 布局（对齐 Rust gen_for_dyn_table）：计数器 alloca（0..len(t)，cond 块每次
// 调 tie_table_len）+ 循环变量 alloca（元素类型 T）；body 每次迭代
// tie_table_at 读取元素 → store 到循环变量；continue → step，break → exit。
func tig_for_table(id: i64, iter: i64, body: i64) -> i64 {
    // 表指针（load ptr 槽 / 全局表 load ptr, ptr @g）
    var t = tig_expr(iter)
    if t < 0 {
        return -1
    }
    // 元素类型判定优先级：
    //   1. iter 变量的作用域完整类型（table<T> → table_elem）
    //   2. node_types[iter] 的表元素类型（语义推导）
    //   3. sinfer.var_table_elem（语义层动态表登记）
    //   4. body 中循环变量引用节点的语义类型（for f in entries 里 println(f) 推断）
    //   5. 兜底 i64
    var elem: i64 = types.named(TK_I64)
    var matched: bool = false
    if s_tags[iter] == 6 {
        var bname = interner.intern(sstate.name_str(iter))
        if scope_get(bname) >= 0 && types.is_table(g_lookup_ty) {
            var le = types.table_elem(g_lookup_ty)
            if le > 0 {
                elem = le
                matched = true
            }
        }
        if !matched {
            var bt2 = node_types[iter]
            if types.is_table(bt2) {
                var le2 = types.table_elem(bt2)
                if le2 > 0 {
                    elem = le2
                    matched = true
                }
            }
        }
        if !matched {
            var te = sinfer.var_table_elem(bname)
            if te >= 0 {
                elem = te
                matched = true
            }
        }
    } else {
        var bt = node_types[iter]
        if types.is_table(bt) {
            var le2 = types.table_elem(bt)
            if le2 > 0 {
                elem = le2
                matched = true
            }
        }
    }
    if !matched {
        // body 中循环变量引用类型（`for f in entries { println(f) }` →
        // f 的引用节点被语义层推断为 TK_STR）
        var var_nm = interner.intern(sstate.name_str(id))
        var bn = sstate.nchild(body)
        var bi: i64 = 0
        while bi < bn {
            var st0 = sstate.child(body, bi)
            var refs = find_var_refs(st0, var_nm)
            var ri: i64 = 0
            while ri < len(refs) {
                var rt = node_types[refs[ri]]
                if rt >= 0 && (rt == types.named(TK_STR) || types.is_int(rt) ||
                    types.is_float(rt) || types.is_bool_like(rt)) {
                    elem = rt
                    matched = true
                    break
                }
                ri = ri + 1
            }
            if matched {
                break
            }
            bi = bi + 1
        }
    }
    var suffix = bridge_suffix(elem)
    var elem_llvm_ty = types.named(TK_I64)
    // P2a 复合元素（struct/enum/fn）：循环变量类型 = 元素类型 id（多字元素）
    var fk2 = types.kind(elem)
    if fk2 == K_STRUCT || fk2 == K_ENUM || fk2 == K_FN || elem == types.named(TK_ANY) {
        elem_llvm_ty = elem
    } else if types.is_table(elem) || types.is_map(elem) || types.kind(elem) == K_PORT {
        suffix = "string"
        elem_llvm_ty = elem
    } else if suffix == "string" {
        elem_llvm_ty = types.named(TK_STR)
    } else if suffix == "bool" {
        elem_llvm_ty = types.named(TK_BOOL)
    } else if suffix == "f64" {
        elem_llvm_ty = types.named(TK_F64)
    }
    // 计数器 alloca（i64）+ store 0
    var idx_a = ir.new_inst(g_cur_block, 20, types.named(TK_I64))  // alloca
    ir.add_operand(idx_a, types.named(TK_I64), 2)
    var idx_ptr = ir.get_value(idx_a)
    var i0 = tig_int_lit_ty(0, types.named(TK_I64))
    var st0 = ir.new_inst(g_cur_block, 22, -1)  // store 0
    ir.add_operand(st0, types.named(TK_I64), 2)
    ir.add_operand(st0, i0, 0)
    ir.add_operand(st0, idx_ptr, 0)
    // 循环变量 alloca（元素类型）
    var item_a = ir.new_inst(g_cur_block, 20, elem_llvm_ty)  // alloca
    ir.add_operand(item_a, elem_llvm_ty, 2)
    var item_ptr = ir.get_value(item_a)
    // 四块：cond / body / step / exit
    var cond_blk = ir.new_block(g_cur_func, interner.intern("for.cond"))
    var body_blk = ir.new_block(g_cur_func, interner.intern("for.body"))
    var step_blk = ir.new_block(g_cur_func, interner.intern("for.step"))
    var exit_blk = ir.new_block(g_cur_func, interner.intern("for.exit"))
    loop_push(s_aux[id], exit_blk, step_blk)
    var b0 = ir.new_inst(g_cur_block, 30, -1)  // br cond
    ir.add_operand(b0, cond_blk, 1)
    // cond 块：cur >= len(t) → exit
    g_cur_block = cond_blk
    var cur = ir.new_inst(g_cur_block, 21, types.named(TK_I64))  // load
    ir.add_operand(cur, idx_ptr, 0)
    var cur_v = ir.get_value(cur)
    var tlen = s21_table_len(t)
    if tlen < 0 {
        return -1
    }
    var done = ir.new_inst(g_cur_block, 12, types.named(TK_BOOL))  // icmp sge
    ir.add_operand(done, cur_v, 0)
    ir.add_operand(done, tlen, 0)
    ir.add_operand(done, 5, 2)  // sge
    var done_v = ir.get_value(done)
    var cb = ir.new_inst(g_cur_block, 31, -1)
    ir.add_operand(cb, done_v, 0)
    ir.add_operand(cb, exit_blk, 1)
    ir.add_operand(cb, body_blk, 1)
    // body 块：item = table_at(t, cur) → store → 循环体
    g_cur_block = body_blk
    var ok_slot = ir.new_inst(g_cur_block, 20, types.named(TK_I8))  // alloca i8
    ir.add_operand(ok_slot, types.named(TK_I8), 2)
    var iv = s21_table_at(t, cur_v, ir.get_value(ok_slot), elem_llvm_ty)
    if iv < 0 {
        return -1
    }
    var ist = ir.new_inst(g_cur_block, 22, -1)  // store
    ir.add_operand(ist, elem_llvm_ty, 2)
    ir.add_operand(ist, iv, 0)
    ir.add_operand(ist, item_ptr, 0)
    scope_put(s_names[id], item_ptr, elem_llvm_ty)
    var bb = tig_block_stmts(body)
    if bb < 0 {
        return -1
    }
    scope_pop()
    if !block_terminated() {
        var bb2 = ir.new_inst(g_cur_block, 30, -1)  // br step
        ir.add_operand(bb2, step_blk, 1)
    }
    // step 块：cur + 1 → store → br cond
    g_cur_block = step_blk
    var add1 = ir.new_inst(g_cur_block, 0, types.named(TK_I64))  // add
    ir.add_operand(add1, cur_v, 0)
    ir.add_operand(add1, 1, 2)
    var add_v = ir.get_value(add1)
    var st2 = ir.new_inst(g_cur_block, 22, -1)
    ir.add_operand(st2, types.named(TK_I64), 2)
    ir.add_operand(st2, add_v, 0)
    ir.add_operand(st2, idx_ptr, 0)
    var sb = ir.new_inst(g_cur_block, 30, -1)  // br cond
    ir.add_operand(sb, cond_blk, 1)
    // exit 块
    g_cur_block = exit_blk
    loop_pop()
    return 0
}

// 语句树中查找变量引用节点（tag 6，名池 id == target）：返回节点 id 表。
// tig_for_table 用它推断循环变量元素类型（body 里 println(f) → node_types[f]）
func find_var_refs(st: i64, target: i64) -> table<i64> {
    var out = table_new_i64()
    collect_var_refs(st, target, out)
    return out
}

// find_var_refs 的递归实现（深度优先遍历子节点）
func collect_var_refs(st: i64, target: i64, out: table<i64>) {
    if st < 0 {
        return
    }
    if s_tags[st] == 6 && s_names[st] == target {
        table_push(out, st)
        return  // 变量节点是叶子
    }
    var n = sstate.nchild(st)
    var i: i64 = 0
    while i < n {
        collect_var_refs(sstate.child(st, i), target, out)
        i = i + 1
    }
}

// ==================== 循环内字符串自加 StringBuilder 提升（p.6.1.4） ====================
// 识别 `out = out + seg...`（string 局部变量自加拼接）→ 循环内自动改为
// StringBuilder 追加（s21_sb_*），循环出口 sb_build 回写 out。根治 str_cat
// O(n²) 无名分配带来的内存无界增长（每次 + 新分配、旧中间串永不释放）。
// 提升前提（逐项静态核对，任何不满足即退回原 str_cat 路径）：
//   1) out 是函数内局部 string 变量（非全局）
//   2) 循环体（含条件）内 out 的全部引用仅是自加 RHS 的最左叶子——
//      无其它读、无取址/传参、无非自加赋值（其它写）
//   3) 循环体内无 goto 逃出（break/continue 均汇入 exit/cond 块，安全）
// 语义与原逐段拼接完全等价：最终 out = 全部段的顺序拼接。

func sb_contains(t: table<i64>, v: i64) -> bool {
    var i: i64 = 0
    while i < len(t) {
        if t[i] == v {
            return true
        }
        i = i + 1
    }
    return false
}

// 定位 sb 状态索引（-1 未提升）
func sb_find(nid: i64) -> i64 {
    var i: i64 = 0
    while i < len(g_sb_keys) {
        if g_sb_keys[i] == nid {
            return i
        }
        i = i + 1
    }
    return -1
}

// 取消提升登记（循环出口 build 回写后）。表重建去除目标条目。
func sb_remove(nid: i64) {
    var i = sb_find(nid)
    if i < 0 {
        return
    }
    var outk = table_new_i64()
    var outh = table_new_i64()
    var j: i64 = 0
    while j < len(g_sb_keys) {
        if j != i {
            table_push(outk, g_sb_keys[j])
            table_push(outh, g_sb_hv[j])
        }
        j = j + 1
    }
    g_sb_keys = outk
    g_sb_hv = outh
}

// val 是否为 `out + ...` 自加形态：B_ADD(0) 左链，最左叶子 = Var(out)，
// node_types[val] == TK_STR（字符串拼接）。
func sb_is_self_add(val: i64, nid: i64) -> bool {
    if val < 0 {
        return false
    }
    if node_types[val] != types.named(TK_STR) {
        return false
    }
    var cur = val
    while s_tags[cur] == 9 && s_vals[cur] == 0 {  // N_BINARY + B_ADD
        var lhs = sstate.child(cur, 0)
        cur = lhs
    }
    return s_tags[cur] == 6 && s_names[cur] == nid
}

// 提取自加 RHS 的段节点（`out + a + b + c` → [a, b, c]，顺序正序；
// 非自加形态返回空表）。
func sb_split_segs(val: i64, nid: i64) -> table<i64> {
    var rev = table_new_i64()
    var cur = val
    var depth: i64 = 0
    while s_tags[cur] == 9 && s_vals[cur] == 0 && depth < 64 {
        var lhs = sstate.child(cur, 0)
        var rhs = sstate.child(cur, 1)
        table_push(rev, rhs)
        depth = depth + 1
        cur = lhs
    }
    if s_tags[cur] != 6 || s_names[cur] != nid {
        var empty = table_new_i64()
        return empty
    }
    var segs = table_new_i64()
    var i: i64 = len(rev) - 1
    while i >= 0 {
        table_push(segs, rev[i])
        i = i - 1
    }
    return segs
}

// 递归收集语句树中的自加候选（合法叶 + 候选名 + 其它写标记 + goto 探测）
func sb_collect(st: i64, legal: table<i64>, nids: table<i64>) {
    if st < 0 {
        return
    }
    if s_tags[st] == 144 {  // goto：逃出循环 → 全局禁提升（调用方查 goflag）
        return
    }
    if s_tags[st] == 103 {  // N_ASSIGN
        var nm = sstate.name_str(st)
        if str_len(nm) > 0 {
            var nid = interner.intern(nm)
            var val = sstate.child(st, 0)
            if sb_is_self_add(val, nid) {
                var leaf = sb_left_leaf(val)
                if leaf >= 0 {
                    table_push(legal, leaf)
                }
                if !sb_contains(nids, nid) {
                    table_push(nids, nid)
                }
            }
        }
        return  // Assign 的 val 子树不作为语句继续扫（引用检查由 find_var_refs 全量覆盖）
    }
    var n = sstate.nchild(st)
    var i: i64 = 0
    while i < n {
        sb_collect(sstate.child(st, i), legal, nids)
        i = i + 1
    }
}

// 自加 RHS 左链最左叶子节点（= 该 out 的 Var 引用节点；-1 非自加形态）
func sb_left_leaf(val: i64) -> i64 {
    if val < 0 {
        return -1
    }
    var cur = val
    while s_tags[cur] == 9 && s_vals[cur] == 0 {
        cur = sstate.child(cur, 0)
    }
    if s_tags[cur] == 6 {
        return cur
    }
    return -1
}

// 扫描循环体：返回可安全提升的自加 string 变量名 id 表（空 = 不提升）。
// 核对 1) 局部 string 未 pending；2) 无其它写；3) 无 goto；4) 引用纯净。
func sb_scan(body: i64, cond: i64) -> table<i64> {
    var jobs = table_new_i64()
    var legal = table_new_i64()
    sb_collect(body, legal, jobs)
    var w_nid = table_new_i64()
    var w_has = table_new_i64()
    collect_other_writes(body, w_nid, w_has)
    var out = table_new_i64()
    var i: i64 = 0
    while i < len(jobs) {
        var nid = jobs[i]
        var ok: bool = true
        if scope_get(nid) < 0 {
            ok = false
        }
        if ok && g_lookup_is_global != 0 {
            ok = false
        }
        if ok && g_lookup_ty != types.named(TK_STR) {
            ok = false
        }
        if ok && sb_find(nid) >= 0 {
            ok = false
        }
        if ok && scan_goto(body) {
            ok = false
        }
        var wi = linear_find(w_nid, nid)
        if ok && wi >= 0 && w_has[wi] == 1 {
            ok = false
        }
        // 引用纯净：全部引用（body + cond）∈ 合法自加叶
        if ok {
            var refs = find_var_refs(body, nid)
            var rc = find_var_refs(cond, nid)
            var rk: i64 = 0
            while rk < len(rc) {
                table_push(refs, rc[rk])
                rk = rk + 1
            }
            var j: i64 = 0
            while j < len(refs) {
                if !sb_contains(legal, refs[j]) {
                    ok = false
                    break
                }
                j = j + 1
            }
        }
        if ok {
            table_push(out, nid)
        }
        i = i + 1
    }
    return out
}

// 收集所有「out 作为赋值目标但非自加」的写（其它写 → 提升不安全）
func collect_other_writes(st: i64, w_nid: table<i64>, w_has: table<i64>) {
    if st < 0 {
        return
    }
    if s_tags[st] == 144 {
        return
    }
    if s_tags[st] == 103 {
        var nm = sstate.name_str(st)
        if str_len(nm) > 0 {
            var nid = interner.intern(nm)
            var val = sstate.child(st, 0)
            // 自加不视为"其它写"：字符串 `t = t + x`（sb）与字节表
            // `t = byte_concat(t, x)`（cbs）都属提升目标，非破坏性写
            if !sb_is_self_add(val, nid) && !cbs_is_self_concat(val, nid) {
                var wi = linear_find(w_nid, nid)
                if wi < 0 {
                    table_push(w_nid, nid)
                    table_push(w_has, 1)
                }
            }
        }
        return
    }
    // 其它写目标：下标赋值 N_INDEX_ASSIGN / 字段赋值 N_FIELD_ASSIGN 也归为写
    if s_tags[st] == 104 || s_tags[st] == 115 {  // N_INDEX_ASSIGN / N_FIELD_ASSIGN
        var wbase = sstate.child(st, 0)
        if s_tags[wbase] == 6 {
            var nid2 = s_names[wbase]
            var wi2 = linear_find(w_nid, nid2)
            if wi2 < 0 {
                table_push(w_nid, nid2)
                table_push(w_has, 1)
            }
        }
        return
    }
    var n = sstate.nchild(st)
    var i: i64 = 0
    while i < n {
        collect_other_writes(sstate.child(st, i), w_nid, w_has)
        i = i + 1
    }
}

// 线性查找（表值 → 下标；-1 无）
func linear_find(t: table<i64>, v: i64) -> i64 {
    var i: i64 = 0
    while i < len(t) {
        if t[i] == v {
            return i
        }
        i = i + 1
    }
    return -1
}

// 探测语句树是否含 goto（144）——含则循环可能逃出 → 禁提升
func scan_goto(st: i64) -> bool {
    if st < 0 {
        return false
    }
    if s_tags[st] == 144 {
        return true
    }
    var n = sstate.nchild(st)
    var i: i64 = 0
    while i < n {
        if scan_goto(sstate.child(st, i)) {
            return true
        }
        i = i + 1
    }
    return false
}

// ==================== 字节表自加 StringBuilder 提升（cbs，p.6.1.4） ====================
// 识别 `t = byte_concat(t, seg...)`（局部字节表变量自加累积）→ 循环内改为
// 私有累积表 acc 就地追加，循环出口写回 t。根治 byte_concat O(n²) 无名分配
//（每迭代新建整表 + 旧表永不释放，dpcodec/jcc-pack encode 内存无界增长根因）。
// 安全前提（与字符串 sb 提升同构，逐项核对）：
//   1) t 是函数内局部 table<i64> 变量（非全局）
//   2) 循环体（含条件）内 t 的全部引用仅是自加 RHS 第一实参（Var(t)）——
//      无其它读、无取址/传参、无非自加赋值（其它写）
//   3) 循环体内无 goto 逃出
// 装配：循环前 acc = 拷贝(t)（唯一引用，旧表只读不写 → 无别名污染）；
// 体内自加 → acc 就地追加（tl_tbl$tbl_ensure 扩容免旧块 + memcpy）；
// 循环出口（break 经 exit 块覆盖）store acc 到 t 槽。语义与原逐段拼接完全等价。

// byte_concat 形态判定：val 为 builtin 调用 `byte_concat(Var(t), 任意)` 或
// 字节拼接包装 `concat(Var(t), 任意)`（如 zd.concat → byte_concat 转发）。
// 内置调用节点：s_names 存名字、实参 children[slot_off(+k)]（call_arg 布局）。
// 注：concat 需"返回值赋给首参表变量 + 引用纯净"双门（cbs_scan）兜底，
// 语义非拼接的自定义 concat 因引用纯净不满足自然被排除。
func cbs_is_self_concat(val: i64, nid: i64) -> bool {
    if val < 0 {
        return false
    }
    var nm = sstate.name_str(val)
    if nm != "byte_concat" && nm != "concat" {
        return false
    }
    var off = sstate.slot_off(val)
    var a0 = sstate.child(val, off)
    if a0 < 0 {
        return false
    }
    return s_tags[a0] == 6 && s_names[a0] == nid
}

// 定位 cbs 状态索引（-1 未提升）
func cbs_find(nid: i64) -> i64 {
    var i: i64 = 0
    while i < len(g_cbs_keys) {
        if g_cbs_keys[i] == nid {
            return i
        }
        i = i + 1
    }
    return -1
}

// 取消提升登记（循环出口写回后）
func cbs_remove(nid: i64) {
    var i = cbs_find(nid)
    if i < 0 {
        return
    }
    var outk = table_new_i64()
    var outa = table_new_i64()
    var j: i64 = 0
    while j < len(g_cbs_keys) {
        if j != i {
            table_push(outk, g_cbs_keys[j])
            table_push(outa, g_cbs_acc[j])
        }
        j = j + 1
    }
    g_cbs_keys = outk
    g_cbs_acc = outa
}

// 私有累积表新建 + 拷贝 t 现有内容（表基座 32B {cap,len,data,esz}）。
func cbs_copy(t: i64) -> i64 {
    var T64 = types.named(TK_I64)
    var lv = s21_load(s21_gep(t, 8, true), T64)
    var eszv = s21_load(s21_gep(t, 24, true), T64)
    var h = s21_raw_alloc_str(tig_int_lit(32))
    s21_store(s21_gep(h, 0, true), lv, T64)
    s21_store(s21_gep(h, 8, true), lv, T64)
    var buf = s21_raw_alloc_str(s21_bin(2, lv, eszv))
    s21_memcpy_if(buf, t21_data(t), s21_bin(2, lv, eszv))
    s21_store(s21_gep(h, 16, true), buf, types.named(TK_STR))
    s21_store(s21_gep(h, 24, true), eszv, T64)
    return h
}

// 就地追加段 x 到累积表 acc：ensure 扩容（免费旧块）→ memcpy → set_len。
func cbs_append(acc: i64, x: i64) {
    var T64 = types.named(TK_I64)
    var la = s21_load(s21_gep(acc, 8, true), T64)
    var lx = s21_load(s21_gep(x, 8, true), T64)
    var eszv = s21_load(s21_gep(acc, 24, true), T64)
    var need = s21_bin(0, la, lx)
    var data_i = tl_i64_2("tl_tbl$tbl_ensure", t21_ptri(acc), need)
    var data_p = t21_intp(data_i)
    var dst = s21_gep(data_p, s21_bin(2, la, eszv), false)
    s21_memcpy_if(dst, t21_data(x), s21_bin(2, lx, eszv))
    s21_store(s21_gep(acc, 8, true), need, T64)
}

// 递归收集循环内 `t = byte_concat(t, x)` 自加候选（合法叶 = RHS 第一实参 Var）。
func cbs_collect(st: i64, legal: table<i64>, nids: table<i64>) {
    if st < 0 {
        return
    }
    if s_tags[st] == 144 {
        return
    }
    if s_tags[st] == 103 {
        var nm = sstate.name_str(st)
        if str_len(nm) > 0 {
            var nid = interner.intern(nm)
            var val = sstate.child(st, 0)
            if cbs_is_self_concat(val, nid) {
                var off = sstate.slot_off(val)
                var a0 = sstate.child(val, off)
                if a0 >= 0 {
                    table_push(legal, a0)
                }
                if !sb_contains(nids, nid) {
                    table_push(nids, nid)
                }
            }
        }
        return
    }
    var n = sstate.nchild(st)
    var i: i64 = 0
    while i < n {
        cbs_collect(sstate.child(st, i), legal, nids)
        i = i + 1
    }
}

// 扫描循环体：返回可安全提升的字节表自加变量名 id 表（空 = 不提升）。
func cbs_scan(body: i64, cond: i64) -> table<i64> {
    var jobs = table_new_i64()
    var legal = table_new_i64()
    cbs_collect(body, legal, jobs)
    var w_nid = table_new_i64()
    var w_has = table_new_i64()
    collect_other_writes(body, w_nid, w_has)
    var out = table_new_i64()
    var i: i64 = 0
    while i < len(jobs) {
        var nid = jobs[i]
        var ok: bool = true
        if scope_get(nid) < 0 {
            ok = false
        }
        if ok && g_lookup_is_global != 0 {
            ok = false
        }
        if ok && g_lookup_ty != types.named(TK_STR) && !types.is_table(g_lookup_ty) {
            ok = false
        }
        if ok && cbs_find(nid) >= 0 {
            ok = false
        }
        if ok && scan_goto(body) {
            ok = false
        }
        var wi = linear_find(w_nid, nid)
        if ok && wi >= 0 && w_has[wi] == 1 {
            ok = false
        }
        if ok {
            var refs = find_var_refs(body, nid)
            var rc = find_var_refs(cond, nid)
            var rk: i64 = 0
            while rk < len(rc) {
                table_push(refs, rc[rk])
                rk = rk + 1
            }
            var j: i64 = 0
            while j < len(refs) {
                if !sb_contains(legal, refs[j]) {
                    ok = false
                    break
                }
                j = j + 1
            }
        }
        if ok {
            table_push(out, nid)
        }
        i = i + 1
    }
    return out
}

// 语句块遍历（StmtList children）。每个块独立作用域（push/pop）。
// 死代码承接：前一条语句已终止块（goto/break/continue/return 等 terminator）
// 后仍有语句时，新开承接块存放后续死代码——LLVM 不允许 terminator 后跟指令，
// 死块由 opt DCE 清理（设计 §7.1.5：goto 后不可达代码 opt 清理，不报错）。
func tig_block_stmts(blk: i64) -> i64 {
    scope_push()
    var n = sstate.nchild(blk)
    var i: i64 = 0
    while i < n {
        var s = sstate.child(blk, i)
        if block_terminated() {
            g_cur_block = ir.new_block(g_cur_func, interner.intern("blk.dead"))
        }
        var r = tig_stmt(s)
        if r < 0 {
            return -1
        }
        i = i + 1
    }
    scope_pop()
    return 0
}

}
