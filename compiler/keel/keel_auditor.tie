type tie<class>
// compiler/keel/keel_auditor.tie —— Keel 龙骨 p.7.1.5 安全审计链（审计核心 ①树根 ②验签 ③信任锚）
// ============================================================
// 目标（Keel 设计稿 §5 安全模型两正交轴）：
//   指纹轴（防篡改，无中心权威）：per-file tsha1f + 包树根 tsha1x
//   凭证轴（去中心认证）：pubkey(Ed25519) + package.sig 对树根签名 + TOFU 信任锚
// 本模块实现审计链核心的 ①②③（产权）与 ① 的包树根级聚合：
//   ① 树根：fingerprint_tree(dir) 扫目录 *.tie → per-file tsha1f（n=48）→
//      拼接清单（<name>:<fp>\n，名字升序）→ tsha1x 作包树根。tsha1x 非原生
//      Merkle 树根 API（std/tsha1 的 x 档只是加强型哈希函数），故以「对文件指纹
//      拼接体的整体哈希」做树根等价物：任一文件改动 → 该文件 per-file 指纹变 →
//      清单变 → 树根变，篡改即被拦截。
//   ② 验签：verify_signature(root_fp, pubkey, sig) 用 std/ed25519 验签（签名的
//      消息 = root_fp 字符串字节）。错误 pubkey → 验签失败（冒名拦截）。
//   ③ 锚定：anchor/check_anchor 维护 TOFU 信任锚文件 .tie.lock
//      （文本 `pubkey_fp:<fp>\n`，存当前运行目录）。首次写入固化；同 id 异 fp → -1。
//   audit(root_fp, pubkey, sig, anchor_fp 可选) 走 ②→③ 两环。
//   ④⑤⑥⑦⑧（IR 版本 / id-version 合法 / 字段白名单 / 依赖解析 / 注册冲突仲裁）
//   分别交给 p.7.1.2 已交付的 keel_registry 仲裁与后续里程碑。
//
// # 语言边界
//   - import 路径相对本文件（compiler/keel/）：std 在 ../../std/。
//   - 命名空间内互调裸调用；对 std 用命名空间前缀 tsha./ed25519.（不 using）。
//   - 全局变量加 keelaud_ 前缀防 import 内联后的顶层重名。
//   - 目录枚举用内置 list_dir（返回文件名表，不含路径前缀）；文件字节用 byte_read。

import "../../std/tsha1.tie"
import "../../std/ed25519.tie"

var keelaud_err: string = "";    // 最近一次失败信息（成功时为空串）

namespace keelaud {

// ---------- 内部工具 ----------

// 字节表（byte_read，i64 元素 0..255）→ 二进制安全字符串（指纹哈希输入）。
func bytes_to_str(t: table<i64>) -> string {
    var sb = string_builder()
    var i: i64 = 0
    while i < len(t) {
        sb_append_byte(sb, t[i])
        i = i + 1
    }
    return sb_build(sb)
}

// 十六进制编码：字符串每个字节 → 2 位小写 hex（验签消息 = root_fp 字节的 hex）。
func str_to_hex(s: string) -> string {
    var hex = "0123456789abcdef"
    var out: string = ""
    var i: i64 = 0
    var n: i64 = len(s)
    while i < n {
        var b = str_byte(s, i)
        out = out + str_char(hex, (b >> 4) & 0xF) + str_char(hex, b & 0xF)
        i = i + 1
    }
    return out
}

// 后缀判断（手动实现，避免引入 std/string 依赖）。
func ends_with(s: string, suf: string) -> bool {
    var n = len(s)
    var m = len(suf)
    if m > n {
        return false
    }
    var i: i64 = 0
    while i < m {
        if str_char(s, n - m + i) != str_char(suf, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// 文件名表升序排序（原地冒泡；< 即 strcmp 码点序）。返回值便于链式。
func sort_names(t: table<string>) -> table<string> {
    var n = len(t)
    var changed: bool = true
    while changed {
        changed = false
        var i: i64 = 0
        while i < n - 1 {
            if t[i] > t[i + 1] {
                var tmp = t[i]
                t[i] = t[i + 1]
                t[i + 1] = tmp
                changed = true
            }
            i = i + 1
        }
    }
    return t
}

// 单文件指纹：读文件字节 → tsha1f（f 档，n=48，48 进制）。文件缺失/读败返回空串。
func file_fingerprint(path: string) -> string {
    if !file_exists(path) {
        return ""
    }
    var t = byte_read(path)
    return tsha.tsha1f(bytes_to_str(t), 48)
}

// ---------- 公开 API ----------

// ① 指纹树：扫目录下全部 *.tie（名字升序），per-file tsha1f，再对拼接清单
//    整体 tsha1x（加强模型）作包树根。产出树根指纹字符串（n=48，48 进制）。
//    目录不存在 / 无 *.tie → 返回空串（err_msg 携带）。
pub func fingerprint_tree(dir: string) -> string {
    keelaud_err = ""
    var names = sort_names(list_dir(dir))
    var manifest: string = ""
    var count: i64 = 0
    var i: i64 = 0
    while i < len(names) {
        var name = names[i]
        if ends_with(name, ".tie") {
            var fp = file_fingerprint(dir + "/" + name)
            if str_len(fp) == 0 {
                keelaud_err = "keelaud fingerprint_tree 指纹计算失败: " + name
                return ""
            }
            manifest = manifest + name + ":" + fp + "\n"
            count = count + 1
        }
        i = i + 1
    }
    if count == 0 {
        keelaud_err = "keelaud fingerprint_tree 目录无 .tie 文件: " + dir
        return ""
    }
    var root = tsha.tsha1x(manifest, 48)
    if str_len(root) == 0 {
        keelaud_err = "keelaud fingerprint_tree 树根计算失败"
        return ""
    }
    return root
}

// ① 树根比对：0 一致 / -1 篡改（任一文件改动 → per-file 指纹变 → 树根变 → 拒绝）。
pub func verify_tree(root_fp: string, actual_fp: string) -> i64 {
    keelaud_err = ""
    if root_fp == actual_fp {
        return 0
    }
    keelaud_err = "keelaud verify_tree 树根不一致（篡改拦截）"
    return -1
}

// ② 验签：用 std/ed25519 校验 sig 是否由与 pubkey 对应的私钥对 root_fp 字节签名。
//    签名内容约定：sig = ed25519_sign(root_fp 字节)。有效 0 / 无效 -1（冒名拦截）。
pub func verify_signature(root_fp: string, pubkey: string, sig: string) -> i64 {
    keelaud_err = ""
    var msg_hex = str_to_hex(root_fp)
    var ok = ed25519.verify(pubkey, msg_hex, sig)
    if ok == 1 {
        return 0
    }
    keelaud_err = "keelaud verify_signature 验签失败（冒名/被篡改凭证拦截）"
    return -1
}

// 锚文件路径：当前运行目录的 .tie.lock（TOFU 信任锚）。
func anchor_path() -> string {
    return ".tie.lock"
}

// ③ TOFU 信任锚：首次写入 tie.lock（`pubkey_fp:<fp>\n`）固化指纹。成功 0 / 写败 -1。
pub func anchor(fp: string) -> i64 {
    keelaud_err = ""
    if !file_write(anchor_path(), "pubkey_fp:" + fp + "\n") {
        keelaud_err = "keelaud anchor 写信任锚失败: " + anchor_path()
        return -1
    }
    return 0
}

// ③ 锚定比对：已锚定且 fp 一致 0 / 不一致 -1（换钥负例拦截）/ 未锚定 1（首次待确认）。
pub func check_anchor(fp: string) -> i64 {
    keelaud_err = ""
    var p = anchor_path()
    if !file_exists(p) {
        return 1
    }
    var m = file_read(p)
    if str_len(m) == 0 {
        keelaud_err = "keelaud check_anchor 信任锚为空: " + p
        return 0
    }
    var want: string = ""
    var n: i64 = str_len(m)
    var i: i64 = 0
    var seen: bool = false
    while i < n {
        var c = str_char(m, i)
        if c == ":" {
            seen = true
        } else if seen {
            if c == "\n" || c == "\r" {
                break
            }
            want = want + c
        }
        i = i + 1
    }
    if want == fp {
        return 0
    }
    keelaud_err = "keelaud check_anchor 信任锚指纹不一致（换钥拦截）"
    return -1
}

// 组装审计链核心：② 验签 → ③ 锚定（① 树根由调用方先算；④-⑧ 留给注册仲裁与后续）。
//   返回 0 通过；-1 拦截；1 首次待确认（未提供锚或未锚定）。
pub func audit(root_fp: string, pubkey: string, sig: string, anchor_fp: string) -> i64 {
    var vs = verify_signature(root_fp, pubkey, sig)
    if vs != 0 {
        return vs
    }
    if str_len(anchor_fp) == 0 {
        keelaud_err = "keelaud audit 未提供信任锚（首次待确认）"
        return 1
    }
    var ca = check_anchor(anchor_fp)
    if ca == 0 {
        return 0
    }
    if ca == -1 {
        return -1
    }
    keelaud_err = "keelaud audit 信任锚未固化（首次待确认）"
    return 1
}

// 最近一次失败信息（成功时为空串）。
pub func err_msg() -> string {
    return keelaud_err
}

}   // namespace keelaud