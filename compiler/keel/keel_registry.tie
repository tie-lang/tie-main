type tie<class>
// compiler/keel/keel_registry.tie —— Keel 龙骨架构 核心微内核化第一步（p.7.1.1 骨架层）
// ============================================================
// 里程碑：2026.2 路线图 p.7.1.1「Keel 龙骨架构核心微内核化第一步」骨架层。
// 目标（docs/superpowers/specs/2026-08-29-plugin-kernel-design.md +
// docs/designs/keel-architecture.md）：核心只余机制层——boot 引导加载器 /
// registry 通用注册表 / auditor 安全审计器 / executor 管线执行骨架，
// 一切行为皆为注册项。本模块 = 通用注册表（registry）。
//
// # 注册项 schema（每行 = 一个注册项；行号 = 注册顺序 = id）
// 里程碑补充：p.7.1.2「id+version：schema 表驱动 + 同 id 异 version 仲裁」。
//   新增注册项列 version（semver 字符串）+ 优先级 prio（来源：内建 0 < config
//   1 < 项目 2 < 依赖包 3，默认 0）。同 id 同 version 幂等忽略；同 id 异
//   version 走 arbitrate 按优先级仲裁，同优先级多版本 = 冲突负例。
//
//   id         string  全局唯一键（如 "tiec::pass_front"）
//   kind       string  类别：pass | pipeline | builtin | role | cli | lib
//                       （本任务先用 pass / pipeline）
//   version    string  semver 包版本（"1.2.3"；register 4 参走默认 "1.0.0"）
//   prio       i64     来源优先级（默认 0=内建；越大越优先）
//   impl       string  实现函数名（impl_name，C1 分派键；无实现/pipeline 为 ""）
//   deps       table<i64>  依赖注册项 id（只读拷贝进扁平段）
//   嵌套段布局与 ir.tie 操作数段同款：行存 off/cnt，内容进扁平段。
// **对 pipeline 注册项**，deps 扁平段复用为「有序 pass 引用列表」（执行序列）。
//
// # 名字查找映射（升序表 + 二分，O(log n)）
//   keelreg_lookup_keys（名字升序）+ keelreg_lookup_vals（并行注册项 id）。
//   **id 稳定不变量**：id = 注册顺序（0 起），注册完成后永不改变。
//   后续注册只追加，不移动既有行（与 lib/dispatch.tie 序号语义一致）。
//
// # C1 分派说明
//   tie 无函数指针，impl_name 参照 compiler/lib/dispatch.tie 模式：
//   存「实现函数名字符串」，执行时按名分派（升序字符串表 + 二分 +
//   整数 switch，见 keel_executor.tie 的 dispatch_impl）。
//
// # 语言边界（实测同 pass_registry.tie，关键约束）
//   - 本模块**零依赖**（不 import 任何库），字符串键二分/有序插入自持
//     实现（同 lib/dispatch.tie d_keys/d_vals 模式）；
//   - 全局标量初始化只能用字面量；表格用 table_new_i64()/table_new_string()
//     惰性初始化（首次 register 时建表，同 dispatch.tie 模式）；
//   - table<i64> 可作函数参数（只读拷贝进扁平段），table<string> 不行；
//   - import 文本内联不查重：与 pass_registry 一致，本模块不 import 任何
//     文件；keel_boot.tie / keel_executor.tie 也不 import 本文件（依赖经
//     入口文件 import 链内联可达，避免重复定义，同 compiler 内部约定）。
//   - 顶层常量/全局变量加 keelreg_ 前缀：import 内联后顶层同作用域，
//     防跨文件重名。
//
// 命名规范：命名空间内函数不加 keelreg_ 前缀；内部工具私有（非 pub）。

// ---------- 全局并行表（行号 = id = 注册顺序；显式分号）----------
var keelreg_ids: table<string>;    // 注册项 id（按注册序，id 行）
var keelreg_kind: table<string>;   // 类别（"pass" / "pipeline" / ...）
var keelreg_impl: table<string>;   // 实现函数名（impl_name；无实现为 ""）
var keelreg_deps_off: table<i64>;  // 依赖段偏移（deps 扁平段内）
var keelreg_deps_cnt: table<i64>;  // 依赖个数（0 = 无依赖 / 空 pipeline）
var keelreg_deps_flat: table<i64>; // 依赖扁平段（全部注册项共享，追加式）
var keelreg_ver: table<string>;    // 注册项 semver 主版本（并行 ids；首登版本）
var keelreg_prio: table<i64>;      // 注册项优先级（并行 ids；默认 0=内建）
var keelreg_conflict_flag: i64 = 0; // 仲裁冲突标志（0 干净 / 1 冲突）
var keelreg_pending_prio: i64 = 0; // 下一次 register_v 携带的优先级（set_priority 设）
// 多版本候选扁平段（记录同 id 出现过的每个 distinct 版本 + 其优先级）
var keelreg_cand_off: table<i64>;  // 候选段偏移（cand_ver 扁平段内）
var keelreg_cand_cnt: table<i64>;  // 该 id 出现过的 distinct 版本数
var keelreg_cand_ver: table<string>; // 候选版本扁平段（共享追加式）
var keelreg_cand_prio: table<i64>; // 候选优先级扁平段（并行 cand_ver）
// 名字查找映射（升序 + 二分；与行表并列的独立结构）
var keelreg_lookup_keys: table<string>;  // id 名字（升序，strcmp 码点序）
var keelreg_lookup_vals: table<i64>;     // 并行注册项 id

namespace keelreg {

// ---------- 表格惰性建表（首次 register 时一次性初始化全部表）----------
func ensure_tables() {
    if len(keelreg_ids) == 0 {
        keelreg_ids = table_new_string()
        keelreg_kind = table_new_string()
        keelreg_impl = table_new_string()
        keelreg_deps_off = table_new_i64()
        keelreg_deps_cnt = table_new_i64()
        keelreg_deps_flat = table_new_i64()
        keelreg_ver = table_new_string()
        keelreg_prio = table_new_i64()
        keelreg_cand_off = table_new_i64()
        keelreg_cand_cnt = table_new_i64()
        keelreg_cand_ver = table_new_string()
        keelreg_cand_prio = table_new_i64()
        keelreg_lookup_keys = table_new_string()
        keelreg_lookup_vals = table_new_i64()
    }
}

// ---------- 名字键二分（自持，同 lib/dispatch.tie bs_find 模式）----------
// keelreg_lookup_keys 恒升序（register 有序插入维护），字符串比较用
// < / > / == 运算符（IR 走 strcmp，按码点序）。

func bs_find_id(nm: string) -> i64 {
    var lo: i64 = 0
    var hi: i64 = len(keelreg_lookup_keys) - 1
    while lo <= hi {
        var mid = (lo + hi) / 2
        if keelreg_lookup_keys[mid] == nm {
            return mid
        }
        if keelreg_lookup_keys[mid] < nm {
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    return -1
}

// 映射表有序插入（尾部追加 + 向前冒泡，两表同步交换；同
// lib/dispatch.tie register 的插入流程）。

func map_insert(nm: string, id: i64) {
    table_push(keelreg_lookup_keys, nm)
    table_push(keelreg_lookup_vals, id)
    var i: i64 = len(keelreg_lookup_keys) - 1
    var moving: bool = true
    while moving {
        if i == 0 {
            moving = false
        } else if keelreg_lookup_keys[i] < keelreg_lookup_keys[i - 1] {
            var tmpk = keelreg_lookup_keys[i]
            keelreg_lookup_keys[i] = keelreg_lookup_keys[i - 1]
            keelreg_lookup_keys[i - 1] = tmpk
            var tmpv: i64 = keelreg_lookup_vals[i]
            keelreg_lookup_vals[i] = keelreg_lookup_vals[i - 1]
            keelreg_lookup_vals[i - 1] = tmpv
            i = i - 1
        } else {
            moving = false
        }
    }
}

// ---------- 注册 ----------

// 登记一个注册项（向后兼容 4 参入口）：等价 register_v(id, kind, impl_name,
// deps, "1.0.0")——无显式 version 的注册项默认取 semver "1.0.0"。
pub func register(id: string, kind: string, impl_name: string, deps: table<i64>) -> i64 {
    return register_v(id, kind, impl_name, deps, "1.0.0")
}

// 登记一个注册项（带版本）：id 全局唯一键、kind 类别、impl_name 实现函数名
// （无实现传 ""，如 pipeline）、deps 依赖注册项 id（只读拷贝进扁平段；对
// pipeline 为「有序 pass 引用列表」）、version semver 字符串。返回注册项 id
// （= 注册顺序，**恒稳定**）。语义：
//   - 新 id：建主行，version/prio 记录为首登值，登记为 1 个候选；
//   - 已登记同 id 同 version：幂等忽略（返回原 id，不重复登记）；
//   - 已登记同 id 异 version：追加为一个新候选（带当前 set_priority 设置的
//     优先级），主行不改（id 稳定）。多版本仲裁走 arbitrate。
pub func register_v(id: string, kind: string, impl_name: string, deps: table<i64>, version: string) -> i64 {
    ensure_tables()
    var idx = bs_find_id(id)
    if idx >= 0 {
        var rid = keelreg_lookup_vals[idx]
        // 同 id 同 version 幂等忽略；异 version 追加候选
        var off = keelreg_cand_off[rid]
        var cnt = keelreg_cand_cnt[rid]
        var j: i64 = 0
        var found: bool = false
        while j < cnt && !found {
            if keelreg_cand_ver[off + j] == version {
                found = true
            }
            j = j + 1
        }
        if !found {
            table_push(keelreg_cand_ver, version)
            table_push(keelreg_cand_prio, keelreg_pending_prio)
            keelreg_cand_cnt[rid] = keelreg_cand_cnt[rid] + 1
        }
        return rid
    }
    var rid = len(keelreg_ids)
    // 行表尾部追加（id = 行号，无需位移——既有行永不移动）
    table_push(keelreg_ids, id)
    table_push(keelreg_kind, kind)
    table_push(keelreg_impl, impl_name)
    table_push(keelreg_deps_off, len(keelreg_deps_flat))
    table_push(keelreg_deps_cnt, len(deps))
    table_push(keelreg_ver, version)
    table_push(keelreg_prio, keelreg_pending_prio)
    table_push(keelreg_cand_off, len(keelreg_cand_ver))
    table_push(keelreg_cand_cnt, 1)
    table_push(keelreg_cand_ver, version)
    table_push(keelreg_cand_prio, keelreg_pending_prio)
    // 依赖内容追加进扁平段
    var i: i64 = 0
    while i < len(deps) {
        table_push(keelreg_deps_flat, deps[i])
        i = i + 1
    }
    // 名字 → id 映射（升序维护）
    map_insert(id, rid)
    return rid
}

// 设置「下一次 register_v 携带的优先级」（默认 0=内建）。注册项来源优先级：
// 内建 0 < config 1 < 项目 2 < 依赖包 3，数值越大越优先。id 参数为语义标注
// （目标注册项）；探针/驱动在注册带来源优先级的版本前调用本函数。
pub func set_priority(id: string, prio: i64) {
    keelreg_pending_prio = prio
}

// 返回 id 出现过的不同版本数：0=未登记 / 1=单版本 / >1=多版本冲突。
pub func find_conflict(id: string) -> i64 {
    var idx = bs_find_id(id)
    if idx < 0 {
        return 0
    }
    var rid = keelreg_lookup_vals[idx]
    return keelreg_cand_cnt[rid]
}

// 同 id 异 version 仲裁：按优先级（内建 0 < config 1 < 项目 2 < 依赖包 3，
// 数值大者胜）选出唯一胜出版本，返回其在候选段中的槽位（供 cand_ver 读出
// 胜出版本串）。同优先级多版本 = 冲突负例（返回 -1 且置 conflict_flag=1）；
// 单候选/唯一胜者清 conflict_flag 并返回其槽位。
pub func arbitrate(id: string) -> i64 {
    var idx = bs_find_id(id)
    if idx < 0 {
        keelreg_conflict_flag = 1
        return -1
    }
    var rid = keelreg_lookup_vals[idx]
    var off = keelreg_cand_off[rid]
    var cnt = keelreg_cand_cnt[rid]
    // 找最高优先级
    var maxprio: i64 = -1
    var i: i64 = 0
    while i < cnt {
        if keelreg_cand_prio[off + i] > maxprio {
            maxprio = keelreg_cand_prio[off + i]
        }
        i = i + 1
    }
    // 统计持最高优先级的不同版本数
    var winners: i64 = 0
    var win_idx: i64 = 0
    i = 0
    while i < cnt {
        if keelreg_cand_prio[off + i] == maxprio {
            winners = winners + 1
            win_idx = i
        }
        i = i + 1
    }
    if winners > 1 {
        keelreg_conflict_flag = 1
        return -1
    }
    keelreg_conflict_flag = 0
    return win_idx
}

// 仲裁冲突标志读出（0 干净 / 1 冲突）。
pub func conflict_flag() -> i64 {
    return keelreg_conflict_flag
}

// 清仲裁冲突标志（探针/驱动在负例断言后 / 新一轮仲裁前复位）。
pub func clear_conflict() {
    keelreg_conflict_flag = 0
}

// ---------- semver 校验 ----------

// 单字符串是否为 ASCII 数字字符 '0'..'9'（用 < > 表达，与 bs_find 的
// strcmp 码点序一致；避免依赖 >= <= 于字符串）。
func is_digit_char(c: string) -> bool {
    if c < "0" {
        return false
    }
    if c > "9" {
        return false
    }
    return true
}

// semver 合法性：格式 X.Y.Z，三节均非空纯数字（X/Y/Z 非负整数，收尾点 0
// 即 Z=0 合法，纯数字非负自动满足）。空串、节数非 3、含非数字或空节均 false。
pub func check_version(ver: string) -> bool {
    var n = str_len(ver)
    if n == 0 {
        return false
    }
    var comps: i64 = 1
    var seg_digits: i64 = 0
    var i: i64 = 0
    while i < n {
        var c = str_char(ver, i)
        if c == "." {
            if seg_digits == 0 {
                return false
            }
            seg_digits = 0
            comps = comps + 1
            if comps > 3 {
                return false
            }
        } else if is_digit_char(c) {
            seg_digits = seg_digits + 1
        } else {
            return false
        }
        i = i + 1
    }
    if seg_digits == 0 {
        return false
    }
    return comps == 3
}

// 访问器：注册项 id -> 主版本（首登版本；越界 / 多版本仲裁前返回首登串）。
pub func version_of(rid: i64) -> string {
    if rid < 0 || rid >= len(keelreg_ver) {
        return ""
    }
    return keelreg_ver[rid]
}

// 访问器：注册项 id -> 候选段第 k 个版本串（arbitrate 返回的槽位经此读出
// 胜出版本；越界返回空串）。
pub func cand_ver(rid: i64, k: i64) -> string {
    if rid < 0 || rid >= len(keelreg_cand_cnt) {
        return ""
    }
    var off = keelreg_cand_off[rid]
    if k < 0 || k >= keelreg_cand_cnt[rid] {
        return ""
    }
    return keelreg_cand_ver[off + k]
}

// 按 id 名字查注册项 id（二分 O(log n)）；未登记返回 -1。
pub func find(id: string) -> i64 {
    var idx = bs_find_id(id)
    if idx < 0 {
        return -1
    }
    return keelreg_lookup_vals[idx]
}

// 已登记注册项总数。
pub func count() -> i64 {
    return len(keelreg_ids)
}

// 访问器：注册项 id -> 类别（"pass"/"pipeline"/...；越界返回空串）。
pub func kind_of(rid: i64) -> string {
    if rid < 0 || rid >= len(keelreg_kind) {
        return ""
    }
    return keelreg_kind[rid]
}

// 访问器：注册项 id -> 实现函数名 impl_name（越界返回空串；无实现亦空串）。
pub func impl_name_of(rid: i64) -> string {
    if rid < 0 || rid >= len(keelreg_impl) {
        return ""
    }
    return keelreg_impl[rid]
}

// 访问器：注册项 id -> 依赖（或 pipeline 有序 pass 引用）个数。
pub func deps_count(rid: i64) -> i64 {
    if rid < 0 || rid >= len(keelreg_deps_cnt) {
        return 0
    }
    return keelreg_deps_cnt[rid]
}

// 访问器：注册项 id -> 第 k 个依赖/pass 引用 id（越界 -1）。
pub func deps_at(rid: i64, k: i64) -> i64 {
    if rid < 0 || rid >= len(keelreg_deps_off) {
        return -1
    }
    var off = keelreg_deps_off[rid]
    var cnt = keelreg_deps_cnt[rid]
    if k < 0 || k >= cnt {
        return -1
    }
    return keelreg_deps_flat[off + k]
}

}   // namespace keelreg