type tie<class>
// compiler/keel/keel_boot.tie —— Keel 龙骨架构 内建引导集（p.7.1.1 骨架层）
// ============================================================
// 里程碑：2026.2 路线图 p.7.1.1「Keel 龙骨架构核心微内核化第一步」骨架层。
// 目标：核心只余机制层，一切行为皆为注册项。本模块 = 内建引导集（boot）：
// 把编译主流水线的默认形态登记为注册项（pipeline:default），并把 5 槽
// 前端的 front/中端 irgen/旁路 tieir/后端 emit/link 登记为 pass 注册项。
//
// # 引导内容
//   boot() 注册两类注册项（进 keelreg 通用注册表）：
//   1) 5 个 pass 注册项：
//        id          "tiec::pass_front" / pass_irgen / pass_tieir / pass_emit / pass_link
//        kind        "pass"
//        impl_name   keelboot.pass_* （占位实现函数名，C1 分派键）
//        deps        指向被依赖的 pass id（依赖顺序 front<irgen<tieir<emit<link）
//   2) 1 个 pipeline 注册项：
//        id          "tiec::pipeline_default"
//        kind        "pipeline"
//        impl_name   ""（pipeline 无实现，只承载有序 pass 引用列表）
//        deps        有序 pass 引用：front → irgen → tieir → emit → link
//
//   pipeline:default = pipeline 5 槽（compiler/pipeline.tie 的
//   g_pass_front/irgen/tieir/emit/link）在注册表世界的登记形态。
//
// # 占位实现
//   本任务只搭骨架，真正的 driver 实现由后续步骤接线（不接 driver）。
//   故 boot 内放 5 个 noop 占位函数（return 0），impl_name 指向它们，
//   keelexec 按名分派到它们（管线全绿返回 0）。
//
// # 语言边界（同 keel_registry.tie）
//   - import 文本内联不查重：本文件**不 import** keel_registry.tie（依赖经
//     入口文件 import 链内联可达，避免重复定义，同 compiler 内部约定）；
//     使用 keelreg.* 需先在入口 import keel_registry.tie。
//   - table<i64> 只读拷贝进注册表扁平段；临时依赖表用 table_new_i64() 建。
//   - 顶层常量/全局变量加 keelboot_ 前缀防 import 内联后的顶层重名。
//
// 命名规范：命名空间内函数不加 keelboot_ 前缀；内部工具私有（非 pub）。

namespace keelboot {

// ---------- 占位实现（p.7.1.1 骨架：真正的 driver 实现后续接线）----------
// 5 槽按 compiler/pipeline.tie 的 pass 签名统一 fn() -> i64：0 成功。

// 前端占位：词法 + 语法 + 语义（含 import）。
pub func pass_front() -> i64 {
    return 0
}

// 中端占位：AST → tie-IR（gen_ast）。
pub func pass_irgen() -> i64 {
    return 0
}

// 中端旁路占位：tieir 序列化（--tieir-out）。
pub func pass_tieir() -> i64 {
    return 0
}

// 后端占位：tie-IR → .ll 文本（llvmgen.emit + 写盘）。
pub func pass_emit() -> i64 {
    return 0
}

// 后端占位：opt/clang/lld-link 工具链。
pub func pass_link() -> i64 {
    return 0
}

// ---------- 内建引导 ----------

// 登记默认管线（pipeline:default = 有序 pass 引用列表）与 5 个 pass
// 注册项。幂等（重复调用不重复登记）。返回 pipeline:default 注册项 id。
pub func boot() -> i64 {
    // 5 槽 pass（依赖顺序 front<irgen<tieir<emit<link，deps 指向被依赖者）
    var front_deps: table<i64> = table_new_i64()
    var front_id = keelreg.register("tiec::pass_front", "pass", "keelboot_pass_front", front_deps)

    var irgen_deps: table<i64> = table_new_i64()
    table_push(irgen_deps, front_id)
    var irgen_id = keelreg.register("tiec::pass_irgen", "pass", "keelboot_pass_irgen", irgen_deps)

    var tieir_deps: table<i64> = table_new_i64()
    table_push(tieir_deps, irgen_id)
    var tieir_id = keelreg.register("tiec::pass_tieir", "pass", "keelboot_pass_tieir", tieir_deps)

    var emit_deps: table<i64> = table_new_i64()
    table_push(emit_deps, tieir_id)
    var emit_id = keelreg.register("tiec::pass_emit", "pass", "keelboot_pass_emit", emit_deps)

    var link_deps: table<i64> = table_new_i64()
    table_push(link_deps, emit_id)
    var link_id = keelreg.register("tiec::pass_link", "pass", "keelboot_pass_link", link_deps)

    // pipeline:default = 有序 pass 引用列表（执行序列 front→irgen→tieir→emit→link）；
    // kind="pipeline"，impl_name=""（无实现，只承载引用列表）
    var pipe_deps: table<i64> = table_new_i64()
    table_push(pipe_deps, front_id)
    table_push(pipe_deps, irgen_id)
    table_push(pipe_deps, tieir_id)
    table_push(pipe_deps, emit_id)
    table_push(pipe_deps, link_id)
    return keelreg.register("tiec::pipeline_default", "pipeline", "", pipe_deps)
}

}   // namespace keelboot