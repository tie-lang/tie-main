type tie<class>
// compiler/keel/keel_cli.tie —— Keel CLI 子命令注册项 schema 与查表（p.7.1.6）
// ============================================================
// 里程碑：2026.2 路线图 p.7.1.6「CLI 子命令注册化 + 库树收敛」。
// 目标（docs/superpowers/specs/2026-08-29-plugin-kernel-design.md §3）：
// 每条 `tie <子命令>`（pack/verify/...）也是注册项（cli:xxx），核心只保留最小
// 命令分派骨架；未注册命令报"未知命令"。本模块 = CLI 注册表（keel_cli）。
//
// # 职责边界（重要）
//   - keel_cli **只**提供命令的登记 / 查表 / 描述（register / has / count /
//     desc_of）。它**不实现** handle 的 switch 分派——tie 无函数指针、且
//     executor（及任何通用骨架）不能引用 driver 的实际处理函数（p.7.1.1
//     实证 E00413），因此分派执行留在 driver 侧（compiler/driver.tie 的
//     keelcli_handle），keel_cli 仅承载注册数据的 schema 与查表。
//   - 命令注册 id 形如 "cli:pack"（设计稿 §3 命名）。driver 侧按名查表并
//     switch 到实际处理函数。
//
// # 语言边界（同 keel_registry.tie / dispatch.tie）
//   - 本模块**零依赖**（不 import 任何文件），字符串键升序二分/有序插入自持；
//   - 全局标量初始化只用字面量；表格用 table_new_i64()/table_new_string() 惰性
//     初始化（首次 register 时建表）；
//   - 顶层常量/全局变量加 kj_ 前缀：import 内联后顶层同作用域，防跨文件重名。
//
// 命名规范：命名空间内函数不加 kj_ 前缀；内部工具私有（非 pub）。

// ---------- 全局并行表（命令 id 升序 + 并行描述） ----------
var kj_cmds: table<string>;     // 命令 id（升序；"cli:pack" 等）
var kj_descs: table<string>;    // 并行描述文本
var kj_init_done: i64 = 0;      // 惰性建表标志

namespace keelcli {

// 惰性建表（首次 register/has/count/desc_of 时初始化）。
func ensure() {
    if kj_init_done == 0 {
        kj_cmds = table_new_string()
        kj_descs = table_new_string()
        kj_init_done = 1
    }
}

// 命令表升序二分定位（O(log n)）；未命中 -1。
// 与 keelreg / dispatch.tie 同款：字符串用 < / > / ==（IR strcmp 码点序）。
func bs_find(nm: string) -> i64 {
    var lo: i64 = 0
    var hi: i64 = len(kj_cmds) - 1
    while lo <= hi {
        var mid = (lo + hi) / 2
        if kj_cmds[mid] == nm {
            return mid
        }
        if kj_cmds[mid] < nm {
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    return -1
}

// 登记一条 CLI 子命令：cmd 形如 "cli:pack"，desc 为其描述。升序有序插入、
// 幂等（已登记则忽略，不重复登记）。返回 1 新登记 / 0 已存在。
pub func register(cmd: string, desc: string) -> i64 {
    ensure()
    if bs_find(cmd) >= 0 {
        return 0
    }
    table_push(kj_cmds, cmd)
    table_push(kj_descs, desc)
    // 尾部追加 + 向前冒泡保持升序（两表同步交换）
    var i: i64 = len(kj_cmds) - 1
    var moving: bool = true
    while moving {
        if i == 0 {
            moving = false
        } else if kj_cmds[i] < kj_cmds[i - 1] {
            var tk = kj_cmds[i]
            kj_cmds[i] = kj_cmds[i - 1]
            kj_cmds[i - 1] = tk
            var td = kj_descs[i]
            kj_descs[i] = kj_descs[i - 1]
            kj_descs[i - 1] = td
            i = i - 1
        } else {
            moving = false
        }
    }
    return 1
}

// 命令是否已登记（返回 0/1）。
pub func has(cmd: string) -> i64 {
    ensure()
    if bs_find(cmd) >= 0 {
        return 1
    }
    return 0
}

// 已登记 CLI 子命令总数。
pub func count() -> i64 {
    ensure()
    return len(kj_cmds)
}

// 命令描述（未登记返回空串）。
pub func desc_of(cmd: string) -> string {
    ensure()
    var idx = bs_find(cmd)
    if idx < 0 {
        return ""
    }
    return kj_descs[idx]
}

}   // namespace keelcli