type tie<class>
// compiler/keel/keel_executor.tie —— Keel 龙骨架构 管线执行骨架（p.7.1.1）
// ============================================================
// 里程碑：2026.2 路线图 p.7.1.1「Keel 龙骨架构核心微内核化第一步」骨架层。
// 目标：核心只余机制层，一切行为皆为注册项。本模块 = 管线执行骨架
// （executor）：读 pipeline 注册项的「有序 pass 引用列表（扁平段）」，
// 逐个经 C1 分派调用对应 pass 实现，任一失败立即中止返回错误码。
//
// # 执行模型（替代 compiler/pipeline.tie 的 5 个硬编码槽）
//   compiler/pipeline.tie 硬编码 g_pass_front/irgen/tieir/emit/link 五个
//   fn 槽位 + run_pipeline(stop_after)。本骨架把「管线 = 有序 pass 引用」
//   （pipeline:default 的 deps 扁平段）作为唯一执行数据源：任何注册为
//   pipeline 的注册项均可执行，不局限于 5 槽。
//
// # C1 分派（无函数指针，参考 lib/dispatch.tie）
//   pass 注册项的 impl_name 是「实现函数名字符串」；执行时按名分派：
//   把 impl_name 映射到整数选择子，再整数 switch 展开到具体实现
//   （case 覆盖 boot 登记的全部占位实现；unknown 走 default）。
//   default 分支返回 -1 并置内部错误标记 keelexec_errflag。
//
// # 语言边界（同 keel_registry.tie / keel_boot.tie）
//   - 本文件**不 import** keel_registry / keel_boot（依赖经入口文件 import
//     链内联可达，避免重复定义）；使用 keelreg.* / keelboot.pass_* 需在
//     入口先 import 对应文件。
//   - 顶层常量/全局变量加 keelexec_ 前缀防 import 内联后的顶层重名。
//
// 命名规范：命名空间内函数不加 keelexec_ 前缀；内部工具私有（非 pub）。

// ---------- 全局（内部错误标记，置位可经 errflag() 读出）----------
var keelexec_errflag: i64 = 0;   // 内部错误标记（0 干净 / 1 已置位）

namespace keelexec {

// ---------- 内部分派（按 impl_name → 整数选择子 → switch）----------
// 覆盖 boot 登记的 5 个占位实现名；unknown impl_name 置错误标记并返回 -1。
func dispatch_impl(nm: string) -> i64 {
    var sel: i64 = -1
    if nm == "keelboot_pass_front" {
        sel = 0
    } else if nm == "keelboot_pass_irgen" {
        sel = 1
    } else if nm == "keelboot_pass_tieir" {
        sel = 2
    } else if nm == "keelboot_pass_emit" {
        sel = 3
    } else if nm == "keelboot_pass_link" {
        sel = 4
    }
    switch sel {
        case 0:
            return keelboot.pass_front()
        case 1:
            return keelboot.pass_irgen()
        case 2:
            return keelboot.pass_tieir()
        case 3:
            return keelboot.pass_emit()
        case 4:
            return keelboot.pass_link()
        default:
            keelexec_errflag = 1
            return -1
    }
}

// 按注册项 id 执行管线（受限前缀版）：读 pipeline 的「有序 pass 引用列表
// （deps 扁平段）」，至多执行前 max_steps 个 pass，逐个查 pass 的 impl_name
// → 分派执行；任一失败立即中止并返回该 pass 错误码（unknown impl_name 返回
// -1 且置内部错误标记）。max_steps<=0 或 > 实际段数 = 执行全段。全绿返回 0。
// --emit-ir 等「只跑管线前缀」的驱动场景经此入口接入（例如 max_steps=4 只
// 跑 front→irgen→tieir→emit，跳过 opt/link）。
pub func run_pipeline_prefix(pipeline_id: i64, max_steps: i64) -> i64 {
    var n = keelreg.deps_count(pipeline_id)
    if max_steps > 0 && max_steps < n {
        n = max_steps
    }
    var i: i64 = 0
    while i < n {
        var pid = keelreg.deps_at(pipeline_id, i)
        var iname = keelreg.impl_name_of(pid)
        if iname == "" {
            keelexec_errflag = 1
            return -2
        }
        var rc = dispatch_impl(iname)
        if rc != 0 {
            return rc
        }
        i = i + 1
    }
    return 0
}

// 按注册项 id 执行管线全段：等价 run_pipeline_prefix(pipeline_id, 全段)。
// 读 pipeline 的「有序 pass 引用列表（deps 扁平段）」，逐个查 pass 的
// impl_name → 分派执行；任一失败立即中止并返回该 pass 错误码（unknown
// impl_name 返回 -1 且置内部错误标记）。全绿返回 0。
pub func run_pipeline(pipeline_id: i64) -> i64 {
    var n = keelreg.deps_count(pipeline_id)
    return run_pipeline_prefix(pipeline_id, n)
}

// 便捷入口：按 pipeline 注册项 id 名字执行（find → run_pipeline）。
// 未登记返回 -1 且置内部错误标记。
pub func run_pipeline_by_name(name: string) -> i64 {
    var pid = keelreg.find(name)
    if pid < 0 {
        keelexec_errflag = 1
        return -1
    }
    return run_pipeline(pid)
}

// 内部错误标记读出（0 干净 / 1 已置位）。
pub func errflag() -> i64 {
    return keelexec_errflag
}

// 清内部错误标记（探针/驱动在负例断言前复位）。
pub func clear_err() {
    keelexec_errflag = 0
}

}   // namespace keelexec