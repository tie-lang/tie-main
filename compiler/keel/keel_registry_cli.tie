type tie<class>
// compiler/keel/keel_registry_cli.tie —— Keel 龙骨 p.7.2.5：registry 包注册中心客户端最小面
// ============================================================
// 里程碑：2026.2 路线图 p.7.2.5「包注册中心 registry 起步」。
// 目标：为独立发行 / 聚合发行提供存储端骨架的客户端最小面——三操作
//   keelpkg.publish(name, ver, src, desc)  发布包（.zd + .zd.fp 指纹 + 元数据 + 版本索引）
//   keelpkg.info(name)                     查询包元数据（最新版本）
//   keelpkg.versions(name)                 列出版本
// 服务端不做：文件系统目录即最小存储端（注册根默认 "./.tie-registry"，
// set_root 可覆盖）。协议/格式文档：docs/release.md §4.6。
//
// # 包格式（基于 zdpub/keelaud 既有产物）
//   publish 把源 tie:data 文件压缩为 zd v2（复用 zdpub.publish：td -><zd | .zd.fp），
//   登录 registry 目录树：
//     <root>/<pkg>/index.td               版本索引（td 表：版本串数组，升序）
//     <root>/<pkg>/<version>/pkg.zd       发布单元（zd v2）
//     <root>/<pkg>/<version>/pkg.zd.fp    单文件指纹（tsha1f:<值>）
//     <root>/<pkg>/<version>/info.td      元数据（name/version/description/fingerprint）
//   版本索引与元数据本身也是 td（config.parse_data 可直接解析回读）。
//
// # 语言边界（本模块自包含）
//   - **import 文本内联不查重**：本模块直接 import ../zdpub.tie（其链式引入
//     tdzd/config/zdwrite + std/tsha1）。若作为另一入口的组成文件参与编译，
//     入口不得重复 import tdzd/tsha1（同文件二次内联 = 重复定义）。
//   - 全局标量初始化只用字面量；表格惰性建表（首次用时 table_new_*）。
//   - 顶层常量/全局变量加 reg_ 前缀：import 内联后顶层同作用域防重名。
//   - 大函数拆小函数规避 tiec 寄存器分配缺陷；循环内不用 `+` 拼接字符串
//     （string_builder + sb_append_byte + sb_build，与 performance 纪律一致）。

import "../zdpub.tie"

var reg_err: string = "";          // 最近一次操作错误消息（成功为空串）
var reg_root: string = "";         // 注册根（惰性默认 ".tie-registry"）

namespace keelpkg {

// 最近一次操作的错误消息（成功时为空串）。
pub func err_msg() -> string {
    return reg_err
}

// 设置注册根（目录路径）；空串重置为默认。
pub func set_root(path: string) {
    reg_root = path
}

// 当前注册根（未设置返回默认 ".tie-registry"）。
pub func registry_root() -> string {
    if str_len(reg_root) == 0 {
        return ".tie-registry"
    }
    return reg_root
}

// 字节表 → 二进制安全字符串（tsha1f 输入）。
func bytes_to_str(t: table<i64>) -> string {
    var sb = string_builder()
    var i: i64 = 0
    while i < len(t) {
        sb_append_byte(sb, t[i])
        i = i + 1
    }
    return sb_build(sb)
}

// 单文件 tsha1f 指纹（n=48，与 zdpub/keelaud 同款）；缺失返回空串。
func fingerprint_of(path: string) -> string {
    if !file_exists(path) {
        return ""
    }
    return tsha.tsha1f(bytes_to_str(byte_read(path)), 48)
}

// 字符串追加到 builder（tie 无 sb_append(sb, str)，逐字节追加）。
func sb_append_str(sb: i64, s: string) {
    var n = str_len(s)
    var i: i64 = 0
    while i < n {
        sb_append_byte(sb, str_byte(s, i))
        i = i + 1
    }
}

// 包名清洗：只留 [a-z0-9._-]，大写转小写；空果（无合法字符）返回空串。
func sanitize(name: string) -> string {
    var sb = string_builder()
    var n = str_len(name)
    var i: i64 = 0
    while i < n {
        var c = str_char(name, i)
        var b = str_byte(name, i)
        if c >= "a" && c <= "z" {
            sb_append_byte(sb, b)
        } else if c >= "0" && c <= "9" {
            sb_append_byte(sb, b)
        } else if c >= "A" && c <= "Z" {
            sb_append_byte(sb, b + 32)
        } else if c == "-" || c == "_" || c == "." {
            sb_append_byte(sb, b)
        }
        i = i + 1
    }
    return sb_build(sb)
}

// 元数据描述清洗：去换行/引号/反斜杠（td 字面量安全）。
func sanitize_desc(d: string) -> string {
    var sb = string_builder()
    var n = str_len(d)
    var i: i64 = 0
    while i < n {
        var c = str_char(d, i)
        if c != "\n" && c != "\r" && c != "\"" && c != "\\" {
            sb_append_byte(sb, str_byte(d, i))
        }
        i = i + 1
    }
    return sb_build(sb)
}

// 目录/文件存在辅助（文件或目录皆算）。
func exists(path: string) -> bool {
    if file_exists(path) {
        return true
    }
    return file_is_dir(path)
}

// ---------- 版本索引（index.td） ----------

// 读版本索引：未发布 / 无索引返回空表（不设错误）。
func read_index(name: string) -> table<string> {
    var out = table_new_string()
    var p = registry_root() + "\\" + name + "\\index.td"
    if !file_exists(p) {
        return out
    }
    var root = config.parse_data(p)
    if root < 0 {
        return out
    }
    if config.type_of(root) != 5 {
        return out
    }
    var n = config.arr_len(root)
    var i: i64 = 0
    while i < n {
        var vn = config.arr_at(root, i)
        if config.type_of(vn) == 4 {
            table_push(out, config.str_val(vn))
        }
        i = i + 1
    }
    return out
}

// 写版本索引（td 数组字面量，升序保持）。
func write_index(name: string, list: table<string>) -> bool {
    var sb = string_builder()
    sb_append_str(sb, "type tie<data>\n[\n")
    var i: i64 = 0
    while i < len(list) {
        sb_append_byte(sb, 34)   // "
        sb_append_str(sb, list[i])
        sb_append_str(sb, "\",\n")
        i = i + 1
    }
    sb_append_byte(sb, 93)   // ]
    sb_append_byte(sb, 10)   // \n
    var txt = sb_build(sb)
    return file_write(registry_root() + "\\" + name + "\\index.td", txt)
}

// 升序插入版本（不重复；返回是否插入）。
func idx_insert(list: table<string>, ver: string) -> i64 {
    var i: i64 = 0
    while i < len(list) {
        if list[i] == ver {
            return 0
        }
        i = i + 1
    }
    table_push(list, ver)
    // 向前冒泡保持升序
    i = len(list) - 1
    var moving: bool = true
    while moving {
        if i == 0 {
            moving = false
        } else if list[i] < list[i - 1] {
            var t = list[i]
            list[i] = list[i - 1]
            list[i - 1] = t
            i = i - 1
        } else {
            moving = false
        }
    }
    return 1
}

// ---------- 三操作 ----------

// publish：把源 tie:data 文件压缩为 .zd + .zd.fp（zdpub），连同元数据
// info.td 写入 registry 目录树，并更新版本索引 index.td。成功 0；失败 -1
// （err_msg 携带原因）。
pub func publish(name: string, ver: string, src: string, desc: string) -> i64 {
    reg_err = ""
    var nm = sanitize(name)
    if str_len(nm) == 0 {
        reg_err = "registry publish: 包名非法（需含字母/数字）"
        return -1
    }
    if str_len(ver) == 0 || str_len(src) == 0 {
        reg_err = "registry publish: 版本与源文件不能为空"
        return -1
    }
    if !file_exists(src) {
        reg_err = "registry publish: 源文件不存在: " + src
        return -1
    }
    var d = sanitize_desc(desc)
    // 建目录 <root>/<name>/<ver>/
    var pkg_dir = registry_root() + "\\" + nm + "\\" + ver
    var _r = mkdir_all(pkg_dir)
    var zd = pkg_dir + "\\pkg.zd"
    var rc = zdpub.publish(src, zd)
    if rc != 0 {
        reg_err = "registry publish: " + zdpub.err_msg()
        return -1
    }
    var fp = fingerprint_of(zd)
    if str_len(fp) == 0 {
        reg_err = "registry publish: 指纹计算失败"
        return -1
    }
    // 元数据 info.td
    var sb = string_builder()
    sb_append_str(sb, "type tie<data>\n[\n")
    sb_append_str(sb, "    \"name\": \"" + nm + "\",\n")
    sb_append_str(sb, "    \"version\": \"" + ver + "\",\n")
    if str_len(d) > 0 {
        sb_append_str(sb, "    \"description\": \"" + d + "\",\n")
    }
    sb_append_str(sb, "    \"fingerprint\": \"" + fp + "\",\n")
    sb_append_byte(sb, 93)   // ]
    sb_append_byte(sb, 10)   // \n
    if !file_write(pkg_dir + "\\info.td", sb_build(sb)) {
        reg_err = "registry publish: 写元数据失败"
        return -1
    }
    // 版本索引
    var idx = read_index(nm)
    idx_insert(idx, ver)
    if !write_index(nm, idx) {
        reg_err = "registry publish: 写版本索引失败"
        return -1
    }
    return 0
}

// 打印包元数据（最新版本：索引末元素）。成功 0；未发布/损坏 -1。
pub func info(name: string) -> i64 {
    reg_err = ""
    var nm = sanitize(name)
    if str_len(nm) == 0 {
        reg_err = "registry info: 包名非法"
        return -1
    }
    var idx = read_index(nm)
    if len(idx) == 0 {
        reg_err = "registry info: 包未发布: " + nm
        return -1
    }
    var ver = idx[len(idx) - 1]
    var info_p = registry_root() + "\\" + nm + "\\" + ver + "\\info.td"
    if !file_exists(info_p) {
        reg_err = "registry info: 元数据缺失: " + ver
        return -1
    }
    var root = config.parse_data(info_p)
    if root < 0 {
        reg_err = "registry info: 元数据解析失败"
        return -1
    }
    println("[" + nm + "] version=" + ver)
    var n = config.map_len(root)
    var i: i64 = 0
    while i < n {
        var k = config.map_key(root, i)
        var vn = config.map_val(root, i)
        if config.type_of(vn) == 4 {
            println("  " + k + "=" + config.str_val(vn))
        }
        i = i + 1
    }
    return 0
}

// 列出版本（每行一个，升序）。返回版本数；包未发布返回 -1。
pub func versions(name: string) -> i64 {
    reg_err = ""
    var nm = sanitize(name)
    if str_len(nm) == 0 {
        reg_err = "registry versions: 包名非法"
        return -1
    }
    var idx = read_index(nm)
    if len(idx) == 0 {
        reg_err = "registry versions: 包未发布: " + nm
        return -1
    }
    var i: i64 = 0
    while i < len(idx) {
        println("  " + idx[i])
        i = i + 1
    }
    return len(idx)
}

}   // namespace keelpkg