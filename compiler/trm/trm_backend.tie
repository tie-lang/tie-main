type tie<class>
// compiler/trm/trm_backend.tie —— Backend 接口 + 可替换后端注册（p.7.3.2-d）
// ============================================================
// 里程碑：2026.2 路线图 p.7.3.2-d「ORC JIT 后端（热点逐函数，对标 HotSpot
// tiered）」。
// 定位（trm-final-design §3.1）：前端/后端解耦——interp 与可替换后端经同一
// Backend 接口对引擎调度透明、可热切换；跨平台一致性以 interp 为语义基准。
// 本阶段落地：
//   * **Backend 注册表**：compile(module)→Exe / execute(exe,entry,args)→Value /
//     invoke(exe,fn,args)→Value 三接口以 (名字, 可用性) 登记（C1 分派）；
//   * **InterpBackend** 为默认实现（可用），compile=加载句柄、execute/invoke=
//     interp 运行（语义基准）；
//   * **热点逐函数提升跟踪**：interp 侧每函数调用计数，达阈值触发提升请求
//     （HotSpot tiered 对位）；后端未接入（orc_jit/wasm/aot 本期无连接）→
//     **确定性回退 interp**（结果不变，契约测试同基准——设计 §7.3「无 LLVM
//     环境退纯 interp」/ §7.4 契约矩阵）;
//   * 未接入哨兵：TRM_BE_NA=-66（注册但未接入）；未注册后端 -1。
//   真实 JIT/wasm/AOT 连接为 p.9.x 扩展（本阶段只登记 + 确定性回退）。
//
// # 语言边界
//   无递归/continue/break；&& 非短路；顶层符号 trmb_ 前缀；
//   与 trm 系列模块同 namespace trm 跨文件闭合并集。

// ---------- 后端状态（模块级全局，前缀 trmb_） ----------
var trmb_n: i64 = 0;                 // 后端注册数
var trmb_keys: table<string>;        // 后端名（升序）
var trmb_avail: table<i64>;          // 1=可用 0=未接入
var trmb_hot_fns: table<string>;     // 热点跟踪：函数名
var trmb_hot_cnt: table<i64>;        // 热点跟踪：调用计数
var trmb_hot_n: i64 = 0;             // 被跟踪函数数
var trmb_last: string = "";          // 最近后端记录（调试/诊断）
var trmb_err: string = "";           // 最近错误

const TRM_BE_NA: i64 = -66;          // 未接入哨兵（registered-not-available）
const TRM_BE_UNKNOWN: i64 = -67;     // 未注册后端哨兵
const TRM_BE_HOT_THRESHOLD: i64 = 4; // 热点提升阈值（逐函数调用数）

namespace trm {

func be_set_err(msg: string) {
    trmb_err = msg
}

// 最近错误（空 = 无错误）。
pub func be_err() -> string {
    return trmb_err
}

// ---------- 注册 ----------

// Backend 登记（内部）：名 → 可用性。重复名拒绝。
func be_reg(name: string, avail: i64) -> i64 {
    var i: i64 = 0
    var dup: i64 = 0
    while i < trmb_n {
        if trmb_keys[i] == name {
            dup = 1
        }
        i = i + 1
    }
    if dup == 1 {
        be_set_err("backend 重复登记: " + name)
        return -1
    }
    table_push(trmb_keys, name)
    table_push(trmb_avail, avail)
    trmb_n = trmb_n + 1
    return 0
}

// Backend 接线（幂等）：interp 可用；orc_jit/wasm/aot 登记未接入。
pub func be_boot() -> i64 {
    if len(trmb_keys) > 0 {
        return 0
    }
    trmb_keys = table_new_string()
    trmb_avail = table_new_i64()
    trmb_hot_fns = table_new_string()
    trmb_hot_cnt = table_new_i64()
    var r0 = be_reg("interp", 1)
    var r1 = be_reg("orc_jit", 0)
    var r2 = be_reg("wasm", 0)
    var r3 = be_reg("aot", 0)
    if r0 < 0 || r1 < 0 || r2 < 0 || r3 < 0 {
        return -1
    }
    be_set_err("")
    return 0
}

// 后端注册数 / 第 i 个后端名 / 可用性（1/0）。
pub func be_count() -> i64 {
    return trmb_n
}
pub func be_name(i: i64) -> string {
    if i >= 0 && i < trmb_n {
        return trmb_keys[i]
    }
    return ""
}
pub func be_avail(name: string) -> i64 {
    var i: i64 = 0
    while i < trmb_n {
        if trmb_keys[i] == name {
            return trmb_avail[i]
        }
        i = i + 1
    }
    return -1
}

// ---------- Backend 三接口（C1 分派） ----------

// compile(module)：interp = 接受句柄（模块 id）；可用后端同 interp（解释）；
// 未接入（orc_jit/wasm/aot）→ TRM_BE_NA（注册未接入）；未注册 → UNKNOWN。
pub func be_compile(backend: string, module: i64) -> i64 {
    var av = be_avail(backend)
    if av < 0 {
        be_set_err("backend 未注册: " + backend)
        return TRM_BE_UNKNOWN
    }
    if av == 0 {
        trmb_last = "backend=" + backend + " 未接入（回退 interp）"
        return TRM_BE_NA
    }
    trmb_last = "backend=" + backend + " compile(模块 " + to_string(module) + ")"
    be_set_err("")
    return module
}

// execute(exe, entry, args)：interp 执行入口函数；未接入 → NA。
pub func be_execute(backend: string, exe: i64, entry: string, args: table<i64>) -> i64 {
    var av = be_avail(backend)
    if av < 0 {
        be_set_err("backend 未注册: " + backend)
        return TRM_BE_UNKNOWN
    }
    if av == 0 {
        trmb_last = "backend=" + backend + " 未接入（execute 回退 interp）"
        return TRM_BE_NA
    }
    var rc = run_by_name(entry, args)
    if rc != 0 {
        be_set_err(interp_err())
        return -1
    }
    trmb_last = "backend=" + backend + " execute(" + entry + ")"
    be_set_err("")
    return 0
}

// invoke(exe, fn, args)：动态调用（沙箱/热更/反射用；本期与 execute 同语义）。
pub func be_invoke(backend: string, exe: i64, fn: string, args: table<i64>) -> i64 {
    var av = be_avail(backend)
    if av < 0 {
        be_set_err("backend 未注册: " + backend)
        return TRM_BE_UNKNOWN
    }
    if av == 0 {
        trmb_last = "backend=" + backend + " 未接入（invoke 回退 interp）"
        return TRM_BE_NA
    }
    var rc = run_by_name(fn, args)
    if rc != 0 {
        be_set_err(interp_err())
        return -1
    }
    trmb_last = "backend=" + backend + " invoke(" + fn + ")"
    be_set_err("")
    return 0
}

// ---------- 热点逐函数提升跟踪（HotSpot tiered 对位） ----------

// 热点调用计数（按函数名；未跟踪从 0 起）。返回当前计数。
pub func be_hot_count(fname: string) -> i64 {
    var i: i64 = 0
    while i < trmb_hot_n {
        if trmb_hot_fns[i] == fname {
            return trmb_hot_cnt[i]
        }
        i = i + 1
    }
    return 0
}

// 热点提升请求：登记函数调用 + 达阈值触发提升尝试（orc_jit 未接入 →
// 确定性回退 interp → 返回 0；已接入且切换成功 → 1；未注册后端 → -1）。
// 返回：0=达阈值尝试提升（无连接，回退 interp）/ 1=已提升到 JIT /
// -1=未达阈值（仅计数）。调用方以 be_last() 取诊断记录。
pub func be_hot(fname: string) -> i64 {
    // 计数 +1（无则新登记）
    var i: i64 = 0
    var cur: i64 = 0
    var found: i64 = -1
    while i < trmb_hot_n {
        if trmb_hot_fns[i] == fname {
            found = i
        }
        i = i + 1
    }
    if found < 0 {
        table_push(trmb_hot_fns, fname)
        table_push(trmb_hot_cnt, 1)
        trmb_hot_n = trmb_hot_n + 1
        cur = 1
    } else {
        trmb_hot_cnt[found] = trmb_hot_cnt[found] + 1
        cur = trmb_hot_cnt[found]
    }
    if cur < TRM_BE_HOT_THRESHOLD {
        be_set_err("")
        return -1
    }
    // 达阈值：请求提升到 orc_jit（热点后端）
    var jav = be_avail("orc_jit")
    if jav == 1 {
        trmb_last = "热点提升: " + fname + " → orc_jit（已接入）"
        be_set_err("")
        return 1
    }
    trmb_last = "热点提升请求: " + fname + "，orc_jit 未接入 → 回退 interp（结果不变）"
    be_set_err("")
    return 0
}

// 最近后端诊断记录（提升/回退/执行后端）。
pub func be_last() -> string {
    return trmb_last
}

}   // namespace trm