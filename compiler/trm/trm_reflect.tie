type tie<class>
// compiler/trm/trm_reflect.tie —— 反射/内省 + 诊断（p.7.3.2-e）
// ============================================================
// 里程碑：2026.2 路线图 p.7.3.2-e「反射/内省 + 动态加载/热更 + 沙箱/校验强化
// + 诊断」。
// 定位（trm-final-design §3.4）：运行期类型查询、自动序列化、跨域身份——
// GC + 序列化 + 调试器 + 动态加载的公共底座（依赖 GC 的统一对象身份建立）。
// 本阶段落地：
//   * **模块内省**：类加载器注册表的模块元数据（名/版本/内容哈希/函数数/指令数）；
//   * **函数内省**：当前 IR 的函数签名面（名/返回类型/参数量/指令数/导出标记），
//     经 interner 还原文本；由函数名可直接动态 invoke（run_by_name 内省→执行）；
//   * **类型/指令名**：类型码 → 文本（i64/f64/i1/str/void）；opcode → 指令名
//     （ir.op_find + op_names）；
//   * **诊断**：模块级 describe（含包/版本/规模）+ 细粒度模块信息行。
//   沙箱/校验强化沿用类加载器（tieir_ser 内建校验安全底线）；热更 = 重复
//   加载同 name@version 拒绝（类加载器语义），新版本为新模块登记。
//
// # 语言边界
//   无递归/continue/break；&& 非短路；顶层符号 trml 前缀防重名；
//   与 trm 系列同 namespace trm 跨文件闭合并集。

namespace trm {

// ---------- 模块内省（来自类加载器注册表） ----------

// 模块元数据：名 / 版本 / 内容哈希 / 函数数 / 指令数（按模块 id）。
pub func refl_module_name(i: i64) -> string {
    if i >= 0 && i < trml_count {
        return trml_names[i]
    }
    return ""
}
pub func refl_module_version(i: i64) -> string {
    if i >= 0 && i < trml_count {
        return trml_vers[i]
    }
    return ""
}
pub func refl_module_hash(i: i64) -> i64 {
    if i >= 0 && i < trml_count {
        return trml_hash[i]
    }
    return 0
}
pub func refl_module_fcnt(i: i64) -> i64 {
    if i >= 0 && i < trml_count {
        return trml_fcnt[i]
    }
    return 0
}
pub func refl_module_icnt(i: i64) -> i64 {
    if i >= 0 && i < trml_count {
        return trml_icnt[i]
    }
    return 0
}

// ---------- 函数内省（当前已加载 IR） ----------

// 当前模块函数数。
pub func refl_func_count() -> i64 {
    return ir.func_count()
}

// 函数名（按函数 id；越界返回空串）。
pub func refl_func_name(i: i64) -> string {
    if i >= 0 && i < ir.func_count() {
        return interner.name_str(ir.func_name(i))
    }
    return ""
}

// 函数返回类型码（types 自编码；越界 -1）。
pub func refl_func_ret(i: i64) -> i64 {
    if i >= 0 && i < ir.func_count() {
        return ir.func_ret(i)
    }
    return -1
}

// 函数参数个数（越界 -1）。
pub func refl_func_params(i: i64) -> i64 {
    if i >= 0 && i < ir.func_count() {
        return ir.func_params_cnt(i)
    }
    return -1
}

// 函数指令总数（按块段累计；越界 -1）。
pub func refl_func_insts(i: i64) -> i64 {
    if i < 0 || i >= ir.func_count() {
        return -1
    }
    var total: i64 = 0
    var nb = ir.block_count()
    var b: i64 = 0
    while b < nb {
        if ir.block_func(b) == i {
            total = total + (ir.block_end(b) - ir.block_start(b))
        }
        b = b + 1
    }
    return total
}

// 函数导出标记（越界 -1）。
pub func refl_func_exported(i: i64) -> i64 {
    if i >= 0 && i < ir.func_count() {
        return ir.func_exported(i)
    }
    return -1
}

// ---------- 类型码/指令名 ----------

// 类型码 → 文本（对齐 llvmgen 面：3=i64 9=f64 10=i1 13=str 14=void）。
pub func refl_ty_name(t: i64) -> string {
    if t == 3 {
        return "i64"
    }
    if t == 9 {
        return "f64"
    }
    if t == 10 {
        return "i1"
    }
    if t == 13 {
        return "str"
    }
    if t == 14 {
        return "void"
    }
    return "ty" + to_string(t)
}

// opcode → 指令名（ir.op_name；未知名返回 "op?" + 码）。
pub func refl_op_name(op: i64) -> string {
    var nm = ir.op_name(op)
    if str_len(nm) == 0 {
        return "op?" + to_string(op)
    }
    return nm
}

// ---------- 诊断 ----------

// 模块诊断摘要（含包/版本/函数/块/指令/导出规模）。
pub func refl_describe() -> string {
    var s = "pkg=" + interner.name_str(ir_meta.get_pkg_name())
    s = s + " ver=" + interner.name_str(ir_meta.get_pkg_version())
    s = s + " func=" + to_string(ir.func_count())
    s = s + " block=" + to_string(ir.block_count())
    s = s + " inst=" + to_string(ir.inst_count())
    s = s + " export=" + to_string(ir_meta.export_count())
    return s
}

// 模块 i 的信息行（诊断）。
pub func refl_module_info(i: i64) -> string {
    var s = "module[" + to_string(i) + "]=" + refl_module_name(i)
    s = s + "@" + refl_module_version(i)
    s = s + " hash=0x" + to_string(refl_module_hash(i))
    s = s + " f=" + to_string(refl_module_fcnt(i))
    s = s + " i=" + to_string(refl_module_icnt(i))
    return s
}

}   // namespace trm