type tie<class>
// compiler/trm/trm_gc.tie —— 引擎级 GC（p.7.3.2-c）
// ============================================================
// 里程碑：2026.2 路线图 p.7.3.2-c「引擎级 GC（分代+移动+精确根扫描，管 tieir
// Object/Value）」。验收：GC 探针 + 根扫描正确。
// 定位（trm-final-design §3.2）：GC 独立成层、引擎层子系统，管 tieir 运行时
// Object/Value 生命期（interp/后端共用托管堆、单一对象身份）。本阶段落地核心：
//   * 对象堆：对象 = 平行表记录（类型码 + 引用段 [off, cnt)）——扁平引用表，
//     id 即下标（B1 arena 同款，单调只增）；
//   * **精确根扫描**：根对象注册表（JVM 全局/栈根对位；interp 值槽为执行期根，
//     本层以显式根集承载根——运行时宿主的根面）；标记 = 沿引用遍历（显式
//     工作表迭代，无递归）；
//   * **mark & sweep**：不可达即回收（周期引用整体可回收——根外环不误清、
//     无泄漏）；
//   * 生命周期负例语义：根内对象不可清（多次 collect 存活）；去根后一次
//     collect 即亡；已亡对象 is_live 恒假。
//   * 回收统计：collect 后 live/free 计数（GC 探针断言载体）。
//   分代 + 移动式回收为后置细化（§12 未决开放项；本期锚定可达性正确性，
//   与里程碑验收「GC 探针 + 根扫描正确」一致）。
//
// # 引擎值模型衔接（§3.2 管理对象）
//   本层管理的对象对应引擎堆上的 Object 值（标量/容器引用）；interp 执行面
//   通过 trm 运行上下文与 GC 共享对象身份（值槽为根，本期以显式根集代表）。
//
// # 语言边界
//   无递归：标记/清理全部迭代（显式工作表）；无 continue/break；&& 非短路；
//   顶层符号 trmg_ 前缀；表参数用 table<i64>。
//
// # 调用
//   trm.gc_alloc(kind, refs) / gc_add_root / gc_rm_root / gc_collect()
//   / gc_live() / gc_freed() / gc_is_live(id) / gc_heap_size()

// ---------- 对象堆状态（模块级全局，前缀 trmg_；namespace 体外） ----------
var trmg_n: i64 = 0;            // 堆对象数（含已回收；id 单调）
var trmg_kind: table<i64>;      // 对象类型码（1=标量 2=容器）
var trmg_mark: table<i64>;      // 最近一轮可达标记（0/1）
var trmg_swept: table<i64>;     // 是否曾被回收（独特死对象计数；0=从未 1=已回收）
var trmg_refs_off: table<i64>;  // 引用段偏移（trmg_refs 内）
var trmg_refs_cnt: table<i64>;  // 引用段长度
var trmg_refs: table<i64>;      // 引用扁平表（对象 id 扁平）
var trmg_roots: table<i64>;     // 根对象 id 注册表（升序去重；逻辑长 = nroots）
var trmg_nroots: i64 = 0;       // 根数
var trmg_live: i64 = 0;         // 最近 collect 后存活数
var trmg_freed: i64 = 0;        // 累计回收对象数（独特死对象口径，防重复计）
var trmg_err: string = "";      // 最近错误

namespace trm {

func gc_set_err(msg: string) {
    trmg_err = msg
}

// 最近错误（空 = 无错误）。
pub func gc_err() -> string {
    return trmg_err
}

// ---------- 分配 ----------

// 在引擎堆上分配对象：kind 类型码 + refs 引用表（复制进扁平段）。
// 返回对象 id（>=0）/ -1（refs 含越界引用）。
pub func gc_alloc(kind: i64, refs: table<i64>) -> i64 {
    var bad: i64 = 0
    var r: i64 = 0
    while r < len(refs) {
        if refs[r] < 0 || refs[r] >= trmg_n {
            bad = 1
        }
        r = r + 1
    }
    if bad == 1 {
        gc_set_err("gc_alloc 引用越界")
        return -1
    }
    var off = len(trmg_refs)
    var i: i64 = 0
    while i < len(refs) {
        table_push(trmg_refs, refs[i])
        i = i + 1
    }
    table_push(trmg_kind, kind)
    table_push(trmg_mark, 0)
    table_push(trmg_swept, 0)
    table_push(trmg_refs_off, off)
    table_push(trmg_refs_cnt, len(refs))
    var id0 = trmg_n
    trmg_n = trmg_n + 1
    gc_set_err("")
    return id0
}

// ---------- 根注册表（精确根：宿主导入的根对象集） ----------

// 追加引用边：from → to（后置建环/引用构造；to 越界报错）。
// 实现要点：共享引用表为追加式尾部，后建对象的段可能落进先建空段的
// 偏移上（段混叠）——按段位三态处理：空段重新指向尾部 / 段在尾部直接
// 追加 / 段不在尾部则复制到尾部再追加（保证每对象段独占、永不混叠）。
// 返回 0 / -1（from/to 越界）。
pub func gc_link(from: i64, to: i64) -> i64 {
    if from < 0 || from >= trmg_n || to < 0 || to >= trmg_n {
        gc_set_err("gc_link 越界")
        return -1
    }
    var off = trmg_refs_off[from]
    var cnt = trmg_refs_cnt[from]
    var tail: i64 = len(trmg_refs)
    if cnt == 0 {
        // 空段：直接指向当前尾部（避免与后续对象的段重叠）
        trmg_refs_off[from] = tail
        table_push(trmg_refs, to)
        trmg_refs_cnt[from] = 1
    } else if off + cnt == tail {
        // 段就在尾部：原地追加
        table_push(trmg_refs, to)
        trmg_refs_cnt[from] = cnt + 1
    } else {
        // 段被后续分配夹在中间：复制到尾部再追加（独占重建）
        var k: i64 = 0
        while k < cnt {
            table_push(trmg_refs, trmg_refs[off + k])
            k = k + 1
        }
        table_push(trmg_refs, to)
        trmg_refs_off[from] = tail
        trmg_refs_cnt[from] = cnt + 1
    }
    gc_set_err("")
    return 0
}

// 登记根对象（升序去重；复用 rm 留下的陈旧尾槽，物理表不膨胀）。
// 返回 0 / -1（越界）。
pub func gc_add_root(id0: i64) -> i64 {
    if id0 < 0 || id0 >= trmg_n {
        gc_set_err("gc_add_root 越界对象")
        return -1
    }
    var i: i64 = 0
    var dup: i64 = 0
    while i < trmg_nroots {
        if trmg_roots[i] == id0 {
            dup = 1
        }
        i = i + 1
    }
    if dup == 1 {
        return 0
    }
    if len(trmg_roots) > trmg_nroots {
        trmg_roots[trmg_nroots] = id0
    } else {
        table_push(trmg_roots, id0)
    }
    trmg_nroots = trmg_nroots + 1
    return 0
}

// 移出根对象。返回 0 / -1（未登记）。
pub func gc_rm_root(id0: i64) -> i64 {
    var found: i64 = -1
    var i: i64 = 0
    while i < trmg_nroots {
        if trmg_roots[i] == id0 {
            found = i
        }
        i = i + 1
    }
    if found < 0 {
        gc_set_err("gc_rm_root 未登记根")
        return -1
    }
    // 移出（保持升序：后段前移；逻辑长度 = nroots——物理表不再 pop）
    var j = found
    while j + 1 < trmg_nroots {
        trmg_roots[j] = trmg_roots[j + 1]
        j = j + 1
    }
    trmg_nroots = trmg_nroots - 1
    return 0
}

// 根数。
pub func gc_nroots() -> i64 {
    return trmg_nroots
}

// ---------- 精确标记（迭代工作表，无递归） ----------

// 从全部根出发标记可达对象（沿引用遍历；工作表 = 显式栈）。
func gc_mark() {
    var widx: i64 = 0
    var i: i64 = 0
    while i < trmg_n {
        trmg_mark[i] = 0
        i = i + 1
    }
    // 工作表（复用独立局部表；栈式 push/pop）
    var work: table<i64> = table_new_i64()
    var wi: i64 = 0
    while wi < trmg_nroots {
        var rid = trmg_roots[wi]
        if trmg_mark[rid] == 0 {
            trmg_mark[rid] = 1
            table_push(work, rid)
            widx = widx + 1
        }
        wi = wi + 1
    }
    // 显式栈遍历（pop 后推其引用；widx = 栈顶游标）
    while widx > 0 {
        widx = widx - 1
        var cur = work[widx]
        var off = trmg_refs_off[cur]
        var cnt = trmg_refs_cnt[cur]
        var k: i64 = 0
        while k < cnt {
            var c = trmg_refs[off + k]
            if trmg_mark[c] == 0 {
                trmg_mark[c] = 1
                work[widx] = c
                widx = widx + 1
            }
            k = k + 1
        }
    }
}

// ---------- 回收（mark & sweep；周期引用整体可回收） ----------

// 执行一次回收：标记 → 清扫（未曾回收的不可达对象计入 freed——独特死对象
// 口径，同一对象不重复计）。返回存活对象数。
// 根外环（周期引用）无外部根 → 整体不可达 → 一并回收（无泄漏）。
pub func gc_collect() -> i64 {
    gc_mark()
    var live: i64 = 0
    var frees: i64 = 0
    var i: i64 = 0
    while i < trmg_n {
        if trmg_mark[i] == 1 {
            live = live + 1
        } else if trmg_swept[i] == 0 {
            trmg_swept[i] = 1
            frees = frees + 1
        }
        i = i + 1
    }
    trmg_live = live
    trmg_freed = trmg_freed + frees
    gc_set_err("")
    return live
}

// 最近回收后存活对象数。
pub func gc_live() -> i64 {
    return trmg_live
}

// 累计回收对象数（全部 collect 之和）。
pub func gc_freed() -> i64 {
    return trmg_freed
}

// 堆对象总数（含已回收；id 单调不复用）。
pub func gc_heap_size() -> i64 {
    return trmg_n
}

// 对象最近一轮是否可达（collect 前调用：以最近一次 collect 的结果为准；
// 从未 collect 过 → 全部 0）。生命周期断言的载体。
pub func gc_is_live(id0: i64) -> i64 {
    if id0 < 0 || id0 >= trmg_n {
        return 0
    }
    return trmg_mark[id0]
}

}   // namespace trm