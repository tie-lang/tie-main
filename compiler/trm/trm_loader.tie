type tie<class>
// compiler/trm/trm_loader.tie —— trm 引擎类加载器（p.7.3.2-a：tieir 加载 + 校验）
// ============================================================
// 里程碑：2026.2 路线图 p.7.3.2-a「tieir 加载 + 校验 + interp 执行」。
// 类加载器底座：加载 .tieir 分发单元 → 反序列化 + 校验（tieir_ser.read 内建：
// 魔数/版本/段号顺序/段体越界/列长一致性均校验，失败 = 加载失败安全底线）+
// 内容哈希（篡改检测载体）→ 登记模块记录 → 运行时按名查找函数。
// 与 JVM 类加载器对位：加载（defineClass 对位）+ 校验（verify 对位）+ 注册表。
//
// # 模块记录（平行表，id = 下标；命名 trml_ 防 import 内联顶层重名）
//   名 / 版本 / 内容哈希（tieir.content_hash：段 2-7，FNV-1a 32）/ 函数数 / 指令数
//
// # 语义约定
//   - 单「当前模块」：反序列化后的全局 IR 池即当前模块（多次 load 覆盖——
//     加载即准备执行，先加载先跑）；同一 name@version 重复加载拒绝
//     （类加载器一次加载语义）；
//   - 反序列化校验失败 = 加载失败（返回 -1 + err_msg）。
//
// # 语言边界（对齐 compiler/middle 系列）
//   - 只 import tieir_ser（链载 ir/ir_meta/interner/columnar/bytes/std）；
//   - 全局表懒构建（len() == 0 守卫，仿 ensure_opcodes 模式）；
//   - 无 continue/break/递归；&& 非短路（边界判断与下标取值分开）。

import "../middle/tieir_ser.tie"

// ---------- 模块注册表（模块级全局，namespace trm 跨文件共享；前缀 trml_） ----------
var trml_count: i64 = 0;
var trml_names: table<string>;   // 模块名
var trml_vers: table<string>;    // 模块版本
var trml_hash: table<i64>;       // 内容哈希（段 2-7 FNV-1a，篡改检测载体）
var trml_fcnt: table<i64>;       // 函数数
var trml_icnt: table<i64>;       // 指令数
var trml_err: string = "";       // 最近错误（空 = 无错误）

namespace trm {

func trml_set_err(msg: string) {
    trml_err = msg
}

// 最近错误（空 = 上次操作成功）。
pub func loader_err() -> string {
    return trml_err
}

// ---------- 实现 ----------

// 注册表懒构建（幂等：已建直接返回）。
func trml_init() {
    if len(trml_names) == 0 {
        trml_names = table_new_string()
        trml_vers = table_new_string()
        trml_hash = table_new_i64()
        trml_fcnt = table_new_i64()
        trml_icnt = table_new_i64()
    }
}

// 加载并校验 .tieir 分发单元，登记模块记录。返回模块 id（>= 0）成功 /
// -1 失败（loader_err() 取原因）。
pub func load_module(path: string) -> i64 {
    trml_init()
    trml_set_err("")
    var rc = tieir.read(path)
    if rc != 0 {
        trml_set_err(tieir.err_msg())
        return -1
    }
    var nm = interner.name_str(ir_meta.get_pkg_name())
    var ver = interner.name_str(ir_meta.get_pkg_version())
    // 查重：同 name@version 拒绝（类加载器一次加载语义）
    var d: i64 = 0
    var dup: i64 = 0
    while d < trml_count {
        if trml_names[d] == nm && trml_vers[d] == ver {
            dup = 1
        }
        d = d + 1
    }
    if dup == 1 {
        trml_set_err("模块重复加载: " + nm + "@" + ver)
        return -1
    }
    var h = tieir.content_hash()
    table_push(trml_names, nm)
    table_push(trml_vers, ver)
    table_push(trml_hash, h)
    table_push(trml_fcnt, ir.func_count())
    table_push(trml_icnt, ir.inst_count())
    var mid = trml_count
    trml_count = trml_count + 1
    return mid
}

// 按函数名查当前模块中的函数 id（函数名 = IR 函数全名；-1 未找到）。
pub func find_func(name: string) -> i64 {
    var nf = ir.func_count()
    var f: i64 = 0
    while f < nf {
        if interner.name_str(ir.func_name(f)) == name {
            return f
        }
        f = f + 1
    }
    return -1
}

}   // namespace trm