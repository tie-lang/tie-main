type tie<logic>
// ============================================================================
// probe_format.tie：format（document formatting，p.6.9.11）探针
//
// 验收：
//   · 无缩进输入（func main() { / var x = 1 / if x > 0 { / println(x) / } / }）
//     → tsp_fmt.format 返回 TextEdit[] JSON，newText 按 2 空格/级缩进：
//     var x = 1 与 if x > 0 { 为 2 空格（\n  var x = 1\n），println(x) 为
//     4 空格（\n    println(x)\n）
//   · 幂等：对格式化结果再 format 一次 → 返回 []（已定型，无需改动）
// 全部断言通过打印 PROBE:PASS 并 exit 0；任一失败打印 PROBE:FAIL 并 exit 1。
//
// 编译：tiec compiler/lsp/probe_format.tie -o compiler/lsp/probe_format.exe
// ============================================================================

import "./format.tie" as tsp_fmt

// 子串查找（首个子串出现位置；未找到 -1）。本文件自足（str_find 非内置）。
func find_sub(hay: string, needle: string) -> i64 {
    if len(needle) == 0 {
        return 0
    }
    var i: i64 = 0
    while i + len(needle) <= len(hay) {
        var matched: bool = true
        var j: i64 = 0
        while j < len(needle) {
            if str_char(hay, i + j) != str_char(needle, j) {
                matched = false
                break
            }
            j = j + 1
        }
        if matched {
            return i
        }
        i = i + 1
    }
    return -1
}

// 子串包含判定。
func has(s: string, sub: string) -> bool {
    return find_sub(s, sub) >= 0
}

// 从 TextEdit[] JSON 提取 newText（含 JSON 转义还原 \n \r \t \" \\）。
func extract_newtext(j: string) -> string {
    var key = "\"newText\":"
    var k = find_sub(j, key)
    if k < 0 {
        return ""
    }
    var start = k + len(key)
    if start >= len(j) || str_char(j, start) != "\"" {
        return ""
    }
    var i = start + 1
    var sb = string_builder()
    while i < len(j) {
        var c = str_char(j, i)
        if c == "\\" {
            if i + 1 < len(j) {
                var n = str_char(j, i + 1)
                if n == "n" {
                    sb_append(sb, "\n")
                } else if n == "r" {
                    sb_append(sb, "\r")
                } else if n == "t" {
                    sb_append(sb, "\t")
                } else if n == "\"" {
                    sb_append(sb, "\"")
                } else if n == "\\" {
                    sb_append(sb, "\\")
                } else {
                    sb_append(sb, c)
                }
                i = i + 1
            }
        } else if c == "\"" {
            break
        } else {
            sb_append(sb, c)
        }
        i = i + 1
    }
    return sb_build(sb)
}

func main() -> i64 {
    var src = "func main() {\nvar x = 1\nif x > 0 {\nprintln(x)\n}\n}\n"
    var j1 = tsp_fmt.format("", src)
    println("FMT1: " + j1)
    if j1 == "[]" {
        println("PROBE:FAIL 首格式未产出编辑")
        return 1
    }
    var nt = extract_newtext(j1)
    var ok: bool = true
    if !has(nt, "\n  var x = 1\n") {
        ok = false
        println("  FAIL: 缺 2 空格缩进 var x = 1")
    }
    if !has(nt, "\n  if x > 0 {\n    println(x)\n  }\n") {
        ok = false
        println("  FAIL: 缺 2/4 空格缩进 if 块")
    }
    // 幂等：对格式化结果再 format 一次 → 返回 []（已定型，无需改动）
    var j2 = tsp_fmt.format("", nt)
    println("FMT2: " + j2)
    if j2 != "[]" {
        ok = false
        println("  FAIL: 二次格式化非幂等（应返回 []）")
    }
    if !ok {
        println("PROBE:FAIL")
        return 1
    }
    println("PROBE:PASS")
    return 0
}
