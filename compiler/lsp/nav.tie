type tie<logic>
// ============================================================================
// nav.tie：tsp（tie Language Server）——definition + references（p.6.9.7）
// 命名空间：tsp_nav
//
// 实现（复用 analyze.tie 的每文档符号索引 + 前端 sstate 列式 AST）：
//   · definition：定位光标处标识符 → 当前文档索引查符号 → 未中跨文档枚举
//     （an.doc_count/an.doc_uri）→ 带命名空间前缀（'.'）时再试全名精确匹配
//     → LSP Location JSON（声明行列 1-based → 0-based）。
//   · references：an.run_check 重跑编译流水线（sstate 为本文档最新状态）→
//     递归遍历 g_file_roots[0]（主文件顶层 StmtList 根）找名字匹配的引用
//     节点（tag ∈ {N_VAR, N_CALL, N_METHOD_CALL, N_FIELD_ACCESS}）→
//     include_decl 时把声明位置并入（与引用位置去重）。
//
// 本文件编译：随 server.tie 一起编译（server 是主入口，本文件被 import）。
// ============================================================================

import "./analyze.tie" as an
import "./protocol.tie" as proto

// ---- AST 节点 tag 常量（对齐 frontend/ast.tie；本地定义——ast.tie 经
// parser 树传递 import，同名常量重定义会报错，故用 NAV_ 前缀）----
const NAV_VAR: i64 = 6
const NAV_CALL: i64 = 7
const NAV_PATH: i64 = 16
const NAV_FIELD_ACCESS: i64 = 15
const NAV_METHOD_CALL: i64 = 18
const NAV_VAR_DECL: i64 = 100
const NAV_FN_DEF: i64 = 101
const NAV_IMPORT: i64 = 111
const NAV_NAMESPACE: i64 = 112
const NAV_STRUCT: i64 = 114
const NAV_EXTERN: i64 = 117
const NAV_PARAM: i64 = 118
const NAV_STMTLIST: i64 = 122
const NAV_ENUM: i64 = 128
const NAV_SEGMENT: i64 = 22
const NAV_NAMED_TYPE: i64 = 200

namespace tsp_nav {

// ==================== 自足小工具 ====================

// 行号（0-based）→ 行首偏移（越界返回文本长度）。
func line_start(txt: string, line: i64) -> i64 {
    var off: i64 = 0
    var ln: i64 = 0
    while ln < line && off < len(txt) {
        while off < len(txt) && str_byte(txt, off) != 10 {
            off = off + 1
        }
        if off < len(txt) {
            off = off + 1   // 跳过 \n
        }
        ln = ln + 1
    }
    return off
}

// 单字符是否标识符延续字符（字母/数字/下划线；char_code 数值比较）。
func is_idchar(c: string) -> bool {
    var v = char_code(c)
    return (v >= 65 && v <= 90) || (v >= 97 && v <= 122) || (v >= 48 && v <= 57) || v == 95
}

// 从 off 向两端扩展标识符；无标识符返回 ""。
func ident_at(txt: string, off: i64) -> string {
    if off < 0 || off > len(txt) {
        return ""
    }
    var a = off
    while a > 0 && is_idchar(str_char(txt, a - 1)) {
        a = a - 1
    }
    var b = off
    while b < len(txt) && is_idchar(str_char(txt, b)) {
        b = b + 1
    }
    if a >= b {
        return ""
    }
    return proto.substr_at(txt, a, b)
}

// 光标处标识符的完整限定名：左边是 '.' 时继续向左跨段收集
// （光标在 ns.add 的 add 处 → "ns.add"；无前缀 → 同 ident_at）。
func qualified_at(txt: string, off: i64) -> string {
    var a = off
    if a > len(txt) {
        a = len(txt)
    }
    while a > 0 && is_idchar(str_char(txt, a - 1)) {
        a = a - 1
    }
    var seg_start = a
    var left = a
    while left > 0 && str_char(txt, left - 1) == "." {
        var m = left - 2
        while m >= 0 && is_idchar(str_char(txt, m)) {
            m = m - 1
        }
        seg_start = m + 1
        left = seg_start
    }
    var b = off
    while b < len(txt) && is_idchar(str_char(txt, b)) {
        b = b + 1
    }
    if seg_start >= b {
        return ""
    }
    return proto.substr_at(txt, seg_start, b)
}

// 前缀判定。
func has_prefix(s: string, p: string) -> bool {
    if len(s) < len(p) {
        return false
    }
    var i: i64 = 0
    while i < len(p) {
        if str_char(s, i) != str_char(p, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// 子串 [start, end)（越界钳位）。
func substr(s: string, start: i64, end: i64) -> string {
    var a = start
    var b = end
    if a < 0 {
        a = 0
    }
    if b > len(s) {
        b = len(s)
    }
    if a >= b {
        return ""
    }
    var out: string = ""
    var i: i64 = a
    while i < b {
        out = out + str_char(s, i)
        i = i + 1
    }
    return out
}

// LSP Location JSON：声明行列（1-based）→ range 0-based；
// end.character = 起始列 + 名字长度。
func loc_json(uri: string, name: string, line: i64, col: i64) -> string {
    var l0 = line - 1
    var c0 = col - 1
    if l0 < 0 {
        l0 = 0
    }
    if c0 < 0 {
        c0 = 0
    }
    return "{\"uri\":" + proto.json_str(uri) + ",\"range\":{\"start\":{\"line\":" + to_string(l0) +
           ",\"character\":" + to_string(c0) + "},\"end\":{\"line\":" + to_string(l0) +
           ",\"character\":" + to_string(c0 + len(name)) + "}}}"
}

// 位置（line/character 0-based）→ 文件偏移。
func pos_to_offset(txt: string, line: i64, character: i64) -> i64 {
    var off = line_start(txt, line)
    var moved: i64 = 0
    while moved < character && off + moved < len(txt) && str_byte(txt, off + moved) != 10 {
        moved = moved + 1
    }
    return off + moved
}

// ==================== 跨文档符号查找 ====================

// 当前文档优先，未中则跨文档枚举；返回 (符号所在 uri, 符号下标)；未找到 ("", -1)。
func find_anywhere(uri: string, name: string) -> (string, i64) {
    var s = an.find_sym_named(uri, name)
    if s >= 0 {
        return (uri, s)
    }
    var i: i64 = 0
    while i < an.doc_count() {
        var du = an.doc_uri(i)
        if du != uri {
            var t = an.find_sym_named(du, name)
            if t >= 0 {
                return (du, t)
            }
        }
        i = i + 1
    }
    return ("", -1)
}

// ==================== definition ====================

// 光标处标识符 → 声明位置 Location JSON；未命中返回 "null"。
// line/character 0-based。索引里的名字若是带命名空间前缀（含 '.'），
// find_sym_named 按全名精确匹配天然覆盖；光标在限定名末段（如 ns.add 的
// add）时经 qualified_at 取全名再匹配。
pub func definition(uri: string, txt: string, base_dir: string, line: i64, character: i64) -> string {
    var off = pos_to_offset(txt, line, character)
    var name = ident_at(txt, off)
    if len(name) == 0 {
        return "null"
    }
    var (furi, s) = find_anywhere(uri, name)
    if s < 0 {
        // 全名精确匹配：光标处在限定名（含 '.'）的末段
        var full = qualified_at(txt, off)
        if len(full) > len(name) {
            var (f2, s2) = find_anywhere(uri, full)
            if s2 >= 0 {
                furi = f2
                s = s2
                name = full
            }
        }
    }
    if s < 0 {
        return "null"
    }
    return loc_json(furi, name, an.sym_line(furi, s), an.sym_col(furi, s))
}

// ==================== references ====================

// uri → 文档所在目录（import 相对路径解析基准；跨文件扫描用）。
func uri_to_dir(uri: string) -> string {
    var p = uri
    if has_prefix(p, "file://") {
        p = proto.substr_at(p, len("file://"), len(p))
    }
    while len(p) > 0 && (str_byte(p, 0) == 47 || str_byte(p, 0) == 92) {
        p = proto.substr_at(p, 1, len(p))
    }
    var last: i64 = -1
    var i: i64 = 0
    while i < len(p) {
        var c = str_byte(p, i)
        if c == 47 || c == 92 {
            last = i
        }
        i = i + 1
    }
    if last < 0 {
        return ""
    }
    return proto.substr_at(p, 0, last + 1)
}

// 光标处标识符 → 引用位置 Location[] JSON（**跨文件**：扫全部打开文档）；
// 未找到 "[]"。include_decl 时把索引里的声明位置并入（与引用位置去重）。
pub func references(uri: string, txt: string, base_dir: string, line: i64, character: i64, include_decl: bool) -> string {
    var off = pos_to_offset(txt, line, character)
    var name = ident_at(txt, off)
    if len(name) == 0 {
        return "[]"
    }
    var locs: table<string> = table_new_string()
    var ruris: table<string> = table_new_string()  // 平行：引用所在 uri（去重用）
    var rls: table<i64> = table_new_i64()          // 平行：引用行（0-based）
    var rcs: table<i64> = table_new_i64()          // 平行：引用列（0-based）
    var n = an.doc_count()
    var i: i64 = 0
    while i < n {
        var du = an.doc_uri(i)
        var dtext = an.fetch_text(du)
        if len(dtext) > 0 {
            var ok = an.run_check(dtext, uri_to_dir(du))
            if ok == 1 {
                walk_refs(g_file_roots[0], name, du, locs, ruris, rls, rcs)
            }
        }
        i = i + 1
    }
    if include_decl {
        var (furi, s) = find_anywhere(uri, name)
        if s >= 0 {
            var dl = an.sym_line(furi, s)
            var dc = an.sym_col(furi, s)
            var l0 = dl - 1
            var c0 = dc - 1
            if l0 < 0 {
                l0 = 0
            }
            if c0 < 0 {
                c0 = 0
            }
            // 去重：与同 uri 已有引用位置不同才加入
            var dup: bool = false
            var k: i64 = 0
            while k < len(ruris) {
                if ruris[k] == furi && rls[k] == l0 && rcs[k] == c0 {
                    dup = true
                    break
                }
                k = k + 1
            }
            if !dup {
                table_push(locs, loc_json(furi, name, dl, dc))
            }
        }
    }
    var out: string = "["
    var j: i64 = 0
    while j < len(locs) {
        if j > 0 {
            out = out + ","
        }
        out = out + locs[j]
        j = j + 1
    }
    out = out + "]"
    return out
}

// 递归遍历 AST：tag ∈ {N_VAR, N_CALL, N_METHOD_CALL, N_FIELD_ACCESS} 且
// 名字匹配的节点记为引用（N_METHOD_CALL/N_FIELD_ACCESS 只比 s_names）。
func walk_refs(node: i64, name: string, uri: string, locs: table<string>, ruris: table<string>, rls: table<i64>, rcs: table<i64>) {
    if node < 0 {
        return
    }
    var tag = s_tags[node]
    if tag == NAV_VAR || tag == NAV_CALL || tag == NAV_METHOD_CALL || tag == NAV_FIELD_ACCESS {
        var nid = s_names[node]
        if nid >= 0 && intern.lookup(nid) == name {
            table_push(locs, loc_json(uri, name, s_lines[node], s_cols[node]))
            table_push(ruris, uri)
            var l0 = s_lines[node] - 1
            var c0 = s_cols[node] - 1
            if l0 < 0 {
                l0 = 0
            }
            if c0 < 0 {
                c0 = 0
            }
            table_push(rls, l0)
            table_push(rcs, c0)
        }
    }
    var nc = s_nchild[node]
    var base = s_coff[node]
    var k: i64 = 0
    while k < nc {
        walk_refs(s_children[base + k], name, uri, locs, ruris, rls, rcs)
        k = k + 1
    }
}

}   // namespace tsp_nav
