type tie<logic>
// ============================================================================
// tokens.tie：tsp（tie Language Server）——semantic tokens + folding 模块（p.6.9.9）
// 命名空间：tsp_tok
//
// 实现（复用 analyze.tie 的 run_check + 前端 sstate 列式 AST）：
//   · semantic_tokens：an.run_check 重跑编译流水线（sstate 为本文档最新状态）→
//     递归遍历 g_file_roots[0]（主文件顶层 StmtList 根），按 AST 节点 tag 映射
//     LSP 语义令牌（tokenType 数字，legend 由 server 声明，顺序固定）→ 按
//     (行, 列) 排序 → 位置去重 → LSP SemanticTokens 标准 **delta 编码**
//     int 数组 JSON：{"data":[dLine,dStart,dLen,type,mod, ...]}。
//   · folding_ranges：run_check 成功后遍历 AST，对块型节点（FN_DEF/STRUCT/
//     ENUM/NAMESPACE/IF/WHILE/FOR/SWITCH/TRY/UNSAFE_BLOCK）且跨多行
//     （起止行差 >= 1）产出 FoldingRange（0 基）JSON 数组，按 startLine
//     排序、同区间去重。
//
// 位置说明（前端 AST 布局实测）：
//   · VAR/CALL/NAMED_TYPE 节点位置即名字位置；FN_DEF/STRUCT/ENUM/NAMESPACE/
//     EXTERN 节点位置在关键字处（pub/repr 等修饰符前缀时在其前）——关键字与
//     名字令牌用源文本扫描定位（跳过 pub/async/unsafe/repr(C) 修饰）。
//   · PARAM 节点位置在参数声明末尾（类型/默认值之后），名字用同行/上数行
//     回溯扫描定位。
//   · METHOD_CALL 节点位置在接收者表达式起始，名字用 "."+方法名 前向扫描定位。
//   · 无返回类型函数的合成 "void" NAMED_TYPE 与函数节点同位——跳过
//     （用递归上下文 fnl/fnc 判定，避免与关键字令牌重叠）。
//   · TRY（`expr ?` 后缀解包）源码中无 "try" 关键字（节点位在操作数起始），
//     不产关键字令牌。
//
// 本文件编译：随 server.tie 一起编译（server 主入口 import 本文件）或经
// probe_tokens.tie 单独编译验证。
// ============================================================================

import "./analyze.tie" as an
import "./protocol.tie" as proto

// ---- AST 节点 tag 常量（对齐 frontend/ast.tie；本地定义——ast.tie 经
// parser 树传递 import，同名常量重定义会报错，故用 TOK_ 前缀）----
const TOK_VAR: i64 = 6
const TOK_CALL: i64 = 7
const TOK_PATH: i64 = 16
const TOK_FIELD_ACCESS: i64 = 15
const TOK_METHOD_CALL: i64 = 18
const TOK_VAR_DECL: i64 = 100
const TOK_FN_DEF: i64 = 101
const TOK_EXPR_STMT: i64 = 102
const TOK_ASSIGN: i64 = 103
const TOK_RETURN: i64 = 104
const TOK_IF: i64 = 105
const TOK_WHILE: i64 = 106
const TOK_FOR: i64 = 107
const TOK_BREAK: i64 = 108
const TOK_CONTINUE: i64 = 109
const TOK_SWITCH: i64 = 110
const TOK_IMPORT: i64 = 111
const TOK_NAMESPACE: i64 = 112
const TOK_USING: i64 = 113
const TOK_STRUCT: i64 = 114
const TOK_EXTERN: i64 = 117
const TOK_PARAM: i64 = 118
const TOK_STMTLIST: i64 = 122
const TOK_ENUM: i64 = 128
const TOK_SEGMENT: i64 = 22
const TOK_NAMED_TYPE: i64 = 200
const TOK_UNSAFE_BLOCK: i64 = 130
const TOK_TRY: i64 = 133
const TOK_PANIC: i64 = 134

// ---- LSP SemanticTokenTypes 数字（legend 由 server 声明，顺序固定）----
const TT_NAMESPACE: i64 = 0
const TT_TYPE: i64 = 1
const TT_CLASS: i64 = 2
const TT_ENUM: i64 = 3
const TT_INTERFACE: i64 = 4
const TT_STRUCT: i64 = 5
const TT_TYPE_PARAM: i64 = 6
const TT_PARAMETER: i64 = 7
const TT_VARIABLE: i64 = 8
const TT_PROPERTY: i64 = 9
const TT_ENUM_MEMBER: i64 = 10
const TT_EVENT: i64 = 11
const TT_FUNCTION: i64 = 12
const TT_METHOD: i64 = 13
const TT_MACRO: i64 = 14
const TT_KEYWORD: i64 = 15
const TT_MODIFIER: i64 = 16
const TT_COMMENT: i64 = 17
const TT_STRING: i64 = 18
const TT_NUMBER: i64 = 19
const TT_REGEXP: i64 = 20
const TT_OPERATOR: i64 = 21
const TT_DECORATOR: i64 = 22

namespace tsp_tok {

// ==================== 自足小工具 ====================

// 0 基行 → 行首字节偏移（越界返回 len(txt)）。字节级（str_char ~360µs/次）。
func line_start(txt: string, line: i64) -> i64 {
    var off: i64 = 0
    var ln: i64 = 0
    while ln < line && off < len(txt) {
        while off < len(txt) && str_byte(txt, off) != 10 {
            off = off + 1
        }
        if off < len(txt) {
            off = off + 1   // 跳过 \n
        }
        ln = ln + 1
    }
    return off
}

// 字节偏移 → 0 基行号。
func off_line(txt: string, off: i64) -> i64 {
    var ln: i64 = 0
    var i: i64 = 0
    while i < off && i < len(txt) {
        if str_byte(txt, i) == 10 {
            ln = ln + 1
        }
        i = i + 1
    }
    return ln
}

// 字节偏移 → 0 基列号（本行内）。
func off_col(txt: string, off: i64) -> i64 {
    var i = off
    while i > 0 && str_byte(txt, i - 1) != 10 {
        i = i - 1
    }
    return off - i
}

// 子串 [start, end)（越界钳位；str_sub_bytes 一次拷贝）。
func substr(s: string, start: i64, end: i64) -> string {
    var a = start
    var b = end
    if a < 0 {
        a = 0
    }
    if b > len(s) {
        b = len(s)
    }
    if a >= b {
        return ""
    }
    return str_sub_bytes(s, a, b)
}

// 字节是否标识符字符（字母/数字/下划线）。
func is_idb(v: i64) -> bool {
    return (v >= 65 && v <= 90) || (v >= 97 && v <= 122) || (v >= 48 && v <= 57) || v == 95
}

// 从 off 起跳过空白，返回第一个非空白偏移；无则 -1。
func skip_ws(txt: string, off: i64) -> i64 {
    var i = off
    while i < len(txt) {
        var c = str_byte(txt, i)
        if c == 32 || c == 9 || c == 13 || c == 10 {
            i = i + 1
        } else {
            return i
        }
    }
    return -1
}

// 从 off 起读一个标识符，返回 [start, end) 字节偏移；无标识符返回 (-1,-1)。
func read_ident(txt: string, off: i64) -> (i64, i64) {
    var s = skip_ws(txt, off)
    if s < 0 {
        return (-1, -1)
    }
    if !is_idb(str_byte(txt, s)) {
        return (-1, -1)
    }
    var e = s
    while e < len(txt) && is_idb(str_byte(txt, e)) {
        e = e + 1
    }
    return (s, e)
}

// 从节点起始向后找第一个非修饰标识符（修饰：pub/async/unsafe/repr(C)）。
// 返回该标识符 [start, end) 字节偏移；找不到 (-1,-1)。
func kw_span(txt: string, node: i64) -> (i64, i64) {
    var l0 = s_lines[node] - 1
    var c0 = s_cols[node] - 1
    if l0 < 0 {
        l0 = 0
    }
    if c0 < 0 {
        c0 = 0
    }
    var off = line_start(txt, l0) + c0
    var i = off
    var lim = off + 48
    if lim > len(txt) {
        lim = len(txt)
    }
    while i < lim {
        var (s, e) = read_ident(txt, i)
        if s < 0 {
            return (-1, -1)
        }
        var w = substr(txt, s, e)
        if w == "repr" {
            // repr(C)：跳过括号部分
            i = e
            while i < lim && str_byte(txt, i) != 41 {
                i = i + 1
            }
            if i < lim {
                i = i + 1
            }
            continue
        }
        if w != "pub" && w != "async" && w != "unsafe" {
            return (s, e)
        }
        i = e
    }
    return (-1, -1)
}

// ==================== 令牌收集 ====================

// 追加令牌：(0 基行, 0 基列, 长度, 类型)。
func tok_push(tl: table<i64>, tc: table<i64>, tlens: table<i64>, tt: table<i64>,
              line: i64, col: i64, l: i64, t: i64) {
    table_push(tl, line)
    table_push(tc, col)
    table_push(tlens, l)
    table_push(tt, t)
}

// 名字令牌：节点名（s_names → intern.lookup），位置 = 节点位置。
func emit_name(node: i64, tl: table<i64>, tc: table<i64>, tlens: table<i64>, tt: table<i64>, t: i64) {
    var nid = s_names[node]
    if nid < 0 {
        return
    }
    var nm = intern.lookup(nid)
    var l = len(nm)
    if l <= 0 {
        return
    }
    var l0 = s_lines[node] - 1
    var c0 = s_cols[node] - 1
    if l0 < 0 {
        l0 = 0
    }
    if c0 < 0 {
        c0 = 0
    }
    tok_push(tl, tc, tlens, tt, l0, c0, l, t)
}

// 声明名令牌：关键字之后的名字（FN_DEF/STRUCT/ENUM）。
// 位置 = kw_span 之后第一个标识符。
func emit_after_kw(node: i64, txt: string, tl: table<i64>, tc: table<i64>,
                   tlens: table<i64>, tt: table<i64>, t: i64) {
    var nid = s_names[node]
    if nid < 0 {
        return
    }
    var l = len(intern.lookup(nid))
    if l <= 0 {
        return
    }
    var (s, e) = kw_span(txt, node)
    if s < 0 {
        return
    }
    var (s2, e2) = read_ident(txt, e)
    if s2 < 0 {
        return
    }
    tok_push(tl, tc, tlens, tt, off_line(txt, s2), off_col(txt, s2), l, t)
}

// var/const 声明名令牌：关键字之后的名字。
func emit_var_decl(node: i64, txt: string, tl: table<i64>, tc: table<i64>,
                   tlens: table<i64>, tt: table<i64>) {
    var nid = s_names[node]
    if nid < 0 {
        return
    }
    var l = len(intern.lookup(nid))
    if l <= 0 {
        return
    }
    var l0 = s_lines[node] - 1
    var c0 = s_cols[node] - 1
    if l0 < 0 {
        l0 = 0
    }
    if c0 < 0 {
        c0 = 0
    }
    var off = line_start(txt, l0) + c0
    var (s, e) = read_ident(txt, off)   // var / const
    if s < 0 {
        return
    }
    var (s2, e2) = read_ident(txt, e)   // 名字
    if s2 < 0 {
        return
    }
    tok_push(tl, tc, tlens, tt, off_line(txt, s2), off_col(txt, s2), l, TT_VARIABLE)
}

// 命名空间段名令牌：关键字之后逐段读标识符（namespace a.b { ... }）。
func emit_ns(node: i64, txt: string, tl: table<i64>, tc: table<i64>,
             tlens: table<i64>, tt: table<i64>) {
    var (s, e) = kw_span(txt, node)
    if s < 0 {
        return
    }
    var nsegs = s_aux[node]
    var base = s_coff[node]
    var cur = e
    var k: i64 = 0
    while k < nsegs {
        var seg = s_children[base + k]
        if seg >= 0 {
            var nid = s_names[seg]
            if nid >= 0 {
                var l = len(intern.lookup(nid))
                var (s2, e2) = read_ident(txt, cur)
                if s2 >= 0 && l > 0 {
                    tok_push(tl, tc, tlens, tt, off_line(txt, s2), off_col(txt, s2), l, TT_NAMESPACE)
                    cur = e2 + 1   // 跳过 '.'（若有下一段）
                }
            }
        }
        k = k + 1
    }
}

// 参数名令牌：参数节点位置在声明末尾（类型/默认值之后），名字在其前。
// 从节点位置回溯（最多上溯 6 行）找最近一个与参数名相同的标识符。
func emit_param(node: i64, txt: string, tl: table<i64>, tc: table<i64>,
                tlens: table<i64>, tt: table<i64>) {
    var nid = s_names[node]
    if nid < 0 {
        return
    }
    var nm = intern.lookup(nid)
    var l = len(nm)
    if l <= 0 {
        return
    }
    var l0 = s_lines[node] - 1
    var c0 = s_cols[node] - 1
    if l0 < 0 {
        l0 = 0
    }
    if c0 < 0 {
        c0 = 0
    }
    var off = line_start(txt, l0) + c0
    var i = off - 1
    var nl: i64 = 0
    while i >= 0 {
        if str_byte(txt, i) == 10 {
            nl = nl + 1
            if nl > 6 {
                break
            }
            i = i - 1
            continue
        }
        if is_idb(str_byte(txt, i)) {
            var e = i + 1
            var s2 = i
            while s2 > 0 && is_idb(str_byte(txt, s2 - 1)) {
                s2 = s2 - 1
            }
            if substr(txt, s2, e) == nm {
                tok_push(tl, tc, tlens, tt, off_line(txt, s2), off_col(txt, s2), l, TT_PARAMETER)
                return
            }
            i = s2 - 1
        } else {
            i = i - 1
        }
    }
    // 未找到：跳过（避免错位高亮）
}

// 方法名令牌：METHOD_CALL 节点位置在接收者起始，名字 = "."+方法名 前向扫描。
func emit_method(node: i64, txt: string, tl: table<i64>, tc: table<i64>,
                 tlens: table<i64>, tt: table<i64>) {
    var nid = s_names[node]
    if nid < 0 {
        return
    }
    var nm = intern.lookup(nid)
    var l = len(nm)
    if l <= 0 {
        return
    }
    var l0 = s_lines[node] - 1
    var c0 = s_cols[node] - 1
    if l0 < 0 {
        l0 = 0
    }
    if c0 < 0 {
        c0 = 0
    }
    var off = line_start(txt, l0) + c0
    var lim = off + 300
    if lim > len(txt) {
        lim = len(txt)
    }
    var i = off
    while i < lim {
        if str_byte(txt, i) == 46 {
            var (s2, e2) = read_ident(txt, i + 1)
            if s2 >= 0 {
                if substr(txt, s2, e2) == nm {
                    tok_push(tl, tc, tlens, tt, off_line(txt, s2), off_col(txt, s2), l, TT_FUNCTION)
                    return
                }
                i = e2
            } else {
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
    // 未找到：跳过（避免错位高亮）
}

// 关键字令牌：节点固定关键字（长度表）；FN_DEF/STRUCT/ENUM/NAMESPACE/EXTERN
// 用 kw_span 取实际关键字位置与长度（兼容 pub/repr/unsafe 修饰前缀）。
func emit_kw(node: i64, txt: string, tl: table<i64>, tc: table<i64>,
             tlens: table<i64>, tt: table<i64>) {
    var tag = s_tags[node]
    if tag == TOK_FN_DEF || tag == TOK_STRUCT || tag == TOK_ENUM ||
       tag == TOK_NAMESPACE || tag == TOK_EXTERN {
        var (s, e) = kw_span(txt, node)
        if s < 0 {
            return
        }
        tok_push(tl, tc, tlens, tt, off_line(txt, s), off_col(txt, s), e - s, TT_KEYWORD)
        return
    }
    var kl: i64 = 0
    if tag == TOK_IMPORT {
        kl = 6
    } else if tag == TOK_USING {
        kl = 5
    } else if tag == TOK_RETURN {
        kl = 6
    } else if tag == TOK_IF {
        kl = 2
    } else if tag == TOK_WHILE {
        kl = 5
    } else if tag == TOK_FOR {
        kl = 3
    } else if tag == TOK_BREAK {
        kl = 5
    } else if tag == TOK_CONTINUE {
        kl = 8
    } else if tag == TOK_SWITCH {
        kl = 6
    } else if tag == TOK_PANIC {
        kl = 5
    } else if tag == TOK_UNSAFE_BLOCK {
        kl = 6
    } else {
        return
    }
    var l0 = s_lines[node] - 1
    var c0 = s_cols[node] - 1
    if l0 < 0 {
        l0 = 0
    }
    if c0 < 0 {
        c0 = 0
    }
    tok_push(tl, tc, tlens, tt, l0, c0, kl, TT_KEYWORD)
}

// 递归收集语义令牌。fnl/fnc：所在函数/外联声明起始位置（0 基；-1 = 顶层），
// 用于跳过与声明同位的合成 "void" 返回类型节点。
func walk_tokens(node: i64, txt: string, tl: table<i64>, tc: table<i64>,
                 tlens: table<i64>, tt: table<i64>, fnl: i64, fnc: i64) {
    if node < 0 {
        return
    }
    var tag = s_tags[node]
    if tag == TOK_VAR {
        emit_name(node, tl, tc, tlens, tt, TT_VARIABLE)
    } else if tag == TOK_CALL {
        emit_name(node, tl, tc, tlens, tt, TT_FUNCTION)
    } else if tag == TOK_METHOD_CALL {
        emit_method(node, txt, tl, tc, tlens, tt)
    } else if tag == TOK_NAMED_TYPE {
        var nid = s_names[node]
        if nid >= 0 && fnl >= 0 {
            var l0 = s_lines[node] - 1
            var c0 = s_cols[node] - 1
            if l0 == fnl && c0 == fnc && intern.lookup(nid) == "void" {
                // 合成的 void 返回类型：跳过
            } else {
                emit_name(node, tl, tc, tlens, tt, TT_TYPE)
            }
        } else {
            emit_name(node, tl, tc, tlens, tt, TT_TYPE)
        }
    } else if tag == TOK_VAR_DECL {
        emit_var_decl(node, txt, tl, tc, tlens, tt)
    } else if tag == TOK_PARAM {
        emit_param(node, txt, tl, tc, tlens, tt)
    } else if tag == TOK_FN_DEF {
        emit_kw(node, txt, tl, tc, tlens, tt)
        emit_after_kw(node, txt, tl, tc, tlens, tt, TT_FUNCTION)
    } else if tag == TOK_STRUCT {
        emit_kw(node, txt, tl, tc, tlens, tt)
        emit_after_kw(node, txt, tl, tc, tlens, tt, TT_STRUCT)
    } else if tag == TOK_ENUM {
        emit_kw(node, txt, tl, tc, tlens, tt)
        emit_after_kw(node, txt, tl, tc, tlens, tt, TT_ENUM)
    } else if tag == TOK_NAMESPACE {
        emit_kw(node, txt, tl, tc, tlens, tt)
        emit_ns(node, txt, tl, tc, tlens, tt)
    } else if tag == TOK_EXTERN {
        emit_kw(node, txt, tl, tc, tlens, tt)
    } else if tag == TOK_IMPORT || tag == TOK_USING || tag == TOK_RETURN ||
              tag == TOK_IF || tag == TOK_WHILE || tag == TOK_FOR ||
              tag == TOK_BREAK || tag == TOK_CONTINUE || tag == TOK_SWITCH ||
              tag == TOK_PANIC || tag == TOK_UNSAFE_BLOCK {
        emit_kw(node, txt, tl, tc, tlens, tt)
    }
    // 递归子节点（FN_DEF/EXTERN 的子树以本声明位置为 void 跳过上下文）
    var nc = s_nchild[node]
    var base = s_coff[node]
    var cl = fnl
    var cc = fnc
    if tag == TOK_FN_DEF || tag == TOK_EXTERN {
        var l0 = s_lines[node] - 1
        var c0 = s_cols[node] - 1
        if l0 < 0 {
            l0 = 0
        }
        if c0 < 0 {
            c0 = 0
        }
        cl = l0
        cc = c0
    }
    var k: i64 = 0
    while k < nc {
        walk_tokens(s_children[base + k], txt, tl, tc, tlens, tt, cl, cc)
        k = k + 1
    }
}

// 令牌按 (行, 列) 排序（插入排序，令牌数有限）。
func sort_tokens(tl: table<i64>, tc: table<i64>, tlens: table<i64>, tt: table<i64>) {
    var n = len(tl)
    var i: i64 = 1
    while i < n {
        var j = i
        while j > 0 {
            var a = tl[j - 1]
            var b = tl[j]
            if b < a || (b == a && tc[j] < tc[j - 1]) {
                var tmp: i64 = tl[j]
                tl[j] = tl[j - 1]
                tl[j - 1] = tmp
                tmp = tc[j]
                tc[j] = tc[j - 1]
                tc[j - 1] = tmp
                tmp = tlens[j]
                tlens[j] = tlens[j - 1]
                tlens[j - 1] = tmp
                tmp = tt[j]
                tt[j] = tt[j - 1]
                tt[j - 1] = tmp
                j = j - 1
            } else {
                break
            }
        }
        i = i + 1
    }
}

// 令牌表 → LSP SemanticTokens delta 编码 JSON：{"data":[dLine,dStart,dLen,type,mod,...]}。
// 相对上一令牌差分：行差 + （同行动列差 / 跨行取新列）；同行同位去重（保留首个）。
func build_tokens_json(tl: table<i64>, tc: table<i64>, tlens: table<i64>, tt: table<i64>) -> string {
    var sb = string_builder()
    sb_append(sb, "{\"data\":[")
    var n = len(tl)
    var i: i64 = 0
    var pl: i64 = 0
    var pc: i64 = 0
    var pp_l: i64 = -1
    var pp_c: i64 = -1
    var first: bool = true
    while i < n {
        if tl[i] == pp_l && tc[i] == pp_c {
            i = i + 1
            continue
        }
        var dl: i64 = 0
        var ds: i64 = 0
        if first {
            dl = tl[i]
            ds = tc[i]
        } else {
            dl = tl[i] - pl
            if dl == 0 {
                ds = tc[i] - pc
            } else {
                ds = tc[i]
            }
        }
        if !first {
            sb_append(sb, ",")
        }
        first = false
        sb_append(sb, to_string(dl))
        sb_append(sb, ",")
        sb_append(sb, to_string(ds))
        sb_append(sb, ",")
        sb_append(sb, to_string(tlens[i]))
        sb_append(sb, ",")
        sb_append(sb, to_string(tt[i]))
        sb_append(sb, ",0")
        pl = tl[i]
        pc = tc[i]
        pp_l = tl[i]
        pp_c = tc[i]
        i = i + 1
    }
    sb_append(sb, "]}")
    return sb_build(sb)
}

// ==================== folding ====================

// 块型节点的 endLine（0 基）：节点最后一个内容子节点（跳过 -1 槽）的行 - 1；
// 若该子节点是 STMTLIST 则取其最后一个子节点的行 - 1；空 STMTLIST / 找不到
// 返回 -1（调用方以 startLine+1 兜底）。
func block_end_line(node: i64) -> i64 {
    var nc = s_nchild[node]
    var base = s_coff[node]
    var k = nc - 1
    while k >= 0 {
        var c = s_children[base + k]
        if c >= 0 {
            if s_tags[c] == TOK_STMTLIST {
                var nc2 = s_nchild[c]
                var base2 = s_coff[c]
                var j = nc2 - 1
                while j >= 0 {
                    var c2 = s_children[base2 + j]
                    if c2 >= 0 {
                        return s_lines[c2] - 1
                    }
                    j = j - 1
                }
                // 空 STMTLIST（如无 else 的 if 兜底体）：按"找不到"处理
                return -1
            }
            return s_lines[c] - 1
        }
        k = k - 1
    }
    return -1
}

// 递归收集折叠区间（块型节点 + 跨多行 + 起止行差 >= 1）。
func walk_fold(node: i64, sl: table<i64>, el: table<i64>) {
    if node < 0 {
        return
    }
    var tag = s_tags[node]
    if tag == TOK_FN_DEF || tag == TOK_STRUCT || tag == TOK_ENUM || tag == TOK_NAMESPACE ||
       tag == TOK_IF || tag == TOK_WHILE || tag == TOK_FOR || tag == TOK_SWITCH ||
       tag == TOK_TRY || tag == TOK_UNSAFE_BLOCK {
        var l0 = s_lines[node] - 1
        if l0 < 0 {
            l0 = 0
        }
        var e = block_end_line(node)
        if e < 0 {
            e = l0 + 1
        }
        if e - l0 >= 1 {
            table_push(sl, l0)
            table_push(el, e)
        }
    }
    var nc = s_nchild[node]
    var base = s_coff[node]
    var k: i64 = 0
    while k < nc {
        walk_fold(s_children[base + k], sl, el)
        k = k + 1
    }
}

// 区间按 startLine 排序（插入排序，稳定）。
func sort_ranges(sl: table<i64>, el: table<i64>) {
    var n = len(sl)
    var i: i64 = 1
    while i < n {
        var j = i
        while j > 0 && sl[j] < sl[j - 1] {
            var t = sl[j]
            sl[j] = sl[j - 1]
            sl[j - 1] = t
            t = el[j]
            el[j] = el[j - 1]
            el[j - 1] = t
            j = j - 1
        }
        i = i + 1
    }
}

// 区间表 → FoldingRange JSON 数组（同区间去重：相邻重复只留一个）。
func build_ranges_json(sl: table<i64>, el: table<i64>) -> string {
    var sb = string_builder()
    sb_append(sb, "[")
    var n = len(sl)
    var i: i64 = 0
    var ps: i64 = -1
    var pe: i64 = -1
    var first: bool = true
    while i < n {
        var s = sl[i]
        var e = el[i]
        if s == ps && e == pe {
            i = i + 1
            continue
        }
        if !first {
            sb_append(sb, ",")
        }
        first = false
        sb_append(sb, "{\"startLine\":")
        sb_append(sb, to_string(s))
        sb_append(sb, ",\"endLine\":")
        sb_append(sb, to_string(e))
        sb_append(sb, "}")
        ps = s
        pe = e
        i = i + 1
    }
    sb_append(sb, "]")
    return sb_build(sb)
}

// ==================== 公开接口 ====================

// 文档语义令牌：LSP SemanticTokens delta 编码 JSON。run_check 失败返回
// {"data":[]}。uri 供 server 后续按文档缓存使用（本版每次全量重算）。
pub func semantic_tokens(uri: string, txt: string, base_dir: string) -> string {
    var ok = an.run_check(txt, base_dir)
    if ok != 1 {
        return "{\"data\":[]}"
    }
    var tl = table_new_i64()
    var tc = table_new_i64()
    var tlens = table_new_i64()
    var tt = table_new_i64()
    walk_tokens(g_file_roots[0], txt, tl, tc, tlens, tt, -1, -1)
    sort_tokens(tl, tc, tlens, tt)
    return build_tokens_json(tl, tc, tlens, tt)
}

// 文档折叠区间：FoldingRange JSON 数组（0 基 startLine/endLine）。
// run_check 失败返回 []。
pub func folding_ranges(uri: string, txt: string, base_dir: string) -> string {
    var ok = an.run_check(txt, base_dir)
    if ok != 1 {
        return "[]"
    }
    var sl = table_new_i64()
    var el = table_new_i64()
    walk_fold(g_file_roots[0], sl, el)
    sort_ranges(sl, el)
    return build_ranges_json(sl, el)
}

}   // namespace tsp_tok
