type tie<logic>
// ============================================================================
// sigdoc.tie：tsp（tie Language Server）——signatureHelp + documentSymbol 模块
// 命名空间：tsp_sig
//
// · signature_help：在文档文本中从光标位置往回找最近的 '('（跳过字符串
//   字面量；只在本行及向上最多 2 行内搜索），取 '(' 前的标识符作为函数名，
//   查符号索引（当前文档优先，未命中跨文档查），命中且签名非空时生成
//   LSP SignatureHelp JSON：
//     {"signatures":[{"label":<sig>,"parameters":[{"label":"a"},...]}],
//      "activeSignature":0,"activeParameter":<N>}
//   · 参数段：从签名 '(' ')' 之间按 ',' 切分（段原样，不解析类型）
//   · activeParameter：光标与 '(' 之间不在字符串字面量内的逗号数（0 基）
// · doc_symbols：遍历文档符号索引（analyze.tie 的 sym_* 查询接口），生成
//   LSP DocumentSymbol[] JSON（kind 映射 + 1 基行列 → 0 基 range）。
//
// 本文件编译：随 server.tie 一起编译（server 主入口 import 本文件）或经
// probe_sigdoc.tie 单独编译验证。
// ============================================================================

import "./analyze.tie" as an
import "./protocol.tie" as proto

namespace tsp_sig {

// ---- 自足字符串/文本小工具 ----

// 行起始偏移（line 0 基；越界返回文本长度；line < 0 返回 0）。
pub func line_start(txt: string, line: i64) -> i64 {
    var off: i64 = 0
    var ln: i64 = 0
    while ln < line && off < len(txt) {
        while off < len(txt) && str_byte(txt, off) != 10 {
            off = off + 1
        }
        if off < len(txt) {
            off = off + 1  // 跳过 \n
        }
        ln = ln + 1
    }
    return off
}

// 子串 [start, end)（越界钳位）。
pub func substr(s: string, start: i64, end: i64) -> string {
    var a = start
    var b = end
    if a < 0 {
        a = 0
    }
    if b > len(s) {
        b = len(s)
    }
    if a >= b {
        return ""
    }
    var out: string = ""
    var i: i64 = a
    while i < b {
        out = out + str_char(s, i)
        i = i + 1
    }
    return out
}

// 统计字符串中的逗号数。
pub func count_commas(s: string) -> i64 {
    var n: i64 = 0
    var i: i64 = 0
    while i < len(s) {
        if str_char(s, i) == "," {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// 从签名文本取括号内参数段：'(' 与 ')' 之间按 ',' 切分（段原样，不解析类型）。
// 无 '(' / 括号内为空 → 返回空表。
pub func split_sig_params(sig: string) -> table<string> {
    var out = table_new_string()
    var open: i64 = -1
    var i: i64 = 0
    while i < len(sig) {
        if str_char(sig, i) == "(" {
            open = i
            break
        }
        i = i + 1
    }
    if open < 0 {
        return out
    }
    var close = len(sig)
    var j = open + 1
    while j < len(sig) {
        if str_char(sig, j) == ")" {
            close = j
            break
        }
        j = j + 1
    }
    var inner = substr(sig, open + 1, close)
    if len(inner) == 0 {
        return out
    }
    // 按 ',' 切分
    var cur: string = ""
    var k: i64 = 0
    while k < len(inner) {
        var c = str_char(inner, k)
        if c == "," {
            table_push(out, cur)
            cur = ""
        } else {
            cur = cur + c
        }
        k = k + 1
    }
    table_push(out, cur)
    return out
}

// ---- signature_help 内部辅助 ----

// 位置（line/character 均 0 基）→ 文件偏移（character 钳位到行尾）。
func pos_off(txt: string, line: i64, character: i64) -> i64 {
    var off = line_start(txt, line)
    var moved: i64 = 0
    while moved < character && off + moved < len(txt) && str_byte(txt, off + moved) != 10 {
        moved = moved + 1
    }
    return off + moved
}

// 在 [start, off) 中找最近（最后一个）不在字符串字面量内的 '('（简单实现：
// 字符串状态按 '"' 开关切换，不处理转义引号）。返回下标；未找到 -1。
func last_paren(txt: string, start: i64, off: i64) -> i64 {
    var paren: i64 = -1
    var in_str: bool = false
    var i = start
    while i < off {
        var c = str_char(txt, i)
        if c == "\"" {
            in_str = !in_str
        } else if c == "(" && !in_str {
            paren = i
        }
        i = i + 1
    }
    return paren
}

// 标识符字符（字母/数字/下划线）。
func is_idch(c: string) -> bool {
    var v = char_code(c)
    return (v >= 65 && v <= 90) || (v >= 97 && v <= 122) || (v >= 48 && v <= 57) || v == 95
}

// '(' 前标识符（允许 '(' 前空白；无标识符返回空串）。
func ident_before(txt: string, paren: i64) -> string {
    var i = paren - 1
    while i >= 0 && (str_char(txt, i) == " " || str_char(txt, i) == "\t") {
        i = i - 1
    }
    if i < 0 {
        return ""
    }
    var e = i
    while i >= 0 && is_idch(str_char(txt, i)) {
        i = i - 1
    }
    if i >= e {
        return ""
    }
    return substr(txt, i + 1, e + 1)
}

// 区间 [from, to) 内不在字符串字面量内的逗号数（字符串状态按 '"' 开关切换）。
func commas_between(txt: string, from: i64, to: i64) -> i64 {
    var n: i64 = 0
    var in_str: bool = false
    var i = from
    while i < to {
        var c = str_char(txt, i)
        if c == "\"" {
            in_str = !in_str
        } else if c == "," && !in_str {
            n = n + 1
        }
        i = i + 1
    }
    return n
}

// 查符号：当前文档优先；未命中跨文档（doc_count/doc_uri + find_sym_named）。
// 返回 (命中文档 uri, 符号下标)；未命中 ("", -1)。
func find_sym_any(uri: string, name: string) -> (string, i64) {
    var si = an.find_sym_named(uri, name)
    if si >= 0 {
        return (uri, si)
    }
    var n = an.doc_count()
    var i: i64 = 0
    while i < n {
        var du = an.doc_uri(i)
        if du != uri {
            var s2 = an.find_sym_named(du, name)
            if s2 >= 0 {
                return (du, s2)
            }
        }
        i = i + 1
    }
    return ("", -1)
}

// ---- 公开接口 ----

// signatureHelp：光标处调用签名提示。line/character 0 基。
// 未命中（无 '('、无函数名、符号未找到、签名为空）返回 "null"。
pub func signature_help(uri: string, txt: string, line: i64, character: i64) -> string {
    var off = pos_off(txt, line, character)
    // 只在本行及向上最多 2 行内找（line_start 对负行返回 0）
    var start = line_start(txt, line - 2)
    var paren = last_paren(txt, start, off)
    if paren < 0 {
        return "null"
    }
    var name = ident_before(txt, paren)
    if len(name) == 0 {
        return "null"
    }
    var (furi, si) = find_sym_any(uri, name)
    if si < 0 {
        return "null"
    }
    var sig = an.sym_sig(furi, si)
    if len(sig) == 0 {
        return "null"
    }
    // 参数段 → parameter JSON（label 原样）；先入表最后 join
    var params = split_sig_params(sig)
    var parts: table<string> = table_new_string()
    var k: i64 = 0
    while k < len(params) {
        table_push(parts, "{\"label\":" + proto.json_str(params[k]) + "}")
        k = k + 1
    }
    var pj: string = ""
    var m: i64 = 0
    while m < len(parts) {
        if m > 0 {
            pj = pj + ","
        }
        pj = pj + parts[m]
        m = m + 1
    }
    var active = commas_between(txt, paren + 1, off)
    return "{\"signatures\":[{\"label\":" + proto.json_str(sig) + ",\"parameters\":[" + pj +
           "]}],\"activeSignature\":0,\"activeParameter\":" + to_string(active) + "}"
}

// kind 字符串 → LSP DocumentSymbolKind 数字：
// func=12(Function) struct=23(Struct) enum=10(Enum) global=13(Variable)
// namespace=3(Namespace) extern=12(Function)；未知回退 12。
func kind_to_k(kind: string) -> i64 {
    if kind == "func" {
        return 12
    }
    if kind == "struct" {
        return 23
    }
    if kind == "enum" {
        return 10
    }
    if kind == "global" {
        return 13
    }
    if kind == "namespace" {
        return 3
    }
    if kind == "extern" {
        return 12
    }
    return 12
}

// documentSymbol：文档符号树（首版扁平数组）。符号行列 1 基 → range 0 基；
// end.character = start.character + len(name)。detail 仅函数填签名。
// 未索引 / 无符号返回 "[]"。
pub func doc_symbols(uri: string) -> string {
    var n = an.sym_count(uri)
    if n < 0 {
        return "[]"
    }
    var items: table<string> = table_new_string()
    var i: i64 = 0
    while i < n {
        var name = an.sym_name(uri, i)
        var kind = an.sym_kind(uri, i)
        var sig = an.sym_sig(uri, i)
        var l0 = an.sym_line(uri, i) - 1
        var c0 = an.sym_col(uri, i) - 1
        if l0 < 0 {
            l0 = 0
        }
        if c0 < 0 {
            c0 = 0
        }
        var k = kind_to_k(kind)
        var detail = ""
        if len(sig) > 0 {
            detail = ",\"detail\":" + proto.json_str(sig)
        }
        var rng = "{\"start\":{\"line\":" + to_string(l0) + ",\"character\":" + to_string(c0) +
                  "},\"end\":{\"line\":" + to_string(l0) + ",\"character\":" +
                  to_string(c0 + len(name)) + "}}"
        table_push(items, "{\"name\":" + proto.json_str(name) + ",\"kind\":" + to_string(k) +
                          detail + ",\"range\":" + rng + ",\"selectionRange\":" + rng + "}")
        i = i + 1
    }
    var out: string = "["
    var j: i64 = 0
    while j < len(items) {
        if j > 0 {
            out = out + ","
        }
        out = out + items[j]
        j = j + 1
    }
    out = out + "]"
    return out
}

}   // namespace tsp_sig
