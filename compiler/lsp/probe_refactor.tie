type tie<logic>
// ============================================================================
// probe_refactor.tie：tsp_ref（rename + documentHighlight + quickfix）探针
// （临时文件）p.6.9.10
// 编译：tiec compiler/lsp/probe_refactor.tie -o compiler/lsp/probe_refactor.exe
// 运行：直接执行 probe_refactor.exe；PROBE:PASS → exit 0，PROBE:FAIL → exit 1。
// 注意：g_cur_fn_name shim 已由 analyze.tie 文件顶层提供，此处不重复声明。
// ============================================================================

import "../frontend/parser.tie"
import "../frontend/semantic.tie"
import "./analyze.tie" as an
import "./refactor.tie" as tsp_ref

// 首个子串出现位置（未找到 -1）。码点级遍历（探针消息含中文）。
func find_str(hay: string, needle: string) -> i64 {
    var h = str_len(hay)
    var n = str_len(needle)
    if n == 0 {
        return 0
    }
    var i: i64 = 0
    while i + n <= h {
        var matched: bool = true
        var j: i64 = 0
        while j < n {
            if str_char(hay, i + j) != str_char(needle, j) {
                matched = false
                break
            }
            j = j + 1
        }
        if matched {
            return i
        }
        i = i + 1
    }
    return -1
}

// 统计子串出现次数（码点级）。
func count_sub(s: string, p: string) -> i64 {
    var n: i64 = 0
    var i: i64 = 0
    var sl = str_len(s)
    var pl = str_len(p)
    while i + pl <= sl {
        var matched: bool = true
        var j: i64 = 0
        while j < pl {
            if str_char(s, i + j) != str_char(p, j) {
                matched = false
                break
            }
            j = j + 1
        }
        if matched {
            n = n + 1
            i = i + pl
        } else {
            i = i + 1
        }
    }
    return n
}

func main() -> i64 {
    // 样例文档：add 声明在第 0 行；main 体内两处 add 调用
    // （第 2 行 `    var x = add(1, 2)` 的 add 在 0-based 列 12）
    var src = "func add(a: i64, b: i64) -> i64 { return a + b }\n" +
              "func main() {\n" +
              "    var x = add(1, 2)\n" +
              "    println(add(3, 4))\n" +
              "}\n"
    var ok: bool = true

    // 编译流水线：parse + semantic + 符号索引（rename/highlight 需要索引并入声明）
    var prc = parser.parse_ast(src)
    if prc != 0 {
        println("PROBE:FAIL parse_ast 失败: " + parser.ast_err_protocol())
        return 1
    }
    var sem = semantic.check_ast("")
    if find_str(sem, "ERR:") == 0 {
        println("PROBE:FAIL check_ast 失败: " + sem)
        return 1
    }
    var cnt = an.index_doc("rf://a")
    println("INDEXED=" + to_string(cnt))

    // ---- rename：光标在 add(1,2) 调用处的 add（0-based 行 2 字符 12）----
    // 期望 3 处编辑：2 处调用 + 1 处声明，newText 均为 "sum"
    var ren = tsp_ref.rename("rf://a", src, "", 2, 12, "sum")
    println("rename -> " + ren)
    if find_str(ren, "\"newText\":\"sum\"") < 0 {
        ok = false
        println("PROBE:FAIL rename 未包含 newText:\"sum\"")
    }
    var ecnt = count_sub(ren, "\"newText\"")
    println("rename 编辑数量 = " + to_string(ecnt) + "（期望 >= 3）")
    if ecnt < 3 {
        ok = false
        println("PROBE:FAIL rename 编辑数量不足")
    }

    // ---- highlight：同一光标位置 ----
    // 期望 >= 2 个位置（2 处调用 + 声明，均 kind=1）
    var hl = tsp_ref.highlight("rf://a", src, "", 2, 12)
    println("highlight -> " + hl)
    var hcnt = count_sub(hl, "\"range\"")
    println("highlight 位置数量 = " + to_string(hcnt) + "（期望 >= 2）")
    if hcnt < 2 {
        ok = false
        println("PROBE:FAIL highlight 位置数量不足")
    }
    if find_str(hl, "\"kind\":1") < 0 {
        ok = false
        println("PROBE:FAIL highlight 缺 kind:1")
    }

    // ---- quickfix：缺分号（消息含"期望 语句结束符"）----
    var qf = tsp_ref.quickfix("rf://a", src, "", 0, 0, "期望 语句结束符，实际是 标识符")
    println("quickfix(缺分号) -> " + qf)
    if find_str(qf, "插入分号") < 0 {
        ok = false
        println("PROBE:FAIL quickfix 缺分号未命中")
    }
    if find_str(qf, "\"newText\":\";\"") < 0 {
        ok = false
        println("PROBE:FAIL quickfix 缺分号 newText 非分号")
    }

    // ---- quickfix：未声明的变量（消息单引号内变量名）----
    var qf2 = tsp_ref.quickfix("rf://a", src, "", 1, 8, "未声明的变量 'y'")
    println("quickfix(未声明变量) -> " + qf2)
    if find_str(qf2, "声明局部变量 y") < 0 {
        ok = false
        println("PROBE:FAIL quickfix 未声明变量未命中")
    }
    if find_str(qf2, "\"newText\":\"var y = 0\\n\"") < 0 {
        ok = false
        println("PROBE:FAIL quickfix 未声明变量 newText 非预期")
    }

    // ---- quickfix：其它消息 → [] ----
    var qf3 = tsp_ref.quickfix("rf://a", src, "", 0, 0, "类型不匹配")
    println("quickfix(其它) -> " + qf3)
    if qf3 != "[]" {
        ok = false
        println("PROBE:FAIL quickfix 其它消息应返回 []")
    }

    if ok {
        println("PROBE:PASS")
        return 0
    }
    println("PROBE:FAIL")
    return 1
}
