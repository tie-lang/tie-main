type tie<logic>
// ============================================================================
// server.tie：tsp（tie Language Server）服务端主循环（tie 写，0-Rust）
// 命名空间：tsp_server
//
// 第一版范围（增量迭代，先打通握手 + 文档同步 + 基础诊断）：
//   · initialize / initialized / shutdown / exit（生命周期）
//   · textDocument/didOpen、didChange、didClose（文档同步 full）
//   · publishDiagnostics（浅层诊断：括号配对 / 字符串闭合 / 未定义变量 / 未定义函数）
//   · 其它方法（hover/completion/definition/...）返回空结果（客户端不报错）
//
// 客户端：editor/vscode-tie/（vscode-languageclient，命令默认 `tie --lsp`）。
// 本文件编译：tiec compiler/lsp/server.tie -o tsp.exe —— 由 driver --lsp 调用
// 或直接由 vscode 扩展配置绝对路径。
//
// 增量分析：文件级缓存（文本 + 浅层诊断），didChange 全量重算单文件。
// ============================================================================

import "../../std/stdio.tie" as stdio
import "../../std/json.tie" as json
import "./protocol.tie" as proto
using tsp_proto;

// ---- 文档状态 ----

// 打开的文档：uri → 文本（简单实现：平行表，首版 Open 文件数有限）。
var g_uris: table<string>
var g_texts: table<string>
var g_seq: i64 = 0          // notification/request 计数（诊断用 server 版本）

// ---- 字符串工具（本文件自足）----

func find_doc(uri: string) -> i64 {
    var i: i64 = 0
    while i < len(g_uris) {
        if g_uris[i] == uri {
            return i
        }
        i = i + 1
    }
    return -1
}

func set_doc(uri: string, txt: string) {
    var idx = find_doc(uri)
    if idx >= 0 {
        g_texts[idx] = txt
    } else {
        table_push(g_uris, uri)
        table_push(g_texts, txt)
    }
}

func get_doc(uri: string) -> string {
    var idx = find_doc(uri)
    if idx >= 0 {
        return g_texts[idx]
    }
    return ""
}

func remove_doc(uri: string) {
    var idx = find_doc(uri)
    if idx >= 0 {
        var i = idx
        while i < len(g_uris) - 1 {
            g_uris[i] = g_uris[i + 1]
            g_texts[i] = g_texts[i + 1]
            i = i + 1
        }
        if len(g_uris) > 0 {
            var newn = len(g_uris) - 1
            // tie 表无 pop：用截断语义——重新建表
            var nu = table_new_string()
            var nt = table_new_string()
            var k: i64 = 0
            while k < newn {
                table_push(nu, g_uris[k])
                table_push(nt, g_texts[k])
                k = k + 1
            }
            g_uris = nu
            g_texts = nt
        }
    }
}

// ---- 诊断（浅层分析）----

// 提取 JSON 参数的字符串字段（textDocument.uri / textDocument.text / line/text）。
// 用 std/json 的扁平访问。为第一版健壮性，直接子串查找（键在 JSON 中引号包裹）。
func json_field(s: string, key: string) -> string {
    var pat = "\"" + key + "\""
    var idx = str_find(s, pat)
    if idx < 0 {
        return ""
    }
    var i = idx + len(pat)
    // 跳过冒号与空白
    while i < len(s) {
        var c = str_char(s, i)
        if c == ":" {
            i = i + 1
            break
        }
        i = i + 1
    }
    while i < len(s) {
        var c = str_char(s, i)
        if c == " " || c == "\t" {
            i = i + 1
        } else {
            break
        }
    }
    if i >= len(s) {
        return ""
    }
    // 字符串值
    if str_char(s, i) == "\"" {
        var out: string = ""
        i = i + 1
        while i < len(s) {
            var c = str_char(s, i)
            if c == "\\" {
                i = i + 1
                if i < len(s) {
                    var e = str_char(s, i)
                    if e == "n" {
                        out = out + "\n"
                    } else if e == "t" {
                        out = out + "\t"
                    } else if e == "r" {
                        out = out + "\r"
                    } else if e == "\"" {
                        out = out + "\""
                    } else if e == "\\" {
                        out = out + "\\"
                    } else {
                        out = out + e
                    }
                }
            } else if c == "\"" {
                break
            } else {
                out = out + c
            }
            i = i + 1
        }
        return out
    }
    // 数字等（截到逗号/花括号）
    var out2: string = ""
    while i < len(s) && i < len(s) {
        var c = str_char(s, i)
        if c == "," || c == "}" || c == "]" {
            break
        }
        if c != " " && c != "\t" {
            out2 = out2 + c
        }
        i = i + 1
    }
    return out2
}

// 数值字段（position.line / position.character）。
func json_field_int(s: string, key: string) -> i64 {
    var v = json_field(s, key)
    return proto.parse_int_trim(v)
}

// 子串查找（首个出现位置；未找到 -1）。
func str_find(hay: string, needle: string) -> i64 {
    if len(needle) == 0 {
        return 0
    }
    var i: i64 = 0
    while i + len(needle) <= len(hay) {
        var matched = true
        var j: i64 = 0
        while j < len(needle) {
            if str_char(hay, i + j) != str_char(needle, j) {
                matched = false
                break
            }
            j = j + 1
        }
        if matched {
            return i
        }
        i = i + 1
    }
    return -1
}

// 行号 → 行起始偏移（0 基）；越界返回文本长度。
func line_start(txt: string, line: i64) -> i64 {
    var off: i64 = 0
    var ln: i64 = 0
    while ln < line && off < len(txt) {
        // 找换行
        while off < len(txt) && str_char(txt, off) != "\n" {
            off = off + 1
        }
        if off < len(txt) {
            off = off + 1  // 跳过 \n
        }
        ln = ln + 1
    }
    return off
}

// 位置（line, char）→ 文件偏移。
func pos_to_offset(txt: string, line: i64, character: i64) -> i64 {
    var off = line_start(txt, line)
    var moved: i64 = 0
    while moved < character && off + moved < len(txt) && str_char(txt, off + moved) != "\n" {
        moved = moved + 1
    }
    return off + moved
}

// 文件名（uri → basename，简单取最后 / 之后）。
func uri_basename(uri: string) -> string {
    var last: i64 = -1
    var i: i64 = 0
    while i < len(uri) {
        var c = str_char(uri, i)
        if c == "/" || c == "\\" {
            last = i
        }
        i = i + 1
    }
    if last >= 0 {
        return proto.substr_at(uri, last + 1, len(uri))
    }
    return uri
}

// ---- 浅层诊断：对一段代码返回诊断数组（JSON 串）----
// 第一版规则集：
//   1. 括号配对：() {} [] 未闭合 → error at 未闭合符位置
//   2. 字符串字面量：奇数个未转义双引号 → error
//   3. 注释/整行提取未定义变量：太浅会误报，先不做（留待 analyzer）。
//   仅做 1/2，保证零误报。

func diagnose(txt: string) -> string {
    var items = table_new_string()
    // ---- 规则 1：括号配对 ----
    var stack = table_new_i64()   // 括号字符码
    var stack_pos = table_new_i64()
    var i: i64 = 0
    var in_str = false
    while i < len(txt) {
        var c = char_code(str_char(txt, i))
        // 字符串/注释跳过
        if c == 34 {  // "
            in_str = !in_str
            i = i + 1
            continue
        }
        if in_str {
            i = i + 1
            continue
        }
        if c == 40 || c == 123 || c == 91 {  // ( { [
            table_push(stack, c)
            table_push(stack_pos, i)
        } else if c == 41 || c == 125 || c == 93 {  // ) } ]
            var open: i64 = 0
            if c == 41 {
                open = 40
            } else if c == 125 {
                open = 123
            } else {
                open = 91
            }
            if len(stack) > 0 && stack[len(stack) - 1] == open {
                if len(stack) > 0 {
                    var nstack = table_new_i64()
                    var nspos = table_new_i64()
                    var k: i64 = 0
                    while k < len(stack) - 1 {
                        table_push(nstack, stack[k])
                        table_push(nspos, stack_pos[k])
                        k = k + 1
                    }
                    stack = nstack
                    stack_pos = nspos
                }
            } else {
                // 不匹配闭合
                var (l, ch) = offset_to_pos(txt, i)
                table_push(items, diag_item(l, ch, ch + 1, 1, "unmatched closing bracket '" + str_char(txt, i) + "'", "error"))
            }
        }
        i = i + 1
    }
    // 未闭合
    while len(stack) > 0 {
        var p = stack_pos[len(stack) - 1]
        var (l0, c0) = offset_to_pos(txt, p)
        var chname: string = ""
        if stack[len(stack) - 1] == 40 {
            chname = "("
        } else if stack[len(stack) - 1] == 123 {
            chname = "{"
        } else {
            chname = "["
        }
        table_push(items, diag_item(l0, c0, c0 + 1, 1, "unclosed bracket '" + chname + "'", "error"))
        var ns = table_new_i64()
        var np = table_new_i64()
        var k: i64 = 0
        while k < len(stack) - 1 {
            table_push(ns, stack[k])
            table_push(np, stack_pos[k])
            k = k + 1
        }
        stack = ns
        stack_pos = np
    }
    // ---- 规则 2：未定义函数调用（保守：仅当调用名非任何声明/内置/关键字时）----
    // 声明收集：func / pub func / namespace / import ... as（别名视为已定义命名空间）。
    var decls = table_new_string()
    // 内置零参量关键字跳过（控制流/字面量），其余候选名——保守用「调用形态 name(」判定。
    var bu = table_new_string()
    table_push(bu, "if")
    table_push(bu, "else")
    table_push(bu, "while")
    table_push(bu, "for")
    table_push(bu, "switch")
    table_push(bu, "case")
    table_push(bu, "return")
    table_push(bu, "func")
    table_push(bu, "import")
    table_push(bu, "using")
    table_push(bu, "println")
    table_push(bu, "print")
    table_push(bu, "len")
    table_push(bu, "str_len")
    table_push(bu, "str_char")
    table_push(bu, "char_code")
    table_push(bu, "to_string")
    table_push(bu, "table_push")
    table_push(bu, "table_new")
    table_push(bu, "table_new_i64")
    table_push(bu, "table_new_string")
    table_push(bu, "exit")
    table_push(bu, "panic")
    table_push(bu, "time_now")
    table_push(bu, "time_now_ms")
    table_push(bu, "read_line")
    // 扫描声明
    var ti: i64 = 0
    while ti < len(txt) {
        // 行扫描：定位 func / pub func / namespace / import 关键字
        var line_end = ti
        while line_end < len(txt) && str_char(txt, line_end) != "\n" {
            line_end = line_end + 1
        }
        var line_txt = proto.substr_at(txt, ti, line_end)
        var lt = trim_str(line_txt)
        var keywords = table_new_string()
        table_push(keywords, "pub func")
        table_push(keywords, "func")
        table_push(keywords, "namespace")
        table_push(keywords, "import")
        var ki: i64 = 0
        while ki < len(keywords) {
            var kw = keywords[ki]
            var at = str_find(lt, kw)
            if at >= 0 {
                // 取关键字后第一个标识符
                var nm = id_after(lt, at + len(kw))
                if len(nm) > 0 {
                    table_push(decls, nm)
                    // 顶层/命名空间内均可。添加常见内置命名空间对象以减误报
                    if kw == "import" || kw == "namespace" {
                        table_push(bu, nm)
                    }
                }
            }
            ki = ki + 1
        }
        ti = line_end + 1
    }
    // 扫描调用形态：按行遍历（声明行 func/pub func/namespace/import 整行跳过），
    // 非声明行内的「标识符+(' 调用」检查是否声明/内置。
    var si2: i64 = 0
    while si2 < len(txt) {
        var l_end = si2
        while l_end < len(txt) && str_char(txt, l_end) != "\n" {
            l_end = l_end + 1
        }
        var line2 = proto.substr_at(txt, si2, l_end)
        var lt2 = trim_str(line2)
        // 声明行跳过
        var is_decl = false
        if str_find(lt2, "func ") == 0 || str_find(lt2, "pub func ") == 0 ||
           str_find(lt2, "namespace ") == 0 || str_find(lt2, "import ") == 0 {
            is_decl = true
        }
        if is_decl {
            si2 = l_end + 1
            continue
        }
        // 行内逐标识符查调用形态
        var k2: i64 = 0
        while k2 < len(line2) {
            var ch2 = str_char(line2, k2)
            if ch2 == "\"" {
                k2 = k2 + 1
                while k2 < len(line2) && str_char(line2, k2) != "\"" {
                    if str_char(line2, k2) == "\\" {
                        k2 = k2 + 1
                    }
                    k2 = k2 + 1
                }
                k2 = k2 + 1
                continue
            }
            if ch2 == "/" && k2 + 1 < len(line2) && str_char(line2, k2 + 1) == "/" {
                break
            }
            var is_id2 = is_idchar(ch2)
            if !is_id2 {
                k2 = k2 + 1
                continue
            }
            var id2 = k2
            while k2 < len(line2) {
                var chd = str_char(line2, k2)
                if is_idchar2(chd) {
                    k2 = k2 + 1
                } else {
                    break
                }
            }
            var nm2 = proto.substr_at(line2, id2, k2)
            var j2 = k2
            while j2 < len(line2) {
                var cj2 = str_char(line2, j2)
                if cj2 == " " || cj2 == "\t" {
                    j2 = j2 + 1
                } else {
                    break
                }
            }
            if j2 < len(line2) && str_char(line2, j2) == "(" {
                var known = is_in(nm2, decls) || is_in(nm2, bu)
                if !known {
                    var (fl, fc) = offset_to_pos(txt, si2 + id2)
                    table_push(items, diag_item(fl, fc, fc + len(nm2), 1,
                        "未定义函数 '" + nm2 + "'", "error"))
                }
            }
        }
        si2 = l_end + 1
    }
    // 组装 JSON 数组
    var out: string = "["
    var ii: i64 = 0
    while ii < len(items) {
        if ii > 0 {
            out = out + ","
        }
        out = out + items[ii]
        ii = ii + 1
    }
    out = out + "]"
    return out
}

// 偏移 → 行/列。
func offset_to_pos(txt: string, off: i64) -> (i64, i64) {
    var line: i64 = 0
    var col: i64 = 0
    var i: i64 = 0
    while i < off && i < len(txt) {
        if str_char(txt, i) == "\n" {
            line = line + 1
            col = 0
        } else {
            col = col + 1
        }
        i = i + 1
    }
    return (line, col)
}

// 名是否在表中（精确匹配）。
func is_in(name: string, tbl: table<string>) -> bool {
    var i: i64 = 0
    while i < len(tbl) {
        if tbl[i] == name {
            return true
        }
        i = i + 1
    }
    return false
}

// 单字符是否为标识符起始（字母/下划线；char_code 数值比较，避免字符串比较符不可用）。
func is_idchar(c: string) -> bool {
    var v = char_code(c)
    return (v >= 65 && v <= 90) || (v >= 97 && v <= 122) || v == 95
}

// 单字符是否为标识符延续（起始 + 数字）。
func is_idchar2(c: string) -> bool {
    var v = char_code(c)
    return (v >= 65 && v <= 90) || (v >= 97 && v <= 122) || (v >= 48 && v <= 57) || v == 95
}

// 去首尾空白。
func trim_str(s: string) -> string {
    var a: i64 = 0
    var b = len(s)
    while a < b {
        var c = str_char(s, a)
        if c == " " || c == "\t" || c == "\r" {
            a = a + 1
        } else {
            break
        }
    }
    while b > a {
        var c = str_char(s, b - 1)
        if c == " " || c == "\t" || c == "\r" {
            b = b - 1
        } else {
            break
        }
    }
    return proto.substr_at(s, a, b)
}

// 从 pos 开始取第一个标识符（字母/下划线开头，含数字/下划线继续）。
func id_after(s: string, pos: i64) -> string {
    var i = pos
    while i < len(s) {
        var c = str_char(s, i)
        if c == " " || c == "\t" {
            i = i + 1
        } else {
            break
        }
    }
    if i >= len(s) {
        return ""
    }
    var c0 = str_char(s, i)
    if !is_idchar(c0) {
        return ""
    }
    var j = i
    while j < len(s) {
        var c = str_char(s, j)
        if is_idchar2(c) {
            j = j + 1
        } else {
            break
        }
    }
    return proto.substr_at(s, i, j)
}

// 单条诊断 JSON。
func diag_item(line: i64, ch: i64, endch: i64, len: i64, msg: string, severity: string) -> string {
    return "{\"range\":{\"start\":{\"line\":" + to_string(line) + ",\"character\":" + to_string(ch) +
           "},\"end\":{\"line\":" + to_string(line) + ",\"character\":" + to_string(endch) + "}}," +
           "\"severity\":2,\"source\":\"tsp\",\"message\":" + proto.json_str(msg) + "}"
}

// ---- LSP 方法处理 ----

// 构造响应（request 需要 id 回显）。
func make_response(id: string, result: string) -> string {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":" + result + "}"
}

func make_error_response(id: string, errcode: i64, msg: string) -> string {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"error\":{\"code\":" + to_string(errcode) +
           ",\"message\":" + proto.json_str(msg) + "}}"
}

// 通知（无 id）。
func make_notification(method: string, parms: string) -> string {
    return "{\"jsonrpc\":\"2.0\",\"method\":" + proto.json_str(method) + ",\"params\":" + parms + "}"
}

// 诊断推送。
func publish_diagnostics(uri: string, diagnostics: string) {
    var parms = "{\"uri\":" + proto.json_str(uri) + ",\"diagnostics\":" + diagnostics + "}"
    var notif = make_notification("textDocument/publishDiagnostics", parms)
    proto.write_frame(notif)
}

// ---- 符号签名索引（hover 用）----
// 每个打开的文档维护：符号名表 + 签名表（平行）。didOpen/didChange 时重建。
var g_sym_uris: table<string>   // 并行 uri
var g_sym_names: table<string>  // 每文档：名称表（分号分隔，首版简化）
var g_sym_sigs: table<string>   // 每文档：签名表（平行分号分隔）

func rebuild_syms(uri: string, txt: string) {
    var idx = -1
    var i: i64 = 0
    while i < len(g_sym_uris) {
        if g_sym_uris[i] == uri {
            idx = i
            break
        }
        i = i + 1
    }
    var names: string = ""
    var sigs: string = ""
    // 逐行收集 func/pub func 签名
    var pos: i64 = 0
    while pos < len(txt) {
        var le = pos
        while le < len(txt) && str_char(txt, le) != "\n" {
            le = le + 1
        }
        var line_t = proto.substr_at(txt, pos, le)
        var lt = trim_str(line_t)
        var check = lt
        if str_find(check, "pub func ") == 0 {
            check = proto.substr_at(check, len("pub func "), len(check))
            var nm = id_after(check, 0)
            if len(nm) > 0 {
                // 签名行（到行尾）
                if len(names) > 0 {
                    names = names + ";"
                    sigs = sigs + ";"
                }
                names = names + nm
                sigs = sigs + line_t
            }
        } else if str_find(check, "func ") == 0 {
            check = proto.substr_at(check, len("func "), len(check))
            var nm2 = id_after(check, 0)
            if len(nm2) > 0 && str_find(nm2, "main") != 0 {
                if len(names) > 0 {
                    names = names + ";"
                    sigs = sigs + ";"
                }
                names = names + nm2
                sigs = sigs + line_t
            }
        }
        pos = le + 1
    }
    if idx >= 0 {
        g_sym_names[idx] = names
        g_sym_sigs[idx] = sigs
    } else {
        table_push(g_sym_uris, uri)
        table_push(g_sym_names, names)
        table_push(g_sym_sigs, sigs)
    }
}

// 查询某文档中 name 的签名（未找到返回空串）。
func find_sig(uri: string, name: string) -> string {
    var idx = -1
    var i: i64 = 0
    while i < len(g_sym_uris) {
        if g_sym_uris[i] == uri {
            idx = i
            break
        }
        i = i + 1
    }
    if idx < 0 {
        return ""
    }
    var names = g_sym_names[idx]
    var sigs = g_sym_sigs[idx]
    // 解析分号分隔
    var nparts = split_semi(names)
    var sparts = split_semi(sigs)
    var k: i64 = 0
    while k < len(nparts) {
        if nparts[k] == name && k < len(sparts) {
            return sparts[k]
        }
        k = k + 1
    }
    return ""
}

// 按分号切分（空串 → 空表）。
func split_semi(s: string) -> table<string> {
    var out = table_new_string()
    var cur: string = ""
    var i: i64 = 0
    while i < len(s) {
        var c = str_char(s, i)
        if c == ";" {
            table_push(out, cur)
            cur = ""
        } else {
            cur = cur + c
        }
        i = i + 1
    }
    table_push(out, cur)
    return out
}

// 某位置处的标识符（向前/向后扩展字母数字_）。
func ident_at(txt: string, off: i64) -> string {
    if off < 0 || off > len(txt) {
        return ""
    }
    var a = off
    while a > 0 && is_idchar2(str_char(txt, a - 1)) {
        a = a - 1
    }
    var b = off
    while b < len(txt) && is_idchar2(str_char(txt, b)) {
        b = b + 1
    }
    if a >= b {
        return ""
    }
    return proto.substr_at(txt, a, b)
}

// Hover 响应：查符号签名（简单文本，keptHover 第一版）+ 未定义函数诊断 hint。
func hover_result(uri: string, txt: string, line: i64, character: i64) -> string {
    var off = pos_to_offset(txt, line, character)
    var nm = ident_at(txt, off)
    if len(nm) == 0 {
        return "null"
    }
    var sig = find_sig(uri, nm)
    if len(sig) > 0 {
        var contents = "[{\"language\":\"tie\",\"value\":" + proto.json_str(sig) + "}]"
        return "{\"contents\":" + contents + "}"
    }
    return "null"
}

// ---- 主循环 ----

func main() -> i64 {
    var jsonrpc_ready = false
    while true {
        var (ok, body) = proto.read_frame()
        if ok == 0 {
            break  // EOF：正常退出
        }
        if len(body) == 0 {
            continue
        }
        // 提取 method / id
        var method = json_field(body, "method")
        var id = json_field(body, "id")
        var has_id = false
        if str_find(body, "\"id\"") >= 0 {
            has_id = true
        }
        var resp_id = id
        if len(resp_id) == 0 {
            resp_id = "null"
        }

        // 生命周期
        if method == "initialize" {
            // 服务器能力声明
            var caps = "{\"textDocumentSync\":1,\"hoverProvider\":true,\"completionProvider\":{\"triggerCharacters\":[\".\"]},\"definitionProvider\":true,\"referencesProvider\":true,\"renameProvider\":true}"
            var res = "{\"capabilities\":" + caps + ",\"serverInfo\":{\"name\":\"tsp\",\"version\":\"0.1.0\"}}"
            proto.write_frame(make_response(resp_id, res))
            jsonrpc_ready = true
        } else if method == "initialized" {
            // 客户端已初始化：无需响应
        } else if method == "shutdown" {
            proto.write_frame(make_response(resp_id, "null"))
        } else if method == "exit" {
            break
        }

        // 文档同步
        else if method == "textDocument/didOpen" {
            var uri = json_field(body, "uri")
            var txt = json_field(body, "text")
            if len(uri) > 0 {
                set_doc(uri, txt)
                rebuild_syms(uri, txt)
                var diags = diagnose(txt)
                publish_diagnostics(uri, diags)
            }
        } else if method == "textDocument/didChange" {
            var uri = json_field(body, "uri")
            var txt = json_field(body, "text")
            if len(uri) > 0 {
                set_doc(uri, txt)
                rebuild_syms(uri, txt)
                var diags = diagnose(txt)
                publish_diagnostics(uri, diags)
            }
        } else if method == "textDocument/didClose" {
            var uri = json_field(body, "uri")
            if len(uri) > 0 {
                remove_doc(uri)
                publish_diagnostics(uri, "[]")
            }
        }

        // hover：查文档签名索引
        else if method == "textDocument/hover" {
            var uri = json_field(body, "uri")
            var line = json_field_int(body, "line")
            var character = json_field_int(body, "character")
            var txt = get_doc(uri)
            var hr = hover_result(uri, txt, line, character)
            proto.write_frame(make_response(resp_id, hr))
        }

        // 通用空响应（hover 等首版返回空/null，客户端无副作用）
        else if has_id {
            proto.write_frame(make_response(resp_id, "null"))
        }
        // notification 无 id 且不认识 → 忽略
    }
    return 0
}