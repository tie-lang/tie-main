type tie<logic>
// ============================================================================
// server.tie：tsp（tie Language Server）服务端主循环（tie 写，0-Rust）
// 命名空间：tsp_server
//
// 当前范围（p.6.9.3/6.9.4/6.9.5 落地：编译器级分析，复用前端树）：
//   · initialize / initialized / shutdown / exit（生命周期）
//   · textDocument/didOpen、didChange、didClose（文档同步 full）
//   · publishDiagnostics（编译器级：词法/语法/语义错误 + 语义警告，见 analyze.tie）
//   · 符号索引 + import 图（跨文件分析基础，见 analyze.tie）
//   · hover（per-doc 签名索引）
//   · 其它方法（completion/definition/references/...）返回空结果（客户端不报错）
//
// 客户端：editor/vscode-tie/（vscode-languageclient，命令默认 `tie --lsp`）。
// 本文件编译：tiec compiler/lsp/server.tie -o tsp.exe —— 由 driver --lsp 调用
// 或直接由 vscode 扩展配置绝对路径。
//
// 增量分析：文件级指纹缓存（诊断 + ok 状态），didChange 全量重算单文件；
// 单文件错误隔离：坏文档只产生自身诊断，不崩服务。
// ============================================================================

import "../../std/stdio.tie" as stdio
import "./protocol.tie" as proto
import "./analyze.tie" as an
using tsp_proto;

// ---- 文档状态 ----

// 打开的文档：uri → 文本（简单实现：平行表，首版 Open 文件数有限）。
var g_uris: table<string>
var g_texts: table<string>
var g_seq: i64 = 0          // notification/request 计数（诊断用 server 版本）

// ---- 字符串工具（本文件自足）----

func find_doc(uri: string) -> i64 {
    var i: i64 = 0
    while i < len(g_uris) {
        if g_uris[i] == uri {
            return i
        }
        i = i + 1
    }
    return -1
}

func set_doc(uri: string, txt: string) {
    var idx = find_doc(uri)
    if idx >= 0 {
        g_texts[idx] = txt
    } else {
        table_push(g_uris, uri)
        table_push(g_texts, txt)
    }
}

func get_doc(uri: string) -> string {
    var idx = find_doc(uri)
    if idx >= 0 {
        return g_texts[idx]
    }
    return ""
}

func remove_doc(uri: string) {
    var idx = find_doc(uri)
    if idx >= 0 {
        var i = idx
        while i < len(g_uris) - 1 {
            g_uris[i] = g_uris[i + 1]
            g_texts[i] = g_texts[i + 1]
            i = i + 1
        }
        if len(g_uris) > 0 {
            var newn = len(g_uris) - 1
            // tie 表无 pop：用截断语义——重新建表
            var nu = table_new_string()
            var nt = table_new_string()
            var k: i64 = 0
            while k < newn {
                table_push(nu, g_uris[k])
                table_push(nt, g_texts[k])
                k = k + 1
            }
            g_uris = nu
            g_texts = nt
        }
    }
}

// ---- 诊断（浅层分析）----

// 提取 JSON 参数的字符串字段（textDocument.uri / textDocument.text / line/text）。
// 用 std/json 的扁平访问。为第一版健壮性，直接子串查找（键在 JSON 中引号包裹）。
func json_field(s: string, key: string) -> string {
    var pat = "\"" + key + "\""
    var idx = str_find(s, pat)
    if idx < 0 {
        return ""
    }
    var i = idx + len(pat)
    // 跳过冒号与空白
    while i < len(s) {
        var c = str_char(s, i)
        if c == ":" {
            i = i + 1
            break
        }
        i = i + 1
    }
    while i < len(s) {
        var c = str_char(s, i)
        if c == " " || c == "\t" {
            i = i + 1
        } else {
            break
        }
    }
    if i >= len(s) {
        return ""
    }
    // 字符串值
    if str_char(s, i) == "\"" {
        var out: string = ""
        i = i + 1
        while i < len(s) {
            var c = str_char(s, i)
            if c == "\\" {
                i = i + 1
                if i < len(s) {
                    var e = str_char(s, i)
                    if e == "n" {
                        out = out + "\n"
                    } else if e == "t" {
                        out = out + "\t"
                    } else if e == "r" {
                        out = out + "\r"
                    } else if e == "\"" {
                        out = out + "\""
                    } else if e == "\\" {
                        out = out + "\\"
                    } else {
                        out = out + e
                    }
                }
            } else if c == "\"" {
                break
            } else {
                out = out + c
            }
            i = i + 1
        }
        return out
    }
    // 数字等（截到逗号/花括号）
    var out2: string = ""
    while i < len(s) && i < len(s) {
        var c = str_char(s, i)
        if c == "," || c == "}" || c == "]" {
            break
        }
        if c != " " && c != "\t" {
            out2 = out2 + c
        }
        i = i + 1
    }
    return out2
}

// 数值字段（position.line / position.character）。
func json_field_int(s: string, key: string) -> i64 {
    var v = json_field(s, key)
    return proto.parse_int_trim(v)
}

// 子串查找（首个出现位置；未找到 -1）。
func str_find(hay: string, needle: string) -> i64 {
    if len(needle) == 0 {
        return 0
    }
    var i: i64 = 0
    while i + len(needle) <= len(hay) {
        var matched = true
        var j: i64 = 0
        while j < len(needle) {
            if str_char(hay, i + j) != str_char(needle, j) {
                matched = false
                break
            }
            j = j + 1
        }
        if matched {
            return i
        }
        i = i + 1
    }
    return -1
}

// 行号 → 行起始偏移（0 基）；越界返回文本长度。
func line_start(txt: string, line: i64) -> i64 {
    var off: i64 = 0
    var ln: i64 = 0
    while ln < line && off < len(txt) {
        // 找换行
        while off < len(txt) && str_char(txt, off) != "\n" {
            off = off + 1
        }
        if off < len(txt) {
            off = off + 1  // 跳过 \n
        }
        ln = ln + 1
    }
    return off
}

// 位置（line, char）→ 文件偏移。
func pos_to_offset(txt: string, line: i64, character: i64) -> i64 {
    var off = line_start(txt, line)
    var moved: i64 = 0
    while moved < character && off + moved < len(txt) && str_char(txt, off + moved) != "\n" {
        moved = moved + 1
    }
    return off + moved
}

// 文件名（uri → basename，简单取最后 / 之后）。
func uri_basename(uri: string) -> string {
    var last: i64 = -1
    var i: i64 = 0
    while i < len(uri) {
        var c = str_char(uri, i)
        if c == "/" || c == "\\" {
            last = i
        }
        i = i + 1
    }
    if last >= 0 {
        return proto.substr_at(uri, last + 1, len(uri))
    }
    return uri
}

// uri → 文档所在目录（import 相对路径解析基准，尾随 '/'，正斜杠）。
// 支持 file:/// 前缀与 Windows 盘符；非文件 uri（untitled: 等）返回 ""。
func uri_to_dir(uri: string) -> string {
    var p = uri
    if has_prefix_str(p, "file://") {
        p = proto.substr_at(p, len("file://"), len(p))
    }
    // 去前导 '/'（file:///F:/... → F:/...）
    while len(p) > 0 && (str_char(p, 0) == "/" || str_char(p, 0) == "\\") {
        p = proto.substr_at(p, 1, len(p))
    }
    var last: i64 = -1
    var i: i64 = 0
    while i < len(p) {
        var c = str_char(p, i)
        if c == "/" || c == "\\" {
            last = i
        }
        i = i + 1
    }
    if last < 0 {
        return ""
    }
    return proto.substr_at(p, 0, last + 1)
}

// 字符串前缀判定（server 自足版）。
func has_prefix_str(s: string, p: string) -> bool {
    if len(s) < len(p) {
        return false
    }
    var i: i64 = 0
    while i < len(p) {
        if str_char(s, i) != str_char(p, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// 单字符是否为标识符起始（字母/下划线；char_code 数值比较，避免字符串比较符不可用）。
func is_idchar(c: string) -> bool {
    var v = char_code(c)
    return (v >= 65 && v <= 90) || (v >= 97 && v <= 122) || v == 95
}

// 单字符是否为标识符延续（起始 + 数字）。
func is_idchar2(c: string) -> bool {
    var v = char_code(c)
    return (v >= 65 && v <= 90) || (v >= 97 && v <= 122) || (v >= 48 && v <= 57) || v == 95
}

// 去首尾空白。
func trim_str(s: string) -> string {
    var a: i64 = 0
    var b = len(s)
    while a < b {
        var c = str_char(s, a)
        if c == " " || c == "\t" || c == "\r" {
            a = a + 1
        } else {
            break
        }
    }
    while b > a {
        var c = str_char(s, b - 1)
        if c == " " || c == "\t" || c == "\r" {
            b = b - 1
        } else {
            break
        }
    }
    return proto.substr_at(s, a, b)
}

// 从 pos 开始取第一个标识符（字母/下划线开头，含数字/下划线继续）。
func id_after(s: string, pos: i64) -> string {
    var i = pos
    while i < len(s) {
        var c = str_char(s, i)
        if c == " " || c == "\t" {
            i = i + 1
        } else {
            break
        }
    }
    if i >= len(s) {
        return ""
    }
    var c0 = str_char(s, i)
    if !is_idchar(c0) {
        return ""
    }
    var j = i
    while j < len(s) {
        var c = str_char(s, j)
        if is_idchar2(c) {
            j = j + 1
        } else {
            break
        }
    }
    return proto.substr_at(s, i, j)
}

// ---- LSP 方法处理 ----

// 构造响应（request 需要 id 回显）。
func make_response(id: string, result: string) -> string {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":" + result + "}"
}

func make_error_response(id: string, errcode: i64, msg: string) -> string {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"error\":{\"code\":" + to_string(errcode) +
           ",\"message\":" + proto.json_str(msg) + "}}"
}

// 通知（无 id）。
func make_notification(method: string, parms: string) -> string {
    return "{\"jsonrpc\":\"2.0\",\"method\":" + proto.json_str(method) + ",\"params\":" + parms + "}"
}

// 诊断推送。
func publish_diagnostics(uri: string, diagnostics: string) {
    var parms = "{\"uri\":" + proto.json_str(uri) + ",\"diagnostics\":" + diagnostics + "}"
    var notif = make_notification("textDocument/publishDiagnostics", parms)
    proto.write_frame(notif)
}

// ---- 符号签名索引（hover 用）----
// 每个打开的文档维护：符号名表 + 签名表（平行）。didOpen/didChange 时重建。
var g_sym_uris: table<string>   // 并行 uri
var g_sym_names: table<string>  // 每文档：名称表（分号分隔，首版简化）
var g_sym_sigs: table<string>   // 每文档：签名表（平行分号分隔）

func rebuild_syms(uri: string, txt: string) {
    var idx = -1
    var i: i64 = 0
    while i < len(g_sym_uris) {
        if g_sym_uris[i] == uri {
            idx = i
            break
        }
        i = i + 1
    }
    var names: string = ""
    var sigs: string = ""
    // 逐行收集 func/pub func 签名
    var pos: i64 = 0
    while pos < len(txt) {
        var le = pos
        while le < len(txt) && str_char(txt, le) != "\n" {
            le = le + 1
        }
        var line_t = proto.substr_at(txt, pos, le)
        var lt = trim_str(line_t)
        var check = lt
        if str_find(check, "pub func ") == 0 {
            check = proto.substr_at(check, len("pub func "), len(check))
            var nm = id_after(check, 0)
            if len(nm) > 0 {
                // 签名行（到行尾）
                if len(names) > 0 {
                    names = names + ";"
                    sigs = sigs + ";"
                }
                names = names + nm
                sigs = sigs + line_t
            }
        } else if str_find(check, "func ") == 0 {
            check = proto.substr_at(check, len("func "), len(check))
            var nm2 = id_after(check, 0)
            if len(nm2) > 0 && str_find(nm2, "main") != 0 {
                if len(names) > 0 {
                    names = names + ";"
                    sigs = sigs + ";"
                }
                names = names + nm2
                sigs = sigs + line_t
            }
        }
        pos = le + 1
    }
    if idx >= 0 {
        g_sym_names[idx] = names
        g_sym_sigs[idx] = sigs
    } else {
        table_push(g_sym_uris, uri)
        table_push(g_sym_names, names)
        table_push(g_sym_sigs, sigs)
    }
}

// 查询某文档中 name 的签名（未找到返回空串）。
func find_sig(uri: string, name: string) -> string {
    var idx = -1
    var i: i64 = 0
    while i < len(g_sym_uris) {
        if g_sym_uris[i] == uri {
            idx = i
            break
        }
        i = i + 1
    }
    if idx < 0 {
        return ""
    }
    var names = g_sym_names[idx]
    var sigs = g_sym_sigs[idx]
    // 解析分号分隔
    var nparts = split_semi(names)
    var sparts = split_semi(sigs)
    var k: i64 = 0
    while k < len(nparts) {
        if nparts[k] == name && k < len(sparts) {
            return sparts[k]
        }
        k = k + 1
    }
    return ""
}

// 按分号切分（空串 → 空表）。
func split_semi(s: string) -> table<string> {
    var out = table_new_string()
    var cur: string = ""
    var i: i64 = 0
    while i < len(s) {
        var c = str_char(s, i)
        if c == ";" {
            table_push(out, cur)
            cur = ""
        } else {
            cur = cur + c
        }
        i = i + 1
    }
    table_push(out, cur)
    return out
}

// 某位置处的标识符（向前/向后扩展字母数字_）。
func ident_at(txt: string, off: i64) -> string {
    if off < 0 || off > len(txt) {
        return ""
    }
    var a = off
    while a > 0 && is_idchar2(str_char(txt, a - 1)) {
        a = a - 1
    }
    var b = off
    while b < len(txt) && is_idchar2(str_char(txt, b)) {
        b = b + 1
    }
    if a >= b {
        return ""
    }
    return proto.substr_at(txt, a, b)
}

// Hover 响应：查符号签名（简单文本，keptHover 第一版）+ 未定义函数诊断 hint。
func hover_result(uri: string, txt: string, line: i64, character: i64) -> string {
    var off = pos_to_offset(txt, line, character)
    var nm = ident_at(txt, off)
    if len(nm) == 0 {
        return "null"
    }
    var sig = find_sig(uri, nm)
    if len(sig) > 0 {
        var contents = "[{\"language\":\"tie\",\"value\":" + proto.json_str(sig) + "}]"
        return "{\"contents\":" + contents + "}"
    }
    return "null"
}

// ---- 主循环 ----

func main() -> i64 {
    var jsonrpc_ready = false
    while true {
        var (ok, body) = proto.read_frame()
        if ok == 0 {
            break  // EOF：正常退出
        }
        if len(body) == 0 {
            continue
        }
        // 提取 method / id
        var method = json_field(body, "method")
        var id = json_field(body, "id")
        var has_id = false
        if str_find(body, "\"id\"") >= 0 {
            has_id = true
        }
        var resp_id = id
        if len(resp_id) == 0 {
            resp_id = "null"
        }

        // 生命周期
        if method == "initialize" {
            // 服务器能力声明
            var caps = "{\"textDocumentSync\":1,\"hoverProvider\":true,\"completionProvider\":{\"triggerCharacters\":[\".\"]},\"definitionProvider\":true,\"referencesProvider\":true,\"renameProvider\":true}"
            var res = "{\"capabilities\":" + caps + ",\"serverInfo\":{\"name\":\"tsp\",\"version\":\"0.1.0\"}}"
            proto.write_frame(make_response(resp_id, res))
            jsonrpc_ready = true
        } else if method == "initialized" {
            // 客户端已初始化：无需响应
        } else if method == "shutdown" {
            proto.write_frame(make_response(resp_id, "null"))
        } else if method == "exit" {
            break
        }

        // 文档同步：p.6.9.3/6.9.5 编译流水线分析（复用编译器前端）
        else if method == "textDocument/didOpen" {
            var uri = json_field(body, "uri")
            var txt = json_field(body, "text")
            if len(uri) > 0 {
                set_doc(uri, txt)
                var base = uri_to_dir(uri)
                var (diags, ok) = an.analyze(uri, txt, base)
                if ok == 1 {
                    an.index_doc(uri)
                }
                rebuild_syms(uri, txt)
                publish_diagnostics(uri, diags)
            }
        } else if method == "textDocument/didChange" {
            var uri = json_field(body, "uri")
            var txt = json_field(body, "text")
            if len(uri) > 0 {
                set_doc(uri, txt)
                var base2 = uri_to_dir(uri)
                var (diags2, ok2) = an.analyze(uri, txt, base2)
                if ok2 == 1 {
                    an.index_doc(uri)
                }
                rebuild_syms(uri, txt)
                publish_diagnostics(uri, diags2)
            }
        } else if method == "textDocument/didClose" {
            var uri = json_field(body, "uri")
            if len(uri) > 0 {
                remove_doc(uri)
                an.drop_doc(uri)
                publish_diagnostics(uri, "[]")
            }
        }

        // hover：查文档签名索引
        else if method == "textDocument/hover" {
            var uri = json_field(body, "uri")
            var line = json_field_int(body, "line")
            var character = json_field_int(body, "character")
            var txt = get_doc(uri)
            var hr = hover_result(uri, txt, line, character)
            proto.write_frame(make_response(resp_id, hr))
        }

        // 通用空响应（hover 等首版返回空/null，客户端无副作用）
        else if has_id {
            proto.write_frame(make_response(resp_id, "null"))
        }
        // notification 无 id 且不认识 → 忽略
    }
    return 0
}