type tie<logic>
// ============================================================================
// server.tie：tsp（tie Language Server）服务端主循环（tie 写，0-Rust）
// 命名空间：tsp_server
//
// 当前范围（p.6.9.3/6.9.4/6.9.5 落地：编译器级分析，复用前端树）：
//   · initialize / initialized / shutdown / exit（生命周期）
//   · textDocument/didOpen、didChange、didClose（文档同步 full）
//   · publishDiagnostics（编译器级：词法/语法/语义错误 + 语义警告，见 analyze.tie）
//   · 符号索引 + import 图（跨文件分析基础，见 analyze.tie）
//   · hover（per-doc 签名索引）
//   · 其它方法（completion/definition/references/...）返回空结果（客户端不报错）
//
// 客户端：editor/vscode-tie/（vscode-languageclient，命令默认 `tie --lsp`）。
// 本文件编译：tiec compiler/lsp/server.tie -o tsp.exe —— 由 driver --lsp 调用
// 或直接由 vscode 扩展配置绝对路径。
//
// 增量分析：文件级指纹缓存（诊断 + ok 状态），didChange 全量重算单文件；
// 单文件错误隔离：坏文档只产生自身诊断，不崩服务。
// ============================================================================

import "../../std/stdio.tie" as stdio
import "./protocol.tie" as proto
import "./analyze.tie" as an
import "./completion.tie" as tsp_comp
import "./nav.tie" as tsp_nav
import "./sigdoc.tie" as tsp_sig
import "./tokens.tie" as tsp_tok
import "./refactor.tie" as tsp_ref
import "./format.tie" as tsp_fmt
using tsp_proto;

// ---- 文档状态 ----

// 打开的文档：uri → 文本（简单实现：平行表，首版 Open 文件数有限）。
var g_uris: table<string>
var g_texts: table<string>
var g_seq: i64 = 0          // notification/request 计数（诊断用 server 版本）

// ---- 字符串工具（本文件自足）----

func find_doc(uri: string) -> i64 {
    var i: i64 = 0
    while i < len(g_uris) {
        if g_uris[i] == uri {
            return i
        }
        i = i + 1
    }
    return -1
}

func set_doc(uri: string, txt: string) {
    var idx = find_doc(uri)
    if idx >= 0 {
        g_texts[idx] = txt
    } else {
        table_push(g_uris, uri)
        table_push(g_texts, txt)
    }
}

func get_doc(uri: string) -> string {
    var idx = find_doc(uri)
    if idx >= 0 {
        return g_texts[idx]
    }
    return ""
}

func remove_doc(uri: string) {
    var idx = find_doc(uri)
    if idx >= 0 {
        var i = idx
        while i < len(g_uris) - 1 {
            g_uris[i] = g_uris[i + 1]
            g_texts[i] = g_texts[i + 1]
            i = i + 1
        }
        if len(g_uris) > 0 {
            var newn = len(g_uris) - 1
            // tie 表无 pop：用截断语义——重新建表
            var nu = table_new_string()
            var nt = table_new_string()
            var k: i64 = 0
            while k < newn {
                table_push(nu, g_uris[k])
                table_push(nt, g_texts[k])
                k = k + 1
            }
            g_uris = nu
            g_texts = nt
        }
    }
}

// ---- 诊断（浅层分析）----

// 提取 JSON 参数的字符串字段（textDocument.uri / textDocument.text / line/text）。
// 字节级扫描（str_byte O(1)）：str_char 逐码点遍历大 body 是 O(n²) 卡死
//（97KB 文档 40s）；无转义时 str_sub_bytes 一次拷贝，稀有转义才逐字节组装。
func json_field(s: string, key: string) -> string {
    var pat = "\"" + key + "\""
    var idx = str_find(s, pat)
    if idx < 0 {
        return ""
    }
    var sl = len(s)
    var i = idx + len(pat)
    // 跳过冒号与空白（字节码：':'=58 空格=32 制表=9）
    while i < sl {
        var c = str_byte(s, i)
        if c == 58 {
            i = i + 1
            break
        }
        i = i + 1
    }
    while i < sl {
        var c = str_byte(s, i)
        if c == 32 || c == 9 {
            i = i + 1
        } else {
            break
        }
    }
    if i >= sl {
        return ""
    }
    // 字符串值（'"'=34 '\\'=92）
    if str_byte(s, i) == 34 {
        var start = i + 1
        var j = start
        var has_esc = false
        while j < sl {
            var b0 = str_byte(s, j)
            if b0 == 92 {
                has_esc = true
                j = j + 2
            } else if b0 == 34 {
                break
            } else {
                j = j + 1
            }
        }
        if !has_esc {
            return str_sub_bytes(s, start, j)
        }
        // 转义处理（少见）：逐字节组装（原样字节 + 常见转义解码）
        var sb = string_builder()
        var k = start
        while k < j {
            var b0 = str_byte(s, k)
            if b0 == 92 {
                k = k + 1
                if k < j {
                    var e = str_byte(s, k)
                    if e == 110 {
                        sb_append(sb, "\n")
                    } else if e == 116 {
                        sb_append(sb, "\t")
                    } else if e == 114 {
                        sb_append(sb, "\r")
                    } else if e == 34 {
                        sb_append(sb, "\"")
                    } else if e == 92 {
                        sb_append(sb, "\\")
                    } else {
                        sb_append_byte(sb, e)
                    }
                }
            } else {
                sb_append_byte(sb, b0)
            }
            k = k + 1
        }
        return sb_build(sb)
    }
    // 数字等（截到逗号/花括号）
    var out2: string = ""
    var j2 = i
    while j2 < sl {
        var c2 = str_byte(s, j2)
        if c2 == 44 || c2 == 125 || c2 == 93 {
            break
        }
        if c2 != 32 && c2 != 9 {
            out2 = out2 + str_from_code(c2)
        }
        j2 = j2 + 1
    }
    return out2
}

// 数值字段（position.line / position.character）。
func json_field_int(s: string, key: string) -> i64 {
    var v = json_field(s, key)
    return proto.parse_int_trim(v)
}

// 子串查找（首个出现位置；未找到 -1）。**字节级**（str_byte O(1)；
// str_char 本运行时单次 ~360µs，逐码点查找不可用）。
func str_find(hay: string, needle: string) -> i64 {
    var hl = len(hay)
    var nl = len(needle)
    if nl == 0 {
        return 0
    }
    var i: i64 = 0
    while i + nl <= hl {
        var matched = true
        var j: i64 = 0
        while j < nl {
            if str_byte(hay, i + j) != str_byte(needle, j) {
                matched = false
                break
            }
            j = j + 1
        }
        if matched {
            return i
        }
        i = i + 1
    }
    return -1
}

// 行号 → 行起始偏移（0 基）；越界返回文本长度。
func line_start(txt: string, line: i64) -> i64 {
    var off: i64 = 0
    var ln: i64 = 0
    while ln < line && off < len(txt) {
        // 找换行（str_byte O(1)，str_char 逐码点扫描大文本 O(n²)）
        while off < len(txt) && str_byte(txt, off) != 10 {
            off = off + 1
        }
        if off < len(txt) {
            off = off + 1  // 跳过 \n
        }
        ln = ln + 1
    }
    return off
}

// 位置（line, char）→ 文件偏移。
func pos_to_offset(txt: string, line: i64, character: i64) -> i64 {
    var off = line_start(txt, line)
    var moved: i64 = 0
    while moved < character && off + moved < len(txt) && str_byte(txt, off + moved) != 10 {
        moved = moved + 1
    }
    return off + moved
}

// 文件名（uri → basename，简单取最后 / 之后）。
func uri_basename(uri: string) -> string {
    var last: i64 = -1
    var i: i64 = 0
    while i < len(uri) {
        var c = str_byte(uri, i)
        if c == 47 || c == 92 {
            last = i
        }
        i = i + 1
    }
    if last >= 0 {
        return proto.substr_at(uri, last + 1, len(uri))
    }
    return uri
}

// uri → 文档所在目录（import 相对路径解析基准，尾随 '/'，正斜杠）。
// 支持 file:/// 前缀与 Windows 盘符；非文件 uri（untitled: 等）返回 ""。
func uri_to_dir(uri: string) -> string {
    var p = uri
    if has_prefix_str(p, "file://") {
        p = proto.substr_at(p, len("file://"), len(p))
    }
    // 去前导 '/'（file:///F:/... → F:/...）
    while len(p) > 0 && (str_byte(p, 0) == 47 || str_byte(p, 0) == 92) {
        p = proto.substr_at(p, 1, len(p))
    }
    var last: i64 = -1
    var i: i64 = 0
    while i < len(p) {
        var c = str_byte(p, i)
        if c == 47 || c == 92 {
            last = i
        }
        i = i + 1
    }
    if last < 0 {
        return ""
    }
    return proto.substr_at(p, 0, last + 1)
}

// 字符串前缀判定（server 自足版；字节级）。
func has_prefix_str(s: string, p: string) -> bool {
    if len(s) < len(p) {
        return false
    }
    var i: i64 = 0
    while i < len(p) {
        if str_byte(s, i) != str_byte(p, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// 字节是否标识符起始（字母/下划线）。
func is_idbyte(v: i64) -> bool {
    return (v >= 65 && v <= 90) || (v >= 97 && v <= 122) || v == 95
}

// 字节是否标识符延续（起始 + 数字）。
func is_idbyte2(v: i64) -> bool {
    return (v >= 65 && v <= 90) || (v >= 97 && v <= 122) || (v >= 48 && v <= 57) || v == 95
}

// 去首尾空白（字节级）。
func trim_str(s: string) -> string {
    var a: i64 = 0
    var b = len(s)
    while a < b {
        var c = str_byte(s, a)
        if c == 32 || c == 9 || c == 13 {
            a = a + 1
        } else {
            break
        }
    }
    while b > a {
        var c = str_byte(s, b - 1)
        if c == 32 || c == 9 || c == 13 {
            b = b - 1
        } else {
            break
        }
    }
    return proto.substr_at(s, a, b)
}

// 从 pos 开始取第一个标识符（字母/下划线开头，含数字/下划线继续；字节级）。
func id_after(s: string, pos: i64) -> string {
    var i = pos
    while i < len(s) {
        var c = str_byte(s, i)
        if c == 32 || c == 9 {
            i = i + 1
        } else {
            break
        }
    }
    if i >= len(s) {
        return ""
    }
    if !is_idbyte(str_byte(s, i)) {
        return ""
    }
    var j = i
    while j < len(s) {
        if is_idbyte2(str_byte(s, j)) {
            j = j + 1
        } else {
            break
        }
    }
    return proto.substr_at(s, i, j)
}

// ---- LSP 方法处理 ----

// 构造响应（request 需要 id 回显）。
func make_response(id: string, result: string) -> string {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":" + result + "}"
}

func make_error_response(id: string, errcode: i64, msg: string) -> string {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"error\":{\"code\":" + to_string(errcode) +
           ",\"message\":" + proto.json_str(msg) + "}}"
}

// 通知（无 id）。
func make_notification(method: string, parms: string) -> string {
    return "{\"jsonrpc\":\"2.0\",\"method\":" + proto.json_str(method) + ",\"params\":" + parms + "}"
}

// 诊断推送。
func publish_diagnostics(uri: string, diagnostics: string) {
    var parms = "{\"uri\":" + proto.json_str(uri) + ",\"diagnostics\":" + diagnostics + "}"
    var notif = make_notification("textDocument/publishDiagnostics", parms)
    proto.write_frame(notif)
}

// ---- 符号签名索引（hover 用）----
// 每个打开的文档维护：符号名表 + 签名表（平行）。didOpen/didChange 时重建。
var g_sym_uris: table<string>   // 并行 uri
var g_sym_names: table<string>  // 每文档：名称表（分号分隔，首版简化）
var g_sym_sigs: table<string>   // 每文档：签名表（平行分号分隔）

func rebuild_syms(uri: string, txt: string) {
    var idx = -1
    var i: i64 = 0
    while i < len(g_sym_uris) {
        if g_sym_uris[i] == uri {
            idx = i
            break
        }
        i = i + 1
    }
    // string_builder 线性组装（`+` 累积对千级函数行是 O(n²)）
    var sb_names = string_builder()
    var sb_sigs = string_builder()
    var first: bool = true
    // 逐行收集 func/pub func 签名
    var pos: i64 = 0
    while pos < len(txt) {
        var le = pos
        while le < len(txt) && str_byte(txt, le) != 10 {
            le = le + 1
        }
        var line_t = proto.substr_at(txt, pos, le)
        var lt = trim_str(line_t)
        var check = lt
        if str_find(check, "pub func ") == 0 {
            check = proto.substr_at(check, len("pub func "), len(check))
            var nm = id_after(check, 0)
            if len(nm) > 0 {
                if !first {
                    sb_append(sb_names, ";")
                    sb_append(sb_sigs, ";")
                }
                first = false
                sb_append(sb_names, nm)
                sb_append(sb_sigs, line_t)
            }
        } else if str_find(check, "func ") == 0 {
            check = proto.substr_at(check, len("func "), len(check))
            var nm2 = id_after(check, 0)
            if len(nm2) > 0 && str_find(nm2, "main") != 0 {
                if !first {
                    sb_append(sb_names, ";")
                    sb_append(sb_sigs, ";")
                }
                first = false
                sb_append(sb_names, nm2)
                sb_append(sb_sigs, line_t)
            }
        }
        pos = le + 1
    }
    var names = sb_build(sb_names)
    var sigs = sb_build(sb_sigs)
    if idx >= 0 {
        g_sym_names[idx] = names
        g_sym_sigs[idx] = sigs
    } else {
        table_push(g_sym_uris, uri)
        table_push(g_sym_names, names)
        table_push(g_sym_sigs, sigs)
    }
}

// 查询某文档中 name 的签名（未找到返回空串）。
func find_sig(uri: string, name: string) -> string {
    var idx = -1
    var i: i64 = 0
    while i < len(g_sym_uris) {
        if g_sym_uris[i] == uri {
            idx = i
            break
        }
        i = i + 1
    }
    if idx < 0 {
        return ""
    }
    var names = g_sym_names[idx]
    var sigs = g_sym_sigs[idx]
    // 解析分号分隔
    var nparts = split_semi(names)
    var sparts = split_semi(sigs)
    var k: i64 = 0
    while k < len(nparts) {
        if nparts[k] == name && k < len(sparts) {
            return sparts[k]
        }
        k = k + 1
    }
    return ""
}

// 按分号切分（空串 → 空表）。
func split_semi(s: string) -> table<string> {
    var out = table_new_string()
    var cur: string = ""
    var i: i64 = 0
    while i < len(s) {
        var c = str_char(s, i)
        if c == ";" {
            table_push(out, cur)
            cur = ""
        } else {
            cur = cur + c
        }
        i = i + 1
    }
    table_push(out, cur)
    return out
}

// 某位置处的标识符（向前/向后扩展字母数字_；字节级）。
func ident_at(txt: string, off: i64) -> string {
    if off < 0 || off > len(txt) {
        return ""
    }
    var a = off
    while a > 0 && is_idbyte2(str_byte(txt, a - 1)) {
        a = a - 1
    }
    var b = off
    while b < len(txt) && is_idbyte2(str_byte(txt, b)) {
        b = b + 1
    }
    if a >= b {
        return ""
    }
    return proto.substr_at(txt, a, b)
}

// Hover 响应：优先索引签名（AST 重建，多行签名可靠），回退行扫描签名。
func hover_result(uri: string, txt: string, line: i64, character: i64) -> string {
    var off = pos_to_offset(txt, line, character)
    var nm = ident_at(txt, off)
    if len(nm) == 0 {
        return "null"
    }
    var sig = ""
    var si = an.find_sym_named(uri, nm)
    if si >= 0 {
        sig = an.sym_sig(uri, si)
    }
    if len(sig) == 0 {
        sig = find_sig(uri, nm)
    }
    if len(sig) > 0 {
        var contents = "[{\"language\":\"tie\",\"value\":" + proto.json_str(sig) + "}]"
        return "{\"contents\":" + contents + "}"
    }
    return "null"
}

// ---- 主循环 ----

func main() -> i64 {
    var jsonrpc_ready = false
    while true {
        var (ok, body) = proto.read_frame()
        if ok == 0 {
            break  // EOF：正常退出
        }
        if len(body) == 0 {
            continue
        }
        // 提取 method / id
        var method = json_field(body, "method")
        var id = json_field(body, "id")
        var has_id = false
        if str_find(body, "\"id\"") >= 0 {
            has_id = true
        }
        var resp_id = id
        if len(resp_id) == 0 {
            resp_id = "null"
        }

        // 生命周期
        if method == "initialize" {
            // 服务器能力声明（p.6.9.6-6.9.11：补全/定义/引用/签名/大纲/语义令牌/折叠/重命名/高亮/修复/格式化）
            var legend = "[\"namespace\",\"type\",\"class\",\"enum\",\"interface\",\"struct\",\"typeParameter\",\"parameter\",\"variable\",\"property\",\"enumMember\",\"event\",\"function\",\"method\",\"macro\",\"keyword\",\"modifier\",\"comment\",\"string\",\"number\",\"regexp\",\"operator\",\"decorator\"]"
            var caps = "{\"textDocumentSync\":1,\"hoverProvider\":true,\"completionProvider\":{\"triggerCharacters\":[\".\"]},\"definitionProvider\":true,\"referencesProvider\":true,\"signatureHelpProvider\":{\"triggerCharacters\":[\"(\",\",\"]},\"documentSymbolProvider\":true,\"renameProvider\":true,\"documentHighlightProvider\":true,\"codeActionProvider\":true,\"documentFormattingProvider\":true,\"foldingRangeProvider\":true,\"semanticTokensProvider\":{\"legend\":{\"tokenTypes\":" + legend + ",\"tokenModifiers\":[]},\"full\":true}}"
            var res = "{\"capabilities\":" + caps + ",\"serverInfo\":{\"name\":\"tsp\",\"version\":\"0.3.0\"}}"
            proto.write_frame(make_response(resp_id, res))
            jsonrpc_ready = true
        } else if method == "initialized" {
            // 客户端已初始化：无需响应
        } else if method == "shutdown" {
            proto.write_frame(make_response(resp_id, "null"))
        } else if method == "exit" {
            break
        }

        // 文档同步：p.6.9.3/6.9.5 编译流水线分析（复用编译器前端）
        else if method == "textDocument/didOpen" {
            var uri = json_field(body, "uri")
            var txt = json_field(body, "text")
            if len(uri) > 0 {
                set_doc(uri, txt)
                var base = uri_to_dir(uri)
                var (diags, ok) = an.analyze(uri, txt, base)
                if ok == 1 {
                    an.index_doc(uri)
                }
                rebuild_syms(uri, txt)
                publish_diagnostics(uri, diags)
            }
        } else if method == "textDocument/didChange" {
            var uri = json_field(body, "uri")
            var txt = json_field(body, "text")
            if len(uri) > 0 {
                set_doc(uri, txt)
                var base2 = uri_to_dir(uri)
                var (diags2, ok2) = an.analyze(uri, txt, base2)
                if ok2 == 1 {
                    an.index_doc(uri)
                }
                rebuild_syms(uri, txt)
                publish_diagnostics(uri, diags2)
            }
        } else if method == "textDocument/didClose" {
            var uri = json_field(body, "uri")
            if len(uri) > 0 {
                remove_doc(uri)
                an.drop_doc(uri)
                publish_diagnostics(uri, "[]")
            }
        }

        // hover：查文档签名索引（优先索引签名，回退行扫描）
        else if method == "textDocument/hover" {
            var uri = json_field(body, "uri")
            var line = json_field_int(body, "line")
            var character = json_field_int(body, "character")
            var txt = get_doc(uri)
            var hr = hover_result(uri, txt, line, character)
            proto.write_frame(make_response(resp_id, hr))
        }

        // 补全：符号表 + 关键字 + 内置（p.6.9.6）
        else if method == "textDocument/completion" {
            var uri = json_field(body, "uri")
            var line = json_field_int(body, "line")
            var character = json_field_int(body, "character")
            var txt = get_doc(uri)
            var cr = tsp_comp.complete(uri, txt, line, character)
            proto.write_frame(make_response(resp_id, cr))
        }

        // 跳转定义（p.6.9.7）
        else if method == "textDocument/definition" {
            var uri = json_field(body, "uri")
            var line = json_field_int(body, "line")
            var character = json_field_int(body, "character")
            var txt = get_doc(uri)
            var dr = tsp_nav.definition(uri, txt, uri_to_dir(uri), line, character)
            proto.write_frame(make_response(resp_id, dr))
        }

        // 引用查找（p.6.9.7）
        else if method == "textDocument/references" {
            var uri = json_field(body, "uri")
            var line = json_field_int(body, "line")
            var character = json_field_int(body, "character")
            var txt = get_doc(uri)
            var inc = false
            var incs = json_field(body, "includeDeclaration")
            if incs == "true" {
                inc = true
            }
            var rr = tsp_nav.references(uri, txt, uri_to_dir(uri), line, character, inc)
            proto.write_frame(make_response(resp_id, rr))
        }

        // 签名帮助（p.6.9.8）
        else if method == "textDocument/signatureHelp" {
            var uri = json_field(body, "uri")
            var line = json_field_int(body, "line")
            var character = json_field_int(body, "character")
            var txt = get_doc(uri)
            var sr = tsp_sig.signature_help(uri, txt, line, character)
            proto.write_frame(make_response(resp_id, sr))
        }

        // 文档符号大纲（p.6.9.8）
        else if method == "textDocument/documentSymbol" {
            var uri = json_field(body, "uri")
            var dsr = tsp_sig.doc_symbols(uri)
            proto.write_frame(make_response(resp_id, dsr))
        }

        // 语义令牌（p.6.9.9）
        else if method == "textDocument/semanticTokens/full" {
            var uri = json_field(body, "uri")
            var txt = get_doc(uri)
            var tr = tsp_tok.semantic_tokens(uri, txt, uri_to_dir(uri))
            proto.write_frame(make_response(resp_id, tr))
        }

        // 折叠范围（p.6.9.9）
        else if method == "textDocument/foldingRange" {
            var uri = json_field(body, "uri")
            var txt = get_doc(uri)
            var fr = tsp_tok.folding_ranges(uri, txt, uri_to_dir(uri))
            proto.write_frame(make_response(resp_id, fr))
        }

        // 重命名（p.6.9.10）
        else if method == "textDocument/rename" {
            var uri = json_field(body, "uri")
            var line = json_field_int(body, "line")
            var character = json_field_int(body, "character")
            var new_name = json_field(body, "newName")
            var txt = get_doc(uri)
            var rr2 = tsp_ref.rename(uri, txt, uri_to_dir(uri), line, character, new_name)
            proto.write_frame(make_response(resp_id, rr2))
        }

        // 符号出现高亮（p.6.9.10）
        else if method == "textDocument/documentHighlight" {
            var uri = json_field(body, "uri")
            var line = json_field_int(body, "line")
            var character = json_field_int(body, "character")
            var txt = get_doc(uri)
            var hr2 = tsp_ref.highlight(uri, txt, uri_to_dir(uri), line, character)
            proto.write_frame(make_response(resp_id, hr2))
        }

        // 代码操作/快速修复（p.6.9.10）：取首个诊断的 range.start 与 message
        else if method == "textDocument/codeAction" {
            var uri = json_field(body, "uri")
            var line = json_field_int(body, "line")
            var character = json_field_int(body, "character")
            var msg = json_field(body, "message")
            var txt = get_doc(uri)
            var qr = tsp_ref.quickfix(uri, txt, uri_to_dir(uri), line, character, msg)
            proto.write_frame(make_response(resp_id, qr))
        }

        // 文档格式化（p.6.9.11）
        else if method == "textDocument/formatting" {
            var uri = json_field(body, "uri")
            var txt = get_doc(uri)
            var fr2 = tsp_fmt.format(uri, txt)
            proto.write_frame(make_response(resp_id, fr2))
        }

        // 通用空响应（未实现方法返回 null，客户端无副作用）
        else if has_id {
            proto.write_frame(make_response(resp_id, "null"))
        }
        // notification 无 id 且不认识 → 忽略
    }
    return 0
}