type tie<logic>
// ============================================================================
// probe_comp.tie：tsp completion 模块探针（p.6.9.6）——临时文件
// 验证：
//   1. 空词缀（光标 (0,5)）→ 全部候选，含 "add"（kind 3）与 "Point"（kind 22）
//   2. 点触发（"util." 后）→ 含 "helper"
//   3. 前缀过滤（词缀 "ad"）→ 仅 add 相关
// 编译运行：tiec compiler/lsp/probe_comp.tie -o compiler/lsp/probe_comp.exe
// 打印 PROBE:PASS / PROBE:FAIL 并 exit(0/1)。
// ============================================================================

import "../frontend/parser.tie"
import "../frontend/semantic.tie"
import "./analyze.tie" as an
import "./completion.tie" as tsp_comp
// 注意：g_cur_fn_name shim 已由 analyze.tie 文件顶层提供（前端树跨层全局，
// 此处不重复声明——重复声明会报 E00242 全局变量重复定义）。

func has_pfx(s: string, p: string) -> bool {
    if len(s) < len(p) {
        return false
    }
    var i: i64 = 0
    while i < len(p) {
        if str_char(s, i) != str_char(p, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// 首个子串出现位置（未找到 -1）。
func find_str(hay: string, needle: string) -> i64 {
    if len(needle) == 0 {
        return 0
    }
    var i: i64 = 0
    while i + len(needle) <= len(hay) {
        var matched = true
        var j: i64 = 0
        while j < len(needle) {
            if str_char(hay, i + j) != str_char(needle, j) {
                matched = false
                break
            }
            j = j + 1
        }
        if matched {
            return i
        }
        i = i + 1
    }
    return -1
}

func main() -> i64 {
    var src = "func add(a: i64, b: i64) -> i64 {\n    return a + b\n}\n" +
              "struct Point {\n    var x: i64\n}\n" +
              "enum Color {\n    Red\n}\n" +
              "var g_x: i64 = 0\n" +
              "namespace util {\n" +
              "    func helper() -> i64 {\n" +
              "        return 0\n" +
              "    }\n" +
              "}\n"
    var prc = parser.parse_ast(src)
    if prc < 0 {
        println("PROBE:FAIL parse_ast " + parser.ast_err_protocol())
        exit(1)
    }
    var sem = semantic.check_ast("")
    if has_pfx(sem, "ERR:") {
        println("PROBE:FAIL check_ast " + sem)
        exit(1)
    }
    var cnt = an.index_doc("probe://a")
    println("INDEXED=" + to_string(cnt))
    var ok = true

    // 1. 空词缀（光标 (0,5)，line 0 = "func add(...)" 行）→ 全部候选
    var r1 = tsp_comp.complete("probe://a", src, 0, 5)
    println("C1=" + r1)
    if find_str(r1, "{\"label\":\"add\",\"kind\":3") < 0 {
        println("FAIL: C1 缺 add(kind3)")
        ok = false
    }
    if find_str(r1, "{\"label\":\"Point\",\"kind\":22") < 0 {
        println("FAIL: C1 缺 Point(kind22)")
        ok = false
    }

    // 2. 点触发："util." 后补全 → 含 "helper"（label=点后部分）
    var r2 = tsp_comp.complete("probe://a", "util.", 0, 5)
    println("C2=" + r2)
    if find_str(r2, "\"helper\"") < 0 {
        println("FAIL: C2 缺 helper")
        ok = false
    }

    // 3. 前缀过滤：词缀 "ad" → 仅 add 相关
    var r3 = tsp_comp.complete("probe://a", "ad", 0, 2)
    println("C3=" + r3)
    if find_str(r3, "\"add\"") < 0 {
        println("FAIL: C3 缺 add")
        ok = false
    }
    if find_str(r3, "\"Point\"") >= 0 || find_str(r3, "\"Color\"") >= 0 ||
       find_str(r3, "\"g_x\"") >= 0 || find_str(r3, "\"util\"") >= 0 {
        println("FAIL: C3 混入其它符号")
        ok = false
    }
    if find_str(r3, "\"if\"") >= 0 || find_str(r3, "\"else\"") >= 0 ||
       find_str(r3, "\"println\"") >= 0 || find_str(r3, "\"table\"") >= 0 {
        println("FAIL: C3 混入关键字/内置")
        ok = false
    }

    if ok {
        println("PROBE:PASS")
        exit(0)
    }
    println("PROBE:FAIL")
    exit(1)
    return 0
}
