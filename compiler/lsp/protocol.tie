type tie<class>
// ============================================================================
// protocol.tie：tsp（tie Language Server）——LSP 协议层（JSON-RPC 帧编解码）
// 命名空间：tsp_proto
//
// LSP = JSON-RPC over stdio：
//   · 每个消息 = 帧头 `Content-Length: <N>\r\n` + 空行 `\r\n` + N 字节 JSON body
//   · body = JSON-RPC 消息：{jsonrpc,id,method,params} / {jsonrpc,id,result} /
//             {jsonrpc,id,error:{code,message}}
//
// 实现：
//   · 帧读：stdio.read_bytes 逐字节读（阻塞至 EOF），解析 Content-Length 头
//   · 帧写：stdio.write_str 原样写（低层 fd，顺序精确）
//   · JSON 生成：tie 侧手写字符串（响应体可控、简单），解析用 std/json
//
// 本层只做传输与编解码，不涉业务。业务在 server.tie / analyze.tie。
// ============================================================================

import "../../std/stdio.tie" as stdio
import "../../std/json.tie" as json

namespace tsp_proto {

// ---- 帧读取 ----

// 从 stdin 读一个 LSP 帧，返回 (ok, body)。ok=0：EOF（无更多输入）。
// 读取逻辑：逐字节累积头部直至 \r\n\r\n，解析 Content-Length，再读 body。
// 注意 tie 无字节流 peek，这里用 read_bytes(1) 逐字节（LSP 头短，可接受）。
pub func read_frame() -> (i64, string) {
    var header: table<i64> = table_new_i64()
    // 读至 "\r\n\r\n"（连续 4 字节）
    var state: i64 = 0  // 0=普通 1=收到\r 2=收到\r\n 3=收到\r\n\r
    while true {
        var b = stdio.read_bytes(1)
        if len(b) == 0 {
            // EOF：什么都没读到过 → 正常退出（ok=0）；读到过一半 → 截断帧错误
            if len(header) == 0 {
                return (0, "")
            }
            return (1, "")
        }
        var c = b[0] & 0xFF
        table_push(header, c)
        if state == 0 {
            if c == 13 {
                state = 1
            }
        } else if state == 1 {
            if c == 10 {
                state = 2
            } else {
                state = 0
            }
        } else if state == 2 {
            if c == 13 {
                state = 3
            } else {
                state = 0
            }
        } else {
            if c == 10 {
                break
            }
            state = 0
        }
    }
    // 解析 Content-Length
    var clen: i64 = 0
    var i: i64 = 0
    var h = bytes_to_str(header)
    var lines = split_lines(h)
    var li: i64 = 0
    while li < len(lines) {
        var ln = lines[li]
        if starts_with_ci(ln, "Content-Length:") {
            clen = parse_int_trim(substr_after(ln, ":"))
        }
        li = li + 1
    }
    if clen <= 0 {
        return (1, "")
    }
    // 读 body
    var body_bytes: table<i64> = table_new_i64()
    var got: i64 = 0
    while got < clen {
        var chunk = stdio.read_bytes(clen - got)
        if len(chunk) == 0 {
            break
        }
        var ci: i64 = 0
        while ci < len(chunk) {
            table_push(body_bytes, chunk[ci] & 0xFF)
            ci = ci + 1
        }
        got = got + len(chunk)
    }
    return (1, bytes_to_str(body_bytes))
}

// ---- 帧写入 ----

// 构造并写出一个 JSON-RPC 消息体（字符串），自动加 Content-Length 头。
pub func write_frame(body: string) {
    var hdr = "Content-Length: " + to_string(len(body)) + "\r\n\r\n"
    stdio.write_str(hdr)
    stdio.write_str(body)
}

// ---- 字符串小工具（本层自足，避免依赖 std/string 全量）----

func bytes_to_str(b: table<i64>) -> string {
    var out: string = ""
    var i: i64 = 0
    while i < len(b) {
        out = out + str_from_code(b[i] & 0xFF)
        i = i + 1
    }
    return out
}

func split_lines(s: string) -> table<string> {
    var out = table_new_string()
    var cur: string = ""
    var i: i64 = 0
    while i < len(s) {
        var c = str_char(s, i)
        if c == "\n" {
            table_push(out, cur)
            cur = ""
        } else if c != "\r" {
            cur = cur + c
        }
        i = i + 1
    }
    table_push(out, cur)
    return out
}

func starts_with_ci(s: string, p: string) -> bool {
    if len(s) < len(p) {
        return false
    }
    var i: i64 = 0
    while i < len(p) {
        var a = str_char(s, i)
        var b = str_char(p, i)
        if to_lower(a) != to_lower(b) {
            return false
        }
        i = i + 1
    }
    return true
}

func to_lower(c: string) -> string {
    var v = char_code(c)
    if v >= 65 && v <= 90 {
        return str_from_code(v + 32)
    }
    return c
}

func substr_after(s: string, p: string) -> string {
    var i: i64 = 0
    while i < len(s) {
        if str_char(s, i) == str_char(p, 0) {
            var j = i + 1
            if j <= len(s) {
                return substr_at(s, j, len(s))
            }
        }
        i = i + 1
    }
    return s
}

// 取 [start, end) 子串（start/end 可越界钳位）。
pub func substr_at(s: string, start: i64, end: i64) -> string {
    var a = start
    var b = end
    if a < 0 {
        a = 0
    }
    if b > len(s) {
        b = len(s)
    }
    if a >= b {
        return ""
    }
    var out: string = ""
    var i: i64 = a
    while i < b {
        out = out + str_char(s, i)
        i = i + 1
    }
    return out
}

// 解析整数字符串（含前导/尾随空白，纯 ASCII 十进制；非数字返回 0）。
pub func parse_int_trim(s: string) -> i64 {
    var t: string = ""
    var i: i64 = 0
    while i < len(s) {
        var c = str_char(s, i)
        if c != " " && c != "\t" {
            t = t + c
        }
        i = i + 1
    }
    if len(t) == 0 {
        return 0
    }
    var v: i64 = 0
    var j: i64 = 0
    while j < len(t) {
        var digit = char_code(str_char(t, j)) - 48
        if digit < 0 || digit > 9 {
            break
        }
        v = v * 10 + digit
        j = j + 1
    }
    return v
}

// ---- JSON 构造快捷（LSP 响应体大多是简单结构，手写字符串足够）----

// JSON 字符串转义（" 与 \ 与控制字符）。
pub func json_str(s: string) -> string {
    var out: string = "\""
    var i: i64 = 0
    while i < len(s) {
        var c = str_char(s, i)
        if c == "\"" {
            out = out + "\\\""
        } else if c == "\\" {
            out = out + "\\\\"
        } else if c == "\n" {
            out = out + "\\n"
        } else if c == "\r" {
            out = out + "\\r"
        } else if c == "\t" {
            out = out + "\\t"
        } else {
            out = out + c
        }
        i = i + 1
    }
    out = out + "\""
    return out
}

// 数字 → JSON 字面量（int 直接）。
pub func json_int(v: i64) -> string {
    return to_string(v)
}

}   // namespace tsp_proto