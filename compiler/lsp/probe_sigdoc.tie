type tie<logic>
// ============================================================================
// probe_sigdoc.tie：sigdoc（signatureHelp + documentSymbol，p.6.9.8）探针
//
// 验收：
//   · signature_help：光标在 `add(1,` 的逗号后（第 2 行 0 基、character 18），
//     返回 JSON 的 label 含 "func add"、activeSignature=0、activeParameter=1
//   · doc_symbols：返回数组含 name=add（kind 12）与 name=main
// 全部断言通过打印 PROBE:PASS 并 exit 0；任一失败打印 PROBE:FAIL 并 exit 1。
//
// 编译：tiec compiler/lsp/probe_sigdoc.tie -o compiler/lsp/probe_sigdoc.exe
// ============================================================================

import "../frontend/parser.tie"
import "../frontend/semantic.tie"
import "./analyze.tie" as an
import "./sigdoc.tie" as tsp_sig

// 子串查找（首个子串出现位置；未找到 -1）。本文件自足（str_find 非内置）。
func find_sub(hay: string, needle: string) -> i64 {
    if len(needle) == 0 {
        return 0
    }
    var i: i64 = 0
    while i + len(needle) <= len(hay) {
        var matched: bool = true
        var j: i64 = 0
        while j < len(needle) {
            if str_char(hay, i + j) != str_char(needle, j) {
                matched = false
                break
            }
            j = j + 1
        }
        if matched {
            return i
        }
        i = i + 1
    }
    return -1
}

// 子串包含判定。
func has(s: string, sub: string) -> bool {
    return find_sub(s, sub) >= 0
}

func main() -> i64 {
    // 样例文档：add 定义在首行，main 在第 2 行调用 add(1, 2)
    var src = "func add(a: i64, b: i64) -> i64 { return a + b }\n" +
              "func main() {\n" +
              "    var x = add(1, 2)\n" +
              "}\n"
    var prc = parser.parse_ast(src)
    if prc < 0 {
        println("PROBE:FAIL parse_ast")
        return 1
    }
    var sem = semantic.check_ast("")
    if has(sem, "ERR:") {
        println("PROBE:FAIL check_ast: " + sem)
        return 1
    }
    var cnt = an.index_doc("sig://a")
    println("indexed: " + to_string(cnt) + " symbols")

    // 光标在 `add(1,` 的逗号后：
    // 第 2 行（0 基）文本 "    var x = add(1, 2)"
    //   'add' 的 '(' 在 character 15，逗号在 17 → 逗号后 = character 18
    var sh = tsp_sig.signature_help("sig://a", src, 2, 18)
    println("SIGHELP: " + sh)

    var ok: bool = true
    if !has(sh, "func add") {
        ok = false
        println("  FAIL: sighelp 缺 'func add'")
    }
    if !has(sh, "\"activeSignature\":0") {
        ok = false
        println("  FAIL: sighelp 缺 activeSignature:0")
    }
    if !has(sh, "\"activeParameter\":1}") {
        ok = false
        println("  FAIL: sighelp 缺 activeParameter:1")
    }

    var ds = tsp_sig.doc_symbols("sig://a")
    println("DOCSYMS: " + ds)

    if !has(ds, "\"name\":\"add\"") {
        ok = false
        println("  FAIL: docsyms 缺 name=add")
    }
    if !has(ds, "\"kind\":12") {
        ok = false
        println("  FAIL: docsyms 缺 kind:12")
    }
    if !has(ds, "\"name\":\"main\"") {
        ok = false
        println("  FAIL: docsyms 缺 name=main")
    }

    if !ok {
        println("PROBE:FAIL")
        return 1
    }
    println("PROBE:PASS")
    return 0
}
