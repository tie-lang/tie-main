type tie<class>
// compiler/frontend/diagcode.tie —— 诊断标号中央（p.6.9.15）
// ============================================================
// 职责：给 tiec 全部错误/警告挂 C# 式标号（error[E#####] / warning[W#####]）。
//   - 错误标号：消息归一化折叠（ASCII 运行 → '%'）后查生成目录
//     （diagcode_cat.gen.tie，scripts/gen-diagcodes.ps1 生成），exact 优先、
//     前缀规则兜底（插值消息动态尾不参与精确匹配）；
//   - 警告标号：核心消息（编译器发射点逐字一致）精确查表；
//   - 输出格式（用户定稿）：error[E#####] @行:列: 消息名；期望 x；实际 y；提示。
//     warning[W#####] @行:列: 消息名；潜在影响与处理建议。
//
// 归一化定义（与 scripts/gen-diagcodes.ps1 Fold-Ascii 完全一致）：
//   按码点遍历，码点在 0x21..0x7E 的连续运行折叠为单个 '%'；其余码点原样保留。
//   tie 侧按 UTF-8 字节遍历等价（ASCII 字节 == 码点；非 ASCII 字节原样拷贝）。
//   注意：str_len() 是码点数，字节数用 len()（内置）。
//
// 依赖：仅 diagcode_cat.gen.tie（leaf，无 import）。调用方：driver/error_driver。

import "./diagcode_cat.gen.tie"

// ---------- 警告目录全局状态（懒构建；核心消息按字节升序） ----------
var diag_w_keys: table<string>;   // 核心消息（发射点逐字一致，升序）
var diag_w_codes: table<string>;
var diag_w_names: table<string>;
var diag_w_tips: table<string>;

namespace diagcode {

// ---------- 字节级工具（自包含；避免与调用方同名冲突） ----------
// 取子串 [a, b)（字节级）。
func dg_slice(s: string, a: i64, b: i64) -> string {
    var sb = string_builder()
    var i: i64 = a
    while i < b {
        sb_append_byte(sb, str_byte(s, i))
        i = i + 1
    }
    return sb_build(sb)
}

// sub 在 s 中首次出现的字节偏移；未找到 -1。
func dg_find(s: string, sub: string) -> i64 {
    var n: i64 = len(s)
    var m: i64 = len(sub)
    if m == 0 {
        return 0
    }
    if m > n {
        return -1
    }
    var i: i64 = 0
    while i <= n - m {
        var j: i64 = 0
        var matched: bool = true
        while j < m && matched {
            if str_byte(s, i + j) != str_byte(sub, j) {
                matched = false
            }
            j = j + 1
        }
        if matched {
            return i
        }
        i = i + 1
    }
    return -1
}

// s 是否以 prefix 开头（字节级）。
func dg_starts(s: string, prefix: string) -> bool {
    var n: i64 = len(s)
    var m: i64 = len(prefix)
    if n < m {
        return false
    }
    var i: i64 = 0
    while i < m {
        if str_byte(s, i) != str_byte(prefix, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// 去掉尾部全角 '：'（EF BC 9A）/ 半角 ':' / 空白。
func dg_trim_tail_colon(s: string) -> string {
    var n: i64 = len(s)
    var end: i64 = n
    while end > 0 {
        if end >= 3 {
            var b0 = str_byte(s, end - 3)
            var b1 = str_byte(s, end - 2)
            var b2 = str_byte(s, end - 1)
            if b0 == 0xEF && b1 == 0xBC && b2 == 0x9A {
                end = end - 3
                continue
            }
        }
        var b = str_byte(s, end - 1)
        if b == 58 || b == 32 || b == 9 {
            end = end - 1
        } else {
            break
        }
    }
    return dg_slice(s, 0, end)
}

// ---------- 归一化与标号查询 ----------

// 归一化折叠（定义见头注释）：ASCII(0x20..0x7E，含空格) 运行 → '%'。
pub func normalize(msg: string) -> string {
    var sb = string_builder()
    var n: i64 = len(msg)
    var i: i64 = 0
    var folded: bool = false
    while i < n {
        var b = str_byte(msg, i)
        if b >= 32 && b <= 126 {
            if !folded {
                sb_append(sb, "%")
                folded = true
            }
        } else {
            folded = false
            sb_append_byte(sb, b)
        }
        i = i + 1
    }
    return sb_build(sb)
}

// 精确查表（二分）；未命中 ""。
func exact_of(norm: string) -> string {
    return diagcat.lookup(norm)
}

// 前缀规则：最长命中（归一化消息以某前缀开头）。
func prefix_of(norm: string) -> string {
    var best: string = ""
    var i: i64 = 0
    while i < diagcat.pfx_count() {
        var p = diagcat.pfx_key(i)
        if dg_starts(norm, p) {
            if len(p) > len(best) {
                best = diagcat.pfx_code(i)
            }
        }
        i = i + 1
    }
    return best
}

// 错误标号：exact → prefix → E00000（未分类兜底；五位纯序号规范）。
pub func code_of(msg: string) -> string {
    var norm = normalize(msg)
    var c = diagcat.lookup(norm)
    if len(c) > 0 {
        return c
    }
    var pc = prefix_of(norm)
    if len(pc) > 0 {
        return pc
    }
    return "E00000"
}

// ---------- 消息名与尾段（用户格式：名字；期望 x；实际 y；提示。） ----------

// 短消息名：首个「期望 」前（含尾部冒号清理）→ 全角「：」前 → ASCII ": "
//（前字节非 ASCII）前 → 整条。
pub func name_of(msg: string) -> string {
    var p = dg_find(msg, "期望 ")
    if p > 0 {
        return dg_trim_tail_colon(dg_slice(msg, 0, p))
    }
    p = dg_find(msg, "：")
    if p > 0 {
        return dg_slice(msg, 0, p)
    }
    p = dg_find(msg, ": ")
    if p > 1 {
        var prev = str_byte(msg, p - 1)
        if prev >= 128 {
            return dg_slice(msg, 0, p)
        }
    }
    return msg
}

// 尾段：名字之后的部分（去前导冒号；「，实际 」→「；实际 」）。
pub func tail_of(msg: string) -> string {
    var p = dg_find(msg, "期望 ")
    if p > 0 {
        return tail_fix(dg_slice(msg, p, len(msg)))
    }
    p = dg_find(msg, "：")
    if p > 0 {
        return tail_fix(dg_slice(msg, p + 1, len(msg)))
    }
    p = dg_find(msg, ": ")
    if p > 1 {
        var prev = str_byte(msg, p - 1)
        if prev >= 128 {
            return tail_fix(dg_slice(msg, p + 2, len(msg)))
        }
    }
    return ""
}

// 「，实际 」→「；实际 」；去首尾空白。
func tail_fix(t: string) -> string {
    var sb = string_builder()
    var n: i64 = len(t)
    var i: i64 = 0
    while i < n {
        var b = str_byte(t, i)
        if b == 0xEF && i + 2 < n {
            // 全角逗号 '，'（EF BC 8C）
            if str_byte(t, i + 1) == 0xBC && str_byte(t, i + 2) == 0x8C {
                sb_append(sb, "；")
                i = i + 3
                continue
            }
        }
        sb_append_byte(sb, b)
        i = i + 1
    }
    var out = sb_build(sb)
    // 去首尾空白
    var k: i64 = 0
    var m: i64 = len(out)
    while k < m {
        var cb = str_byte(out, k)
        if cb == 32 || cb == 9 || cb == 10 || cb == 13 {
            k = k + 1
        } else {
            break
        }
    }
    if k > 0 {
        out = dg_slice(out, k, m)
    }
    var e: i64 = len(out)
    while e > 0 {
        var eb = str_byte(out, e - 1)
        if eb == 32 || eb == 9 || eb == 10 || eb == 13 {
            e = e - 1
        } else {
            break
        }
    }
    if e < len(out) {
        out = dg_slice(out, 0, e)
    }
    return out
}

// ---------- 输出渲染 ----------

// error[E#####] @行:列: 消息名；期望 x；实际 y。 （line < 0 时省略位置段）
pub func render_error(line: i64, col: i64, msg: string) -> string {
    var cc = code_of(msg)
    var out = "error[" + cc + "]"
    if line >= 0 {
        out = out + " @" + to_string(line) + ":" + to_string(col)
    }
    out = out + ": " + name_of(msg)
    var tl = tail_of(msg)
    if len(tl) > 0 {
        out = out + "；" + tl
    }
    return out + "。"
}

// 从 ERR 协议文本 "ERR:<line> <col> <msg>" 渲染错误行。
pub func render_err_proto(proto: string) -> string {
    if !dg_starts(proto, "ERR:") {
        return proto
    }
    var rest = dg_slice(proto, 4, len(proto))
    var sp1 = dg_find(rest, " ")
    if sp1 < 0 {
        return proto
    }
    var sp2: i64 = -1
    var i: i64 = sp1 + 1
    var rn: i64 = len(rest)
    while i < rn {
        if str_byte(rest, i) == 32 {
            sp2 = i
            break
        }
        i = i + 1
    }
    if sp2 < 0 {
        return proto
    }
    var lv: i64 = 0
    var j: i64 = 0
    while j < sp1 {
        lv = lv * 10 + (str_byte(rest, j) - 48)
        j = j + 1
    }
    var cv: i64 = 0
    j = sp1 + 1
    while j < sp2 {
        cv = cv * 10 + (str_byte(rest, j) - 48)
        j = j + 1
    }
    var msg = dg_slice(rest, sp2 + 1, rn)
    return render_error(lv, cv, msg)
}

// ---------- 警告目录（核心消息 → 码/名/建议；核心按字节升序） ----------

func ensure_warns() {
    if len(diag_w_keys) > 0 {
        return
    }
    // 升序（字节序）：ASCII "roles..." 在前，中文按码点递增
    var k: table<string> = [
        "roles.data.tie 解析失败，使用内置默认角色",
        "依赖包角色定义解析失败，使用内置默认角色",
        "循环内字符串拼接累积（x = x + y 逐次整体复制，O(n²)）",
        "整数除法结果截断（如 7/2 == 3）",
        "浮点相等比较（==/!= 对 f64/f32 结果不可靠）",
        "表变量拷贝共享底层数组（var b = a 后 b 的修改会反映到 a）",
        "角色 output 非法值，回退 lib",
        "角色重复注册，忽略后注册者"
    ]
    var c: table<string> = ["W00020", "W00021", "W00003", "W00002", "W00001", "W00004", "W00023", "W00022"]
    var nm: table<string> = [
        "角色配置解析失败",
        "角色定义解析失败",
        "字符串拼接累积",
        "整数除法截断",
        "浮点相等比较",
        "表变量拷贝共享",
        "角色 output 非法",
        "角色重复注册"
    ]
    var tp: table<string> = [
        "自定义角色配置语法错误，本次按内置默认角色编译；请检查 roles 段格式",
        "依赖包角色定义解析失败，已忽略；请检查包内 roles.data.tie 格式",
        "tie 字符串不可变，每次拼接生成新串并复制全部旧内容，循环 N 次总成本 O(N²)，长文本可致内存/时间爆炸；用 string_builder + sb_append + sb_build",
        "整数除法结果向下取整会丢小数；需保留精度请把操作数转为 f64",
        "浮点二进制表示有误差，== 几乎总是不成立；改用 |a-b| <= eps 的误差范围比较",
        "表赋值是引用共享而非深拷贝；需要独立副本请用 clone",
        "角色输出类型仅支持 lib/check/exe；非法值按 lib 处理，请检查 roles 段 output 字段",
        "同名角色先注册者生效，后注册者被忽略；请保持角色名全局唯一"
    ]
    diag_w_keys = table_new_string()
    diag_w_codes = table_new_string()
    diag_w_names = table_new_string()
    diag_w_tips = table_new_string()
    var i: i64 = 0
    while i < len(k) {
        table_push(diag_w_keys, k[i])
        table_push(diag_w_codes, c[i])
        table_push(diag_w_names, nm[i])
        table_push(diag_w_tips, tp[i])
        i = i + 1
    }
}

// 按核心消息查（原始字节二分；表升序）；未命中 ""。
func warn_at(core: string) -> i64 {
    ensure_warns()
    var lo: i64 = 0
    var hi: i64 = len(diag_w_keys) - 1
    while lo <= hi {
        var mid = (lo + hi) / 2
        if diag_w_keys[mid] == core {
            return mid
        }
        if diag_w_keys[mid] < core {
            lo = mid + 1
        } else {
            hi = mid - 1
        }
    }
    return -1
}

// 警告标号：未命中 W00000。
pub func warn_code_of(core: string) -> string {
    var idx = warn_at(core)
    if idx < 0 {
        return "W00000"
    }
    return diag_w_codes[idx]
}

// 警告消息名。
pub func warn_name_of(core: string) -> string {
    var idx = warn_at(core)
    if idx < 0 {
        return core
    }
    return diag_w_names[idx]
}

// 警告建议（潜在影响 / 处理方向）。
pub func warn_tip_of(core: string) -> string {
    var idx = warn_at(core)
    if idx < 0 {
        return ""
    }
    return diag_w_tips[idx]
}

// warning[W#####] @行:列: 消息名；潜在影响与处理建议。 （line < 0 省略位置段）
pub func render_warning(line: i64, col: i64, core: string) -> string {
    var cc = warn_code_of(core)
    var out = "warning[" + cc + "]"
    if line >= 0 {
        out = out + " @" + to_string(line) + ":" + to_string(col)
    }
    out = out + ": " + warn_name_of(core)
    var tp = warn_tip_of(core)
    if len(tp) > 0 {
        out = out + "；" + tp
    }
    return out + "。"
}

}   // namespace diagcode
