// 二分查表：key → code；未命中返回空串。
pub func lookup(key: string) -> string {
    ensure()
    var lo: i64 = 0
    var hi: i64 = len(cat_keys) - 1
    while lo <= hi {
        var mid = (lo + hi) / 2
        if cat_keys[mid] == key { return cat_codes[mid] }
        if cat_keys[mid] < key { lo = mid + 1 } else { hi = mid - 1 }
    }
    return ""
}
// 前缀规则：返回归一化前缀表（最长命中由 diagcode 侧完成）。
pub func pfx_count() -> i64 { ensure(); return len(pfx_keys) }
pub func pfx_key(i: i64) -> string { return pfx_keys[i] }
pub func pfx_code(i: i64) -> string { return pfx_codes[i] }
}
