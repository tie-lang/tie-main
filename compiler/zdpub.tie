type tie<class>
// compiler/zdpub.tie —— Keel 龙骨 p.7.1.4：data→zd 发布转换（publish 压缩 + 指纹计算）
// ============================================================
// 目标（specs/2026-08-29-plugin-kernel-design.md §4）：tie:data 明文 → tie:zd
// 压缩二进制发布，publish 时算指纹；load 时校验指纹。Keel 龙骨配置形态：
// 开发态 data 明文 → 分发态 zd（复用 tdzd.compress_data，不重实现表遍历）。
// 指纹=单文件 tsha1f（std/tsha1 底座，不修改）；随附清单 .zd.fp 文本 `tsha1f:<值>\n`。
//
// 对外 API：
//   zdpub.publish(data_path, zd_path) -> i64  发布：压缩写 .zd + 算指纹 + 写 .zd.fp
//   zdpub.load(path_or_zd) -> i64             加载：校验 .zd.fp 单文件指纹（tsha1f 比对）
//   zdpub.err_msg() -> string                 最近一次失败信息（成功时为空串）
//
// 本次只做文件级单指纹（整包树根 tsha1x 留给 p.7.1.5 审计链）。
//
// import 依赖（import 文本内联、归一化路径去重）：tdzd 提供 --compress-data 等价
// 压缩路径；tsha1 提供 tsha1f。语言边界：全局初始化只用字面量；模块级全局加
// zdpub_ 前缀防重名；命名空间内互调裸调用。文件字节用 byte_read（table<i64>），
// 桥接成二进制安全 string 后走 tsha1f 寄存器哈希。

import "./tdzd.tie"
import "../std/tsha1.tie"

var zdpub_err: string = "";

namespace zdpub {

// 最近一次操作的错误消息（成功时为空串）。
pub func err_msg() -> string {
    return zdpub_err
}

// 字节表（byte_read，i64 元素 0..255）→ 二进制安全字符串（指纹哈希输入）。
func bytes_to_str(t: table<i64>) -> string {
    var sb = string_builder()
    var i: i64 = 0
    while i < len(t) {
        sb_append_byte(sb, t[i])
        i = i + 1
    }
    return sb_build(sb)
}

// 单文件指纹：读文件字节 → tsha1f（f 档，n=48，48 进制）。文件缺失/读败返回空串。
func file_fingerprint(path: string) -> string {
    if !file_exists(path) {
        return ""
    }
    var t = byte_read(path)
    return tsha.tsha1f(bytes_to_str(t), 48)
}

// parse_fp：从清单文本提取 tsha1f 值（`tsha1f:<值>\n`，': '之后到行尾/空白前）。
func parse_fp(m: string) -> string {
    var n: i64 = str_len(m)
    var i: i64 = 0
    var seen: bool = false
    var out: string = ""
    while i < n {
        var c = str_char(m, i)
        if c == ":" {
            seen = true
        } else if seen {
            if c == "\n" || c == "\r" {
                break
            }
            out = out + c
        }
        i = i + 1
    }
    return out
}

// publish：读 tie:data 表字面量文件 → tdzd 压缩为 .zd → 单文件指纹 → 写随附
// 清单 zd_path + ".fp"（文本 `tsha1f:<值>\n`）。成功 0；失败非 0（err_msg 携带）。
pub func publish(data_path: string, zd_path: string) -> i64 {
    zdpub_err = ""
    if !tdzd.compress_data(data_path, zd_path) {
        zdpub_err = "zdpub publish 压缩失败: " + tdzd.err_msg()
        return -1
    }
    var fp = file_fingerprint(zd_path)
    if str_len(fp) == 0 {
        zdpub_err = "zdpub publish 指纹计算失败: " + zd_path
        return -1
    }
    if !file_write(zd_path + ".fp", "tsha1f:" + fp + "\n") {
        zdpub_err = "zdpub publish 写指纹清单失败: " + zd_path + ".fp"
        return -1
    }
    return 0
}

// load：读 .zd → 校验 .zd.fp 单文件指纹与字节指纹一致。一致 0；
// 指纹不符 / 文件缺失 / 清单异常 → -1（err_msg 携带）。"zd 包加载与 data
// 等价 + 指纹核验"的闭环入口（本次只做到文件级）。
pub func load(path: string) -> i64 {
    zdpub_err = ""
    var fp_path = path + ".fp"
    if !file_exists(path) || !file_exists(fp_path) {
        zdpub_err = "zdpub load 缺少 .zd 或 .zd.fp 文件"
        return -1
    }
    var manifest = file_read(fp_path)
    if str_len(manifest) == 0 {
        zdpub_err = "zdpub load 指纹清单为空: " + fp_path
        return -1
    }
    var want = parse_fp(manifest)
    if str_len(want) == 0 {
        zdpub_err = "zdpub load 指纹清单格式错误"
        return -1
    }
    var got = file_fingerprint(path)
    if str_len(got) == 0 {
        zdpub_err = "zdpub load 指纹计算失败: " + path
        return -1
    }
    if got != want {
        zdpub_err = "zdpub load 指纹不符（拒绝加载）"
        return -1
    }
    return 0
}

}   // namespace zdpub