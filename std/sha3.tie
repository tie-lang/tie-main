type tie<class>
// ============================================================================
// sha3.tie：标准库——SHA-3（Keccak 海绵，命名空间 sha3）
// 用途：可与 SHA-2 并列的安全哈希族；FIPS 202。用于指纹 / 完整性安全场景，
//   与 NIST 标准实现（Python hashlib.sha3_256/_512）二进制兼容。
// 接口：
//   sha3.sha3_256(s: string) -> string   SHA3-256 → 64 位十六进制小写
//   sha3.sha3_512(s: string) -> string   SHA3-512 → 128 位十六进制小写
// 逐**字节**处理（str_byte + len），任意 UTF-8 原始字节可哈希（同 sha/blake）。
//
// 算法（FIPS 202 / Keccak）：
//   - Keccak-f[1600]：25 个 64 位 lane，24 轮，每轮 θ/ρ/π/χ/ι。
//   - ρ/π 复合置换采用 Keccak 参考源码的 in-place 流水写法（t=s[1]；目的 lane 依
//     piln 顺序、轮转量 rotc；lane0 固定）——比 FIPS 双坐标公式更不易出错。
//   - 海绵构造：rate SHA3-256=136 字节、SHA3-512=72 字节；capacity=1600-rate。
//   - 消息按 lane 小端 XOR 进 rate 区；多速率填充 pad10*1 + 域块 0x06
//     （最后字节 0x80；只剩 1 字节时仅 XOR 0x80，避免 0x06 与 0x80 碰撞）。
//   - 输出：挤 rate 前 d 字节（d=256/8、512/8），每 lane 小端展开（lo 再 hi）。
//
// == 字宽 ==
//   Keccak 仅用 XOR/AND/NOT/循环左移。64 位 lane 用两个 32 位半分 (hi, lo)
//   表示（同 blake2b）；`>>` 生成 ashr，依赖半分恒 <2^32 正数以令算术右移 ==
//   逻辑右移（数值安全论证同 sha256/crypto）。shl64/lsr64/rotl64 取 blake2b
//   同款实现（对任意 64 位输入已用 Python 全空间随机抽样验证）。
//
// 标准向量（FIPS 202 / Python hashlib，已核对）：
//   sha3_256("")    = a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a
//   sha3_256("abc") = 3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532
//   sha3_512("")    = a69f73cca23a9ac5c8b567dc185a756e97c982164fe25859e0d1dcc1475c80a61
//                     5b2123af1f5f94c11e3e9402c3ac558f500199d95b6d3e301758586281dcd26
//   sha3_512("abc") = b751850b1a57168a5693cd924b6b096e08f621827444f70d884f5d0240d2712e
//                     10e116e9192af3c91a7ec57647e3934057340b4cf408d5a56592f8274eec53f0
// 探针：tests/hash2_probe/sha3_probe.tie（多向量 + 块边界 55/56/64/128）。
// 备注：命名空间内互调为裸调用，内部函数不加 sha3_ 前缀（同 sha/blake）。
// ============================================================================

var sha3_rc: table<i64>;     // 24 轮轮常量 RC（每轮 [hi, lo] 半分 = 48 项）
var sha3_rotc: table<i64>;    // ρ/π 流水轮转量（24 项）
var sha3_piln: table<i64>;    // ρ/π 流水目的 lane（24 项）

namespace sha3 {

// 惰性构建 24 轮 RC 常量（[hi, lo] 交错，48 项）。
func ensure_rc() {
    if len(sha3_rc) > 0 {
        return
    }
    var h = "0000000000000000800000008000000000000000000000008000000080000000" +
            "0000000000000000000000000000000000000000800000008000000080000000" +
            "8000000080000000000000008000000080000000800000000000000080000000"
    var l = "00000001000080820000808a800080000000808b800000018000808100008009" +
            "0000008a00000088800080098000000a8000808b0000008b0000808900008003" +
            "00008002000000800000800a8000000a80008081000080808000000180008008"
    var i: i64 = 0
    while i < 24 {
        table_push(sha3_rc, parse_hex32(substr(h, i * 8, i * 8 + 8)))
        table_push(sha3_rc, parse_hex32(substr(l, i * 8, i * 8 + 8)))
        i = i + 1
    }
}

// 惰性构建 ρ/π 流水常量（Keccak 参考源码 rotc 与 piln，各 24 项）。
func ensure_rp() {
    if len(sha3_rotc) > 0 {
        return
    }
    var rt = [1, 3, 6, 10, 15, 21, 28, 36, 45, 55, 2, 14, 27, 41, 56, 8, 25, 43, 62, 18, 39, 61, 20, 44]
    var pl = [10, 7, 11, 17, 18, 3, 5, 16, 8, 21, 24, 4, 15, 23, 19, 13, 12, 2, 20, 14, 22, 9, 6, 1]
    var i: i64 = 0
    while i < 24 {
        table_push(sha3_rotc, rt[i])
        table_push(sha3_piln, pl[i])
        i = i + 1
    }
}

// 截取字符串 [a, b)（码点区间）——内联实现（不依赖 string.tie）。
func substr(s: string, a: i64, b: i64) -> string {
    var out: string = ""
    var i: i64 = a
    while i < b {
        out = out + str_char(s, i)
        i = i + 1
    }
    return out
}

// 单字符十六进制数字（0..15）；非十六进制返回 0（仅解析内部常量）。
func hex_nibble(c: string) -> i64 {
    var digits = "0123456789abcdef"
    var i: i64 = 0
    while i < 16 {
        if str_char(digits, i) == c {
            return i
        }
        i = i + 1
    }
    return 0
}

// 解析 8 个 hex 字符为 32 位 i64（恒 <2^32 正数）。
func parse_hex32(s: string) -> i64 {
    var v: i64 = 0
    var i: i64 = 0
    while i < 8 {
        v = ((v << 4) | hex_nibble(str_char(s, i))) & 0xFFFFFFFF
        i = i + 1
    }
    return v
}

// 生成双元素表 [hi, lo]（64 位字载体；掩码保正）。
func w64(hi: i64, lo: i64) -> table<i64> {
    var o = table_new_i64()
    table_push(o, hi & 0xFFFFFFFF)
    table_push(o, lo & 0xFFFFFFFF)
    return o
}

// 64 位逻辑右移 r 位（r 0..63）→ [hi,lo]。
func lsr64(ah: i64, al: i64, r: i64) -> table<i64> {
    if r == 0 {
        return w64(ah, al)
    }
    if r < 32 {
        return w64((ah >> r), ((al >> r) | (ah << (32 - r))))
    }
    if r == 32 {
        return w64(0, ah)
    }
    return w64(0, (ah >> (r - 32)))
}

// 64 位逻辑左移 r 位（r 0..63）→ [hi,lo]。
func shl64(ah: i64, al: i64, r: i64) -> table<i64> {
    if r == 0 {
        return w64(ah, al)
    }
    if r < 32 {
        return w64(((ah << r) | (al >> (32 - r))), (al << r))
    }
    if r == 32 {
        return w64(al, 0)
    }
    return w64((al << (r - 32)), 0)
}

// 64 位循环左移 r 位（r 0..63）→ [hi,lo] = (W<<r)|(W>>(64-r))。
func rotl64(ah: i64, al: i64, r: i64) -> table<i64> {
    if r == 0 {
        return w64(ah, al)
    }
    var a = shl64(ah, al, r)
    var b = lsr64(ah, al, 64 - r)
    return w64((a[0] | b[0]), (a[1] | b[1]))
}

// 32 位值 → 8 位小写 hex（小端字节序：字节低地址在前，字节内高半字节在前）。
func hex8_le(v: i64) -> string {
    var hex = "0123456789abcdef"
    var out: string = ""
    var b: i64 = 0
    while b < 4 {
        var hi2 = (v >> (8 * b + 4)) & 0xF
        var lo = (v >> (8 * b)) & 0xF
        out = out + str_char(hex, hi2) + str_char(hex, lo)
        b = b + 1
    }
    return out
}

// 把单字节 val XOR 进 state 的 rate 字节位置 j（j<rate）。
func xor_byte(state: ref table<i64>, j: i64, val: i64) {
    var lane = j / 8
    var sub = j % 8
    if sub >= 4 {
        state[2 * lane] = state[2 * lane] ^ ((val << (8 * (sub - 4))) & 0xFFFFFFFF)
    } else {
        state[2 * lane + 1] = state[2 * lane + 1] ^ ((val << (8 * sub)) & 0xFFFFFFFF)
    }
}

// 一次 Keccak-f[1600] 置换（24 轮），原地作用于 state（25 lane × [hi,lo] = 50 项）。
func keccakf(state: ref table<i64>) {
    var c = table_new_i64()
    var k: i64 = 0
    while k < 10 {
        table_push(c, 0)
        k = k + 1
    }
    var round: i64 = 0
    while round < 24 {
        // ---- θ：C[x] = 列异或；D = C[x-1] ^ rotl(C[x+1],1)；A[x,y] ^= D ----
        var x: i64 = 0
        while x < 5 {
            c[2 * x] = state[2 * x] ^ state[2 * (x + 5)] ^ state[2 * (x + 10)] ^ state[2 * (x + 15)] ^ state[2 * (x + 20)]
            c[2 * x + 1] = state[2 * x + 1] ^ state[2 * (x + 5) + 1] ^ state[2 * (x + 10) + 1] ^ state[2 * (x + 15) + 1] ^ state[2 * (x + 20) + 1]
            x = x + 1
        }
        x = 0
        while x < 5 {
            var xm1 = (x + 4) % 5
            var xp1 = (x + 1) % 5
            var r1 = rotl64(c[2 * xp1], c[2 * xp1 + 1], 1)
            var dh = c[2 * xm1] ^ r1[0]
            var dl = c[2 * xm1 + 1] ^ r1[1]
            var yy: i64 = 0
            while yy < 5 {
                state[2 * (x + 5 * yy)] = state[2 * (x + 5 * yy)] ^ dh
                state[2 * (x + 5 * yy) + 1] = state[2 * (x + 5 * yy) + 1] ^ dl
                yy = yy + 1
            }
            x = x + 1
        }
        // ---- ρ + π：in-place 流水（t=s[1]；目的 lane=piln[i]，轮转 rotc[i]）----
        var th = state[2]
        var tl = state[3]
        var pi: i64 = 0
        while pi < 24 {
            var jp = sha3_piln[pi]
            var nh = state[2 * jp]
            var nl = state[2 * jp + 1]
            var r = rotl64(th, tl, sha3_rotc[pi])
            state[2 * jp] = r[0]
            state[2 * jp + 1] = r[1]
            th = nh
            tl = nl
            pi = pi + 1
        }
        // ---- χ：A[x,y] = B[x,y] ^ (~B[x+1,y] & B[x+2,y])，行内 x 环绕；先快照整行 ----
        var yy2: i64 = 0
        while yy2 < 5 {
            var i0 = 5 * yy2
            var h0 = state[2 * i0];     var l0 = state[2 * i0 + 1]
            var h1 = state[2 * (i0 + 1)]; var l1 = state[2 * (i0 + 1) + 1]
            var h2 = state[2 * (i0 + 2)]; var l2 = state[2 * (i0 + 2) + 1]
            var h3 = state[2 * (i0 + 3)]; var l3 = state[2 * (i0 + 3) + 1]
            var h4 = state[2 * (i0 + 4)]; var l4 = state[2 * (i0 + 4) + 1]
            state[2 * i0] = h0 ^ ((0xFFFFFFFF ^ h1) & h2)
            state[2 * i0 + 1] = l0 ^ ((0xFFFFFFFF ^ l1) & l2)
            state[2 * (i0 + 1)] = h1 ^ ((0xFFFFFFFF ^ h2) & h3)
            state[2 * (i0 + 1) + 1] = l1 ^ ((0xFFFFFFFF ^ l2) & l3)
            state[2 * (i0 + 2)] = h2 ^ ((0xFFFFFFFF ^ h3) & h4)
            state[2 * (i0 + 2) + 1] = l2 ^ ((0xFFFFFFFF ^ l3) & l4)
            state[2 * (i0 + 3)] = h3 ^ ((0xFFFFFFFF ^ h4) & h0)
            state[2 * (i0 + 3) + 1] = l3 ^ ((0xFFFFFFFF ^ l4) & l0)
            state[2 * (i0 + 4)] = h4 ^ ((0xFFFFFFFF ^ h0) & h1)
            state[2 * (i0 + 4) + 1] = l4 ^ ((0xFFFFFFFF ^ l0) & l1)
            yy2 = yy2 + 1
        }
        // ---- ι：A[0,0] ^= RC[round] ----
        state[0] = state[0] ^ sha3_rc[2 * round]
        state[1] = state[1] ^ sha3_rc[2 * round + 1]
        round = round + 1
    }
}

// Keccak 海绵主入口：msg 按 rate 吸收 + pad10*1(0x06) + 置换，挤 outlen 字节输出。
func keccak(msg: string, rate: i64, outlen: i64) -> string {
    ensure_rc()
    ensure_rp()
    var n: i64 = len(msg)
    var state = table_new_i64()
    var i: i64 = 0
    while i < 50 {
        table_push(state, 0)
        i = i + 1
    }
    var pos: i64 = 0
    while pos + rate <= n {
        var j: i64 = 0
        while j < rate {
            xor_byte(state, j, str_byte(msg, pos + j))
            j = j + 1
        }
        keccakf(state)
        pos = pos + rate
    }
    var rem = n - pos
    var jj: i64 = 0
    while jj < rem {
        xor_byte(state, jj, str_byte(msg, pos + jj))
        jj = jj + 1
    }
    if rem == rate - 1 {
        xor_byte(state, rem, 0x80)
    } else {
        xor_byte(state, rem, 0x06)
        xor_byte(state, rate - 1, 0x80)
    }
    keccakf(state)
    // 挤前 outlen 字节：d=256→4 lane、512→8 lane，每 lane 小端 [lo 先, hi 后]。
    var out: string = ""
    var lanes = outlen / 8
    i = 0
    while i < lanes {
        out = out + hex8_le(state[2 * i + 1]) + hex8_le(state[2 * i])
        i = i + 1
    }
    return out
}

// SHA3-256：rate=136，输出 32 字节 = 64 hex。
pub func sha3_256(msg: string) -> string {
    return keccak(msg, 136, 32)
}

// SHA3-512：rate=72，输出 64 字节 = 128 hex。
pub func sha3_512(msg: string) -> string {
    return keccak(msg, 72, 64)
}

}   // namespace sha3




