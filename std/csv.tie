type tie<class>
// csv.tie：标准库——CSV 读写（命名空间 csv；纯 tie 实现，基于 file_read/file_write
// + str 命名空间函数）。本文件 import string.tie 并用 `using str;` 裸调
// split/slice/join（M2.1.7 using 引入）；str_char 是语言底座原语（非 str 命名空间）。
// 注意——当前 import 展开不做去重，调用方只需导入 csv.tie（string.tie 会随
// 之展开）；若再重复导入 string.tie，会导致 str 命名空间内函数重复定义。
// cells 直接委托 str.split，保证与 string.tie 的语义逐字符一致。
// 调用：import 后 csv.read(...) / csv.cells(...) / csv.write(...)
// library-v2：csv_read/csv_cells/csv_write 去前缀（read/cells/write），
// 表参数类型化。注：read 本应返回 Result<table<string>, string>，但编译器
// enum payload 白名单仅支持标量，table<string> 作 payload 编译不过，
// 故保持原始空表哨兵（文件不存在/读取失败返回空表）。

import "./string.tie"
using str;

namespace csv {
// 读取 CSV 文件全部内容为字符串表（一行一个元素）：
// - file_read 读全文，按 "\n" 切分；
// - 每行末尾的 "\r"（Windows 换行残留）自动去除；
// - 空行保留为空字符串元素；文件以 \n 结尾时末尾会产生一个空元素
//   （与 split 语义一致），调用方可按需过滤。
// 每行内的单元格由调用方用 cells(row, ",") 切分（支持任意分隔符）。
pub func read(path: string) -> table<string> {
    var content: string = file_read(path)
    var raw = split(content, "\n")
    var lines = table_new_string()
    var n: i64 = len(raw)
    var i: i64 = 0
    while i < n {
        table_push(lines, strip_cr(raw[i]))
        i = i + 1
    }
    return lines
}

// 把一行 CSV 文本按分隔符切分为单元格表（str.split 的委托，语义逐字符一致）；
// sep 为空串时返回单元素 [line]。
pub func cells(line: string, sep: string) -> table<string> {
    var out = table_new_string()
    var raw = split(line, sep)
    var i: i64 = 0
    while i < len(raw) {
        table_push(out, raw[i])
        i = i + 1
    }
    return out
}

// 把行表 lines 写入 CSV 文件（每行已含分隔符，用 \n 连接，**无尾换行**——
// 与 read 的 split("\n") 对称，写读往返不产生空行元素）；
// 返回 file_write 是否成功（true 成功 / false 失败）。
pub func write(path: string, lines: table<string>) -> bool {
    var content = join(lines, "\n")
    return file_write(path, content)
}

// 去掉字符串末尾的一个回车符 "\r"（Windows 换行残留）；无 \r 时原样返回
// 注意：str_char 是语言底座原语（不在 str 命名空间内），此处裸调用；
// 边界用 str_len（码点数）——中文等多字节字符下 len 的字节数会让
// str_char 越界返回空串，导致 \r 判断失效。
func strip_cr(s: string) -> string {
    var n: i64 = str_len(s)
    if n > 0 && str_char(s, n - 1) == "\r" {
        return slice(s, 0, n - 1)
    }
    return s
}
}