type tie<logic>
// std/tsha_all_probe.tie —— tsha1 全档位性能探针（f/b/x/r × 多位长）
// 每档固定 iters=4 次哈希，结果即时 fs 写文件（避免 stdout 全缓冲长跑丢失）。
// 目的：识别仍走通用 table 路径的慢档（特化覆盖 n=8/48/64），指导后续特化。

import "./tsha1.tie" as tsha
import "./time.tie" as time
import "./fs.tie" as fs

var g_log: string = "std/tsha_all_probe.log"

func build_msg(n: i64) -> string {
    var chunk = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789abcdefghijklmnopqrstuvwxyz!@#$"
    var out: string = ""
    var i: i64 = 0
    var blocks = n / 64
    while i < blocks {
        out = out + chunk
        i = i + 1
    }
    return out
}

func wlog(line: string) {
    // 追加写：避免重复构造
    fs.append_text(g_log, line + "\n")
}

func do_f(msg: string, n: i64) -> string { return tsha.tsha1f(msg, n) }
func do_b(msg: string, n: i64) -> string { return tsha.tsha1b(msg, n) }
func do_x(msg: string, n: i64) -> string { return tsha.tsha1x(msg, n) }
func do_r(msg: string, n: i64) -> string { return tsha.tsha1r(msg, n) }

func measure(name: string, f: fn(string, i64) -> string, msg: string, n: i64) {
    var it = 4
    var t0 = time.now_ms()
    var acc: string = ""
    var i: i64 = 0
    while i < it {
        acc = f(msg, n)
        i = i + 1
    }
    var t1 = time.now_ms()
    var dt = t1 - t0
    var per = dt * 1000 / it
    wlog(name + " n=" + to_string(n) + " x" + to_string(it) + " total_ms=" + to_string(dt) + " us/call=" + to_string(per))
}

func main() -> i64 {
    var msg = build_msg(1048576)
    fs.write_text(g_log, "== tsha1 全档位（1MB×4 次，slow 档 >1000ms/call）==\n")
    var ns = table_new_i64()
    table_push(ns, 2)
    table_push(ns, 4)
    table_push(ns, 6)
    table_push(ns, 8)
    table_push(ns, 12)
    table_push(ns, 16)
    table_push(ns, 24)
    table_push(ns, 32)
    table_push(ns, 48)
    table_push(ns, 64)
    table_push(ns, 88)
    table_push(ns, 96)
    table_push(ns, 128)
    table_push(ns, 144)
    var m: i64 = 0
    while m < len(ns) {
        var n = ns[m]
        measure("f", do_f, msg, n)
        measure("b", do_b, msg, n)
        measure("x", do_x, msg, n)
        measure("r", do_r, msg, n)
        wlog("-- n=" + to_string(n) + " done --")
        m = m + 1
    }
    wlog("tsha 全档位探针完成")
    return 0
}