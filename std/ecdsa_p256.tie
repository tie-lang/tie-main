type tie<class>
// ============================================================================
// ecdsa_p256.tie：标准库——纯 tie ECDSA 签名，NIST P-256 / SHA-256（命名空间 ecdsa_p256）
// 用途：r.1.6.14——为 Linux 提供无 CNG/无 extern 的 P-256（secp256r1）EC-DSA 签名。
//   复用既有纯 tie `ext/tls/p256.tie` 的域算术与标量乘（已由 openssl 确定性密钥对
//   逐字节验证）+ `std/bigint.tie`（mod-n 运算与模逆）+ `std/hmac.tie`（RFC 6979
//   确定性 k 的 HMAC-SHA256 DRBG）。**无任何新的外部/系统依赖，纯 tie**。
//
// == 序列化约定（本模块独立定义，与旧 ext/ecdsa 的 CNG blob 不同）==
//   - 私钥 d   = 32 字节大端 hex（64 hex，1 ≤ d < n），同 ext/tls/p256.keygen 格式。
//   - 公钥     = 未压缩点 0x04‖X‖Y（65 字节 hex，130 hex）。
//   - 签名     = r‖s 各 32 字节大端 hex（64 字节 hex，128 hex）。
//   说明：旧 `ext/ecdsa`（Windows BCrypt/CNG）keygen 返回的是 ECCPRIVATEBLOB
//   hex（104B=8 头+X+Y+d，208 hex），与本模块序列化不同；本模块以 raw d + 未压缩
//   点为准（与 p256 对齐），调用方若由旧 CNG blob 迁移需自行转换。
//
// == 接口（对齐既有纯 tie 签名模块风格，hex IO）==
//   ecdsa_p256.keygen()                      -> string  私钥 d 的 32B hex（64 hex）
//   ecdsa_p256.pubkey(d_hex)                 -> string  公钥 65B hex（130 hex）；失败 ""
//   ecdsa_p256.sign(d_hex, hash_hex)         -> string  r‖s 64B hex（128 hex）；失败 ""
//   ecdsa_p256.verify(pub_hex, hash_hex, sig_hex) -> bool
//   （hash_hex 为调用方预先 SHA-256 得到的 32 字节摘要，本模块不再内部哈希。）
//
// == 算法（FIPS 186-4 ECDSA）==
//   sign  ：确定性 k = RFC 6979(HMAC-SHA256 DRBG，输入 d 与 h)；
//           R = k·G；r = Rx mod n（r≠0）；s = k⁻¹·(z + r·d) mod n（s≠0）；
//           z = int(hash) mod n。确定性 ⇒ 同 d/same hash → 同签名（可重放测试）。
//   verify：解析公钥点 Q 并校验 on-curve；校验 r,s ∈ [1,n)；
//           u1 = z·s⁻¹ mod n，u2 = r·s⁻¹ mod n；P = u1·G + u2·Q；
//           P≠∞ 且 Px mod n == r 则接受。
//   k 复用 RFC 6979 §3.2 HMAC-SHA256：V/K 初值 0x01/0x00（32B），
//   keydata = V‖0x00‖int2octets(x)‖bits2octets(h)，再 0x01 一遍，随后循环产出候选。
//   P-256 的 qlen=256=holen，无位截断，k = int(V) 直接判 1≤k<n。
//
// == 性能纪律（r.1.6.14）==
//   - mod-n / mod-p 全部走 bigint limb 数组（add/sub/mul/invmod），**无字符串参与**；
//   - hex 仅在固定边界（32/65 字节，64/130 hex）做预分配拼接，无循环逐字节 += 大串；
//   - 标量乘一律复用 `p256.mulf/mulp/addp`，sign=1 次、verify≈3 次标量乘（含点加），
//     一次性签名预算足够，不投优化。
//
// == 安全注记（同 p256/ed25519 定位）==
//   仿射点运算与 bigint 分支非常数时间（field inv、double-and-add 按位分支），且
//   RFC 6979 确定性 k 不引入系统 RNG 依赖；本模块面向功能正确性 + 确定性向量验证，
//   **不提供侧信道隔离**，生产签名须在调用层复核（见 r167-ecdsa-decision.md §3.5）。
//
// 依赖：bigint.tie（limb 数组算术）、hmac.tie（HMAC-SHA256）、ext/tls/p256.tie（点数/标量乘）。
// ============================================================================

// 顶层常量（懒构建）：P-256 群阶 n / 域模 p / 系数 b / 常数。
// 命名避开 p256/其他模块的全局（ec_n/ec_p 等），避免跨模块全局名冲突。
var ec_n: table<i64>;
var ec_p: table<i64>;
var ec_b: table<i64>;
var ec_one: table<i64>;
var ec_three: table<i64>;

import "./bigint.tie" as bigint
import "./hmac.tie" as hmac
import "../ext/tls/p256.tie" as p256
import "../ext/tls/tool.tie" as tbt

namespace ecdsa_p256 {

// 惰性构建本模块常量（n/p/b 与 p256 对齐同源；三者经 p256 的 curve_* 访问器拿到）。
func ensure_consts() {
    if len(ec_n) > 0 {
        return
    }
    ec_n = p256.curve_order()
    ec_p = p256.curve_prime()
    ec_b = p256.curve_b()
    ec_one = bigint.from_hex("1")
    ec_three = bigint.from_hex("3")
}

// ---- hex 工具（固定边界；仅内联 substr 与超长零填充）----

// 截取字符串 [a, b)（码点区间，仅用于定长分段）。
func substr(s: string, a: i64, b: i64) -> string {
    var out: string = ""
    var i: i64 = a
    while i < b {
        out = out + str_char(s, i)
        i = i + 1
    }
    return out
}

// 大整数 → 32 字节大端小写 hex（高位补零到 64）。b<n，to_hex 至多 64 字符，
// 补位循环有界（≤63），属固定边界序列化，允许。
func to_hex32(b: table<i64>) -> string {
    var h = bigint.to_hex(b)
    var out: string = ""
    var pad: i64 = len(h)
    while pad < 64 {
        out = out + "0"
        pad = pad + 1
    }
    return out + h
}

// RFC 6979 确定性 k（HMAC-SHA256 DRBG，视线双双 hex 字符串承载）。
// 输入 d_hex（私钥 32B hex）、h_hex（摘要 32B hex）→ 返回 32B hex 的 k（1≤k<n）。
func rfc6979_k(d_hex: string, h_hex: string) -> string {
    // V 初值 = 0x01×32，K 初值 = 0x00×32（holen=256 位）
    var V: string = ""
    var K: string = ""
    var i: i64 = 0
    while i < 32 {
        V = V + "01"
        K = K + "00"
        i = i + 1
    }
    // bits2octets(h)：z = int(h) mod n → int2octets(32B)。P-256 无位截断。
    var z = bigint.mod(bigint.from_hex(h_hex), ec_n)
    var h1o = to_hex32(z)
    // K = HMAC(K, V‖0x00‖int2octets(x)‖bits2octets(h1))
    K = hmac.hmac_sha256(K, V + "00" + d_hex + h1o)
    V = hmac.hmac_sha256(K, V)
    // K = HMAC(K, V‖0x01‖int2octets(x)‖bits2octets(h1))
    K = hmac.hmac_sha256(K, V + "01" + d_hex + h1o)
    V = hmac.hmac_sha256(K, V)
    // 候选循环：V=HMAC(K,V)；k=int(V)；合法则返回，否则 K/V 重置（本路径极少触发）。
    var guard: i64 = 0
    while guard < 64 {
        V = hmac.hmac_sha256(K, V)
        var k = bigint.from_hex(V)
        if bigint.is_zero(k) == false && bigint.cmp(k, ec_n) < 0 {
            return V
        }
        K = hmac.hmac_sha256(K, V + "00")
        V = hmac.hmac_sha256(K, V)
        guard = guard + 1
    }
    return ""
}

// ---- 公钥解码与 on-curve 校验 ----

// 解码未压缩公钥 04‖X‖Y（130 hex）→ (x, y, ok)；前缀/长度错 → ok=false。
func decode_pub(pub_hex: string) -> (table<i64>, table<i64>, bool) {
    if len(pub_hex) != 130 {
        return (table_new_i64(), table_new_i64(), false)
    }
    if substr(pub_hex, 0, 2) != "04" {
        return (table_new_i64(), table_new_i64(), false)
    }
    var x = bigint.from_hex(substr(pub_hex, 2, 66))
    var y = bigint.from_hex(substr(pub_hex, 66, 130))
    return (x, y, true)
}

// 曲线方程校验： y² ≡ x³ − 3x + b (mod p)，且 x,y ∈ [0,p)。
func on_curve(x: table<i64>, y: table<i64>) -> bool {
    if bigint.cmp(x, ec_p) >= 0 || bigint.cmp(y, ec_p) >= 0 {
        return false
    }
    var x2 = bigint.mod(bigint.mul(x, x), ec_p)
    var x3 = bigint.mod(bigint.mul(x2, x), ec_p)
    var am = bigint.sub(ec_p, ec_three)                 // a = -3 ≡ p-3 (mod p)
    var ax = bigint.mod(bigint.mul(am, x), ec_p)
    var rhs = bigint.mod(bigint.add(bigint.add(x3, ax), ec_b), ec_p)
    var lhs = bigint.mod(bigint.mul(y, y), ec_p)
    return bigint.cmp(lhs, rhs) == 0
}

// ---- 公开接口 ----

// 生成私钥 d（1 ≤ d < n）→ 32B 大端 hex。直接复用 p256.keygen（已验证 CSPRNG + mod-n）。
pub func keygen() -> string {
    ensure_consts()
    return p256.keygen()
}

// 私钥 d（64 hex）→ 公钥 65B hex（04‖X‖Y）；失败（非法 d）返回 ""。
pub func pubkey(d_hex: string) -> string {
    ensure_consts()
    var pb = p256.pubkey(d_hex)
    if len(pb) == 0 {
        return ""
    }
    return tbt.bytes_to_hex(pb)
}

// 签名：d（64 hex）× 摘要（64 hex）→ r‖s（128 hex）。RFC 6979 确定性 k。
// 失败返回 ""（非法 d / 非法摘要长度 / r 或 s 为零，后两者理论上不可达）。
pub func sign(d_hex: string, hash_hex: string) -> string {
    ensure_consts()
    if len(d_hex) != 64 || len(hash_hex) != 64 {
        return ""
    }
    var d = bigint.from_hex(d_hex)
    if bigint.is_zero(d) || bigint.cmp(d, ec_n) >= 0 {
        return ""
    }
    var k_hex = rfc6979_k(d_hex, hash_hex)
    if len(k_hex) == 0 {
        return ""
    }
    var k = bigint.from_hex(k_hex)
    var (rx, ry, ok) = p256.mulf(k)
    if !ok {
        return ""
    }
    var r = bigint.mod(rx, ec_n)
    if bigint.is_zero(r) {
        return ""
    }
    var z = bigint.mod(bigint.from_hex(hash_hex), ec_n)
    var rd = bigint.mod(bigint.mul(r, d), ec_n)
    var t = bigint.mod(bigint.add(z, rd), ec_n)
    var ki = bigint.invmod(k, ec_n)
    if bigint.is_zero(ki) {
        return ""
    }
    var s = bigint.mod(bigint.mul(ki, t), ec_n)
    if bigint.is_zero(s) {
        return ""
    }
    return to_hex32(r) + to_hex32(s)
}

// 验签：公钥（130 hex）× 摘要（64 hex）× 签名（128 hex）→ true/false。
pub func verify(pub_hex: string, hash_hex: string, sig_hex: string) -> bool {
    ensure_consts()
    if len(hash_hex) != 64 || len(sig_hex) != 128 {
        return false
    }
    var (qx, qy, dok) = decode_pub(pub_hex)
    if !dok {
        return false
    }
    if !on_curve(qx, qy) {
        return false
    }
    var r = bigint.from_hex(substr(sig_hex, 0, 64))
    var s = bigint.from_hex(substr(sig_hex, 64, 128))
    if bigint.is_zero(r) || bigint.cmp(r, ec_n) >= 0 {
        return false
    }
    if bigint.is_zero(s) || bigint.cmp(s, ec_n) >= 0 {
        return false
    }
    var z = bigint.mod(bigint.from_hex(hash_hex), ec_n)
    var si = bigint.invmod(s, ec_n)
    if bigint.is_zero(si) {
        return false
    }
    var u1 = bigint.mod(bigint.mul(z, si), ec_n)
    var u2 = bigint.mod(bigint.mul(r, si), ec_n)
    var (x1, y1, o1) = p256.mulf(u1)         // u1·G
    var (x2, y2, o2) = p256.mulp(u2, qx, qy) // u2·Q
    var px: table<i64>
    var pok: bool = false
    if o1 && o2 {
        var (ax, ay, oak) = p256.addp(x1, y1, x2, y2)
        if oak {
            px = ax
            pok = true
        }
    } else if o1 {
        px = x1
        pok = true
    } else if o2 {
        px = x2
        pok = true
    }
    if !pok {
        return false
    }
    var v = bigint.mod(px, ec_n)
    return bigint.cmp(v, r) == 0
}

}   // namespace ecdsa_p256