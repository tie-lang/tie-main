    l.N12 = (l.N12 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M10, l.N10, rrp(M0, mA), rrp(N0, mA))
    l.M10 = im
    l.N10 = in2
    var (jm, jn2) = tadd2(l.M11, l.N11, rrp(M1, (mA + 7) & 31), rrp(N1, (mA + 7) & 31))
    l.M11 = jm
    l.N11 = jn2
    l.M10 = (l.M10 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N12 = (l.N12 ^ rrp(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

