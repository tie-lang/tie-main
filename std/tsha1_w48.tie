    var (s18m, s18n) = tadd2(q18m, q18n,
                    rrp16(l.M21, (rB + 1) & 31), rrp16(l.N21, (rB + 1) & 31))
    var (q19m, q19n) = tadd2(l.M19, l.N19,
                    rrp16(l.M21, (rA + 31) & 31), rrp16(l.N21, (rA + 31) & 31))
    var (s19m, s19n) = tadd2(q19m, q19n,
                    rrp16(l.M0, (rB + 8) & 31), rrp16(l.N0, (rB + 8) & 31))
    var (q20m, q20n) = tadd2(l.M20, l.N20,
                    rrp16(l.M0, (rA + 4) & 31), rrp16(l.N0, (rA + 4) & 31))
    var (s20m, s20n) = tadd2(q20m, q20n,
                    rrp16(l.M1, (rB + 15) & 31), rrp16(l.N1, (rB + 15) & 31))
    var (q21m, q21n) = tadd2(l.M21, l.N21,
                    rrp16(l.M1, (rA + 9) & 31), rrp16(l.N1, (rA + 9) & 31))
    var (s21m, s21n) = tadd2(q21m, q21n,
                    rrp16(l.M2, (rB + 22) & 31), rrp16(l.N2, (rB + 22) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    l.M2 = s2m
    l.N2 = s2n
    l.M3 = s3m
    l.N3 = s3n
    l.M4 = s4m
    l.N4 = s4n
    l.M5 = s5m
    l.N5 = s5n
    l.M6 = s6m
    l.N6 = s6n
    l.M7 = s7m
    l.N7 = s7n
    l.M8 = s8m
    l.N8 = s8n
    l.M9 = s9m
    l.N9 = s9n
    l.M10 = s10m
    l.N10 = s10n
    l.M11 = s11m
    l.N11 = s11n
    l.M12 = s12m
    l.N12 = s12n
    l.M13 = s13m
    l.N13 = s13n
    l.M14 = s14m
    l.N14 = s14n
    l.M15 = s15m
    l.N15 = s15n
    l.M16 = s16m
    l.N16 = s16n
    l.M17 = s17m
    l.N17 = s17n
    l.M18 = s18m
    l.N18 = s18n
    l.M19 = s19m
    l.N19 = s19n
    l.M20 = s20m
    l.N20 = s20n
    l.M21 = s21m
    l.N21 = s21n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M2 = (l.M2 ^ p1m) & 0xFFFFFFFF
