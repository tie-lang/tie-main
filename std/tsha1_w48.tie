    var (p16m, p16n) = tmul2(s16m, s16n, s18m, s18n)
    l.M17 = (l.M17 ^ p16m) & 0xFFFFFFFF
    l.N17 = (l.N17 ^ p16n) & 0xFFFFFFFF
    var (p17m, p17n) = tmul2(s17m, s17n, s19m, s19n)
    l.M18 = (l.M18 ^ p17m) & 0xFFFFFFFF
    l.N18 = (l.N18 ^ p17n) & 0xFFFFFFFF
    var (p18m, p18n) = tmul2(s18m, s18n, s20m, s20n)
    l.M19 = (l.M19 ^ p18m) & 0xFFFFFFFF
