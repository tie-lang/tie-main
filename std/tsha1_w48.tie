    var (s20m, s20n) = tadd2(q20m, q20n,
                    rrp(l.M0, (rB + 15) & 31), rrp(l.N0, (rB + 15) & 31))
    var (q21m, q21n) = tadd2(l.M21, l.N21,
                    rrp(l.M0, (rA + 9) & 31), rrp(l.N0, (rA + 9) & 31))
    var (s21m, s21n) = tadd2(q21m, q21n,
                    rrp(l.M1, (rB + 22) & 31), rrp(l.N1, (rB + 22) & 31))
    var (q22m, q22n) = tadd2(l.M22, l.N22,
                    rrp(l.M1, (rA + 14) & 31), rrp(l.N1, (rA + 14) & 31))
    var (s22m, s22n) = tadd2(q22m, q22n,
                    rrp(l.M2, (rB + 29) & 31), rrp(l.N2, (rB + 29) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    l.M2 = s2m
    l.N2 = s2n
