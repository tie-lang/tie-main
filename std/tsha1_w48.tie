            ) -> Lanes23b {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M20, l.N20,
                    rrp(l.M22, rA), rrp(l.N22, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp(l.M20, (rB + 3) & 31), rrp(l.N20, (rB + 3) & 31))
