    l.M11 = h[11] & 0xFFFFFFFF
    l.N11 = rrp(h[12], 7)
    l.M12 = h[12] & 0xFFFFFFFF
    l.N12 = rrp(h[13], 7)
    l.M13 = h[13] & 0xFFFFFFFF
    l.N13 = rrp(h[14], 7)
    l.M14 = h[14] & 0xFFFFFFFF
    l.N14 = rrp(h[15], 7)
    l.M15 = h[15] & 0xFFFFFFFF
    l.N15 = rrp(h[16], 7)
    l.M16 = h[16] & 0xFFFFFFFF
    l.N16 = rrp(h[17], 7)
    l.M17 = h[17] & 0xFFFFFFFF
    l.N17 = rrp(h[18], 7)
    l.M18 = h[18] & 0xFFFFFFFF
    l.N18 = rrp(h[19], 7)
    l.M19 = h[19] & 0xFFFFFFFF
    l.N19 = rrp(h[20], 7)
    l.M20 = h[20] & 0xFFFFFFFF
    l.N20 = rrp(h[21], 7)
    l.M21 = h[21] & 0xFFFFFFFF
    l.N21 = rrp(h[22], 7)
    l.M22 = h[22] & 0xFFFFFFFF
    l.N22 = rrp(h[0], 7)
    var sf: i64 = 0
    while sf < 4 {
        l = ring23_mixF(l, sf, 0x13579BDF)
        sf = sf + 1
    }
    h[0] = (l.M0 ^ rrp(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (l.M1 ^ rrp(l.N1, 5)) & 0xFFFFFFFF
    h[2] = (l.M2 ^ rrp(l.N2, 10)) & 0xFFFFFFFF
    h[3] = (l.M3 ^ rrp(l.N3, 15)) & 0xFFFFFFFF
    h[4] = (l.M4 ^ rrp(l.N4, 20)) & 0xFFFFFFFF
    h[5] = (l.M5 ^ rrp(l.N5, 25)) & 0xFFFFFFFF
    h[6] = (l.M6 ^ rrp(l.N6, 30)) & 0xFFFFFFFF
    h[7] = (l.M7 ^ rrp(l.N7, 3)) & 0xFFFFFFFF
    h[8] = (l.M8 ^ rrp(l.N8, 8)) & 0xFFFFFFFF
    h[9] = (l.M9 ^ rrp(l.N9, 13)) & 0xFFFFFFFF
    h[10] = (l.M10 ^ rrp(l.N10, 18)) & 0xFFFFFFFF
    h[11] = (l.M11 ^ rrp(l.N11, 23)) & 0xFFFFFFFF
    h[12] = (l.M12 ^ rrp(l.N12, 28)) & 0xFFFFFFFF
    h[13] = (l.M13 ^ rrp(l.N13, 1)) & 0xFFFFFFFF
    h[14] = (l.M14 ^ rrp(l.N14, 6)) & 0xFFFFFFFF
    h[15] = (l.M15 ^ rrp(l.N15, 11)) & 0xFFFFFFFF
    h[16] = (l.M16 ^ rrp(l.N16, 16)) & 0xFFFFFFFF
    h[17] = (l.M17 ^ rrp(l.N17, 21)) & 0xFFFFFFFF
    h[18] = (l.M18 ^ rrp(l.N18, 26)) & 0xFFFFFFFF
    h[19] = (l.M19 ^ rrp(l.N19, 31)) & 0xFFFFFFFF
    h[20] = (l.M20 ^ rrp(l.N20, 4)) & 0xFFFFFFFF
    h[21] = (l.M21 ^ rrp(l.N21, 9)) & 0xFFFFFFFF
    h[22] = (l.M22 ^ rrp(l.N22, 14)) & 0xFFFFFFFF
}

pub func compress_w23(h: ref table<i64>, msg: string, pos: i64, nbytes: i64,
            t_lo: i64, t_hi: i64, last: bool,
            iv: table<i64>, rcon: table<i64>, R: i64) {
    var (M0, N0, M1, N1, Pw, skey) = w48_planes_skey(msg, pos, nbytes)
    var l = Lanes23()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp(h[11], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp(h[12], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp(h[13], 7)
    l.M3 = h[3] & 0xFFFFFFFF
    l.N3 = rrp(h[14], 7)
    l.M4 = h[4] & 0xFFFFFFFF
    l.N4 = rrp(h[15], 7)
    l.M5 = h[5] & 0xFFFFFFFF
    l.N5 = rrp(h[16], 7)
    l.M6 = h[6] & 0xFFFFFFFF
    l.N6 = rrp(h[17], 7)
    l.M7 = h[7] & 0xFFFFFFFF
    l.N7 = rrp(h[18], 7)
    l.M8 = h[8] & 0xFFFFFFFF
    l.N8 = rrp(h[19], 7)
    l.M9 = h[9] & 0xFFFFFFFF
    l.N9 = rrp(h[20], 7)
    l.M10 = h[10] & 0xFFFFFFFF
    l.N10 = rrp(h[21], 7)
    l.M11 = h[11] & 0xFFFFFFFF
    l.N11 = rrp(h[22], 7)
    l.M12 = h[12] & 0xFFFFFFFF
    l.N12 = rrp(h[0], 7)
    l.M13 = h[13] & 0xFFFFFFFF
    l.N13 = rrp(h[1], 7)
    l.M14 = h[14] & 0xFFFFFFFF
    l.N14 = rrp(h[2], 7)
    l.M15 = h[15] & 0xFFFFFFFF
    l.N15 = rrp(h[3], 7)
    l.M16 = h[16] & 0xFFFFFFFF
    l.N16 = rrp(h[4], 7)
    l.M17 = h[17] & 0xFFFFFFFF
    l.N17 = rrp(h[5], 7)
    l.M18 = h[18] & 0xFFFFFFFF
    l.N18 = rrp(h[6], 7)
    l.M19 = h[19] & 0xFFFFFFFF
    l.N19 = rrp(h[7], 7)
    l.M20 = h[20] & 0xFFFFFFFF
    l.N20 = rrp(h[8], 7)
    l.M21 = h[21] & 0xFFFFFFFF
    l.N21 = rrp(h[9], 7)
    l.M22 = h[22] & 0xFFFFFFFF
    l.N22 = rrp(h[10], 7)
    l.M0 = (l.M0 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M1 = (l.M1 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M2 = (l.M2 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M3 = (l.M3 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M4 = (l.M4 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M5 = (l.M5 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M6 = (l.M6 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M7 = (l.M7 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M8 = (l.M8 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M9 = (l.M9 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N9 = (l.N9 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M10 = (l.M10 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M11 = (l.M11 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M12 = (l.M12 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N12 = (l.N12 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M13 = (l.M13 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N13 = (l.N13 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M14 = (l.M14 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N14 = (l.N14 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M15 = (l.M15 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N15 = (l.N15 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M16 = (l.M16 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N16 = (l.N16 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M17 = (l.M17 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N17 = (l.N17 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M18 = (l.M18 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N18 = (l.N18 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M19 = (l.M19 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N19 = (l.N19 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M20 = (l.M20 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N20 = (l.N20 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M21 = (l.M21 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N21 = (l.N21 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M22 = (l.M22 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N22 = (l.N22 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (t_lo & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ (t_hi & 0xFFFFFFFF)) & 0xFFFFFFFF
    if last {
        l.N11 = (l.N11 ^ 0xFFFFFFFF) & 0xFFFFFFFF
    }
    l = absorb23(l, Pw, skey)
    var mA: i64 = 0
    var mC: i64 = 0
    var r: i64 = 0
    while r < R {
        mA = (r * 5 + ((skey >> 6) & 7)) & 31
        mC = (r * 7 + ((skey >> 12) & 7)) & 31
        l = ring23_mixA(l, r, skey, M0, N0, M1, N1, mA, rcon, r)
        l = ring23_mixB(l, r, skey, M0, N0, M1, N1, mC, rcon, (r + 8) & 15)
        r = r + 1
    }
    h[0] = (h[0] ^ l.M0 ^ rrp(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (h[1] ^ l.M1 ^ rrp(l.N1, 3)) & 0xFFFFFFFF
    h[2] = (h[2] ^ l.M2 ^ rrp(l.N2, 6)) & 0xFFFFFFFF
    h[3] = (h[3] ^ l.M3 ^ rrp(l.N3, 9)) & 0xFFFFFFFF
    h[4] = (h[4] ^ l.M4 ^ rrp(l.N4, 12)) & 0xFFFFFFFF
    h[5] = (h[5] ^ l.M5 ^ rrp(l.N5, 15)) & 0xFFFFFFFF
    h[6] = (h[6] ^ l.M6 ^ rrp(l.N6, 18)) & 0xFFFFFFFF
    h[7] = (h[7] ^ l.M7 ^ rrp(l.N7, 21)) & 0xFFFFFFFF
    h[8] = (h[8] ^ l.M8 ^ rrp(l.N8, 24)) & 0xFFFFFFFF
    h[9] = (h[9] ^ l.M9 ^ rrp(l.N9, 27)) & 0xFFFFFFFF
    h[10] = (h[10] ^ l.M10 ^ rrp(l.N10, 30)) & 0xFFFFFFFF
    h[11] = (h[11] ^ l.M11 ^ rrp(l.N11, 1)) & 0xFFFFFFFF
    h[12] = (h[12] ^ l.M12 ^ rrp(l.N12, 4)) & 0xFFFFFFFF
    h[13] = (h[13] ^ l.M13 ^ rrp(l.N13, 7)) & 0xFFFFFFFF
    h[14] = (h[14] ^ l.M14 ^ rrp(l.N14, 10)) & 0xFFFFFFFF
    h[15] = (h[15] ^ l.M15 ^ rrp(l.N15, 13)) & 0xFFFFFFFF
    h[16] = (h[16] ^ l.M16 ^ rrp(l.N16, 16)) & 0xFFFFFFFF
    h[17] = (h[17] ^ l.M17 ^ rrp(l.N17, 19)) & 0xFFFFFFFF
    h[18] = (h[18] ^ l.M18 ^ rrp(l.N18, 22)) & 0xFFFFFFFF
    h[19] = (h[19] ^ l.M19 ^ rrp(l.N19, 25)) & 0xFFFFFFFF
    h[20] = (h[20] ^ l.M20 ^ rrp(l.N20, 28)) & 0xFFFFFFFF
    h[21] = (h[21] ^ l.M21 ^ rrp(l.N21, 31)) & 0xFFFFFFFF
    h[22] = (h[22] ^ l.M22 ^ rrp(l.N22, 2)) & 0xFFFFFFFF
    fin_synth23(h)
}

// === W=26 全宽双轨特化内核（f，n=88/92/96/128/144）——轨A lanes[0..13)、轨B lanes[13..26)；R=12 ===
struct Lanes26 {
    var M0: i64 = 0
    var N0: i64 = 0
    var M1: i64 = 0
    var N1: i64 = 0
    var M2: i64 = 0
    var N2: i64 = 0
    var M3: i64 = 0
    var N3: i64 = 0
    var M4: i64 = 0
    var N4: i64 = 0
    var M5: i64 = 0
    var N5: i64 = 0
    var M6: i64 = 0
    var N6: i64 = 0
    var M7: i64 = 0
    var N7: i64 = 0
    var M8: i64 = 0
    var N8: i64 = 0
    var M9: i64 = 0
    var N9: i64 = 0
    var M10: i64 = 0
    var N10: i64 = 0
    var M11: i64 = 0
    var N11: i64 = 0
    var M12: i64 = 0
    var N12: i64 = 0
    var M13: i64 = 0
    var N13: i64 = 0
    var M14: i64 = 0
    var N14: i64 = 0
    var M15: i64 = 0
    var N15: i64 = 0
    var M16: i64 = 0
    var N16: i64 = 0
    var M17: i64 = 0
    var N17: i64 = 0
    var M18: i64 = 0
    var N18: i64 = 0
    var M19: i64 = 0
    var N19: i64 = 0
    var M20: i64 = 0
    var N20: i64 = 0
    var M21: i64 = 0
    var N21: i64 = 0
    var M22: i64 = 0
    var N22: i64 = 0
    var M23: i64 = 0
    var N23: i64 = 0
    var M24: i64 = 0
    var N24: i64 = 0
    var M25: i64 = 0
    var N25: i64 = 0
}

func ring26_mixA(l: Lanes26, r: i64
            , skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes26 {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0,
                    rrp(l.M2, rA), rrp(l.N2, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp(l.M3, (rB + 3) & 31), rrp(l.N3, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1,
                    rrp(l.M3, (rA + 5) & 31), rrp(l.N3, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp(l.M4, (rB + 10) & 31), rrp(l.N4, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M2, l.N2,
                    rrp(l.M4, (rA + 10) & 31), rrp(l.N4, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp(l.M5, (rB + 17) & 31), rrp(l.N5, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M3, l.N3,
                    rrp(l.M5, (rA + 15) & 31), rrp(l.N5, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp(l.M6, (rB + 24) & 31), rrp(l.N6, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M4, l.N4,
                    rrp(l.M6, (rA + 20) & 31), rrp(l.N6, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp(l.M7, (rB + 31) & 31), rrp(l.N7, (rB + 31) & 31))
    var (q5m, q5n) = tadd2(l.M5, l.N5,
                    rrp(l.M7, (rA + 25) & 31), rrp(l.N7, (rA + 25) & 31))
    var (s5m, s5n) = tadd2(q5m, q5n,
                    rrp(l.M8, (rB + 6) & 31), rrp(l.N8, (rB + 6) & 31))
    var (q6m, q6n) = tadd2(l.M6, l.N6,
                    rrp(l.M8, (rA + 30) & 31), rrp(l.N8, (rA + 30) & 31))
    var (s6m, s6n) = tadd2(q6m, q6n,
                    rrp(l.M9, (rB + 13) & 31), rrp(l.N9, (rB + 13) & 31))
    var (q7m, q7n) = tadd2(l.M7, l.N7,
                    rrp(l.M9, (rA + 3) & 31), rrp(l.N9, (rA + 3) & 31))
    var (s7m, s7n) = tadd2(q7m, q7n,
                    rrp(l.M10, (rB + 20) & 31), rrp(l.N10, (rB + 20) & 31))
    var (q8m, q8n) = tadd2(l.M8, l.N8,
                    rrp(l.M10, (rA + 8) & 31), rrp(l.N10, (rA + 8) & 31))
    var (s8m, s8n) = tadd2(q8m, q8n,
                    rrp(l.M11, (rB + 27) & 31), rrp(l.N11, (rB + 27) & 31))
    var (q9m, q9n) = tadd2(l.M9, l.N9,
                    rrp(l.M11, (rA + 13) & 31), rrp(l.N11, (rA + 13) & 31))
    var (s9m, s9n) = tadd2(q9m, q9n,
                    rrp(l.M12, (rB + 2) & 31), rrp(l.N12, (rB + 2) & 31))
    var (q10m, q10n) = tadd2(l.M10, l.N10,
                    rrp(l.M12, (rA + 18) & 31), rrp(l.N12, (rA + 18) & 31))
    var (s10m, s10n) = tadd2(q10m, q10n,
                    rrp(l.M0, (rB + 9) & 31), rrp(l.N0, (rB + 9) & 31))
    var (q11m, q11n) = tadd2(l.M11, l.N11,
                    rrp(l.M0, (rA + 23) & 31), rrp(l.N0, (rA + 23) & 31))
    var (s11m, s11n) = tadd2(q11m, q11n,
                    rrp(l.M1, (rB + 16) & 31), rrp(l.N1, (rB + 16) & 31))
    var (q12m, q12n) = tadd2(l.M12, l.N12,
                    rrp(l.M1, (rA + 28) & 31), rrp(l.N1, (rA + 28) & 31))
    var (s12m, s12n) = tadd2(q12m, q12n,
                    rrp(l.M2, (rB + 23) & 31), rrp(l.N2, (rB + 23) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    l.M2 = s2m
    l.N2 = s2n
    l.M3 = s3m
    l.N3 = s3n
    l.M4 = s4m
    l.N4 = s4n
    l.M5 = s5m
    l.N5 = s5n
    l.M6 = s6m
    l.N6 = s6n
    l.M7 = s7m
    l.N7 = s7n
    l.M8 = s8m
    l.N8 = s8n
    l.M9 = s9m
    l.N9 = s9n
    l.M10 = s10m
    l.N10 = s10n
    l.M11 = s11m
    l.N11 = s11n
    l.M12 = s12m
    l.N12 = s12n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M2 = (l.M2 ^ p1m) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M3 = (l.M3 ^ p2m) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s5m, s5n)
    l.M4 = (l.M4 ^ p3m) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s6m, s6n)
    l.M5 = (l.M5 ^ p4m) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ p4n) & 0xFFFFFFFF
    var (p5m, p5n) = tmul2(s5m, s5n, s7m, s7n)
    l.M6 = (l.M6 ^ p5m) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ p5n) & 0xFFFFFFFF
    var (p6m, p6n) = tmul2(s6m, s6n, s8m, s8n)
    l.M7 = (l.M7 ^ p6m) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ p6n) & 0xFFFFFFFF
    var (p7m, p7n) = tmul2(s7m, s7n, s9m, s9n)
    l.M8 = (l.M8 ^ p7m) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ p7n) & 0xFFFFFFFF
    var (p8m, p8n) = tmul2(s8m, s8n, s10m, s10n)
    l.M9 = (l.M9 ^ p8m) & 0xFFFFFFFF
    l.N9 = (l.N9 ^ p8n) & 0xFFFFFFFF
    var (p9m, p9n) = tmul2(s9m, s9n, s11m, s11n)
    l.M10 = (l.M10 ^ p9m) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ p9n) & 0xFFFFFFFF
    var (p10m, p10n) = tmul2(s10m, s10n, s12m, s12n)
    l.M11 = (l.M11 ^ p10m) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ p10n) & 0xFFFFFFFF
    var (p11m, p11n) = tmul2(s11m, s11n, s0m, s0n)
    l.M12 = (l.M12 ^ p11m) & 0xFFFFFFFF
    l.N12 = (l.N12 ^ p11n) & 0xFFFFFFFF
    var (p12m, p12n) = tmul2(s12m, s12n, s1m, s1n)
    l.M0 = (l.M0 ^ p12m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p12n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M12 = (l.M12 ^ maj) & 0xFFFFFFFF
    l.N12 = (l.N12 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M0, l.N0, rrp(M0, mA), rrp(N0, mA))
    l.M0 = im
    l.N0 = in2
    var (jm, jn2) = tadd2(l.M1, l.N1, rrp(M1, (mA + 7) & 31), rrp(N1, (mA + 7) & 31))
    l.M1 = jm
    l.N1 = jn2
    l.M0 = (l.M0 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N12 = (l.N12 ^ rrp(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

func ring26_mixB(l: Lanes26, r: i64
            , skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes26 {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M13, l.N13,
                    rrp(l.M15, rA), rrp(l.N15, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp(l.M16, (rB + 3) & 31), rrp(l.N16, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M14, l.N14,
                    rrp(l.M16, (rA + 5) & 31), rrp(l.N16, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp(l.M17, (rB + 10) & 31), rrp(l.N17, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M15, l.N15,
                    rrp(l.M17, (rA + 10) & 31), rrp(l.N17, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp(l.M18, (rB + 17) & 31), rrp(l.N18, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M16, l.N16,
                    rrp(l.M18, (rA + 15) & 31), rrp(l.N18, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp(l.M19, (rB + 24) & 31), rrp(l.N19, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M17, l.N17,
                    rrp(l.M19, (rA + 20) & 31), rrp(l.N19, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp(l.M20, (rB + 31) & 31), rrp(l.N20, (rB + 31) & 31))
    var (q5m, q5n) = tadd2(l.M18, l.N18,
                    rrp(l.M20, (rA + 25) & 31), rrp(l.N20, (rA + 25) & 31))
    var (s5m, s5n) = tadd2(q5m, q5n,
                    rrp(l.M21, (rB + 6) & 31), rrp(l.N21, (rB + 6) & 31))
    var (q6m, q6n) = tadd2(l.M19, l.N19,
                    rrp(l.M21, (rA + 30) & 31), rrp(l.N21, (rA + 30) & 31))
    var (s6m, s6n) = tadd2(q6m, q6n,
                    rrp(l.M22, (rB + 13) & 31), rrp(l.N22, (rB + 13) & 31))
    var (q7m, q7n) = tadd2(l.M20, l.N20,
                    rrp(l.M22, (rA + 3) & 31), rrp(l.N22, (rA + 3) & 31))
    var (s7m, s7n) = tadd2(q7m, q7n,
                    rrp(l.M23, (rB + 20) & 31), rrp(l.N23, (rB + 20) & 31))
    var (q8m, q8n) = tadd2(l.M21, l.N21,
                    rrp(l.M23, (rA + 8) & 31), rrp(l.N23, (rA + 8) & 31))
    var (s8m, s8n) = tadd2(q8m, q8n,
                    rrp(l.M24, (rB + 27) & 31), rrp(l.N24, (rB + 27) & 31))
    var (q9m, q9n) = tadd2(l.M22, l.N22,
                    rrp(l.M24, (rA + 13) & 31), rrp(l.N24, (rA + 13) & 31))
    var (s9m, s9n) = tadd2(q9m, q9n,
                    rrp(l.M25, (rB + 2) & 31), rrp(l.N25, (rB + 2) & 31))
    var (q10m, q10n) = tadd2(l.M23, l.N23,
                    rrp(l.M25, (rA + 18) & 31), rrp(l.N25, (rA + 18) & 31))
    var (s10m, s10n) = tadd2(q10m, q10n,
                    rrp(l.M13, (rB + 9) & 31), rrp(l.N13, (rB + 9) & 31))
    var (q11m, q11n) = tadd2(l.M24, l.N24,
                    rrp(l.M13, (rA + 23) & 31), rrp(l.N13, (rA + 23) & 31))
    var (s11m, s11n) = tadd2(q11m, q11n,
                    rrp(l.M14, (rB + 16) & 31), rrp(l.N14, (rB + 16) & 31))
    var (q12m, q12n) = tadd2(l.M25, l.N25,
                    rrp(l.M14, (rA + 28) & 31), rrp(l.N14, (rA + 28) & 31))
    var (s12m, s12n) = tadd2(q12m, q12n,
                    rrp(l.M15, (rB + 23) & 31), rrp(l.N15, (rB + 23) & 31))
    l.M13 = s0m
    l.N13 = s0n
    l.M14 = s1m
    l.N14 = s1n
    l.M15 = s2m
    l.N15 = s2n
    l.M16 = s3m
    l.N16 = s3n
    l.M17 = s4m
    l.N17 = s4n
    l.M18 = s5m
    l.N18 = s5n
    l.M19 = s6m
    l.N19 = s6n
    l.M20 = s7m
    l.N20 = s7n
    l.M21 = s8m
    l.N21 = s8n
    l.M22 = s9m
    l.N22 = s9n
    l.M23 = s10m
    l.N23 = s10n
    l.M24 = s11m
    l.N24 = s11n
    l.M25 = s12m
    l.N25 = s12n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M14 = (l.M14 ^ p0m) & 0xFFFFFFFF
    l.N14 = (l.N14 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M15 = (l.M15 ^ p1m) & 0xFFFFFFFF
    l.N15 = (l.N15 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M16 = (l.M16 ^ p2m) & 0xFFFFFFFF
    l.N16 = (l.N16 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s5m, s5n)
    l.M17 = (l.M17 ^ p3m) & 0xFFFFFFFF
    l.N17 = (l.N17 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s6m, s6n)
    l.M18 = (l.M18 ^ p4m) & 0xFFFFFFFF
    l.N18 = (l.N18 ^ p4n) & 0xFFFFFFFF
    var (p5m, p5n) = tmul2(s5m, s5n, s7m, s7n)
    l.M19 = (l.M19 ^ p5m) & 0xFFFFFFFF
    l.N19 = (l.N19 ^ p5n) & 0xFFFFFFFF
    var (p6m, p6n) = tmul2(s6m, s6n, s8m, s8n)
    l.M20 = (l.M20 ^ p6m) & 0xFFFFFFFF
    l.N20 = (l.N20 ^ p6n) & 0xFFFFFFFF
    var (p7m, p7n) = tmul2(s7m, s7n, s9m, s9n)
    l.M21 = (l.M21 ^ p7m) & 0xFFFFFFFF
    l.N21 = (l.N21 ^ p7n) & 0xFFFFFFFF
    var (p8m, p8n) = tmul2(s8m, s8n, s10m, s10n)
    l.M22 = (l.M22 ^ p8m) & 0xFFFFFFFF
    l.N22 = (l.N22 ^ p8n) & 0xFFFFFFFF
    var (p9m, p9n) = tmul2(s9m, s9n, s11m, s11n)
    l.M23 = (l.M23 ^ p9m) & 0xFFFFFFFF
    l.N23 = (l.N23 ^ p9n) & 0xFFFFFFFF
    var (p10m, p10n) = tmul2(s10m, s10n, s12m, s12n)
    l.M24 = (l.M24 ^ p10m) & 0xFFFFFFFF
    l.N24 = (l.N24 ^ p10n) & 0xFFFFFFFF
    var (p11m, p11n) = tmul2(s11m, s11n, s0m, s0n)
    l.M25 = (l.M25 ^ p11m) & 0xFFFFFFFF
    l.N25 = (l.N25 ^ p11n) & 0xFFFFFFFF
    var (p12m, p12n) = tmul2(s12m, s12n, s1m, s1n)
    l.M13 = (l.M13 ^ p12m) & 0xFFFFFFFF
    l.N13 = (l.N13 ^ p12n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M25 = (l.M25 ^ maj) & 0xFFFFFFFF
    l.N25 = (l.N25 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M13, l.N13, rrp(M0, mA), rrp(N0, mA))
    l.M13 = im
    l.N13 = in2
    var (jm, jn2) = tadd2(l.M14, l.N14, rrp(M1, (mA + 7) & 31), rrp(N1, (mA + 7) & 31))
    l.M14 = jm
    l.N14 = jn2
    l.M13 = (l.M13 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N25 = (l.N25 ^ rrp(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

