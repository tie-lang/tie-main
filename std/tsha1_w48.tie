func absorb26b(l: Lanes26b, Pw: Planes16, skey: i64) -> Lanes26b {
    var w: i64 = 0
    while w < 16 {
        var pv: i64 = 0
        if w == 0 {
            pv = Pw.w0
        } else if w == 1 {
            pv = Pw.w1
        } else if w == 2 {
            pv = Pw.w2
        } else if w == 3 {
            pv = Pw.w3
        } else if w == 4 {
            pv = Pw.w4
        } else if w == 5 {
            pv = Pw.w5
        } else if w == 6 {
            pv = Pw.w6
        } else if w == 7 {
            pv = Pw.w7
        } else if w == 8 {
            pv = Pw.w8
        } else if w == 9 {
            pv = Pw.w9
        } else if w == 10 {
            pv = Pw.w10
        } else if w == 11 {
            pv = Pw.w11
        } else if w == 12 {
            pv = Pw.w12
        } else if w == 13 {
            pv = Pw.w13
        } else if w == 14 {
            pv = Pw.w14
        } else {
            pv = Pw.w15
        }
        if pv != 0 {
            var a = (w * 5 + ((skey >> (w & 7)) & 7)) & 31
            var an = w % 26
            var v = rrp(pv, a)
            var v2 = rrp(pv, a + 17)
            if an == 0 {
                var (t0m, t0n) = tadd2(l.M0, l.N0, v, v2)
                l.M0 = t0m & 0xFFFFFFFF
                l.N0 = t0n & 0xFFFFFFFF
            } else if an == 1 {
                var (t1m, t1n) = tadd2(l.M1, l.N1, v, v2)
                l.M1 = t1m & 0xFFFFFFFF
                l.N1 = t1n & 0xFFFFFFFF
            } else if an == 2 {
                var (t2m, t2n) = tadd2(l.M2, l.N2, v, v2)
                l.M2 = t2m & 0xFFFFFFFF
                l.N2 = t2n & 0xFFFFFFFF
            } else if an == 3 {
                var (t3m, t3n) = tadd2(l.M3, l.N3, v, v2)
                l.M3 = t3m & 0xFFFFFFFF
                l.N3 = t3n & 0xFFFFFFFF
            } else if an == 4 {
                var (t4m, t4n) = tadd2(l.M4, l.N4, v, v2)
                l.M4 = t4m & 0xFFFFFFFF
                l.N4 = t4n & 0xFFFFFFFF
            } else if an == 5 {
                var (t5m, t5n) = tadd2(l.M5, l.N5, v, v2)
                l.M5 = t5m & 0xFFFFFFFF
                l.N5 = t5n & 0xFFFFFFFF
            } else if an == 6 {
                var (t6m, t6n) = tadd2(l.M6, l.N6, v, v2)
                l.M6 = t6m & 0xFFFFFFFF
                l.N6 = t6n & 0xFFFFFFFF
            } else if an == 7 {
                var (t7m, t7n) = tadd2(l.M7, l.N7, v, v2)
                l.M7 = t7m & 0xFFFFFFFF
                l.N7 = t7n & 0xFFFFFFFF
            } else if an == 8 {
                var (t8m, t8n) = tadd2(l.M8, l.N8, v, v2)
                l.M8 = t8m & 0xFFFFFFFF
                l.N8 = t8n & 0xFFFFFFFF
            } else if an == 9 {
                var (t9m, t9n) = tadd2(l.M9, l.N9, v, v2)
                l.M9 = t9m & 0xFFFFFFFF
                l.N9 = t9n & 0xFFFFFFFF
            } else if an == 10 {
                var (t10m, t10n) = tadd2(l.M10, l.N10, v, v2)
                l.M10 = t10m & 0xFFFFFFFF
                l.N10 = t10n & 0xFFFFFFFF
            } else if an == 11 {
                var (t11m, t11n) = tadd2(l.M11, l.N11, v, v2)
                l.M11 = t11m & 0xFFFFFFFF
                l.N11 = t11n & 0xFFFFFFFF
            } else if an == 12 {
                var (t12m, t12n) = tadd2(l.M12, l.N12, v, v2)
                l.M12 = t12m & 0xFFFFFFFF
                l.N12 = t12n & 0xFFFFFFFF
            } else if an == 13 {
                var (t13m, t13n) = tadd2(l.M13, l.N13, v, v2)
                l.M13 = t13m & 0xFFFFFFFF
                l.N13 = t13n & 0xFFFFFFFF
            } else if an == 14 {
                var (t14m, t14n) = tadd2(l.M14, l.N14, v, v2)
                l.M14 = t14m & 0xFFFFFFFF
                l.N14 = t14n & 0xFFFFFFFF
            } else if an == 15 {
                var (t15m, t15n) = tadd2(l.M15, l.N15, v, v2)
                l.M15 = t15m & 0xFFFFFFFF
                l.N15 = t15n & 0xFFFFFFFF
            } else if an == 16 {
                var (t16m, t16n) = tadd2(l.M16, l.N16, v, v2)
                l.M16 = t16m & 0xFFFFFFFF
                l.N16 = t16n & 0xFFFFFFFF
            } else if an == 17 {
                var (t17m, t17n) = tadd2(l.M17, l.N17, v, v2)
                l.M17 = t17m & 0xFFFFFFFF
                l.N17 = t17n & 0xFFFFFFFF
            } else if an == 18 {
                var (t18m, t18n) = tadd2(l.M18, l.N18, v, v2)
                l.M18 = t18m & 0xFFFFFFFF
                l.N18 = t18n & 0xFFFFFFFF
            } else if an == 19 {
                var (t19m, t19n) = tadd2(l.M19, l.N19, v, v2)
                l.M19 = t19m & 0xFFFFFFFF
                l.N19 = t19n & 0xFFFFFFFF
            } else if an == 20 {
                var (t20m, t20n) = tadd2(l.M20, l.N20, v, v2)
                l.M20 = t20m & 0xFFFFFFFF
                l.N20 = t20n & 0xFFFFFFFF
            } else if an == 21 {
                var (t21m, t21n) = tadd2(l.M21, l.N21, v, v2)
                l.M21 = t21m & 0xFFFFFFFF
                l.N21 = t21n & 0xFFFFFFFF
            } else if an == 22 {
                var (t22m, t22n) = tadd2(l.M22, l.N22, v, v2)
                l.M22 = t22m & 0xFFFFFFFF
                l.N22 = t22n & 0xFFFFFFFF
            } else if an == 23 {
                var (t23m, t23n) = tadd2(l.M23, l.N23, v, v2)
                l.M23 = t23m & 0xFFFFFFFF
                l.N23 = t23n & 0xFFFFFFFF
            } else if an == 24 {
                var (t24m, t24n) = tadd2(l.M24, l.N24, v, v2)
                l.M24 = t24m & 0xFFFFFFFF
                l.N24 = t24n & 0xFFFFFFFF
            } else {
                var (t25m, t25n) = tadd2(l.M25, l.N25, v, v2)
                l.M25 = t25m & 0xFFFFFFFF
                l.N25 = t25n & 0xFFFFFFFF
            }
        }
        w = w + 1
    }
    return l
}

func fin_synth26b(h: ref table<i64>) {
    var l = Lanes26b()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp(h[1], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp(h[2], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp(h[3], 7)
    l.M3 = h[3] & 0xFFFFFFFF
    l.N3 = rrp(h[4], 7)
    l.M4 = h[4] & 0xFFFFFFFF
    l.N4 = rrp(h[5], 7)
    l.M5 = h[5] & 0xFFFFFFFF
    l.N5 = rrp(h[6], 7)
    l.M6 = h[6] & 0xFFFFFFFF
    l.N6 = rrp(h[7], 7)
    l.M7 = h[7] & 0xFFFFFFFF
    l.N7 = rrp(h[8], 7)
    l.M8 = h[8] & 0xFFFFFFFF
    l.N8 = rrp(h[9], 7)
    l.M9 = h[9] & 0xFFFFFFFF
    l.N9 = rrp(h[10], 7)
    l.M10 = h[10] & 0xFFFFFFFF
    l.N10 = rrp(h[11], 7)
    l.M11 = h[11] & 0xFFFFFFFF
    l.N11 = rrp(h[12], 7)
    l.M12 = h[12] & 0xFFFFFFFF
    l.N12 = rrp(h[13], 7)
    l.M13 = h[13] & 0xFFFFFFFF
    l.N13 = rrp(h[14], 7)
    l.M14 = h[14] & 0xFFFFFFFF
    l.N14 = rrp(h[15], 7)
    l.M15 = h[15] & 0xFFFFFFFF
    l.N15 = rrp(h[16], 7)
    l.M16 = h[16] & 0xFFFFFFFF
    l.N16 = rrp(h[17], 7)
    l.M17 = h[17] & 0xFFFFFFFF
    l.N17 = rrp(h[18], 7)
    l.M18 = h[18] & 0xFFFFFFFF
    l.N18 = rrp(h[19], 7)
    l.M19 = h[19] & 0xFFFFFFFF
    l.N19 = rrp(h[20], 7)
    l.M20 = h[20] & 0xFFFFFFFF
    l.N20 = rrp(h[21], 7)
    l.M21 = h[21] & 0xFFFFFFFF
    l.N21 = rrp(h[22], 7)
    l.M22 = h[22] & 0xFFFFFFFF
    l.N22 = rrp(h[23], 7)
    l.M23 = h[23] & 0xFFFFFFFF
    l.N23 = rrp(h[24], 7)
    l.M24 = h[24] & 0xFFFFFFFF
    l.N24 = rrp(h[25], 7)
    l.M25 = h[25] & 0xFFFFFFFF
    l.N25 = rrp(h[0], 7)
    var sf: i64 = 0
    while sf < 4 {
        l = ring26b_mixF(l, sf, 0x13579BDF)
        sf = sf + 1
    }
    h[0] = (l.M0 ^ rrp(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (l.M1 ^ rrp(l.N1, 5)) & 0xFFFFFFFF
    h[2] = (l.M2 ^ rrp(l.N2, 10)) & 0xFFFFFFFF
    h[3] = (l.M3 ^ rrp(l.N3, 15)) & 0xFFFFFFFF
    h[4] = (l.M4 ^ rrp(l.N4, 20)) & 0xFFFFFFFF
    h[5] = (l.M5 ^ rrp(l.N5, 25)) & 0xFFFFFFFF
    h[6] = (l.M6 ^ rrp(l.N6, 30)) & 0xFFFFFFFF
    h[7] = (l.M7 ^ rrp(l.N7, 3)) & 0xFFFFFFFF
    h[8] = (l.M8 ^ rrp(l.N8, 8)) & 0xFFFFFFFF
    h[9] = (l.M9 ^ rrp(l.N9, 13)) & 0xFFFFFFFF
    h[10] = (l.M10 ^ rrp(l.N10, 18)) & 0xFFFFFFFF
    h[11] = (l.M11 ^ rrp(l.N11, 23)) & 0xFFFFFFFF
    h[12] = (l.M12 ^ rrp(l.N12, 28)) & 0xFFFFFFFF
    h[13] = (l.M13 ^ rrp(l.N13, 1)) & 0xFFFFFFFF
    h[14] = (l.M14 ^ rrp(l.N14, 6)) & 0xFFFFFFFF
    h[15] = (l.M15 ^ rrp(l.N15, 11)) & 0xFFFFFFFF
    h[16] = (l.M16 ^ rrp(l.N16, 16)) & 0xFFFFFFFF
    h[17] = (l.M17 ^ rrp(l.N17, 21)) & 0xFFFFFFFF
    h[18] = (l.M18 ^ rrp(l.N18, 26)) & 0xFFFFFFFF
    h[19] = (l.M19 ^ rrp(l.N19, 31)) & 0xFFFFFFFF
    h[20] = (l.M20 ^ rrp(l.N20, 4)) & 0xFFFFFFFF
    h[21] = (l.M21 ^ rrp(l.N21, 9)) & 0xFFFFFFFF
    h[22] = (l.M22 ^ rrp(l.N22, 14)) & 0xFFFFFFFF
    h[23] = (l.M23 ^ rrp(l.N23, 19)) & 0xFFFFFFFF
    h[24] = (l.M24 ^ rrp(l.N24, 24)) & 0xFFFFFFFF
    h[25] = (l.M25 ^ rrp(l.N25, 29)) & 0xFFFFFFFF
}

pub func compress_w26b(h: ref table<i64>, msg: string, pos: i64, nbytes: i64,
            t_lo: i64, t_hi: i64, last: bool,
            iv: table<i64>, rcon: table<i64>, bcon: table<i64>, R: i64) {
    var (M0, N0, M1, N1, Pw, skey) = w48_planes_skey(msg, pos, nbytes)
    var l = Lanes26b()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp(h[13], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp(h[14], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp(h[15], 7)
    l.M3 = h[3] & 0xFFFFFFFF
    l.N3 = rrp(h[16], 7)
    l.M4 = h[4] & 0xFFFFFFFF
    l.N4 = rrp(h[17], 7)
    l.M5 = h[5] & 0xFFFFFFFF
    l.N5 = rrp(h[18], 7)
    l.M6 = h[6] & 0xFFFFFFFF
    l.N6 = rrp(h[19], 7)
    l.M7 = h[7] & 0xFFFFFFFF
    l.N7 = rrp(h[20], 7)
    l.M8 = h[8] & 0xFFFFFFFF
    l.N8 = rrp(h[21], 7)
    l.M9 = h[9] & 0xFFFFFFFF
    l.N9 = rrp(h[22], 7)
    l.M10 = h[10] & 0xFFFFFFFF
    l.N10 = rrp(h[23], 7)
    l.M11 = h[11] & 0xFFFFFFFF
    l.N11 = rrp(h[24], 7)
    l.M12 = h[12] & 0xFFFFFFFF
    l.N12 = rrp(h[25], 7)
    l.M13 = h[13] & 0xFFFFFFFF
    l.N13 = rrp(h[0], 7)
    l.M14 = h[14] & 0xFFFFFFFF
    l.N14 = rrp(h[1], 7)
    l.M15 = h[15] & 0xFFFFFFFF
    l.N15 = rrp(h[2], 7)
    l.M16 = h[16] & 0xFFFFFFFF
    l.N16 = rrp(h[3], 7)
    l.M17 = h[17] & 0xFFFFFFFF
    l.N17 = rrp(h[4], 7)
    l.M18 = h[18] & 0xFFFFFFFF
    l.N18 = rrp(h[5], 7)
    l.M19 = h[19] & 0xFFFFFFFF
    l.N19 = rrp(h[6], 7)
    l.M20 = h[20] & 0xFFFFFFFF
    l.N20 = rrp(h[7], 7)
    l.M21 = h[21] & 0xFFFFFFFF
    l.N21 = rrp(h[8], 7)
    l.M22 = h[22] & 0xFFFFFFFF
    l.N22 = rrp(h[9], 7)
    l.M23 = h[23] & 0xFFFFFFFF
    l.N23 = rrp(h[10], 7)
    l.M24 = h[24] & 0xFFFFFFFF
    l.N24 = rrp(h[11], 7)
    l.M25 = h[25] & 0xFFFFFFFF
    l.N25 = rrp(h[12], 7)
    l.M0 = (l.M0 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M1 = (l.M1 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M2 = (l.M2 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M3 = (l.M3 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M4 = (l.M4 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M5 = (l.M5 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M6 = (l.M6 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M7 = (l.M7 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M8 = (l.M8 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M9 = (l.M9 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N9 = (l.N9 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M10 = (l.M10 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M11 = (l.M11 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M12 = (l.M12 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N12 = (l.N12 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M13 = (l.M13 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N13 = (l.N13 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M14 = (l.M14 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N14 = (l.N14 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M15 = (l.M15 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N15 = (l.N15 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M16 = (l.M16 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N16 = (l.N16 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M17 = (l.M17 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N17 = (l.N17 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M18 = (l.M18 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N18 = (l.N18 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M19 = (l.M19 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N19 = (l.N19 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M20 = (l.M20 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N20 = (l.N20 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M21 = (l.M21 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N21 = (l.N21 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M22 = (l.M22 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N22 = (l.N22 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M23 = (l.M23 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N23 = (l.N23 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M24 = (l.M24 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N24 = (l.N24 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M25 = (l.M25 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N25 = (l.N25 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (t_lo & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N13 = (l.N13 ^ (t_hi & 0xFFFFFFFF)) & 0xFFFFFFFF
    if last {
        l.N13 = (l.N13 ^ 0xFFFFFFFF) & 0xFFFFFFFF
    }
    l = absorb26b(l, Pw, skey)
    var mA: i64 = 0
    var mC: i64 = 0
    var r: i64 = 0
    while r < R {
        mA = (r * 5 + ((skey >> 6) & 7)) & 31
        mC = (r * 7 + ((skey >> 12) & 7)) & 31
        l = ring26b_mixA(l, r, skey, M0, N0, M1, N1, mA, rcon, r)
        l = ring26b_mixB(l, r, skey, M0, N0, M1, N1, mC, rcon, (r + 8) & 15)
        l = ring26b_sponge_r(l, r, skey, M0, N0, M1, N1, mA, bcon, (r + 3) & 15)
        l = ring26b_sponge_c(l, r, skey, bcon, (r + 11) & 15)
            var (sm, sn) = tadd2(l.M0, l.N0, l.M18, l.N18)
    l.M0 = sm
    l.N0 = sn
    var (pm, pn) = tmul2(l.M0, l.N0, l.M18, l.N18)
    l.M18 = (l.M18 ^ pm) & 0xFFFFFFFF
    l.N18 = (l.N18 ^ pn) & 0xFFFFFFFF
            var (sm, sn) = tadd2(l.M9, l.N9, l.M19, l.N19)
    l.M9 = sm
    l.N9 = sn
    var (pm, pn) = tmul2(l.M9, l.N9, l.M19, l.N19)
    l.M19 = (l.M19 ^ pm) & 0xFFFFFFFF
    l.N19 = (l.N19 ^ pn) & 0xFFFFFFFF
            var (sm, sn) = tadd2(l.M1, l.N1, l.M22, l.N22)
    l.M1 = sm
    l.N1 = sn
    var (pm, pn) = tmul2(l.M1, l.N1, l.M22, l.N22)
    l.M22 = (l.M22 ^ pm) & 0xFFFFFFFF
    l.N22 = (l.N22 ^ pn) & 0xFFFFFFFF
            var (sm, sn) = tadd2(l.M10, l.N10, l.M23, l.N23)
    l.M10 = sm
    l.N10 = sn
    var (pm, pn) = tmul2(l.M10, l.N10, l.M23, l.N23)
    l.M23 = (l.M23 ^ pm) & 0xFFFFFFFF
    l.N23 = (l.N23 ^ pn) & 0xFFFFFFFF
        r = r + 1
    }
    h[0] = (h[0] ^ l.M0 ^ rrp(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (h[1] ^ l.M1 ^ rrp(l.N1, 3)) & 0xFFFFFFFF
    h[2] = (h[2] ^ l.M2 ^ rrp(l.N2, 6)) & 0xFFFFFFFF
    h[3] = (h[3] ^ l.M3 ^ rrp(l.N3, 9)) & 0xFFFFFFFF
    h[4] = (h[4] ^ l.M4 ^ rrp(l.N4, 12)) & 0xFFFFFFFF
    h[5] = (h[5] ^ l.M5 ^ rrp(l.N5, 15)) & 0xFFFFFFFF
    h[6] = (h[6] ^ l.M6 ^ rrp(l.N6, 18)) & 0xFFFFFFFF
    h[7] = (h[7] ^ l.M7 ^ rrp(l.N7, 21)) & 0xFFFFFFFF
    h[8] = (h[8] ^ l.M8 ^ rrp(l.N8, 24)) & 0xFFFFFFFF
    h[9] = (h[9] ^ l.M9 ^ rrp(l.N9, 27)) & 0xFFFFFFFF
    h[10] = (h[10] ^ l.M10 ^ rrp(l.N10, 30)) & 0xFFFFFFFF
    h[11] = (h[11] ^ l.M11 ^ rrp(l.N11, 1)) & 0xFFFFFFFF
    h[12] = (h[12] ^ l.M12 ^ rrp(l.N12, 4)) & 0xFFFFFFFF
    h[13] = (h[13] ^ l.M13 ^ rrp(l.N13, 7)) & 0xFFFFFFFF
    h[14] = (h[14] ^ l.M14 ^ rrp(l.N14, 10)) & 0xFFFFFFFF
    h[15] = (h[15] ^ l.M15 ^ rrp(l.N15, 13)) & 0xFFFFFFFF
    h[16] = (h[16] ^ l.M16 ^ rrp(l.N16, 16)) & 0xFFFFFFFF
    h[17] = (h[17] ^ l.M17 ^ rrp(l.N17, 19)) & 0xFFFFFFFF
    h[18] = (h[18] ^ l.M18 ^ rrp(l.N18, 22)) & 0xFFFFFFFF
    h[19] = (h[19] ^ l.M19 ^ rrp(l.N19, 25)) & 0xFFFFFFFF
    h[20] = (h[20] ^ l.M20 ^ rrp(l.N20, 28)) & 0xFFFFFFFF
    h[21] = (h[21] ^ l.M21 ^ rrp(l.N21, 31)) & 0xFFFFFFFF
    h[22] = (h[22] ^ l.M22 ^ rrp(l.N22, 2)) & 0xFFFFFFFF
    h[23] = (h[23] ^ l.M23 ^ rrp(l.N23, 5)) & 0xFFFFFFFF
    h[24] = (h[24] ^ l.M24 ^ rrp(l.N24, 8)) & 0xFFFFFFFF
    h[25] = (h[25] ^ l.M25 ^ rrp(l.N25, 11)) & 0xFFFFFFFF
    fin_synth26b(h)
}

// === W=16 四轨特化内核（x，n=88/92/96/128/144）——轨A[0..5)、轨B[5..10)、海绵[10..15) rate4=3、LFSR[15..16)；R=16 ===
struct Lanes16x {
    var M0: i64 = 0
    var N0: i64 = 0
    var M1: i64 = 0
    var N1: i64 = 0
    var M2: i64 = 0
    var N2: i64 = 0
    var M3: i64 = 0
    var N3: i64 = 0
    var M4: i64 = 0
    var N4: i64 = 0
    var M5: i64 = 0
    var N5: i64 = 0
    var M6: i64 = 0
    var N6: i64 = 0
    var M7: i64 = 0
    var N7: i64 = 0
    var M8: i64 = 0
    var N8: i64 = 0
    var M9: i64 = 0
    var N9: i64 = 0
    var M10: i64 = 0
    var N10: i64 = 0
    var M11: i64 = 0
    var N11: i64 = 0
    var M12: i64 = 0
    var N12: i64 = 0
    var M13: i64 = 0
    var N13: i64 = 0
    var M14: i64 = 0
    var N14: i64 = 0
    var M15: i64 = 0
    var N15: i64 = 0
}

func ring16x_mixA(l: Lanes16x, r: i64
            , skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes16x {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0,
                    rrp(l.M2, rA), rrp(l.N2, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp(l.M3, (rB + 3) & 31), rrp(l.N3, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1,
                    rrp(l.M3, (rA + 5) & 31), rrp(l.N3, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp(l.M4, (rB + 10) & 31), rrp(l.N4, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M2, l.N2,
                    rrp(l.M4, (rA + 10) & 31), rrp(l.N4, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp(l.M0, (rB + 17) & 31), rrp(l.N0, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M3, l.N3,
                    rrp(l.M0, (rA + 15) & 31), rrp(l.N0, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp(l.M1, (rB + 24) & 31), rrp(l.N1, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M4, l.N4,
                    rrp(l.M1, (rA + 20) & 31), rrp(l.N1, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp(l.M2, (rB + 31) & 31), rrp(l.N2, (rB + 31) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    l.M2 = s2m
    l.N2 = s2n
    l.M3 = s3m
    l.N3 = s3n
    l.M4 = s4m
    l.N4 = s4n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M2 = (l.M2 ^ p1m) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M3 = (l.M3 ^ p2m) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s0m, s0n)
    l.M4 = (l.M4 ^ p3m) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s1m, s1n)
    l.M0 = (l.M0 ^ p4m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p4n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M4 = (l.M4 ^ maj) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M0, l.N0, rrp(M0, mA), rrp(N0, mA))
    l.M0 = im
    l.N0 = in2
    var (jm, jn2) = tadd2(l.M1, l.N1, rrp(M1, (mA + 7) & 31), rrp(N1, (mA + 7) & 31))
    l.M1 = jm
    l.N1 = jn2
    l.M0 = (l.M0 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ rrp(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

func ring16x_mixB(l: Lanes16x, r: i64
            , skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes16x {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M5, l.N5,
                    rrp(l.M7, rA), rrp(l.N7, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp(l.M8, (rB + 3) & 31), rrp(l.N8, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M6, l.N6,
                    rrp(l.M8, (rA + 5) & 31), rrp(l.N8, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp(l.M9, (rB + 10) & 31), rrp(l.N9, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M7, l.N7,
                    rrp(l.M9, (rA + 10) & 31), rrp(l.N9, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp(l.M5, (rB + 17) & 31), rrp(l.N5, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M8, l.N8,
                    rrp(l.M5, (rA + 15) & 31), rrp(l.N5, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp(l.M6, (rB + 24) & 31), rrp(l.N6, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M9, l.N9,
                    rrp(l.M6, (rA + 20) & 31), rrp(l.N6, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp(l.M7, (rB + 31) & 31), rrp(l.N7, (rB + 31) & 31))
    l.M5 = s0m
    l.N5 = s0n
    l.M6 = s1m
    l.N6 = s1n
    l.M7 = s2m
    l.N7 = s2n
    l.M8 = s3m
    l.N8 = s3n
    l.M9 = s4m
    l.N9 = s4n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M6 = (l.M6 ^ p0m) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M7 = (l.M7 ^ p1m) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M8 = (l.M8 ^ p2m) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s0m, s0n)
    l.M9 = (l.M9 ^ p3m) & 0xFFFFFFFF
    l.N9 = (l.N9 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s1m, s1n)
    l.M5 = (l.M5 ^ p4m) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ p4n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M9 = (l.M9 ^ maj) & 0xFFFFFFFF
    l.N9 = (l.N9 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M5, l.N5, rrp(M0, mA), rrp(N0, mA))
    l.M5 = im
    l.N5 = in2
    var (jm, jn2) = tadd2(l.M6, l.N6, rrp(M1, (mA + 7) & 31), rrp(N1, (mA + 7) & 31))
    l.M6 = jm
    l.N6 = jn2
    l.M5 = (l.M5 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N9 = (l.N9 ^ rrp(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

func ring16x_sponge_r(l: Lanes16x, r: i64
