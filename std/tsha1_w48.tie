    var (q17m, q17n) = tadd2(l.M17, l.N17,
                    rrp16(l.M19, (rA + 21) & 31), rrp16(l.N19, (rA + 21) & 31))
    var (s17m, s17n) = tadd2(q17m, q17n,
                    rrp16(l.M20, (rB + 26) & 31), rrp16(l.N20, (rB + 26) & 31))
    var (q18m, q18n) = tadd2(l.M18, l.N18,
