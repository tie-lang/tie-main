    l.N9 = (l.N9 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M10 = (l.M10 ^ p2m) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s5m, s5n)
    l.M11 = (l.M11 ^ p3m) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s6m, s6n)
    l.M12 = (l.M12 ^ p4m) & 0xFFFFFFFF
    l.N12 = (l.N12 ^ p4n) & 0xFFFFFFFF
    var (p5m, p5n) = tmul2(s5m, s5n, s0m, s0n)
    l.M13 = (l.M13 ^ p5m) & 0xFFFFFFFF
    l.N13 = (l.N13 ^ p5n) & 0xFFFFFFFF
