    l.N7 = s7n
    l.M8 = s8m
    l.N8 = s8n
    l.M9 = s9m
    l.N9 = s9n
    l.M10 = s10m
    l.N10 = s10n
    l.M11 = s11m
    l.N11 = s11n
    l.M12 = s12m
    l.N12 = s12n
    l.M13 = s13m
    l.N13 = s13n
    l.M14 = s14m
    l.N14 = s14n
    l.M15 = s15m
    l.N15 = s15n
    l.M16 = s16m
    l.N16 = s16n
    l.M17 = s17m
