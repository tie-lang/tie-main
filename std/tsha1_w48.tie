                    rrp(l.M11, (rA + 10) & 31), rrp(l.N11, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp(l.M12, (rB + 17) & 31), rrp(l.N12, (rB + 17) & 31))
