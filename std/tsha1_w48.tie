    l.N9 = (l.N9 ^ p8n) & 0xFFFFFFFF
    var (p9m, p9n) = tmul2(s9m, s9n, s11m, s11n)
    l.M10 = (l.M10 ^ p9m) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ p9n) & 0xFFFFFFFF
    var (p10m, p10n) = tmul2(s10m, s10n, s12m, s12n)
    l.M11 = (l.M11 ^ p10m) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ p10n) & 0xFFFFFFFF
    var (p11m, p11n) = tmul2(s11m, s11n, s13m, s13n)
    l.M12 = (l.M12 ^ p11m) & 0xFFFFFFFF
    l.N12 = (l.N12 ^ p11n) & 0xFFFFFFFF
    var (p12m, p12n) = tmul2(s12m, s12n, s14m, s14n)
    l.M13 = (l.M13 ^ p12m) & 0xFFFFFFFF
    l.N13 = (l.N13 ^ p12n) & 0xFFFFFFFF
    var (p13m, p13n) = tmul2(s13m, s13n, s15m, s15n)
    l.M14 = (l.M14 ^ p13m) & 0xFFFFFFFF
    l.N14 = (l.N14 ^ p13n) & 0xFFFFFFFF
    var (p14m, p14n) = tmul2(s14m, s14n, s16m, s16n)
    l.M15 = (l.M15 ^ p14m) & 0xFFFFFFFF
    l.N15 = (l.N15 ^ p14n) & 0xFFFFFFFF
    var (p15m, p15n) = tmul2(s15m, s15n, s17m, s17n)
    l.M16 = (l.M16 ^ p15m) & 0xFFFFFFFF
    l.N16 = (l.N16 ^ p15n) & 0xFFFFFFFF
    var (p16m, p16n) = tmul2(s16m, s16n, s18m, s18n)
    l.M17 = (l.M17 ^ p16m) & 0xFFFFFFFF
    l.N17 = (l.N17 ^ p16n) & 0xFFFFFFFF
    var (p17m, p17n) = tmul2(s17m, s17n, s19m, s19n)
    l.M18 = (l.M18 ^ p17m) & 0xFFFFFFFF
    l.N18 = (l.N18 ^ p17n) & 0xFFFFFFFF
    var (p18m, p18n) = tmul2(s18m, s18n, s20m, s20n)
    l.M19 = (l.M19 ^ p18m) & 0xFFFFFFFF
    l.N19 = (l.N19 ^ p18n) & 0xFFFFFFFF
    var (p19m, p19n) = tmul2(s19m, s19n, s21m, s21n)
    l.M20 = (l.M20 ^ p19m) & 0xFFFFFFFF
    l.N20 = (l.N20 ^ p19n) & 0xFFFFFFFF
    var (p20m, p20n) = tmul2(s20m, s20n, s22m, s22n)
    l.M21 = (l.M21 ^ p20m) & 0xFFFFFFFF
    l.N21 = (l.N21 ^ p20n) & 0xFFFFFFFF
    var (p21m, p21n) = tmul2(s21m, s21n, s23m, s23n)
    l.M22 = (l.M22 ^ p21m) & 0xFFFFFFFF
    l.N22 = (l.N22 ^ p21n) & 0xFFFFFFFF
    var (p22m, p22n) = tmul2(s22m, s22n, s24m, s24n)
    l.M23 = (l.M23 ^ p22m) & 0xFFFFFFFF
    l.N23 = (l.N23 ^ p22n) & 0xFFFFFFFF
    var (p23m, p23n) = tmul2(s23m, s23n, s25m, s25n)
    l.M24 = (l.M24 ^ p23m) & 0xFFFFFFFF
    l.N24 = (l.N24 ^ p23n) & 0xFFFFFFFF
    var (p24m, p24n) = tmul2(s24m, s24n, s0m, s0n)
    l.M25 = (l.M25 ^ p24m) & 0xFFFFFFFF
    l.N25 = (l.N25 ^ p24n) & 0xFFFFFFFF
    var (p25m, p25n) = tmul2(s25m, s25n, s1m, s1n)
    l.M0 = (l.M0 ^ p25m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p25n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M25 = (l.M25 ^ maj) & 0xFFFFFFFF
    l.N25 = (l.N25 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    return l
}

func absorb26(l: Lanes26, Pw: Planes16, skey: i64) -> Lanes26 {
    var w: i64 = 0
    while w < 16 {
        var pv: i64 = 0
        if w == 0 {
            pv = Pw.w0
        } else if w == 1 {
            pv = Pw.w1
        } else if w == 2 {
            pv = Pw.w2
        } else if w == 3 {
            pv = Pw.w3
        } else if w == 4 {
            pv = Pw.w4
        } else if w == 5 {
            pv = Pw.w5
        } else if w == 6 {
            pv = Pw.w6
        } else if w == 7 {
            pv = Pw.w7
        } else if w == 8 {
            pv = Pw.w8
        } else if w == 9 {
            pv = Pw.w9
        } else if w == 10 {
            pv = Pw.w10
        } else if w == 11 {
            pv = Pw.w11
        } else if w == 12 {
            pv = Pw.w12
        } else if w == 13 {
            pv = Pw.w13
        } else if w == 14 {
            pv = Pw.w14
        } else {
            pv = Pw.w15
        }
        if pv != 0 {
            var a = (w * 5 + ((skey >> (w & 7)) & 7)) & 31
            var an = w % 26
            var v = rrp(pv, a)
            var v2 = rrp(pv, a + 17)
            if an == 0 {
                var (t0m, t0n) = tadd2(l.M0, l.N0, v, v2)
                l.M0 = t0m & 0xFFFFFFFF
                l.N0 = t0n & 0xFFFFFFFF
            } else if an == 1 {
                var (t1m, t1n) = tadd2(l.M1, l.N1, v, v2)
                l.M1 = t1m & 0xFFFFFFFF
                l.N1 = t1n & 0xFFFFFFFF
            } else if an == 2 {
                var (t2m, t2n) = tadd2(l.M2, l.N2, v, v2)
                l.M2 = t2m & 0xFFFFFFFF
                l.N2 = t2n & 0xFFFFFFFF
            } else if an == 3 {
                var (t3m, t3n) = tadd2(l.M3, l.N3, v, v2)
                l.M3 = t3m & 0xFFFFFFFF
                l.N3 = t3n & 0xFFFFFFFF
            } else if an == 4 {
                var (t4m, t4n) = tadd2(l.M4, l.N4, v, v2)
                l.M4 = t4m & 0xFFFFFFFF
                l.N4 = t4n & 0xFFFFFFFF
            } else if an == 5 {
                var (t5m, t5n) = tadd2(l.M5, l.N5, v, v2)
                l.M5 = t5m & 0xFFFFFFFF
                l.N5 = t5n & 0xFFFFFFFF
            } else if an == 6 {
                var (t6m, t6n) = tadd2(l.M6, l.N6, v, v2)
                l.M6 = t6m & 0xFFFFFFFF
                l.N6 = t6n & 0xFFFFFFFF
            } else if an == 7 {
                var (t7m, t7n) = tadd2(l.M7, l.N7, v, v2)
                l.M7 = t7m & 0xFFFFFFFF
                l.N7 = t7n & 0xFFFFFFFF
            } else if an == 8 {
                var (t8m, t8n) = tadd2(l.M8, l.N8, v, v2)
                l.M8 = t8m & 0xFFFFFFFF
                l.N8 = t8n & 0xFFFFFFFF
            } else if an == 9 {
                var (t9m, t9n) = tadd2(l.M9, l.N9, v, v2)
                l.M9 = t9m & 0xFFFFFFFF
                l.N9 = t9n & 0xFFFFFFFF
            } else if an == 10 {
                var (t10m, t10n) = tadd2(l.M10, l.N10, v, v2)
                l.M10 = t10m & 0xFFFFFFFF
                l.N10 = t10n & 0xFFFFFFFF
            } else if an == 11 {
                var (t11m, t11n) = tadd2(l.M11, l.N11, v, v2)
                l.M11 = t11m & 0xFFFFFFFF
                l.N11 = t11n & 0xFFFFFFFF
            } else if an == 12 {
                var (t12m, t12n) = tadd2(l.M12, l.N12, v, v2)
                l.M12 = t12m & 0xFFFFFFFF
                l.N12 = t12n & 0xFFFFFFFF
            } else if an == 13 {
                var (t13m, t13n) = tadd2(l.M13, l.N13, v, v2)
                l.M13 = t13m & 0xFFFFFFFF
                l.N13 = t13n & 0xFFFFFFFF
            } else if an == 14 {
                var (t14m, t14n) = tadd2(l.M14, l.N14, v, v2)
                l.M14 = t14m & 0xFFFFFFFF
                l.N14 = t14n & 0xFFFFFFFF
            } else if an == 15 {
                var (t15m, t15n) = tadd2(l.M15, l.N15, v, v2)
                l.M15 = t15m & 0xFFFFFFFF
                l.N15 = t15n & 0xFFFFFFFF
            } else if an == 16 {
                var (t16m, t16n) = tadd2(l.M16, l.N16, v, v2)
                l.M16 = t16m & 0xFFFFFFFF
                l.N16 = t16n & 0xFFFFFFFF
            } else if an == 17 {
                var (t17m, t17n) = tadd2(l.M17, l.N17, v, v2)
                l.M17 = t17m & 0xFFFFFFFF
                l.N17 = t17n & 0xFFFFFFFF
            } else if an == 18 {
                var (t18m, t18n) = tadd2(l.M18, l.N18, v, v2)
                l.M18 = t18m & 0xFFFFFFFF
                l.N18 = t18n & 0xFFFFFFFF
            } else if an == 19 {
                var (t19m, t19n) = tadd2(l.M19, l.N19, v, v2)
                l.M19 = t19m & 0xFFFFFFFF
                l.N19 = t19n & 0xFFFFFFFF
            } else if an == 20 {
                var (t20m, t20n) = tadd2(l.M20, l.N20, v, v2)
                l.M20 = t20m & 0xFFFFFFFF
                l.N20 = t20n & 0xFFFFFFFF
            } else if an == 21 {
                var (t21m, t21n) = tadd2(l.M21, l.N21, v, v2)
                l.M21 = t21m & 0xFFFFFFFF
                l.N21 = t21n & 0xFFFFFFFF
            } else if an == 22 {
                var (t22m, t22n) = tadd2(l.M22, l.N22, v, v2)
                l.M22 = t22m & 0xFFFFFFFF
                l.N22 = t22n & 0xFFFFFFFF
            } else if an == 23 {
                var (t23m, t23n) = tadd2(l.M23, l.N23, v, v2)
                l.M23 = t23m & 0xFFFFFFFF
                l.N23 = t23n & 0xFFFFFFFF
            } else if an == 24 {
                var (t24m, t24n) = tadd2(l.M24, l.N24, v, v2)
                l.M24 = t24m & 0xFFFFFFFF
                l.N24 = t24n & 0xFFFFFFFF
            } else {
                var (t25m, t25n) = tadd2(l.M25, l.N25, v, v2)
                l.M25 = t25m & 0xFFFFFFFF
                l.N25 = t25n & 0xFFFFFFFF
            }
        }
        w = w + 1
    }
    return l
}

func fin_synth26(h: ref table<i64>) {
    var l = Lanes26()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp(h[1], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp(h[2], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp(h[3], 7)
    l.M3 = h[3] & 0xFFFFFFFF
    l.N3 = rrp(h[4], 7)
    l.M4 = h[4] & 0xFFFFFFFF
    l.N4 = rrp(h[5], 7)
    l.M5 = h[5] & 0xFFFFFFFF
    l.N5 = rrp(h[6], 7)
    l.M6 = h[6] & 0xFFFFFFFF
    l.N6 = rrp(h[7], 7)
    l.M7 = h[7] & 0xFFFFFFFF
    l.N7 = rrp(h[8], 7)
    l.M8 = h[8] & 0xFFFFFFFF
    l.N8 = rrp(h[9], 7)
    l.M9 = h[9] & 0xFFFFFFFF
    l.N9 = rrp(h[10], 7)
    l.M10 = h[10] & 0xFFFFFFFF
    l.N10 = rrp(h[11], 7)
    l.M11 = h[11] & 0xFFFFFFFF
    l.N11 = rrp(h[12], 7)
    l.M12 = h[12] & 0xFFFFFFFF
    l.N12 = rrp(h[13], 7)
    l.M13 = h[13] & 0xFFFFFFFF
    l.N13 = rrp(h[14], 7)
    l.M14 = h[14] & 0xFFFFFFFF
    l.N14 = rrp(h[15], 7)
    l.M15 = h[15] & 0xFFFFFFFF
    l.N15 = rrp(h[16], 7)
    l.M16 = h[16] & 0xFFFFFFFF
    l.N16 = rrp(h[17], 7)
    l.M17 = h[17] & 0xFFFFFFFF
    l.N17 = rrp(h[18], 7)
    l.M18 = h[18] & 0xFFFFFFFF
    l.N18 = rrp(h[19], 7)
    l.M19 = h[19] & 0xFFFFFFFF
    l.N19 = rrp(h[20], 7)
    l.M20 = h[20] & 0xFFFFFFFF
    l.N20 = rrp(h[21], 7)
    l.M21 = h[21] & 0xFFFFFFFF
    l.N21 = rrp(h[22], 7)
    l.M22 = h[22] & 0xFFFFFFFF
    l.N22 = rrp(h[23], 7)
    l.M23 = h[23] & 0xFFFFFFFF
    l.N23 = rrp(h[24], 7)
    l.M24 = h[24] & 0xFFFFFFFF
    l.N24 = rrp(h[25], 7)
    l.M25 = h[25] & 0xFFFFFFFF
    l.N25 = rrp(h[0], 7)
    var sf: i64 = 0
    while sf < 4 {
        l = ring26_mixF(l, sf, 0x13579BDF)
        sf = sf + 1
    }
    h[0] = (l.M0 ^ rrp(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (l.M1 ^ rrp(l.N1, 5)) & 0xFFFFFFFF
    h[2] = (l.M2 ^ rrp(l.N2, 10)) & 0xFFFFFFFF
    h[3] = (l.M3 ^ rrp(l.N3, 15)) & 0xFFFFFFFF
    h[4] = (l.M4 ^ rrp(l.N4, 20)) & 0xFFFFFFFF
    h[5] = (l.M5 ^ rrp(l.N5, 25)) & 0xFFFFFFFF
    h[6] = (l.M6 ^ rrp(l.N6, 30)) & 0xFFFFFFFF
    h[7] = (l.M7 ^ rrp(l.N7, 3)) & 0xFFFFFFFF
    h[8] = (l.M8 ^ rrp(l.N8, 8)) & 0xFFFFFFFF
    h[9] = (l.M9 ^ rrp(l.N9, 13)) & 0xFFFFFFFF
    h[10] = (l.M10 ^ rrp(l.N10, 18)) & 0xFFFFFFFF
    h[11] = (l.M11 ^ rrp(l.N11, 23)) & 0xFFFFFFFF
    h[12] = (l.M12 ^ rrp(l.N12, 28)) & 0xFFFFFFFF
    h[13] = (l.M13 ^ rrp(l.N13, 1)) & 0xFFFFFFFF
    h[14] = (l.M14 ^ rrp(l.N14, 6)) & 0xFFFFFFFF
    h[15] = (l.M15 ^ rrp(l.N15, 11)) & 0xFFFFFFFF
    h[16] = (l.M16 ^ rrp(l.N16, 16)) & 0xFFFFFFFF
    h[17] = (l.M17 ^ rrp(l.N17, 21)) & 0xFFFFFFFF
    h[18] = (l.M18 ^ rrp(l.N18, 26)) & 0xFFFFFFFF
    h[19] = (l.M19 ^ rrp(l.N19, 31)) & 0xFFFFFFFF
    h[20] = (l.M20 ^ rrp(l.N20, 4)) & 0xFFFFFFFF
    h[21] = (l.M21 ^ rrp(l.N21, 9)) & 0xFFFFFFFF
    h[22] = (l.M22 ^ rrp(l.N22, 14)) & 0xFFFFFFFF
    h[23] = (l.M23 ^ rrp(l.N23, 19)) & 0xFFFFFFFF
    h[24] = (l.M24 ^ rrp(l.N24, 24)) & 0xFFFFFFFF
    h[25] = (l.M25 ^ rrp(l.N25, 29)) & 0xFFFFFFFF
}

pub func compress_w26(h: ref table<i64>, msg: string, pos: i64, nbytes: i64,
            t_lo: i64, t_hi: i64, last: bool,
            iv: table<i64>, rcon: table<i64>, R: i64) {
    var (M0, N0, M1, N1, Pw, skey) = w48_planes_skey(msg, pos, nbytes)
    var l = Lanes26()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp(h[13], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp(h[14], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp(h[15], 7)
    l.M3 = h[3] & 0xFFFFFFFF
    l.N3 = rrp(h[16], 7)
    l.M4 = h[4] & 0xFFFFFFFF
    l.N4 = rrp(h[17], 7)
    l.M5 = h[5] & 0xFFFFFFFF
    l.N5 = rrp(h[18], 7)
    l.M6 = h[6] & 0xFFFFFFFF
    l.N6 = rrp(h[19], 7)
    l.M7 = h[7] & 0xFFFFFFFF
    l.N7 = rrp(h[20], 7)
    l.M8 = h[8] & 0xFFFFFFFF
    l.N8 = rrp(h[21], 7)
    l.M9 = h[9] & 0xFFFFFFFF
    l.N9 = rrp(h[22], 7)
    l.M10 = h[10] & 0xFFFFFFFF
    l.N10 = rrp(h[23], 7)
    l.M11 = h[11] & 0xFFFFFFFF
    l.N11 = rrp(h[24], 7)
    l.M12 = h[12] & 0xFFFFFFFF
    l.N12 = rrp(h[25], 7)
    l.M13 = h[13] & 0xFFFFFFFF
    l.N13 = rrp(h[0], 7)
    l.M14 = h[14] & 0xFFFFFFFF
    l.N14 = rrp(h[1], 7)
    l.M15 = h[15] & 0xFFFFFFFF
    l.N15 = rrp(h[2], 7)
    l.M16 = h[16] & 0xFFFFFFFF
    l.N16 = rrp(h[3], 7)
    l.M17 = h[17] & 0xFFFFFFFF
    l.N17 = rrp(h[4], 7)
    l.M18 = h[18] & 0xFFFFFFFF
    l.N18 = rrp(h[5], 7)
    l.M19 = h[19] & 0xFFFFFFFF
    l.N19 = rrp(h[6], 7)
    l.M20 = h[20] & 0xFFFFFFFF
    l.N20 = rrp(h[7], 7)
    l.M21 = h[21] & 0xFFFFFFFF
    l.N21 = rrp(h[8], 7)
    l.M22 = h[22] & 0xFFFFFFFF
    l.N22 = rrp(h[9], 7)
    l.M23 = h[23] & 0xFFFFFFFF
    l.N23 = rrp(h[10], 7)
    l.M24 = h[24] & 0xFFFFFFFF
    l.N24 = rrp(h[11], 7)
    l.M25 = h[25] & 0xFFFFFFFF
    l.N25 = rrp(h[12], 7)
    l.M0 = (l.M0 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M1 = (l.M1 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M2 = (l.M2 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M3 = (l.M3 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M4 = (l.M4 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M5 = (l.M5 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M6 = (l.M6 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M7 = (l.M7 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M8 = (l.M8 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M9 = (l.M9 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N9 = (l.N9 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M10 = (l.M10 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M11 = (l.M11 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M12 = (l.M12 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N12 = (l.N12 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M13 = (l.M13 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N13 = (l.N13 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M14 = (l.M14 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N14 = (l.N14 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M15 = (l.M15 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N15 = (l.N15 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M16 = (l.M16 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N16 = (l.N16 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M17 = (l.M17 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N17 = (l.N17 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M18 = (l.M18 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N18 = (l.N18 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M19 = (l.M19 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N19 = (l.N19 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M20 = (l.M20 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N20 = (l.N20 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M21 = (l.M21 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N21 = (l.N21 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M22 = (l.M22 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N22 = (l.N22 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M23 = (l.M23 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N23 = (l.N23 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M24 = (l.M24 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N24 = (l.N24 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M25 = (l.M25 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N25 = (l.N25 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (t_lo & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N13 = (l.N13 ^ (t_hi & 0xFFFFFFFF)) & 0xFFFFFFFF
    if last {
        l.N13 = (l.N13 ^ 0xFFFFFFFF) & 0xFFFFFFFF
    }
    l = absorb26(l, Pw, skey)
    var mA: i64 = 0
    var mC: i64 = 0
    var r: i64 = 0
    while r < R {
        mA = (r * 5 + ((skey >> 6) & 7)) & 31
        mC = (r * 7 + ((skey >> 12) & 7)) & 31
        l = ring26_mixA(l, r, skey, M0, N0, M1, N1, mA, rcon, r)
        l = ring26_mixB(l, r, skey, M0, N0, M1, N1, mC, rcon, (r + 8) & 15)
        r = r + 1
    }
    h[0] = (h[0] ^ l.M0 ^ rrp(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (h[1] ^ l.M1 ^ rrp(l.N1, 3)) & 0xFFFFFFFF
    h[2] = (h[2] ^ l.M2 ^ rrp(l.N2, 6)) & 0xFFFFFFFF
    h[3] = (h[3] ^ l.M3 ^ rrp(l.N3, 9)) & 0xFFFFFFFF
    h[4] = (h[4] ^ l.M4 ^ rrp(l.N4, 12)) & 0xFFFFFFFF
    h[5] = (h[5] ^ l.M5 ^ rrp(l.N5, 15)) & 0xFFFFFFFF
    h[6] = (h[6] ^ l.M6 ^ rrp(l.N6, 18)) & 0xFFFFFFFF
    h[7] = (h[7] ^ l.M7 ^ rrp(l.N7, 21)) & 0xFFFFFFFF
    h[8] = (h[8] ^ l.M8 ^ rrp(l.N8, 24)) & 0xFFFFFFFF
    h[9] = (h[9] ^ l.M9 ^ rrp(l.N9, 27)) & 0xFFFFFFFF
    h[10] = (h[10] ^ l.M10 ^ rrp(l.N10, 30)) & 0xFFFFFFFF
    h[11] = (h[11] ^ l.M11 ^ rrp(l.N11, 1)) & 0xFFFFFFFF
    h[12] = (h[12] ^ l.M12 ^ rrp(l.N12, 4)) & 0xFFFFFFFF
    h[13] = (h[13] ^ l.M13 ^ rrp(l.N13, 7)) & 0xFFFFFFFF
    h[14] = (h[14] ^ l.M14 ^ rrp(l.N14, 10)) & 0xFFFFFFFF
    h[15] = (h[15] ^ l.M15 ^ rrp(l.N15, 13)) & 0xFFFFFFFF
    h[16] = (h[16] ^ l.M16 ^ rrp(l.N16, 16)) & 0xFFFFFFFF
    h[17] = (h[17] ^ l.M17 ^ rrp(l.N17, 19)) & 0xFFFFFFFF
    h[18] = (h[18] ^ l.M18 ^ rrp(l.N18, 22)) & 0xFFFFFFFF
    h[19] = (h[19] ^ l.M19 ^ rrp(l.N19, 25)) & 0xFFFFFFFF
    h[20] = (h[20] ^ l.M20 ^ rrp(l.N20, 28)) & 0xFFFFFFFF
    h[21] = (h[21] ^ l.M21 ^ rrp(l.N21, 31)) & 0xFFFFFFFF
    h[22] = (h[22] ^ l.M22 ^ rrp(l.N22, 2)) & 0xFFFFFFFF
    h[23] = (h[23] ^ l.M23 ^ rrp(l.N23, 5)) & 0xFFFFFFFF
    h[24] = (h[24] ^ l.M24 ^ rrp(l.N24, 8)) & 0xFFFFFFFF
    h[25] = (h[25] ^ l.M25 ^ rrp(l.N25, 11)) & 0xFFFFFFFF
    fin_synth26(h)
}

// === W=20 半宽双轨特化内核（r，n=88/92/96/128/144；rrp16/0xFFFF 掩码）——轨A lanes[0..10)、轨B lanes[10..20)；R=8 ===
struct Lanes20h {
    var M0: i64 = 0
    var N0: i64 = 0
    var M1: i64 = 0
    var N1: i64 = 0
    var M2: i64 = 0
    var N2: i64 = 0
    var M3: i64 = 0
    var N3: i64 = 0
    var M4: i64 = 0
    var N4: i64 = 0
    var M5: i64 = 0
    var N5: i64 = 0
    var M6: i64 = 0
    var N6: i64 = 0
    var M7: i64 = 0
    var N7: i64 = 0
    var M8: i64 = 0
    var N8: i64 = 0
    var M9: i64 = 0
    var N9: i64 = 0
    var M10: i64 = 0
    var N10: i64 = 0
    var M11: i64 = 0
    var N11: i64 = 0
    var M12: i64 = 0
    var N12: i64 = 0
    var M13: i64 = 0
    var N13: i64 = 0
    var M14: i64 = 0
    var N14: i64 = 0
    var M15: i64 = 0
    var N15: i64 = 0
    var M16: i64 = 0
    var N16: i64 = 0
    var M17: i64 = 0
    var N17: i64 = 0
    var M18: i64 = 0
    var N18: i64 = 0
    var M19: i64 = 0
    var N19: i64 = 0
}

func ring20h_mixA(l: Lanes20h, r: i64
            , skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes20h {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0,
                    rrp16(l.M2, rA), rrp16(l.N2, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp16(l.M3, (rB + 3) & 31), rrp16(l.N3, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1,
                    rrp16(l.M3, (rA + 5) & 31), rrp16(l.N3, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp16(l.M4, (rB + 10) & 31), rrp16(l.N4, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M2, l.N2,
                    rrp16(l.M4, (rA + 10) & 31), rrp16(l.N4, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp16(l.M5, (rB + 17) & 31), rrp16(l.N5, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M3, l.N3,
                    rrp16(l.M5, (rA + 15) & 31), rrp16(l.N5, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp16(l.M6, (rB + 24) & 31), rrp16(l.N6, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M4, l.N4,
                    rrp16(l.M6, (rA + 20) & 31), rrp16(l.N6, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp16(l.M7, (rB + 31) & 31), rrp16(l.N7, (rB + 31) & 31))
    var (q5m, q5n) = tadd2(l.M5, l.N5,
                    rrp16(l.M7, (rA + 25) & 31), rrp16(l.N7, (rA + 25) & 31))
    var (s5m, s5n) = tadd2(q5m, q5n,
                    rrp16(l.M8, (rB + 6) & 31), rrp16(l.N8, (rB + 6) & 31))
    var (q6m, q6n) = tadd2(l.M6, l.N6,
                    rrp16(l.M8, (rA + 30) & 31), rrp16(l.N8, (rA + 30) & 31))
    var (s6m, s6n) = tadd2(q6m, q6n,
                    rrp16(l.M9, (rB + 13) & 31), rrp16(l.N9, (rB + 13) & 31))
    var (q7m, q7n) = tadd2(l.M7, l.N7,
                    rrp16(l.M9, (rA + 3) & 31), rrp16(l.N9, (rA + 3) & 31))
    var (s7m, s7n) = tadd2(q7m, q7n,
                    rrp16(l.M0, (rB + 20) & 31), rrp16(l.N0, (rB + 20) & 31))
    var (q8m, q8n) = tadd2(l.M8, l.N8,
                    rrp16(l.M0, (rA + 8) & 31), rrp16(l.N0, (rA + 8) & 31))
    var (s8m, s8n) = tadd2(q8m, q8n,
                    rrp16(l.M1, (rB + 27) & 31), rrp16(l.N1, (rB + 27) & 31))
    var (q9m, q9n) = tadd2(l.M9, l.N9,
                    rrp16(l.M1, (rA + 13) & 31), rrp16(l.N1, (rA + 13) & 31))
    var (s9m, s9n) = tadd2(q9m, q9n,
                    rrp16(l.M2, (rB + 2) & 31), rrp16(l.N2, (rB + 2) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    l.M2 = s2m
    l.N2 = s2n
    l.M3 = s3m
    l.N3 = s3n
    l.M4 = s4m
    l.N4 = s4n
    l.M5 = s5m
    l.N5 = s5n
    l.M6 = s6m
    l.N6 = s6n
    l.M7 = s7m
    l.N7 = s7n
    l.M8 = s8m
    l.N8 = s8n
    l.M9 = s9m
    l.N9 = s9n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M2 = (l.M2 ^ p1m) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M3 = (l.M3 ^ p2m) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s5m, s5n)
    l.M4 = (l.M4 ^ p3m) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s6m, s6n)
    l.M5 = (l.M5 ^ p4m) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ p4n) & 0xFFFFFFFF
    var (p5m, p5n) = tmul2(s5m, s5n, s7m, s7n)
    l.M6 = (l.M6 ^ p5m) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ p5n) & 0xFFFFFFFF
    var (p6m, p6n) = tmul2(s6m, s6n, s8m, s8n)
    l.M7 = (l.M7 ^ p6m) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ p6n) & 0xFFFFFFFF
    var (p7m, p7n) = tmul2(s7m, s7n, s9m, s9n)
    l.M8 = (l.M8 ^ p7m) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ p7n) & 0xFFFFFFFF
    var (p8m, p8n) = tmul2(s8m, s8n, s0m, s0n)
    l.M9 = (l.M9 ^ p8m) & 0xFFFFFFFF
    l.N9 = (l.N9 ^ p8n) & 0xFFFFFFFF
    var (p9m, p9n) = tmul2(s9m, s9n, s1m, s1n)
    l.M0 = (l.M0 ^ p9m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p9n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M9 = (l.M9 ^ maj) & 0xFFFFFFFF
    l.N9 = (l.N9 ^ rrp16(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M0, l.N0, rrp16(M0, mA), rrp16(N0, mA))
    l.M0 = im
    l.N0 = in2
    var (jm, jn2) = tadd2(l.M1, l.N1, rrp16(M1, (mA + 7) & 31), rrp16(N1, (mA + 7) & 31))
    l.M1 = jm
    l.N1 = jn2
    l.M0 = (l.M0 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N9 = (l.N9 ^ rrp16(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

func ring20h_mixB(l: Lanes20h, r: i64
            , skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes20h {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M10, l.N10,
                    rrp16(l.M12, rA), rrp16(l.N12, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp16(l.M13, (rB + 3) & 31), rrp16(l.N13, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M11, l.N11,
                    rrp16(l.M13, (rA + 5) & 31), rrp16(l.N13, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp16(l.M14, (rB + 10) & 31), rrp16(l.N14, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M12, l.N12,
                    rrp16(l.M14, (rA + 10) & 31), rrp16(l.N14, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp16(l.M15, (rB + 17) & 31), rrp16(l.N15, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M13, l.N13,
                    rrp16(l.M15, (rA + 15) & 31), rrp16(l.N15, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp16(l.M16, (rB + 24) & 31), rrp16(l.N16, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M14, l.N14,
                    rrp16(l.M16, (rA + 20) & 31), rrp16(l.N16, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp16(l.M17, (rB + 31) & 31), rrp16(l.N17, (rB + 31) & 31))
    var (q5m, q5n) = tadd2(l.M15, l.N15,
                    rrp16(l.M17, (rA + 25) & 31), rrp16(l.N17, (rA + 25) & 31))
    var (s5m, s5n) = tadd2(q5m, q5n,
                    rrp16(l.M18, (rB + 6) & 31), rrp16(l.N18, (rB + 6) & 31))
    var (q6m, q6n) = tadd2(l.M16, l.N16,
                    rrp16(l.M18, (rA + 30) & 31), rrp16(l.N18, (rA + 30) & 31))
    var (s6m, s6n) = tadd2(q6m, q6n,
                    rrp16(l.M19, (rB + 13) & 31), rrp16(l.N19, (rB + 13) & 31))
    var (q7m, q7n) = tadd2(l.M17, l.N17,
                    rrp16(l.M19, (rA + 3) & 31), rrp16(l.N19, (rA + 3) & 31))
    var (s7m, s7n) = tadd2(q7m, q7n,
                    rrp16(l.M10, (rB + 20) & 31), rrp16(l.N10, (rB + 20) & 31))
    var (q8m, q8n) = tadd2(l.M18, l.N18,
                    rrp16(l.M10, (rA + 8) & 31), rrp16(l.N10, (rA + 8) & 31))
    var (s8m, s8n) = tadd2(q8m, q8n,
                    rrp16(l.M11, (rB + 27) & 31), rrp16(l.N11, (rB + 27) & 31))
    var (q9m, q9n) = tadd2(l.M19, l.N19,
                    rrp16(l.M11, (rA + 13) & 31), rrp16(l.N11, (rA + 13) & 31))
    var (s9m, s9n) = tadd2(q9m, q9n,
                    rrp16(l.M12, (rB + 2) & 31), rrp16(l.N12, (rB + 2) & 31))
    l.M10 = s0m
    l.N10 = s0n
    l.M11 = s1m
    l.N11 = s1n
    l.M12 = s2m
    l.N12 = s2n
    l.M13 = s3m
    l.N13 = s3n
    l.M14 = s4m
    l.N14 = s4n
    l.M15 = s5m
    l.N15 = s5n
    l.M16 = s6m
    l.N16 = s6n
    l.M17 = s7m
    l.N17 = s7n
    l.M18 = s8m
    l.N18 = s8n
    l.M19 = s9m
    l.N19 = s9n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M11 = (l.M11 ^ p0m) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M12 = (l.M12 ^ p1m) & 0xFFFFFFFF
    l.N12 = (l.N12 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M13 = (l.M13 ^ p2m) & 0xFFFFFFFF
    l.N13 = (l.N13 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s5m, s5n)
    l.M14 = (l.M14 ^ p3m) & 0xFFFFFFFF
    l.N14 = (l.N14 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s6m, s6n)
    l.M15 = (l.M15 ^ p4m) & 0xFFFFFFFF
    l.N15 = (l.N15 ^ p4n) & 0xFFFFFFFF
    var (p5m, p5n) = tmul2(s5m, s5n, s7m, s7n)
    l.M16 = (l.M16 ^ p5m) & 0xFFFFFFFF
    l.N16 = (l.N16 ^ p5n) & 0xFFFFFFFF
    var (p6m, p6n) = tmul2(s6m, s6n, s8m, s8n)
    l.M17 = (l.M17 ^ p6m) & 0xFFFFFFFF
    l.N17 = (l.N17 ^ p6n) & 0xFFFFFFFF
    var (p7m, p7n) = tmul2(s7m, s7n, s9m, s9n)
    l.M18 = (l.M18 ^ p7m) & 0xFFFFFFFF
    l.N18 = (l.N18 ^ p7n) & 0xFFFFFFFF
    var (p8m, p8n) = tmul2(s8m, s8n, s0m, s0n)
    l.M19 = (l.M19 ^ p8m) & 0xFFFFFFFF
    l.N19 = (l.N19 ^ p8n) & 0xFFFFFFFF
    var (p9m, p9n) = tmul2(s9m, s9n, s1m, s1n)
    l.M10 = (l.M10 ^ p9m) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ p9n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M19 = (l.M19 ^ maj) & 0xFFFFFFFF
    l.N19 = (l.N19 ^ rrp16(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M10, l.N10, rrp16(M0, mA), rrp16(N0, mA))
    l.M10 = im
    l.N10 = in2
    var (jm, jn2) = tadd2(l.M11, l.N11, rrp16(M1, (mA + 7) & 31), rrp16(N1, (mA + 7) & 31))
    l.M11 = jm
    l.N11 = jn2
    l.M10 = (l.M10 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N19 = (l.N19 ^ rrp16(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

func ring20h_mixF(l: Lanes20h, r: i64
            , skey: i64
            ) -> Lanes20h {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0,
                    rrp16(l.M2, rA), rrp16(l.N2, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp16(l.M3, (rB + 3) & 31), rrp16(l.N3, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1,
                    rrp16(l.M3, (rA + 5) & 31), rrp16(l.N3, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp16(l.M4, (rB + 10) & 31), rrp16(l.N4, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M2, l.N2,
                    rrp16(l.M4, (rA + 10) & 31), rrp16(l.N4, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp16(l.M5, (rB + 17) & 31), rrp16(l.N5, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M3, l.N3,
                    rrp16(l.M5, (rA + 15) & 31), rrp16(l.N5, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp16(l.M6, (rB + 24) & 31), rrp16(l.N6, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M4, l.N4,
                    rrp16(l.M6, (rA + 20) & 31), rrp16(l.N6, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp16(l.M7, (rB + 31) & 31), rrp16(l.N7, (rB + 31) & 31))
    var (q5m, q5n) = tadd2(l.M5, l.N5,
                    rrp16(l.M7, (rA + 25) & 31), rrp16(l.N7, (rA + 25) & 31))
    var (s5m, s5n) = tadd2(q5m, q5n,
                    rrp16(l.M8, (rB + 6) & 31), rrp16(l.N8, (rB + 6) & 31))
    var (q6m, q6n) = tadd2(l.M6, l.N6,
                    rrp16(l.M8, (rA + 30) & 31), rrp16(l.N8, (rA + 30) & 31))
    var (s6m, s6n) = tadd2(q6m, q6n,
                    rrp16(l.M9, (rB + 13) & 31), rrp16(l.N9, (rB + 13) & 31))
    var (q7m, q7n) = tadd2(l.M7, l.N7,
                    rrp16(l.M9, (rA + 3) & 31), rrp16(l.N9, (rA + 3) & 31))
    var (s7m, s7n) = tadd2(q7m, q7n,
                    rrp16(l.M10, (rB + 20) & 31), rrp16(l.N10, (rB + 20) & 31))
    var (q8m, q8n) = tadd2(l.M8, l.N8,
                    rrp16(l.M10, (rA + 8) & 31), rrp16(l.N10, (rA + 8) & 31))
    var (s8m, s8n) = tadd2(q8m, q8n,
                    rrp16(l.M11, (rB + 27) & 31), rrp16(l.N11, (rB + 27) & 31))
    var (q9m, q9n) = tadd2(l.M9, l.N9,
                    rrp16(l.M11, (rA + 13) & 31), rrp16(l.N11, (rA + 13) & 31))
    var (s9m, s9n) = tadd2(q9m, q9n,
                    rrp16(l.M12, (rB + 2) & 31), rrp16(l.N12, (rB + 2) & 31))
    var (q10m, q10n) = tadd2(l.M10, l.N10,
                    rrp16(l.M12, (rA + 18) & 31), rrp16(l.N12, (rA + 18) & 31))
    var (s10m, s10n) = tadd2(q10m, q10n,
                    rrp16(l.M13, (rB + 9) & 31), rrp16(l.N13, (rB + 9) & 31))
    var (q11m, q11n) = tadd2(l.M11, l.N11,
                    rrp16(l.M13, (rA + 23) & 31), rrp16(l.N13, (rA + 23) & 31))
    var (s11m, s11n) = tadd2(q11m, q11n,
                    rrp16(l.M14, (rB + 16) & 31), rrp16(l.N14, (rB + 16) & 31))
    var (q12m, q12n) = tadd2(l.M12, l.N12,
                    rrp16(l.M14, (rA + 28) & 31), rrp16(l.N14, (rA + 28) & 31))
    var (s12m, s12n) = tadd2(q12m, q12n,
                    rrp16(l.M15, (rB + 23) & 31), rrp16(l.N15, (rB + 23) & 31))
    var (q13m, q13n) = tadd2(l.M13, l.N13,
                    rrp16(l.M15, (rA + 1) & 31), rrp16(l.N15, (rA + 1) & 31))
    var (s13m, s13n) = tadd2(q13m, q13n,
                    rrp16(l.M16, (rB + 30) & 31), rrp16(l.N16, (rB + 30) & 31))
    var (q14m, q14n) = tadd2(l.M14, l.N14,
                    rrp16(l.M16, (rA + 6) & 31), rrp16(l.N16, (rA + 6) & 31))
    var (s14m, s14n) = tadd2(q14m, q14n,
                    rrp16(l.M17, (rB + 5) & 31), rrp16(l.N17, (rB + 5) & 31))
    var (q15m, q15n) = tadd2(l.M15, l.N15,
                    rrp16(l.M17, (rA + 11) & 31), rrp16(l.N17, (rA + 11) & 31))
    var (s15m, s15n) = tadd2(q15m, q15n,
                    rrp16(l.M18, (rB + 12) & 31), rrp16(l.N18, (rB + 12) & 31))
    var (q16m, q16n) = tadd2(l.M16, l.N16,
                    rrp16(l.M18, (rA + 16) & 31), rrp16(l.N18, (rA + 16) & 31))
    var (s16m, s16n) = tadd2(q16m, q16n,
                    rrp16(l.M19, (rB + 19) & 31), rrp16(l.N19, (rB + 19) & 31))
    var (q17m, q17n) = tadd2(l.M17, l.N17,
                    rrp16(l.M19, (rA + 21) & 31), rrp16(l.N19, (rA + 21) & 31))
    var (s17m, s17n) = tadd2(q17m, q17n,
                    rrp16(l.M0, (rB + 26) & 31), rrp16(l.N0, (rB + 26) & 31))
    var (q18m, q18n) = tadd2(l.M18, l.N18,
                    rrp16(l.M0, (rA + 26) & 31), rrp16(l.N0, (rA + 26) & 31))
    var (s18m, s18n) = tadd2(q18m, q18n,
                    rrp16(l.M1, (rB + 1) & 31), rrp16(l.N1, (rB + 1) & 31))
    var (q19m, q19n) = tadd2(l.M19, l.N19,
                    rrp16(l.M1, (rA + 31) & 31), rrp16(l.N1, (rA + 31) & 31))
    var (s19m, s19n) = tadd2(q19m, q19n,
                    rrp16(l.M2, (rB + 8) & 31), rrp16(l.N2, (rB + 8) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    l.M2 = s2m
    l.N2 = s2n
    l.M3 = s3m
    l.N3 = s3n
    l.M4 = s4m
    l.N4 = s4n
    l.M5 = s5m
    l.N5 = s5n
    l.M6 = s6m
    l.N6 = s6n
    l.M7 = s7m
    l.N7 = s7n
    l.M8 = s8m
    l.N8 = s8n
    l.M9 = s9m
    l.N9 = s9n
    l.M10 = s10m
    l.N10 = s10n
    l.M11 = s11m
    l.N11 = s11n
    l.M12 = s12m
    l.N12 = s12n
    l.M13 = s13m
    l.N13 = s13n
    l.M14 = s14m
    l.N14 = s14n
    l.M15 = s15m
    l.N15 = s15n
    l.M16 = s16m
    l.N16 = s16n
    l.M17 = s17m
    l.N17 = s17n
    l.M18 = s18m
    l.N18 = s18n
    l.M19 = s19m
    l.N19 = s19n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M2 = (l.M2 ^ p1m) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M3 = (l.M3 ^ p2m) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s5m, s5n)
    l.M4 = (l.M4 ^ p3m) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s6m, s6n)
    l.M5 = (l.M5 ^ p4m) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ p4n) & 0xFFFFFFFF
    var (p5m, p5n) = tmul2(s5m, s5n, s7m, s7n)
    l.M6 = (l.M6 ^ p5m) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ p5n) & 0xFFFFFFFF
    var (p6m, p6n) = tmul2(s6m, s6n, s8m, s8n)
    l.M7 = (l.M7 ^ p6m) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ p6n) & 0xFFFFFFFF
    var (p7m, p7n) = tmul2(s7m, s7n, s9m, s9n)
    l.M8 = (l.M8 ^ p7m) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ p7n) & 0xFFFFFFFF
    var (p8m, p8n) = tmul2(s8m, s8n, s10m, s10n)
    l.M9 = (l.M9 ^ p8m) & 0xFFFFFFFF
    l.N9 = (l.N9 ^ p8n) & 0xFFFFFFFF
    var (p9m, p9n) = tmul2(s9m, s9n, s11m, s11n)
    l.M10 = (l.M10 ^ p9m) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ p9n) & 0xFFFFFFFF
    var (p10m, p10n) = tmul2(s10m, s10n, s12m, s12n)
    l.M11 = (l.M11 ^ p10m) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ p10n) & 0xFFFFFFFF
    var (p11m, p11n) = tmul2(s11m, s11n, s13m, s13n)
    l.M12 = (l.M12 ^ p11m) & 0xFFFFFFFF
    l.N12 = (l.N12 ^ p11n) & 0xFFFFFFFF
    var (p12m, p12n) = tmul2(s12m, s12n, s14m, s14n)
    l.M13 = (l.M13 ^ p12m) & 0xFFFFFFFF
    l.N13 = (l.N13 ^ p12n) & 0xFFFFFFFF
    var (p13m, p13n) = tmul2(s13m, s13n, s15m, s15n)
    l.M14 = (l.M14 ^ p13m) & 0xFFFFFFFF
    l.N14 = (l.N14 ^ p13n) & 0xFFFFFFFF
    var (p14m, p14n) = tmul2(s14m, s14n, s16m, s16n)
    l.M15 = (l.M15 ^ p14m) & 0xFFFFFFFF
    l.N15 = (l.N15 ^ p14n) & 0xFFFFFFFF
    var (p15m, p15n) = tmul2(s15m, s15n, s17m, s17n)
    l.M16 = (l.M16 ^ p15m) & 0xFFFFFFFF
    l.N16 = (l.N16 ^ p15n) & 0xFFFFFFFF
    var (p16m, p16n) = tmul2(s16m, s16n, s18m, s18n)
    l.M17 = (l.M17 ^ p16m) & 0xFFFFFFFF
    l.N17 = (l.N17 ^ p16n) & 0xFFFFFFFF
    var (p17m, p17n) = tmul2(s17m, s17n, s19m, s19n)
    l.M18 = (l.M18 ^ p17m) & 0xFFFFFFFF
    l.N18 = (l.N18 ^ p17n) & 0xFFFFFFFF
    var (p18m, p18n) = tmul2(s18m, s18n, s0m, s0n)
    l.M19 = (l.M19 ^ p18m) & 0xFFFFFFFF
    l.N19 = (l.N19 ^ p18n) & 0xFFFFFFFF
    var (p19m, p19n) = tmul2(s19m, s19n, s1m, s1n)
    l.M0 = (l.M0 ^ p19m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p19n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M19 = (l.M19 ^ maj) & 0xFFFFFFFF
    l.N19 = (l.N19 ^ rrp16(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    return l
}

func absorb20h(l: Lanes20h, Pw: Planes16, skey: i64) -> Lanes20h {
    var w: i64 = 0
    while w < 16 {
        var pv: i64 = 0
        if w == 0 {
            pv = Pw.w0
        } else if w == 1 {
            pv = Pw.w1
        } else if w == 2 {
            pv = Pw.w2
        } else if w == 3 {
            pv = Pw.w3
        } else if w == 4 {
            pv = Pw.w4
        } else if w == 5 {
            pv = Pw.w5
        } else if w == 6 {
            pv = Pw.w6
        } else if w == 7 {
            pv = Pw.w7
        } else if w == 8 {
            pv = Pw.w8
        } else if w == 9 {
            pv = Pw.w9
        } else if w == 10 {
            pv = Pw.w10
        } else if w == 11 {
            pv = Pw.w11
        } else if w == 12 {
            pv = Pw.w12
        } else if w == 13 {
            pv = Pw.w13
        } else if w == 14 {
            pv = Pw.w14
        } else {
            pv = Pw.w15
        }
        if pv != 0 {
            var a = (w * 5 + ((skey >> (w & 7)) & 7)) & 31
            var an = w % 20
            var v = rrp16(pv, a)
            var v2 = rrp16(pv, a + 17)
            if an == 0 {
                var (t0m, t0n) = tadd2(l.M0, l.N0, v, v2)
                l.M0 = t0m & 0xFFFFFFFF
                l.N0 = t0n & 0xFFFFFFFF
            } else if an == 1 {
                var (t1m, t1n) = tadd2(l.M1, l.N1, v, v2)
                l.M1 = t1m & 0xFFFFFFFF
                l.N1 = t1n & 0xFFFFFFFF
            } else if an == 2 {
                var (t2m, t2n) = tadd2(l.M2, l.N2, v, v2)
                l.M2 = t2m & 0xFFFFFFFF
                l.N2 = t2n & 0xFFFFFFFF
            } else if an == 3 {
                var (t3m, t3n) = tadd2(l.M3, l.N3, v, v2)
                l.M3 = t3m & 0xFFFFFFFF
                l.N3 = t3n & 0xFFFFFFFF
            } else if an == 4 {
                var (t4m, t4n) = tadd2(l.M4, l.N4, v, v2)
                l.M4 = t4m & 0xFFFFFFFF
                l.N4 = t4n & 0xFFFFFFFF
            } else if an == 5 {
                var (t5m, t5n) = tadd2(l.M5, l.N5, v, v2)
                l.M5 = t5m & 0xFFFFFFFF
                l.N5 = t5n & 0xFFFFFFFF
            } else if an == 6 {
                var (t6m, t6n) = tadd2(l.M6, l.N6, v, v2)
                l.M6 = t6m & 0xFFFFFFFF
                l.N6 = t6n & 0xFFFFFFFF
            } else if an == 7 {
                var (t7m, t7n) = tadd2(l.M7, l.N7, v, v2)
                l.M7 = t7m & 0xFFFFFFFF
                l.N7 = t7n & 0xFFFFFFFF
            } else if an == 8 {
                var (t8m, t8n) = tadd2(l.M8, l.N8, v, v2)
                l.M8 = t8m & 0xFFFFFFFF
                l.N8 = t8n & 0xFFFFFFFF
            } else if an == 9 {
                var (t9m, t9n) = tadd2(l.M9, l.N9, v, v2)
                l.M9 = t9m & 0xFFFFFFFF
                l.N9 = t9n & 0xFFFFFFFF
            } else if an == 10 {
                var (t10m, t10n) = tadd2(l.M10, l.N10, v, v2)
                l.M10 = t10m & 0xFFFFFFFF
                l.N10 = t10n & 0xFFFFFFFF
            } else if an == 11 {
                var (t11m, t11n) = tadd2(l.M11, l.N11, v, v2)
                l.M11 = t11m & 0xFFFFFFFF
                l.N11 = t11n & 0xFFFFFFFF
            } else if an == 12 {
                var (t12m, t12n) = tadd2(l.M12, l.N12, v, v2)
                l.M12 = t12m & 0xFFFFFFFF
                l.N12 = t12n & 0xFFFFFFFF
            } else if an == 13 {
                var (t13m, t13n) = tadd2(l.M13, l.N13, v, v2)
                l.M13 = t13m & 0xFFFFFFFF
                l.N13 = t13n & 0xFFFFFFFF
            } else if an == 14 {
                var (t14m, t14n) = tadd2(l.M14, l.N14, v, v2)
                l.M14 = t14m & 0xFFFFFFFF
                l.N14 = t14n & 0xFFFFFFFF
            } else if an == 15 {
                var (t15m, t15n) = tadd2(l.M15, l.N15, v, v2)
                l.M15 = t15m & 0xFFFFFFFF
                l.N15 = t15n & 0xFFFFFFFF
            } else if an == 16 {
                var (t16m, t16n) = tadd2(l.M16, l.N16, v, v2)
                l.M16 = t16m & 0xFFFFFFFF
                l.N16 = t16n & 0xFFFFFFFF
            } else if an == 17 {
                var (t17m, t17n) = tadd2(l.M17, l.N17, v, v2)
                l.M17 = t17m & 0xFFFFFFFF
                l.N17 = t17n & 0xFFFFFFFF
            } else if an == 18 {
                var (t18m, t18n) = tadd2(l.M18, l.N18, v, v2)
                l.M18 = t18m & 0xFFFFFFFF
                l.N18 = t18n & 0xFFFFFFFF
            } else {
                var (t19m, t19n) = tadd2(l.M19, l.N19, v, v2)
                l.M19 = t19m & 0xFFFFFFFF
                l.N19 = t19n & 0xFFFFFFFF
            }
        }
        w = w + 1
    }
    return l
}

func fin_synth20h(h: ref table<i64>) {
    var l = Lanes20h()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp16(h[1], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp16(h[2], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp16(h[3], 7)
    l.M3 = h[3] & 0xFFFFFFFF
    l.N3 = rrp16(h[4], 7)
    l.M4 = h[4] & 0xFFFFFFFF
    l.N4 = rrp16(h[5], 7)
    l.M5 = h[5] & 0xFFFFFFFF
    l.N5 = rrp16(h[6], 7)
    l.M6 = h[6] & 0xFFFFFFFF
    l.N6 = rrp16(h[7], 7)
    l.M7 = h[7] & 0xFFFFFFFF
    l.N7 = rrp16(h[8], 7)
    l.M8 = h[8] & 0xFFFFFFFF
    l.N8 = rrp16(h[9], 7)
    l.M9 = h[9] & 0xFFFFFFFF
    l.N9 = rrp16(h[10], 7)
    l.M10 = h[10] & 0xFFFFFFFF
    l.N10 = rrp16(h[11], 7)
    l.M11 = h[11] & 0xFFFFFFFF
    l.N11 = rrp16(h[12], 7)
    l.M12 = h[12] & 0xFFFFFFFF
    l.N12 = rrp16(h[13], 7)
    l.M13 = h[13] & 0xFFFFFFFF
    l.N13 = rrp16(h[14], 7)
    l.M14 = h[14] & 0xFFFFFFFF
    l.N14 = rrp16(h[15], 7)
    l.M15 = h[15] & 0xFFFFFFFF
    l.N15 = rrp16(h[16], 7)
    l.M16 = h[16] & 0xFFFFFFFF
    l.N16 = rrp16(h[17], 7)
    l.M17 = h[17] & 0xFFFFFFFF
    l.N17 = rrp16(h[18], 7)
    l.M18 = h[18] & 0xFFFFFFFF
    l.N18 = rrp16(h[19], 7)
    l.M19 = h[19] & 0xFFFFFFFF
    l.N19 = rrp16(h[0], 7)
    var sf: i64 = 0
    while sf < 4 {
        l = ring20h_mixF(l, sf, 0x13579BDF)
        sf = sf + 1
    }
    h[0] = (l.M0 ^ rrp16(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (l.M1 ^ rrp16(l.N1, 5)) & 0xFFFFFFFF
    h[2] = (l.M2 ^ rrp16(l.N2, 10)) & 0xFFFFFFFF
    h[3] = (l.M3 ^ rrp16(l.N3, 15)) & 0xFFFFFFFF
    h[4] = (l.M4 ^ rrp16(l.N4, 20)) & 0xFFFFFFFF
    h[5] = (l.M5 ^ rrp16(l.N5, 25)) & 0xFFFFFFFF
    h[6] = (l.M6 ^ rrp16(l.N6, 30)) & 0xFFFFFFFF
    h[7] = (l.M7 ^ rrp16(l.N7, 3)) & 0xFFFFFFFF
    h[8] = (l.M8 ^ rrp16(l.N8, 8)) & 0xFFFFFFFF
    h[9] = (l.M9 ^ rrp16(l.N9, 13)) & 0xFFFFFFFF
    h[10] = (l.M10 ^ rrp16(l.N10, 18)) & 0xFFFFFFFF
    h[11] = (l.M11 ^ rrp16(l.N11, 23)) & 0xFFFFFFFF
    h[12] = (l.M12 ^ rrp16(l.N12, 28)) & 0xFFFFFFFF
    h[13] = (l.M13 ^ rrp16(l.N13, 1)) & 0xFFFFFFFF
    h[14] = (l.M14 ^ rrp16(l.N14, 6)) & 0xFFFFFFFF
    h[15] = (l.M15 ^ rrp16(l.N15, 11)) & 0xFFFFFFFF
    h[16] = (l.M16 ^ rrp16(l.N16, 16)) & 0xFFFFFFFF
    h[17] = (l.M17 ^ rrp16(l.N17, 21)) & 0xFFFFFFFF
    h[18] = (l.M18 ^ rrp16(l.N18, 26)) & 0xFFFFFFFF
    h[19] = (l.M19 ^ rrp16(l.N19, 31)) & 0xFFFFFFFF
}

pub func compress_w20h(h: ref table<i64>, msg: string, pos: i64, nbytes: i64,
            t_lo: i64, t_hi: i64, last: bool,
            iv: table<i64>, rcon: table<i64>, R: i64) {
    var (M0, N0, M1, N1, Pw, skey) = w48_planes_skey(msg, pos, nbytes)
    var l = Lanes20h()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp16(h[10], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp16(h[11], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp16(h[12], 7)
    l.M3 = h[3] & 0xFFFFFFFF
    l.N3 = rrp16(h[13], 7)
    l.M4 = h[4] & 0xFFFFFFFF
    l.N4 = rrp16(h[14], 7)
    l.M5 = h[5] & 0xFFFFFFFF
    l.N5 = rrp16(h[15], 7)
    l.M6 = h[6] & 0xFFFFFFFF
    l.N6 = rrp16(h[16], 7)
    l.M7 = h[7] & 0xFFFFFFFF
    l.N7 = rrp16(h[17], 7)
    l.M8 = h[8] & 0xFFFFFFFF
    l.N8 = rrp16(h[18], 7)
    l.M9 = h[9] & 0xFFFFFFFF
    l.N9 = rrp16(h[19], 7)
    l.M10 = h[10] & 0xFFFFFFFF
    l.N10 = rrp16(h[0], 7)
    l.M11 = h[11] & 0xFFFFFFFF
    l.N11 = rrp16(h[1], 7)
    l.M12 = h[12] & 0xFFFFFFFF
    l.N12 = rrp16(h[2], 7)
    l.M13 = h[13] & 0xFFFFFFFF
    l.N13 = rrp16(h[3], 7)
    l.M14 = h[14] & 0xFFFFFFFF
    l.N14 = rrp16(h[4], 7)
    l.M15 = h[15] & 0xFFFFFFFF
    l.N15 = rrp16(h[5], 7)
    l.M16 = h[16] & 0xFFFFFFFF
    l.N16 = rrp16(h[6], 7)
    l.M17 = h[17] & 0xFFFFFFFF
    l.N17 = rrp16(h[7], 7)
    l.M18 = h[18] & 0xFFFFFFFF
    l.N18 = rrp16(h[8], 7)
    l.M19 = h[19] & 0xFFFFFFFF
    l.N19 = rrp16(h[9], 7)
    l.M0 = (l.M0 ^ (iv[0] & 0xFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (iv[4] & 0xFFFF)) & 0xFFFFFFFF
    l.M1 = (l.M1 ^ (iv[1] & 0xFFFF)) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ (iv[5] & 0xFFFF)) & 0xFFFFFFFF
    l.M2 = (l.M2 ^ (iv[2] & 0xFFFF)) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ (iv[6] & 0xFFFF)) & 0xFFFFFFFF
    l.M3 = (l.M3 ^ (iv[3] & 0xFFFF)) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ (iv[7] & 0xFFFF)) & 0xFFFFFFFF
    l.M4 = (l.M4 ^ (iv[4] & 0xFFFF)) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ (iv[0] & 0xFFFF)) & 0xFFFFFFFF
    l.M5 = (l.M5 ^ (iv[5] & 0xFFFF)) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ (iv[1] & 0xFFFF)) & 0xFFFFFFFF
    l.M6 = (l.M6 ^ (iv[6] & 0xFFFF)) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ (iv[2] & 0xFFFF)) & 0xFFFFFFFF
    l.M7 = (l.M7 ^ (iv[7] & 0xFFFF)) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ (iv[3] & 0xFFFF)) & 0xFFFFFFFF
    l.M8 = (l.M8 ^ (iv[0] & 0xFFFF)) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ (iv[4] & 0xFFFF)) & 0xFFFFFFFF
    l.M9 = (l.M9 ^ (iv[1] & 0xFFFF)) & 0xFFFFFFFF
    l.N9 = (l.N9 ^ (iv[5] & 0xFFFF)) & 0xFFFFFFFF
    l.M10 = (l.M10 ^ (iv[2] & 0xFFFF)) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ (iv[6] & 0xFFFF)) & 0xFFFFFFFF
    l.M11 = (l.M11 ^ (iv[3] & 0xFFFF)) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ (iv[7] & 0xFFFF)) & 0xFFFFFFFF
    l.M12 = (l.M12 ^ (iv[4] & 0xFFFF)) & 0xFFFFFFFF
    l.N12 = (l.N12 ^ (iv[0] & 0xFFFF)) & 0xFFFFFFFF
    l.M13 = (l.M13 ^ (iv[5] & 0xFFFF)) & 0xFFFFFFFF
    l.N13 = (l.N13 ^ (iv[1] & 0xFFFF)) & 0xFFFFFFFF
    l.M14 = (l.M14 ^ (iv[6] & 0xFFFF)) & 0xFFFFFFFF
    l.N14 = (l.N14 ^ (iv[2] & 0xFFFF)) & 0xFFFFFFFF
    l.M15 = (l.M15 ^ (iv[7] & 0xFFFF)) & 0xFFFFFFFF
    l.N15 = (l.N15 ^ (iv[3] & 0xFFFF)) & 0xFFFFFFFF
    l.M16 = (l.M16 ^ (iv[0] & 0xFFFF)) & 0xFFFFFFFF
    l.N16 = (l.N16 ^ (iv[4] & 0xFFFF)) & 0xFFFFFFFF
    l.M17 = (l.M17 ^ (iv[1] & 0xFFFF)) & 0xFFFFFFFF
    l.N17 = (l.N17 ^ (iv[5] & 0xFFFF)) & 0xFFFFFFFF
    l.M18 = (l.M18 ^ (iv[2] & 0xFFFF)) & 0xFFFFFFFF
    l.N18 = (l.N18 ^ (iv[6] & 0xFFFF)) & 0xFFFFFFFF
    l.M19 = (l.M19 ^ (iv[3] & 0xFFFF)) & 0xFFFFFFFF
    l.N19 = (l.N19 ^ (iv[7] & 0xFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (t_lo & 0xFFFF)) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ (t_hi & 0xFFFF)) & 0xFFFFFFFF
    if last {
        l.N10 = (l.N10 ^ 0xFFFFFFFF) & 0xFFFFFFFF
    }
    l = absorb20h(l, Pw, skey)
    var mA: i64 = 0
    var mC: i64 = 0
    var r: i64 = 0
    while r < R {
        mA = (r * 5 + ((skey >> 6) & 7)) & 31
        mC = (r * 7 + ((skey >> 12) & 7)) & 31
        l = ring20h_mixA(l, r, skey, M0, N0, M1, N1, mA, rcon, r)
        l = ring20h_mixB(l, r, skey, M0, N0, M1, N1, mC, rcon, (r + 8) & 15)
        r = r + 1
    }
    h[0] = (h[0] ^ l.M0 ^ rrp16(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (h[1] ^ l.M1 ^ rrp16(l.N1, 3)) & 0xFFFFFFFF
    h[2] = (h[2] ^ l.M2 ^ rrp16(l.N2, 6)) & 0xFFFFFFFF
    h[3] = (h[3] ^ l.M3 ^ rrp16(l.N3, 9)) & 0xFFFFFFFF
    h[4] = (h[4] ^ l.M4 ^ rrp16(l.N4, 12)) & 0xFFFFFFFF
    h[5] = (h[5] ^ l.M5 ^ rrp16(l.N5, 15)) & 0xFFFFFFFF
    h[6] = (h[6] ^ l.M6 ^ rrp16(l.N6, 18)) & 0xFFFFFFFF
    h[7] = (h[7] ^ l.M7 ^ rrp16(l.N7, 21)) & 0xFFFFFFFF
    h[8] = (h[8] ^ l.M8 ^ rrp16(l.N8, 24)) & 0xFFFFFFFF
    h[9] = (h[9] ^ l.M9 ^ rrp16(l.N9, 27)) & 0xFFFFFFFF
    h[10] = (h[10] ^ l.M10 ^ rrp16(l.N10, 30)) & 0xFFFFFFFF
    h[11] = (h[11] ^ l.M11 ^ rrp16(l.N11, 1)) & 0xFFFFFFFF
    h[12] = (h[12] ^ l.M12 ^ rrp16(l.N12, 4)) & 0xFFFFFFFF
    h[13] = (h[13] ^ l.M13 ^ rrp16(l.N13, 7)) & 0xFFFFFFFF
    h[14] = (h[14] ^ l.M14 ^ rrp16(l.N14, 10)) & 0xFFFFFFFF
    h[15] = (h[15] ^ l.M15 ^ rrp16(l.N15, 13)) & 0xFFFFFFFF
    h[16] = (h[16] ^ l.M16 ^ rrp16(l.N16, 16)) & 0xFFFFFFFF
    h[17] = (h[17] ^ l.M17 ^ rrp16(l.N17, 19)) & 0xFFFFFFFF
    h[18] = (h[18] ^ l.M18 ^ rrp16(l.N18, 22)) & 0xFFFFFFFF
    h[19] = (h[19] ^ l.M19 ^ rrp16(l.N19, 25)) & 0xFFFFFFFF
    fin_synth20h(h)
}

// === W=21 半宽双轨特化内核（r，n=88/92/96/128/144；rrp16/0xFFFF 掩码）——轨A lanes[0..11)、轨B lanes[11..21)；R=8 ===
struct Lanes21h {
    var M0: i64 = 0
    var N0: i64 = 0
    var M1: i64 = 0
    var N1: i64 = 0
    var M2: i64 = 0
    var N2: i64 = 0
    var M3: i64 = 0
    var N3: i64 = 0
    var M4: i64 = 0
    var N4: i64 = 0
    var M5: i64 = 0
    var N5: i64 = 0
    var M6: i64 = 0
    var N6: i64 = 0
    var M7: i64 = 0
    var N7: i64 = 0
    var M8: i64 = 0
    var N8: i64 = 0
    var M9: i64 = 0
    var N9: i64 = 0
    var M10: i64 = 0
    var N10: i64 = 0
    var M11: i64 = 0
    var N11: i64 = 0
    var M12: i64 = 0
    var N12: i64 = 0
    var M13: i64 = 0
    var N13: i64 = 0
    var M14: i64 = 0
    var N14: i64 = 0
    var M15: i64 = 0
    var N15: i64 = 0
    var M16: i64 = 0
    var N16: i64 = 0
    var M17: i64 = 0
    var N17: i64 = 0
    var M18: i64 = 0
    var N18: i64 = 0
    var M19: i64 = 0
    var N19: i64 = 0
    var M20: i64 = 0
    var N20: i64 = 0
}

func ring21h_mixA(l: Lanes21h, r: i64
            , skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes21h {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0,
                    rrp16(l.M2, rA), rrp16(l.N2, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp16(l.M3, (rB + 3) & 31), rrp16(l.N3, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1,
                    rrp16(l.M3, (rA + 5) & 31), rrp16(l.N3, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp16(l.M4, (rB + 10) & 31), rrp16(l.N4, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M2, l.N2,
                    rrp16(l.M4, (rA + 10) & 31), rrp16(l.N4, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp16(l.M5, (rB + 17) & 31), rrp16(l.N5, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M3, l.N3,
                    rrp16(l.M5, (rA + 15) & 31), rrp16(l.N5, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp16(l.M6, (rB + 24) & 31), rrp16(l.N6, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M4, l.N4,
                    rrp16(l.M6, (rA + 20) & 31), rrp16(l.N6, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp16(l.M7, (rB + 31) & 31), rrp16(l.N7, (rB + 31) & 31))
    var (q5m, q5n) = tadd2(l.M5, l.N5,
                    rrp16(l.M7, (rA + 25) & 31), rrp16(l.N7, (rA + 25) & 31))
    var (s5m, s5n) = tadd2(q5m, q5n,
                    rrp16(l.M8, (rB + 6) & 31), rrp16(l.N8, (rB + 6) & 31))
    var (q6m, q6n) = tadd2(l.M6, l.N6,
                    rrp16(l.M8, (rA + 30) & 31), rrp16(l.N8, (rA + 30) & 31))
    var (s6m, s6n) = tadd2(q6m, q6n,
                    rrp16(l.M9, (rB + 13) & 31), rrp16(l.N9, (rB + 13) & 31))
    var (q7m, q7n) = tadd2(l.M7, l.N7,
                    rrp16(l.M9, (rA + 3) & 31), rrp16(l.N9, (rA + 3) & 31))
    var (s7m, s7n) = tadd2(q7m, q7n,
                    rrp16(l.M10, (rB + 20) & 31), rrp16(l.N10, (rB + 20) & 31))
    var (q8m, q8n) = tadd2(l.M8, l.N8,
                    rrp16(l.M10, (rA + 8) & 31), rrp16(l.N10, (rA + 8) & 31))
    var (s8m, s8n) = tadd2(q8m, q8n,
                    rrp16(l.M0, (rB + 27) & 31), rrp16(l.N0, (rB + 27) & 31))
    var (q9m, q9n) = tadd2(l.M9, l.N9,
                    rrp16(l.M0, (rA + 13) & 31), rrp16(l.N0, (rA + 13) & 31))
    var (s9m, s9n) = tadd2(q9m, q9n,
                    rrp16(l.M1, (rB + 2) & 31), rrp16(l.N1, (rB + 2) & 31))
    var (q10m, q10n) = tadd2(l.M10, l.N10,
                    rrp16(l.M1, (rA + 18) & 31), rrp16(l.N1, (rA + 18) & 31))
    var (s10m, s10n) = tadd2(q10m, q10n,
                    rrp16(l.M2, (rB + 9) & 31), rrp16(l.N2, (rB + 9) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    l.M2 = s2m
    l.N2 = s2n
    l.M3 = s3m
    l.N3 = s3n
    l.M4 = s4m
    l.N4 = s4n
    l.M5 = s5m
    l.N5 = s5n
    l.M6 = s6m
    l.N6 = s6n
    l.M7 = s7m
    l.N7 = s7n
    l.M8 = s8m
    l.N8 = s8n
    l.M9 = s9m
    l.N9 = s9n
    l.M10 = s10m
    l.N10 = s10n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M2 = (l.M2 ^ p1m) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M3 = (l.M3 ^ p2m) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s5m, s5n)
    l.M4 = (l.M4 ^ p3m) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s6m, s6n)
    l.M5 = (l.M5 ^ p4m) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ p4n) & 0xFFFFFFFF
    var (p5m, p5n) = tmul2(s5m, s5n, s7m, s7n)
    l.M6 = (l.M6 ^ p5m) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ p5n) & 0xFFFFFFFF
    var (p6m, p6n) = tmul2(s6m, s6n, s8m, s8n)
    l.M7 = (l.M7 ^ p6m) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ p6n) & 0xFFFFFFFF
    var (p7m, p7n) = tmul2(s7m, s7n, s9m, s9n)
    l.M8 = (l.M8 ^ p7m) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ p7n) & 0xFFFFFFFF
    var (p8m, p8n) = tmul2(s8m, s8n, s10m, s10n)
    l.M9 = (l.M9 ^ p8m) & 0xFFFFFFFF
    l.N9 = (l.N9 ^ p8n) & 0xFFFFFFFF
    var (p9m, p9n) = tmul2(s9m, s9n, s0m, s0n)
    l.M10 = (l.M10 ^ p9m) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ p9n) & 0xFFFFFFFF
    var (p10m, p10n) = tmul2(s10m, s10n, s1m, s1n)
    l.M0 = (l.M0 ^ p10m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p10n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M10 = (l.M10 ^ maj) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ rrp16(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M0, l.N0, rrp16(M0, mA), rrp16(N0, mA))
    l.M0 = im
    l.N0 = in2
    var (jm, jn2) = tadd2(l.M1, l.N1, rrp16(M1, (mA + 7) & 31), rrp16(N1, (mA + 7) & 31))
    l.M1 = jm
    l.N1 = jn2
    l.M0 = (l.M0 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ rrp16(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

func ring21h_mixB(l: Lanes21h, r: i64
            , skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes21h {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M11, l.N11,
                    rrp16(l.M13, rA), rrp16(l.N13, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp16(l.M14, (rB + 3) & 31), rrp16(l.N14, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M12, l.N12,
                    rrp16(l.M14, (rA + 5) & 31), rrp16(l.N14, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp16(l.M15, (rB + 10) & 31), rrp16(l.N15, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M13, l.N13,
                    rrp16(l.M15, (rA + 10) & 31), rrp16(l.N15, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp16(l.M16, (rB + 17) & 31), rrp16(l.N16, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M14, l.N14,
                    rrp16(l.M16, (rA + 15) & 31), rrp16(l.N16, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp16(l.M17, (rB + 24) & 31), rrp16(l.N17, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M15, l.N15,
                    rrp16(l.M17, (rA + 20) & 31), rrp16(l.N17, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp16(l.M18, (rB + 31) & 31), rrp16(l.N18, (rB + 31) & 31))
    var (q5m, q5n) = tadd2(l.M16, l.N16,
                    rrp16(l.M18, (rA + 25) & 31), rrp16(l.N18, (rA + 25) & 31))
    var (s5m, s5n) = tadd2(q5m, q5n,
                    rrp16(l.M19, (rB + 6) & 31), rrp16(l.N19, (rB + 6) & 31))
    var (q6m, q6n) = tadd2(l.M17, l.N17,
                    rrp16(l.M19, (rA + 30) & 31), rrp16(l.N19, (rA + 30) & 31))
    var (s6m, s6n) = tadd2(q6m, q6n,
                    rrp16(l.M20, (rB + 13) & 31), rrp16(l.N20, (rB + 13) & 31))
    var (q7m, q7n) = tadd2(l.M18, l.N18,
                    rrp16(l.M20, (rA + 3) & 31), rrp16(l.N20, (rA + 3) & 31))
    var (s7m, s7n) = tadd2(q7m, q7n,
                    rrp16(l.M11, (rB + 20) & 31), rrp16(l.N11, (rB + 20) & 31))
    var (q8m, q8n) = tadd2(l.M19, l.N19,
                    rrp16(l.M11, (rA + 8) & 31), rrp16(l.N11, (rA + 8) & 31))
    var (s8m, s8n) = tadd2(q8m, q8n,
                    rrp16(l.M12, (rB + 27) & 31), rrp16(l.N12, (rB + 27) & 31))
    var (q9m, q9n) = tadd2(l.M20, l.N20,
                    rrp16(l.M12, (rA + 13) & 31), rrp16(l.N12, (rA + 13) & 31))
    var (s9m, s9n) = tadd2(q9m, q9n,
                    rrp16(l.M13, (rB + 2) & 31), rrp16(l.N13, (rB + 2) & 31))
    l.M11 = s0m
    l.N11 = s0n
    l.M12 = s1m
    l.N12 = s1n
    l.M13 = s2m
    l.N13 = s2n
    l.M14 = s3m
    l.N14 = s3n
    l.M15 = s4m
    l.N15 = s4n
    l.M16 = s5m
    l.N16 = s5n
    l.M17 = s6m
    l.N17 = s6n
    l.M18 = s7m
    l.N18 = s7n
    l.M19 = s8m
    l.N19 = s8n
    l.M20 = s9m
    l.N20 = s9n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M12 = (l.M12 ^ p0m) & 0xFFFFFFFF
    l.N12 = (l.N12 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M13 = (l.M13 ^ p1m) & 0xFFFFFFFF
    l.N13 = (l.N13 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M14 = (l.M14 ^ p2m) & 0xFFFFFFFF
    l.N14 = (l.N14 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s5m, s5n)
    l.M15 = (l.M15 ^ p3m) & 0xFFFFFFFF
    l.N15 = (l.N15 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s6m, s6n)
    l.M16 = (l.M16 ^ p4m) & 0xFFFFFFFF
    l.N16 = (l.N16 ^ p4n) & 0xFFFFFFFF
    var (p5m, p5n) = tmul2(s5m, s5n, s7m, s7n)
    l.M17 = (l.M17 ^ p5m) & 0xFFFFFFFF
    l.N17 = (l.N17 ^ p5n) & 0xFFFFFFFF
    var (p6m, p6n) = tmul2(s6m, s6n, s8m, s8n)
    l.M18 = (l.M18 ^ p6m) & 0xFFFFFFFF
    l.N18 = (l.N18 ^ p6n) & 0xFFFFFFFF
    var (p7m, p7n) = tmul2(s7m, s7n, s9m, s9n)
    l.M19 = (l.M19 ^ p7m) & 0xFFFFFFFF
    l.N19 = (l.N19 ^ p7n) & 0xFFFFFFFF
    var (p8m, p8n) = tmul2(s8m, s8n, s0m, s0n)
    l.M20 = (l.M20 ^ p8m) & 0xFFFFFFFF
    l.N20 = (l.N20 ^ p8n) & 0xFFFFFFFF
    var (p9m, p9n) = tmul2(s9m, s9n, s1m, s1n)
    l.M11 = (l.M11 ^ p9m) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ p9n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M20 = (l.M20 ^ maj) & 0xFFFFFFFF
    l.N20 = (l.N20 ^ rrp16(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M11, l.N11, rrp16(M0, mA), rrp16(N0, mA))
    l.M11 = im
    l.N11 = in2
    var (jm, jn2) = tadd2(l.M12, l.N12, rrp16(M1, (mA + 7) & 31), rrp16(N1, (mA + 7) & 31))
    l.M12 = jm
    l.N12 = jn2
    l.M11 = (l.M11 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N20 = (l.N20 ^ rrp16(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

func ring21h_mixF(l: Lanes21h, r: i64
            , skey: i64
            ) -> Lanes21h {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0,
                    rrp16(l.M2, rA), rrp16(l.N2, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
