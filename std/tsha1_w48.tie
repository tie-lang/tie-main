type tie<class>
// ============================================================================
// tsha1_w48.tie：TSHA1 v2 的 n=48 W 特化内核（dual9 / dual11h）——struct 字段承载
//   lanes，把双轨 ring_mix / 注入 / 末块折回 / fin_synth 对 W=9（f/b/x）与 W=11
//   （r 半宽 rrp16）全部 unroll 为常数字段访问：零 table 分配、零动态 lanes 索引、
//   零 unsafe。语义唯源 gen_tsha1_core.py，与 std/tsha1.tie 的通用 compress 逐式一致。
//   复用 tsha1.tie 的 ensure_* 轮常量/IV 表（由 digest 传入本文件内的 compress_w9/w11）。
// ============================================================================
func rrp(v: i64, r: i64) -> i64 {
    return rr32(v, r & 31)
}

// 高半折叠进低半：消息平面（32 位、覆盖 64 字节位置）高 16 位整体补入第 16-31 字节位置。
// 对 ≤16 位的 r 状态值是恒等（x ^ 0）。
func fold16(v: i64) -> i64 {
    return ((v & 0xFFFF) ^ (v >> 16)) & 0xFFFF
}

// r 半宽旋转（dual11h 内核）：统一先 fold16 再 rrp16。本文件 rrp16 仅被 W=11（r 半宽）
// 内核使用（W=9 走 rrp），故在定义点折叠等价于在每个 rrp16 调用点先折叠——语义与
// canonical gen_tsha1_core._rot_lane(half=true) 一致。
func rrp16(v: i64, r: i64) -> i64 {
    return rr32(fold16(v), r & 15)
}

func rr32(v: i64, n: i64) -> i64 {
    return ((v >> n) | (v << (32 - n))) & 0xFFFFFFFF
}

func tadd2(Ma: i64, Na: i64, Mb: i64, Nb: i64) -> (mo: i64, no: i64) {
    var nMa = Ma ^ 0xFFFFFFFF
    var nNa = Na ^ 0xFFFFFFFF
    var nMb = Mb ^ 0xFFFFFFFF
    var nNb = Nb ^ 0xFFFFFFFF
    var aP = Ma & nNa
    var aN = Ma & Na
    var bP = Mb & nNb
    var bN = Mb & Nb
    var o_pos = ((nMa & Mb & nNb) | (Ma & nNa & nMb) | (aN & bN)) & 0xFFFFFFFF
    var o_neg = ((nMa & Mb & Nb) | (Ma & Na & nMb) | (aP & bP)) & 0xFFFFFFFF
    return (o_pos | o_neg, o_neg)
}

func tmul2(Ma: i64, Na: i64, Mb: i64, Nb: i64) -> (mo: i64, no: i64) {
    var amp = (Ma & Mb) & 0xFFFFFFFF
    var no = ((Na ^ Nb) & amp) & 0xFFFFFFFF
    return (amp, no)
}

func quant3(m0: i64, n0: i64, m1: i64, n1: i64, m2: i64, n2: i64) -> i64 {
    var A = m0 & (n0 ^ 0xFFFFFFFF)
    var B = m1 & (n1 ^ 0xFFFFFFFF)
    var C = m2 & (n2 ^ 0xFFFFFFFF)
    return ((A & B) | (B & C) | (C & A)) & 0xFFFFFFFF
}

// F1-2 位平面 16 项标量容器（替代 table<i64> Pw）：零堆分配、零动态索引，与 Lanes9/
// Lanes11h 同哲学——把吸收路径的位平面固化为常数字段，供 LLVM -O2 全展开常量折叠。
struct Planes16 {
    var w0: i64 = 0
    var w1: i64 = 0
    var w2: i64 = 0
    var w3: i64 = 0
    var w4: i64 = 0
    var w5: i64 = 0
    var w6: i64 = 0
    var w7: i64 = 0
    var w8: i64 = 0
    var w9: i64 = 0
    var w10: i64 = 0
    var w11: i64 = 0
    var w12: i64 = 0
    var w13: i64 = 0
    var w14: i64 = 0
    var w15: i64 = 0
}

// 位平面累积：skey / M/N 掩码 / 16 项 Pw 位平面。内部按「整块是否 64 字节齐全」
// 分两条等义路径——齐全块（pos+64 <= nbytes）走免逐字节越界判断的快路径（主要
// 场景，微基准 ~3.5x）；末块（不足 64 字节）走慢路径，越界字节按 0 处理。
// 两路径逐字节处理逐式一致，签名/返回语义与 canonical 完全不变。
func w48_planes_skey(msg: string, pos: i64, nbytes: i64) -> (m0: i64, n0: i64, m1: i64, n1: i64, pw: Planes16, skey: i64) {
    var M0v: i64 = 0
    var N0v: i64 = 0
    var M1v: i64 = 0
    var N1v: i64 = 0
    var Pw = Planes16()
    var skey: i64 = 0
    var j: i64 = 0
    if pos + 64 <= nbytes {
        // 快路径：整块 64 字节均在消息内（pos+64 <= nbytes ⇒ 任一 pos+j < nbytes），
        // 免去逐字节越界分支，让 LLVM 无分支依赖地展开/调度位平面累积。
        while j < 64 {
            var b = str_byte(msg, pos + j)
            var bits3 = b & 7
            var tf = (b >> 6) & 3
            var t = tf - 1
            // skey 位型与 canonical 核心一致：dig = bits3*3 + (t+1)（t+1==tf∈{0,1,2,3}）。
            // 不能用 tv 二元钳位（会把 t=2/tf=3 误并为 1，令高两位 11 的字节污染 skey）。
            var dig = bits3 * 3 + (t + 1)
            skey = (skey * 3 + dig) & 0xFFFFFFFF
            var wv = j / 32
            var bit = j % 32
            if t != 0 {
                if t > 0 {
                    if wv == 0 {
                        M0v = M0v | (1 << bit)
                    } else {
                        M1v = M1v | (1 << bit)
                    }
                } else {
                    if wv == 0 {
                        N0v = N0v | (1 << bit)
                    } else {
                        N1v = N1v | (1 << bit)
                    }
                }
            }
            // 位平面累积（标量 unroll：pi = biti*2 + wv，biti=0..7 → 偶/奇 8 项一组）。
            if wv == 0 {
                Pw.w0 = Pw.w0 | (((b >> 0) & 1) << bit)
                Pw.w2 = Pw.w2 | (((b >> 1) & 1) << bit)
                Pw.w4 = Pw.w4 | (((b >> 2) & 1) << bit)
                Pw.w6 = Pw.w6 | (((b >> 3) & 1) << bit)
                Pw.w8 = Pw.w8 | (((b >> 4) & 1) << bit)
                Pw.w10 = Pw.w10 | (((b >> 5) & 1) << bit)
                Pw.w12 = Pw.w12 | (((b >> 6) & 1) << bit)
                Pw.w14 = Pw.w14 | (((b >> 7) & 1) << bit)
            } else {
                Pw.w1 = Pw.w1 | (((b >> 0) & 1) << bit)
                Pw.w3 = Pw.w3 | (((b >> 1) & 1) << bit)
                Pw.w5 = Pw.w5 | (((b >> 2) & 1) << bit)
                Pw.w7 = Pw.w7 | (((b >> 3) & 1) << bit)
                Pw.w9 = Pw.w9 | (((b >> 4) & 1) << bit)
                Pw.w11 = Pw.w11 | (((b >> 5) & 1) << bit)
                Pw.w13 = Pw.w13 | (((b >> 6) & 1) << bit)
                Pw.w15 = Pw.w15 | (((b >> 7) & 1) << bit)
            }
            j = j + 1
        }
    } else {
        // 慢路径：末块（pos+64 > nbytes），逐字节越界判断，越界字节按 0 处理。
        while j < 64 {
            var b: i64 = 0
            if pos + j < nbytes {
                b = str_byte(msg, pos + j)
            }
            var bits3 = b & 7
            var tf = (b >> 6) & 3
            var t = tf - 1
            var dig = bits3 * 3 + (t + 1)
            skey = (skey * 3 + dig) & 0xFFFFFFFF
            var wv = j / 32
            var bit = j % 32
            if t != 0 {
                if t > 0 {
                    if wv == 0 {
                        M0v = M0v | (1 << bit)
                    } else {
                        M1v = M1v | (1 << bit)
                    }
                } else {
                    if wv == 0 {
                        N0v = N0v | (1 << bit)
                    } else {
                        N1v = N1v | (1 << bit)
                    }
                }
            }
            if wv == 0 {
                Pw.w0 = Pw.w0 | (((b >> 0) & 1) << bit)
                Pw.w2 = Pw.w2 | (((b >> 1) & 1) << bit)
                Pw.w4 = Pw.w4 | (((b >> 2) & 1) << bit)
                Pw.w6 = Pw.w6 | (((b >> 3) & 1) << bit)
                Pw.w8 = Pw.w8 | (((b >> 4) & 1) << bit)
                Pw.w10 = Pw.w10 | (((b >> 5) & 1) << bit)
                Pw.w12 = Pw.w12 | (((b >> 6) & 1) << bit)
                Pw.w14 = Pw.w14 | (((b >> 7) & 1) << bit)
            } else {
                Pw.w1 = Pw.w1 | (((b >> 0) & 1) << bit)
                Pw.w3 = Pw.w3 | (((b >> 1) & 1) << bit)
                Pw.w5 = Pw.w5 | (((b >> 2) & 1) << bit)
                Pw.w7 = Pw.w7 | (((b >> 3) & 1) << bit)
                Pw.w9 = Pw.w9 | (((b >> 4) & 1) << bit)
                Pw.w11 = Pw.w11 | (((b >> 5) & 1) << bit)
                Pw.w13 = Pw.w13 | (((b >> 6) & 1) << bit)
                Pw.w15 = Pw.w15 | (((b >> 7) & 1) << bit)
            }
            j = j + 1
        }
    }
    return (M0v & 0xFFFFFFFF, N0v & 0xFFFFFFFF, M1v & 0xFFFFFFFF, N1v & 0xFFFFFFFF, Pw, skey)
}

struct Lanes9 {
    var M0: i64 = 0
    var N0: i64 = 0
    var M1: i64 = 0
    var N1: i64 = 0
    var M2: i64 = 0
    var N2: i64 = 0
    var M3: i64 = 0
    var N3: i64 = 0
    var M4: i64 = 0
    var N4: i64 = 0
    var M5: i64 = 0
    var N5: i64 = 0
    var M6: i64 = 0
    var N6: i64 = 0
    var M7: i64 = 0
    var N7: i64 = 0
    var M8: i64 = 0
    var N8: i64 = 0
}

struct Lanes11h {
    var M0: i64 = 0
    var N0: i64 = 0
    var M1: i64 = 0
    var N1: i64 = 0
    var M2: i64 = 0
    var N2: i64 = 0
    var M3: i64 = 0
    var N3: i64 = 0
    var M4: i64 = 0
    var N4: i64 = 0
    var M5: i64 = 0
    var N5: i64 = 0
    var M6: i64 = 0
    var N6: i64 = 0
    var M7: i64 = 0
    var N7: i64 = 0
    var M8: i64 = 0
    var N8: i64 = 0
    var M9: i64 = 0
    var N9: i64 = 0
    var M10: i64 = 0
    var N10: i64 = 0
}

func ring9_mixA(l: Lanes9, r: i64
            , skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes9 {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0,
                    rrp(l.M2, rA), rrp(l.N2, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp(l.M3, (rB + 3) & 31), rrp(l.N3, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1,
                    rrp(l.M3, (rA + 5) & 31), rrp(l.N3, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp(l.M4, (rB + 10) & 31), rrp(l.N4, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M2, l.N2,
                    rrp(l.M4, (rA + 10) & 31), rrp(l.N4, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp(l.M0, (rB + 17) & 31), rrp(l.N0, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M3, l.N3,
                    rrp(l.M0, (rA + 15) & 31), rrp(l.N0, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp(l.M1, (rB + 24) & 31), rrp(l.N1, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M4, l.N4,
                    rrp(l.M1, (rA + 20) & 31), rrp(l.N1, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp(l.M2, (rB + 31) & 31), rrp(l.N2, (rB + 31) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    l.M2 = s2m
    l.N2 = s2n
    l.M3 = s3m
    l.N3 = s3n
    l.M4 = s4m
    l.N4 = s4n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M2 = (l.M2 ^ p1m) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M3 = (l.M3 ^ p2m) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s0m, s0n)
    l.M4 = (l.M4 ^ p3m) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s1m, s1n)
    l.M0 = (l.M0 ^ p4m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p4n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M4 = (l.M4 ^ maj) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M0, l.N0, rrp(M0, mA), rrp(N0, mA))
    l.M0 = im
    l.N0 = in2
    var (jm, jn2) = tadd2(l.M1, l.N1, rrp(M1, (mA + 7) & 31), rrp(N1, (mA + 7) & 31))
    l.M1 = jm
    l.N1 = jn2
    l.M0 = (l.M0 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ rrp(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

func ring9_mixB(l: Lanes9, r: i64
            , skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes9 {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M5, l.N5,
                    rrp(l.M7, rA), rrp(l.N7, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp(l.M8, (rB + 3) & 31), rrp(l.N8, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M6, l.N6,
                    rrp(l.M8, (rA + 5) & 31), rrp(l.N8, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp(l.M5, (rB + 10) & 31), rrp(l.N5, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M7, l.N7,
                    rrp(l.M5, (rA + 10) & 31), rrp(l.N5, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp(l.M6, (rB + 17) & 31), rrp(l.N6, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M8, l.N8,
                    rrp(l.M6, (rA + 15) & 31), rrp(l.N6, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp(l.M7, (rB + 24) & 31), rrp(l.N7, (rB + 24) & 31))
    l.M5 = s0m
    l.N5 = s0n
    l.M6 = s1m
    l.N6 = s1n
    l.M7 = s2m
    l.N7 = s2n
    l.M8 = s3m
    l.N8 = s3n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M6 = (l.M6 ^ p0m) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M7 = (l.M7 ^ p1m) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s0m, s0n)
    l.M8 = (l.M8 ^ p2m) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s1m, s1n)
    l.M5 = (l.M5 ^ p3m) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ p3n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M8 = (l.M8 ^ maj) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M5, l.N5, rrp(M0, mA), rrp(N0, mA))
    l.M5 = im
    l.N5 = in2
    var (jm, jn2) = tadd2(l.M6, l.N6, rrp(M1, (mA + 7) & 31), rrp(N1, (mA + 7) & 31))
    l.M6 = jm
    l.N6 = jn2
    l.M5 = (l.M5 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ rrp(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

func ring9_mixF(l: Lanes9, r: i64
            , skey: i64
            ) -> Lanes9 {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0,
                    rrp(l.M2, rA), rrp(l.N2, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp(l.M3, (rB + 3) & 31), rrp(l.N3, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1,
                    rrp(l.M3, (rA + 5) & 31), rrp(l.N3, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp(l.M4, (rB + 10) & 31), rrp(l.N4, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M2, l.N2,
                    rrp(l.M4, (rA + 10) & 31), rrp(l.N4, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp(l.M5, (rB + 17) & 31), rrp(l.N5, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M3, l.N3,
                    rrp(l.M5, (rA + 15) & 31), rrp(l.N5, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp(l.M6, (rB + 24) & 31), rrp(l.N6, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M4, l.N4,
                    rrp(l.M6, (rA + 20) & 31), rrp(l.N6, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp(l.M7, (rB + 31) & 31), rrp(l.N7, (rB + 31) & 31))
    var (q5m, q5n) = tadd2(l.M5, l.N5,
                    rrp(l.M7, (rA + 25) & 31), rrp(l.N7, (rA + 25) & 31))
    var (s5m, s5n) = tadd2(q5m, q5n,
                    rrp(l.M8, (rB + 6) & 31), rrp(l.N8, (rB + 6) & 31))
    var (q6m, q6n) = tadd2(l.M6, l.N6,
                    rrp(l.M8, (rA + 30) & 31), rrp(l.N8, (rA + 30) & 31))
    var (s6m, s6n) = tadd2(q6m, q6n,
                    rrp(l.M0, (rB + 13) & 31), rrp(l.N0, (rB + 13) & 31))
    var (q7m, q7n) = tadd2(l.M7, l.N7,
                    rrp(l.M0, (rA + 3) & 31), rrp(l.N0, (rA + 3) & 31))
    var (s7m, s7n) = tadd2(q7m, q7n,
                    rrp(l.M1, (rB + 20) & 31), rrp(l.N1, (rB + 20) & 31))
    var (q8m, q8n) = tadd2(l.M8, l.N8,
                    rrp(l.M1, (rA + 8) & 31), rrp(l.N1, (rA + 8) & 31))
    var (s8m, s8n) = tadd2(q8m, q8n,
                    rrp(l.M2, (rB + 27) & 31), rrp(l.N2, (rB + 27) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    l.M2 = s2m
    l.N2 = s2n
    l.M3 = s3m
    l.N3 = s3n
    l.M4 = s4m
    l.N4 = s4n
    l.M5 = s5m
    l.N5 = s5n
    l.M6 = s6m
    l.N6 = s6n
    l.M7 = s7m
    l.N7 = s7n
    l.M8 = s8m
    l.N8 = s8n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M2 = (l.M2 ^ p1m) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M3 = (l.M3 ^ p2m) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s5m, s5n)
    l.M4 = (l.M4 ^ p3m) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s6m, s6n)
    l.M5 = (l.M5 ^ p4m) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ p4n) & 0xFFFFFFFF
    var (p5m, p5n) = tmul2(s5m, s5n, s7m, s7n)
    l.M6 = (l.M6 ^ p5m) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ p5n) & 0xFFFFFFFF
    var (p6m, p6n) = tmul2(s6m, s6n, s8m, s8n)
    l.M7 = (l.M7 ^ p6m) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ p6n) & 0xFFFFFFFF
    var (p7m, p7n) = tmul2(s7m, s7n, s0m, s0n)
    l.M8 = (l.M8 ^ p7m) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ p7n) & 0xFFFFFFFF
    var (p8m, p8n) = tmul2(s8m, s8n, s1m, s1n)
    l.M0 = (l.M0 ^ p8m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p8n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M8 = (l.M8 ^ maj) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    return l
}

func ring11_mixA(l: Lanes11h, r: i64
            , skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes11h {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0,
                    rrp16(l.M2, rA), rrp16(l.N2, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp16(l.M3, (rB + 3) & 31), rrp16(l.N3, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1,
                    rrp16(l.M3, (rA + 5) & 31), rrp16(l.N3, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp16(l.M4, (rB + 10) & 31), rrp16(l.N4, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M2, l.N2,
                    rrp16(l.M4, (rA + 10) & 31), rrp16(l.N4, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp16(l.M5, (rB + 17) & 31), rrp16(l.N5, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M3, l.N3,
                    rrp16(l.M5, (rA + 15) & 31), rrp16(l.N5, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp16(l.M0, (rB + 24) & 31), rrp16(l.N0, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M4, l.N4,
                    rrp16(l.M0, (rA + 20) & 31), rrp16(l.N0, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp16(l.M1, (rB + 31) & 31), rrp16(l.N1, (rB + 31) & 31))
    var (q5m, q5n) = tadd2(l.M5, l.N5,
                    rrp16(l.M1, (rA + 25) & 31), rrp16(l.N1, (rA + 25) & 31))
    var (s5m, s5n) = tadd2(q5m, q5n,
                    rrp16(l.M2, (rB + 6) & 31), rrp16(l.N2, (rB + 6) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    l.M2 = s2m
    l.N2 = s2n
    l.M3 = s3m
    l.N3 = s3n
    l.M4 = s4m
    l.N4 = s4n
    l.M5 = s5m
    l.N5 = s5n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M2 = (l.M2 ^ p1m) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M3 = (l.M3 ^ p2m) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s5m, s5n)
    l.M4 = (l.M4 ^ p3m) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s0m, s0n)
    l.M5 = (l.M5 ^ p4m) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ p4n) & 0xFFFFFFFF
    var (p5m, p5n) = tmul2(s5m, s5n, s1m, s1n)
    l.M0 = (l.M0 ^ p5m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p5n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M5 = (l.M5 ^ maj) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ rrp16(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M0, l.N0, rrp16(M0, mA), rrp16(N0, mA))
    l.M0 = im
    l.N0 = in2
    var (jm, jn2) = tadd2(l.M1, l.N1, rrp16(M1, (mA + 7) & 31), rrp16(N1, (mA + 7) & 31))
    l.M1 = jm
    l.N1 = jn2
    l.M0 = (l.M0 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ rrp16(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

func ring11_mixB(l: Lanes11h, r: i64
            , skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes11h {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M6, l.N6,
                    rrp16(l.M8, rA), rrp16(l.N8, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp16(l.M9, (rB + 3) & 31), rrp16(l.N9, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M7, l.N7,
                    rrp16(l.M9, (rA + 5) & 31), rrp16(l.N9, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp16(l.M10, (rB + 10) & 31), rrp16(l.N10, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M8, l.N8,
                    rrp16(l.M10, (rA + 10) & 31), rrp16(l.N10, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp16(l.M6, (rB + 17) & 31), rrp16(l.N6, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M9, l.N9,
                    rrp16(l.M6, (rA + 15) & 31), rrp16(l.N6, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp16(l.M7, (rB + 24) & 31), rrp16(l.N7, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M10, l.N10,
                    rrp16(l.M7, (rA + 20) & 31), rrp16(l.N7, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp16(l.M8, (rB + 31) & 31), rrp16(l.N8, (rB + 31) & 31))
    l.M6 = s0m
    l.N6 = s0n
    l.M7 = s1m
    l.N7 = s1n
    l.M8 = s2m
    l.N8 = s2n
    l.M9 = s3m
    l.N9 = s3n
    l.M10 = s4m
    l.N10 = s4n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M7 = (l.M7 ^ p0m) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M8 = (l.M8 ^ p1m) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M9 = (l.M9 ^ p2m) & 0xFFFFFFFF
    l.N9 = (l.N9 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s0m, s0n)
    l.M10 = (l.M10 ^ p3m) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s1m, s1n)
    l.M6 = (l.M6 ^ p4m) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ p4n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M10 = (l.M10 ^ maj) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ rrp16(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M6, l.N6, rrp16(M0, mA), rrp16(N0, mA))
    l.M6 = im
    l.N6 = in2
    var (jm, jn2) = tadd2(l.M7, l.N7, rrp16(M1, (mA + 7) & 31), rrp16(N1, (mA + 7) & 31))
    l.M7 = jm
    l.N7 = jn2
    l.M6 = (l.M6 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ rrp16(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

func ring11_mixF(l: Lanes11h, r: i64
            , skey: i64
            ) -> Lanes11h {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0,
                    rrp16(l.M2, rA), rrp16(l.N2, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp16(l.M3, (rB + 3) & 31), rrp16(l.N3, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1,
                    rrp16(l.M3, (rA + 5) & 31), rrp16(l.N3, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp16(l.M4, (rB + 10) & 31), rrp16(l.N4, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M2, l.N2,
                    rrp16(l.M4, (rA + 10) & 31), rrp16(l.N4, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp16(l.M5, (rB + 17) & 31), rrp16(l.N5, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M3, l.N3,
                    rrp16(l.M5, (rA + 15) & 31), rrp16(l.N5, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp16(l.M6, (rB + 24) & 31), rrp16(l.N6, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M4, l.N4,
                    rrp16(l.M6, (rA + 20) & 31), rrp16(l.N6, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp16(l.M7, (rB + 31) & 31), rrp16(l.N7, (rB + 31) & 31))
    var (q5m, q5n) = tadd2(l.M5, l.N5,
                    rrp16(l.M7, (rA + 25) & 31), rrp16(l.N7, (rA + 25) & 31))
    var (s5m, s5n) = tadd2(q5m, q5n,
                    rrp16(l.M8, (rB + 6) & 31), rrp16(l.N8, (rB + 6) & 31))
    var (q6m, q6n) = tadd2(l.M6, l.N6,
                    rrp16(l.M8, (rA + 30) & 31), rrp16(l.N8, (rA + 30) & 31))
    var (s6m, s6n) = tadd2(q6m, q6n,
                    rrp16(l.M9, (rB + 13) & 31), rrp16(l.N9, (rB + 13) & 31))
    var (q7m, q7n) = tadd2(l.M7, l.N7,
                    rrp16(l.M9, (rA + 3) & 31), rrp16(l.N9, (rA + 3) & 31))
    var (s7m, s7n) = tadd2(q7m, q7n,
                    rrp16(l.M10, (rB + 20) & 31), rrp16(l.N10, (rB + 20) & 31))
    var (q8m, q8n) = tadd2(l.M8, l.N8,
                    rrp16(l.M10, (rA + 8) & 31), rrp16(l.N10, (rA + 8) & 31))
    var (s8m, s8n) = tadd2(q8m, q8n,
                    rrp16(l.M0, (rB + 27) & 31), rrp16(l.N0, (rB + 27) & 31))
    var (q9m, q9n) = tadd2(l.M9, l.N9,
                    rrp16(l.M0, (rA + 13) & 31), rrp16(l.N0, (rA + 13) & 31))
    var (s9m, s9n) = tadd2(q9m, q9n,
                    rrp16(l.M1, (rB + 2) & 31), rrp16(l.N1, (rB + 2) & 31))
    var (q10m, q10n) = tadd2(l.M10, l.N10,
                    rrp16(l.M1, (rA + 18) & 31), rrp16(l.N1, (rA + 18) & 31))
    var (s10m, s10n) = tadd2(q10m, q10n,
                    rrp16(l.M2, (rB + 9) & 31), rrp16(l.N2, (rB + 9) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    l.M2 = s2m
    l.N2 = s2n
    l.M3 = s3m
    l.N3 = s3n
    l.M4 = s4m
    l.N4 = s4n
    l.M5 = s5m
    l.N5 = s5n
    l.M6 = s6m
    l.N6 = s6n
    l.M7 = s7m
    l.N7 = s7n
    l.M8 = s8m
    l.N8 = s8n
    l.M9 = s9m
    l.N9 = s9n
    l.M10 = s10m
    l.N10 = s10n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M2 = (l.M2 ^ p1m) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M3 = (l.M3 ^ p2m) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s5m, s5n)
    l.M4 = (l.M4 ^ p3m) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s6m, s6n)
    l.M5 = (l.M5 ^ p4m) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ p4n) & 0xFFFFFFFF
    var (p5m, p5n) = tmul2(s5m, s5n, s7m, s7n)
    l.M6 = (l.M6 ^ p5m) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ p5n) & 0xFFFFFFFF
    var (p6m, p6n) = tmul2(s6m, s6n, s8m, s8n)
    l.M7 = (l.M7 ^ p6m) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ p6n) & 0xFFFFFFFF
    var (p7m, p7n) = tmul2(s7m, s7n, s9m, s9n)
    l.M8 = (l.M8 ^ p7m) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ p7n) & 0xFFFFFFFF
    var (p8m, p8n) = tmul2(s8m, s8n, s10m, s10n)
    l.M9 = (l.M9 ^ p8m) & 0xFFFFFFFF
    l.N9 = (l.N9 ^ p8n) & 0xFFFFFFFF
    var (p9m, p9n) = tmul2(s9m, s9n, s0m, s0n)
    l.M10 = (l.M10 ^ p9m) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ p9n) & 0xFFFFFFFF
    var (p10m, p10n) = tmul2(s10m, s10n, s1m, s1n)
    l.M0 = (l.M0 ^ p10m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p10n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M10 = (l.M10 ^ maj) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ rrp16(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    return l
}

func fin_synth9(h: ref table<i64>) {
    var l = Lanes9()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp(h[1], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp(h[2], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp(h[3], 7)
    l.M3 = h[3] & 0xFFFFFFFF
    l.N3 = rrp(h[4], 7)
    l.M4 = h[4] & 0xFFFFFFFF
    l.N4 = rrp(h[5], 7)
    l.M5 = h[5] & 0xFFFFFFFF
    l.N5 = rrp(h[6], 7)
    l.M6 = h[6] & 0xFFFFFFFF
    l.N6 = rrp(h[7], 7)
    l.M7 = h[7] & 0xFFFFFFFF
    l.N7 = rrp(h[8], 7)
    l.M8 = h[8] & 0xFFFFFFFF
    l.N8 = rrp(h[0], 7)
    var sf: i64 = 0
    while sf < 4 {
        l = ring9_mixF(l, sf, 0x13579BDF)
        sf = sf + 1
    }
    h[0] = (l.M0 ^ rrp(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (l.M1 ^ rrp(l.N1, 5)) & 0xFFFFFFFF
    h[2] = (l.M2 ^ rrp(l.N2, 10)) & 0xFFFFFFFF
    h[3] = (l.M3 ^ rrp(l.N3, 15)) & 0xFFFFFFFF
    h[4] = (l.M4 ^ rrp(l.N4, 20)) & 0xFFFFFFFF
    h[5] = (l.M5 ^ rrp(l.N5, 25)) & 0xFFFFFFFF
    h[6] = (l.M6 ^ rrp(l.N6, 30)) & 0xFFFFFFFF
    h[7] = (l.M7 ^ rrp(l.N7, 3)) & 0xFFFFFFFF
    h[8] = (l.M8 ^ rrp(l.N8, 8)) & 0xFFFFFFFF
}

func fin_synth11(h: ref table<i64>) {
    var l = Lanes11h()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp16(h[1], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp16(h[2], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp16(h[3], 7)
    l.M3 = h[3] & 0xFFFFFFFF
    l.N3 = rrp16(h[4], 7)
    l.M4 = h[4] & 0xFFFFFFFF
    l.N4 = rrp16(h[5], 7)
    l.M5 = h[5] & 0xFFFFFFFF
    l.N5 = rrp16(h[6], 7)
    l.M6 = h[6] & 0xFFFFFFFF
    l.N6 = rrp16(h[7], 7)
    l.M7 = h[7] & 0xFFFFFFFF
    l.N7 = rrp16(h[8], 7)
    l.M8 = h[8] & 0xFFFFFFFF
    l.N8 = rrp16(h[9], 7)
    l.M9 = h[9] & 0xFFFFFFFF
    l.N9 = rrp16(h[10], 7)
    l.M10 = h[10] & 0xFFFFFFFF
    l.N10 = rrp16(h[0], 7)
    var sf: i64 = 0
    while sf < 4 {
        l = ring11_mixF(l, sf, 0x13579BDF)
        sf = sf + 1
    }
    h[0] = (l.M0 ^ rrp16(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (l.M1 ^ rrp16(l.N1, 5)) & 0xFFFFFFFF
    h[2] = (l.M2 ^ rrp16(l.N2, 10)) & 0xFFFFFFFF
    h[3] = (l.M3 ^ rrp16(l.N3, 15)) & 0xFFFFFFFF
    h[4] = (l.M4 ^ rrp16(l.N4, 20)) & 0xFFFFFFFF
    h[5] = (l.M5 ^ rrp16(l.N5, 25)) & 0xFFFFFFFF
    h[6] = (l.M6 ^ rrp16(l.N6, 30)) & 0xFFFFFFFF
    h[7] = (l.M7 ^ rrp16(l.N7, 3)) & 0xFFFFFFFF
    h[8] = (l.M8 ^ rrp16(l.N8, 8)) & 0xFFFFFFFF
    h[9] = (l.M9 ^ rrp16(l.N9, 13)) & 0xFFFFFFFF
    h[10] = (l.M10 ^ rrp16(l.N10, 18)) & 0xFFFFFFFF
}

// F1-2 位平面吸收（W=9 全宽内核，半宽=false → rrp）。逐条 Pw 按锚点字 w%9
// 平衡加并入 l 字段（tadd2 后写回原字段，与通用路径 lanes 语义逐式一致）。
func absorb9(l: Lanes9, Pw: Planes16, skey: i64) -> Lanes9 {
    var w: i64 = 0
    while w < 16 {
        var pv: i64 = 0
        if w == 0 {
            pv = Pw.w0
        } else if w == 1 {
            pv = Pw.w1
        } else if w == 2 {
            pv = Pw.w2
        } else if w == 3 {
            pv = Pw.w3
        } else if w == 4 {
            pv = Pw.w4
        } else if w == 5 {
            pv = Pw.w5
        } else if w == 6 {
            pv = Pw.w6
        } else if w == 7 {
            pv = Pw.w7
        } else if w == 8 {
            pv = Pw.w8
        } else if w == 9 {
            pv = Pw.w9
        } else if w == 10 {
            pv = Pw.w10
        } else if w == 11 {
            pv = Pw.w11
        } else if w == 12 {
            pv = Pw.w12
        } else if w == 13 {
            pv = Pw.w13
        } else if w == 14 {
            pv = Pw.w14
        } else {
            pv = Pw.w15
        }
        if pv != 0 {
            var a = (w * 5 + ((skey >> (w & 7)) & 7)) & 31
            var an = w % 9
            var v = rrp(pv, a)
            var v2 = rrp(pv, a + 17)
            if an == 0 {
                var (s0m, s0n) = tadd2(l.M0, l.N0, v, v2)
                l.M0 = s0m & 0xFFFFFFFF
                l.N0 = s0n & 0xFFFFFFFF
            } else if an == 1 {
                var (s1m, s1n) = tadd2(l.M1, l.N1, v, v2)
                l.M1 = s1m & 0xFFFFFFFF
                l.N1 = s1n & 0xFFFFFFFF
            } else if an == 2 {
                var (s2m, s2n) = tadd2(l.M2, l.N2, v, v2)
                l.M2 = s2m & 0xFFFFFFFF
                l.N2 = s2n & 0xFFFFFFFF
            } else if an == 3 {
                var (s3m, s3n) = tadd2(l.M3, l.N3, v, v2)
                l.M3 = s3m & 0xFFFFFFFF
                l.N3 = s3n & 0xFFFFFFFF
            } else if an == 4 {
                var (s4m, s4n) = tadd2(l.M4, l.N4, v, v2)
                l.M4 = s4m & 0xFFFFFFFF
                l.N4 = s4n & 0xFFFFFFFF
            } else if an == 5 {
                var (s5m, s5n) = tadd2(l.M5, l.N5, v, v2)
                l.M5 = s5m & 0xFFFFFFFF
                l.N5 = s5n & 0xFFFFFFFF
            } else if an == 6 {
                var (s6m, s6n) = tadd2(l.M6, l.N6, v, v2)
                l.M6 = s6m & 0xFFFFFFFF
                l.N6 = s6n & 0xFFFFFFFF
            } else if an == 7 {
                var (s7m, s7n) = tadd2(l.M7, l.N7, v, v2)
                l.M7 = s7m & 0xFFFFFFFF
                l.N7 = s7n & 0xFFFFFFFF
            } else {
                var (s8m, s8n) = tadd2(l.M8, l.N8, v, v2)
                l.M8 = s8m & 0xFFFFFFFF
                l.N8 = s8n & 0xFFFFFFFF
            }
        }
        w = w + 1
    }
    return l
}

// F1-2 位平面吸收（W=11 半宽内核，半宽=true → rrp16）。锚点字 w%11。
func absorb11h(l: Lanes11h, Pw: Planes16, skey: i64) -> Lanes11h {
    var w: i64 = 0
    while w < 16 {
        var pv: i64 = 0
        if w == 0 {
            pv = Pw.w0
        } else if w == 1 {
            pv = Pw.w1
        } else if w == 2 {
            pv = Pw.w2
        } else if w == 3 {
            pv = Pw.w3
        } else if w == 4 {
            pv = Pw.w4
        } else if w == 5 {
            pv = Pw.w5
        } else if w == 6 {
            pv = Pw.w6
        } else if w == 7 {
            pv = Pw.w7
        } else if w == 8 {
            pv = Pw.w8
        } else if w == 9 {
            pv = Pw.w9
        } else if w == 10 {
            pv = Pw.w10
        } else if w == 11 {
            pv = Pw.w11
        } else if w == 12 {
            pv = Pw.w12
        } else if w == 13 {
            pv = Pw.w13
        } else if w == 14 {
            pv = Pw.w14
        } else {
            pv = Pw.w15
        }
        if pv != 0 {
            var a = (w * 5 + ((skey >> (w & 7)) & 7)) & 31
            var an = w % 11
            var v = rrp16(pv, a)
            var v2 = rrp16(pv, a + 17)
            if an == 0 {
                var (t0m, t0n) = tadd2(l.M0, l.N0, v, v2)
                l.M0 = t0m & 0xFFFFFFFF
                l.N0 = t0n & 0xFFFFFFFF
            } else if an == 1 {
                var (t1m, t1n) = tadd2(l.M1, l.N1, v, v2)
                l.M1 = t1m & 0xFFFFFFFF
                l.N1 = t1n & 0xFFFFFFFF
            } else if an == 2 {
                var (t2m, t2n) = tadd2(l.M2, l.N2, v, v2)
                l.M2 = t2m & 0xFFFFFFFF
                l.N2 = t2n & 0xFFFFFFFF
            } else if an == 3 {
                var (t3m, t3n) = tadd2(l.M3, l.N3, v, v2)
                l.M3 = t3m & 0xFFFFFFFF
                l.N3 = t3n & 0xFFFFFFFF
            } else if an == 4 {
                var (t4m, t4n) = tadd2(l.M4, l.N4, v, v2)
                l.M4 = t4m & 0xFFFFFFFF
                l.N4 = t4n & 0xFFFFFFFF
            } else if an == 5 {
                var (t5m, t5n) = tadd2(l.M5, l.N5, v, v2)
                l.M5 = t5m & 0xFFFFFFFF
                l.N5 = t5n & 0xFFFFFFFF
            } else if an == 6 {
                var (t6m, t6n) = tadd2(l.M6, l.N6, v, v2)
                l.M6 = t6m & 0xFFFFFFFF
                l.N6 = t6n & 0xFFFFFFFF
            } else if an == 7 {
                var (t7m, t7n) = tadd2(l.M7, l.N7, v, v2)
                l.M7 = t7m & 0xFFFFFFFF
                l.N7 = t7n & 0xFFFFFFFF
            } else if an == 8 {
                var (t8m, t8n) = tadd2(l.M8, l.N8, v, v2)
                l.M8 = t8m & 0xFFFFFFFF
                l.N8 = t8n & 0xFFFFFFFF
            } else if an == 9 {
                var (t9m, t9n) = tadd2(l.M9, l.N9, v, v2)
                l.M9 = t9m & 0xFFFFFFFF
                l.N9 = t9n & 0xFFFFFFFF
            } else {
                var (tAm, tAn) = tadd2(l.M10, l.N10, v, v2)
                l.M10 = tAm & 0xFFFFFFFF
                l.N10 = tAn & 0xFFFFFFFF
            }
        }
        w = w + 1
    }
    return l
}

pub func compress_w9(h: ref table<i64>, msg: string, pos: i64, nbytes: i64,
            t_lo: i64, t_hi: i64, last: bool,
            iv: table<i64>, rcon: table<i64>, R: i64) {
    var (M0, N0, M1, N1, Pw, skey) = w48_planes_skey(msg, pos, nbytes)
    var l = Lanes9()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp(h[4], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp(h[5], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp(h[6], 7)
    l.M3 = h[3] & 0xFFFFFFFF
    l.N3 = rrp(h[7], 7)
    l.M4 = h[4] & 0xFFFFFFFF
    l.N4 = rrp(h[8], 7)
    l.M5 = h[5] & 0xFFFFFFFF
    l.N5 = rrp(h[0], 7)
    l.M6 = h[6] & 0xFFFFFFFF
    l.N6 = rrp(h[1], 7)
    l.M7 = h[7] & 0xFFFFFFFF
    l.N7 = rrp(h[2], 7)
    l.M8 = h[8] & 0xFFFFFFFF
    l.N8 = rrp(h[3], 7)
    l.M0 = (l.M0 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M1 = (l.M1 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M2 = (l.M2 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M3 = (l.M3 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M4 = (l.M4 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M5 = (l.M5 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M6 = (l.M6 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M7 = (l.M7 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M8 = (l.M8 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (t_lo & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ (t_hi & 0xFFFFFFFF)) & 0xFFFFFFFF
    if last {
        l.N4 = (l.N4 ^ 0xFFFFFFFF) & 0xFFFFFFFF
    }
    l = absorb9(l, Pw, skey)   // F1-2：位平面吸收（IV/计数器混入之后、轮循环之前，每块一次）
    var mA: i64 = 0
    var mC: i64 = 0
    var r: i64 = 0
    while r < R {
        mA = (r * 5 + ((skey >> 6) & 7)) & 31
        mC = (r * 7 + ((skey >> 12) & 7)) & 31
        l = ring9_mixA(l, r, skey, M0, N0, M1, N1, mA, rcon, r)
        l = ring9_mixB(l, r, skey, M0, N0, M1, N1, mC, rcon, (r + 8) & 15)
        r = r + 1
    }
    h[0] = (h[0] ^ l.M0 ^ rrp(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (h[1] ^ l.M1 ^ rrp(l.N1, 3)) & 0xFFFFFFFF
    h[2] = (h[2] ^ l.M2 ^ rrp(l.N2, 6)) & 0xFFFFFFFF
    h[3] = (h[3] ^ l.M3 ^ rrp(l.N3, 9)) & 0xFFFFFFFF
    h[4] = (h[4] ^ l.M4 ^ rrp(l.N4, 12)) & 0xFFFFFFFF
    h[5] = (h[5] ^ l.M5 ^ rrp(l.N5, 15)) & 0xFFFFFFFF
    h[6] = (h[6] ^ l.M6 ^ rrp(l.N6, 18)) & 0xFFFFFFFF
    h[7] = (h[7] ^ l.M7 ^ rrp(l.N7, 21)) & 0xFFFFFFFF
    h[8] = (h[8] ^ l.M8 ^ rrp(l.N8, 24)) & 0xFFFFFFFF
    fin_synth9(h)
}

pub func compress_w11(h: ref table<i64>, msg: string, pos: i64, nbytes: i64,
            t_lo: i64, t_hi: i64, last: bool,
            iv: table<i64>, rcon: table<i64>, R: i64) {
    var (M0, N0, M1, N1, Pw, skey) = w48_planes_skey(msg, pos, nbytes)
    var l = Lanes11h()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp16(h[5], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp16(h[6], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp16(h[7], 7)
    l.M3 = h[3] & 0xFFFFFFFF
    l.N3 = rrp16(h[8], 7)
    l.M4 = h[4] & 0xFFFFFFFF
    l.N4 = rrp16(h[9], 7)
    l.M5 = h[5] & 0xFFFFFFFF
    l.N5 = rrp16(h[10], 7)
    l.M6 = h[6] & 0xFFFFFFFF
    l.N6 = rrp16(h[0], 7)
    l.M7 = h[7] & 0xFFFFFFFF
    l.N7 = rrp16(h[1], 7)
    l.M8 = h[8] & 0xFFFFFFFF
    l.N8 = rrp16(h[2], 7)
    l.M9 = h[9] & 0xFFFFFFFF
    l.N9 = rrp16(h[3], 7)
    l.M10 = h[10] & 0xFFFFFFFF
    l.N10 = rrp16(h[4], 7)
    l.M0 = (l.M0 ^ (iv[0] & 0xFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (iv[4] & 0xFFFF)) & 0xFFFFFFFF
    l.M1 = (l.M1 ^ (iv[1] & 0xFFFF)) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ (iv[5] & 0xFFFF)) & 0xFFFFFFFF
    l.M2 = (l.M2 ^ (iv[2] & 0xFFFF)) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ (iv[6] & 0xFFFF)) & 0xFFFFFFFF
    l.M3 = (l.M3 ^ (iv[3] & 0xFFFF)) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ (iv[7] & 0xFFFF)) & 0xFFFFFFFF
    l.M4 = (l.M4 ^ (iv[4] & 0xFFFF)) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ (iv[0] & 0xFFFF)) & 0xFFFFFFFF
    l.M5 = (l.M5 ^ (iv[5] & 0xFFFF)) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ (iv[1] & 0xFFFF)) & 0xFFFFFFFF
    l.M6 = (l.M6 ^ (iv[6] & 0xFFFF)) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ (iv[2] & 0xFFFF)) & 0xFFFFFFFF
    l.M7 = (l.M7 ^ (iv[7] & 0xFFFF)) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ (iv[3] & 0xFFFF)) & 0xFFFFFFFF
    l.M8 = (l.M8 ^ (iv[0] & 0xFFFF)) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ (iv[4] & 0xFFFF)) & 0xFFFFFFFF
    l.M9 = (l.M9 ^ (iv[1] & 0xFFFF)) & 0xFFFFFFFF
    l.N9 = (l.N9 ^ (iv[5] & 0xFFFF)) & 0xFFFFFFFF
    l.M10 = (l.M10 ^ (iv[2] & 0xFFFF)) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ (iv[6] & 0xFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (t_lo & 0xFFFF)) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ (t_hi & 0xFFFF)) & 0xFFFFFFFF
    if last {
        l.N5 = (l.N5 ^ 0xFFFFFFFF) & 0xFFFFFFFF
    }
    l = absorb11h(l, Pw, skey)   // F1-2：位平面吸收（IV/计数器混入之后、轮循环之前，每块一次）
    var mA: i64 = 0
    var mC: i64 = 0
    var r: i64 = 0
    while r < R {
        mA = (r * 5 + ((skey >> 6) & 7)) & 31
        mC = (r * 7 + ((skey >> 12) & 7)) & 31
        l = ring11_mixA(l, r, skey, M0, N0, M1, N1, mA, rcon, r)
        l = ring11_mixB(l, r, skey, M0, N0, M1, N1, mC, rcon, (r + 8) & 15)
        r = r + 1
    }
    h[0] = (h[0] ^ l.M0 ^ rrp16(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (h[1] ^ l.M1 ^ rrp16(l.N1, 3)) & 0xFFFFFFFF
    h[2] = (h[2] ^ l.M2 ^ rrp16(l.N2, 6)) & 0xFFFFFFFF
    h[3] = (h[3] ^ l.M3 ^ rrp16(l.N3, 9)) & 0xFFFFFFFF
    h[4] = (h[4] ^ l.M4 ^ rrp16(l.N4, 12)) & 0xFFFFFFFF
    h[5] = (h[5] ^ l.M5 ^ rrp16(l.N5, 15)) & 0xFFFFFFFF
    h[6] = (h[6] ^ l.M6 ^ rrp16(l.N6, 18)) & 0xFFFFFFFF
    h[7] = (h[7] ^ l.M7 ^ rrp16(l.N7, 21)) & 0xFFFFFFFF
    h[8] = (h[8] ^ l.M8 ^ rrp16(l.N8, 24)) & 0xFFFFFFFF
    h[9] = (h[9] ^ l.M9 ^ rrp16(l.N9, 27)) & 0xFFFFFFFF
    h[10] = (h[10] ^ l.M10 ^ rrp16(l.N10, 30)) & 0xFFFFFFFF
    fin_synth11(h)
}
struct Lanes12 {
    var M0: i64 = 0
    var N0: i64 = 0
    var M1: i64 = 0
    var N1: i64 = 0
    var M2: i64 = 0
    var N2: i64 = 0
    var M3: i64 = 0
    var N3: i64 = 0
    var M4: i64 = 0
    var N4: i64 = 0
    var M5: i64 = 0
    var N5: i64 = 0
    var M6: i64 = 0
    var N6: i64 = 0
    var M7: i64 = 0
    var N7: i64 = 0
    var M8: i64 = 0
    var N8: i64 = 0
    var M9: i64 = 0
    var N9: i64 = 0
    var M10: i64 = 0
    var N10: i64 = 0
    var M11: i64 = 0
    var N11: i64 = 0
}

func ring12_mixA(l: Lanes12, r: i64
            , skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes12 {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0,
                    rrp(l.M2, rA), rrp(l.N2, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp(l.M3, (rB + 3) & 31), rrp(l.N3, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1,
                    rrp(l.M3, (rA + 5) & 31), rrp(l.N3, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp(l.M4, (rB + 10) & 31), rrp(l.N4, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M2, l.N2,
                    rrp(l.M4, (rA + 10) & 31), rrp(l.N4, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp(l.M5, (rB + 17) & 31), rrp(l.N5, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M3, l.N3,
                    rrp(l.M5, (rA + 15) & 31), rrp(l.N5, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp(l.M0, (rB + 24) & 31), rrp(l.N0, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M4, l.N4,
                    rrp(l.M0, (rA + 20) & 31), rrp(l.N0, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp(l.M1, (rB + 31) & 31), rrp(l.N1, (rB + 31) & 31))
    var (q5m, q5n) = tadd2(l.M5, l.N5,
                    rrp(l.M1, (rA + 25) & 31), rrp(l.N1, (rA + 25) & 31))
    var (s5m, s5n) = tadd2(q5m, q5n,
                    rrp(l.M2, (rB + 6) & 31), rrp(l.N2, (rB + 6) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    l.M2 = s2m
    l.N2 = s2n
    l.M3 = s3m
    l.N3 = s3n
    l.M4 = s4m
    l.N4 = s4n
    l.M5 = s5m
    l.N5 = s5n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M2 = (l.M2 ^ p1m) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M3 = (l.M3 ^ p2m) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s5m, s5n)
    l.M4 = (l.M4 ^ p3m) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s0m, s0n)
    l.M5 = (l.M5 ^ p4m) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ p4n) & 0xFFFFFFFF
    var (p5m, p5n) = tmul2(s5m, s5n, s1m, s1n)
    l.M0 = (l.M0 ^ p5m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p5n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M5 = (l.M5 ^ maj) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M0, l.N0, rrp(M0, mA), rrp(N0, mA))
    l.M0 = im
    l.N0 = in2
    var (jm, jn2) = tadd2(l.M1, l.N1, rrp(M1, (mA + 7) & 31), rrp(N1, (mA + 7) & 31))
    l.M1 = jm
    l.N1 = jn2
    l.M0 = (l.M0 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ rrp(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

func ring12_mixB(l: Lanes12, r: i64
            , skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes12 {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M6, l.N6,
                    rrp(l.M8, rA), rrp(l.N8, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp(l.M9, (rB + 3) & 31), rrp(l.N9, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M7, l.N7,
                    rrp(l.M9, (rA + 5) & 31), rrp(l.N9, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp(l.M10, (rB + 10) & 31), rrp(l.N10, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M8, l.N8,
                    rrp(l.M10, (rA + 10) & 31), rrp(l.N10, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp(l.M11, (rB + 17) & 31), rrp(l.N11, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M9, l.N9,
                    rrp(l.M11, (rA + 15) & 31), rrp(l.N11, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp(l.M6, (rB + 24) & 31), rrp(l.N6, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M10, l.N10,
                    rrp(l.M6, (rA + 20) & 31), rrp(l.N6, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp(l.M7, (rB + 31) & 31), rrp(l.N7, (rB + 31) & 31))
    var (q5m, q5n) = tadd2(l.M11, l.N11,
                    rrp(l.M7, (rA + 25) & 31), rrp(l.N7, (rA + 25) & 31))
    var (s5m, s5n) = tadd2(q5m, q5n,
                    rrp(l.M8, (rB + 6) & 31), rrp(l.N8, (rB + 6) & 31))
    l.M6 = s0m
    l.N6 = s0n
    l.M7 = s1m
    l.N7 = s1n
    l.M8 = s2m
    l.N8 = s2n
    l.M9 = s3m
    l.N9 = s3n
    l.M10 = s4m
    l.N10 = s4n
    l.M11 = s5m
    l.N11 = s5n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M7 = (l.M7 ^ p0m) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M8 = (l.M8 ^ p1m) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M9 = (l.M9 ^ p2m) & 0xFFFFFFFF
    l.N9 = (l.N9 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s5m, s5n)
    l.M10 = (l.M10 ^ p3m) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s0m, s0n)
    l.M11 = (l.M11 ^ p4m) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ p4n) & 0xFFFFFFFF
    var (p5m, p5n) = tmul2(s5m, s5n, s1m, s1n)
    l.M6 = (l.M6 ^ p5m) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ p5n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M11 = (l.M11 ^ maj) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M6, l.N6, rrp(M0, mA), rrp(N0, mA))
    l.M6 = im
    l.N6 = in2
    var (jm, jn2) = tadd2(l.M7, l.N7, rrp(M1, (mA + 7) & 31), rrp(N1, (mA + 7) & 31))
    l.M7 = jm
    l.N7 = jn2
    l.M6 = (l.M6 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ rrp(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

func ring12_mixF(l: Lanes12, r: i64
            , skey: i64
            ) -> Lanes12 {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0,
                    rrp(l.M2, rA), rrp(l.N2, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp(l.M3, (rB + 3) & 31), rrp(l.N3, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1,
                    rrp(l.M3, (rA + 5) & 31), rrp(l.N3, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp(l.M4, (rB + 10) & 31), rrp(l.N4, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M2, l.N2,
                    rrp(l.M4, (rA + 10) & 31), rrp(l.N4, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp(l.M5, (rB + 17) & 31), rrp(l.N5, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M3, l.N3,
                    rrp(l.M5, (rA + 15) & 31), rrp(l.N5, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp(l.M6, (rB + 24) & 31), rrp(l.N6, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M4, l.N4,
                    rrp(l.M6, (rA + 20) & 31), rrp(l.N6, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp(l.M7, (rB + 31) & 31), rrp(l.N7, (rB + 31) & 31))
    var (q5m, q5n) = tadd2(l.M5, l.N5,
                    rrp(l.M7, (rA + 25) & 31), rrp(l.N7, (rA + 25) & 31))
    var (s5m, s5n) = tadd2(q5m, q5n,
                    rrp(l.M8, (rB + 6) & 31), rrp(l.N8, (rB + 6) & 31))
    var (q6m, q6n) = tadd2(l.M6, l.N6,
                    rrp(l.M8, (rA + 30) & 31), rrp(l.N8, (rA + 30) & 31))
    var (s6m, s6n) = tadd2(q6m, q6n,
                    rrp(l.M9, (rB + 13) & 31), rrp(l.N9, (rB + 13) & 31))
    var (q7m, q7n) = tadd2(l.M7, l.N7,
                    rrp(l.M9, (rA + 3) & 31), rrp(l.N9, (rA + 3) & 31))
    var (s7m, s7n) = tadd2(q7m, q7n,
                    rrp(l.M10, (rB + 20) & 31), rrp(l.N10, (rB + 20) & 31))
    var (q8m, q8n) = tadd2(l.M8, l.N8,
                    rrp(l.M10, (rA + 8) & 31), rrp(l.N10, (rA + 8) & 31))
    var (s8m, s8n) = tadd2(q8m, q8n,
                    rrp(l.M11, (rB + 27) & 31), rrp(l.N11, (rB + 27) & 31))
    var (q9m, q9n) = tadd2(l.M9, l.N9,
                    rrp(l.M11, (rA + 13) & 31), rrp(l.N11, (rA + 13) & 31))
    var (s9m, s9n) = tadd2(q9m, q9n,
                    rrp(l.M0, (rB + 2) & 31), rrp(l.N0, (rB + 2) & 31))
    var (q10m, q10n) = tadd2(l.M10, l.N10,
                    rrp(l.M0, (rA + 18) & 31), rrp(l.N0, (rA + 18) & 31))
    var (s10m, s10n) = tadd2(q10m, q10n,
                    rrp(l.M1, (rB + 9) & 31), rrp(l.N1, (rB + 9) & 31))
    var (q11m, q11n) = tadd2(l.M11, l.N11,
                    rrp(l.M1, (rA + 23) & 31), rrp(l.N1, (rA + 23) & 31))
    var (s11m, s11n) = tadd2(q11m, q11n,
                    rrp(l.M2, (rB + 16) & 31), rrp(l.N2, (rB + 16) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    l.M2 = s2m
    l.N2 = s2n
    l.M3 = s3m
    l.N3 = s3n
    l.M4 = s4m
    l.N4 = s4n
    l.M5 = s5m
    l.N5 = s5n
    l.M6 = s6m
    l.N6 = s6n
    l.M7 = s7m
    l.N7 = s7n
    l.M8 = s8m
    l.N8 = s8n
    l.M9 = s9m
    l.N9 = s9n
    l.M10 = s10m
    l.N10 = s10n
    l.M11 = s11m
    l.N11 = s11n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M2 = (l.M2 ^ p1m) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M3 = (l.M3 ^ p2m) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s5m, s5n)
    l.M4 = (l.M4 ^ p3m) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s6m, s6n)
    l.M5 = (l.M5 ^ p4m) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ p4n) & 0xFFFFFFFF
    var (p5m, p5n) = tmul2(s5m, s5n, s7m, s7n)
    l.M6 = (l.M6 ^ p5m) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ p5n) & 0xFFFFFFFF
    var (p6m, p6n) = tmul2(s6m, s6n, s8m, s8n)
    l.M7 = (l.M7 ^ p6m) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ p6n) & 0xFFFFFFFF
    var (p7m, p7n) = tmul2(s7m, s7n, s9m, s9n)
    l.M8 = (l.M8 ^ p7m) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ p7n) & 0xFFFFFFFF
    var (p8m, p8n) = tmul2(s8m, s8n, s10m, s10n)
    l.M9 = (l.M9 ^ p8m) & 0xFFFFFFFF
    l.N9 = (l.N9 ^ p8n) & 0xFFFFFFFF
    var (p9m, p9n) = tmul2(s9m, s9n, s11m, s11n)
    l.M10 = (l.M10 ^ p9m) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ p9n) & 0xFFFFFFFF
    var (p10m, p10n) = tmul2(s10m, s10n, s0m, s0n)
    l.M11 = (l.M11 ^ p10m) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ p10n) & 0xFFFFFFFF
    var (p11m, p11n) = tmul2(s11m, s11n, s1m, s1n)
    l.M0 = (l.M0 ^ p11m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p11n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M11 = (l.M11 ^ maj) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    return l
}

func absorb12(l: Lanes12, Pw: Planes16, skey: i64) -> Lanes12 {
    var w: i64 = 0
    while w < 16 {
        var pv: i64 = 0
        if w == 0 {
            pv = Pw.w0
        } else if w == 1 {
            pv = Pw.w1
        } else if w == 2 {
            pv = Pw.w2
        } else if w == 3 {
            pv = Pw.w3
        } else if w == 4 {
            pv = Pw.w4
        } else if w == 5 {
            pv = Pw.w5
        } else if w == 6 {
            pv = Pw.w6
        } else if w == 7 {
            pv = Pw.w7
        } else if w == 8 {
            pv = Pw.w8
        } else if w == 9 {
            pv = Pw.w9
        } else if w == 10 {
            pv = Pw.w10
        } else if w == 11 {
            pv = Pw.w11
        } else if w == 12 {
            pv = Pw.w12
        } else if w == 13 {
            pv = Pw.w13
        } else if w == 14 {
            pv = Pw.w14
        } else {
            pv = Pw.w15
        }
        if pv != 0 {
            var a = (w * 5 + ((skey >> (w & 7)) & 7)) & 31
            var an = w % 12
            var v = rrp(pv, a)
            var v2 = rrp(pv, a + 17)
            if an == 0 {
                var (t0m, t0n) = tadd2(l.M0, l.N0, v, v2)
                l.M0 = t0m & 0xFFFFFFFF
                l.N0 = t0n & 0xFFFFFFFF
            } else if an == 1 {
                var (t1m, t1n) = tadd2(l.M1, l.N1, v, v2)
                l.M1 = t1m & 0xFFFFFFFF
                l.N1 = t1n & 0xFFFFFFFF
            } else if an == 2 {
                var (t2m, t2n) = tadd2(l.M2, l.N2, v, v2)
                l.M2 = t2m & 0xFFFFFFFF
                l.N2 = t2n & 0xFFFFFFFF
            } else if an == 3 {
                var (t3m, t3n) = tadd2(l.M3, l.N3, v, v2)
                l.M3 = t3m & 0xFFFFFFFF
                l.N3 = t3n & 0xFFFFFFFF
            } else if an == 4 {
                var (t4m, t4n) = tadd2(l.M4, l.N4, v, v2)
                l.M4 = t4m & 0xFFFFFFFF
                l.N4 = t4n & 0xFFFFFFFF
            } else if an == 5 {
                var (t5m, t5n) = tadd2(l.M5, l.N5, v, v2)
                l.M5 = t5m & 0xFFFFFFFF
                l.N5 = t5n & 0xFFFFFFFF
            } else if an == 6 {
                var (t6m, t6n) = tadd2(l.M6, l.N6, v, v2)
                l.M6 = t6m & 0xFFFFFFFF
                l.N6 = t6n & 0xFFFFFFFF
            } else if an == 7 {
                var (t7m, t7n) = tadd2(l.M7, l.N7, v, v2)
                l.M7 = t7m & 0xFFFFFFFF
                l.N7 = t7n & 0xFFFFFFFF
            } else if an == 8 {
                var (t8m, t8n) = tadd2(l.M8, l.N8, v, v2)
                l.M8 = t8m & 0xFFFFFFFF
                l.N8 = t8n & 0xFFFFFFFF
            } else if an == 9 {
                var (t9m, t9n) = tadd2(l.M9, l.N9, v, v2)
                l.M9 = t9m & 0xFFFFFFFF
                l.N9 = t9n & 0xFFFFFFFF
            } else if an == 10 {
                var (t10m, t10n) = tadd2(l.M10, l.N10, v, v2)
                l.M10 = t10m & 0xFFFFFFFF
                l.N10 = t10n & 0xFFFFFFFF
            } else {
                var (t11m, t11n) = tadd2(l.M11, l.N11, v, v2)
                l.M11 = t11m & 0xFFFFFFFF
                l.N11 = t11n & 0xFFFFFFFF
            }
        }
        w = w + 1
    }
    return l
}

func fin_synth12(h: ref table<i64>) {
    var l = Lanes12()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp(h[1], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp(h[2], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp(h[3], 7)
    l.M3 = h[3] & 0xFFFFFFFF
    l.N3 = rrp(h[4], 7)
    l.M4 = h[4] & 0xFFFFFFFF
    l.N4 = rrp(h[5], 7)
    l.M5 = h[5] & 0xFFFFFFFF
    l.N5 = rrp(h[6], 7)
    l.M6 = h[6] & 0xFFFFFFFF
    l.N6 = rrp(h[7], 7)
    l.M7 = h[7] & 0xFFFFFFFF
    l.N7 = rrp(h[8], 7)
    l.M8 = h[8] & 0xFFFFFFFF
    l.N8 = rrp(h[9], 7)
    l.M9 = h[9] & 0xFFFFFFFF
    l.N9 = rrp(h[10], 7)
    l.M10 = h[10] & 0xFFFFFFFF
    l.N10 = rrp(h[11], 7)
    l.M11 = h[11] & 0xFFFFFFFF
    l.N11 = rrp(h[0], 7)
    var sf: i64 = 0
    while sf < 4 {
        l = ring12_mixF(l, sf, 0x13579BDF)
        sf = sf + 1
    }
    h[0] = (l.M0 ^ rrp(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (l.M1 ^ rrp(l.N1, 5)) & 0xFFFFFFFF
    h[2] = (l.M2 ^ rrp(l.N2, 10)) & 0xFFFFFFFF
    h[3] = (l.M3 ^ rrp(l.N3, 15)) & 0xFFFFFFFF
    h[4] = (l.M4 ^ rrp(l.N4, 20)) & 0xFFFFFFFF
    h[5] = (l.M5 ^ rrp(l.N5, 25)) & 0xFFFFFFFF
    h[6] = (l.M6 ^ rrp(l.N6, 30)) & 0xFFFFFFFF
    h[7] = (l.M7 ^ rrp(l.N7, 3)) & 0xFFFFFFFF
    h[8] = (l.M8 ^ rrp(l.N8, 8)) & 0xFFFFFFFF
    h[9] = (l.M9 ^ rrp(l.N9, 13)) & 0xFFFFFFFF
    h[10] = (l.M10 ^ rrp(l.N10, 18)) & 0xFFFFFFFF
    h[11] = (l.M11 ^ rrp(l.N11, 23)) & 0xFFFFFFFF
}

pub func compress_w12(h: ref table<i64>, msg: string, pos: i64, nbytes: i64,
            t_lo: i64, t_hi: i64, last: bool,
            iv: table<i64>, rcon: table<i64>, R: i64) {
    var (M0, N0, M1, N1, Pw, skey) = w48_planes_skey(msg, pos, nbytes)
    var l = Lanes12()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp(h[6], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp(h[7], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp(h[8], 7)
    l.M3 = h[3] & 0xFFFFFFFF
    l.N3 = rrp(h[9], 7)
    l.M4 = h[4] & 0xFFFFFFFF
    l.N4 = rrp(h[10], 7)
    l.M5 = h[5] & 0xFFFFFFFF
    l.N5 = rrp(h[11], 7)
    l.M6 = h[6] & 0xFFFFFFFF
    l.N6 = rrp(h[0], 7)
    l.M7 = h[7] & 0xFFFFFFFF
    l.N7 = rrp(h[1], 7)
    l.M8 = h[8] & 0xFFFFFFFF
    l.N8 = rrp(h[2], 7)
    l.M9 = h[9] & 0xFFFFFFFF
    l.N9 = rrp(h[3], 7)
    l.M10 = h[10] & 0xFFFFFFFF
    l.N10 = rrp(h[4], 7)
    l.M11 = h[11] & 0xFFFFFFFF
    l.N11 = rrp(h[5], 7)
    l.M0 = (l.M0 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M1 = (l.M1 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M2 = (l.M2 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M3 = (l.M3 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M4 = (l.M4 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M5 = (l.M5 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M6 = (l.M6 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M7 = (l.M7 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M8 = (l.M8 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M9 = (l.M9 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N9 = (l.N9 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M10 = (l.M10 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M11 = (l.M11 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (t_lo & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ (t_hi & 0xFFFFFFFF)) & 0xFFFFFFFF
    if last {
        l.N6 = (l.N6 ^ 0xFFFFFFFF) & 0xFFFFFFFF
    }
    l = absorb12(l, Pw, skey)   // F1-2：位平面吸收（IV/计数器混入之后、轮循环之前，每块一次）
    var mA: i64 = 0
    var mC: i64 = 0
    var r: i64 = 0
    while r < R {
        mA = (r * 5 + ((skey >> 6) & 7)) & 31
        mC = (r * 7 + ((skey >> 12) & 7)) & 31
        l = ring12_mixA(l, r, skey, M0, N0, M1, N1, mA, rcon, r)
        l = ring12_mixB(l, r, skey, M0, N0, M1, N1, mC, rcon, (r + 8) & 15)
        r = r + 1
    }
    h[0] = (h[0] ^ l.M0 ^ rrp(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (h[1] ^ l.M1 ^ rrp(l.N1, 3)) & 0xFFFFFFFF
    h[2] = (h[2] ^ l.M2 ^ rrp(l.N2, 6)) & 0xFFFFFFFF
    h[3] = (h[3] ^ l.M3 ^ rrp(l.N3, 9)) & 0xFFFFFFFF
    h[4] = (h[4] ^ l.M4 ^ rrp(l.N4, 12)) & 0xFFFFFFFF
    h[5] = (h[5] ^ l.M5 ^ rrp(l.N5, 15)) & 0xFFFFFFFF
    h[6] = (h[6] ^ l.M6 ^ rrp(l.N6, 18)) & 0xFFFFFFFF
    h[7] = (h[7] ^ l.M7 ^ rrp(l.N7, 21)) & 0xFFFFFFFF
    h[8] = (h[8] ^ l.M8 ^ rrp(l.N8, 24)) & 0xFFFFFFFF
    h[9] = (h[9] ^ l.M9 ^ rrp(l.N9, 27)) & 0xFFFFFFFF
    h[10] = (h[10] ^ l.M10 ^ rrp(l.N10, 30)) & 0xFFFFFFFF
    h[11] = (h[11] ^ l.M11 ^ rrp(l.N11, 1)) & 0xFFFFFFFF
    fin_synth12(h)
}

// ============================================================================
// W=2 特化内核（n=8 快速档，tink v2 帧快校验主路径）——struct 字段承载 lanes
//   （零 table 动态索引），ring_mix / 注入 / 末块折回 / fin_synth 对 L=2 单环
//   全部人工展开，让 LLVM 全 SSA → 自动向量化；语义与 std/tsha1.tie 通用
//   compress（W<8 单轨 kind=1）逐式一致，复用 w48_planes_skey 快路径逐字节。
// ============================================================================
struct Lanes2 {
    var M0: i64 = 0
    var N0: i64 = 0
    var M1: i64 = 0
    var N1: i64 = 0
}

// L=2 单环 ring_mix（注入版，压缩轮用）：S 段 + tmul 段 + maj 段 + inj 段 + rcon 段。
func ring2_mix(l: Lanes2, r: i64, skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64) -> Lanes2 {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    // ---- S 段（k=0..1；j2=(k+2)%2、j3=(k+3)%2）----
    var (q0m, q0n) = tadd2(l.M0, l.N0, rrp(l.M0, rA), rrp(l.N0, rA))
    var (s0m, s0n) = tadd2(q0m, q0n, rrp(l.M1, (rB + 3) & 31), rrp(l.N1, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1, rrp(l.M1, (rA + 5) & 31), rrp(l.N1, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n, rrp(l.M0, (rB + 10) & 31), rrp(l.N0, (rB + 10) & 31))
    // ---- 写回 S ----
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    // ---- tmul 段（k2r=(k+2)%2、k1r=(k+1)%2）----
    var (p0m, p0n) = tmul2(s0m, s0n, s0m, s0n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s1m, s1n)
    l.M0 = (l.M0 ^ p1m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p1n) & 0xFFFFFFFF
    // ---- maj 段（L=2 → 复用前两组）----
    var maj = quant3(s0m, s0n, s1m, s1n, s0m, s0n)
    l.M1 = (l.M1 ^ maj) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    // ---- inj 段（i0=0、i1=1）----
    var (im, in2) = tadd2(l.M0, l.N0, rrp(M0, mA), rrp(N0, mA))
    l.M0 = im & 0xFFFFFFFF
    l.N0 = in2 & 0xFFFFFFFF
    var (jm, jn2) = tadd2(l.M1, l.N1, rrp(M1, (mA + 7) & 31), rrp(N1, (mA + 7) & 31))
    l.M1 = jm & 0xFFFFFFFF
    l.N1 = jn2 & 0xFFFFFFFF
    // ---- rcon 段 ----
    l.M0 = (l.M0 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ rrp(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

// L=2 无注入 ring_mix（fin_synth 终筛用，rcon=0）。
func ring2_mixF(l: Lanes2, r: i64, skey: i64) -> Lanes2 {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0, rrp(l.M0, rA), rrp(l.N0, rA))
    var (s0m, s0n) = tadd2(q0m, q0n, rrp(l.M1, (rB + 3) & 31), rrp(l.N1, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1, rrp(l.M1, (rA + 5) & 31), rrp(l.N1, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n, rrp(l.M0, (rB + 10) & 31), rrp(l.N0, (rB + 10) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    var (p0m, p0n) = tmul2(s0m, s0n, s0m, s0n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s1m, s1n)
    l.M0 = (l.M0 ^ p1m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p1n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s0m, s0n)
    l.M1 = (l.M1 ^ maj) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    return l
}

// F1-2 位平面吸收（W=2：锚点字 w%2 → M0/N0 或 M1/N1）。
func absorb2(l: Lanes2, Pw: Planes16, skey: i64) -> Lanes2 {
    var w: i64 = 0
    while w < 16 {
        var pv: i64 = 0
        if w == 0 {
            pv = Pw.w0
        } else if w == 1 {
            pv = Pw.w1
        } else if w == 2 {
            pv = Pw.w2
        } else if w == 3 {
            pv = Pw.w3
        } else if w == 4 {
            pv = Pw.w4
        } else if w == 5 {
            pv = Pw.w5
        } else if w == 6 {
            pv = Pw.w6
        } else if w == 7 {
            pv = Pw.w7
        } else if w == 8 {
            pv = Pw.w8
        } else if w == 9 {
            pv = Pw.w9
        } else if w == 10 {
            pv = Pw.w10
        } else if w == 11 {
            pv = Pw.w11
        } else if w == 12 {
            pv = Pw.w12
        } else if w == 13 {
            pv = Pw.w13
        } else if w == 14 {
            pv = Pw.w14
        } else {
            pv = Pw.w15
        }
        if pv != 0 {
            var a = (w * 5 + ((skey >> (w & 7)) & 7)) & 31
            var v = rrp(pv, a)
            var v2 = rrp(pv, a + 17)
            if (w & 1) == 0 {
                var (s0m, s0n) = tadd2(l.M0, l.N0, v, v2)
                l.M0 = s0m & 0xFFFFFFFF
                l.N0 = s0n & 0xFFFFFFFF
            } else {
                var (s1m, s1n) = tadd2(l.M1, l.N1, v, v2)
                l.M1 = s1m & 0xFFFFFFFF
                l.N1 = s1n & 0xFFFFFFFF
            }
        }
        w = w + 1
    }
    return l
}

// W=2 终筛（fin_synth 展开：S=4 轮单环 + 投影 rrp 偏移 i*5）。
func fin_synth2(h: ref table<i64>) {
    var l = Lanes2()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp(h[1], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp(h[0], 7)
    var sf: i64 = 0
    while sf < 4 {
        l = ring2_mixF(l, sf, 0x13579BDF)
        sf = sf + 1
    }
    h[0] = (l.M0 ^ rrp(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (l.M1 ^ rrp(l.N1, 5)) & 0xFFFFFFFF
}

// W=2 单块压缩（n=8 全宽，f/b/x 共用；r 半宽走 compress_w2h）。
pub func compress_w2(h: ref table<i64>, msg: string, pos: i64, nbytes: i64,
            t_lo: i64, t_hi: i64, last: bool,
            iv: table<i64>, rcon: table<i64>, R: i64) {
    var (M0, N0, M1, N1, Pw, skey) = w48_planes_skey(msg, pos, nbytes)
    var l = Lanes2()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp(h[1], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp(h[0], 7)
    l.M0 = (l.M0 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M1 = (l.M1 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (t_lo & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ (t_hi & 0xFFFFFFFF)) & 0xFFFFFFFF
    if last {
        l.N1 = (l.N1 ^ 0xFFFFFFFF) & 0xFFFFFFFF
    }
    l = absorb2(l, Pw, skey)
    var mA: i64 = 0
    var mB: i64 = 0
    var r: i64 = 0
    while r < R {
        mA = (r * 5 + ((skey >> 6) & 7)) & 31
        mB = (r * 11 + ((skey >> 9) & 7)) & 31
        l = ring2_mix(l, r, skey, M0, N0, M1, N1, mA, rcon, r)
        r = r + 1
    }
    h[0] = (h[0] ^ l.M0 ^ rrp(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (h[1] ^ l.M1 ^ rrp(l.N1, 3)) & 0xFFFFFFFF
    fin_synth2(h)
}

// ============================================================================
// W=1 特化内核（n=2/3/4 单字档；L=1 单环：j2/j3 环自指，maj 用 S0 三重复用）——
//   语义与通用 ring_mix L==1 分支逐式一致；W=1 时 fin_synth 直接 return（通用同）。
// ============================================================================
struct Lanes1 {
    var M0: i64 = 0
    var N0: i64 = 0
}

// L=1 单环 ring_mix（注入版）。通用 L==1：S0=tadd2(l0,rot(l0,a))；S1=tadd2(S0,rot(l0,b))；
//   tmul S0*S0→l0；maj=quant3(S0,S1,S0,S1,S0,S1)→l0。
func ring1_mix(l: Lanes1, r: i64, skey: i64
            , M0: i64, N0: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64) -> Lanes1 {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0, rrp(l.M0, rA), rrp(l.N0, rA))
    var (s0m, s0n) = tadd2(q0m, q0n, rrp(l.M0, (rB + 3) & 31), rrp(l.N0, (rB + 3) & 31))
    l.M0 = s0m
    l.N0 = s0n
    var (p0m, p0n) = tmul2(s0m, s0n, s0m, s0n)
    l.M0 = (l.M0 ^ p0m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p0n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s0m, s0n, s0m, s0n)
    l.M0 = (l.M0 ^ maj) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M0, l.N0, rrp(M0, mA), rrp(N0, mA))
    l.M0 = im & 0xFFFFFFFF
    l.N0 = in2 & 0xFFFFFFFF
    l.M0 = (l.M0 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ rrp(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

// F1-2 位平面吸收（W=1：锚点字恒 0 → 全部并入 M0/N0）。
func absorb1(l: Lanes1, Pw: Planes16, skey: i64) -> Lanes1 {
    var w: i64 = 0
    while w < 16 {
        var pv: i64 = 0
        if w == 0 {
            pv = Pw.w0
        } else if w == 1 {
            pv = Pw.w1
        } else if w == 2 {
            pv = Pw.w2
        } else if w == 3 {
            pv = Pw.w3
        } else if w == 4 {
            pv = Pw.w4
        } else if w == 5 {
            pv = Pw.w5
        } else if w == 6 {
            pv = Pw.w6
        } else if w == 7 {
            pv = Pw.w7
        } else if w == 8 {
            pv = Pw.w8
        } else if w == 9 {
            pv = Pw.w9
        } else if w == 10 {
            pv = Pw.w10
        } else if w == 11 {
            pv = Pw.w11
        } else if w == 12 {
            pv = Pw.w12
        } else if w == 13 {
            pv = Pw.w13
        } else if w == 14 {
            pv = Pw.w14
        } else {
            pv = Pw.w15
        }
        if pv != 0 {
            var a = (w * 5 + ((skey >> (w & 7)) & 7)) & 31
            var v = rrp(pv, a)
            var v2 = rrp(pv, a + 17)
            var (s0m, s0n) = tadd2(l.M0, l.N0, v, v2)
            l.M0 = s0m & 0xFFFFFFFF
            l.N0 = s0n & 0xFFFFFFFF
        }
        w = w + 1
    }
    return l
}

// W=1 单块压缩（n=2/3/4 全宽 f/b/x 共用；fin_synth 对 W=1 恒为空）。
pub func compress_w1(h: ref table<i64>, msg: string, pos: i64, nbytes: i64,
            t_lo: i64, t_hi: i64, last: bool,
            iv: table<i64>, rcon: table<i64>, R: i64) {
    var (M0, N0, M1, N1, Pw, skey) = w48_planes_skey(msg, pos, nbytes)
    var l = Lanes1()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp(h[0], 7)
    l.M0 = (l.M0 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (t_lo & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (t_hi & 0xFFFFFFFF)) & 0xFFFFFFFF
    if last {
        l.N0 = (l.N0 ^ 0xFFFFFFFF) & 0xFFFFFFFF
    }
    l = absorb1(l, Pw, skey)
    var mA: i64 = 0
    var r: i64 = 0
    while r < R {
        mA = (r * 5 + ((skey >> 6) & 7)) & 31
        l = ring1_mix(l, r, skey, M0, N0, mA, rcon, r)
        r = r + 1
    }
    h[0] = (h[0] ^ l.M0 ^ rrp(l.N0, 0)) & 0xFFFFFFFF
}

// ============================================================================
// W=2 r 半宽特化内核（n=6/8 r；rrp16 + fold16 语义，半宽 16-trit 字）——
//   语义与通用 half=true（L=2 单环）逐式一致，fin_synth 同 W=2 半宽投影。
// ============================================================================
struct Lanes2h {
    var M0: i64 = 0
    var N0: i64 = 0
    var M1: i64 = 0
    var N1: i64 = 0
}

// L=2 单环 ring_mix（半宽注入版）。
func ring2h_mix(l: Lanes2h, r: i64, skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64) -> Lanes2h {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0, rrp16(l.M0, rA), rrp16(l.N0, rA))
    var (s0m, s0n) = tadd2(q0m, q0n, rrp16(l.M1, (rB + 3) & 31), rrp16(l.N1, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1, rrp16(l.M1, (rA + 5) & 31), rrp16(l.N1, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n, rrp16(l.M0, (rB + 10) & 31), rrp16(l.N0, (rB + 10) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    var (p0m, p0n) = tmul2(s0m, s0n, s0m, s0n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s1m, s1n)
    l.M0 = (l.M0 ^ p1m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p1n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s0m, s0n)
    l.M1 = (l.M1 ^ maj) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ rrp16(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M0, l.N0, rrp16(M0, mA), rrp16(N0, mA))
    l.M0 = im & 0xFFFFFFFF
    l.N0 = in2 & 0xFFFFFFFF
    var (jm, jn2) = tadd2(l.M1, l.N1, rrp16(M1, (mA + 7) & 31), rrp16(N1, (mA + 7) & 31))
    l.M1 = jm & 0xFFFFFFFF
    l.N1 = jn2 & 0xFFFFFFFF
    l.M0 = (l.M0 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ rrp16(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

// L=2 无注入 ring_mix（半宽 fin_synth）。
func ring2h_mixF(l: Lanes2h, r: i64, skey: i64) -> Lanes2h {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0, rrp16(l.M0, rA), rrp16(l.N0, rA))
    var (s0m, s0n) = tadd2(q0m, q0n, rrp16(l.M1, (rB + 3) & 31), rrp16(l.N1, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1, rrp16(l.M1, (rA + 5) & 31), rrp16(l.N1, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n, rrp16(l.M0, (rB + 10) & 31), rrp16(l.N0, (rB + 10) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    var (p0m, p0n) = tmul2(s0m, s0n, s0m, s0n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s1m, s1n)
    l.M0 = (l.M0 ^ p1m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p1n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s0m, s0n)
    l.M1 = (l.M1 ^ maj) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ rrp16(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    return l
}

// F1-2 位平面吸收（W=2 半宽：锚点字 w%2，rrp16）。
func absorb2h(l: Lanes2h, Pw: Planes16, skey: i64) -> Lanes2h {
    var w: i64 = 0
    while w < 16 {
        var pv: i64 = 0
        if w == 0 {
            pv = Pw.w0
        } else if w == 1 {
            pv = Pw.w1
        } else if w == 2 {
            pv = Pw.w2
        } else if w == 3 {
            pv = Pw.w3
        } else if w == 4 {
            pv = Pw.w4
        } else if w == 5 {
            pv = Pw.w5
        } else if w == 6 {
            pv = Pw.w6
        } else if w == 7 {
            pv = Pw.w7
        } else if w == 8 {
            pv = Pw.w8
        } else if w == 9 {
            pv = Pw.w9
        } else if w == 10 {
            pv = Pw.w10
        } else if w == 11 {
            pv = Pw.w11
        } else if w == 12 {
            pv = Pw.w12
        } else if w == 13 {
            pv = Pw.w13
        } else if w == 14 {
            pv = Pw.w14
        } else {
            pv = Pw.w15
        }
        if pv != 0 {
            var a = (w * 5 + ((skey >> (w & 7)) & 7)) & 31
            var v = rrp16(pv, a)
            var v2 = rrp16(pv, a + 17)
            if (w & 1) == 0 {
                var (s0m, s0n) = tadd2(l.M0, l.N0, v, v2)
                l.M0 = s0m & 0xFFFFFFFF
                l.N0 = s0n & 0xFFFFFFFF
            } else {
                var (s1m, s1n) = tadd2(l.M1, l.N1, v, v2)
                l.M1 = s1m & 0xFFFFFFFF
                l.N1 = s1n & 0xFFFFFFFF
            }
        }
        w = w + 1
    }
    return l
}

// W=2 半宽终筛（rrp16 投影偏移 i*5）。
func fin_synth2h(h: ref table<i64>) {
    var l = Lanes2h()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp16(h[1], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp16(h[0], 7)
    var sf: i64 = 0
    while sf < 4 {
        l = ring2h_mixF(l, sf, 0x13579BDF)
        sf = sf + 1
    }
    h[0] = (l.M0 ^ rrp16(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (l.M1 ^ rrp16(l.N1, 5)) & 0xFFFFFFFF
}

// W=2 r 半宽单块压缩（n=6/8 r，R=8）。
pub func compress_w2h(h: ref table<i64>, msg: string, pos: i64, nbytes: i64,
            t_lo: i64, t_hi: i64, last: bool,
            iv: table<i64>, rcon: table<i64>, R: i64) {
    var (M0, N0, M1, N1, Pw, skey) = w48_planes_skey(msg, pos, nbytes)
    var l = Lanes2h()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp16(h[1], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp16(h[0], 7)
    l.M0 = (l.M0 ^ (iv[0] & 0xFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (iv[4] & 0xFFFF)) & 0xFFFFFFFF
    l.M1 = (l.M1 ^ (iv[1] & 0xFFFF)) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ (iv[5] & 0xFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (t_lo & 0xFFFF)) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ (t_hi & 0xFFFF)) & 0xFFFFFFFF
    if last {
        l.N1 = (l.N1 ^ 0xFFFFFFFF) & 0xFFFFFFFF
    }
    l = absorb2h(l, Pw, skey)
    var mA: i64 = 0
    var r: i64 = 0
    var mH: i64 = 0
    while r < R {
        mA = (r * 5 + ((skey >> 6) & 7)) & 31
        mH = (r * 7 + ((skey >> 3) & 7)) & 31
        l = ring2h_mix(l, r, skey, M0, N0, M1, N1, mA, rcon, r)
        r = r + 1
    }
    h[0] = (h[0] ^ l.M0 ^ rrp16(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (h[1] ^ l.M1 ^ rrp16(l.N1, 3)) & 0xFFFFFFFF
    fin_synth2h(h)
}

// ============================================================================
// W=3 单环特化内核（n=12/16 全宽；L=W 单环）——语义与通用 ring_mix 单环逐式一致。
// ============================================================================
struct Lanes3 {
    var M0: i64 = 0
    var N0: i64 = 0
    var M1: i64 = 0
    var N1: i64 = 0
    var M2: i64 = 0
    var N2: i64 = 0
}

func ring3_mix(l: Lanes3, r: i64
            , skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes3 {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0,
                    rrp(l.M2, rA), rrp(l.N2, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp(l.M0, (rB + 3) & 31), rrp(l.N0, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1,
                    rrp(l.M0, (rA + 5) & 31), rrp(l.N0, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp(l.M1, (rB + 10) & 31), rrp(l.N1, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M2, l.N2,
                    rrp(l.M1, (rA + 10) & 31), rrp(l.N1, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp(l.M2, (rB + 17) & 31), rrp(l.N2, (rB + 17) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    l.M2 = s2m
    l.N2 = s2n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s0m, s0n)
    l.M2 = (l.M2 ^ p1m) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s1m, s1n)
    l.M0 = (l.M0 ^ p2m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p2n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M2 = (l.M2 ^ maj) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M0, l.N0, rrp(M0, mA), rrp(N0, mA))
    l.M0 = im
    l.N0 = in2
    var (jm, jn2) = tadd2(l.M1, l.N1, rrp(M1, (mA + 7) & 31), rrp(N1, (mA + 7) & 31))
    l.M1 = jm
    l.N1 = jn2
    l.M0 = (l.M0 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ rrp(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

func ring3_mixF(l: Lanes3, r: i64
            , skey: i64
            ) -> Lanes3 {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0,
                    rrp(l.M2, rA), rrp(l.N2, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp(l.M0, (rB + 3) & 31), rrp(l.N0, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1,
                    rrp(l.M0, (rA + 5) & 31), rrp(l.N0, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp(l.M1, (rB + 10) & 31), rrp(l.N1, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M2, l.N2,
                    rrp(l.M1, (rA + 10) & 31), rrp(l.N1, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp(l.M2, (rB + 17) & 31), rrp(l.N2, (rB + 17) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    l.M2 = s2m
    l.N2 = s2n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s0m, s0n)
    l.M2 = (l.M2 ^ p1m) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s1m, s1n)
    l.M0 = (l.M0 ^ p2m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p2n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M2 = (l.M2 ^ maj) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    return l
}

func absorb3(l: Lanes3, Pw: Planes16, skey: i64) -> Lanes3 {
    var w: i64 = 0
    while w < 16 {
        var pv: i64 = 0
        if w == 0 {
            pv = Pw.w0
        } else if w == 1 {
            pv = Pw.w1
        } else if w == 2 {
            pv = Pw.w2
        } else if w == 3 {
            pv = Pw.w3
        } else if w == 4 {
            pv = Pw.w4
        } else if w == 5 {
            pv = Pw.w5
        } else if w == 6 {
            pv = Pw.w6
        } else if w == 7 {
            pv = Pw.w7
        } else if w == 8 {
            pv = Pw.w8
        } else if w == 9 {
            pv = Pw.w9
        } else if w == 10 {
            pv = Pw.w10
        } else if w == 11 {
            pv = Pw.w11
        } else if w == 12 {
            pv = Pw.w12
        } else if w == 13 {
            pv = Pw.w13
        } else if w == 14 {
            pv = Pw.w14
        } else {
            pv = Pw.w15
        }
        if pv != 0 {
            var a = (w * 5 + ((skey >> (w & 7)) & 7)) & 31
            var an = w % 3
            var v = rrp(pv, a)
            var v2 = rrp(pv, a + 17)
            if an == 0 {
                var (t0m, t0n) = tadd2(l.M0, l.N0, v, v2)
                l.M0 = t0m & 0xFFFFFFFF
                l.N0 = t0n & 0xFFFFFFFF
            } else if an == 1 {
                var (t1m, t1n) = tadd2(l.M1, l.N1, v, v2)
                l.M1 = t1m & 0xFFFFFFFF
                l.N1 = t1n & 0xFFFFFFFF
            } else {
                var (t2m, t2n) = tadd2(l.M2, l.N2, v, v2)
                l.M2 = t2m & 0xFFFFFFFF
                l.N2 = t2n & 0xFFFFFFFF
            }
        }
        w = w + 1
    }
    return l
}

// W=3 终筛
func fin_synth3(h: ref table<i64>) {
    var l = Lanes3()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp(h[1], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp(h[2], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp(h[0], 7)
    var sf: i64 = 0
    while sf < 4 {
        l = ring3_mixF(l, sf, 0x13579BDF)
        sf = sf + 1
    }
    h[0] = (l.M0 ^ rrp(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (l.M1 ^ rrp(l.N1, 5)) & 0xFFFFFFFF
    h[2] = (l.M2 ^ rrp(l.N2, 10)) & 0xFFFFFFFF
}

// W=3 单块压缩（f/b/x 共用单环内核，R 各档）
pub func compress_w3(h: ref table<i64>, msg: string, pos: i64, nbytes: i64,
            t_lo: i64, t_hi: i64, last: bool,
            iv: table<i64>, rcon: table<i64>, R: i64) {
    var (M0, N0, M1, N1, Pw, skey) = w48_planes_skey(msg, pos, nbytes)
    var l = Lanes3()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp(h[1], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp(h[2], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp(h[0], 7)
    l.M0 = (l.M0 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M1 = (l.M1 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M2 = (l.M2 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (t_lo & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ (t_hi & 0xFFFFFFFF)) & 0xFFFFFFFF
    if last {
        l.N1 = (l.N1 ^ 0xFFFFFFFF) & 0xFFFFFFFF
    }
    l = absorb3(l, Pw, skey)
    var mA: i64 = 0
    var r: i64 = 0
    while r < R {
        mA = (r * 5 + ((skey >> 6) & 7)) & 31
        l = ring3_mix(l, r, skey, M0, N0, M1, N1, mA, rcon, r)
        r = r + 1
    }
    h[0] = (h[0] ^ l.M0 ^ rrp(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (h[1] ^ l.M1 ^ rrp(l.N1, 3)) & 0xFFFFFFFF
    h[2] = (h[2] ^ l.M2 ^ rrp(l.N2, 6)) & 0xFFFFFFFF
    fin_synth3(h)
}

// ============================================================================
// W=5 单环特化内核（n=24 全宽；L=W 单环）——语义与通用 ring_mix 单环逐式一致。
// ============================================================================
struct Lanes5 {
    var M0: i64 = 0
    var N0: i64 = 0
    var M1: i64 = 0
    var N1: i64 = 0
    var M2: i64 = 0
    var N2: i64 = 0
    var M3: i64 = 0
    var N3: i64 = 0
    var M4: i64 = 0
    var N4: i64 = 0
}

func ring5_mix(l: Lanes5, r: i64
            , skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes5 {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0,
                    rrp(l.M2, rA), rrp(l.N2, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp(l.M3, (rB + 3) & 31), rrp(l.N3, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1,
                    rrp(l.M3, (rA + 5) & 31), rrp(l.N3, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp(l.M4, (rB + 10) & 31), rrp(l.N4, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M2, l.N2,
                    rrp(l.M4, (rA + 10) & 31), rrp(l.N4, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp(l.M0, (rB + 17) & 31), rrp(l.N0, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M3, l.N3,
                    rrp(l.M0, (rA + 15) & 31), rrp(l.N0, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp(l.M1, (rB + 24) & 31), rrp(l.N1, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M4, l.N4,
                    rrp(l.M1, (rA + 20) & 31), rrp(l.N1, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp(l.M2, (rB + 31) & 31), rrp(l.N2, (rB + 31) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    l.M2 = s2m
    l.N2 = s2n
    l.M3 = s3m
    l.N3 = s3n
    l.M4 = s4m
    l.N4 = s4n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M2 = (l.M2 ^ p1m) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M3 = (l.M3 ^ p2m) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s0m, s0n)
    l.M4 = (l.M4 ^ p3m) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s1m, s1n)
    l.M0 = (l.M0 ^ p4m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p4n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M4 = (l.M4 ^ maj) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M0, l.N0, rrp(M0, mA), rrp(N0, mA))
    l.M0 = im
    l.N0 = in2
    var (jm, jn2) = tadd2(l.M1, l.N1, rrp(M1, (mA + 7) & 31), rrp(N1, (mA + 7) & 31))
    l.M1 = jm
    l.N1 = jn2
    l.M0 = (l.M0 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ rrp(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

func ring5_mixF(l: Lanes5, r: i64
            , skey: i64
            ) -> Lanes5 {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0,
                    rrp(l.M2, rA), rrp(l.N2, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp(l.M3, (rB + 3) & 31), rrp(l.N3, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1,
                    rrp(l.M3, (rA + 5) & 31), rrp(l.N3, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp(l.M4, (rB + 10) & 31), rrp(l.N4, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M2, l.N2,
                    rrp(l.M4, (rA + 10) & 31), rrp(l.N4, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp(l.M0, (rB + 17) & 31), rrp(l.N0, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M3, l.N3,
                    rrp(l.M0, (rA + 15) & 31), rrp(l.N0, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp(l.M1, (rB + 24) & 31), rrp(l.N1, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M4, l.N4,
                    rrp(l.M1, (rA + 20) & 31), rrp(l.N1, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp(l.M2, (rB + 31) & 31), rrp(l.N2, (rB + 31) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    l.M2 = s2m
    l.N2 = s2n
    l.M3 = s3m
    l.N3 = s3n
    l.M4 = s4m
    l.N4 = s4n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M2 = (l.M2 ^ p1m) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M3 = (l.M3 ^ p2m) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s0m, s0n)
    l.M4 = (l.M4 ^ p3m) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s1m, s1n)
    l.M0 = (l.M0 ^ p4m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p4n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M4 = (l.M4 ^ maj) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    return l
}

func absorb5(l: Lanes5, Pw: Planes16, skey: i64) -> Lanes5 {
    var w: i64 = 0
    while w < 16 {
        var pv: i64 = 0
        if w == 0 {
            pv = Pw.w0
        } else if w == 1 {
            pv = Pw.w1
        } else if w == 2 {
            pv = Pw.w2
        } else if w == 3 {
            pv = Pw.w3
        } else if w == 4 {
            pv = Pw.w4
        } else if w == 5 {
            pv = Pw.w5
        } else if w == 6 {
            pv = Pw.w6
        } else if w == 7 {
            pv = Pw.w7
        } else if w == 8 {
            pv = Pw.w8
        } else if w == 9 {
            pv = Pw.w9
        } else if w == 10 {
            pv = Pw.w10
        } else if w == 11 {
            pv = Pw.w11
        } else if w == 12 {
            pv = Pw.w12
        } else if w == 13 {
            pv = Pw.w13
        } else if w == 14 {
            pv = Pw.w14
        } else {
            pv = Pw.w15
        }
        if pv != 0 {
            var a = (w * 5 + ((skey >> (w & 7)) & 7)) & 31
            var an = w % 5
            var v = rrp(pv, a)
            var v2 = rrp(pv, a + 17)
            if an == 0 {
                var (t0m, t0n) = tadd2(l.M0, l.N0, v, v2)
                l.M0 = t0m & 0xFFFFFFFF
                l.N0 = t0n & 0xFFFFFFFF
            } else if an == 1 {
                var (t1m, t1n) = tadd2(l.M1, l.N1, v, v2)
                l.M1 = t1m & 0xFFFFFFFF
                l.N1 = t1n & 0xFFFFFFFF
            } else if an == 2 {
                var (t2m, t2n) = tadd2(l.M2, l.N2, v, v2)
                l.M2 = t2m & 0xFFFFFFFF
                l.N2 = t2n & 0xFFFFFFFF
            } else if an == 3 {
                var (t3m, t3n) = tadd2(l.M3, l.N3, v, v2)
                l.M3 = t3m & 0xFFFFFFFF
                l.N3 = t3n & 0xFFFFFFFF
            } else {
                var (t4m, t4n) = tadd2(l.M4, l.N4, v, v2)
                l.M4 = t4m & 0xFFFFFFFF
                l.N4 = t4n & 0xFFFFFFFF
            }
        }
        w = w + 1
    }
    return l
}

// W=5 终筛
func fin_synth5(h: ref table<i64>) {
    var l = Lanes5()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp(h[1], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp(h[2], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp(h[3], 7)
    l.M3 = h[3] & 0xFFFFFFFF
    l.N3 = rrp(h[4], 7)
    l.M4 = h[4] & 0xFFFFFFFF
    l.N4 = rrp(h[0], 7)
    var sf: i64 = 0
    while sf < 4 {
        l = ring5_mixF(l, sf, 0x13579BDF)
        sf = sf + 1
    }
    h[0] = (l.M0 ^ rrp(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (l.M1 ^ rrp(l.N1, 5)) & 0xFFFFFFFF
    h[2] = (l.M2 ^ rrp(l.N2, 10)) & 0xFFFFFFFF
    h[3] = (l.M3 ^ rrp(l.N3, 15)) & 0xFFFFFFFF
    h[4] = (l.M4 ^ rrp(l.N4, 20)) & 0xFFFFFFFF
}

// W=5 单块压缩（f/b/x 共用单环内核，R 各档）
pub func compress_w5(h: ref table<i64>, msg: string, pos: i64, nbytes: i64,
            t_lo: i64, t_hi: i64, last: bool,
            iv: table<i64>, rcon: table<i64>, R: i64) {
    var (M0, N0, M1, N1, Pw, skey) = w48_planes_skey(msg, pos, nbytes)
    var l = Lanes5()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp(h[2], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp(h[3], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp(h[4], 7)
    l.M3 = h[3] & 0xFFFFFFFF
    l.N3 = rrp(h[0], 7)
    l.M4 = h[4] & 0xFFFFFFFF
    l.N4 = rrp(h[1], 7)
    l.M0 = (l.M0 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M1 = (l.M1 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M2 = (l.M2 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M3 = (l.M3 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M4 = (l.M4 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (t_lo & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ (t_hi & 0xFFFFFFFF)) & 0xFFFFFFFF
    if last {
        l.N2 = (l.N2 ^ 0xFFFFFFFF) & 0xFFFFFFFF
    }
    l = absorb5(l, Pw, skey)
    var mA: i64 = 0
    var r: i64 = 0
    while r < R {
        mA = (r * 5 + ((skey >> 6) & 7)) & 31
        l = ring5_mix(l, r, skey, M0, N0, M1, N1, mA, rcon, r)
        r = r + 1
    }
    h[0] = (h[0] ^ l.M0 ^ rrp(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (h[1] ^ l.M1 ^ rrp(l.N1, 3)) & 0xFFFFFFFF
    h[2] = (h[2] ^ l.M2 ^ rrp(l.N2, 6)) & 0xFFFFFFFF
    h[3] = (h[3] ^ l.M3 ^ rrp(l.N3, 9)) & 0xFFFFFFFF
    h[4] = (h[4] ^ l.M4 ^ rrp(l.N4, 12)) & 0xFFFFFFFF
    fin_synth5(h)
}

// ============================================================================
// W=6 单环特化内核（n=32 全宽；L=W 单环）——语义与通用 ring_mix 单环逐式一致。
// ============================================================================
struct Lanes6 {
    var M0: i64 = 0
    var N0: i64 = 0
    var M1: i64 = 0
    var N1: i64 = 0
    var M2: i64 = 0
    var N2: i64 = 0
    var M3: i64 = 0
    var N3: i64 = 0
    var M4: i64 = 0
    var N4: i64 = 0
    var M5: i64 = 0
    var N5: i64 = 0
}

func ring6_mix(l: Lanes6, r: i64
            , skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes6 {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0,
                    rrp(l.M2, rA), rrp(l.N2, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp(l.M3, (rB + 3) & 31), rrp(l.N3, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1,
                    rrp(l.M3, (rA + 5) & 31), rrp(l.N3, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp(l.M4, (rB + 10) & 31), rrp(l.N4, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M2, l.N2,
                    rrp(l.M4, (rA + 10) & 31), rrp(l.N4, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp(l.M5, (rB + 17) & 31), rrp(l.N5, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M3, l.N3,
                    rrp(l.M5, (rA + 15) & 31), rrp(l.N5, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp(l.M0, (rB + 24) & 31), rrp(l.N0, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M4, l.N4,
                    rrp(l.M0, (rA + 20) & 31), rrp(l.N0, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp(l.M1, (rB + 31) & 31), rrp(l.N1, (rB + 31) & 31))
    var (q5m, q5n) = tadd2(l.M5, l.N5,
                    rrp(l.M1, (rA + 25) & 31), rrp(l.N1, (rA + 25) & 31))
    var (s5m, s5n) = tadd2(q5m, q5n,
                    rrp(l.M2, (rB + 6) & 31), rrp(l.N2, (rB + 6) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    l.M2 = s2m
    l.N2 = s2n
    l.M3 = s3m
    l.N3 = s3n
    l.M4 = s4m
    l.N4 = s4n
    l.M5 = s5m
    l.N5 = s5n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M2 = (l.M2 ^ p1m) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M3 = (l.M3 ^ p2m) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s5m, s5n)
    l.M4 = (l.M4 ^ p3m) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s0m, s0n)
    l.M5 = (l.M5 ^ p4m) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ p4n) & 0xFFFFFFFF
    var (p5m, p5n) = tmul2(s5m, s5n, s1m, s1n)
    l.M0 = (l.M0 ^ p5m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p5n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M5 = (l.M5 ^ maj) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M0, l.N0, rrp(M0, mA), rrp(N0, mA))
    l.M0 = im
    l.N0 = in2
    var (jm, jn2) = tadd2(l.M1, l.N1, rrp(M1, (mA + 7) & 31), rrp(N1, (mA + 7) & 31))
    l.M1 = jm
    l.N1 = jn2
    l.M0 = (l.M0 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ rrp(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

func ring6_mixF(l: Lanes6, r: i64
            , skey: i64
            ) -> Lanes6 {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0,
                    rrp(l.M2, rA), rrp(l.N2, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp(l.M3, (rB + 3) & 31), rrp(l.N3, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1,
                    rrp(l.M3, (rA + 5) & 31), rrp(l.N3, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp(l.M4, (rB + 10) & 31), rrp(l.N4, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M2, l.N2,
                    rrp(l.M4, (rA + 10) & 31), rrp(l.N4, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp(l.M5, (rB + 17) & 31), rrp(l.N5, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M3, l.N3,
                    rrp(l.M5, (rA + 15) & 31), rrp(l.N5, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp(l.M0, (rB + 24) & 31), rrp(l.N0, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M4, l.N4,
                    rrp(l.M0, (rA + 20) & 31), rrp(l.N0, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp(l.M1, (rB + 31) & 31), rrp(l.N1, (rB + 31) & 31))
    var (q5m, q5n) = tadd2(l.M5, l.N5,
                    rrp(l.M1, (rA + 25) & 31), rrp(l.N1, (rA + 25) & 31))
    var (s5m, s5n) = tadd2(q5m, q5n,
                    rrp(l.M2, (rB + 6) & 31), rrp(l.N2, (rB + 6) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    l.M2 = s2m
    l.N2 = s2n
    l.M3 = s3m
    l.N3 = s3n
    l.M4 = s4m
    l.N4 = s4n
    l.M5 = s5m
    l.N5 = s5n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M2 = (l.M2 ^ p1m) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M3 = (l.M3 ^ p2m) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s5m, s5n)
    l.M4 = (l.M4 ^ p3m) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s0m, s0n)
    l.M5 = (l.M5 ^ p4m) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ p4n) & 0xFFFFFFFF
    var (p5m, p5n) = tmul2(s5m, s5n, s1m, s1n)
    l.M0 = (l.M0 ^ p5m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p5n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M5 = (l.M5 ^ maj) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    return l
}

func absorb6(l: Lanes6, Pw: Planes16, skey: i64) -> Lanes6 {
    var w: i64 = 0
    while w < 16 {
        var pv: i64 = 0
        if w == 0 {
            pv = Pw.w0
        } else if w == 1 {
            pv = Pw.w1
        } else if w == 2 {
            pv = Pw.w2
        } else if w == 3 {
            pv = Pw.w3
        } else if w == 4 {
            pv = Pw.w4
        } else if w == 5 {
            pv = Pw.w5
        } else if w == 6 {
            pv = Pw.w6
        } else if w == 7 {
            pv = Pw.w7
        } else if w == 8 {
            pv = Pw.w8
        } else if w == 9 {
            pv = Pw.w9
        } else if w == 10 {
            pv = Pw.w10
        } else if w == 11 {
            pv = Pw.w11
        } else if w == 12 {
            pv = Pw.w12
        } else if w == 13 {
            pv = Pw.w13
        } else if w == 14 {
            pv = Pw.w14
        } else {
            pv = Pw.w15
        }
        if pv != 0 {
            var a = (w * 5 + ((skey >> (w & 7)) & 7)) & 31
            var an = w % 6
            var v = rrp(pv, a)
            var v2 = rrp(pv, a + 17)
            if an == 0 {
                var (t0m, t0n) = tadd2(l.M0, l.N0, v, v2)
                l.M0 = t0m & 0xFFFFFFFF
                l.N0 = t0n & 0xFFFFFFFF
            } else if an == 1 {
                var (t1m, t1n) = tadd2(l.M1, l.N1, v, v2)
                l.M1 = t1m & 0xFFFFFFFF
                l.N1 = t1n & 0xFFFFFFFF
            } else if an == 2 {
                var (t2m, t2n) = tadd2(l.M2, l.N2, v, v2)
                l.M2 = t2m & 0xFFFFFFFF
                l.N2 = t2n & 0xFFFFFFFF
            } else if an == 3 {
                var (t3m, t3n) = tadd2(l.M3, l.N3, v, v2)
                l.M3 = t3m & 0xFFFFFFFF
                l.N3 = t3n & 0xFFFFFFFF
            } else if an == 4 {
                var (t4m, t4n) = tadd2(l.M4, l.N4, v, v2)
                l.M4 = t4m & 0xFFFFFFFF
                l.N4 = t4n & 0xFFFFFFFF
            } else {
                var (t5m, t5n) = tadd2(l.M5, l.N5, v, v2)
                l.M5 = t5m & 0xFFFFFFFF
                l.N5 = t5n & 0xFFFFFFFF
            }
        }
        w = w + 1
    }
    return l
}

// W=6 终筛
func fin_synth6(h: ref table<i64>) {
    var l = Lanes6()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp(h[1], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp(h[2], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp(h[3], 7)
    l.M3 = h[3] & 0xFFFFFFFF
    l.N3 = rrp(h[4], 7)
    l.M4 = h[4] & 0xFFFFFFFF
    l.N4 = rrp(h[5], 7)
    l.M5 = h[5] & 0xFFFFFFFF
    l.N5 = rrp(h[0], 7)
    var sf: i64 = 0
    while sf < 4 {
        l = ring6_mixF(l, sf, 0x13579BDF)
        sf = sf + 1
    }
    h[0] = (l.M0 ^ rrp(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (l.M1 ^ rrp(l.N1, 5)) & 0xFFFFFFFF
    h[2] = (l.M2 ^ rrp(l.N2, 10)) & 0xFFFFFFFF
    h[3] = (l.M3 ^ rrp(l.N3, 15)) & 0xFFFFFFFF
    h[4] = (l.M4 ^ rrp(l.N4, 20)) & 0xFFFFFFFF
    h[5] = (l.M5 ^ rrp(l.N5, 25)) & 0xFFFFFFFF
}

// W=6 单块压缩（f/b/x 共用单环内核，R 各档）
pub func compress_w6(h: ref table<i64>, msg: string, pos: i64, nbytes: i64,
            t_lo: i64, t_hi: i64, last: bool,
            iv: table<i64>, rcon: table<i64>, R: i64) {
    var (M0, N0, M1, N1, Pw, skey) = w48_planes_skey(msg, pos, nbytes)
    var l = Lanes6()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp(h[3], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp(h[4], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp(h[5], 7)
    l.M3 = h[3] & 0xFFFFFFFF
    l.N3 = rrp(h[0], 7)
    l.M4 = h[4] & 0xFFFFFFFF
    l.N4 = rrp(h[1], 7)
    l.M5 = h[5] & 0xFFFFFFFF
    l.N5 = rrp(h[2], 7)
    l.M0 = (l.M0 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M1 = (l.M1 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M2 = (l.M2 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M3 = (l.M3 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M4 = (l.M4 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M5 = (l.M5 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (t_lo & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ (t_hi & 0xFFFFFFFF)) & 0xFFFFFFFF
    if last {
        l.N3 = (l.N3 ^ 0xFFFFFFFF) & 0xFFFFFFFF
    }
    l = absorb6(l, Pw, skey)
    var mA: i64 = 0
    var r: i64 = 0
    while r < R {
        mA = (r * 5 + ((skey >> 6) & 7)) & 31
        l = ring6_mix(l, r, skey, M0, N0, M1, N1, mA, rcon, r)
        r = r + 1
    }
    h[0] = (h[0] ^ l.M0 ^ rrp(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (h[1] ^ l.M1 ^ rrp(l.N1, 3)) & 0xFFFFFFFF
    h[2] = (h[2] ^ l.M2 ^ rrp(l.N2, 6)) & 0xFFFFFFFF
    h[3] = (h[3] ^ l.M3 ^ rrp(l.N3, 9)) & 0xFFFFFFFF
    h[4] = (h[4] ^ l.M4 ^ rrp(l.N4, 12)) & 0xFFFFFFFF
    h[5] = (h[5] ^ l.M5 ^ rrp(l.N5, 15)) & 0xFFFFFFFF
    fin_synth6(h)
}


// ============================================================================
// W=3 单环特化内核（n=12/16 r 半宽；L=W 单环）——语义与通用 ring_mix 单环逐式一致。
// ============================================================================
struct Lanes3h {
    var M0: i64 = 0
    var N0: i64 = 0
    var M1: i64 = 0
    var N1: i64 = 0
    var M2: i64 = 0
    var N2: i64 = 0
}

func ring3h_mix(l: Lanes3h, r: i64
            , skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes3h {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0,
                    rrp16(l.M2, rA), rrp16(l.N2, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp16(l.M0, (rB + 3) & 31), rrp16(l.N0, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1,
                    rrp16(l.M0, (rA + 5) & 31), rrp16(l.N0, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp16(l.M1, (rB + 10) & 31), rrp16(l.N1, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M2, l.N2,
                    rrp16(l.M1, (rA + 10) & 31), rrp16(l.N1, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp16(l.M2, (rB + 17) & 31), rrp16(l.N2, (rB + 17) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    l.M2 = s2m
    l.N2 = s2n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s0m, s0n)
    l.M2 = (l.M2 ^ p1m) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s1m, s1n)
    l.M0 = (l.M0 ^ p2m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p2n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M2 = (l.M2 ^ maj) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ rrp16(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M0, l.N0, rrp16(M0, mA), rrp16(N0, mA))
    l.M0 = im
    l.N0 = in2
    var (jm, jn2) = tadd2(l.M1, l.N1, rrp16(M1, (mA + 7) & 31), rrp16(N1, (mA + 7) & 31))
    l.M1 = jm
    l.N1 = jn2
    l.M0 = (l.M0 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ rrp16(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

func ring3h_mixF(l: Lanes3h, r: i64
            , skey: i64
            ) -> Lanes3h {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0,
                    rrp16(l.M2, rA), rrp16(l.N2, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp16(l.M0, (rB + 3) & 31), rrp16(l.N0, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1,
                    rrp16(l.M0, (rA + 5) & 31), rrp16(l.N0, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp16(l.M1, (rB + 10) & 31), rrp16(l.N1, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M2, l.N2,
                    rrp16(l.M1, (rA + 10) & 31), rrp16(l.N1, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp16(l.M2, (rB + 17) & 31), rrp16(l.N2, (rB + 17) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    l.M2 = s2m
    l.N2 = s2n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s0m, s0n)
    l.M2 = (l.M2 ^ p1m) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s1m, s1n)
    l.M0 = (l.M0 ^ p2m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p2n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M2 = (l.M2 ^ maj) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ rrp16(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    return l
}

func absorb3h(l: Lanes3h, Pw: Planes16, skey: i64) -> Lanes3h {
    var w: i64 = 0
    while w < 16 {
        var pv: i64 = 0
        if w == 0 {
            pv = Pw.w0
        } else if w == 1 {
            pv = Pw.w1
        } else if w == 2 {
            pv = Pw.w2
        } else if w == 3 {
            pv = Pw.w3
        } else if w == 4 {
            pv = Pw.w4
        } else if w == 5 {
            pv = Pw.w5
        } else if w == 6 {
            pv = Pw.w6
        } else if w == 7 {
            pv = Pw.w7
        } else if w == 8 {
            pv = Pw.w8
        } else if w == 9 {
            pv = Pw.w9
        } else if w == 10 {
            pv = Pw.w10
        } else if w == 11 {
            pv = Pw.w11
        } else if w == 12 {
            pv = Pw.w12
        } else if w == 13 {
            pv = Pw.w13
        } else if w == 14 {
            pv = Pw.w14
        } else {
            pv = Pw.w15
        }
        if pv != 0 {
            var a = (w * 5 + ((skey >> (w & 7)) & 7)) & 31
            var an = w % 3
            var v = rrp16(pv, a)
            var v2 = rrp16(pv, a + 17)
            if an == 0 {
                var (t0m, t0n) = tadd2(l.M0, l.N0, v, v2)
                l.M0 = t0m & 0xFFFFFFFF
                l.N0 = t0n & 0xFFFFFFFF
            } else if an == 1 {
                var (t1m, t1n) = tadd2(l.M1, l.N1, v, v2)
                l.M1 = t1m & 0xFFFFFFFF
                l.N1 = t1n & 0xFFFFFFFF
            } else {
                var (t2m, t2n) = tadd2(l.M2, l.N2, v, v2)
                l.M2 = t2m & 0xFFFFFFFF
                l.N2 = t2n & 0xFFFFFFFF
            }
        }
        w = w + 1
    }
    return l
}

// W=3 r 半宽终筛
func fin_synth3h(h: ref table<i64>) {
    var l = Lanes3h()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp16(h[1], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp16(h[2], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp16(h[0], 7)
    var sf: i64 = 0
    while sf < 4 {
        l = ring3h_mixF(l, sf, 0x13579BDF)
        sf = sf + 1
    }
    h[0] = (l.M0 ^ rrp16(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (l.M1 ^ rrp16(l.N1, 5)) & 0xFFFFFFFF
    h[2] = (l.M2 ^ rrp16(l.N2, 10)) & 0xFFFFFFFF
}

// W=3 r 半宽单块压缩（r 半宽 R=8，R 各档）
pub func compress_w3h(h: ref table<i64>, msg: string, pos: i64, nbytes: i64,
            t_lo: i64, t_hi: i64, last: bool,
            iv: table<i64>, rcon: table<i64>, R: i64) {
    var (M0, N0, M1, N1, Pw, skey) = w48_planes_skey(msg, pos, nbytes)
    var l = Lanes3h()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp16(h[1], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp16(h[2], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp16(h[0], 7)
    l.M0 = (l.M0 ^ (iv[0] & 0xFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (iv[4] & 0xFFFF)) & 0xFFFFFFFF
    l.M1 = (l.M1 ^ (iv[1] & 0xFFFF)) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ (iv[5] & 0xFFFF)) & 0xFFFFFFFF
    l.M2 = (l.M2 ^ (iv[2] & 0xFFFF)) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ (iv[6] & 0xFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (t_lo & 0xFFFF)) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ (t_hi & 0xFFFF)) & 0xFFFFFFFF
    if last {
        l.N1 = (l.N1 ^ 0xFFFFFFFF) & 0xFFFFFFFF
    }
    l = absorb3h(l, Pw, skey)
    var mA: i64 = 0
    var r: i64 = 0
    while r < R {
        mA = (r * 5 + ((skey >> 6) & 7)) & 31
        l = ring3h_mix(l, r, skey, M0, N0, M1, N1, mA, rcon, r)
        r = r + 1
    }
    h[0] = (h[0] ^ l.M0 ^ rrp16(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (h[1] ^ l.M1 ^ rrp16(l.N1, 3)) & 0xFFFFFFFF
    h[2] = (h[2] ^ l.M2 ^ rrp16(l.N2, 6)) & 0xFFFFFFFF
    fin_synth3h(h)
}

// ============================================================================
// W=4 单环特化内核（n=4 r 半宽；L=W 单环）——语义与通用 ring_mix 单环逐式一致。
// ============================================================================
struct Lanes4h {
    var M0: i64 = 0
    var N0: i64 = 0
    var M1: i64 = 0
    var N1: i64 = 0
    var M2: i64 = 0
    var N2: i64 = 0
    var M3: i64 = 0
    var N3: i64 = 0
}

func ring4h_mix(l: Lanes4h, r: i64
            , skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes4h {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0,
                    rrp16(l.M2, rA), rrp16(l.N2, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp16(l.M3, (rB + 3) & 31), rrp16(l.N3, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1,
                    rrp16(l.M3, (rA + 5) & 31), rrp16(l.N3, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp16(l.M0, (rB + 10) & 31), rrp16(l.N0, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M2, l.N2,
                    rrp16(l.M0, (rA + 10) & 31), rrp16(l.N0, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp16(l.M1, (rB + 17) & 31), rrp16(l.N1, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M3, l.N3,
                    rrp16(l.M1, (rA + 15) & 31), rrp16(l.N1, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp16(l.M2, (rB + 24) & 31), rrp16(l.N2, (rB + 24) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    l.M2 = s2m
    l.N2 = s2n
    l.M3 = s3m
    l.N3 = s3n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M2 = (l.M2 ^ p1m) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s0m, s0n)
    l.M3 = (l.M3 ^ p2m) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s1m, s1n)
    l.M0 = (l.M0 ^ p3m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p3n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M3 = (l.M3 ^ maj) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ rrp16(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M0, l.N0, rrp16(M0, mA), rrp16(N0, mA))
    l.M0 = im
    l.N0 = in2
    var (jm, jn2) = tadd2(l.M1, l.N1, rrp16(M1, (mA + 7) & 31), rrp16(N1, (mA + 7) & 31))
    l.M1 = jm
    l.N1 = jn2
    l.M0 = (l.M0 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ rrp16(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

func ring4h_mixF(l: Lanes4h, r: i64
            , skey: i64
            ) -> Lanes4h {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0,
                    rrp16(l.M2, rA), rrp16(l.N2, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp16(l.M3, (rB + 3) & 31), rrp16(l.N3, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1,
                    rrp16(l.M3, (rA + 5) & 31), rrp16(l.N3, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp16(l.M0, (rB + 10) & 31), rrp16(l.N0, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M2, l.N2,
                    rrp16(l.M0, (rA + 10) & 31), rrp16(l.N0, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp16(l.M1, (rB + 17) & 31), rrp16(l.N1, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M3, l.N3,
                    rrp16(l.M1, (rA + 15) & 31), rrp16(l.N1, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp16(l.M2, (rB + 24) & 31), rrp16(l.N2, (rB + 24) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    l.M2 = s2m
    l.N2 = s2n
    l.M3 = s3m
    l.N3 = s3n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M2 = (l.M2 ^ p1m) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s0m, s0n)
    l.M3 = (l.M3 ^ p2m) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s1m, s1n)
    l.M0 = (l.M0 ^ p3m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p3n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M3 = (l.M3 ^ maj) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ rrp16(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    return l
}

func absorb4h(l: Lanes4h, Pw: Planes16, skey: i64) -> Lanes4h {
    var w: i64 = 0
    while w < 16 {
        var pv: i64 = 0
        if w == 0 {
            pv = Pw.w0
        } else if w == 1 {
            pv = Pw.w1
        } else if w == 2 {
            pv = Pw.w2
        } else if w == 3 {
            pv = Pw.w3
        } else if w == 4 {
            pv = Pw.w4
        } else if w == 5 {
            pv = Pw.w5
        } else if w == 6 {
            pv = Pw.w6
        } else if w == 7 {
            pv = Pw.w7
        } else if w == 8 {
            pv = Pw.w8
        } else if w == 9 {
            pv = Pw.w9
        } else if w == 10 {
            pv = Pw.w10
        } else if w == 11 {
            pv = Pw.w11
        } else if w == 12 {
            pv = Pw.w12
        } else if w == 13 {
            pv = Pw.w13
        } else if w == 14 {
            pv = Pw.w14
        } else {
            pv = Pw.w15
        }
        if pv != 0 {
            var a = (w * 5 + ((skey >> (w & 7)) & 7)) & 31
            var an = w % 4
            var v = rrp16(pv, a)
            var v2 = rrp16(pv, a + 17)
            if an == 0 {
                var (t0m, t0n) = tadd2(l.M0, l.N0, v, v2)
                l.M0 = t0m & 0xFFFFFFFF
                l.N0 = t0n & 0xFFFFFFFF
            } else if an == 1 {
                var (t1m, t1n) = tadd2(l.M1, l.N1, v, v2)
                l.M1 = t1m & 0xFFFFFFFF
                l.N1 = t1n & 0xFFFFFFFF
            } else if an == 2 {
                var (t2m, t2n) = tadd2(l.M2, l.N2, v, v2)
                l.M2 = t2m & 0xFFFFFFFF
                l.N2 = t2n & 0xFFFFFFFF
            } else {
                var (t3m, t3n) = tadd2(l.M3, l.N3, v, v2)
                l.M3 = t3m & 0xFFFFFFFF
                l.N3 = t3n & 0xFFFFFFFF
            }
        }
        w = w + 1
    }
    return l
}

// W=4 r 半宽终筛
func fin_synth4h(h: ref table<i64>) {
    var l = Lanes4h()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp16(h[1], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp16(h[2], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp16(h[3], 7)
    l.M3 = h[3] & 0xFFFFFFFF
    l.N3 = rrp16(h[0], 7)
    var sf: i64 = 0
    while sf < 4 {
        l = ring4h_mixF(l, sf, 0x13579BDF)
        sf = sf + 1
    }
    h[0] = (l.M0 ^ rrp16(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (l.M1 ^ rrp16(l.N1, 5)) & 0xFFFFFFFF
    h[2] = (l.M2 ^ rrp16(l.N2, 10)) & 0xFFFFFFFF
    h[3] = (l.M3 ^ rrp16(l.N3, 15)) & 0xFFFFFFFF
}

// W=4 r 半宽单块压缩（r 半宽 R=8，R 各档）
pub func compress_w4h(h: ref table<i64>, msg: string, pos: i64, nbytes: i64,
            t_lo: i64, t_hi: i64, last: bool,
            iv: table<i64>, rcon: table<i64>, R: i64) {
    var (M0, N0, M1, N1, Pw, skey) = w48_planes_skey(msg, pos, nbytes)
    var l = Lanes4h()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp16(h[2], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp16(h[3], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp16(h[0], 7)
    l.M3 = h[3] & 0xFFFFFFFF
    l.N3 = rrp16(h[1], 7)
    l.M0 = (l.M0 ^ (iv[0] & 0xFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (iv[4] & 0xFFFF)) & 0xFFFFFFFF
    l.M1 = (l.M1 ^ (iv[1] & 0xFFFF)) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ (iv[5] & 0xFFFF)) & 0xFFFFFFFF
    l.M2 = (l.M2 ^ (iv[2] & 0xFFFF)) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ (iv[6] & 0xFFFF)) & 0xFFFFFFFF
    l.M3 = (l.M3 ^ (iv[3] & 0xFFFF)) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ (iv[7] & 0xFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (t_lo & 0xFFFF)) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ (t_hi & 0xFFFF)) & 0xFFFFFFFF
    if last {
        l.N2 = (l.N2 ^ 0xFFFFFFFF) & 0xFFFFFFFF
    }
    l = absorb4h(l, Pw, skey)
    var mA: i64 = 0
    var r: i64 = 0
    while r < R {
        mA = (r * 5 + ((skey >> 6) & 7)) & 31
        l = ring4h_mix(l, r, skey, M0, N0, M1, N1, mA, rcon, r)
        r = r + 1
    }
    h[0] = (h[0] ^ l.M0 ^ rrp16(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (h[1] ^ l.M1 ^ rrp16(l.N1, 3)) & 0xFFFFFFFF
    h[2] = (h[2] ^ l.M2 ^ rrp16(l.N2, 6)) & 0xFFFFFFFF
    h[3] = (h[3] ^ l.M3 ^ rrp16(l.N3, 9)) & 0xFFFFFFFF
    fin_synth4h(h)
}

// ============================================================================
// W=6 单环特化内核（n=32 r 半宽；L=W 单环）——语义与通用 ring_mix 单环逐式一致。
// ============================================================================
struct Lanes6h {
    var M0: i64 = 0
    var N0: i64 = 0
    var M1: i64 = 0
    var N1: i64 = 0
    var M2: i64 = 0
    var N2: i64 = 0
    var M3: i64 = 0
    var N3: i64 = 0
    var M4: i64 = 0
    var N4: i64 = 0
    var M5: i64 = 0
    var N5: i64 = 0
}

func ring6h_mix(l: Lanes6h, r: i64
            , skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes6h {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0,
                    rrp16(l.M2, rA), rrp16(l.N2, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp16(l.M3, (rB + 3) & 31), rrp16(l.N3, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1,
                    rrp16(l.M3, (rA + 5) & 31), rrp16(l.N3, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp16(l.M4, (rB + 10) & 31), rrp16(l.N4, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M2, l.N2,
                    rrp16(l.M4, (rA + 10) & 31), rrp16(l.N4, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp16(l.M5, (rB + 17) & 31), rrp16(l.N5, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M3, l.N3,
                    rrp16(l.M5, (rA + 15) & 31), rrp16(l.N5, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp16(l.M0, (rB + 24) & 31), rrp16(l.N0, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M4, l.N4,
                    rrp16(l.M0, (rA + 20) & 31), rrp16(l.N0, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp16(l.M1, (rB + 31) & 31), rrp16(l.N1, (rB + 31) & 31))
    var (q5m, q5n) = tadd2(l.M5, l.N5,
                    rrp16(l.M1, (rA + 25) & 31), rrp16(l.N1, (rA + 25) & 31))
    var (s5m, s5n) = tadd2(q5m, q5n,
                    rrp16(l.M2, (rB + 6) & 31), rrp16(l.N2, (rB + 6) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    l.M2 = s2m
    l.N2 = s2n
    l.M3 = s3m
    l.N3 = s3n
    l.M4 = s4m
    l.N4 = s4n
    l.M5 = s5m
    l.N5 = s5n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M2 = (l.M2 ^ p1m) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M3 = (l.M3 ^ p2m) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s5m, s5n)
    l.M4 = (l.M4 ^ p3m) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s0m, s0n)
    l.M5 = (l.M5 ^ p4m) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ p4n) & 0xFFFFFFFF
    var (p5m, p5n) = tmul2(s5m, s5n, s1m, s1n)
    l.M0 = (l.M0 ^ p5m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p5n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M5 = (l.M5 ^ maj) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ rrp16(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M0, l.N0, rrp16(M0, mA), rrp16(N0, mA))
    l.M0 = im
    l.N0 = in2
    var (jm, jn2) = tadd2(l.M1, l.N1, rrp16(M1, (mA + 7) & 31), rrp16(N1, (mA + 7) & 31))
    l.M1 = jm
    l.N1 = jn2
    l.M0 = (l.M0 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ rrp16(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

func ring6h_mixF(l: Lanes6h, r: i64
            , skey: i64
            ) -> Lanes6h {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0,
                    rrp16(l.M2, rA), rrp16(l.N2, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp16(l.M3, (rB + 3) & 31), rrp16(l.N3, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1,
                    rrp16(l.M3, (rA + 5) & 31), rrp16(l.N3, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp16(l.M4, (rB + 10) & 31), rrp16(l.N4, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M2, l.N2,
                    rrp16(l.M4, (rA + 10) & 31), rrp16(l.N4, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp16(l.M5, (rB + 17) & 31), rrp16(l.N5, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M3, l.N3,
                    rrp16(l.M5, (rA + 15) & 31), rrp16(l.N5, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp16(l.M0, (rB + 24) & 31), rrp16(l.N0, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M4, l.N4,
                    rrp16(l.M0, (rA + 20) & 31), rrp16(l.N0, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp16(l.M1, (rB + 31) & 31), rrp16(l.N1, (rB + 31) & 31))
    var (q5m, q5n) = tadd2(l.M5, l.N5,
                    rrp16(l.M1, (rA + 25) & 31), rrp16(l.N1, (rA + 25) & 31))
    var (s5m, s5n) = tadd2(q5m, q5n,
                    rrp16(l.M2, (rB + 6) & 31), rrp16(l.N2, (rB + 6) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    l.M2 = s2m
    l.N2 = s2n
    l.M3 = s3m
    l.N3 = s3n
    l.M4 = s4m
    l.N4 = s4n
    l.M5 = s5m
    l.N5 = s5n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M2 = (l.M2 ^ p1m) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M3 = (l.M3 ^ p2m) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s5m, s5n)
    l.M4 = (l.M4 ^ p3m) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s0m, s0n)
    l.M5 = (l.M5 ^ p4m) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ p4n) & 0xFFFFFFFF
    var (p5m, p5n) = tmul2(s5m, s5n, s1m, s1n)
    l.M0 = (l.M0 ^ p5m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p5n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M5 = (l.M5 ^ maj) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ rrp16(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    return l
}

func absorb6h(l: Lanes6h, Pw: Planes16, skey: i64) -> Lanes6h {
    var w: i64 = 0
    while w < 16 {
        var pv: i64 = 0
        if w == 0 {
            pv = Pw.w0
        } else if w == 1 {
            pv = Pw.w1
        } else if w == 2 {
            pv = Pw.w2
        } else if w == 3 {
            pv = Pw.w3
        } else if w == 4 {
            pv = Pw.w4
        } else if w == 5 {
            pv = Pw.w5
        } else if w == 6 {
            pv = Pw.w6
        } else if w == 7 {
            pv = Pw.w7
        } else if w == 8 {
            pv = Pw.w8
        } else if w == 9 {
            pv = Pw.w9
        } else if w == 10 {
            pv = Pw.w10
        } else if w == 11 {
            pv = Pw.w11
        } else if w == 12 {
            pv = Pw.w12
        } else if w == 13 {
            pv = Pw.w13
        } else if w == 14 {
            pv = Pw.w14
        } else {
            pv = Pw.w15
        }
        if pv != 0 {
            var a = (w * 5 + ((skey >> (w & 7)) & 7)) & 31
            var an = w % 6
            var v = rrp16(pv, a)
            var v2 = rrp16(pv, a + 17)
            if an == 0 {
                var (t0m, t0n) = tadd2(l.M0, l.N0, v, v2)
                l.M0 = t0m & 0xFFFFFFFF
                l.N0 = t0n & 0xFFFFFFFF
            } else if an == 1 {
                var (t1m, t1n) = tadd2(l.M1, l.N1, v, v2)
                l.M1 = t1m & 0xFFFFFFFF
                l.N1 = t1n & 0xFFFFFFFF
            } else if an == 2 {
                var (t2m, t2n) = tadd2(l.M2, l.N2, v, v2)
                l.M2 = t2m & 0xFFFFFFFF
                l.N2 = t2n & 0xFFFFFFFF
            } else if an == 3 {
                var (t3m, t3n) = tadd2(l.M3, l.N3, v, v2)
                l.M3 = t3m & 0xFFFFFFFF
                l.N3 = t3n & 0xFFFFFFFF
            } else if an == 4 {
                var (t4m, t4n) = tadd2(l.M4, l.N4, v, v2)
                l.M4 = t4m & 0xFFFFFFFF
                l.N4 = t4n & 0xFFFFFFFF
            } else {
                var (t5m, t5n) = tadd2(l.M5, l.N5, v, v2)
                l.M5 = t5m & 0xFFFFFFFF
                l.N5 = t5n & 0xFFFFFFFF
            }
        }
        w = w + 1
    }
    return l
}

// W=6 r 半宽终筛
func fin_synth6h(h: ref table<i64>) {
    var l = Lanes6h()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp16(h[1], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp16(h[2], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp16(h[3], 7)
    l.M3 = h[3] & 0xFFFFFFFF
    l.N3 = rrp16(h[4], 7)
    l.M4 = h[4] & 0xFFFFFFFF
    l.N4 = rrp16(h[5], 7)
    l.M5 = h[5] & 0xFFFFFFFF
    l.N5 = rrp16(h[0], 7)
    var sf: i64 = 0
    while sf < 4 {
        l = ring6h_mixF(l, sf, 0x13579BDF)
        sf = sf + 1
    }
    h[0] = (l.M0 ^ rrp16(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (l.M1 ^ rrp16(l.N1, 5)) & 0xFFFFFFFF
    h[2] = (l.M2 ^ rrp16(l.N2, 10)) & 0xFFFFFFFF
    h[3] = (l.M3 ^ rrp16(l.N3, 15)) & 0xFFFFFFFF
    h[4] = (l.M4 ^ rrp16(l.N4, 20)) & 0xFFFFFFFF
    h[5] = (l.M5 ^ rrp16(l.N5, 25)) & 0xFFFFFFFF
}

// W=6 r 半宽单块压缩（r 半宽 R=8，R 各档）
pub func compress_w6h(h: ref table<i64>, msg: string, pos: i64, nbytes: i64,
            t_lo: i64, t_hi: i64, last: bool,
            iv: table<i64>, rcon: table<i64>, R: i64) {
    var (M0, N0, M1, N1, Pw, skey) = w48_planes_skey(msg, pos, nbytes)
    var l = Lanes6h()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp16(h[3], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp16(h[4], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp16(h[5], 7)
    l.M3 = h[3] & 0xFFFFFFFF
    l.N3 = rrp16(h[0], 7)
    l.M4 = h[4] & 0xFFFFFFFF
    l.N4 = rrp16(h[1], 7)
    l.M5 = h[5] & 0xFFFFFFFF
    l.N5 = rrp16(h[2], 7)
    l.M0 = (l.M0 ^ (iv[0] & 0xFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (iv[4] & 0xFFFF)) & 0xFFFFFFFF
    l.M1 = (l.M1 ^ (iv[1] & 0xFFFF)) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ (iv[5] & 0xFFFF)) & 0xFFFFFFFF
    l.M2 = (l.M2 ^ (iv[2] & 0xFFFF)) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ (iv[6] & 0xFFFF)) & 0xFFFFFFFF
    l.M3 = (l.M3 ^ (iv[3] & 0xFFFF)) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ (iv[7] & 0xFFFF)) & 0xFFFFFFFF
    l.M4 = (l.M4 ^ (iv[4] & 0xFFFF)) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ (iv[0] & 0xFFFF)) & 0xFFFFFFFF
    l.M5 = (l.M5 ^ (iv[5] & 0xFFFF)) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ (iv[1] & 0xFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (t_lo & 0xFFFF)) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ (t_hi & 0xFFFF)) & 0xFFFFFFFF
    if last {
        l.N3 = (l.N3 ^ 0xFFFFFFFF) & 0xFFFFFFFF
    }
    l = absorb6h(l, Pw, skey)
    var mA: i64 = 0
    var r: i64 = 0
    while r < R {
        mA = (r * 5 + ((skey >> 6) & 7)) & 31
        l = ring6h_mix(l, r, skey, M0, N0, M1, N1, mA, rcon, r)
        r = r + 1
    }
    h[0] = (h[0] ^ l.M0 ^ rrp16(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (h[1] ^ l.M1 ^ rrp16(l.N1, 3)) & 0xFFFFFFFF
    h[2] = (h[2] ^ l.M2 ^ rrp16(l.N2, 6)) & 0xFFFFFFFF
    h[3] = (h[3] ^ l.M3 ^ rrp16(l.N3, 9)) & 0xFFFFFFFF
    h[4] = (h[4] ^ l.M4 ^ rrp16(l.N4, 12)) & 0xFFFFFFFF
    h[5] = (h[5] ^ l.M5 ^ rrp16(l.N5, 15)) & 0xFFFFFFFF
    fin_synth6h(h)
}
// ============================================================================
// W=1 r 半宽特化内核（n=2/3/4 r；rrp16 半宽 16-trit 字）——语义与通用 half=true
// （L=1 单环，fin_synth 对 W=1 恒为空）逐式一致。
// ============================================================================
struct Lanes1h {
    var M0: i64 = 0
    var N0: i64 = 0
}

// L=1 单环 ring_mix（半宽注入版）。通用 L==1：S0=tadd2(l0,rot(l0,a))；
// S1=tadd2(S0,rot(l0,b))；tmul S0*S0→l0；maj=quant3(S0,S1,S0,S1,S0,S1)→l0。
func ring1h_mix(l: Lanes1h, r: i64, skey: i64
            , M0: i64, N0: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64) -> Lanes1h {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0, rrp16(l.M0, rA), rrp16(l.N0, rA))
    var (s0m, s0n) = tadd2(q0m, q0n, rrp16(l.M0, (rB + 3) & 31), rrp16(l.N0, (rB + 3) & 31))
    l.M0 = s0m
    l.N0 = s0n
    var (p0m, p0n) = tmul2(s0m, s0n, s0m, s0n)
    l.M0 = (l.M0 ^ p0m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p0n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s0m, s0n, s0m, s0n)
    l.M0 = (l.M0 ^ maj) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ rrp16(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M0, l.N0, rrp16(M0, mA), rrp16(N0, mA))
    l.M0 = im & 0xFFFFFFFF
    l.N0 = in2 & 0xFFFFFFFF
    l.M0 = (l.M0 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ rrp16(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

// F1-2 位平面吸收（W=1 半宽：锚点字恒 0 → 全部并入 M0/N0，rrp16）。
func absorb1h(l: Lanes1h, Pw: Planes16, skey: i64) -> Lanes1h {
    var w: i64 = 0
    while w < 16 {
        var pv: i64 = 0
        if w == 0 {
            pv = Pw.w0
        } else if w == 1 {
            pv = Pw.w1
        } else if w == 2 {
            pv = Pw.w2
        } else if w == 3 {
            pv = Pw.w3
        } else if w == 4 {
            pv = Pw.w4
        } else if w == 5 {
            pv = Pw.w5
        } else if w == 6 {
            pv = Pw.w6
        } else if w == 7 {
            pv = Pw.w7
        } else if w == 8 {
            pv = Pw.w8
        } else if w == 9 {
            pv = Pw.w9
        } else if w == 10 {
            pv = Pw.w10
        } else if w == 11 {
            pv = Pw.w11
        } else if w == 12 {
            pv = Pw.w12
        } else if w == 13 {
            pv = Pw.w13
        } else if w == 14 {
            pv = Pw.w14
        } else {
            pv = Pw.w15
        }
        if pv != 0 {
            var a = (w * 5 + ((skey >> (w & 7)) & 7)) & 31
            var v = rrp16(pv, a)
            var v2 = rrp16(pv, a + 17)
            var (s0m, s0n) = tadd2(l.M0, l.N0, v, v2)
            l.M0 = s0m & 0xFFFFFFFF
            l.N0 = s0n & 0xFFFFFFFF
        }
        w = w + 1
    }
    return l
}

// W=1 r 半宽单块压缩（n=2/3/4 r，R=8；fin_synth 对 W=1 恒为空）。
pub func compress_w1h(h: ref table<i64>, msg: string, pos: i64, nbytes: i64,
            t_lo: i64, t_hi: i64, last: bool,
            iv: table<i64>, rcon: table<i64>, R: i64) {
    var (M0, N0, M1, N1, Pw, skey) = w48_planes_skey(msg, pos, nbytes)
    var l = Lanes1h()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp16(h[0], 7)
    l.M0 = (l.M0 ^ (iv[0] & 0xFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (iv[4] & 0xFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (t_lo & 0xFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (t_hi & 0xFFFF)) & 0xFFFFFFFF
    if last {
        l.N0 = (l.N0 ^ 0xFFFFFFFF) & 0xFFFFFFFF
    }
    l = absorb1h(l, Pw, skey)
    var mA: i64 = 0
    var r: i64 = 0
    while r < R {
        mA = (r * 5 + ((skey >> 6) & 7)) & 31
        l = ring1h_mix(l, r, skey, M0, N0, mA, rcon, r)
        r = r + 1
    }
    h[0] = (h[0] ^ l.M0 ^ rrp16(l.N0, 0)) & 0xFFFFFFFF
}

// ============================================================================
// W=8 双轨特化内核（r 半宽；轨A lanes[0..4)、轨B lanes[4..8)，LA=4）——
//   语义与通用 ring_mix 双轨（8<=W<16）逐式一致：轨A mA/rcon_idx=r、轨B mC/rcon_idx=(r+8)&15。
// ============================================================================
struct Lanes8h {
    var M0: i64 = 0
    var N0: i64 = 0
    var M1: i64 = 0
    var N1: i64 = 0
    var M2: i64 = 0
    var N2: i64 = 0
    var M3: i64 = 0
    var N3: i64 = 0
    var M4: i64 = 0
    var N4: i64 = 0
    var M5: i64 = 0
    var N5: i64 = 0
    var M6: i64 = 0
    var N6: i64 = 0
    var M7: i64 = 0
    var N7: i64 = 0
}

func ring8h_mixA(l: Lanes8h, r: i64
            , skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes8h {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0,
                    rrp16(l.M2, rA), rrp16(l.N2, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp16(l.M3, (rB + 3) & 31), rrp16(l.N3, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1,
                    rrp16(l.M3, (rA + 5) & 31), rrp16(l.N3, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp16(l.M0, (rB + 10) & 31), rrp16(l.N0, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M2, l.N2,
                    rrp16(l.M0, (rA + 10) & 31), rrp16(l.N0, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp16(l.M1, (rB + 17) & 31), rrp16(l.N1, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M3, l.N3,
                    rrp16(l.M1, (rA + 15) & 31), rrp16(l.N1, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp16(l.M2, (rB + 24) & 31), rrp16(l.N2, (rB + 24) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    l.M2 = s2m
    l.N2 = s2n
    l.M3 = s3m
    l.N3 = s3n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M2 = (l.M2 ^ p1m) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s0m, s0n)
    l.M3 = (l.M3 ^ p2m) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s1m, s1n)
    l.M0 = (l.M0 ^ p3m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p3n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M3 = (l.M3 ^ maj) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ rrp16(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M0, l.N0, rrp16(M0, mA), rrp16(N0, mA))
    l.M0 = im
    l.N0 = in2
    var (jm, jn2) = tadd2(l.M1, l.N1, rrp16(M1, (mA + 7) & 31), rrp16(N1, (mA + 7) & 31))
    l.M1 = jm
    l.N1 = jn2
    l.M0 = (l.M0 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ rrp16(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

func ring8h_mixB(l: Lanes8h, r: i64
            , skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes8h {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M4, l.N4,
                    rrp16(l.M6, rA), rrp16(l.N6, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp16(l.M7, (rB + 3) & 31), rrp16(l.N7, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M5, l.N5,
                    rrp16(l.M7, (rA + 5) & 31), rrp16(l.N7, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp16(l.M4, (rB + 10) & 31), rrp16(l.N4, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M6, l.N6,
                    rrp16(l.M4, (rA + 10) & 31), rrp16(l.N4, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp16(l.M5, (rB + 17) & 31), rrp16(l.N5, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M7, l.N7,
                    rrp16(l.M5, (rA + 15) & 31), rrp16(l.N5, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp16(l.M6, (rB + 24) & 31), rrp16(l.N6, (rB + 24) & 31))
    l.M4 = s0m
    l.N4 = s0n
    l.M5 = s1m
    l.N5 = s1n
    l.M6 = s2m
    l.N6 = s2n
    l.M7 = s3m
    l.N7 = s3n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M5 = (l.M5 ^ p0m) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M6 = (l.M6 ^ p1m) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s0m, s0n)
    l.M7 = (l.M7 ^ p2m) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s1m, s1n)
    l.M4 = (l.M4 ^ p3m) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ p3n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M7 = (l.M7 ^ maj) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ rrp16(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M4, l.N4, rrp16(M0, mA), rrp16(N0, mA))
    l.M4 = im
    l.N4 = in2
    var (jm, jn2) = tadd2(l.M5, l.N5, rrp16(M1, (mA + 7) & 31), rrp16(N1, (mA + 7) & 31))
    l.M5 = jm
    l.N5 = jn2
    l.M4 = (l.M4 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ rrp16(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

func ring8h_mixF(l: Lanes8h, r: i64
            , skey: i64
            ) -> Lanes8h {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0,
                    rrp16(l.M2, rA), rrp16(l.N2, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp16(l.M3, (rB + 3) & 31), rrp16(l.N3, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1,
                    rrp16(l.M3, (rA + 5) & 31), rrp16(l.N3, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp16(l.M4, (rB + 10) & 31), rrp16(l.N4, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M2, l.N2,
                    rrp16(l.M4, (rA + 10) & 31), rrp16(l.N4, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp16(l.M5, (rB + 17) & 31), rrp16(l.N5, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M3, l.N3,
                    rrp16(l.M5, (rA + 15) & 31), rrp16(l.N5, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp16(l.M6, (rB + 24) & 31), rrp16(l.N6, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M4, l.N4,
                    rrp16(l.M6, (rA + 20) & 31), rrp16(l.N6, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp16(l.M7, (rB + 31) & 31), rrp16(l.N7, (rB + 31) & 31))
    var (q5m, q5n) = tadd2(l.M5, l.N5,
                    rrp16(l.M7, (rA + 25) & 31), rrp16(l.N7, (rA + 25) & 31))
    var (s5m, s5n) = tadd2(q5m, q5n,
                    rrp16(l.M0, (rB + 6) & 31), rrp16(l.N0, (rB + 6) & 31))
    var (q6m, q6n) = tadd2(l.M6, l.N6,
                    rrp16(l.M0, (rA + 30) & 31), rrp16(l.N0, (rA + 30) & 31))
    var (s6m, s6n) = tadd2(q6m, q6n,
                    rrp16(l.M1, (rB + 13) & 31), rrp16(l.N1, (rB + 13) & 31))
    var (q7m, q7n) = tadd2(l.M7, l.N7,
                    rrp16(l.M1, (rA + 3) & 31), rrp16(l.N1, (rA + 3) & 31))
    var (s7m, s7n) = tadd2(q7m, q7n,
                    rrp16(l.M2, (rB + 20) & 31), rrp16(l.N2, (rB + 20) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    l.M2 = s2m
    l.N2 = s2n
    l.M3 = s3m
    l.N3 = s3n
    l.M4 = s4m
    l.N4 = s4n
    l.M5 = s5m
    l.N5 = s5n
    l.M6 = s6m
    l.N6 = s6n
    l.M7 = s7m
    l.N7 = s7n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M2 = (l.M2 ^ p1m) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M3 = (l.M3 ^ p2m) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s5m, s5n)
    l.M4 = (l.M4 ^ p3m) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s6m, s6n)
    l.M5 = (l.M5 ^ p4m) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ p4n) & 0xFFFFFFFF
    var (p5m, p5n) = tmul2(s5m, s5n, s7m, s7n)
    l.M6 = (l.M6 ^ p5m) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ p5n) & 0xFFFFFFFF
    var (p6m, p6n) = tmul2(s6m, s6n, s0m, s0n)
    l.M7 = (l.M7 ^ p6m) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ p6n) & 0xFFFFFFFF
    var (p7m, p7n) = tmul2(s7m, s7n, s1m, s1n)
    l.M0 = (l.M0 ^ p7m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p7n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M7 = (l.M7 ^ maj) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ rrp16(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    return l
}

func absorb8h(l: Lanes8h, Pw: Planes16, skey: i64) -> Lanes8h {
    var w: i64 = 0
    while w < 16 {
        var pv: i64 = 0
        if w == 0 {
            pv = Pw.w0
        } else if w == 1 {
            pv = Pw.w1
        } else if w == 2 {
            pv = Pw.w2
        } else if w == 3 {
            pv = Pw.w3
        } else if w == 4 {
            pv = Pw.w4
        } else if w == 5 {
            pv = Pw.w5
        } else if w == 6 {
            pv = Pw.w6
        } else if w == 7 {
            pv = Pw.w7
        } else if w == 8 {
            pv = Pw.w8
        } else if w == 9 {
            pv = Pw.w9
        } else if w == 10 {
            pv = Pw.w10
        } else if w == 11 {
            pv = Pw.w11
        } else if w == 12 {
            pv = Pw.w12
        } else if w == 13 {
            pv = Pw.w13
        } else if w == 14 {
            pv = Pw.w14
        } else {
            pv = Pw.w15
        }
        if pv != 0 {
            var a = (w * 5 + ((skey >> (w & 7)) & 7)) & 31
            var an = w % 8
            var v = rrp16(pv, a)
            var v2 = rrp16(pv, a + 17)
            if an == 0 {
                var (t0m, t0n) = tadd2(l.M0, l.N0, v, v2)
                l.M0 = t0m & 0xFFFFFFFF
                l.N0 = t0n & 0xFFFFFFFF
            } else if an == 1 {
                var (t1m, t1n) = tadd2(l.M1, l.N1, v, v2)
                l.M1 = t1m & 0xFFFFFFFF
                l.N1 = t1n & 0xFFFFFFFF
            } else if an == 2 {
                var (t2m, t2n) = tadd2(l.M2, l.N2, v, v2)
                l.M2 = t2m & 0xFFFFFFFF
                l.N2 = t2n & 0xFFFFFFFF
            } else if an == 3 {
                var (t3m, t3n) = tadd2(l.M3, l.N3, v, v2)
                l.M3 = t3m & 0xFFFFFFFF
                l.N3 = t3n & 0xFFFFFFFF
            } else if an == 4 {
                var (t4m, t4n) = tadd2(l.M4, l.N4, v, v2)
                l.M4 = t4m & 0xFFFFFFFF
                l.N4 = t4n & 0xFFFFFFFF
            } else if an == 5 {
                var (t5m, t5n) = tadd2(l.M5, l.N5, v, v2)
                l.M5 = t5m & 0xFFFFFFFF
                l.N5 = t5n & 0xFFFFFFFF
            } else if an == 6 {
                var (t6m, t6n) = tadd2(l.M6, l.N6, v, v2)
                l.M6 = t6m & 0xFFFFFFFF
                l.N6 = t6n & 0xFFFFFFFF
            } else {
                var (t7m, t7n) = tadd2(l.M7, l.N7, v, v2)
                l.M7 = t7m & 0xFFFFFFFF
                l.N7 = t7n & 0xFFFFFFFF
            }
        }
        w = w + 1
    }
    return l
}

func fin_synth8h(h: ref table<i64>) {
    var l = Lanes8h()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp16(h[1], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp16(h[2], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp16(h[3], 7)
    l.M3 = h[3] & 0xFFFFFFFF
    l.N3 = rrp16(h[4], 7)
    l.M4 = h[4] & 0xFFFFFFFF
    l.N4 = rrp16(h[5], 7)
    l.M5 = h[5] & 0xFFFFFFFF
    l.N5 = rrp16(h[6], 7)
    l.M6 = h[6] & 0xFFFFFFFF
    l.N6 = rrp16(h[7], 7)
    l.M7 = h[7] & 0xFFFFFFFF
    l.N7 = rrp16(h[0], 7)
    var sf: i64 = 0
    while sf < 4 {
        l = ring8h_mixF(l, sf, 0x13579BDF)
        sf = sf + 1
    }
    h[0] = (l.M0 ^ rrp16(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (l.M1 ^ rrp16(l.N1, 5)) & 0xFFFFFFFF
    h[2] = (l.M2 ^ rrp16(l.N2, 10)) & 0xFFFFFFFF
    h[3] = (l.M3 ^ rrp16(l.N3, 15)) & 0xFFFFFFFF
    h[4] = (l.M4 ^ rrp16(l.N4, 20)) & 0xFFFFFFFF
    h[5] = (l.M5 ^ rrp16(l.N5, 25)) & 0xFFFFFFFF
    h[6] = (l.M6 ^ rrp16(l.N6, 30)) & 0xFFFFFFFF
    h[7] = (l.M7 ^ rrp16(l.N7, 3)) & 0xFFFFFFFF
}

// W=8 r 半宽单块压缩（r 半宽，R=8）
pub func compress_w8h(h: ref table<i64>, msg: string, pos: i64, nbytes: i64,
            t_lo: i64, t_hi: i64, last: bool,
            iv: table<i64>, rcon: table<i64>, R: i64) {
    var (M0, N0, M1, N1, Pw, skey) = w48_planes_skey(msg, pos, nbytes)
    var l = Lanes8h()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp16(h[4], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp16(h[5], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp16(h[6], 7)
    l.M3 = h[3] & 0xFFFFFFFF
    l.N3 = rrp16(h[7], 7)
    l.M4 = h[4] & 0xFFFFFFFF
    l.N4 = rrp16(h[0], 7)
    l.M5 = h[5] & 0xFFFFFFFF
    l.N5 = rrp16(h[1], 7)
    l.M6 = h[6] & 0xFFFFFFFF
    l.N6 = rrp16(h[2], 7)
    l.M7 = h[7] & 0xFFFFFFFF
    l.N7 = rrp16(h[3], 7)
    l.M0 = (l.M0 ^ (iv[0] & 0xFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (iv[4] & 0xFFFF)) & 0xFFFFFFFF
    l.M1 = (l.M1 ^ (iv[1] & 0xFFFF)) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ (iv[5] & 0xFFFF)) & 0xFFFFFFFF
    l.M2 = (l.M2 ^ (iv[2] & 0xFFFF)) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ (iv[6] & 0xFFFF)) & 0xFFFFFFFF
    l.M3 = (l.M3 ^ (iv[3] & 0xFFFF)) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ (iv[7] & 0xFFFF)) & 0xFFFFFFFF
    l.M4 = (l.M4 ^ (iv[4] & 0xFFFF)) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ (iv[0] & 0xFFFF)) & 0xFFFFFFFF
    l.M5 = (l.M5 ^ (iv[5] & 0xFFFF)) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ (iv[1] & 0xFFFF)) & 0xFFFFFFFF
    l.M6 = (l.M6 ^ (iv[6] & 0xFFFF)) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ (iv[2] & 0xFFFF)) & 0xFFFFFFFF
    l.M7 = (l.M7 ^ (iv[7] & 0xFFFF)) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ (iv[3] & 0xFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (t_lo & 0xFFFF)) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ (t_hi & 0xFFFF)) & 0xFFFFFFFF
    if last {
        l.N4 = (l.N4 ^ 0xFFFFFFFF) & 0xFFFFFFFF
    }
    l = absorb8h(l, Pw, skey)   // F1-2：位平面吸收（IV/计数器混入之后、轮循环之前，每块一次）
    var mA: i64 = 0
    var mC: i64 = 0
    var r: i64 = 0
    while r < R {
        mA = (r * 5 + ((skey >> 6) & 7)) & 31
        mC = (r * 7 + ((skey >> 12) & 7)) & 31
        l = ring8h_mixA(l, r, skey, M0, N0, M1, N1, mA, rcon, r)
        l = ring8h_mixB(l, r, skey, M0, N0, M1, N1, mC, rcon, (r + 8) & 15)
        r = r + 1
    }
    h[0] = (h[0] ^ l.M0 ^ rrp16(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (h[1] ^ l.M1 ^ rrp16(l.N1, 3)) & 0xFFFFFFFF
    h[2] = (h[2] ^ l.M2 ^ rrp16(l.N2, 6)) & 0xFFFFFFFF
    h[3] = (h[3] ^ l.M3 ^ rrp16(l.N3, 9)) & 0xFFFFFFFF
    h[4] = (h[4] ^ l.M4 ^ rrp16(l.N4, 12)) & 0xFFFFFFFF
    h[5] = (h[5] ^ l.M5 ^ rrp16(l.N5, 15)) & 0xFFFFFFFF
    h[6] = (h[6] ^ l.M6 ^ rrp16(l.N6, 18)) & 0xFFFFFFFF
    h[7] = (h[7] ^ l.M7 ^ rrp16(l.N7, 21)) & 0xFFFFFFFF
    fin_synth8h(h)
}

// ============================================================================
// W=15 双轨特化内核（r 半宽；轨A lanes[0..8)、轨B lanes[8..15)，LA=8）——
//   语义与通用 ring_mix 双轨（8<=W<16）逐式一致：轨A mA/rcon_idx=r、轨B mC/rcon_idx=(r+8)&15。
// ============================================================================
struct Lanes15h {
    var M0: i64 = 0
    var N0: i64 = 0
    var M1: i64 = 0
    var N1: i64 = 0
    var M2: i64 = 0
    var N2: i64 = 0
    var M3: i64 = 0
    var N3: i64 = 0
    var M4: i64 = 0
    var N4: i64 = 0
    var M5: i64 = 0
    var N5: i64 = 0
    var M6: i64 = 0
    var N6: i64 = 0
    var M7: i64 = 0
    var N7: i64 = 0
    var M8: i64 = 0
    var N8: i64 = 0
    var M9: i64 = 0
    var N9: i64 = 0
    var M10: i64 = 0
    var N10: i64 = 0
    var M11: i64 = 0
    var N11: i64 = 0
    var M12: i64 = 0
    var N12: i64 = 0
    var M13: i64 = 0
    var N13: i64 = 0
    var M14: i64 = 0
    var N14: i64 = 0
}

func ring15h_mixA(l: Lanes15h, r: i64
            , skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes15h {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0,
                    rrp16(l.M2, rA), rrp16(l.N2, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp16(l.M3, (rB + 3) & 31), rrp16(l.N3, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1,
                    rrp16(l.M3, (rA + 5) & 31), rrp16(l.N3, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp16(l.M4, (rB + 10) & 31), rrp16(l.N4, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M2, l.N2,
                    rrp16(l.M4, (rA + 10) & 31), rrp16(l.N4, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp16(l.M5, (rB + 17) & 31), rrp16(l.N5, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M3, l.N3,
                    rrp16(l.M5, (rA + 15) & 31), rrp16(l.N5, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp16(l.M6, (rB + 24) & 31), rrp16(l.N6, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M4, l.N4,
                    rrp16(l.M6, (rA + 20) & 31), rrp16(l.N6, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp16(l.M7, (rB + 31) & 31), rrp16(l.N7, (rB + 31) & 31))
    var (q5m, q5n) = tadd2(l.M5, l.N5,
                    rrp16(l.M7, (rA + 25) & 31), rrp16(l.N7, (rA + 25) & 31))
    var (s5m, s5n) = tadd2(q5m, q5n,
                    rrp16(l.M0, (rB + 6) & 31), rrp16(l.N0, (rB + 6) & 31))
    var (q6m, q6n) = tadd2(l.M6, l.N6,
                    rrp16(l.M0, (rA + 30) & 31), rrp16(l.N0, (rA + 30) & 31))
    var (s6m, s6n) = tadd2(q6m, q6n,
                    rrp16(l.M1, (rB + 13) & 31), rrp16(l.N1, (rB + 13) & 31))
    var (q7m, q7n) = tadd2(l.M7, l.N7,
                    rrp16(l.M1, (rA + 3) & 31), rrp16(l.N1, (rA + 3) & 31))
    var (s7m, s7n) = tadd2(q7m, q7n,
                    rrp16(l.M2, (rB + 20) & 31), rrp16(l.N2, (rB + 20) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    l.M2 = s2m
    l.N2 = s2n
    l.M3 = s3m
    l.N3 = s3n
    l.M4 = s4m
    l.N4 = s4n
    l.M5 = s5m
    l.N5 = s5n
    l.M6 = s6m
    l.N6 = s6n
    l.M7 = s7m
    l.N7 = s7n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M2 = (l.M2 ^ p1m) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M3 = (l.M3 ^ p2m) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s5m, s5n)
    l.M4 = (l.M4 ^ p3m) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s6m, s6n)
    l.M5 = (l.M5 ^ p4m) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ p4n) & 0xFFFFFFFF
    var (p5m, p5n) = tmul2(s5m, s5n, s7m, s7n)
    l.M6 = (l.M6 ^ p5m) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ p5n) & 0xFFFFFFFF
    var (p6m, p6n) = tmul2(s6m, s6n, s0m, s0n)
    l.M7 = (l.M7 ^ p6m) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ p6n) & 0xFFFFFFFF
    var (p7m, p7n) = tmul2(s7m, s7n, s1m, s1n)
    l.M0 = (l.M0 ^ p7m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p7n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M7 = (l.M7 ^ maj) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ rrp16(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M0, l.N0, rrp16(M0, mA), rrp16(N0, mA))
    l.M0 = im
    l.N0 = in2
    var (jm, jn2) = tadd2(l.M1, l.N1, rrp16(M1, (mA + 7) & 31), rrp16(N1, (mA + 7) & 31))
    l.M1 = jm
    l.N1 = jn2
    l.M0 = (l.M0 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ rrp16(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

func ring15h_mixB(l: Lanes15h, r: i64
            , skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes15h {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M8, l.N8,
                    rrp16(l.M10, rA), rrp16(l.N10, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp16(l.M11, (rB + 3) & 31), rrp16(l.N11, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M9, l.N9,
                    rrp16(l.M11, (rA + 5) & 31), rrp16(l.N11, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp16(l.M12, (rB + 10) & 31), rrp16(l.N12, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M10, l.N10,
                    rrp16(l.M12, (rA + 10) & 31), rrp16(l.N12, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp16(l.M13, (rB + 17) & 31), rrp16(l.N13, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M11, l.N11,
                    rrp16(l.M13, (rA + 15) & 31), rrp16(l.N13, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp16(l.M14, (rB + 24) & 31), rrp16(l.N14, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M12, l.N12,
                    rrp16(l.M14, (rA + 20) & 31), rrp16(l.N14, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp16(l.M8, (rB + 31) & 31), rrp16(l.N8, (rB + 31) & 31))
    var (q5m, q5n) = tadd2(l.M13, l.N13,
                    rrp16(l.M8, (rA + 25) & 31), rrp16(l.N8, (rA + 25) & 31))
    var (s5m, s5n) = tadd2(q5m, q5n,
                    rrp16(l.M9, (rB + 6) & 31), rrp16(l.N9, (rB + 6) & 31))
    var (q6m, q6n) = tadd2(l.M14, l.N14,
                    rrp16(l.M9, (rA + 30) & 31), rrp16(l.N9, (rA + 30) & 31))
    var (s6m, s6n) = tadd2(q6m, q6n,
                    rrp16(l.M10, (rB + 13) & 31), rrp16(l.N10, (rB + 13) & 31))
    l.M8 = s0m
    l.N8 = s0n
    l.M9 = s1m
    l.N9 = s1n
    l.M10 = s2m
    l.N10 = s2n
    l.M11 = s3m
    l.N11 = s3n
    l.M12 = s4m
    l.N12 = s4n
    l.M13 = s5m
    l.N13 = s5n
    l.M14 = s6m
    l.N14 = s6n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M9 = (l.M9 ^ p0m) & 0xFFFFFFFF
    l.N9 = (l.N9 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M10 = (l.M10 ^ p1m) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M11 = (l.M11 ^ p2m) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s5m, s5n)
    l.M12 = (l.M12 ^ p3m) & 0xFFFFFFFF
    l.N12 = (l.N12 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s6m, s6n)
    l.M13 = (l.M13 ^ p4m) & 0xFFFFFFFF
    l.N13 = (l.N13 ^ p4n) & 0xFFFFFFFF
    var (p5m, p5n) = tmul2(s5m, s5n, s0m, s0n)
    l.M14 = (l.M14 ^ p5m) & 0xFFFFFFFF
    l.N14 = (l.N14 ^ p5n) & 0xFFFFFFFF
    var (p6m, p6n) = tmul2(s6m, s6n, s1m, s1n)
    l.M8 = (l.M8 ^ p6m) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ p6n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M14 = (l.M14 ^ maj) & 0xFFFFFFFF
    l.N14 = (l.N14 ^ rrp16(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M8, l.N8, rrp16(M0, mA), rrp16(N0, mA))
    l.M8 = im
    l.N8 = in2
    var (jm, jn2) = tadd2(l.M9, l.N9, rrp16(M1, (mA + 7) & 31), rrp16(N1, (mA + 7) & 31))
    l.M9 = jm
    l.N9 = jn2
    l.M8 = (l.M8 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N14 = (l.N14 ^ rrp16(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

func ring15h_mixF(l: Lanes15h, r: i64
            , skey: i64
            ) -> Lanes15h {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0,
                    rrp16(l.M2, rA), rrp16(l.N2, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp16(l.M3, (rB + 3) & 31), rrp16(l.N3, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1,
                    rrp16(l.M3, (rA + 5) & 31), rrp16(l.N3, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp16(l.M4, (rB + 10) & 31), rrp16(l.N4, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M2, l.N2,
                    rrp16(l.M4, (rA + 10) & 31), rrp16(l.N4, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp16(l.M5, (rB + 17) & 31), rrp16(l.N5, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M3, l.N3,
                    rrp16(l.M5, (rA + 15) & 31), rrp16(l.N5, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp16(l.M6, (rB + 24) & 31), rrp16(l.N6, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M4, l.N4,
                    rrp16(l.M6, (rA + 20) & 31), rrp16(l.N6, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp16(l.M7, (rB + 31) & 31), rrp16(l.N7, (rB + 31) & 31))
    var (q5m, q5n) = tadd2(l.M5, l.N5,
                    rrp16(l.M7, (rA + 25) & 31), rrp16(l.N7, (rA + 25) & 31))
    var (s5m, s5n) = tadd2(q5m, q5n,
                    rrp16(l.M8, (rB + 6) & 31), rrp16(l.N8, (rB + 6) & 31))
    var (q6m, q6n) = tadd2(l.M6, l.N6,
                    rrp16(l.M8, (rA + 30) & 31), rrp16(l.N8, (rA + 30) & 31))
    var (s6m, s6n) = tadd2(q6m, q6n,
                    rrp16(l.M9, (rB + 13) & 31), rrp16(l.N9, (rB + 13) & 31))
    var (q7m, q7n) = tadd2(l.M7, l.N7,
                    rrp16(l.M9, (rA + 3) & 31), rrp16(l.N9, (rA + 3) & 31))
    var (s7m, s7n) = tadd2(q7m, q7n,
                    rrp16(l.M10, (rB + 20) & 31), rrp16(l.N10, (rB + 20) & 31))
    var (q8m, q8n) = tadd2(l.M8, l.N8,
                    rrp16(l.M10, (rA + 8) & 31), rrp16(l.N10, (rA + 8) & 31))
    var (s8m, s8n) = tadd2(q8m, q8n,
                    rrp16(l.M11, (rB + 27) & 31), rrp16(l.N11, (rB + 27) & 31))
    var (q9m, q9n) = tadd2(l.M9, l.N9,
                    rrp16(l.M11, (rA + 13) & 31), rrp16(l.N11, (rA + 13) & 31))
    var (s9m, s9n) = tadd2(q9m, q9n,
                    rrp16(l.M12, (rB + 2) & 31), rrp16(l.N12, (rB + 2) & 31))
    var (q10m, q10n) = tadd2(l.M10, l.N10,
                    rrp16(l.M12, (rA + 18) & 31), rrp16(l.N12, (rA + 18) & 31))
    var (s10m, s10n) = tadd2(q10m, q10n,
                    rrp16(l.M13, (rB + 9) & 31), rrp16(l.N13, (rB + 9) & 31))
    var (q11m, q11n) = tadd2(l.M11, l.N11,
                    rrp16(l.M13, (rA + 23) & 31), rrp16(l.N13, (rA + 23) & 31))
    var (s11m, s11n) = tadd2(q11m, q11n,
                    rrp16(l.M14, (rB + 16) & 31), rrp16(l.N14, (rB + 16) & 31))
    var (q12m, q12n) = tadd2(l.M12, l.N12,
                    rrp16(l.M14, (rA + 28) & 31), rrp16(l.N14, (rA + 28) & 31))
    var (s12m, s12n) = tadd2(q12m, q12n,
                    rrp16(l.M0, (rB + 23) & 31), rrp16(l.N0, (rB + 23) & 31))
    var (q13m, q13n) = tadd2(l.M13, l.N13,
                    rrp16(l.M0, (rA + 1) & 31), rrp16(l.N0, (rA + 1) & 31))
    var (s13m, s13n) = tadd2(q13m, q13n,
                    rrp16(l.M1, (rB + 30) & 31), rrp16(l.N1, (rB + 30) & 31))
    var (q14m, q14n) = tadd2(l.M14, l.N14,
                    rrp16(l.M1, (rA + 6) & 31), rrp16(l.N1, (rA + 6) & 31))
    var (s14m, s14n) = tadd2(q14m, q14n,
                    rrp16(l.M2, (rB + 5) & 31), rrp16(l.N2, (rB + 5) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    l.M2 = s2m
    l.N2 = s2n
    l.M3 = s3m
    l.N3 = s3n
    l.M4 = s4m
    l.N4 = s4n
    l.M5 = s5m
    l.N5 = s5n
    l.M6 = s6m
    l.N6 = s6n
    l.M7 = s7m
    l.N7 = s7n
    l.M8 = s8m
    l.N8 = s8n
    l.M9 = s9m
    l.N9 = s9n
    l.M10 = s10m
    l.N10 = s10n
    l.M11 = s11m
    l.N11 = s11n
    l.M12 = s12m
    l.N12 = s12n
    l.M13 = s13m
    l.N13 = s13n
    l.M14 = s14m
    l.N14 = s14n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M2 = (l.M2 ^ p1m) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M3 = (l.M3 ^ p2m) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s5m, s5n)
    l.M4 = (l.M4 ^ p3m) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s6m, s6n)
    l.M5 = (l.M5 ^ p4m) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ p4n) & 0xFFFFFFFF
    var (p5m, p5n) = tmul2(s5m, s5n, s7m, s7n)
    l.M6 = (l.M6 ^ p5m) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ p5n) & 0xFFFFFFFF
    var (p6m, p6n) = tmul2(s6m, s6n, s8m, s8n)
    l.M7 = (l.M7 ^ p6m) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ p6n) & 0xFFFFFFFF
    var (p7m, p7n) = tmul2(s7m, s7n, s9m, s9n)
    l.M8 = (l.M8 ^ p7m) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ p7n) & 0xFFFFFFFF
    var (p8m, p8n) = tmul2(s8m, s8n, s10m, s10n)
    l.M9 = (l.M9 ^ p8m) & 0xFFFFFFFF
    l.N9 = (l.N9 ^ p8n) & 0xFFFFFFFF
    var (p9m, p9n) = tmul2(s9m, s9n, s11m, s11n)
    l.M10 = (l.M10 ^ p9m) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ p9n) & 0xFFFFFFFF
    var (p10m, p10n) = tmul2(s10m, s10n, s12m, s12n)
    l.M11 = (l.M11 ^ p10m) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ p10n) & 0xFFFFFFFF
    var (p11m, p11n) = tmul2(s11m, s11n, s13m, s13n)
    l.M12 = (l.M12 ^ p11m) & 0xFFFFFFFF
    l.N12 = (l.N12 ^ p11n) & 0xFFFFFFFF
    var (p12m, p12n) = tmul2(s12m, s12n, s14m, s14n)
    l.M13 = (l.M13 ^ p12m) & 0xFFFFFFFF
    l.N13 = (l.N13 ^ p12n) & 0xFFFFFFFF
    var (p13m, p13n) = tmul2(s13m, s13n, s0m, s0n)
    l.M14 = (l.M14 ^ p13m) & 0xFFFFFFFF
    l.N14 = (l.N14 ^ p13n) & 0xFFFFFFFF
    var (p14m, p14n) = tmul2(s14m, s14n, s1m, s1n)
    l.M0 = (l.M0 ^ p14m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p14n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M14 = (l.M14 ^ maj) & 0xFFFFFFFF
    l.N14 = (l.N14 ^ rrp16(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    return l
}

func absorb15h(l: Lanes15h, Pw: Planes16, skey: i64) -> Lanes15h {
    var w: i64 = 0
    while w < 16 {
        var pv: i64 = 0
        if w == 0 {
            pv = Pw.w0
        } else if w == 1 {
            pv = Pw.w1
        } else if w == 2 {
            pv = Pw.w2
        } else if w == 3 {
            pv = Pw.w3
        } else if w == 4 {
            pv = Pw.w4
        } else if w == 5 {
            pv = Pw.w5
        } else if w == 6 {
            pv = Pw.w6
        } else if w == 7 {
            pv = Pw.w7
        } else if w == 8 {
            pv = Pw.w8
        } else if w == 9 {
            pv = Pw.w9
        } else if w == 10 {
            pv = Pw.w10
        } else if w == 11 {
            pv = Pw.w11
        } else if w == 12 {
            pv = Pw.w12
        } else if w == 13 {
            pv = Pw.w13
        } else if w == 14 {
            pv = Pw.w14
        } else {
            pv = Pw.w15
        }
        if pv != 0 {
            var a = (w * 5 + ((skey >> (w & 7)) & 7)) & 31
            var an = w % 15
            var v = rrp16(pv, a)
            var v2 = rrp16(pv, a + 17)
            if an == 0 {
                var (t0m, t0n) = tadd2(l.M0, l.N0, v, v2)
                l.M0 = t0m & 0xFFFFFFFF
                l.N0 = t0n & 0xFFFFFFFF
            } else if an == 1 {
                var (t1m, t1n) = tadd2(l.M1, l.N1, v, v2)
                l.M1 = t1m & 0xFFFFFFFF
                l.N1 = t1n & 0xFFFFFFFF
            } else if an == 2 {
                var (t2m, t2n) = tadd2(l.M2, l.N2, v, v2)
                l.M2 = t2m & 0xFFFFFFFF
                l.N2 = t2n & 0xFFFFFFFF
            } else if an == 3 {
                var (t3m, t3n) = tadd2(l.M3, l.N3, v, v2)
                l.M3 = t3m & 0xFFFFFFFF
                l.N3 = t3n & 0xFFFFFFFF
            } else if an == 4 {
                var (t4m, t4n) = tadd2(l.M4, l.N4, v, v2)
                l.M4 = t4m & 0xFFFFFFFF
                l.N4 = t4n & 0xFFFFFFFF
            } else if an == 5 {
                var (t5m, t5n) = tadd2(l.M5, l.N5, v, v2)
                l.M5 = t5m & 0xFFFFFFFF
                l.N5 = t5n & 0xFFFFFFFF
            } else if an == 6 {
                var (t6m, t6n) = tadd2(l.M6, l.N6, v, v2)
                l.M6 = t6m & 0xFFFFFFFF
                l.N6 = t6n & 0xFFFFFFFF
            } else if an == 7 {
                var (t7m, t7n) = tadd2(l.M7, l.N7, v, v2)
                l.M7 = t7m & 0xFFFFFFFF
                l.N7 = t7n & 0xFFFFFFFF
            } else if an == 8 {
                var (t8m, t8n) = tadd2(l.M8, l.N8, v, v2)
                l.M8 = t8m & 0xFFFFFFFF
                l.N8 = t8n & 0xFFFFFFFF
            } else if an == 9 {
                var (t9m, t9n) = tadd2(l.M9, l.N9, v, v2)
                l.M9 = t9m & 0xFFFFFFFF
                l.N9 = t9n & 0xFFFFFFFF
            } else if an == 10 {
                var (t10m, t10n) = tadd2(l.M10, l.N10, v, v2)
                l.M10 = t10m & 0xFFFFFFFF
                l.N10 = t10n & 0xFFFFFFFF
            } else if an == 11 {
                var (t11m, t11n) = tadd2(l.M11, l.N11, v, v2)
                l.M11 = t11m & 0xFFFFFFFF
                l.N11 = t11n & 0xFFFFFFFF
            } else if an == 12 {
                var (t12m, t12n) = tadd2(l.M12, l.N12, v, v2)
                l.M12 = t12m & 0xFFFFFFFF
                l.N12 = t12n & 0xFFFFFFFF
            } else if an == 13 {
                var (t13m, t13n) = tadd2(l.M13, l.N13, v, v2)
                l.M13 = t13m & 0xFFFFFFFF
                l.N13 = t13n & 0xFFFFFFFF
            } else {
                var (t14m, t14n) = tadd2(l.M14, l.N14, v, v2)
                l.M14 = t14m & 0xFFFFFFFF
                l.N14 = t14n & 0xFFFFFFFF
            }
        }
        w = w + 1
    }
    return l
}

func fin_synth15h(h: ref table<i64>) {
    var l = Lanes15h()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp16(h[1], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp16(h[2], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp16(h[3], 7)
    l.M3 = h[3] & 0xFFFFFFFF
    l.N3 = rrp16(h[4], 7)
    l.M4 = h[4] & 0xFFFFFFFF
    l.N4 = rrp16(h[5], 7)
    l.M5 = h[5] & 0xFFFFFFFF
    l.N5 = rrp16(h[6], 7)
    l.M6 = h[6] & 0xFFFFFFFF
    l.N6 = rrp16(h[7], 7)
    l.M7 = h[7] & 0xFFFFFFFF
    l.N7 = rrp16(h[8], 7)
    l.M8 = h[8] & 0xFFFFFFFF
    l.N8 = rrp16(h[9], 7)
    l.M9 = h[9] & 0xFFFFFFFF
    l.N9 = rrp16(h[10], 7)
    l.M10 = h[10] & 0xFFFFFFFF
    l.N10 = rrp16(h[11], 7)
    l.M11 = h[11] & 0xFFFFFFFF
    l.N11 = rrp16(h[12], 7)
    l.M12 = h[12] & 0xFFFFFFFF
    l.N12 = rrp16(h[13], 7)
    l.M13 = h[13] & 0xFFFFFFFF
    l.N13 = rrp16(h[14], 7)
    l.M14 = h[14] & 0xFFFFFFFF
    l.N14 = rrp16(h[0], 7)
    var sf: i64 = 0
    while sf < 4 {
        l = ring15h_mixF(l, sf, 0x13579BDF)
        sf = sf + 1
    }
    h[0] = (l.M0 ^ rrp16(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (l.M1 ^ rrp16(l.N1, 5)) & 0xFFFFFFFF
    h[2] = (l.M2 ^ rrp16(l.N2, 10)) & 0xFFFFFFFF
    h[3] = (l.M3 ^ rrp16(l.N3, 15)) & 0xFFFFFFFF
    h[4] = (l.M4 ^ rrp16(l.N4, 20)) & 0xFFFFFFFF
    h[5] = (l.M5 ^ rrp16(l.N5, 25)) & 0xFFFFFFFF
    h[6] = (l.M6 ^ rrp16(l.N6, 30)) & 0xFFFFFFFF
    h[7] = (l.M7 ^ rrp16(l.N7, 3)) & 0xFFFFFFFF
    h[8] = (l.M8 ^ rrp16(l.N8, 8)) & 0xFFFFFFFF
    h[9] = (l.M9 ^ rrp16(l.N9, 13)) & 0xFFFFFFFF
    h[10] = (l.M10 ^ rrp16(l.N10, 18)) & 0xFFFFFFFF
    h[11] = (l.M11 ^ rrp16(l.N11, 23)) & 0xFFFFFFFF
    h[12] = (l.M12 ^ rrp16(l.N12, 28)) & 0xFFFFFFFF
    h[13] = (l.M13 ^ rrp16(l.N13, 1)) & 0xFFFFFFFF
    h[14] = (l.M14 ^ rrp16(l.N14, 6)) & 0xFFFFFFFF
}

// W=15 r 半宽单块压缩（r 半宽，R=8）
pub func compress_w15h(h: ref table<i64>, msg: string, pos: i64, nbytes: i64,
            t_lo: i64, t_hi: i64, last: bool,
            iv: table<i64>, rcon: table<i64>, R: i64) {
    var (M0, N0, M1, N1, Pw, skey) = w48_planes_skey(msg, pos, nbytes)
    var l = Lanes15h()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp16(h[7], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp16(h[8], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp16(h[9], 7)
    l.M3 = h[3] & 0xFFFFFFFF
    l.N3 = rrp16(h[10], 7)
    l.M4 = h[4] & 0xFFFFFFFF
    l.N4 = rrp16(h[11], 7)
    l.M5 = h[5] & 0xFFFFFFFF
    l.N5 = rrp16(h[12], 7)
    l.M6 = h[6] & 0xFFFFFFFF
    l.N6 = rrp16(h[13], 7)
    l.M7 = h[7] & 0xFFFFFFFF
    l.N7 = rrp16(h[14], 7)
    l.M8 = h[8] & 0xFFFFFFFF
    l.N8 = rrp16(h[0], 7)
    l.M9 = h[9] & 0xFFFFFFFF
    l.N9 = rrp16(h[1], 7)
    l.M10 = h[10] & 0xFFFFFFFF
    l.N10 = rrp16(h[2], 7)
    l.M11 = h[11] & 0xFFFFFFFF
    l.N11 = rrp16(h[3], 7)
    l.M12 = h[12] & 0xFFFFFFFF
    l.N12 = rrp16(h[4], 7)
    l.M13 = h[13] & 0xFFFFFFFF
    l.N13 = rrp16(h[5], 7)
    l.M14 = h[14] & 0xFFFFFFFF
    l.N14 = rrp16(h[6], 7)
    l.M0 = (l.M0 ^ (iv[0] & 0xFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (iv[4] & 0xFFFF)) & 0xFFFFFFFF
    l.M1 = (l.M1 ^ (iv[1] & 0xFFFF)) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ (iv[5] & 0xFFFF)) & 0xFFFFFFFF
    l.M2 = (l.M2 ^ (iv[2] & 0xFFFF)) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ (iv[6] & 0xFFFF)) & 0xFFFFFFFF
    l.M3 = (l.M3 ^ (iv[3] & 0xFFFF)) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ (iv[7] & 0xFFFF)) & 0xFFFFFFFF
    l.M4 = (l.M4 ^ (iv[4] & 0xFFFF)) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ (iv[0] & 0xFFFF)) & 0xFFFFFFFF
    l.M5 = (l.M5 ^ (iv[5] & 0xFFFF)) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ (iv[1] & 0xFFFF)) & 0xFFFFFFFF
    l.M6 = (l.M6 ^ (iv[6] & 0xFFFF)) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ (iv[2] & 0xFFFF)) & 0xFFFFFFFF
    l.M7 = (l.M7 ^ (iv[7] & 0xFFFF)) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ (iv[3] & 0xFFFF)) & 0xFFFFFFFF
    l.M8 = (l.M8 ^ (iv[0] & 0xFFFF)) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ (iv[4] & 0xFFFF)) & 0xFFFFFFFF
    l.M9 = (l.M9 ^ (iv[1] & 0xFFFF)) & 0xFFFFFFFF
    l.N9 = (l.N9 ^ (iv[5] & 0xFFFF)) & 0xFFFFFFFF
    l.M10 = (l.M10 ^ (iv[2] & 0xFFFF)) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ (iv[6] & 0xFFFF)) & 0xFFFFFFFF
    l.M11 = (l.M11 ^ (iv[3] & 0xFFFF)) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ (iv[7] & 0xFFFF)) & 0xFFFFFFFF
    l.M12 = (l.M12 ^ (iv[4] & 0xFFFF)) & 0xFFFFFFFF
    l.N12 = (l.N12 ^ (iv[0] & 0xFFFF)) & 0xFFFFFFFF
    l.M13 = (l.M13 ^ (iv[5] & 0xFFFF)) & 0xFFFFFFFF
    l.N13 = (l.N13 ^ (iv[1] & 0xFFFF)) & 0xFFFFFFFF
    l.M14 = (l.M14 ^ (iv[6] & 0xFFFF)) & 0xFFFFFFFF
    l.N14 = (l.N14 ^ (iv[2] & 0xFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (t_lo & 0xFFFF)) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ (t_hi & 0xFFFF)) & 0xFFFFFFFF
    if last {
        l.N7 = (l.N7 ^ 0xFFFFFFFF) & 0xFFFFFFFF
    }
    l = absorb15h(l, Pw, skey)   // F1-2：位平面吸收（IV/计数器混入之后、轮循环之前，每块一次）
    var mA: i64 = 0
    var mC: i64 = 0
    var r: i64 = 0
    while r < R {
        mA = (r * 5 + ((skey >> 6) & 7)) & 31
        mC = (r * 7 + ((skey >> 12) & 7)) & 31
        l = ring15h_mixA(l, r, skey, M0, N0, M1, N1, mA, rcon, r)
        l = ring15h_mixB(l, r, skey, M0, N0, M1, N1, mC, rcon, (r + 8) & 15)
        r = r + 1
    }
    h[0] = (h[0] ^ l.M0 ^ rrp16(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (h[1] ^ l.M1 ^ rrp16(l.N1, 3)) & 0xFFFFFFFF
    h[2] = (h[2] ^ l.M2 ^ rrp16(l.N2, 6)) & 0xFFFFFFFF
    h[3] = (h[3] ^ l.M3 ^ rrp16(l.N3, 9)) & 0xFFFFFFFF
    h[4] = (h[4] ^ l.M4 ^ rrp16(l.N4, 12)) & 0xFFFFFFFF
    h[5] = (h[5] ^ l.M5 ^ rrp16(l.N5, 15)) & 0xFFFFFFFF
    h[6] = (h[6] ^ l.M6 ^ rrp16(l.N6, 18)) & 0xFFFFFFFF
    h[7] = (h[7] ^ l.M7 ^ rrp16(l.N7, 21)) & 0xFFFFFFFF
    h[8] = (h[8] ^ l.M8 ^ rrp16(l.N8, 24)) & 0xFFFFFFFF
    h[9] = (h[9] ^ l.M9 ^ rrp16(l.N9, 27)) & 0xFFFFFFFF
    h[10] = (h[10] ^ l.M10 ^ rrp16(l.N10, 30)) & 0xFFFFFFFF
    h[11] = (h[11] ^ l.M11 ^ rrp16(l.N11, 1)) & 0xFFFFFFFF
    h[12] = (h[12] ^ l.M12 ^ rrp16(l.N12, 4)) & 0xFFFFFFFF
    h[13] = (h[13] ^ l.M13 ^ rrp16(l.N13, 7)) & 0xFFFFFFFF
    h[14] = (h[14] ^ l.M14 ^ rrp16(l.N14, 10)) & 0xFFFFFFFF
    fin_synth15h(h)
}
// === W=16 全宽双轨特化内核（f，n=88/92/96/128/144）——轨A lanes[0..8)、轨B lanes[8..16)；R=12 ===
struct Lanes16 {
    var M0: i64 = 0
    var N0: i64 = 0
    var M1: i64 = 0
    var N1: i64 = 0
    var M2: i64 = 0
    var N2: i64 = 0
    var M3: i64 = 0
    var N3: i64 = 0
    var M4: i64 = 0
    var N4: i64 = 0
    var M5: i64 = 0
    var N5: i64 = 0
    var M6: i64 = 0
    var N6: i64 = 0
    var M7: i64 = 0
    var N7: i64 = 0
    var M8: i64 = 0
    var N8: i64 = 0
    var M9: i64 = 0
    var N9: i64 = 0
    var M10: i64 = 0
    var N10: i64 = 0
    var M11: i64 = 0
    var N11: i64 = 0
    var M12: i64 = 0
    var N12: i64 = 0
    var M13: i64 = 0
    var N13: i64 = 0
    var M14: i64 = 0
    var N14: i64 = 0
    var M15: i64 = 0
    var N15: i64 = 0
}

func ring16_mixA(l: Lanes16, r: i64
            , skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes16 {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0,
                    rrp(l.M2, rA), rrp(l.N2, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp(l.M3, (rB + 3) & 31), rrp(l.N3, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1,
                    rrp(l.M3, (rA + 5) & 31), rrp(l.N3, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp(l.M4, (rB + 10) & 31), rrp(l.N4, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M2, l.N2,
                    rrp(l.M4, (rA + 10) & 31), rrp(l.N4, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp(l.M5, (rB + 17) & 31), rrp(l.N5, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M3, l.N3,
                    rrp(l.M5, (rA + 15) & 31), rrp(l.N5, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp(l.M6, (rB + 24) & 31), rrp(l.N6, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M4, l.N4,
                    rrp(l.M6, (rA + 20) & 31), rrp(l.N6, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp(l.M7, (rB + 31) & 31), rrp(l.N7, (rB + 31) & 31))
    var (q5m, q5n) = tadd2(l.M5, l.N5,
                    rrp(l.M7, (rA + 25) & 31), rrp(l.N7, (rA + 25) & 31))
    var (s5m, s5n) = tadd2(q5m, q5n,
                    rrp(l.M0, (rB + 6) & 31), rrp(l.N0, (rB + 6) & 31))
    var (q6m, q6n) = tadd2(l.M6, l.N6,
                    rrp(l.M0, (rA + 30) & 31), rrp(l.N0, (rA + 30) & 31))
    var (s6m, s6n) = tadd2(q6m, q6n,
                    rrp(l.M1, (rB + 13) & 31), rrp(l.N1, (rB + 13) & 31))
    var (q7m, q7n) = tadd2(l.M7, l.N7,
                    rrp(l.M1, (rA + 3) & 31), rrp(l.N1, (rA + 3) & 31))
    var (s7m, s7n) = tadd2(q7m, q7n,
                    rrp(l.M2, (rB + 20) & 31), rrp(l.N2, (rB + 20) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    l.M2 = s2m
    l.N2 = s2n
    l.M3 = s3m
    l.N3 = s3n
    l.M4 = s4m
    l.N4 = s4n
    l.M5 = s5m
    l.N5 = s5n
    l.M6 = s6m
    l.N6 = s6n
    l.M7 = s7m
    l.N7 = s7n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M2 = (l.M2 ^ p1m) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M3 = (l.M3 ^ p2m) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s5m, s5n)
    l.M4 = (l.M4 ^ p3m) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s6m, s6n)
    l.M5 = (l.M5 ^ p4m) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ p4n) & 0xFFFFFFFF
    var (p5m, p5n) = tmul2(s5m, s5n, s7m, s7n)
    l.M6 = (l.M6 ^ p5m) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ p5n) & 0xFFFFFFFF
    var (p6m, p6n) = tmul2(s6m, s6n, s0m, s0n)
    l.M7 = (l.M7 ^ p6m) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ p6n) & 0xFFFFFFFF
    var (p7m, p7n) = tmul2(s7m, s7n, s1m, s1n)
    l.M0 = (l.M0 ^ p7m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p7n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M7 = (l.M7 ^ maj) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M0, l.N0, rrp(M0, mA), rrp(N0, mA))
    l.M0 = im
    l.N0 = in2
    var (jm, jn2) = tadd2(l.M1, l.N1, rrp(M1, (mA + 7) & 31), rrp(N1, (mA + 7) & 31))
    l.M1 = jm
    l.N1 = jn2
    l.M0 = (l.M0 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ rrp(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

func ring16_mixB(l: Lanes16, r: i64
            , skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes16 {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M8, l.N8,
                    rrp(l.M10, rA), rrp(l.N10, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp(l.M11, (rB + 3) & 31), rrp(l.N11, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M9, l.N9,
                    rrp(l.M11, (rA + 5) & 31), rrp(l.N11, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp(l.M12, (rB + 10) & 31), rrp(l.N12, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M10, l.N10,
                    rrp(l.M12, (rA + 10) & 31), rrp(l.N12, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp(l.M13, (rB + 17) & 31), rrp(l.N13, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M11, l.N11,
                    rrp(l.M13, (rA + 15) & 31), rrp(l.N13, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp(l.M14, (rB + 24) & 31), rrp(l.N14, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M12, l.N12,
                    rrp(l.M14, (rA + 20) & 31), rrp(l.N14, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp(l.M15, (rB + 31) & 31), rrp(l.N15, (rB + 31) & 31))
    var (q5m, q5n) = tadd2(l.M13, l.N13,
                    rrp(l.M15, (rA + 25) & 31), rrp(l.N15, (rA + 25) & 31))
    var (s5m, s5n) = tadd2(q5m, q5n,
                    rrp(l.M8, (rB + 6) & 31), rrp(l.N8, (rB + 6) & 31))
    var (q6m, q6n) = tadd2(l.M14, l.N14,
                    rrp(l.M8, (rA + 30) & 31), rrp(l.N8, (rA + 30) & 31))
    var (s6m, s6n) = tadd2(q6m, q6n,
                    rrp(l.M9, (rB + 13) & 31), rrp(l.N9, (rB + 13) & 31))
    var (q7m, q7n) = tadd2(l.M15, l.N15,
                    rrp(l.M9, (rA + 3) & 31), rrp(l.N9, (rA + 3) & 31))
    var (s7m, s7n) = tadd2(q7m, q7n,
                    rrp(l.M10, (rB + 20) & 31), rrp(l.N10, (rB + 20) & 31))
    l.M8 = s0m
    l.N8 = s0n
    l.M9 = s1m
    l.N9 = s1n
    l.M10 = s2m
    l.N10 = s2n
    l.M11 = s3m
    l.N11 = s3n
    l.M12 = s4m
    l.N12 = s4n
    l.M13 = s5m
    l.N13 = s5n
    l.M14 = s6m
    l.N14 = s6n
    l.M15 = s7m
    l.N15 = s7n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M9 = (l.M9 ^ p0m) & 0xFFFFFFFF
    l.N9 = (l.N9 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M10 = (l.M10 ^ p1m) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M11 = (l.M11 ^ p2m) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s5m, s5n)
    l.M12 = (l.M12 ^ p3m) & 0xFFFFFFFF
    l.N12 = (l.N12 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s6m, s6n)
    l.M13 = (l.M13 ^ p4m) & 0xFFFFFFFF
    l.N13 = (l.N13 ^ p4n) & 0xFFFFFFFF
    var (p5m, p5n) = tmul2(s5m, s5n, s7m, s7n)
    l.M14 = (l.M14 ^ p5m) & 0xFFFFFFFF
    l.N14 = (l.N14 ^ p5n) & 0xFFFFFFFF
    var (p6m, p6n) = tmul2(s6m, s6n, s0m, s0n)
    l.M15 = (l.M15 ^ p6m) & 0xFFFFFFFF
    l.N15 = (l.N15 ^ p6n) & 0xFFFFFFFF
    var (p7m, p7n) = tmul2(s7m, s7n, s1m, s1n)
    l.M8 = (l.M8 ^ p7m) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ p7n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M15 = (l.M15 ^ maj) & 0xFFFFFFFF
    l.N15 = (l.N15 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M8, l.N8, rrp(M0, mA), rrp(N0, mA))
    l.M8 = im
    l.N8 = in2
    var (jm, jn2) = tadd2(l.M9, l.N9, rrp(M1, (mA + 7) & 31), rrp(N1, (mA + 7) & 31))
    l.M9 = jm
    l.N9 = jn2
    l.M8 = (l.M8 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N15 = (l.N15 ^ rrp(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

func ring16_mixF(l: Lanes16, r: i64
            , skey: i64
            ) -> Lanes16 {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0,
                    rrp(l.M2, rA), rrp(l.N2, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp(l.M3, (rB + 3) & 31), rrp(l.N3, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1,
                    rrp(l.M3, (rA + 5) & 31), rrp(l.N3, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp(l.M4, (rB + 10) & 31), rrp(l.N4, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M2, l.N2,
                    rrp(l.M4, (rA + 10) & 31), rrp(l.N4, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp(l.M5, (rB + 17) & 31), rrp(l.N5, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M3, l.N3,
                    rrp(l.M5, (rA + 15) & 31), rrp(l.N5, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp(l.M6, (rB + 24) & 31), rrp(l.N6, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M4, l.N4,
                    rrp(l.M6, (rA + 20) & 31), rrp(l.N6, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp(l.M7, (rB + 31) & 31), rrp(l.N7, (rB + 31) & 31))
    var (q5m, q5n) = tadd2(l.M5, l.N5,
                    rrp(l.M7, (rA + 25) & 31), rrp(l.N7, (rA + 25) & 31))
    var (s5m, s5n) = tadd2(q5m, q5n,
                    rrp(l.M8, (rB + 6) & 31), rrp(l.N8, (rB + 6) & 31))
    var (q6m, q6n) = tadd2(l.M6, l.N6,
                    rrp(l.M8, (rA + 30) & 31), rrp(l.N8, (rA + 30) & 31))
    var (s6m, s6n) = tadd2(q6m, q6n,
                    rrp(l.M9, (rB + 13) & 31), rrp(l.N9, (rB + 13) & 31))
    var (q7m, q7n) = tadd2(l.M7, l.N7,
                    rrp(l.M9, (rA + 3) & 31), rrp(l.N9, (rA + 3) & 31))
    var (s7m, s7n) = tadd2(q7m, q7n,
                    rrp(l.M10, (rB + 20) & 31), rrp(l.N10, (rB + 20) & 31))
    var (q8m, q8n) = tadd2(l.M8, l.N8,
                    rrp(l.M10, (rA + 8) & 31), rrp(l.N10, (rA + 8) & 31))
    var (s8m, s8n) = tadd2(q8m, q8n,
                    rrp(l.M11, (rB + 27) & 31), rrp(l.N11, (rB + 27) & 31))
    var (q9m, q9n) = tadd2(l.M9, l.N9,
                    rrp(l.M11, (rA + 13) & 31), rrp(l.N11, (rA + 13) & 31))
    var (s9m, s9n) = tadd2(q9m, q9n,
                    rrp(l.M12, (rB + 2) & 31), rrp(l.N12, (rB + 2) & 31))
    var (q10m, q10n) = tadd2(l.M10, l.N10,
                    rrp(l.M12, (rA + 18) & 31), rrp(l.N12, (rA + 18) & 31))
    var (s10m, s10n) = tadd2(q10m, q10n,
                    rrp(l.M13, (rB + 9) & 31), rrp(l.N13, (rB + 9) & 31))
    var (q11m, q11n) = tadd2(l.M11, l.N11,
                    rrp(l.M13, (rA + 23) & 31), rrp(l.N13, (rA + 23) & 31))
    var (s11m, s11n) = tadd2(q11m, q11n,
                    rrp(l.M14, (rB + 16) & 31), rrp(l.N14, (rB + 16) & 31))
    var (q12m, q12n) = tadd2(l.M12, l.N12,
                    rrp(l.M14, (rA + 28) & 31), rrp(l.N14, (rA + 28) & 31))
    var (s12m, s12n) = tadd2(q12m, q12n,
                    rrp(l.M15, (rB + 23) & 31), rrp(l.N15, (rB + 23) & 31))
    var (q13m, q13n) = tadd2(l.M13, l.N13,
                    rrp(l.M15, (rA + 1) & 31), rrp(l.N15, (rA + 1) & 31))
    var (s13m, s13n) = tadd2(q13m, q13n,
                    rrp(l.M0, (rB + 30) & 31), rrp(l.N0, (rB + 30) & 31))
    var (q14m, q14n) = tadd2(l.M14, l.N14,
                    rrp(l.M0, (rA + 6) & 31), rrp(l.N0, (rA + 6) & 31))
    var (s14m, s14n) = tadd2(q14m, q14n,
                    rrp(l.M1, (rB + 5) & 31), rrp(l.N1, (rB + 5) & 31))
    var (q15m, q15n) = tadd2(l.M15, l.N15,
                    rrp(l.M1, (rA + 11) & 31), rrp(l.N1, (rA + 11) & 31))
    var (s15m, s15n) = tadd2(q15m, q15n,
                    rrp(l.M2, (rB + 12) & 31), rrp(l.N2, (rB + 12) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    l.M2 = s2m
    l.N2 = s2n
    l.M3 = s3m
    l.N3 = s3n
    l.M4 = s4m
    l.N4 = s4n
    l.M5 = s5m
    l.N5 = s5n
    l.M6 = s6m
    l.N6 = s6n
    l.M7 = s7m
    l.N7 = s7n
    l.M8 = s8m
    l.N8 = s8n
    l.M9 = s9m
    l.N9 = s9n
    l.M10 = s10m
    l.N10 = s10n
    l.M11 = s11m
    l.N11 = s11n
    l.M12 = s12m
    l.N12 = s12n
    l.M13 = s13m
    l.N13 = s13n
    l.M14 = s14m
    l.N14 = s14n
    l.M15 = s15m
    l.N15 = s15n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M2 = (l.M2 ^ p1m) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M3 = (l.M3 ^ p2m) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s5m, s5n)
    l.M4 = (l.M4 ^ p3m) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s6m, s6n)
    l.M5 = (l.M5 ^ p4m) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ p4n) & 0xFFFFFFFF
    var (p5m, p5n) = tmul2(s5m, s5n, s7m, s7n)
    l.M6 = (l.M6 ^ p5m) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ p5n) & 0xFFFFFFFF
    var (p6m, p6n) = tmul2(s6m, s6n, s8m, s8n)
    l.M7 = (l.M7 ^ p6m) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ p6n) & 0xFFFFFFFF
    var (p7m, p7n) = tmul2(s7m, s7n, s9m, s9n)
    l.M8 = (l.M8 ^ p7m) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ p7n) & 0xFFFFFFFF
    var (p8m, p8n) = tmul2(s8m, s8n, s10m, s10n)
    l.M9 = (l.M9 ^ p8m) & 0xFFFFFFFF
    l.N9 = (l.N9 ^ p8n) & 0xFFFFFFFF
    var (p9m, p9n) = tmul2(s9m, s9n, s11m, s11n)
    l.M10 = (l.M10 ^ p9m) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ p9n) & 0xFFFFFFFF
    var (p10m, p10n) = tmul2(s10m, s10n, s12m, s12n)
    l.M11 = (l.M11 ^ p10m) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ p10n) & 0xFFFFFFFF
    var (p11m, p11n) = tmul2(s11m, s11n, s13m, s13n)
    l.M12 = (l.M12 ^ p11m) & 0xFFFFFFFF
    l.N12 = (l.N12 ^ p11n) & 0xFFFFFFFF
    var (p12m, p12n) = tmul2(s12m, s12n, s14m, s14n)
    l.M13 = (l.M13 ^ p12m) & 0xFFFFFFFF
    l.N13 = (l.N13 ^ p12n) & 0xFFFFFFFF
    var (p13m, p13n) = tmul2(s13m, s13n, s15m, s15n)
    l.M14 = (l.M14 ^ p13m) & 0xFFFFFFFF
    l.N14 = (l.N14 ^ p13n) & 0xFFFFFFFF
    var (p14m, p14n) = tmul2(s14m, s14n, s0m, s0n)
    l.M15 = (l.M15 ^ p14m) & 0xFFFFFFFF
    l.N15 = (l.N15 ^ p14n) & 0xFFFFFFFF
    var (p15m, p15n) = tmul2(s15m, s15n, s1m, s1n)
    l.M0 = (l.M0 ^ p15m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p15n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M15 = (l.M15 ^ maj) & 0xFFFFFFFF
    l.N15 = (l.N15 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    return l
}

func absorb16(l: Lanes16, Pw: Planes16, skey: i64) -> Lanes16 {
    var w: i64 = 0
    while w < 16 {
        var pv: i64 = 0
        if w == 0 {
            pv = Pw.w0
        } else if w == 1 {
            pv = Pw.w1
        } else if w == 2 {
            pv = Pw.w2
        } else if w == 3 {
            pv = Pw.w3
        } else if w == 4 {
            pv = Pw.w4
        } else if w == 5 {
            pv = Pw.w5
        } else if w == 6 {
            pv = Pw.w6
        } else if w == 7 {
            pv = Pw.w7
        } else if w == 8 {
            pv = Pw.w8
        } else if w == 9 {
            pv = Pw.w9
        } else if w == 10 {
            pv = Pw.w10
        } else if w == 11 {
            pv = Pw.w11
        } else if w == 12 {
            pv = Pw.w12
        } else if w == 13 {
            pv = Pw.w13
        } else if w == 14 {
            pv = Pw.w14
        } else {
            pv = Pw.w15
        }
        if pv != 0 {
            var a = (w * 5 + ((skey >> (w & 7)) & 7)) & 31
            var an = w % 16
            var v = rrp(pv, a)
            var v2 = rrp(pv, a + 17)
            if an == 0 {
                var (t0m, t0n) = tadd2(l.M0, l.N0, v, v2)
                l.M0 = t0m & 0xFFFFFFFF
                l.N0 = t0n & 0xFFFFFFFF
            } else if an == 1 {
                var (t1m, t1n) = tadd2(l.M1, l.N1, v, v2)
                l.M1 = t1m & 0xFFFFFFFF
                l.N1 = t1n & 0xFFFFFFFF
            } else if an == 2 {
                var (t2m, t2n) = tadd2(l.M2, l.N2, v, v2)
                l.M2 = t2m & 0xFFFFFFFF
                l.N2 = t2n & 0xFFFFFFFF
            } else if an == 3 {
                var (t3m, t3n) = tadd2(l.M3, l.N3, v, v2)
                l.M3 = t3m & 0xFFFFFFFF
                l.N3 = t3n & 0xFFFFFFFF
            } else if an == 4 {
                var (t4m, t4n) = tadd2(l.M4, l.N4, v, v2)
                l.M4 = t4m & 0xFFFFFFFF
                l.N4 = t4n & 0xFFFFFFFF
            } else if an == 5 {
                var (t5m, t5n) = tadd2(l.M5, l.N5, v, v2)
                l.M5 = t5m & 0xFFFFFFFF
                l.N5 = t5n & 0xFFFFFFFF
            } else if an == 6 {
                var (t6m, t6n) = tadd2(l.M6, l.N6, v, v2)
                l.M6 = t6m & 0xFFFFFFFF
                l.N6 = t6n & 0xFFFFFFFF
            } else if an == 7 {
                var (t7m, t7n) = tadd2(l.M7, l.N7, v, v2)
                l.M7 = t7m & 0xFFFFFFFF
                l.N7 = t7n & 0xFFFFFFFF
            } else if an == 8 {
                var (t8m, t8n) = tadd2(l.M8, l.N8, v, v2)
                l.M8 = t8m & 0xFFFFFFFF
                l.N8 = t8n & 0xFFFFFFFF
            } else if an == 9 {
                var (t9m, t9n) = tadd2(l.M9, l.N9, v, v2)
                l.M9 = t9m & 0xFFFFFFFF
                l.N9 = t9n & 0xFFFFFFFF
            } else if an == 10 {
                var (t10m, t10n) = tadd2(l.M10, l.N10, v, v2)
                l.M10 = t10m & 0xFFFFFFFF
                l.N10 = t10n & 0xFFFFFFFF
            } else if an == 11 {
                var (t11m, t11n) = tadd2(l.M11, l.N11, v, v2)
                l.M11 = t11m & 0xFFFFFFFF
                l.N11 = t11n & 0xFFFFFFFF
            } else if an == 12 {
                var (t12m, t12n) = tadd2(l.M12, l.N12, v, v2)
                l.M12 = t12m & 0xFFFFFFFF
                l.N12 = t12n & 0xFFFFFFFF
            } else if an == 13 {
                var (t13m, t13n) = tadd2(l.M13, l.N13, v, v2)
                l.M13 = t13m & 0xFFFFFFFF
                l.N13 = t13n & 0xFFFFFFFF
            } else if an == 14 {
                var (t14m, t14n) = tadd2(l.M14, l.N14, v, v2)
                l.M14 = t14m & 0xFFFFFFFF
                l.N14 = t14n & 0xFFFFFFFF
            } else {
                var (t15m, t15n) = tadd2(l.M15, l.N15, v, v2)
                l.M15 = t15m & 0xFFFFFFFF
                l.N15 = t15n & 0xFFFFFFFF
            }
        }
        w = w + 1
    }
    return l
}

func fin_synth16(h: ref table<i64>) {
    var l = Lanes16()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp(h[1], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp(h[2], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp(h[3], 7)
    l.M3 = h[3] & 0xFFFFFFFF
    l.N3 = rrp(h[4], 7)
    l.M4 = h[4] & 0xFFFFFFFF
    l.N4 = rrp(h[5], 7)
    l.M5 = h[5] & 0xFFFFFFFF
    l.N5 = rrp(h[6], 7)
    l.M6 = h[6] & 0xFFFFFFFF
    l.N6 = rrp(h[7], 7)
    l.M7 = h[7] & 0xFFFFFFFF
    l.N7 = rrp(h[8], 7)
    l.M8 = h[8] & 0xFFFFFFFF
    l.N8 = rrp(h[9], 7)
    l.M9 = h[9] & 0xFFFFFFFF
    l.N9 = rrp(h[10], 7)
    l.M10 = h[10] & 0xFFFFFFFF
    l.N10 = rrp(h[11], 7)
    l.M11 = h[11] & 0xFFFFFFFF
    l.N11 = rrp(h[12], 7)
    l.M12 = h[12] & 0xFFFFFFFF
    l.N12 = rrp(h[13], 7)
    l.M13 = h[13] & 0xFFFFFFFF
    l.N13 = rrp(h[14], 7)
    l.M14 = h[14] & 0xFFFFFFFF
    l.N14 = rrp(h[15], 7)
    l.M15 = h[15] & 0xFFFFFFFF
    l.N15 = rrp(h[0], 7)
    var sf: i64 = 0
    while sf < 4 {
        l = ring16_mixF(l, sf, 0x13579BDF)
        sf = sf + 1
    }
    h[0] = (l.M0 ^ rrp(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (l.M1 ^ rrp(l.N1, 5)) & 0xFFFFFFFF
    h[2] = (l.M2 ^ rrp(l.N2, 10)) & 0xFFFFFFFF
    h[3] = (l.M3 ^ rrp(l.N3, 15)) & 0xFFFFFFFF
    h[4] = (l.M4 ^ rrp(l.N4, 20)) & 0xFFFFFFFF
    h[5] = (l.M5 ^ rrp(l.N5, 25)) & 0xFFFFFFFF
    h[6] = (l.M6 ^ rrp(l.N6, 30)) & 0xFFFFFFFF
    h[7] = (l.M7 ^ rrp(l.N7, 3)) & 0xFFFFFFFF
    h[8] = (l.M8 ^ rrp(l.N8, 8)) & 0xFFFFFFFF
    h[9] = (l.M9 ^ rrp(l.N9, 13)) & 0xFFFFFFFF
    h[10] = (l.M10 ^ rrp(l.N10, 18)) & 0xFFFFFFFF
    h[11] = (l.M11 ^ rrp(l.N11, 23)) & 0xFFFFFFFF
    h[12] = (l.M12 ^ rrp(l.N12, 28)) & 0xFFFFFFFF
    h[13] = (l.M13 ^ rrp(l.N13, 1)) & 0xFFFFFFFF
    h[14] = (l.M14 ^ rrp(l.N14, 6)) & 0xFFFFFFFF
    h[15] = (l.M15 ^ rrp(l.N15, 11)) & 0xFFFFFFFF
}

pub func compress_w16(h: ref table<i64>, msg: string, pos: i64, nbytes: i64,
            t_lo: i64, t_hi: i64, last: bool,
            iv: table<i64>, rcon: table<i64>, R: i64) {
    var (M0, N0, M1, N1, Pw, skey) = w48_planes_skey(msg, pos, nbytes)
    var l = Lanes16()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp(h[8], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp(h[9], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp(h[10], 7)
    l.M3 = h[3] & 0xFFFFFFFF
    l.N3 = rrp(h[11], 7)
    l.M4 = h[4] & 0xFFFFFFFF
    l.N4 = rrp(h[12], 7)
    l.M5 = h[5] & 0xFFFFFFFF
    l.N5 = rrp(h[13], 7)
    l.M6 = h[6] & 0xFFFFFFFF
    l.N6 = rrp(h[14], 7)
    l.M7 = h[7] & 0xFFFFFFFF
    l.N7 = rrp(h[15], 7)
    l.M8 = h[8] & 0xFFFFFFFF
    l.N8 = rrp(h[0], 7)
    l.M9 = h[9] & 0xFFFFFFFF
    l.N9 = rrp(h[1], 7)
    l.M10 = h[10] & 0xFFFFFFFF
    l.N10 = rrp(h[2], 7)
    l.M11 = h[11] & 0xFFFFFFFF
    l.N11 = rrp(h[3], 7)
    l.M12 = h[12] & 0xFFFFFFFF
    l.N12 = rrp(h[4], 7)
    l.M13 = h[13] & 0xFFFFFFFF
    l.N13 = rrp(h[5], 7)
    l.M14 = h[14] & 0xFFFFFFFF
    l.N14 = rrp(h[6], 7)
    l.M15 = h[15] & 0xFFFFFFFF
    l.N15 = rrp(h[7], 7)
    l.M0 = (l.M0 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M1 = (l.M1 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M2 = (l.M2 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M3 = (l.M3 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M4 = (l.M4 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M5 = (l.M5 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M6 = (l.M6 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M7 = (l.M7 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M8 = (l.M8 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M9 = (l.M9 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N9 = (l.N9 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M10 = (l.M10 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M11 = (l.M11 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M12 = (l.M12 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N12 = (l.N12 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M13 = (l.M13 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N13 = (l.N13 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M14 = (l.M14 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N14 = (l.N14 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M15 = (l.M15 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N15 = (l.N15 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (t_lo & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ (t_hi & 0xFFFFFFFF)) & 0xFFFFFFFF
    if last {
        l.N8 = (l.N8 ^ 0xFFFFFFFF) & 0xFFFFFFFF
    }
    l = absorb16(l, Pw, skey)
    var mA: i64 = 0
    var mC: i64 = 0
    var r: i64 = 0
    while r < R {
        mA = (r * 5 + ((skey >> 6) & 7)) & 31
        mC = (r * 7 + ((skey >> 12) & 7)) & 31
        l = ring16_mixA(l, r, skey, M0, N0, M1, N1, mA, rcon, r)
        l = ring16_mixB(l, r, skey, M0, N0, M1, N1, mC, rcon, (r + 8) & 15)
        r = r + 1
    }
    h[0] = (h[0] ^ l.M0 ^ rrp(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (h[1] ^ l.M1 ^ rrp(l.N1, 3)) & 0xFFFFFFFF
    h[2] = (h[2] ^ l.M2 ^ rrp(l.N2, 6)) & 0xFFFFFFFF
    h[3] = (h[3] ^ l.M3 ^ rrp(l.N3, 9)) & 0xFFFFFFFF
    h[4] = (h[4] ^ l.M4 ^ rrp(l.N4, 12)) & 0xFFFFFFFF
    h[5] = (h[5] ^ l.M5 ^ rrp(l.N5, 15)) & 0xFFFFFFFF
    h[6] = (h[6] ^ l.M6 ^ rrp(l.N6, 18)) & 0xFFFFFFFF
    h[7] = (h[7] ^ l.M7 ^ rrp(l.N7, 21)) & 0xFFFFFFFF
    h[8] = (h[8] ^ l.M8 ^ rrp(l.N8, 24)) & 0xFFFFFFFF
    h[9] = (h[9] ^ l.M9 ^ rrp(l.N9, 27)) & 0xFFFFFFFF
    h[10] = (h[10] ^ l.M10 ^ rrp(l.N10, 30)) & 0xFFFFFFFF
    h[11] = (h[11] ^ l.M11 ^ rrp(l.N11, 1)) & 0xFFFFFFFF
    h[12] = (h[12] ^ l.M12 ^ rrp(l.N12, 4)) & 0xFFFFFFFF
    h[13] = (h[13] ^ l.M13 ^ rrp(l.N13, 7)) & 0xFFFFFFFF
    h[14] = (h[14] ^ l.M14 ^ rrp(l.N14, 10)) & 0xFFFFFFFF
    h[15] = (h[15] ^ l.M15 ^ rrp(l.N15, 13)) & 0xFFFFFFFF
    fin_synth16(h)
}

// === W=17 全宽双轨特化内核（f，n=88/92/96/128/144）——轨A lanes[0..9)、轨B lanes[9..17)；R=12 ===
struct Lanes17 {
    var M0: i64 = 0
    var N0: i64 = 0
    var M1: i64 = 0
    var N1: i64 = 0
    var M2: i64 = 0
    var N2: i64 = 0
    var M3: i64 = 0
    var N3: i64 = 0
    var M4: i64 = 0
    var N4: i64 = 0
    var M5: i64 = 0
    var N5: i64 = 0
    var M6: i64 = 0
    var N6: i64 = 0
    var M7: i64 = 0
    var N7: i64 = 0
    var M8: i64 = 0
    var N8: i64 = 0
    var M9: i64 = 0
    var N9: i64 = 0
    var M10: i64 = 0
    var N10: i64 = 0
    var M11: i64 = 0
    var N11: i64 = 0
    var M12: i64 = 0
    var N12: i64 = 0
    var M13: i64 = 0
    var N13: i64 = 0
    var M14: i64 = 0
    var N14: i64 = 0
    var M15: i64 = 0
    var N15: i64 = 0
    var M16: i64 = 0
    var N16: i64 = 0
}

func ring17_mixA(l: Lanes17, r: i64
            , skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes17 {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0,
                    rrp(l.M2, rA), rrp(l.N2, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp(l.M3, (rB + 3) & 31), rrp(l.N3, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1,
                    rrp(l.M3, (rA + 5) & 31), rrp(l.N3, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp(l.M4, (rB + 10) & 31), rrp(l.N4, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M2, l.N2,
                    rrp(l.M4, (rA + 10) & 31), rrp(l.N4, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp(l.M5, (rB + 17) & 31), rrp(l.N5, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M3, l.N3,
                    rrp(l.M5, (rA + 15) & 31), rrp(l.N5, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp(l.M6, (rB + 24) & 31), rrp(l.N6, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M4, l.N4,
                    rrp(l.M6, (rA + 20) & 31), rrp(l.N6, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp(l.M7, (rB + 31) & 31), rrp(l.N7, (rB + 31) & 31))
    var (q5m, q5n) = tadd2(l.M5, l.N5,
                    rrp(l.M7, (rA + 25) & 31), rrp(l.N7, (rA + 25) & 31))
    var (s5m, s5n) = tadd2(q5m, q5n,
                    rrp(l.M8, (rB + 6) & 31), rrp(l.N8, (rB + 6) & 31))
    var (q6m, q6n) = tadd2(l.M6, l.N6,
                    rrp(l.M8, (rA + 30) & 31), rrp(l.N8, (rA + 30) & 31))
    var (s6m, s6n) = tadd2(q6m, q6n,
                    rrp(l.M0, (rB + 13) & 31), rrp(l.N0, (rB + 13) & 31))
    var (q7m, q7n) = tadd2(l.M7, l.N7,
                    rrp(l.M0, (rA + 3) & 31), rrp(l.N0, (rA + 3) & 31))
    var (s7m, s7n) = tadd2(q7m, q7n,
                    rrp(l.M1, (rB + 20) & 31), rrp(l.N1, (rB + 20) & 31))
    var (q8m, q8n) = tadd2(l.M8, l.N8,
                    rrp(l.M1, (rA + 8) & 31), rrp(l.N1, (rA + 8) & 31))
    var (s8m, s8n) = tadd2(q8m, q8n,
                    rrp(l.M2, (rB + 27) & 31), rrp(l.N2, (rB + 27) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    l.M2 = s2m
    l.N2 = s2n
    l.M3 = s3m
    l.N3 = s3n
    l.M4 = s4m
    l.N4 = s4n
    l.M5 = s5m
    l.N5 = s5n
    l.M6 = s6m
    l.N6 = s6n
    l.M7 = s7m
    l.N7 = s7n
    l.M8 = s8m
    l.N8 = s8n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M2 = (l.M2 ^ p1m) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M3 = (l.M3 ^ p2m) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s5m, s5n)
    l.M4 = (l.M4 ^ p3m) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s6m, s6n)
    l.M5 = (l.M5 ^ p4m) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ p4n) & 0xFFFFFFFF
    var (p5m, p5n) = tmul2(s5m, s5n, s7m, s7n)
    l.M6 = (l.M6 ^ p5m) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ p5n) & 0xFFFFFFFF
    var (p6m, p6n) = tmul2(s6m, s6n, s8m, s8n)
    l.M7 = (l.M7 ^ p6m) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ p6n) & 0xFFFFFFFF
    var (p7m, p7n) = tmul2(s7m, s7n, s0m, s0n)
    l.M8 = (l.M8 ^ p7m) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ p7n) & 0xFFFFFFFF
    var (p8m, p8n) = tmul2(s8m, s8n, s1m, s1n)
    l.M0 = (l.M0 ^ p8m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p8n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M8 = (l.M8 ^ maj) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M0, l.N0, rrp(M0, mA), rrp(N0, mA))
    l.M0 = im
    l.N0 = in2
    var (jm, jn2) = tadd2(l.M1, l.N1, rrp(M1, (mA + 7) & 31), rrp(N1, (mA + 7) & 31))
    l.M1 = jm
    l.N1 = jn2
    l.M0 = (l.M0 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ rrp(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

func ring17_mixB(l: Lanes17, r: i64
            , skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes17 {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M9, l.N9,
                    rrp(l.M11, rA), rrp(l.N11, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp(l.M12, (rB + 3) & 31), rrp(l.N12, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M10, l.N10,
                    rrp(l.M12, (rA + 5) & 31), rrp(l.N12, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp(l.M13, (rB + 10) & 31), rrp(l.N13, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M11, l.N11,
                    rrp(l.M13, (rA + 10) & 31), rrp(l.N13, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp(l.M14, (rB + 17) & 31), rrp(l.N14, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M12, l.N12,
                    rrp(l.M14, (rA + 15) & 31), rrp(l.N14, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp(l.M15, (rB + 24) & 31), rrp(l.N15, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M13, l.N13,
                    rrp(l.M15, (rA + 20) & 31), rrp(l.N15, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp(l.M16, (rB + 31) & 31), rrp(l.N16, (rB + 31) & 31))
    var (q5m, q5n) = tadd2(l.M14, l.N14,
                    rrp(l.M16, (rA + 25) & 31), rrp(l.N16, (rA + 25) & 31))
    var (s5m, s5n) = tadd2(q5m, q5n,
                    rrp(l.M9, (rB + 6) & 31), rrp(l.N9, (rB + 6) & 31))
    var (q6m, q6n) = tadd2(l.M15, l.N15,
                    rrp(l.M9, (rA + 30) & 31), rrp(l.N9, (rA + 30) & 31))
    var (s6m, s6n) = tadd2(q6m, q6n,
                    rrp(l.M10, (rB + 13) & 31), rrp(l.N10, (rB + 13) & 31))
    var (q7m, q7n) = tadd2(l.M16, l.N16,
                    rrp(l.M10, (rA + 3) & 31), rrp(l.N10, (rA + 3) & 31))
    var (s7m, s7n) = tadd2(q7m, q7n,
                    rrp(l.M11, (rB + 20) & 31), rrp(l.N11, (rB + 20) & 31))
    l.M9 = s0m
    l.N9 = s0n
    l.M10 = s1m
    l.N10 = s1n
    l.M11 = s2m
    l.N11 = s2n
    l.M12 = s3m
    l.N12 = s3n
    l.M13 = s4m
    l.N13 = s4n
    l.M14 = s5m
    l.N14 = s5n
    l.M15 = s6m
    l.N15 = s6n
    l.M16 = s7m
    l.N16 = s7n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M10 = (l.M10 ^ p0m) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M11 = (l.M11 ^ p1m) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M12 = (l.M12 ^ p2m) & 0xFFFFFFFF
    l.N12 = (l.N12 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s5m, s5n)
    l.M13 = (l.M13 ^ p3m) & 0xFFFFFFFF
    l.N13 = (l.N13 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s6m, s6n)
    l.M14 = (l.M14 ^ p4m) & 0xFFFFFFFF
    l.N14 = (l.N14 ^ p4n) & 0xFFFFFFFF
    var (p5m, p5n) = tmul2(s5m, s5n, s7m, s7n)
    l.M15 = (l.M15 ^ p5m) & 0xFFFFFFFF
    l.N15 = (l.N15 ^ p5n) & 0xFFFFFFFF
    var (p6m, p6n) = tmul2(s6m, s6n, s0m, s0n)
    l.M16 = (l.M16 ^ p6m) & 0xFFFFFFFF
    l.N16 = (l.N16 ^ p6n) & 0xFFFFFFFF
    var (p7m, p7n) = tmul2(s7m, s7n, s1m, s1n)
    l.M9 = (l.M9 ^ p7m) & 0xFFFFFFFF
    l.N9 = (l.N9 ^ p7n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M16 = (l.M16 ^ maj) & 0xFFFFFFFF
    l.N16 = (l.N16 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M9, l.N9, rrp(M0, mA), rrp(N0, mA))
    l.M9 = im
    l.N9 = in2
    var (jm, jn2) = tadd2(l.M10, l.N10, rrp(M1, (mA + 7) & 31), rrp(N1, (mA + 7) & 31))
    l.M10 = jm
    l.N10 = jn2
    l.M9 = (l.M9 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N16 = (l.N16 ^ rrp(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

func ring17_mixF(l: Lanes17, r: i64
            , skey: i64
            ) -> Lanes17 {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0,
                    rrp(l.M2, rA), rrp(l.N2, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp(l.M3, (rB + 3) & 31), rrp(l.N3, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1,
                    rrp(l.M3, (rA + 5) & 31), rrp(l.N3, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp(l.M4, (rB + 10) & 31), rrp(l.N4, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M2, l.N2,
                    rrp(l.M4, (rA + 10) & 31), rrp(l.N4, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp(l.M5, (rB + 17) & 31), rrp(l.N5, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M3, l.N3,
                    rrp(l.M5, (rA + 15) & 31), rrp(l.N5, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp(l.M6, (rB + 24) & 31), rrp(l.N6, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M4, l.N4,
                    rrp(l.M6, (rA + 20) & 31), rrp(l.N6, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp(l.M7, (rB + 31) & 31), rrp(l.N7, (rB + 31) & 31))
    var (q5m, q5n) = tadd2(l.M5, l.N5,
                    rrp(l.M7, (rA + 25) & 31), rrp(l.N7, (rA + 25) & 31))
    var (s5m, s5n) = tadd2(q5m, q5n,
                    rrp(l.M8, (rB + 6) & 31), rrp(l.N8, (rB + 6) & 31))
    var (q6m, q6n) = tadd2(l.M6, l.N6,
                    rrp(l.M8, (rA + 30) & 31), rrp(l.N8, (rA + 30) & 31))
    var (s6m, s6n) = tadd2(q6m, q6n,
                    rrp(l.M9, (rB + 13) & 31), rrp(l.N9, (rB + 13) & 31))
    var (q7m, q7n) = tadd2(l.M7, l.N7,
                    rrp(l.M9, (rA + 3) & 31), rrp(l.N9, (rA + 3) & 31))
    var (s7m, s7n) = tadd2(q7m, q7n,
                    rrp(l.M10, (rB + 20) & 31), rrp(l.N10, (rB + 20) & 31))
    var (q8m, q8n) = tadd2(l.M8, l.N8,
                    rrp(l.M10, (rA + 8) & 31), rrp(l.N10, (rA + 8) & 31))
    var (s8m, s8n) = tadd2(q8m, q8n,
                    rrp(l.M11, (rB + 27) & 31), rrp(l.N11, (rB + 27) & 31))
    var (q9m, q9n) = tadd2(l.M9, l.N9,
                    rrp(l.M11, (rA + 13) & 31), rrp(l.N11, (rA + 13) & 31))
    var (s9m, s9n) = tadd2(q9m, q9n,
                    rrp(l.M12, (rB + 2) & 31), rrp(l.N12, (rB + 2) & 31))
    var (q10m, q10n) = tadd2(l.M10, l.N10,
                    rrp(l.M12, (rA + 18) & 31), rrp(l.N12, (rA + 18) & 31))
    var (s10m, s10n) = tadd2(q10m, q10n,
                    rrp(l.M13, (rB + 9) & 31), rrp(l.N13, (rB + 9) & 31))
    var (q11m, q11n) = tadd2(l.M11, l.N11,
                    rrp(l.M13, (rA + 23) & 31), rrp(l.N13, (rA + 23) & 31))
    var (s11m, s11n) = tadd2(q11m, q11n,
                    rrp(l.M14, (rB + 16) & 31), rrp(l.N14, (rB + 16) & 31))
    var (q12m, q12n) = tadd2(l.M12, l.N12,
                    rrp(l.M14, (rA + 28) & 31), rrp(l.N14, (rA + 28) & 31))
    var (s12m, s12n) = tadd2(q12m, q12n,
                    rrp(l.M15, (rB + 23) & 31), rrp(l.N15, (rB + 23) & 31))
    var (q13m, q13n) = tadd2(l.M13, l.N13,
                    rrp(l.M15, (rA + 1) & 31), rrp(l.N15, (rA + 1) & 31))
    var (s13m, s13n) = tadd2(q13m, q13n,
                    rrp(l.M16, (rB + 30) & 31), rrp(l.N16, (rB + 30) & 31))
    var (q14m, q14n) = tadd2(l.M14, l.N14,
                    rrp(l.M16, (rA + 6) & 31), rrp(l.N16, (rA + 6) & 31))
    var (s14m, s14n) = tadd2(q14m, q14n,
                    rrp(l.M0, (rB + 5) & 31), rrp(l.N0, (rB + 5) & 31))
    var (q15m, q15n) = tadd2(l.M15, l.N15,
                    rrp(l.M0, (rA + 11) & 31), rrp(l.N0, (rA + 11) & 31))
    var (s15m, s15n) = tadd2(q15m, q15n,
                    rrp(l.M1, (rB + 12) & 31), rrp(l.N1, (rB + 12) & 31))
    var (q16m, q16n) = tadd2(l.M16, l.N16,
                    rrp(l.M1, (rA + 16) & 31), rrp(l.N1, (rA + 16) & 31))
    var (s16m, s16n) = tadd2(q16m, q16n,
                    rrp(l.M2, (rB + 19) & 31), rrp(l.N2, (rB + 19) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    l.M2 = s2m
    l.N2 = s2n
    l.M3 = s3m
    l.N3 = s3n
    l.M4 = s4m
    l.N4 = s4n
    l.M5 = s5m
    l.N5 = s5n
    l.M6 = s6m
    l.N6 = s6n
    l.M7 = s7m
    l.N7 = s7n
    l.M8 = s8m
    l.N8 = s8n
    l.M9 = s9m
    l.N9 = s9n
    l.M10 = s10m
    l.N10 = s10n
    l.M11 = s11m
    l.N11 = s11n
    l.M12 = s12m
    l.N12 = s12n
    l.M13 = s13m
    l.N13 = s13n
    l.M14 = s14m
    l.N14 = s14n
    l.M15 = s15m
    l.N15 = s15n
    l.M16 = s16m
    l.N16 = s16n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M2 = (l.M2 ^ p1m) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M3 = (l.M3 ^ p2m) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s5m, s5n)
    l.M4 = (l.M4 ^ p3m) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s6m, s6n)
    l.M5 = (l.M5 ^ p4m) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ p4n) & 0xFFFFFFFF
    var (p5m, p5n) = tmul2(s5m, s5n, s7m, s7n)
    l.M6 = (l.M6 ^ p5m) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ p5n) & 0xFFFFFFFF
    var (p6m, p6n) = tmul2(s6m, s6n, s8m, s8n)
    l.M7 = (l.M7 ^ p6m) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ p6n) & 0xFFFFFFFF
    var (p7m, p7n) = tmul2(s7m, s7n, s9m, s9n)
    l.M8 = (l.M8 ^ p7m) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ p7n) & 0xFFFFFFFF
    var (p8m, p8n) = tmul2(s8m, s8n, s10m, s10n)
    l.M9 = (l.M9 ^ p8m) & 0xFFFFFFFF
    l.N9 = (l.N9 ^ p8n) & 0xFFFFFFFF
    var (p9m, p9n) = tmul2(s9m, s9n, s11m, s11n)
    l.M10 = (l.M10 ^ p9m) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ p9n) & 0xFFFFFFFF
    var (p10m, p10n) = tmul2(s10m, s10n, s12m, s12n)
    l.M11 = (l.M11 ^ p10m) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ p10n) & 0xFFFFFFFF
    var (p11m, p11n) = tmul2(s11m, s11n, s13m, s13n)
    l.M12 = (l.M12 ^ p11m) & 0xFFFFFFFF
    l.N12 = (l.N12 ^ p11n) & 0xFFFFFFFF
    var (p12m, p12n) = tmul2(s12m, s12n, s14m, s14n)
    l.M13 = (l.M13 ^ p12m) & 0xFFFFFFFF
    l.N13 = (l.N13 ^ p12n) & 0xFFFFFFFF
    var (p13m, p13n) = tmul2(s13m, s13n, s15m, s15n)
    l.M14 = (l.M14 ^ p13m) & 0xFFFFFFFF
    l.N14 = (l.N14 ^ p13n) & 0xFFFFFFFF
    var (p14m, p14n) = tmul2(s14m, s14n, s16m, s16n)
    l.M15 = (l.M15 ^ p14m) & 0xFFFFFFFF
    l.N15 = (l.N15 ^ p14n) & 0xFFFFFFFF
    var (p15m, p15n) = tmul2(s15m, s15n, s0m, s0n)
    l.M16 = (l.M16 ^ p15m) & 0xFFFFFFFF
    l.N16 = (l.N16 ^ p15n) & 0xFFFFFFFF
    var (p16m, p16n) = tmul2(s16m, s16n, s1m, s1n)
    l.M0 = (l.M0 ^ p16m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p16n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M16 = (l.M16 ^ maj) & 0xFFFFFFFF
    l.N16 = (l.N16 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    return l
}

func absorb17(l: Lanes17, Pw: Planes16, skey: i64) -> Lanes17 {
    var w: i64 = 0
    while w < 16 {
        var pv: i64 = 0
        if w == 0 {
            pv = Pw.w0
        } else if w == 1 {
            pv = Pw.w1
        } else if w == 2 {
            pv = Pw.w2
        } else if w == 3 {
            pv = Pw.w3
        } else if w == 4 {
            pv = Pw.w4
        } else if w == 5 {
            pv = Pw.w5
        } else if w == 6 {
            pv = Pw.w6
        } else if w == 7 {
            pv = Pw.w7
        } else if w == 8 {
            pv = Pw.w8
        } else if w == 9 {
            pv = Pw.w9
        } else if w == 10 {
            pv = Pw.w10
        } else if w == 11 {
            pv = Pw.w11
        } else if w == 12 {
            pv = Pw.w12
        } else if w == 13 {
            pv = Pw.w13
        } else if w == 14 {
            pv = Pw.w14
        } else {
            pv = Pw.w15
        }
        if pv != 0 {
            var a = (w * 5 + ((skey >> (w & 7)) & 7)) & 31
            var an = w % 17
            var v = rrp(pv, a)
            var v2 = rrp(pv, a + 17)
            if an == 0 {
                var (t0m, t0n) = tadd2(l.M0, l.N0, v, v2)
                l.M0 = t0m & 0xFFFFFFFF
                l.N0 = t0n & 0xFFFFFFFF
            } else if an == 1 {
                var (t1m, t1n) = tadd2(l.M1, l.N1, v, v2)
                l.M1 = t1m & 0xFFFFFFFF
                l.N1 = t1n & 0xFFFFFFFF
            } else if an == 2 {
                var (t2m, t2n) = tadd2(l.M2, l.N2, v, v2)
                l.M2 = t2m & 0xFFFFFFFF
                l.N2 = t2n & 0xFFFFFFFF
            } else if an == 3 {
                var (t3m, t3n) = tadd2(l.M3, l.N3, v, v2)
                l.M3 = t3m & 0xFFFFFFFF
                l.N3 = t3n & 0xFFFFFFFF
            } else if an == 4 {
                var (t4m, t4n) = tadd2(l.M4, l.N4, v, v2)
                l.M4 = t4m & 0xFFFFFFFF
                l.N4 = t4n & 0xFFFFFFFF
            } else if an == 5 {
                var (t5m, t5n) = tadd2(l.M5, l.N5, v, v2)
                l.M5 = t5m & 0xFFFFFFFF
                l.N5 = t5n & 0xFFFFFFFF
            } else if an == 6 {
                var (t6m, t6n) = tadd2(l.M6, l.N6, v, v2)
                l.M6 = t6m & 0xFFFFFFFF
                l.N6 = t6n & 0xFFFFFFFF
            } else if an == 7 {
                var (t7m, t7n) = tadd2(l.M7, l.N7, v, v2)
                l.M7 = t7m & 0xFFFFFFFF
                l.N7 = t7n & 0xFFFFFFFF
            } else if an == 8 {
                var (t8m, t8n) = tadd2(l.M8, l.N8, v, v2)
                l.M8 = t8m & 0xFFFFFFFF
                l.N8 = t8n & 0xFFFFFFFF
            } else if an == 9 {
                var (t9m, t9n) = tadd2(l.M9, l.N9, v, v2)
                l.M9 = t9m & 0xFFFFFFFF
                l.N9 = t9n & 0xFFFFFFFF
            } else if an == 10 {
                var (t10m, t10n) = tadd2(l.M10, l.N10, v, v2)
                l.M10 = t10m & 0xFFFFFFFF
                l.N10 = t10n & 0xFFFFFFFF
            } else if an == 11 {
                var (t11m, t11n) = tadd2(l.M11, l.N11, v, v2)
                l.M11 = t11m & 0xFFFFFFFF
                l.N11 = t11n & 0xFFFFFFFF
            } else if an == 12 {
                var (t12m, t12n) = tadd2(l.M12, l.N12, v, v2)
                l.M12 = t12m & 0xFFFFFFFF
                l.N12 = t12n & 0xFFFFFFFF
            } else if an == 13 {
                var (t13m, t13n) = tadd2(l.M13, l.N13, v, v2)
                l.M13 = t13m & 0xFFFFFFFF
                l.N13 = t13n & 0xFFFFFFFF
            } else if an == 14 {
                var (t14m, t14n) = tadd2(l.M14, l.N14, v, v2)
                l.M14 = t14m & 0xFFFFFFFF
                l.N14 = t14n & 0xFFFFFFFF
            } else if an == 15 {
                var (t15m, t15n) = tadd2(l.M15, l.N15, v, v2)
                l.M15 = t15m & 0xFFFFFFFF
                l.N15 = t15n & 0xFFFFFFFF
            } else {
                var (t16m, t16n) = tadd2(l.M16, l.N16, v, v2)
                l.M16 = t16m & 0xFFFFFFFF
                l.N16 = t16n & 0xFFFFFFFF
            }
        }
        w = w + 1
    }
    return l
}

func fin_synth17(h: ref table<i64>) {
    var l = Lanes17()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp(h[1], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp(h[2], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp(h[3], 7)
    l.M3 = h[3] & 0xFFFFFFFF
    l.N3 = rrp(h[4], 7)
    l.M4 = h[4] & 0xFFFFFFFF
    l.N4 = rrp(h[5], 7)
    l.M5 = h[5] & 0xFFFFFFFF
    l.N5 = rrp(h[6], 7)
    l.M6 = h[6] & 0xFFFFFFFF
    l.N6 = rrp(h[7], 7)
    l.M7 = h[7] & 0xFFFFFFFF
    l.N7 = rrp(h[8], 7)
    l.M8 = h[8] & 0xFFFFFFFF
    l.N8 = rrp(h[9], 7)
    l.M9 = h[9] & 0xFFFFFFFF
    l.N9 = rrp(h[10], 7)
    l.M10 = h[10] & 0xFFFFFFFF
    l.N10 = rrp(h[11], 7)
    l.M11 = h[11] & 0xFFFFFFFF
    l.N11 = rrp(h[12], 7)
    l.M12 = h[12] & 0xFFFFFFFF
    l.N12 = rrp(h[13], 7)
    l.M13 = h[13] & 0xFFFFFFFF
    l.N13 = rrp(h[14], 7)
    l.M14 = h[14] & 0xFFFFFFFF
    l.N14 = rrp(h[15], 7)
    l.M15 = h[15] & 0xFFFFFFFF
    l.N15 = rrp(h[16], 7)
    l.M16 = h[16] & 0xFFFFFFFF
    l.N16 = rrp(h[0], 7)
    var sf: i64 = 0
    while sf < 4 {
        l = ring17_mixF(l, sf, 0x13579BDF)
        sf = sf + 1
    }
    h[0] = (l.M0 ^ rrp(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (l.M1 ^ rrp(l.N1, 5)) & 0xFFFFFFFF
    h[2] = (l.M2 ^ rrp(l.N2, 10)) & 0xFFFFFFFF
    h[3] = (l.M3 ^ rrp(l.N3, 15)) & 0xFFFFFFFF
    h[4] = (l.M4 ^ rrp(l.N4, 20)) & 0xFFFFFFFF
    h[5] = (l.M5 ^ rrp(l.N5, 25)) & 0xFFFFFFFF
    h[6] = (l.M6 ^ rrp(l.N6, 30)) & 0xFFFFFFFF
    h[7] = (l.M7 ^ rrp(l.N7, 3)) & 0xFFFFFFFF
    h[8] = (l.M8 ^ rrp(l.N8, 8)) & 0xFFFFFFFF
    h[9] = (l.M9 ^ rrp(l.N9, 13)) & 0xFFFFFFFF
    h[10] = (l.M10 ^ rrp(l.N10, 18)) & 0xFFFFFFFF
    h[11] = (l.M11 ^ rrp(l.N11, 23)) & 0xFFFFFFFF
    h[12] = (l.M12 ^ rrp(l.N12, 28)) & 0xFFFFFFFF
    h[13] = (l.M13 ^ rrp(l.N13, 1)) & 0xFFFFFFFF
    h[14] = (l.M14 ^ rrp(l.N14, 6)) & 0xFFFFFFFF
    h[15] = (l.M15 ^ rrp(l.N15, 11)) & 0xFFFFFFFF
    h[16] = (l.M16 ^ rrp(l.N16, 16)) & 0xFFFFFFFF
}

pub func compress_w17(h: ref table<i64>, msg: string, pos: i64, nbytes: i64,
            t_lo: i64, t_hi: i64, last: bool,
            iv: table<i64>, rcon: table<i64>, R: i64) {
    var (M0, N0, M1, N1, Pw, skey) = w48_planes_skey(msg, pos, nbytes)
    var l = Lanes17()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp(h[8], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp(h[9], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp(h[10], 7)
    l.M3 = h[3] & 0xFFFFFFFF
    l.N3 = rrp(h[11], 7)
    l.M4 = h[4] & 0xFFFFFFFF
    l.N4 = rrp(h[12], 7)
    l.M5 = h[5] & 0xFFFFFFFF
    l.N5 = rrp(h[13], 7)
    l.M6 = h[6] & 0xFFFFFFFF
    l.N6 = rrp(h[14], 7)
    l.M7 = h[7] & 0xFFFFFFFF
    l.N7 = rrp(h[15], 7)
    l.M8 = h[8] & 0xFFFFFFFF
    l.N8 = rrp(h[16], 7)
    l.M9 = h[9] & 0xFFFFFFFF
    l.N9 = rrp(h[0], 7)
    l.M10 = h[10] & 0xFFFFFFFF
    l.N10 = rrp(h[1], 7)
    l.M11 = h[11] & 0xFFFFFFFF
    l.N11 = rrp(h[2], 7)
    l.M12 = h[12] & 0xFFFFFFFF
    l.N12 = rrp(h[3], 7)
    l.M13 = h[13] & 0xFFFFFFFF
    l.N13 = rrp(h[4], 7)
    l.M14 = h[14] & 0xFFFFFFFF
    l.N14 = rrp(h[5], 7)
    l.M15 = h[15] & 0xFFFFFFFF
    l.N15 = rrp(h[6], 7)
    l.M16 = h[16] & 0xFFFFFFFF
    l.N16 = rrp(h[7], 7)
    l.M0 = (l.M0 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M1 = (l.M1 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M2 = (l.M2 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M3 = (l.M3 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M4 = (l.M4 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M5 = (l.M5 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M6 = (l.M6 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M7 = (l.M7 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M8 = (l.M8 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M9 = (l.M9 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N9 = (l.N9 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M10 = (l.M10 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M11 = (l.M11 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M12 = (l.M12 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N12 = (l.N12 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M13 = (l.M13 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N13 = (l.N13 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M14 = (l.M14 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N14 = (l.N14 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M15 = (l.M15 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N15 = (l.N15 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M16 = (l.M16 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N16 = (l.N16 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (t_lo & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ (t_hi & 0xFFFFFFFF)) & 0xFFFFFFFF
    if last {
        l.N8 = (l.N8 ^ 0xFFFFFFFF) & 0xFFFFFFFF
    }
    l = absorb17(l, Pw, skey)
    var mA: i64 = 0
    var mC: i64 = 0
    var r: i64 = 0
    while r < R {
        mA = (r * 5 + ((skey >> 6) & 7)) & 31
        mC = (r * 7 + ((skey >> 12) & 7)) & 31
        l = ring17_mixA(l, r, skey, M0, N0, M1, N1, mA, rcon, r)
        l = ring17_mixB(l, r, skey, M0, N0, M1, N1, mC, rcon, (r + 8) & 15)
        r = r + 1
    }
    h[0] = (h[0] ^ l.M0 ^ rrp(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (h[1] ^ l.M1 ^ rrp(l.N1, 3)) & 0xFFFFFFFF
    h[2] = (h[2] ^ l.M2 ^ rrp(l.N2, 6)) & 0xFFFFFFFF
    h[3] = (h[3] ^ l.M3 ^ rrp(l.N3, 9)) & 0xFFFFFFFF
    h[4] = (h[4] ^ l.M4 ^ rrp(l.N4, 12)) & 0xFFFFFFFF
    h[5] = (h[5] ^ l.M5 ^ rrp(l.N5, 15)) & 0xFFFFFFFF
    h[6] = (h[6] ^ l.M6 ^ rrp(l.N6, 18)) & 0xFFFFFFFF
    h[7] = (h[7] ^ l.M7 ^ rrp(l.N7, 21)) & 0xFFFFFFFF
    h[8] = (h[8] ^ l.M8 ^ rrp(l.N8, 24)) & 0xFFFFFFFF
    h[9] = (h[9] ^ l.M9 ^ rrp(l.N9, 27)) & 0xFFFFFFFF
    h[10] = (h[10] ^ l.M10 ^ rrp(l.N10, 30)) & 0xFFFFFFFF
    h[11] = (h[11] ^ l.M11 ^ rrp(l.N11, 1)) & 0xFFFFFFFF
    h[12] = (h[12] ^ l.M12 ^ rrp(l.N12, 4)) & 0xFFFFFFFF
    h[13] = (h[13] ^ l.M13 ^ rrp(l.N13, 7)) & 0xFFFFFFFF
    h[14] = (h[14] ^ l.M14 ^ rrp(l.N14, 10)) & 0xFFFFFFFF
    h[15] = (h[15] ^ l.M15 ^ rrp(l.N15, 13)) & 0xFFFFFFFF
    h[16] = (h[16] ^ l.M16 ^ rrp(l.N16, 16)) & 0xFFFFFFFF
    fin_synth17(h)
}

// === W=23 全宽双轨特化内核（f，n=88/92/96/128/144）——轨A lanes[0..12)、轨B lanes[12..23)；R=12 ===
struct Lanes23 {
    var M0: i64 = 0
    var N0: i64 = 0
    var M1: i64 = 0
    var N1: i64 = 0
    var M2: i64 = 0
    var N2: i64 = 0
    var M3: i64 = 0
    var N3: i64 = 0
    var M4: i64 = 0
    var N4: i64 = 0
    var M5: i64 = 0
    var N5: i64 = 0
    var M6: i64 = 0
    var N6: i64 = 0
    var M7: i64 = 0
    var N7: i64 = 0
    var M8: i64 = 0
    var N8: i64 = 0
    var M9: i64 = 0
    var N9: i64 = 0
    var M10: i64 = 0
    var N10: i64 = 0
    var M11: i64 = 0
    var N11: i64 = 0
    var M12: i64 = 0
    var N12: i64 = 0
    var M13: i64 = 0
    var N13: i64 = 0
    var M14: i64 = 0
    var N14: i64 = 0
    var M15: i64 = 0
    var N15: i64 = 0
    var M16: i64 = 0
    var N16: i64 = 0
    var M17: i64 = 0
    var N17: i64 = 0
    var M18: i64 = 0
    var N18: i64 = 0
    var M19: i64 = 0
    var N19: i64 = 0
    var M20: i64 = 0
    var N20: i64 = 0
    var M21: i64 = 0
    var N21: i64 = 0
    var M22: i64 = 0
    var N22: i64 = 0
}

func ring23_mixA(l: Lanes23, r: i64
            , skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes23 {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0,
                    rrp(l.M2, rA), rrp(l.N2, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp(l.M3, (rB + 3) & 31), rrp(l.N3, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1,
                    rrp(l.M3, (rA + 5) & 31), rrp(l.N3, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp(l.M4, (rB + 10) & 31), rrp(l.N4, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M2, l.N2,
                    rrp(l.M4, (rA + 10) & 31), rrp(l.N4, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp(l.M5, (rB + 17) & 31), rrp(l.N5, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M3, l.N3,
                    rrp(l.M5, (rA + 15) & 31), rrp(l.N5, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp(l.M6, (rB + 24) & 31), rrp(l.N6, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M4, l.N4,
                    rrp(l.M6, (rA + 20) & 31), rrp(l.N6, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp(l.M7, (rB + 31) & 31), rrp(l.N7, (rB + 31) & 31))
    var (q5m, q5n) = tadd2(l.M5, l.N5,
                    rrp(l.M7, (rA + 25) & 31), rrp(l.N7, (rA + 25) & 31))
    var (s5m, s5n) = tadd2(q5m, q5n,
                    rrp(l.M8, (rB + 6) & 31), rrp(l.N8, (rB + 6) & 31))
    var (q6m, q6n) = tadd2(l.M6, l.N6,
                    rrp(l.M8, (rA + 30) & 31), rrp(l.N8, (rA + 30) & 31))
    var (s6m, s6n) = tadd2(q6m, q6n,
                    rrp(l.M9, (rB + 13) & 31), rrp(l.N9, (rB + 13) & 31))
    var (q7m, q7n) = tadd2(l.M7, l.N7,
                    rrp(l.M9, (rA + 3) & 31), rrp(l.N9, (rA + 3) & 31))
    var (s7m, s7n) = tadd2(q7m, q7n,
                    rrp(l.M10, (rB + 20) & 31), rrp(l.N10, (rB + 20) & 31))
    var (q8m, q8n) = tadd2(l.M8, l.N8,
                    rrp(l.M10, (rA + 8) & 31), rrp(l.N10, (rA + 8) & 31))
    var (s8m, s8n) = tadd2(q8m, q8n,
                    rrp(l.M11, (rB + 27) & 31), rrp(l.N11, (rB + 27) & 31))
    var (q9m, q9n) = tadd2(l.M9, l.N9,
                    rrp(l.M11, (rA + 13) & 31), rrp(l.N11, (rA + 13) & 31))
    var (s9m, s9n) = tadd2(q9m, q9n,
                    rrp(l.M0, (rB + 2) & 31), rrp(l.N0, (rB + 2) & 31))
    var (q10m, q10n) = tadd2(l.M10, l.N10,
                    rrp(l.M0, (rA + 18) & 31), rrp(l.N0, (rA + 18) & 31))
    var (s10m, s10n) = tadd2(q10m, q10n,
                    rrp(l.M1, (rB + 9) & 31), rrp(l.N1, (rB + 9) & 31))
    var (q11m, q11n) = tadd2(l.M11, l.N11,
                    rrp(l.M1, (rA + 23) & 31), rrp(l.N1, (rA + 23) & 31))
    var (s11m, s11n) = tadd2(q11m, q11n,
                    rrp(l.M2, (rB + 16) & 31), rrp(l.N2, (rB + 16) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    l.M2 = s2m
    l.N2 = s2n
    l.M3 = s3m
    l.N3 = s3n
    l.M4 = s4m
    l.N4 = s4n
    l.M5 = s5m
    l.N5 = s5n
    l.M6 = s6m
    l.N6 = s6n
    l.M7 = s7m
    l.N7 = s7n
    l.M8 = s8m
    l.N8 = s8n
    l.M9 = s9m
    l.N9 = s9n
    l.M10 = s10m
    l.N10 = s10n
    l.M11 = s11m
    l.N11 = s11n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M2 = (l.M2 ^ p1m) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M3 = (l.M3 ^ p2m) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s5m, s5n)
    l.M4 = (l.M4 ^ p3m) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s6m, s6n)
    l.M5 = (l.M5 ^ p4m) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ p4n) & 0xFFFFFFFF
    var (p5m, p5n) = tmul2(s5m, s5n, s7m, s7n)
    l.M6 = (l.M6 ^ p5m) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ p5n) & 0xFFFFFFFF
    var (p6m, p6n) = tmul2(s6m, s6n, s8m, s8n)
    l.M7 = (l.M7 ^ p6m) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ p6n) & 0xFFFFFFFF
    var (p7m, p7n) = tmul2(s7m, s7n, s9m, s9n)
    l.M8 = (l.M8 ^ p7m) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ p7n) & 0xFFFFFFFF
    var (p8m, p8n) = tmul2(s8m, s8n, s10m, s10n)
    l.M9 = (l.M9 ^ p8m) & 0xFFFFFFFF
    l.N9 = (l.N9 ^ p8n) & 0xFFFFFFFF
    var (p9m, p9n) = tmul2(s9m, s9n, s11m, s11n)
    l.M10 = (l.M10 ^ p9m) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ p9n) & 0xFFFFFFFF
    var (p10m, p10n) = tmul2(s10m, s10n, s0m, s0n)
    l.M11 = (l.M11 ^ p10m) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ p10n) & 0xFFFFFFFF
    var (p11m, p11n) = tmul2(s11m, s11n, s1m, s1n)
    l.M0 = (l.M0 ^ p11m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p11n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M11 = (l.M11 ^ maj) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M0, l.N0, rrp(M0, mA), rrp(N0, mA))
    l.M0 = im
    l.N0 = in2
    var (jm, jn2) = tadd2(l.M1, l.N1, rrp(M1, (mA + 7) & 31), rrp(N1, (mA + 7) & 31))
    l.M1 = jm
    l.N1 = jn2
    l.M0 = (l.M0 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ rrp(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

func ring23_mixB(l: Lanes23, r: i64
            , skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes23 {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M12, l.N12,
                    rrp(l.M14, rA), rrp(l.N14, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp(l.M15, (rB + 3) & 31), rrp(l.N15, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M13, l.N13,
                    rrp(l.M15, (rA + 5) & 31), rrp(l.N15, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp(l.M16, (rB + 10) & 31), rrp(l.N16, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M14, l.N14,
                    rrp(l.M16, (rA + 10) & 31), rrp(l.N16, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp(l.M17, (rB + 17) & 31), rrp(l.N17, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M15, l.N15,
                    rrp(l.M17, (rA + 15) & 31), rrp(l.N17, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp(l.M18, (rB + 24) & 31), rrp(l.N18, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M16, l.N16,
                    rrp(l.M18, (rA + 20) & 31), rrp(l.N18, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp(l.M19, (rB + 31) & 31), rrp(l.N19, (rB + 31) & 31))
    var (q5m, q5n) = tadd2(l.M17, l.N17,
                    rrp(l.M19, (rA + 25) & 31), rrp(l.N19, (rA + 25) & 31))
    var (s5m, s5n) = tadd2(q5m, q5n,
                    rrp(l.M20, (rB + 6) & 31), rrp(l.N20, (rB + 6) & 31))
    var (q6m, q6n) = tadd2(l.M18, l.N18,
                    rrp(l.M20, (rA + 30) & 31), rrp(l.N20, (rA + 30) & 31))
    var (s6m, s6n) = tadd2(q6m, q6n,
                    rrp(l.M21, (rB + 13) & 31), rrp(l.N21, (rB + 13) & 31))
    var (q7m, q7n) = tadd2(l.M19, l.N19,
                    rrp(l.M21, (rA + 3) & 31), rrp(l.N21, (rA + 3) & 31))
    var (s7m, s7n) = tadd2(q7m, q7n,
                    rrp(l.M22, (rB + 20) & 31), rrp(l.N22, (rB + 20) & 31))
    var (q8m, q8n) = tadd2(l.M20, l.N20,
                    rrp(l.M22, (rA + 8) & 31), rrp(l.N22, (rA + 8) & 31))
    var (s8m, s8n) = tadd2(q8m, q8n,
                    rrp(l.M12, (rB + 27) & 31), rrp(l.N12, (rB + 27) & 31))
    var (q9m, q9n) = tadd2(l.M21, l.N21,
                    rrp(l.M12, (rA + 13) & 31), rrp(l.N12, (rA + 13) & 31))
    var (s9m, s9n) = tadd2(q9m, q9n,
                    rrp(l.M13, (rB + 2) & 31), rrp(l.N13, (rB + 2) & 31))
    var (q10m, q10n) = tadd2(l.M22, l.N22,
                    rrp(l.M13, (rA + 18) & 31), rrp(l.N13, (rA + 18) & 31))
    var (s10m, s10n) = tadd2(q10m, q10n,
                    rrp(l.M14, (rB + 9) & 31), rrp(l.N14, (rB + 9) & 31))
    l.M12 = s0m
    l.N12 = s0n
    l.M13 = s1m
    l.N13 = s1n
    l.M14 = s2m
    l.N14 = s2n
    l.M15 = s3m
    l.N15 = s3n
    l.M16 = s4m
    l.N16 = s4n
    l.M17 = s5m
    l.N17 = s5n
    l.M18 = s6m
    l.N18 = s6n
    l.M19 = s7m
    l.N19 = s7n
    l.M20 = s8m
    l.N20 = s8n
    l.M21 = s9m
    l.N21 = s9n
    l.M22 = s10m
    l.N22 = s10n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M13 = (l.M13 ^ p0m) & 0xFFFFFFFF
    l.N13 = (l.N13 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M14 = (l.M14 ^ p1m) & 0xFFFFFFFF
    l.N14 = (l.N14 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M15 = (l.M15 ^ p2m) & 0xFFFFFFFF
    l.N15 = (l.N15 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s5m, s5n)
    l.M16 = (l.M16 ^ p3m) & 0xFFFFFFFF
    l.N16 = (l.N16 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s6m, s6n)
    l.M17 = (l.M17 ^ p4m) & 0xFFFFFFFF
    l.N17 = (l.N17 ^ p4n) & 0xFFFFFFFF
    var (p5m, p5n) = tmul2(s5m, s5n, s7m, s7n)
    l.M18 = (l.M18 ^ p5m) & 0xFFFFFFFF
    l.N18 = (l.N18 ^ p5n) & 0xFFFFFFFF
    var (p6m, p6n) = tmul2(s6m, s6n, s8m, s8n)
    l.M19 = (l.M19 ^ p6m) & 0xFFFFFFFF
    l.N19 = (l.N19 ^ p6n) & 0xFFFFFFFF
    var (p7m, p7n) = tmul2(s7m, s7n, s9m, s9n)
    l.M20 = (l.M20 ^ p7m) & 0xFFFFFFFF
    l.N20 = (l.N20 ^ p7n) & 0xFFFFFFFF
    var (p8m, p8n) = tmul2(s8m, s8n, s10m, s10n)
    l.M21 = (l.M21 ^ p8m) & 0xFFFFFFFF
    l.N21 = (l.N21 ^ p8n) & 0xFFFFFFFF
    var (p9m, p9n) = tmul2(s9m, s9n, s0m, s0n)
    l.M22 = (l.M22 ^ p9m) & 0xFFFFFFFF
    l.N22 = (l.N22 ^ p9n) & 0xFFFFFFFF
    var (p10m, p10n) = tmul2(s10m, s10n, s1m, s1n)
    l.M12 = (l.M12 ^ p10m) & 0xFFFFFFFF
    l.N12 = (l.N12 ^ p10n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M22 = (l.M22 ^ maj) & 0xFFFFFFFF
    l.N22 = (l.N22 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M12, l.N12, rrp(M0, mA), rrp(N0, mA))
    l.M12 = im
    l.N12 = in2
    var (jm, jn2) = tadd2(l.M13, l.N13, rrp(M1, (mA + 7) & 31), rrp(N1, (mA + 7) & 31))
    l.M13 = jm
    l.N13 = jn2
    l.M12 = (l.M12 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N22 = (l.N22 ^ rrp(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

func ring23_mixF(l: Lanes23, r: i64
            , skey: i64
            ) -> Lanes23 {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0,
                    rrp(l.M2, rA), rrp(l.N2, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp(l.M3, (rB + 3) & 31), rrp(l.N3, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1,
                    rrp(l.M3, (rA + 5) & 31), rrp(l.N3, (rA + 5) & 31))
