                    rrp(l.M20, (rA + 5) & 31), rrp(l.N20, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp(l.M21, (rB + 10) & 31), rrp(l.N21, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M22, l.N22,
                    rrp(l.M21, (rA + 10) & 31), rrp(l.N21, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp(l.M22, (rB + 17) & 31), rrp(l.N22, (rB + 17) & 31))
    l.M20 = s0m
    l.N20 = s0n
    l.M21 = s1m
    l.N21 = s1n
    l.M22 = s2m
    l.N22 = s2n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M21 = (l.M21 ^ p0m) & 0xFFFFFFFF
    l.N21 = (l.N21 ^ p0n) & 0xFFFFFFFF
