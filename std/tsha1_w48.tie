    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M25 = (l.M25 ^ maj) & 0xFFFFFFFF
    l.N25 = (l.N25 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    return l
}

func absorb26x(l: Lanes26x, Pw: Planes16, skey: i64) -> Lanes26x {
    var w: i64 = 0
    while w < 16 {
        var pv: i64 = 0
        if w == 0 {
            pv = Pw.w0
        } else if w == 1 {
            pv = Pw.w1
        } else if w == 2 {
            pv = Pw.w2
        } else if w == 3 {
            pv = Pw.w3
        } else if w == 4 {
            pv = Pw.w4
        } else if w == 5 {
            pv = Pw.w5
        } else if w == 6 {
            pv = Pw.w6
        } else if w == 7 {
            pv = Pw.w7
        } else if w == 8 {
            pv = Pw.w8
        } else if w == 9 {
            pv = Pw.w9
        } else if w == 10 {
            pv = Pw.w10
        } else if w == 11 {
            pv = Pw.w11
        } else if w == 12 {
            pv = Pw.w12
        } else if w == 13 {
            pv = Pw.w13
        } else if w == 14 {
            pv = Pw.w14
        } else {
            pv = Pw.w15
        }
        if pv != 0 {
            var a = (w * 5 + ((skey >> (w & 7)) & 7)) & 31
            var an = w % 26
            var v = rrp(pv, a)
            var v2 = rrp(pv, a + 17)
            if an == 0 {
                var (t0m, t0n) = tadd2(l.M0, l.N0, v, v2)
                l.M0 = t0m & 0xFFFFFFFF
                l.N0 = t0n & 0xFFFFFFFF
            } else if an == 1 {
                var (t1m, t1n) = tadd2(l.M1, l.N1, v, v2)
                l.M1 = t1m & 0xFFFFFFFF
                l.N1 = t1n & 0xFFFFFFFF
            } else if an == 2 {
                var (t2m, t2n) = tadd2(l.M2, l.N2, v, v2)
                l.M2 = t2m & 0xFFFFFFFF
                l.N2 = t2n & 0xFFFFFFFF
            } else if an == 3 {
                var (t3m, t3n) = tadd2(l.M3, l.N3, v, v2)
                l.M3 = t3m & 0xFFFFFFFF
                l.N3 = t3n & 0xFFFFFFFF
            } else if an == 4 {
                var (t4m, t4n) = tadd2(l.M4, l.N4, v, v2)
                l.M4 = t4m & 0xFFFFFFFF
                l.N4 = t4n & 0xFFFFFFFF
            } else if an == 5 {
                var (t5m, t5n) = tadd2(l.M5, l.N5, v, v2)
                l.M5 = t5m & 0xFFFFFFFF
                l.N5 = t5n & 0xFFFFFFFF
            } else if an == 6 {
                var (t6m, t6n) = tadd2(l.M6, l.N6, v, v2)
                l.M6 = t6m & 0xFFFFFFFF
                l.N6 = t6n & 0xFFFFFFFF
            } else if an == 7 {
                var (t7m, t7n) = tadd2(l.M7, l.N7, v, v2)
                l.M7 = t7m & 0xFFFFFFFF
                l.N7 = t7n & 0xFFFFFFFF
            } else if an == 8 {
                var (t8m, t8n) = tadd2(l.M8, l.N8, v, v2)
                l.M8 = t8m & 0xFFFFFFFF
                l.N8 = t8n & 0xFFFFFFFF
            } else if an == 9 {
                var (t9m, t9n) = tadd2(l.M9, l.N9, v, v2)
                l.M9 = t9m & 0xFFFFFFFF
                l.N9 = t9n & 0xFFFFFFFF
            } else if an == 10 {
                var (t10m, t10n) = tadd2(l.M10, l.N10, v, v2)
                l.M10 = t10m & 0xFFFFFFFF
                l.N10 = t10n & 0xFFFFFFFF
            } else if an == 11 {
                var (t11m, t11n) = tadd2(l.M11, l.N11, v, v2)
                l.M11 = t11m & 0xFFFFFFFF
                l.N11 = t11n & 0xFFFFFFFF
            } else if an == 12 {
                var (t12m, t12n) = tadd2(l.M12, l.N12, v, v2)
                l.M12 = t12m & 0xFFFFFFFF
                l.N12 = t12n & 0xFFFFFFFF
            } else if an == 13 {
                var (t13m, t13n) = tadd2(l.M13, l.N13, v, v2)
                l.M13 = t13m & 0xFFFFFFFF
                l.N13 = t13n & 0xFFFFFFFF
            } else if an == 14 {
                var (t14m, t14n) = tadd2(l.M14, l.N14, v, v2)
                l.M14 = t14m & 0xFFFFFFFF
                l.N14 = t14n & 0xFFFFFFFF
            } else if an == 15 {
                var (t15m, t15n) = tadd2(l.M15, l.N15, v, v2)
                l.M15 = t15m & 0xFFFFFFFF
                l.N15 = t15n & 0xFFFFFFFF
            } else if an == 16 {
                var (t16m, t16n) = tadd2(l.M16, l.N16, v, v2)
                l.M16 = t16m & 0xFFFFFFFF
                l.N16 = t16n & 0xFFFFFFFF
            } else if an == 17 {
                var (t17m, t17n) = tadd2(l.M17, l.N17, v, v2)
                l.M17 = t17m & 0xFFFFFFFF
                l.N17 = t17n & 0xFFFFFFFF
            } else if an == 18 {
                var (t18m, t18n) = tadd2(l.M18, l.N18, v, v2)
                l.M18 = t18m & 0xFFFFFFFF
                l.N18 = t18n & 0xFFFFFFFF
            } else if an == 19 {
                var (t19m, t19n) = tadd2(l.M19, l.N19, v, v2)
                l.M19 = t19m & 0xFFFFFFFF
                l.N19 = t19n & 0xFFFFFFFF
            } else if an == 20 {
                var (t20m, t20n) = tadd2(l.M20, l.N20, v, v2)
                l.M20 = t20m & 0xFFFFFFFF
                l.N20 = t20n & 0xFFFFFFFF
            } else if an == 21 {
                var (t21m, t21n) = tadd2(l.M21, l.N21, v, v2)
                l.M21 = t21m & 0xFFFFFFFF
                l.N21 = t21n & 0xFFFFFFFF
            } else if an == 22 {
                var (t22m, t22n) = tadd2(l.M22, l.N22, v, v2)
                l.M22 = t22m & 0xFFFFFFFF
                l.N22 = t22n & 0xFFFFFFFF
            } else if an == 23 {
                var (t23m, t23n) = tadd2(l.M23, l.N23, v, v2)
                l.M23 = t23m & 0xFFFFFFFF
                l.N23 = t23n & 0xFFFFFFFF
            } else if an == 24 {
                var (t24m, t24n) = tadd2(l.M24, l.N24, v, v2)
                l.M24 = t24m & 0xFFFFFFFF
                l.N24 = t24n & 0xFFFFFFFF
            } else {
                var (t25m, t25n) = tadd2(l.M25, l.N25, v, v2)
                l.M25 = t25m & 0xFFFFFFFF
                l.N25 = t25n & 0xFFFFFFFF
            }
        }
        w = w + 1
    }
    return l
}

func fin_synth26x(h: ref table<i64>) {
    var l = Lanes26x()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp(h[1], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp(h[2], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp(h[3], 7)
    l.M3 = h[3] & 0xFFFFFFFF
    l.N3 = rrp(h[4], 7)
    l.M4 = h[4] & 0xFFFFFFFF
    l.N4 = rrp(h[5], 7)
    l.M5 = h[5] & 0xFFFFFFFF
    l.N5 = rrp(h[6], 7)
    l.M6 = h[6] & 0xFFFFFFFF
    l.N6 = rrp(h[7], 7)
    l.M7 = h[7] & 0xFFFFFFFF
    l.N7 = rrp(h[8], 7)
    l.M8 = h[8] & 0xFFFFFFFF
    l.N8 = rrp(h[9], 7)
    l.M9 = h[9] & 0xFFFFFFFF
    l.N9 = rrp(h[10], 7)
    l.M10 = h[10] & 0xFFFFFFFF
    l.N10 = rrp(h[11], 7)
    l.M11 = h[11] & 0xFFFFFFFF
    l.N11 = rrp(h[12], 7)
    l.M12 = h[12] & 0xFFFFFFFF
    l.N12 = rrp(h[13], 7)
    l.M13 = h[13] & 0xFFFFFFFF
    l.N13 = rrp(h[14], 7)
    l.M14 = h[14] & 0xFFFFFFFF
    l.N14 = rrp(h[15], 7)
    l.M15 = h[15] & 0xFFFFFFFF
    l.N15 = rrp(h[16], 7)
    l.M16 = h[16] & 0xFFFFFFFF
    l.N16 = rrp(h[17], 7)
    l.M17 = h[17] & 0xFFFFFFFF
    l.N17 = rrp(h[18], 7)
    l.M18 = h[18] & 0xFFFFFFFF
    l.N18 = rrp(h[19], 7)
    l.M19 = h[19] & 0xFFFFFFFF
    l.N19 = rrp(h[20], 7)
    l.M20 = h[20] & 0xFFFFFFFF
    l.N20 = rrp(h[21], 7)
    l.M21 = h[21] & 0xFFFFFFFF
    l.N21 = rrp(h[22], 7)
    l.M22 = h[22] & 0xFFFFFFFF
    l.N22 = rrp(h[23], 7)
    l.M23 = h[23] & 0xFFFFFFFF
    l.N23 = rrp(h[24], 7)
    l.M24 = h[24] & 0xFFFFFFFF
    l.N24 = rrp(h[25], 7)
    l.M25 = h[25] & 0xFFFFFFFF
    l.N25 = rrp(h[0], 7)
    var sf: i64 = 0
    while sf < 4 {
        l = ring26x_mixF(l, sf, 0x13579BDF)
        sf = sf + 1
    }
    h[0] = (l.M0 ^ rrp(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (l.M1 ^ rrp(l.N1, 5)) & 0xFFFFFFFF
    h[2] = (l.M2 ^ rrp(l.N2, 10)) & 0xFFFFFFFF
    h[3] = (l.M3 ^ rrp(l.N3, 15)) & 0xFFFFFFFF
    h[4] = (l.M4 ^ rrp(l.N4, 20)) & 0xFFFFFFFF
    h[5] = (l.M5 ^ rrp(l.N5, 25)) & 0xFFFFFFFF
    h[6] = (l.M6 ^ rrp(l.N6, 30)) & 0xFFFFFFFF
    h[7] = (l.M7 ^ rrp(l.N7, 3)) & 0xFFFFFFFF
    h[8] = (l.M8 ^ rrp(l.N8, 8)) & 0xFFFFFFFF
    h[9] = (l.M9 ^ rrp(l.N9, 13)) & 0xFFFFFFFF
    h[10] = (l.M10 ^ rrp(l.N10, 18)) & 0xFFFFFFFF
    h[11] = (l.M11 ^ rrp(l.N11, 23)) & 0xFFFFFFFF
    h[12] = (l.M12 ^ rrp(l.N12, 28)) & 0xFFFFFFFF
    h[13] = (l.M13 ^ rrp(l.N13, 1)) & 0xFFFFFFFF
    h[14] = (l.M14 ^ rrp(l.N14, 6)) & 0xFFFFFFFF
    h[15] = (l.M15 ^ rrp(l.N15, 11)) & 0xFFFFFFFF
    h[16] = (l.M16 ^ rrp(l.N16, 16)) & 0xFFFFFFFF
    h[17] = (l.M17 ^ rrp(l.N17, 21)) & 0xFFFFFFFF
    h[18] = (l.M18 ^ rrp(l.N18, 26)) & 0xFFFFFFFF
    h[19] = (l.M19 ^ rrp(l.N19, 31)) & 0xFFFFFFFF
    h[20] = (l.M20 ^ rrp(l.N20, 4)) & 0xFFFFFFFF
    h[21] = (l.M21 ^ rrp(l.N21, 9)) & 0xFFFFFFFF
    h[22] = (l.M22 ^ rrp(l.N22, 14)) & 0xFFFFFFFF
    h[23] = (l.M23 ^ rrp(l.N23, 19)) & 0xFFFFFFFF
    h[24] = (l.M24 ^ rrp(l.N24, 24)) & 0xFFFFFFFF
    h[25] = (l.M25 ^ rrp(l.N25, 29)) & 0xFFFFFFFF
}

pub func compress_w26x(h: ref table<i64>, msg: string, pos: i64, nbytes: i64,
            t_lo: i64, t_hi: i64, last: bool,
            iv: table<i64>, rcon: table<i64>, bcon: table<i64>, xdcon: table<i64>, R: i64) {
    var (M0, N0, M1, N1, Pw, skey) = w48_planes_skey(msg, pos, nbytes)
    var l = Lanes26x()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp(h[13], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp(h[14], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp(h[15], 7)
    l.M3 = h[3] & 0xFFFFFFFF
    l.N3 = rrp(h[16], 7)
    l.M4 = h[4] & 0xFFFFFFFF
    l.N4 = rrp(h[17], 7)
    l.M5 = h[5] & 0xFFFFFFFF
    l.N5 = rrp(h[18], 7)
    l.M6 = h[6] & 0xFFFFFFFF
    l.N6 = rrp(h[19], 7)
    l.M7 = h[7] & 0xFFFFFFFF
    l.N7 = rrp(h[20], 7)
    l.M8 = h[8] & 0xFFFFFFFF
    l.N8 = rrp(h[21], 7)
    l.M9 = h[9] & 0xFFFFFFFF
    l.N9 = rrp(h[22], 7)
    l.M10 = h[10] & 0xFFFFFFFF
    l.N10 = rrp(h[23], 7)
    l.M11 = h[11] & 0xFFFFFFFF
    l.N11 = rrp(h[24], 7)
    l.M12 = h[12] & 0xFFFFFFFF
    l.N12 = rrp(h[25], 7)
    l.M13 = h[13] & 0xFFFFFFFF
    l.N13 = rrp(h[0], 7)
    l.M14 = h[14] & 0xFFFFFFFF
    l.N14 = rrp(h[1], 7)
    l.M15 = h[15] & 0xFFFFFFFF
    l.N15 = rrp(h[2], 7)
    l.M16 = h[16] & 0xFFFFFFFF
    l.N16 = rrp(h[3], 7)
    l.M17 = h[17] & 0xFFFFFFFF
    l.N17 = rrp(h[4], 7)
    l.M18 = h[18] & 0xFFFFFFFF
    l.N18 = rrp(h[5], 7)
    l.M19 = h[19] & 0xFFFFFFFF
    l.N19 = rrp(h[6], 7)
    l.M20 = h[20] & 0xFFFFFFFF
    l.N20 = rrp(h[7], 7)
    l.M21 = h[21] & 0xFFFFFFFF
    l.N21 = rrp(h[8], 7)
    l.M22 = h[22] & 0xFFFFFFFF
    l.N22 = rrp(h[9], 7)
    l.M23 = h[23] & 0xFFFFFFFF
    l.N23 = rrp(h[10], 7)
    l.M24 = h[24] & 0xFFFFFFFF
    l.N24 = rrp(h[11], 7)
    l.M25 = h[25] & 0xFFFFFFFF
    l.N25 = rrp(h[12], 7)
    l.M0 = (l.M0 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M1 = (l.M1 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M2 = (l.M2 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M3 = (l.M3 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M4 = (l.M4 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M5 = (l.M5 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M6 = (l.M6 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M7 = (l.M7 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M8 = (l.M8 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M9 = (l.M9 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N9 = (l.N9 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M10 = (l.M10 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M11 = (l.M11 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M12 = (l.M12 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N12 = (l.N12 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M13 = (l.M13 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N13 = (l.N13 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M14 = (l.M14 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N14 = (l.N14 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M15 = (l.M15 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N15 = (l.N15 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M16 = (l.M16 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N16 = (l.N16 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M17 = (l.M17 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N17 = (l.N17 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M18 = (l.M18 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N18 = (l.N18 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M19 = (l.M19 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N19 = (l.N19 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M20 = (l.M20 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N20 = (l.N20 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M21 = (l.M21 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N21 = (l.N21 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M22 = (l.M22 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N22 = (l.N22 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M23 = (l.M23 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N23 = (l.N23 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M24 = (l.M24 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N24 = (l.N24 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M25 = (l.M25 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N25 = (l.N25 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (t_lo & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N13 = (l.N13 ^ (t_hi & 0xFFFFFFFF)) & 0xFFFFFFFF
    if last {
        l.N13 = (l.N13 ^ 0xFFFFFFFF) & 0xFFFFFFFF
    }
    l = absorb26x(l, Pw, skey)
    var mA: i64 = 0
    var mC: i64 = 0
    var r: i64 = 0
    while r < R {
        mA = (r * 5 + ((skey >> 6) & 7)) & 31
        mC = (r * 7 + ((skey >> 12) & 7)) & 31
        l = ring26x_mixA(l, r, skey, M0, N0, M1, N1, mA, rcon, r)
        l = ring26x_mixB(l, r, skey, M0, N0, M1, N1, mC, rcon, (r + 8) & 15)
        l = ring26x_sponge_r(l, r, skey, M0, N0, M1, N1, mA, bcon, (r + 3) & 15)
        l = ring26x_sponge_c(l, r, skey, bcon, (r + 11) & 15)
        l = lfsr26x_mix(l, r, M0, N0, xdcon)
            var (sm, sn) = tadd2(l.M0, l.N0, l.M16, l.N16)
    l.M0 = sm
    l.N0 = sn
    var (pm, pn) = tmul2(l.M0, l.N0, l.M16, l.N16)
    l.M16 = (l.M16 ^ pm) & 0xFFFFFFFF
    l.N16 = (l.N16 ^ pn) & 0xFFFFFFFF
            var (sm, sn) = tadd2(l.M8, l.N8, l.M17, l.N17)
    l.M8 = sm
    l.N8 = sn
    var (pm, pn) = tmul2(l.M8, l.N8, l.M17, l.N17)
    l.M17 = (l.M17 ^ pm) & 0xFFFFFFFF
    l.N17 = (l.N17 ^ pn) & 0xFFFFFFFF
            var (sm, sn) = tadd2(l.M1, l.N1, l.M20, l.N20)
    l.M1 = sm
    l.N1 = sn
    var (pm, pn) = tmul2(l.M1, l.N1, l.M20, l.N20)
    l.M20 = (l.M20 ^ pm) & 0xFFFFFFFF
    l.N20 = (l.N20 ^ pn) & 0xFFFFFFFF
            var (sm, sn) = tadd2(l.M9, l.N9, l.M21, l.N21)
    l.M9 = sm
    l.N9 = sn
    var (pm, pn) = tmul2(l.M9, l.N9, l.M21, l.N21)
    l.M21 = (l.M21 ^ pm) & 0xFFFFFFFF
    l.N21 = (l.N21 ^ pn) & 0xFFFFFFFF
            var (sm, sn) = tadd2(l.M0, l.N0, l.M24, l.N24)
    l.M0 = sm
    l.N0 = sn
    var (pm, pn) = tmul2(l.M0, l.N0, l.M24, l.N24)
    l.M24 = (l.M24 ^ pm) & 0xFFFFFFFF
    l.N24 = (l.N24 ^ pn) & 0xFFFFFFFF
            var (sm, sn) = tadd2(l.M1, l.N1, l.M25, l.N25)
    l.M1 = sm
    l.N1 = sn
    var (pm, pn) = tmul2(l.M1, l.N1, l.M25, l.N25)
    l.M25 = (l.M25 ^ pm) & 0xFFFFFFFF
    l.N25 = (l.N25 ^ pn) & 0xFFFFFFFF
        r = r + 1
    }
    h[0] = (h[0] ^ l.M0 ^ rrp(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (h[1] ^ l.M1 ^ rrp(l.N1, 3)) & 0xFFFFFFFF
    h[2] = (h[2] ^ l.M2 ^ rrp(l.N2, 6)) & 0xFFFFFFFF
    h[3] = (h[3] ^ l.M3 ^ rrp(l.N3, 9)) & 0xFFFFFFFF
    h[4] = (h[4] ^ l.M4 ^ rrp(l.N4, 12)) & 0xFFFFFFFF
    h[5] = (h[5] ^ l.M5 ^ rrp(l.N5, 15)) & 0xFFFFFFFF
    h[6] = (h[6] ^ l.M6 ^ rrp(l.N6, 18)) & 0xFFFFFFFF
    h[7] = (h[7] ^ l.M7 ^ rrp(l.N7, 21)) & 0xFFFFFFFF
    h[8] = (h[8] ^ l.M8 ^ rrp(l.N8, 24)) & 0xFFFFFFFF
    h[9] = (h[9] ^ l.M9 ^ rrp(l.N9, 27)) & 0xFFFFFFFF
    h[10] = (h[10] ^ l.M10 ^ rrp(l.N10, 30)) & 0xFFFFFFFF
