                    rrp(l.M12, (rA + 15) & 31), rrp(l.N12, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp(l.M13, (rB + 24) & 31), rrp(l.N13, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M11, l.N11,
                    rrp(l.M13, (rA + 20) & 31), rrp(l.N13, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp(l.M7, (rB + 31) & 31), rrp(l.N7, (rB + 31) & 31))
