    l.N20 = (l.N20 ^ p2n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M22 = (l.M22 ^ maj) & 0xFFFFFFFF
    l.N22 = (l.N22 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    l.M20 = (l.M20 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N22 = (l.N22 ^ rrp(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
