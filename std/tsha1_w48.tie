func fin_synth29h(h: ref table<i64>) {
    var l = Lanes29h()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp16(h[1], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp16(h[2], 7)
    l.M2 = h[2] & 0xFFFFFFFF
