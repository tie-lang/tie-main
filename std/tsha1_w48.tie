func lfsr23x_mix(l: Lanes23x, r: i64
            , M0: i64, N0: i64, rcon: table<i64>
            ) -> Lanes23x {
    var fb: i64 = 0
    l.M21 = (l.M21 ^ rrp(M0, (r * 3 + 0) & 31)) & 0xFFFFFFFF
    l.N21 = (l.N21 ^ rrp(N0, (r * 5 + 0) & 31)) & 0xFFFFFFFF
    fb = (l.M21 >> 16) ^ l.N21
    l.M22 = (l.M22 ^ fb) & 0xFFFFFFFF
    l.N22 = (l.N22 ^ fb) & 0xFFFFFFFF
    l.M22 = (l.M22 ^ rcon[(r + 0) & 15]) & 0xFFFFFFFF
    l.N22 = (l.N22 ^ rrp(rcon[(r + 0 + 8) & 15], (r + 0) & 31)) & 0xFFFFFFFF
    l.M22 = (l.M22 ^ rrp(M0, (r * 3 + 5) & 31)) & 0xFFFFFFFF
    l.N22 = (l.N22 ^ rrp(N0, (r * 5 + 3) & 31)) & 0xFFFFFFFF
    fb = (l.M22 >> 16) ^ l.N22
    l.M21 = (l.M21 ^ fb) & 0xFFFFFFFF
    l.N21 = (l.N21 ^ fb) & 0xFFFFFFFF
    l.M21 = (l.M21 ^ rcon[(r + 1) & 15]) & 0xFFFFFFFF
    l.N21 = (l.N21 ^ rrp(rcon[(r + 1 + 8) & 15], (r + 2) & 31)) & 0xFFFFFFFF
    return l
}

