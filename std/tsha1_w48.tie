    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp(l.M14, (rB + 3) & 31), rrp(l.N14, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M14, l.N14,
                    rrp(l.M14, (rA + 5) & 31), rrp(l.N14, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp(l.M13, (rB + 10) & 31), rrp(l.N13, (rB + 10) & 31))
