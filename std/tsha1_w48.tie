                l.N20 = t20n & 0xFFFFFFFF
            } else if an == 21 {
                var (t21m, t21n) = tadd2(l.M21, l.N21, v, v2)
                l.M21 = t21m & 0xFFFFFFFF
                l.N21 = t21n & 0xFFFFFFFF
            } else if an == 22 {
                var (t22m, t22n) = tadd2(l.M22, l.N22, v, v2)
                l.M22 = t22m & 0xFFFFFFFF
                l.N22 = t22n & 0xFFFFFFFF
            } else if an == 23 {
                var (t23m, t23n) = tadd2(l.M23, l.N23, v, v2)
                l.M23 = t23m & 0xFFFFFFFF
                l.N23 = t23n & 0xFFFFFFFF
            } else if an == 24 {
                var (t24m, t24n) = tadd2(l.M24, l.N24, v, v2)
                l.M24 = t24m & 0xFFFFFFFF
                l.N24 = t24n & 0xFFFFFFFF
            } else if an == 25 {
                var (t25m, t25n) = tadd2(l.M25, l.N25, v, v2)
                l.M25 = t25m & 0xFFFFFFFF
                l.N25 = t25n & 0xFFFFFFFF
            } else if an == 26 {
                var (t26m, t26n) = tadd2(l.M26, l.N26, v, v2)
                l.M26 = t26m & 0xFFFFFFFF
                l.N26 = t26n & 0xFFFFFFFF
            } else if an == 27 {
                var (t27m, t27n) = tadd2(l.M27, l.N27, v, v2)
                l.M27 = t27m & 0xFFFFFFFF
                l.N27 = t27n & 0xFFFFFFFF
            } else if an == 28 {
                var (t28m, t28n) = tadd2(l.M28, l.N28, v, v2)
                l.M28 = t28m & 0xFFFFFFFF
                l.N28 = t28n & 0xFFFFFFFF
            } else if an == 29 {
                var (t29m, t29n) = tadd2(l.M29, l.N29, v, v2)
                l.M29 = t29m & 0xFFFFFFFF
                l.N29 = t29n & 0xFFFFFFFF
            } else if an == 30 {
                var (t30m, t30n) = tadd2(l.M30, l.N30, v, v2)
                l.M30 = t30m & 0xFFFFFFFF
                l.N30 = t30n & 0xFFFFFFFF
            } else {
                var (t31m, t31n) = tadd2(l.M31, l.N31, v, v2)
                l.M31 = t31m & 0xFFFFFFFF
                l.N31 = t31n & 0xFFFFFFFF
            }
        }
        w = w + 1
    }
    return l
}

func fin_synth32h(h: ref table<i64>) {
    var l = Lanes32h()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp16(h[1], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp16(h[2], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp16(h[3], 7)
    l.M3 = h[3] & 0xFFFFFFFF
    l.N3 = rrp16(h[4], 7)
    l.M4 = h[4] & 0xFFFFFFFF
    l.N4 = rrp16(h[5], 7)
    l.M5 = h[5] & 0xFFFFFFFF
    l.N5 = rrp16(h[6], 7)
    l.M6 = h[6] & 0xFFFFFFFF
    l.N6 = rrp16(h[7], 7)
    l.M7 = h[7] & 0xFFFFFFFF
    l.N7 = rrp16(h[8], 7)
    l.M8 = h[8] & 0xFFFFFFFF
    l.N8 = rrp16(h[9], 7)
    l.M9 = h[9] & 0xFFFFFFFF
    l.N9 = rrp16(h[10], 7)
    l.M10 = h[10] & 0xFFFFFFFF
    l.N10 = rrp16(h[11], 7)
    l.M11 = h[11] & 0xFFFFFFFF
    l.N11 = rrp16(h[12], 7)
    l.M12 = h[12] & 0xFFFFFFFF
    l.N12 = rrp16(h[13], 7)
    l.M13 = h[13] & 0xFFFFFFFF
    l.N13 = rrp16(h[14], 7)
    l.M14 = h[14] & 0xFFFFFFFF
    l.N14 = rrp16(h[15], 7)
    l.M15 = h[15] & 0xFFFFFFFF
    l.N15 = rrp16(h[16], 7)
    l.M16 = h[16] & 0xFFFFFFFF
    l.N16 = rrp16(h[17], 7)
    l.M17 = h[17] & 0xFFFFFFFF
    l.N17 = rrp16(h[18], 7)
    l.M18 = h[18] & 0xFFFFFFFF
    l.N18 = rrp16(h[19], 7)
    l.M19 = h[19] & 0xFFFFFFFF
    l.N19 = rrp16(h[20], 7)
    l.M20 = h[20] & 0xFFFFFFFF
    l.N20 = rrp16(h[21], 7)
    l.M21 = h[21] & 0xFFFFFFFF
    l.N21 = rrp16(h[22], 7)
    l.M22 = h[22] & 0xFFFFFFFF
    l.N22 = rrp16(h[23], 7)
    l.M23 = h[23] & 0xFFFFFFFF
    l.N23 = rrp16(h[24], 7)
    l.M24 = h[24] & 0xFFFFFFFF
    l.N24 = rrp16(h[25], 7)
    l.M25 = h[25] & 0xFFFFFFFF
    l.N25 = rrp16(h[26], 7)
    l.M26 = h[26] & 0xFFFFFFFF
    l.N26 = rrp16(h[27], 7)
    l.M27 = h[27] & 0xFFFFFFFF
    l.N27 = rrp16(h[28], 7)
    l.M28 = h[28] & 0xFFFFFFFF
    l.N28 = rrp16(h[29], 7)
    l.M29 = h[29] & 0xFFFFFFFF
    l.N29 = rrp16(h[30], 7)
    l.M30 = h[30] & 0xFFFFFFFF
    l.N30 = rrp16(h[31], 7)
    l.M31 = h[31] & 0xFFFFFFFF
    l.N31 = rrp16(h[0], 7)
    var sf: i64 = 0
    while sf < 4 {
        l = ring32h_mixF(l, sf, 0x13579BDF)
        sf = sf + 1
    }
    h[0] = (l.M0 ^ rrp16(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (l.M1 ^ rrp16(l.N1, 5)) & 0xFFFFFFFF
    h[2] = (l.M2 ^ rrp16(l.N2, 10)) & 0xFFFFFFFF
    h[3] = (l.M3 ^ rrp16(l.N3, 15)) & 0xFFFFFFFF
    h[4] = (l.M4 ^ rrp16(l.N4, 20)) & 0xFFFFFFFF
    h[5] = (l.M5 ^ rrp16(l.N5, 25)) & 0xFFFFFFFF
    h[6] = (l.M6 ^ rrp16(l.N6, 30)) & 0xFFFFFFFF
    h[7] = (l.M7 ^ rrp16(l.N7, 3)) & 0xFFFFFFFF
    h[8] = (l.M8 ^ rrp16(l.N8, 8)) & 0xFFFFFFFF
    h[9] = (l.M9 ^ rrp16(l.N9, 13)) & 0xFFFFFFFF
    h[10] = (l.M10 ^ rrp16(l.N10, 18)) & 0xFFFFFFFF
    h[11] = (l.M11 ^ rrp16(l.N11, 23)) & 0xFFFFFFFF
    h[12] = (l.M12 ^ rrp16(l.N12, 28)) & 0xFFFFFFFF
    h[13] = (l.M13 ^ rrp16(l.N13, 1)) & 0xFFFFFFFF
    h[14] = (l.M14 ^ rrp16(l.N14, 6)) & 0xFFFFFFFF
    h[15] = (l.M15 ^ rrp16(l.N15, 11)) & 0xFFFFFFFF
    h[16] = (l.M16 ^ rrp16(l.N16, 16)) & 0xFFFFFFFF
    h[17] = (l.M17 ^ rrp16(l.N17, 21)) & 0xFFFFFFFF
    h[18] = (l.M18 ^ rrp16(l.N18, 26)) & 0xFFFFFFFF
    h[19] = (l.M19 ^ rrp16(l.N19, 31)) & 0xFFFFFFFF
    h[20] = (l.M20 ^ rrp16(l.N20, 4)) & 0xFFFFFFFF
    h[21] = (l.M21 ^ rrp16(l.N21, 9)) & 0xFFFFFFFF
    h[22] = (l.M22 ^ rrp16(l.N22, 14)) & 0xFFFFFFFF
    h[23] = (l.M23 ^ rrp16(l.N23, 19)) & 0xFFFFFFFF
    h[24] = (l.M24 ^ rrp16(l.N24, 24)) & 0xFFFFFFFF
    h[25] = (l.M25 ^ rrp16(l.N25, 29)) & 0xFFFFFFFF
    h[26] = (l.M26 ^ rrp16(l.N26, 2)) & 0xFFFFFFFF
    h[27] = (l.M27 ^ rrp16(l.N27, 7)) & 0xFFFFFFFF
    h[28] = (l.M28 ^ rrp16(l.N28, 12)) & 0xFFFFFFFF
    h[29] = (l.M29 ^ rrp16(l.N29, 17)) & 0xFFFFFFFF
    h[30] = (l.M30 ^ rrp16(l.N30, 22)) & 0xFFFFFFFF
    h[31] = (l.M31 ^ rrp16(l.N31, 27)) & 0xFFFFFFFF
}

pub func compress_w32h(h: ref table<i64>, msg: string, pos: i64, nbytes: i64,
            t_lo: i64, t_hi: i64, last: bool,
            iv: table<i64>, rcon: table<i64>, R: i64) {
    var (M0, N0, M1, N1, Pw, skey) = w48_planes_skey(msg, pos, nbytes)
    var l = Lanes32h()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp16(h[16], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp16(h[17], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp16(h[18], 7)
    l.M3 = h[3] & 0xFFFFFFFF
    l.N3 = rrp16(h[19], 7)
    l.M4 = h[4] & 0xFFFFFFFF
    l.N4 = rrp16(h[20], 7)
    l.M5 = h[5] & 0xFFFFFFFF
    l.N5 = rrp16(h[21], 7)
    l.M6 = h[6] & 0xFFFFFFFF
    l.N6 = rrp16(h[22], 7)
    l.M7 = h[7] & 0xFFFFFFFF
    l.N7 = rrp16(h[23], 7)
    l.M8 = h[8] & 0xFFFFFFFF
    l.N8 = rrp16(h[24], 7)
    l.M9 = h[9] & 0xFFFFFFFF
    l.N9 = rrp16(h[25], 7)
    l.M10 = h[10] & 0xFFFFFFFF
    l.N10 = rrp16(h[26], 7)
    l.M11 = h[11] & 0xFFFFFFFF
    l.N11 = rrp16(h[27], 7)
    l.M12 = h[12] & 0xFFFFFFFF
    l.N12 = rrp16(h[28], 7)
    l.M13 = h[13] & 0xFFFFFFFF
    l.N13 = rrp16(h[29], 7)
    l.M14 = h[14] & 0xFFFFFFFF
    l.N14 = rrp16(h[30], 7)
    l.M15 = h[15] & 0xFFFFFFFF
    l.N15 = rrp16(h[31], 7)
    l.M16 = h[16] & 0xFFFFFFFF
    l.N16 = rrp16(h[0], 7)
    l.M17 = h[17] & 0xFFFFFFFF
    l.N17 = rrp16(h[1], 7)
    l.M18 = h[18] & 0xFFFFFFFF
    l.N18 = rrp16(h[2], 7)
    l.M19 = h[19] & 0xFFFFFFFF
    l.N19 = rrp16(h[3], 7)
    l.M20 = h[20] & 0xFFFFFFFF
    l.N20 = rrp16(h[4], 7)
    l.M21 = h[21] & 0xFFFFFFFF
    l.N21 = rrp16(h[5], 7)
    l.M22 = h[22] & 0xFFFFFFFF
    l.N22 = rrp16(h[6], 7)
    l.M23 = h[23] & 0xFFFFFFFF
    l.N23 = rrp16(h[7], 7)
    l.M24 = h[24] & 0xFFFFFFFF
    l.N24 = rrp16(h[8], 7)
    l.M25 = h[25] & 0xFFFFFFFF
    l.N25 = rrp16(h[9], 7)
    l.M26 = h[26] & 0xFFFFFFFF
    l.N26 = rrp16(h[10], 7)
    l.M27 = h[27] & 0xFFFFFFFF
    l.N27 = rrp16(h[11], 7)
    l.M28 = h[28] & 0xFFFFFFFF
    l.N28 = rrp16(h[12], 7)
    l.M29 = h[29] & 0xFFFFFFFF
    l.N29 = rrp16(h[13], 7)
    l.M30 = h[30] & 0xFFFFFFFF
    l.N30 = rrp16(h[14], 7)
    l.M31 = h[31] & 0xFFFFFFFF
    l.N31 = rrp16(h[15], 7)
    l.M0 = (l.M0 ^ (iv[0] & 0xFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (iv[4] & 0xFFFF)) & 0xFFFFFFFF
    l.M1 = (l.M1 ^ (iv[1] & 0xFFFF)) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ (iv[5] & 0xFFFF)) & 0xFFFFFFFF
    l.M2 = (l.M2 ^ (iv[2] & 0xFFFF)) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ (iv[6] & 0xFFFF)) & 0xFFFFFFFF
    l.M3 = (l.M3 ^ (iv[3] & 0xFFFF)) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ (iv[7] & 0xFFFF)) & 0xFFFFFFFF
    l.M4 = (l.M4 ^ (iv[4] & 0xFFFF)) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ (iv[0] & 0xFFFF)) & 0xFFFFFFFF
    l.M5 = (l.M5 ^ (iv[5] & 0xFFFF)) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ (iv[1] & 0xFFFF)) & 0xFFFFFFFF
    l.M6 = (l.M6 ^ (iv[6] & 0xFFFF)) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ (iv[2] & 0xFFFF)) & 0xFFFFFFFF
    l.M7 = (l.M7 ^ (iv[7] & 0xFFFF)) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ (iv[3] & 0xFFFF)) & 0xFFFFFFFF
    l.M8 = (l.M8 ^ (iv[0] & 0xFFFF)) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ (iv[4] & 0xFFFF)) & 0xFFFFFFFF
    l.M9 = (l.M9 ^ (iv[1] & 0xFFFF)) & 0xFFFFFFFF
    l.N9 = (l.N9 ^ (iv[5] & 0xFFFF)) & 0xFFFFFFFF
    l.M10 = (l.M10 ^ (iv[2] & 0xFFFF)) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ (iv[6] & 0xFFFF)) & 0xFFFFFFFF
    l.M11 = (l.M11 ^ (iv[3] & 0xFFFF)) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ (iv[7] & 0xFFFF)) & 0xFFFFFFFF
    l.M12 = (l.M12 ^ (iv[4] & 0xFFFF)) & 0xFFFFFFFF
    l.N12 = (l.N12 ^ (iv[0] & 0xFFFF)) & 0xFFFFFFFF
    l.M13 = (l.M13 ^ (iv[5] & 0xFFFF)) & 0xFFFFFFFF
    l.N13 = (l.N13 ^ (iv[1] & 0xFFFF)) & 0xFFFFFFFF
    l.M14 = (l.M14 ^ (iv[6] & 0xFFFF)) & 0xFFFFFFFF
    l.N14 = (l.N14 ^ (iv[2] & 0xFFFF)) & 0xFFFFFFFF
    l.M15 = (l.M15 ^ (iv[7] & 0xFFFF)) & 0xFFFFFFFF
    l.N15 = (l.N15 ^ (iv[3] & 0xFFFF)) & 0xFFFFFFFF
    l.M16 = (l.M16 ^ (iv[0] & 0xFFFF)) & 0xFFFFFFFF
    l.N16 = (l.N16 ^ (iv[4] & 0xFFFF)) & 0xFFFFFFFF
    l.M17 = (l.M17 ^ (iv[1] & 0xFFFF)) & 0xFFFFFFFF
    l.N17 = (l.N17 ^ (iv[5] & 0xFFFF)) & 0xFFFFFFFF
    l.M18 = (l.M18 ^ (iv[2] & 0xFFFF)) & 0xFFFFFFFF
    l.N18 = (l.N18 ^ (iv[6] & 0xFFFF)) & 0xFFFFFFFF
    l.M19 = (l.M19 ^ (iv[3] & 0xFFFF)) & 0xFFFFFFFF
    l.N19 = (l.N19 ^ (iv[7] & 0xFFFF)) & 0xFFFFFFFF
    l.M20 = (l.M20 ^ (iv[4] & 0xFFFF)) & 0xFFFFFFFF
    l.N20 = (l.N20 ^ (iv[0] & 0xFFFF)) & 0xFFFFFFFF
    l.M21 = (l.M21 ^ (iv[5] & 0xFFFF)) & 0xFFFFFFFF
    l.N21 = (l.N21 ^ (iv[1] & 0xFFFF)) & 0xFFFFFFFF
    l.M22 = (l.M22 ^ (iv[6] & 0xFFFF)) & 0xFFFFFFFF
    l.N22 = (l.N22 ^ (iv[2] & 0xFFFF)) & 0xFFFFFFFF
    l.M23 = (l.M23 ^ (iv[7] & 0xFFFF)) & 0xFFFFFFFF
    l.N23 = (l.N23 ^ (iv[3] & 0xFFFF)) & 0xFFFFFFFF
    l.M24 = (l.M24 ^ (iv[0] & 0xFFFF)) & 0xFFFFFFFF
    l.N24 = (l.N24 ^ (iv[4] & 0xFFFF)) & 0xFFFFFFFF
    l.M25 = (l.M25 ^ (iv[1] & 0xFFFF)) & 0xFFFFFFFF
    l.N25 = (l.N25 ^ (iv[5] & 0xFFFF)) & 0xFFFFFFFF
    l.M26 = (l.M26 ^ (iv[2] & 0xFFFF)) & 0xFFFFFFFF
    l.N26 = (l.N26 ^ (iv[6] & 0xFFFF)) & 0xFFFFFFFF
    l.M27 = (l.M27 ^ (iv[3] & 0xFFFF)) & 0xFFFFFFFF
    l.N27 = (l.N27 ^ (iv[7] & 0xFFFF)) & 0xFFFFFFFF
    l.M28 = (l.M28 ^ (iv[4] & 0xFFFF)) & 0xFFFFFFFF
    l.N28 = (l.N28 ^ (iv[0] & 0xFFFF)) & 0xFFFFFFFF
    l.M29 = (l.M29 ^ (iv[5] & 0xFFFF)) & 0xFFFFFFFF
    l.N29 = (l.N29 ^ (iv[1] & 0xFFFF)) & 0xFFFFFFFF
    l.M30 = (l.M30 ^ (iv[6] & 0xFFFF)) & 0xFFFFFFFF
    l.N30 = (l.N30 ^ (iv[2] & 0xFFFF)) & 0xFFFFFFFF
    l.M31 = (l.M31 ^ (iv[7] & 0xFFFF)) & 0xFFFFFFFF
    l.N31 = (l.N31 ^ (iv[3] & 0xFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (t_lo & 0xFFFF)) & 0xFFFFFFFF
    l.N16 = (l.N16 ^ (t_hi & 0xFFFF)) & 0xFFFFFFFF
    if last {
        l.N16 = (l.N16 ^ 0xFFFFFFFF) & 0xFFFFFFFF
    }
    l = absorb32h(l, Pw, skey)
    var mA: i64 = 0
    var mC: i64 = 0
    var r: i64 = 0
    while r < R {
        mA = (r * 5 + ((skey >> 6) & 7)) & 31
        mC = (r * 7 + ((skey >> 12) & 7)) & 31
        l = ring32h_mixA(l, r, skey, M0, N0, M1, N1, mA, rcon, r)
        l = ring32h_mixB(l, r, skey, M0, N0, M1, N1, mC, rcon, (r + 8) & 15)
        r = r + 1
    }
    h[0] = (h[0] ^ l.M0 ^ rrp16(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (h[1] ^ l.M1 ^ rrp16(l.N1, 3)) & 0xFFFFFFFF
    h[2] = (h[2] ^ l.M2 ^ rrp16(l.N2, 6)) & 0xFFFFFFFF
    h[3] = (h[3] ^ l.M3 ^ rrp16(l.N3, 9)) & 0xFFFFFFFF
    h[4] = (h[4] ^ l.M4 ^ rrp16(l.N4, 12)) & 0xFFFFFFFF
    h[5] = (h[5] ^ l.M5 ^ rrp16(l.N5, 15)) & 0xFFFFFFFF
    h[6] = (h[6] ^ l.M6 ^ rrp16(l.N6, 18)) & 0xFFFFFFFF
    h[7] = (h[7] ^ l.M7 ^ rrp16(l.N7, 21)) & 0xFFFFFFFF
    h[8] = (h[8] ^ l.M8 ^ rrp16(l.N8, 24)) & 0xFFFFFFFF
    h[9] = (h[9] ^ l.M9 ^ rrp16(l.N9, 27)) & 0xFFFFFFFF
    h[10] = (h[10] ^ l.M10 ^ rrp16(l.N10, 30)) & 0xFFFFFFFF
    h[11] = (h[11] ^ l.M11 ^ rrp16(l.N11, 1)) & 0xFFFFFFFF
    h[12] = (h[12] ^ l.M12 ^ rrp16(l.N12, 4)) & 0xFFFFFFFF
    h[13] = (h[13] ^ l.M13 ^ rrp16(l.N13, 7)) & 0xFFFFFFFF
    h[14] = (h[14] ^ l.M14 ^ rrp16(l.N14, 10)) & 0xFFFFFFFF
    h[15] = (h[15] ^ l.M15 ^ rrp16(l.N15, 13)) & 0xFFFFFFFF
    h[16] = (h[16] ^ l.M16 ^ rrp16(l.N16, 16)) & 0xFFFFFFFF
    h[17] = (h[17] ^ l.M17 ^ rrp16(l.N17, 19)) & 0xFFFFFFFF
    h[18] = (h[18] ^ l.M18 ^ rrp16(l.N18, 22)) & 0xFFFFFFFF
    h[19] = (h[19] ^ l.M19 ^ rrp16(l.N19, 25)) & 0xFFFFFFFF
    h[20] = (h[20] ^ l.M20 ^ rrp16(l.N20, 28)) & 0xFFFFFFFF
    h[21] = (h[21] ^ l.M21 ^ rrp16(l.N21, 31)) & 0xFFFFFFFF
    h[22] = (h[22] ^ l.M22 ^ rrp16(l.N22, 2)) & 0xFFFFFFFF
    h[23] = (h[23] ^ l.M23 ^ rrp16(l.N23, 5)) & 0xFFFFFFFF
    h[24] = (h[24] ^ l.M24 ^ rrp16(l.N24, 8)) & 0xFFFFFFFF
    h[25] = (h[25] ^ l.M25 ^ rrp16(l.N25, 11)) & 0xFFFFFFFF
    h[26] = (h[26] ^ l.M26 ^ rrp16(l.N26, 14)) & 0xFFFFFFFF
    h[27] = (h[27] ^ l.M27 ^ rrp16(l.N27, 17)) & 0xFFFFFFFF
    h[28] = (h[28] ^ l.M28 ^ rrp16(l.N28, 20)) & 0xFFFFFFFF
    h[29] = (h[29] ^ l.M29 ^ rrp16(l.N29, 23)) & 0xFFFFFFFF
    h[30] = (h[30] ^ l.M30 ^ rrp16(l.N30, 26)) & 0xFFFFFFFF
    h[31] = (h[31] ^ l.M31 ^ rrp16(l.N31, 29)) & 0xFFFFFFFF
    fin_synth32h(h)
}

// === W=16 三轨特化内核（b，n=88/92/96/128/144）——轨A[0..6)、轨B[6..12)、海绵[12..16) rate2=2；R=14 ===
struct Lanes16b {
    var M0: i64 = 0
    var N0: i64 = 0
    var M1: i64 = 0
    var N1: i64 = 0
    var M2: i64 = 0
    var N2: i64 = 0
    var M3: i64 = 0
    var N3: i64 = 0
    var M4: i64 = 0
    var N4: i64 = 0
    var M5: i64 = 0
    var N5: i64 = 0
    var M6: i64 = 0
    var N6: i64 = 0
    var M7: i64 = 0
    var N7: i64 = 0
    var M8: i64 = 0
    var N8: i64 = 0
    var M9: i64 = 0
    var N9: i64 = 0
    var M10: i64 = 0
    var N10: i64 = 0
    var M11: i64 = 0
    var N11: i64 = 0
    var M12: i64 = 0
    var N12: i64 = 0
    var M13: i64 = 0
    var N13: i64 = 0
    var M14: i64 = 0
    var N14: i64 = 0
    var M15: i64 = 0
    var N15: i64 = 0
}

func ring16b_mixA(l: Lanes16b, r: i64
            , skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes16b {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0,
                    rrp(l.M2, rA), rrp(l.N2, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp(l.M3, (rB + 3) & 31), rrp(l.N3, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1,
                    rrp(l.M3, (rA + 5) & 31), rrp(l.N3, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp(l.M4, (rB + 10) & 31), rrp(l.N4, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M2, l.N2,
                    rrp(l.M4, (rA + 10) & 31), rrp(l.N4, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp(l.M5, (rB + 17) & 31), rrp(l.N5, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M3, l.N3,
                    rrp(l.M5, (rA + 15) & 31), rrp(l.N5, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp(l.M0, (rB + 24) & 31), rrp(l.N0, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M4, l.N4,
                    rrp(l.M0, (rA + 20) & 31), rrp(l.N0, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp(l.M1, (rB + 31) & 31), rrp(l.N1, (rB + 31) & 31))
    var (q5m, q5n) = tadd2(l.M5, l.N5,
                    rrp(l.M1, (rA + 25) & 31), rrp(l.N1, (rA + 25) & 31))
    var (s5m, s5n) = tadd2(q5m, q5n,
                    rrp(l.M2, (rB + 6) & 31), rrp(l.N2, (rB + 6) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    l.M2 = s2m
    l.N2 = s2n
    l.M3 = s3m
    l.N3 = s3n
    l.M4 = s4m
    l.N4 = s4n
    l.M5 = s5m
    l.N5 = s5n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M2 = (l.M2 ^ p1m) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M3 = (l.M3 ^ p2m) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s5m, s5n)
    l.M4 = (l.M4 ^ p3m) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s0m, s0n)
    l.M5 = (l.M5 ^ p4m) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ p4n) & 0xFFFFFFFF
    var (p5m, p5n) = tmul2(s5m, s5n, s1m, s1n)
    l.M0 = (l.M0 ^ p5m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p5n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M5 = (l.M5 ^ maj) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M0, l.N0, rrp(M0, mA), rrp(N0, mA))
    l.M0 = im
    l.N0 = in2
    var (jm, jn2) = tadd2(l.M1, l.N1, rrp(M1, (mA + 7) & 31), rrp(N1, (mA + 7) & 31))
    l.M1 = jm
    l.N1 = jn2
    l.M0 = (l.M0 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ rrp(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

func ring16b_mixB(l: Lanes16b, r: i64
            , skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes16b {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M6, l.N6,
                    rrp(l.M8, rA), rrp(l.N8, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp(l.M9, (rB + 3) & 31), rrp(l.N9, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M7, l.N7,
                    rrp(l.M9, (rA + 5) & 31), rrp(l.N9, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp(l.M10, (rB + 10) & 31), rrp(l.N10, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M8, l.N8,
                    rrp(l.M10, (rA + 10) & 31), rrp(l.N10, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp(l.M11, (rB + 17) & 31), rrp(l.N11, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M9, l.N9,
                    rrp(l.M11, (rA + 15) & 31), rrp(l.N11, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp(l.M6, (rB + 24) & 31), rrp(l.N6, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M10, l.N10,
                    rrp(l.M6, (rA + 20) & 31), rrp(l.N6, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp(l.M7, (rB + 31) & 31), rrp(l.N7, (rB + 31) & 31))
    var (q5m, q5n) = tadd2(l.M11, l.N11,
                    rrp(l.M7, (rA + 25) & 31), rrp(l.N7, (rA + 25) & 31))
    var (s5m, s5n) = tadd2(q5m, q5n,
                    rrp(l.M8, (rB + 6) & 31), rrp(l.N8, (rB + 6) & 31))
    l.M6 = s0m
    l.N6 = s0n
    l.M7 = s1m
    l.N7 = s1n
    l.M8 = s2m
    l.N8 = s2n
    l.M9 = s3m
    l.N9 = s3n
    l.M10 = s4m
    l.N10 = s4n
    l.M11 = s5m
    l.N11 = s5n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M7 = (l.M7 ^ p0m) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M8 = (l.M8 ^ p1m) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M9 = (l.M9 ^ p2m) & 0xFFFFFFFF
    l.N9 = (l.N9 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s5m, s5n)
    l.M10 = (l.M10 ^ p3m) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s0m, s0n)
    l.M11 = (l.M11 ^ p4m) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ p4n) & 0xFFFFFFFF
    var (p5m, p5n) = tmul2(s5m, s5n, s1m, s1n)
    l.M6 = (l.M6 ^ p5m) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ p5n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M11 = (l.M11 ^ maj) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M6, l.N6, rrp(M0, mA), rrp(N0, mA))
    l.M6 = im
    l.N6 = in2
    var (jm, jn2) = tadd2(l.M7, l.N7, rrp(M1, (mA + 7) & 31), rrp(N1, (mA + 7) & 31))
    l.M7 = jm
    l.N7 = jn2
    l.M6 = (l.M6 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ rrp(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

func ring16b_sponge_r(l: Lanes16b, r: i64
            , skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes16b {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M12, l.N12,
                    rrp(l.M12, rA), rrp(l.N12, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp(l.M13, (rB + 3) & 31), rrp(l.N13, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M13, l.N13,
                    rrp(l.M13, (rA + 5) & 31), rrp(l.N13, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp(l.M12, (rB + 10) & 31), rrp(l.N12, (rB + 10) & 31))
    l.M12 = s0m
    l.N12 = s0n
    l.M13 = s1m
    l.N13 = s1n
    var (p0m, p0n) = tmul2(s0m, s0n, s0m, s0n)
    l.M13 = (l.M13 ^ p0m) & 0xFFFFFFFF
    l.N13 = (l.N13 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s1m, s1n)
    l.M12 = (l.M12 ^ p1m) & 0xFFFFFFFF
    l.N12 = (l.N12 ^ p1n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s0m, s0n)
    l.M13 = (l.M13 ^ maj) & 0xFFFFFFFF
    l.N13 = (l.N13 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M12, l.N12, rrp(M0, mA), rrp(N0, mA))
    l.M12 = im
    l.N12 = in2
    var (jm, jn2) = tadd2(l.M13, l.N13, rrp(M1, (mA + 7) & 31), rrp(N1, (mA + 7) & 31))
    l.M13 = jm
    l.N13 = jn2
    l.M12 = (l.M12 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N13 = (l.N13 ^ rrp(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

func ring16b_sponge_c(l: Lanes16b, r: i64
            , skey: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes16b {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M14, l.N14,
                    rrp(l.M14, rA), rrp(l.N14, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp(l.M15, (rB + 3) & 31), rrp(l.N15, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M15, l.N15,
                    rrp(l.M15, (rA + 5) & 31), rrp(l.N15, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp(l.M14, (rB + 10) & 31), rrp(l.N14, (rB + 10) & 31))
    l.M14 = s0m
    l.N14 = s0n
    l.M15 = s1m
    l.N15 = s1n
    var (p0m, p0n) = tmul2(s0m, s0n, s0m, s0n)
    l.M15 = (l.M15 ^ p0m) & 0xFFFFFFFF
    l.N15 = (l.N15 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s1m, s1n)
    l.M14 = (l.M14 ^ p1m) & 0xFFFFFFFF
    l.N14 = (l.N14 ^ p1n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s0m, s0n)
    l.M15 = (l.M15 ^ maj) & 0xFFFFFFFF
    l.N15 = (l.N15 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    l.M14 = (l.M14 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N15 = (l.N15 ^ rrp(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

func ring16b_mixF(l: Lanes16b, r: i64
            , skey: i64
            ) -> Lanes16b {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0,
                    rrp(l.M2, rA), rrp(l.N2, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp(l.M3, (rB + 3) & 31), rrp(l.N3, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1,
                    rrp(l.M3, (rA + 5) & 31), rrp(l.N3, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp(l.M4, (rB + 10) & 31), rrp(l.N4, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M2, l.N2,
                    rrp(l.M4, (rA + 10) & 31), rrp(l.N4, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp(l.M5, (rB + 17) & 31), rrp(l.N5, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M3, l.N3,
                    rrp(l.M5, (rA + 15) & 31), rrp(l.N5, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp(l.M6, (rB + 24) & 31), rrp(l.N6, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M4, l.N4,
                    rrp(l.M6, (rA + 20) & 31), rrp(l.N6, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp(l.M7, (rB + 31) & 31), rrp(l.N7, (rB + 31) & 31))
    var (q5m, q5n) = tadd2(l.M5, l.N5,
                    rrp(l.M7, (rA + 25) & 31), rrp(l.N7, (rA + 25) & 31))
    var (s5m, s5n) = tadd2(q5m, q5n,
                    rrp(l.M8, (rB + 6) & 31), rrp(l.N8, (rB + 6) & 31))
    var (q6m, q6n) = tadd2(l.M6, l.N6,
                    rrp(l.M8, (rA + 30) & 31), rrp(l.N8, (rA + 30) & 31))
    var (s6m, s6n) = tadd2(q6m, q6n,
                    rrp(l.M9, (rB + 13) & 31), rrp(l.N9, (rB + 13) & 31))
    var (q7m, q7n) = tadd2(l.M7, l.N7,
                    rrp(l.M9, (rA + 3) & 31), rrp(l.N9, (rA + 3) & 31))
    var (s7m, s7n) = tadd2(q7m, q7n,
                    rrp(l.M10, (rB + 20) & 31), rrp(l.N10, (rB + 20) & 31))
    var (q8m, q8n) = tadd2(l.M8, l.N8,
                    rrp(l.M10, (rA + 8) & 31), rrp(l.N10, (rA + 8) & 31))
    var (s8m, s8n) = tadd2(q8m, q8n,
                    rrp(l.M11, (rB + 27) & 31), rrp(l.N11, (rB + 27) & 31))
    var (q9m, q9n) = tadd2(l.M9, l.N9,
                    rrp(l.M11, (rA + 13) & 31), rrp(l.N11, (rA + 13) & 31))
    var (s9m, s9n) = tadd2(q9m, q9n,
                    rrp(l.M12, (rB + 2) & 31), rrp(l.N12, (rB + 2) & 31))
    var (q10m, q10n) = tadd2(l.M10, l.N10,
                    rrp(l.M12, (rA + 18) & 31), rrp(l.N12, (rA + 18) & 31))
    var (s10m, s10n) = tadd2(q10m, q10n,
                    rrp(l.M13, (rB + 9) & 31), rrp(l.N13, (rB + 9) & 31))
    var (q11m, q11n) = tadd2(l.M11, l.N11,
                    rrp(l.M13, (rA + 23) & 31), rrp(l.N13, (rA + 23) & 31))
    var (s11m, s11n) = tadd2(q11m, q11n,
                    rrp(l.M14, (rB + 16) & 31), rrp(l.N14, (rB + 16) & 31))
    var (q12m, q12n) = tadd2(l.M12, l.N12,
                    rrp(l.M14, (rA + 28) & 31), rrp(l.N14, (rA + 28) & 31))
    var (s12m, s12n) = tadd2(q12m, q12n,
                    rrp(l.M15, (rB + 23) & 31), rrp(l.N15, (rB + 23) & 31))
    var (q13m, q13n) = tadd2(l.M13, l.N13,
                    rrp(l.M15, (rA + 1) & 31), rrp(l.N15, (rA + 1) & 31))
    var (s13m, s13n) = tadd2(q13m, q13n,
                    rrp(l.M0, (rB + 30) & 31), rrp(l.N0, (rB + 30) & 31))
    var (q14m, q14n) = tadd2(l.M14, l.N14,
                    rrp(l.M0, (rA + 6) & 31), rrp(l.N0, (rA + 6) & 31))
    var (s14m, s14n) = tadd2(q14m, q14n,
                    rrp(l.M1, (rB + 5) & 31), rrp(l.N1, (rB + 5) & 31))
    var (q15m, q15n) = tadd2(l.M15, l.N15,
                    rrp(l.M1, (rA + 11) & 31), rrp(l.N1, (rA + 11) & 31))
    var (s15m, s15n) = tadd2(q15m, q15n,
                    rrp(l.M2, (rB + 12) & 31), rrp(l.N2, (rB + 12) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    l.M2 = s2m
    l.N2 = s2n
    l.M3 = s3m
    l.N3 = s3n
    l.M4 = s4m
    l.N4 = s4n
    l.M5 = s5m
    l.N5 = s5n
    l.M6 = s6m
    l.N6 = s6n
    l.M7 = s7m
    l.N7 = s7n
    l.M8 = s8m
    l.N8 = s8n
    l.M9 = s9m
    l.N9 = s9n
    l.M10 = s10m
    l.N10 = s10n
    l.M11 = s11m
    l.N11 = s11n
    l.M12 = s12m
    l.N12 = s12n
    l.M13 = s13m
    l.N13 = s13n
    l.M14 = s14m
    l.N14 = s14n
    l.M15 = s15m
    l.N15 = s15n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M2 = (l.M2 ^ p1m) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M3 = (l.M3 ^ p2m) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s5m, s5n)
    l.M4 = (l.M4 ^ p3m) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s6m, s6n)
    l.M5 = (l.M5 ^ p4m) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ p4n) & 0xFFFFFFFF
    var (p5m, p5n) = tmul2(s5m, s5n, s7m, s7n)
    l.M6 = (l.M6 ^ p5m) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ p5n) & 0xFFFFFFFF
    var (p6m, p6n) = tmul2(s6m, s6n, s8m, s8n)
    l.M7 = (l.M7 ^ p6m) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ p6n) & 0xFFFFFFFF
    var (p7m, p7n) = tmul2(s7m, s7n, s9m, s9n)
    l.M8 = (l.M8 ^ p7m) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ p7n) & 0xFFFFFFFF
    var (p8m, p8n) = tmul2(s8m, s8n, s10m, s10n)
    l.M9 = (l.M9 ^ p8m) & 0xFFFFFFFF
    l.N9 = (l.N9 ^ p8n) & 0xFFFFFFFF
    var (p9m, p9n) = tmul2(s9m, s9n, s11m, s11n)
    l.M10 = (l.M10 ^ p9m) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ p9n) & 0xFFFFFFFF
    var (p10m, p10n) = tmul2(s10m, s10n, s12m, s12n)
    l.M11 = (l.M11 ^ p10m) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ p10n) & 0xFFFFFFFF
    var (p11m, p11n) = tmul2(s11m, s11n, s13m, s13n)
    l.M12 = (l.M12 ^ p11m) & 0xFFFFFFFF
    l.N12 = (l.N12 ^ p11n) & 0xFFFFFFFF
    var (p12m, p12n) = tmul2(s12m, s12n, s14m, s14n)
    l.M13 = (l.M13 ^ p12m) & 0xFFFFFFFF
    l.N13 = (l.N13 ^ p12n) & 0xFFFFFFFF
    var (p13m, p13n) = tmul2(s13m, s13n, s15m, s15n)
    l.M14 = (l.M14 ^ p13m) & 0xFFFFFFFF
    l.N14 = (l.N14 ^ p13n) & 0xFFFFFFFF
    var (p14m, p14n) = tmul2(s14m, s14n, s0m, s0n)
    l.M15 = (l.M15 ^ p14m) & 0xFFFFFFFF
    l.N15 = (l.N15 ^ p14n) & 0xFFFFFFFF
    var (p15m, p15n) = tmul2(s15m, s15n, s1m, s1n)
    l.M0 = (l.M0 ^ p15m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p15n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M15 = (l.M15 ^ maj) & 0xFFFFFFFF
    l.N15 = (l.N15 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    return l
}

func absorb16b(l: Lanes16b, Pw: Planes16, skey: i64) -> Lanes16b {
    var w: i64 = 0
    while w < 16 {
        var pv: i64 = 0
        if w == 0 {
            pv = Pw.w0
        } else if w == 1 {
            pv = Pw.w1
        } else if w == 2 {
            pv = Pw.w2
        } else if w == 3 {
            pv = Pw.w3
        } else if w == 4 {
            pv = Pw.w4
        } else if w == 5 {
            pv = Pw.w5
        } else if w == 6 {
            pv = Pw.w6
        } else if w == 7 {
            pv = Pw.w7
        } else if w == 8 {
            pv = Pw.w8
        } else if w == 9 {
            pv = Pw.w9
        } else if w == 10 {
            pv = Pw.w10
        } else if w == 11 {
            pv = Pw.w11
        } else if w == 12 {
            pv = Pw.w12
        } else if w == 13 {
            pv = Pw.w13
        } else if w == 14 {
            pv = Pw.w14
        } else {
            pv = Pw.w15
        }
        if pv != 0 {
            var a = (w * 5 + ((skey >> (w & 7)) & 7)) & 31
            var an = w % 16
            var v = rrp(pv, a)
            var v2 = rrp(pv, a + 17)
            if an == 0 {
                var (t0m, t0n) = tadd2(l.M0, l.N0, v, v2)
                l.M0 = t0m & 0xFFFFFFFF
                l.N0 = t0n & 0xFFFFFFFF
            } else if an == 1 {
                var (t1m, t1n) = tadd2(l.M1, l.N1, v, v2)
                l.M1 = t1m & 0xFFFFFFFF
                l.N1 = t1n & 0xFFFFFFFF
            } else if an == 2 {
                var (t2m, t2n) = tadd2(l.M2, l.N2, v, v2)
                l.M2 = t2m & 0xFFFFFFFF
                l.N2 = t2n & 0xFFFFFFFF
            } else if an == 3 {
                var (t3m, t3n) = tadd2(l.M3, l.N3, v, v2)
                l.M3 = t3m & 0xFFFFFFFF
                l.N3 = t3n & 0xFFFFFFFF
            } else if an == 4 {
                var (t4m, t4n) = tadd2(l.M4, l.N4, v, v2)
                l.M4 = t4m & 0xFFFFFFFF
                l.N4 = t4n & 0xFFFFFFFF
            } else if an == 5 {
                var (t5m, t5n) = tadd2(l.M5, l.N5, v, v2)
                l.M5 = t5m & 0xFFFFFFFF
                l.N5 = t5n & 0xFFFFFFFF
            } else if an == 6 {
                var (t6m, t6n) = tadd2(l.M6, l.N6, v, v2)
                l.M6 = t6m & 0xFFFFFFFF
                l.N6 = t6n & 0xFFFFFFFF
            } else if an == 7 {
                var (t7m, t7n) = tadd2(l.M7, l.N7, v, v2)
                l.M7 = t7m & 0xFFFFFFFF
                l.N7 = t7n & 0xFFFFFFFF
            } else if an == 8 {
                var (t8m, t8n) = tadd2(l.M8, l.N8, v, v2)
                l.M8 = t8m & 0xFFFFFFFF
                l.N8 = t8n & 0xFFFFFFFF
            } else if an == 9 {
                var (t9m, t9n) = tadd2(l.M9, l.N9, v, v2)
                l.M9 = t9m & 0xFFFFFFFF
                l.N9 = t9n & 0xFFFFFFFF
            } else if an == 10 {
                var (t10m, t10n) = tadd2(l.M10, l.N10, v, v2)
                l.M10 = t10m & 0xFFFFFFFF
                l.N10 = t10n & 0xFFFFFFFF
            } else if an == 11 {
                var (t11m, t11n) = tadd2(l.M11, l.N11, v, v2)
                l.M11 = t11m & 0xFFFFFFFF
                l.N11 = t11n & 0xFFFFFFFF
            } else if an == 12 {
                var (t12m, t12n) = tadd2(l.M12, l.N12, v, v2)
                l.M12 = t12m & 0xFFFFFFFF
                l.N12 = t12n & 0xFFFFFFFF
            } else if an == 13 {
                var (t13m, t13n) = tadd2(l.M13, l.N13, v, v2)
                l.M13 = t13m & 0xFFFFFFFF
                l.N13 = t13n & 0xFFFFFFFF
            } else if an == 14 {
                var (t14m, t14n) = tadd2(l.M14, l.N14, v, v2)
                l.M14 = t14m & 0xFFFFFFFF
                l.N14 = t14n & 0xFFFFFFFF
            } else {
                var (t15m, t15n) = tadd2(l.M15, l.N15, v, v2)
                l.M15 = t15m & 0xFFFFFFFF
                l.N15 = t15n & 0xFFFFFFFF
            }
        }
        w = w + 1
    }
    return l
}

func fin_synth16b(h: ref table<i64>) {
    var l = Lanes16b()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp(h[1], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp(h[2], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp(h[3], 7)
    l.M3 = h[3] & 0xFFFFFFFF
    l.N3 = rrp(h[4], 7)
    l.M4 = h[4] & 0xFFFFFFFF
    l.N4 = rrp(h[5], 7)
    l.M5 = h[5] & 0xFFFFFFFF
    l.N5 = rrp(h[6], 7)
    l.M6 = h[6] & 0xFFFFFFFF
    l.N6 = rrp(h[7], 7)
    l.M7 = h[7] & 0xFFFFFFFF
    l.N7 = rrp(h[8], 7)
    l.M8 = h[8] & 0xFFFFFFFF
    l.N8 = rrp(h[9], 7)
    l.M9 = h[9] & 0xFFFFFFFF
    l.N9 = rrp(h[10], 7)
    l.M10 = h[10] & 0xFFFFFFFF
    l.N10 = rrp(h[11], 7)
    l.M11 = h[11] & 0xFFFFFFFF
    l.N11 = rrp(h[12], 7)
    l.M12 = h[12] & 0xFFFFFFFF
    l.N12 = rrp(h[13], 7)
    l.M13 = h[13] & 0xFFFFFFFF
    l.N13 = rrp(h[14], 7)
    l.M14 = h[14] & 0xFFFFFFFF
    l.N14 = rrp(h[15], 7)
    l.M15 = h[15] & 0xFFFFFFFF
    l.N15 = rrp(h[0], 7)
    var sf: i64 = 0
    while sf < 4 {
        l = ring16b_mixF(l, sf, 0x13579BDF)
        sf = sf + 1
    }
    h[0] = (l.M0 ^ rrp(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (l.M1 ^ rrp(l.N1, 5)) & 0xFFFFFFFF
    h[2] = (l.M2 ^ rrp(l.N2, 10)) & 0xFFFFFFFF
    h[3] = (l.M3 ^ rrp(l.N3, 15)) & 0xFFFFFFFF
    h[4] = (l.M4 ^ rrp(l.N4, 20)) & 0xFFFFFFFF
    h[5] = (l.M5 ^ rrp(l.N5, 25)) & 0xFFFFFFFF
    h[6] = (l.M6 ^ rrp(l.N6, 30)) & 0xFFFFFFFF
    h[7] = (l.M7 ^ rrp(l.N7, 3)) & 0xFFFFFFFF
    h[8] = (l.M8 ^ rrp(l.N8, 8)) & 0xFFFFFFFF
    h[9] = (l.M9 ^ rrp(l.N9, 13)) & 0xFFFFFFFF
    h[10] = (l.M10 ^ rrp(l.N10, 18)) & 0xFFFFFFFF
    h[11] = (l.M11 ^ rrp(l.N11, 23)) & 0xFFFFFFFF
    h[12] = (l.M12 ^ rrp(l.N12, 28)) & 0xFFFFFFFF
    h[13] = (l.M13 ^ rrp(l.N13, 1)) & 0xFFFFFFFF
    h[14] = (l.M14 ^ rrp(l.N14, 6)) & 0xFFFFFFFF
    h[15] = (l.M15 ^ rrp(l.N15, 11)) & 0xFFFFFFFF
}

pub func compress_w16b(h: ref table<i64>, msg: string, pos: i64, nbytes: i64,
            t_lo: i64, t_hi: i64, last: bool,
            iv: table<i64>, rcon: table<i64>, bcon: table<i64>, R: i64) {
    var (M0, N0, M1, N1, Pw, skey) = w48_planes_skey(msg, pos, nbytes)
    var l = Lanes16b()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp(h[8], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp(h[9], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp(h[10], 7)
    l.M3 = h[3] & 0xFFFFFFFF
    l.N3 = rrp(h[11], 7)
    l.M4 = h[4] & 0xFFFFFFFF
    l.N4 = rrp(h[12], 7)
    l.M5 = h[5] & 0xFFFFFFFF
    l.N5 = rrp(h[13], 7)
    l.M6 = h[6] & 0xFFFFFFFF
    l.N6 = rrp(h[14], 7)
    l.M7 = h[7] & 0xFFFFFFFF
    l.N7 = rrp(h[15], 7)
    l.M8 = h[8] & 0xFFFFFFFF
    l.N8 = rrp(h[0], 7)
    l.M9 = h[9] & 0xFFFFFFFF
    l.N9 = rrp(h[1], 7)
    l.M10 = h[10] & 0xFFFFFFFF
    l.N10 = rrp(h[2], 7)
    l.M11 = h[11] & 0xFFFFFFFF
    l.N11 = rrp(h[3], 7)
    l.M12 = h[12] & 0xFFFFFFFF
    l.N12 = rrp(h[4], 7)
    l.M13 = h[13] & 0xFFFFFFFF
    l.N13 = rrp(h[5], 7)
    l.M14 = h[14] & 0xFFFFFFFF
    l.N14 = rrp(h[6], 7)
    l.M15 = h[15] & 0xFFFFFFFF
    l.N15 = rrp(h[7], 7)
    l.M0 = (l.M0 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M1 = (l.M1 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M2 = (l.M2 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M3 = (l.M3 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M4 = (l.M4 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M5 = (l.M5 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M6 = (l.M6 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M7 = (l.M7 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M8 = (l.M8 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M9 = (l.M9 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N9 = (l.N9 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M10 = (l.M10 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M11 = (l.M11 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M12 = (l.M12 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N12 = (l.N12 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M13 = (l.M13 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N13 = (l.N13 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M14 = (l.M14 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N14 = (l.N14 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M15 = (l.M15 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N15 = (l.N15 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (t_lo & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ (t_hi & 0xFFFFFFFF)) & 0xFFFFFFFF
    if last {
        l.N8 = (l.N8 ^ 0xFFFFFFFF) & 0xFFFFFFFF
    }
    l = absorb16b(l, Pw, skey)
    var mA: i64 = 0
    var mC: i64 = 0
    var r: i64 = 0
    while r < R {
        mA = (r * 5 + ((skey >> 6) & 7)) & 31
        mC = (r * 7 + ((skey >> 12) & 7)) & 31
        l = ring16b_mixA(l, r, skey, M0, N0, M1, N1, mA, rcon, r)
        l = ring16b_mixB(l, r, skey, M0, N0, M1, N1, mC, rcon, (r + 8) & 15)
        l = ring16b_sponge_r(l, r, skey, M0, N0, M1, N1, mA, bcon, (r + 3) & 15)
        l = ring16b_sponge_c(l, r, skey, bcon, (r + 11) & 15)
            var (sm, sn) = tadd2(l.M0, l.N0, l.M12, l.N12)
    l.M0 = sm
    l.N0 = sn
    var (pm, pn) = tmul2(l.M0, l.N0, l.M12, l.N12)
    l.M12 = (l.M12 ^ pm) & 0xFFFFFFFF
    l.N12 = (l.N12 ^ pn) & 0xFFFFFFFF
            var (sm, sn) = tadd2(l.M6, l.N6, l.M13, l.N13)
    l.M6 = sm
    l.N6 = sn
    var (pm, pn) = tmul2(l.M6, l.N6, l.M13, l.N13)
    l.M13 = (l.M13 ^ pm) & 0xFFFFFFFF
    l.N13 = (l.N13 ^ pn) & 0xFFFFFFFF
            var (sm, sn) = tadd2(l.M1, l.N1, l.M14, l.N14)
    l.M1 = sm
    l.N1 = sn
    var (pm, pn) = tmul2(l.M1, l.N1, l.M14, l.N14)
    l.M14 = (l.M14 ^ pm) & 0xFFFFFFFF
    l.N14 = (l.N14 ^ pn) & 0xFFFFFFFF
            var (sm, sn) = tadd2(l.M7, l.N7, l.M15, l.N15)
    l.M7 = sm
    l.N7 = sn
    var (pm, pn) = tmul2(l.M7, l.N7, l.M15, l.N15)
    l.M15 = (l.M15 ^ pm) & 0xFFFFFFFF
    l.N15 = (l.N15 ^ pn) & 0xFFFFFFFF
        r = r + 1
    }
    h[0] = (h[0] ^ l.M0 ^ rrp(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (h[1] ^ l.M1 ^ rrp(l.N1, 3)) & 0xFFFFFFFF
    h[2] = (h[2] ^ l.M2 ^ rrp(l.N2, 6)) & 0xFFFFFFFF
    h[3] = (h[3] ^ l.M3 ^ rrp(l.N3, 9)) & 0xFFFFFFFF
    h[4] = (h[4] ^ l.M4 ^ rrp(l.N4, 12)) & 0xFFFFFFFF
    h[5] = (h[5] ^ l.M5 ^ rrp(l.N5, 15)) & 0xFFFFFFFF
    h[6] = (h[6] ^ l.M6 ^ rrp(l.N6, 18)) & 0xFFFFFFFF
    h[7] = (h[7] ^ l.M7 ^ rrp(l.N7, 21)) & 0xFFFFFFFF
    h[8] = (h[8] ^ l.M8 ^ rrp(l.N8, 24)) & 0xFFFFFFFF
    h[9] = (h[9] ^ l.M9 ^ rrp(l.N9, 27)) & 0xFFFFFFFF
    h[10] = (h[10] ^ l.M10 ^ rrp(l.N10, 30)) & 0xFFFFFFFF
    h[11] = (h[11] ^ l.M11 ^ rrp(l.N11, 1)) & 0xFFFFFFFF
    h[12] = (h[12] ^ l.M12 ^ rrp(l.N12, 4)) & 0xFFFFFFFF
    h[13] = (h[13] ^ l.M13 ^ rrp(l.N13, 7)) & 0xFFFFFFFF
    h[14] = (h[14] ^ l.M14 ^ rrp(l.N14, 10)) & 0xFFFFFFFF
    h[15] = (h[15] ^ l.M15 ^ rrp(l.N15, 13)) & 0xFFFFFFFF
    fin_synth16b(h)
}

// === W=17 三轨特化内核（b，n=88/92/96/128/144）——轨A[0..6)、轨B[6..12)、海绵[12..17) rate2=3；R=14 ===
struct Lanes17b {
    var M0: i64 = 0
    var N0: i64 = 0
    var M1: i64 = 0
    var N1: i64 = 0
    var M2: i64 = 0
    var N2: i64 = 0
    var M3: i64 = 0
    var N3: i64 = 0
    var M4: i64 = 0
    var N4: i64 = 0
    var M5: i64 = 0
    var N5: i64 = 0
    var M6: i64 = 0
    var N6: i64 = 0
    var M7: i64 = 0
    var N7: i64 = 0
    var M8: i64 = 0
    var N8: i64 = 0
    var M9: i64 = 0
    var N9: i64 = 0
    var M10: i64 = 0
    var N10: i64 = 0
    var M11: i64 = 0
    var N11: i64 = 0
    var M12: i64 = 0
    var N12: i64 = 0
    var M13: i64 = 0
    var N13: i64 = 0
    var M14: i64 = 0
    var N14: i64 = 0
    var M15: i64 = 0
    var N15: i64 = 0
    var M16: i64 = 0
    var N16: i64 = 0
}

func ring17b_mixA(l: Lanes17b, r: i64
            , skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes17b {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0,
                    rrp(l.M2, rA), rrp(l.N2, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp(l.M3, (rB + 3) & 31), rrp(l.N3, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1,
                    rrp(l.M3, (rA + 5) & 31), rrp(l.N3, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp(l.M4, (rB + 10) & 31), rrp(l.N4, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M2, l.N2,
                    rrp(l.M4, (rA + 10) & 31), rrp(l.N4, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp(l.M5, (rB + 17) & 31), rrp(l.N5, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M3, l.N3,
                    rrp(l.M5, (rA + 15) & 31), rrp(l.N5, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp(l.M0, (rB + 24) & 31), rrp(l.N0, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M4, l.N4,
                    rrp(l.M0, (rA + 20) & 31), rrp(l.N0, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp(l.M1, (rB + 31) & 31), rrp(l.N1, (rB + 31) & 31))
    var (q5m, q5n) = tadd2(l.M5, l.N5,
                    rrp(l.M1, (rA + 25) & 31), rrp(l.N1, (rA + 25) & 31))
    var (s5m, s5n) = tadd2(q5m, q5n,
                    rrp(l.M2, (rB + 6) & 31), rrp(l.N2, (rB + 6) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    l.M2 = s2m
    l.N2 = s2n
    l.M3 = s3m
    l.N3 = s3n
    l.M4 = s4m
    l.N4 = s4n
    l.M5 = s5m
    l.N5 = s5n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M2 = (l.M2 ^ p1m) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M3 = (l.M3 ^ p2m) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s5m, s5n)
    l.M4 = (l.M4 ^ p3m) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s0m, s0n)
    l.M5 = (l.M5 ^ p4m) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ p4n) & 0xFFFFFFFF
    var (p5m, p5n) = tmul2(s5m, s5n, s1m, s1n)
    l.M0 = (l.M0 ^ p5m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p5n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M5 = (l.M5 ^ maj) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M0, l.N0, rrp(M0, mA), rrp(N0, mA))
    l.M0 = im
    l.N0 = in2
    var (jm, jn2) = tadd2(l.M1, l.N1, rrp(M1, (mA + 7) & 31), rrp(N1, (mA + 7) & 31))
    l.M1 = jm
    l.N1 = jn2
    l.M0 = (l.M0 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ rrp(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

func ring17b_mixB(l: Lanes17b, r: i64
            , skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes17b {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M6, l.N6,
                    rrp(l.M8, rA), rrp(l.N8, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp(l.M9, (rB + 3) & 31), rrp(l.N9, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M7, l.N7,
                    rrp(l.M9, (rA + 5) & 31), rrp(l.N9, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp(l.M10, (rB + 10) & 31), rrp(l.N10, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M8, l.N8,
                    rrp(l.M10, (rA + 10) & 31), rrp(l.N10, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp(l.M11, (rB + 17) & 31), rrp(l.N11, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M9, l.N9,
                    rrp(l.M11, (rA + 15) & 31), rrp(l.N11, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp(l.M6, (rB + 24) & 31), rrp(l.N6, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M10, l.N10,
                    rrp(l.M6, (rA + 20) & 31), rrp(l.N6, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp(l.M7, (rB + 31) & 31), rrp(l.N7, (rB + 31) & 31))
    var (q5m, q5n) = tadd2(l.M11, l.N11,
                    rrp(l.M7, (rA + 25) & 31), rrp(l.N7, (rA + 25) & 31))
    var (s5m, s5n) = tadd2(q5m, q5n,
                    rrp(l.M8, (rB + 6) & 31), rrp(l.N8, (rB + 6) & 31))
    l.M6 = s0m
    l.N6 = s0n
    l.M7 = s1m
    l.N7 = s1n
    l.M8 = s2m
    l.N8 = s2n
    l.M9 = s3m
    l.N9 = s3n
    l.M10 = s4m
    l.N10 = s4n
    l.M11 = s5m
    l.N11 = s5n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M7 = (l.M7 ^ p0m) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M8 = (l.M8 ^ p1m) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M9 = (l.M9 ^ p2m) & 0xFFFFFFFF
    l.N9 = (l.N9 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s5m, s5n)
    l.M10 = (l.M10 ^ p3m) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s0m, s0n)
    l.M11 = (l.M11 ^ p4m) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ p4n) & 0xFFFFFFFF
    var (p5m, p5n) = tmul2(s5m, s5n, s1m, s1n)
    l.M6 = (l.M6 ^ p5m) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ p5n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M11 = (l.M11 ^ maj) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M6, l.N6, rrp(M0, mA), rrp(N0, mA))
    l.M6 = im
    l.N6 = in2
    var (jm, jn2) = tadd2(l.M7, l.N7, rrp(M1, (mA + 7) & 31), rrp(N1, (mA + 7) & 31))
    l.M7 = jm
    l.N7 = jn2
    l.M6 = (l.M6 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ rrp(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

func ring17b_sponge_r(l: Lanes17b, r: i64
            , skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes17b {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M12, l.N12,
                    rrp(l.M14, rA), rrp(l.N14, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp(l.M12, (rB + 3) & 31), rrp(l.N12, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M13, l.N13,
                    rrp(l.M12, (rA + 5) & 31), rrp(l.N12, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp(l.M13, (rB + 10) & 31), rrp(l.N13, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M14, l.N14,
                    rrp(l.M13, (rA + 10) & 31), rrp(l.N13, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp(l.M14, (rB + 17) & 31), rrp(l.N14, (rB + 17) & 31))
    l.M12 = s0m
    l.N12 = s0n
    l.M13 = s1m
    l.N13 = s1n
    l.M14 = s2m
    l.N14 = s2n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M13 = (l.M13 ^ p0m) & 0xFFFFFFFF
    l.N13 = (l.N13 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s0m, s0n)
    l.M14 = (l.M14 ^ p1m) & 0xFFFFFFFF
    l.N14 = (l.N14 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s1m, s1n)
    l.M12 = (l.M12 ^ p2m) & 0xFFFFFFFF
    l.N12 = (l.N12 ^ p2n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M14 = (l.M14 ^ maj) & 0xFFFFFFFF
    l.N14 = (l.N14 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M12, l.N12, rrp(M0, mA), rrp(N0, mA))
    l.M12 = im
    l.N12 = in2
    var (jm, jn2) = tadd2(l.M13, l.N13, rrp(M1, (mA + 7) & 31), rrp(N1, (mA + 7) & 31))
    l.M13 = jm
    l.N13 = jn2
    l.M12 = (l.M12 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N14 = (l.N14 ^ rrp(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

func ring17b_sponge_c(l: Lanes17b, r: i64
            , skey: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes17b {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M15, l.N15,
                    rrp(l.M15, rA), rrp(l.N15, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp(l.M16, (rB + 3) & 31), rrp(l.N16, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M16, l.N16,
                    rrp(l.M16, (rA + 5) & 31), rrp(l.N16, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp(l.M15, (rB + 10) & 31), rrp(l.N15, (rB + 10) & 31))
    l.M15 = s0m
    l.N15 = s0n
    l.M16 = s1m
    l.N16 = s1n
    var (p0m, p0n) = tmul2(s0m, s0n, s0m, s0n)
    l.M16 = (l.M16 ^ p0m) & 0xFFFFFFFF
    l.N16 = (l.N16 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s1m, s1n)
    l.M15 = (l.M15 ^ p1m) & 0xFFFFFFFF
    l.N15 = (l.N15 ^ p1n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s0m, s0n)
    l.M16 = (l.M16 ^ maj) & 0xFFFFFFFF
    l.N16 = (l.N16 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    l.M15 = (l.M15 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N16 = (l.N16 ^ rrp(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

func ring17b_mixF(l: Lanes17b, r: i64
            , skey: i64
            ) -> Lanes17b {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0,
                    rrp(l.M2, rA), rrp(l.N2, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp(l.M3, (rB + 3) & 31), rrp(l.N3, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1,
                    rrp(l.M3, (rA + 5) & 31), rrp(l.N3, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp(l.M4, (rB + 10) & 31), rrp(l.N4, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M2, l.N2,
                    rrp(l.M4, (rA + 10) & 31), rrp(l.N4, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp(l.M5, (rB + 17) & 31), rrp(l.N5, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M3, l.N3,
                    rrp(l.M5, (rA + 15) & 31), rrp(l.N5, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp(l.M6, (rB + 24) & 31), rrp(l.N6, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M4, l.N4,
                    rrp(l.M6, (rA + 20) & 31), rrp(l.N6, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp(l.M7, (rB + 31) & 31), rrp(l.N7, (rB + 31) & 31))
    var (q5m, q5n) = tadd2(l.M5, l.N5,
                    rrp(l.M7, (rA + 25) & 31), rrp(l.N7, (rA + 25) & 31))
    var (s5m, s5n) = tadd2(q5m, q5n,
                    rrp(l.M8, (rB + 6) & 31), rrp(l.N8, (rB + 6) & 31))
    var (q6m, q6n) = tadd2(l.M6, l.N6,
                    rrp(l.M8, (rA + 30) & 31), rrp(l.N8, (rA + 30) & 31))
    var (s6m, s6n) = tadd2(q6m, q6n,
                    rrp(l.M9, (rB + 13) & 31), rrp(l.N9, (rB + 13) & 31))
    var (q7m, q7n) = tadd2(l.M7, l.N7,
                    rrp(l.M9, (rA + 3) & 31), rrp(l.N9, (rA + 3) & 31))
    var (s7m, s7n) = tadd2(q7m, q7n,
                    rrp(l.M10, (rB + 20) & 31), rrp(l.N10, (rB + 20) & 31))
    var (q8m, q8n) = tadd2(l.M8, l.N8,
                    rrp(l.M10, (rA + 8) & 31), rrp(l.N10, (rA + 8) & 31))
    var (s8m, s8n) = tadd2(q8m, q8n,
                    rrp(l.M11, (rB + 27) & 31), rrp(l.N11, (rB + 27) & 31))
    var (q9m, q9n) = tadd2(l.M9, l.N9,
                    rrp(l.M11, (rA + 13) & 31), rrp(l.N11, (rA + 13) & 31))
    var (s9m, s9n) = tadd2(q9m, q9n,
                    rrp(l.M12, (rB + 2) & 31), rrp(l.N12, (rB + 2) & 31))
    var (q10m, q10n) = tadd2(l.M10, l.N10,
                    rrp(l.M12, (rA + 18) & 31), rrp(l.N12, (rA + 18) & 31))
    var (s10m, s10n) = tadd2(q10m, q10n,
                    rrp(l.M13, (rB + 9) & 31), rrp(l.N13, (rB + 9) & 31))
    var (q11m, q11n) = tadd2(l.M11, l.N11,
                    rrp(l.M13, (rA + 23) & 31), rrp(l.N13, (rA + 23) & 31))
    var (s11m, s11n) = tadd2(q11m, q11n,
                    rrp(l.M14, (rB + 16) & 31), rrp(l.N14, (rB + 16) & 31))
    var (q12m, q12n) = tadd2(l.M12, l.N12,
                    rrp(l.M14, (rA + 28) & 31), rrp(l.N14, (rA + 28) & 31))
    var (s12m, s12n) = tadd2(q12m, q12n,
                    rrp(l.M15, (rB + 23) & 31), rrp(l.N15, (rB + 23) & 31))
    var (q13m, q13n) = tadd2(l.M13, l.N13,
                    rrp(l.M15, (rA + 1) & 31), rrp(l.N15, (rA + 1) & 31))
    var (s13m, s13n) = tadd2(q13m, q13n,
                    rrp(l.M16, (rB + 30) & 31), rrp(l.N16, (rB + 30) & 31))
    var (q14m, q14n) = tadd2(l.M14, l.N14,
                    rrp(l.M16, (rA + 6) & 31), rrp(l.N16, (rA + 6) & 31))
    var (s14m, s14n) = tadd2(q14m, q14n,
                    rrp(l.M0, (rB + 5) & 31), rrp(l.N0, (rB + 5) & 31))
    var (q15m, q15n) = tadd2(l.M15, l.N15,
                    rrp(l.M0, (rA + 11) & 31), rrp(l.N0, (rA + 11) & 31))
    var (s15m, s15n) = tadd2(q15m, q15n,
                    rrp(l.M1, (rB + 12) & 31), rrp(l.N1, (rB + 12) & 31))
    var (q16m, q16n) = tadd2(l.M16, l.N16,
                    rrp(l.M1, (rA + 16) & 31), rrp(l.N1, (rA + 16) & 31))
    var (s16m, s16n) = tadd2(q16m, q16n,
                    rrp(l.M2, (rB + 19) & 31), rrp(l.N2, (rB + 19) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    l.M2 = s2m
    l.N2 = s2n
    l.M3 = s3m
    l.N3 = s3n
    l.M4 = s4m
    l.N4 = s4n
    l.M5 = s5m
    l.N5 = s5n
    l.M6 = s6m
    l.N6 = s6n
    l.M7 = s7m
    l.N7 = s7n
    l.M8 = s8m
    l.N8 = s8n
    l.M9 = s9m
    l.N9 = s9n
    l.M10 = s10m
    l.N10 = s10n
    l.M11 = s11m
    l.N11 = s11n
    l.M12 = s12m
    l.N12 = s12n
    l.M13 = s13m
    l.N13 = s13n
    l.M14 = s14m
    l.N14 = s14n
    l.M15 = s15m
    l.N15 = s15n
    l.M16 = s16m
    l.N16 = s16n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M2 = (l.M2 ^ p1m) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M3 = (l.M3 ^ p2m) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s5m, s5n)
    l.M4 = (l.M4 ^ p3m) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s6m, s6n)
    l.M5 = (l.M5 ^ p4m) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ p4n) & 0xFFFFFFFF
    var (p5m, p5n) = tmul2(s5m, s5n, s7m, s7n)
    l.M6 = (l.M6 ^ p5m) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ p5n) & 0xFFFFFFFF
    var (p6m, p6n) = tmul2(s6m, s6n, s8m, s8n)
    l.M7 = (l.M7 ^ p6m) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ p6n) & 0xFFFFFFFF
    var (p7m, p7n) = tmul2(s7m, s7n, s9m, s9n)
    l.M8 = (l.M8 ^ p7m) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ p7n) & 0xFFFFFFFF
    var (p8m, p8n) = tmul2(s8m, s8n, s10m, s10n)
    l.M9 = (l.M9 ^ p8m) & 0xFFFFFFFF
    l.N9 = (l.N9 ^ p8n) & 0xFFFFFFFF
    var (p9m, p9n) = tmul2(s9m, s9n, s11m, s11n)
    l.M10 = (l.M10 ^ p9m) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ p9n) & 0xFFFFFFFF
    var (p10m, p10n) = tmul2(s10m, s10n, s12m, s12n)
    l.M11 = (l.M11 ^ p10m) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ p10n) & 0xFFFFFFFF
    var (p11m, p11n) = tmul2(s11m, s11n, s13m, s13n)
    l.M12 = (l.M12 ^ p11m) & 0xFFFFFFFF
    l.N12 = (l.N12 ^ p11n) & 0xFFFFFFFF
    var (p12m, p12n) = tmul2(s12m, s12n, s14m, s14n)
    l.M13 = (l.M13 ^ p12m) & 0xFFFFFFFF
    l.N13 = (l.N13 ^ p12n) & 0xFFFFFFFF
    var (p13m, p13n) = tmul2(s13m, s13n, s15m, s15n)
    l.M14 = (l.M14 ^ p13m) & 0xFFFFFFFF
    l.N14 = (l.N14 ^ p13n) & 0xFFFFFFFF
    var (p14m, p14n) = tmul2(s14m, s14n, s16m, s16n)
    l.M15 = (l.M15 ^ p14m) & 0xFFFFFFFF
    l.N15 = (l.N15 ^ p14n) & 0xFFFFFFFF
    var (p15m, p15n) = tmul2(s15m, s15n, s0m, s0n)
    l.M16 = (l.M16 ^ p15m) & 0xFFFFFFFF
    l.N16 = (l.N16 ^ p15n) & 0xFFFFFFFF
    var (p16m, p16n) = tmul2(s16m, s16n, s1m, s1n)
    l.M0 = (l.M0 ^ p16m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p16n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M16 = (l.M16 ^ maj) & 0xFFFFFFFF
    l.N16 = (l.N16 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    return l
}

func absorb17b(l: Lanes17b, Pw: Planes16, skey: i64) -> Lanes17b {
    var w: i64 = 0
    while w < 16 {
        var pv: i64 = 0
        if w == 0 {
            pv = Pw.w0
        } else if w == 1 {
            pv = Pw.w1
        } else if w == 2 {
            pv = Pw.w2
        } else if w == 3 {
            pv = Pw.w3
        } else if w == 4 {
            pv = Pw.w4
        } else if w == 5 {
            pv = Pw.w5
        } else if w == 6 {
            pv = Pw.w6
        } else if w == 7 {
            pv = Pw.w7
        } else if w == 8 {
            pv = Pw.w8
        } else if w == 9 {
            pv = Pw.w9
        } else if w == 10 {
            pv = Pw.w10
        } else if w == 11 {
            pv = Pw.w11
        } else if w == 12 {
            pv = Pw.w12
        } else if w == 13 {
            pv = Pw.w13
        } else if w == 14 {
            pv = Pw.w14
        } else {
            pv = Pw.w15
        }
        if pv != 0 {
            var a = (w * 5 + ((skey >> (w & 7)) & 7)) & 31
            var an = w % 17
            var v = rrp(pv, a)
            var v2 = rrp(pv, a + 17)
            if an == 0 {
                var (t0m, t0n) = tadd2(l.M0, l.N0, v, v2)
                l.M0 = t0m & 0xFFFFFFFF
                l.N0 = t0n & 0xFFFFFFFF
            } else if an == 1 {
                var (t1m, t1n) = tadd2(l.M1, l.N1, v, v2)
                l.M1 = t1m & 0xFFFFFFFF
                l.N1 = t1n & 0xFFFFFFFF
            } else if an == 2 {
                var (t2m, t2n) = tadd2(l.M2, l.N2, v, v2)
                l.M2 = t2m & 0xFFFFFFFF
                l.N2 = t2n & 0xFFFFFFFF
            } else if an == 3 {
                var (t3m, t3n) = tadd2(l.M3, l.N3, v, v2)
                l.M3 = t3m & 0xFFFFFFFF
                l.N3 = t3n & 0xFFFFFFFF
            } else if an == 4 {
                var (t4m, t4n) = tadd2(l.M4, l.N4, v, v2)
                l.M4 = t4m & 0xFFFFFFFF
                l.N4 = t4n & 0xFFFFFFFF
            } else if an == 5 {
                var (t5m, t5n) = tadd2(l.M5, l.N5, v, v2)
                l.M5 = t5m & 0xFFFFFFFF
                l.N5 = t5n & 0xFFFFFFFF
            } else if an == 6 {
                var (t6m, t6n) = tadd2(l.M6, l.N6, v, v2)
                l.M6 = t6m & 0xFFFFFFFF
                l.N6 = t6n & 0xFFFFFFFF
            } else if an == 7 {
                var (t7m, t7n) = tadd2(l.M7, l.N7, v, v2)
                l.M7 = t7m & 0xFFFFFFFF
                l.N7 = t7n & 0xFFFFFFFF
            } else if an == 8 {
                var (t8m, t8n) = tadd2(l.M8, l.N8, v, v2)
                l.M8 = t8m & 0xFFFFFFFF
                l.N8 = t8n & 0xFFFFFFFF
            } else if an == 9 {
                var (t9m, t9n) = tadd2(l.M9, l.N9, v, v2)
                l.M9 = t9m & 0xFFFFFFFF
                l.N9 = t9n & 0xFFFFFFFF
            } else if an == 10 {
                var (t10m, t10n) = tadd2(l.M10, l.N10, v, v2)
                l.M10 = t10m & 0xFFFFFFFF
                l.N10 = t10n & 0xFFFFFFFF
            } else if an == 11 {
                var (t11m, t11n) = tadd2(l.M11, l.N11, v, v2)
                l.M11 = t11m & 0xFFFFFFFF
                l.N11 = t11n & 0xFFFFFFFF
            } else if an == 12 {
                var (t12m, t12n) = tadd2(l.M12, l.N12, v, v2)
                l.M12 = t12m & 0xFFFFFFFF
                l.N12 = t12n & 0xFFFFFFFF
            } else if an == 13 {
                var (t13m, t13n) = tadd2(l.M13, l.N13, v, v2)
                l.M13 = t13m & 0xFFFFFFFF
                l.N13 = t13n & 0xFFFFFFFF
            } else if an == 14 {
                var (t14m, t14n) = tadd2(l.M14, l.N14, v, v2)
                l.M14 = t14m & 0xFFFFFFFF
                l.N14 = t14n & 0xFFFFFFFF
            } else if an == 15 {
                var (t15m, t15n) = tadd2(l.M15, l.N15, v, v2)
                l.M15 = t15m & 0xFFFFFFFF
                l.N15 = t15n & 0xFFFFFFFF
            } else {
                var (t16m, t16n) = tadd2(l.M16, l.N16, v, v2)
                l.M16 = t16m & 0xFFFFFFFF
                l.N16 = t16n & 0xFFFFFFFF
            }
        }
        w = w + 1
    }
    return l
}

func fin_synth17b(h: ref table<i64>) {
    var l = Lanes17b()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp(h[1], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp(h[2], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp(h[3], 7)
    l.M3 = h[3] & 0xFFFFFFFF
    l.N3 = rrp(h[4], 7)
    l.M4 = h[4] & 0xFFFFFFFF
    l.N4 = rrp(h[5], 7)
    l.M5 = h[5] & 0xFFFFFFFF
    l.N5 = rrp(h[6], 7)
    l.M6 = h[6] & 0xFFFFFFFF
    l.N6 = rrp(h[7], 7)
    l.M7 = h[7] & 0xFFFFFFFF
    l.N7 = rrp(h[8], 7)
    l.M8 = h[8] & 0xFFFFFFFF
    l.N8 = rrp(h[9], 7)
    l.M9 = h[9] & 0xFFFFFFFF
    l.N9 = rrp(h[10], 7)
    l.M10 = h[10] & 0xFFFFFFFF
    l.N10 = rrp(h[11], 7)
    l.M11 = h[11] & 0xFFFFFFFF
    l.N11 = rrp(h[12], 7)
    l.M12 = h[12] & 0xFFFFFFFF
    l.N12 = rrp(h[13], 7)
    l.M13 = h[13] & 0xFFFFFFFF
    l.N13 = rrp(h[14], 7)
    l.M14 = h[14] & 0xFFFFFFFF
    l.N14 = rrp(h[15], 7)
    l.M15 = h[15] & 0xFFFFFFFF
    l.N15 = rrp(h[16], 7)
    l.M16 = h[16] & 0xFFFFFFFF
    l.N16 = rrp(h[0], 7)
    var sf: i64 = 0
    while sf < 4 {
        l = ring17b_mixF(l, sf, 0x13579BDF)
        sf = sf + 1
    }
    h[0] = (l.M0 ^ rrp(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (l.M1 ^ rrp(l.N1, 5)) & 0xFFFFFFFF
    h[2] = (l.M2 ^ rrp(l.N2, 10)) & 0xFFFFFFFF
    h[3] = (l.M3 ^ rrp(l.N3, 15)) & 0xFFFFFFFF
    h[4] = (l.M4 ^ rrp(l.N4, 20)) & 0xFFFFFFFF
    h[5] = (l.M5 ^ rrp(l.N5, 25)) & 0xFFFFFFFF
    h[6] = (l.M6 ^ rrp(l.N6, 30)) & 0xFFFFFFFF
    h[7] = (l.M7 ^ rrp(l.N7, 3)) & 0xFFFFFFFF
    h[8] = (l.M8 ^ rrp(l.N8, 8)) & 0xFFFFFFFF
    h[9] = (l.M9 ^ rrp(l.N9, 13)) & 0xFFFFFFFF
    h[10] = (l.M10 ^ rrp(l.N10, 18)) & 0xFFFFFFFF
    h[11] = (l.M11 ^ rrp(l.N11, 23)) & 0xFFFFFFFF
    h[12] = (l.M12 ^ rrp(l.N12, 28)) & 0xFFFFFFFF
    h[13] = (l.M13 ^ rrp(l.N13, 1)) & 0xFFFFFFFF
    h[14] = (l.M14 ^ rrp(l.N14, 6)) & 0xFFFFFFFF
    h[15] = (l.M15 ^ rrp(l.N15, 11)) & 0xFFFFFFFF
    h[16] = (l.M16 ^ rrp(l.N16, 16)) & 0xFFFFFFFF
}

pub func compress_w17b(h: ref table<i64>, msg: string, pos: i64, nbytes: i64,
            t_lo: i64, t_hi: i64, last: bool,
            iv: table<i64>, rcon: table<i64>, bcon: table<i64>, R: i64) {
    var (M0, N0, M1, N1, Pw, skey) = w48_planes_skey(msg, pos, nbytes)
    var l = Lanes17b()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp(h[8], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp(h[9], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp(h[10], 7)
    l.M3 = h[3] & 0xFFFFFFFF
    l.N3 = rrp(h[11], 7)
    l.M4 = h[4] & 0xFFFFFFFF
    l.N4 = rrp(h[12], 7)
    l.M5 = h[5] & 0xFFFFFFFF
    l.N5 = rrp(h[13], 7)
    l.M6 = h[6] & 0xFFFFFFFF
    l.N6 = rrp(h[14], 7)
    l.M7 = h[7] & 0xFFFFFFFF
    l.N7 = rrp(h[15], 7)
    l.M8 = h[8] & 0xFFFFFFFF
    l.N8 = rrp(h[16], 7)
    l.M9 = h[9] & 0xFFFFFFFF
    l.N9 = rrp(h[0], 7)
    l.M10 = h[10] & 0xFFFFFFFF
    l.N10 = rrp(h[1], 7)
    l.M11 = h[11] & 0xFFFFFFFF
    l.N11 = rrp(h[2], 7)
    l.M12 = h[12] & 0xFFFFFFFF
    l.N12 = rrp(h[3], 7)
    l.M13 = h[13] & 0xFFFFFFFF
    l.N13 = rrp(h[4], 7)
    l.M14 = h[14] & 0xFFFFFFFF
    l.N14 = rrp(h[5], 7)
    l.M15 = h[15] & 0xFFFFFFFF
    l.N15 = rrp(h[6], 7)
    l.M16 = h[16] & 0xFFFFFFFF
    l.N16 = rrp(h[7], 7)
    l.M0 = (l.M0 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M1 = (l.M1 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M2 = (l.M2 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M3 = (l.M3 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M4 = (l.M4 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M5 = (l.M5 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M6 = (l.M6 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M7 = (l.M7 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M8 = (l.M8 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M9 = (l.M9 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N9 = (l.N9 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M10 = (l.M10 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M11 = (l.M11 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M12 = (l.M12 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N12 = (l.N12 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M13 = (l.M13 ^ (iv[5] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N13 = (l.N13 ^ (iv[1] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M14 = (l.M14 ^ (iv[6] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N14 = (l.N14 ^ (iv[2] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M15 = (l.M15 ^ (iv[7] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N15 = (l.N15 ^ (iv[3] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.M16 = (l.M16 ^ (iv[0] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N16 = (l.N16 ^ (iv[4] & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (t_lo & 0xFFFFFFFF)) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ (t_hi & 0xFFFFFFFF)) & 0xFFFFFFFF
    if last {
        l.N8 = (l.N8 ^ 0xFFFFFFFF) & 0xFFFFFFFF
    }
    l = absorb17b(l, Pw, skey)
    var mA: i64 = 0
    var mC: i64 = 0
    var r: i64 = 0
    while r < R {
        mA = (r * 5 + ((skey >> 6) & 7)) & 31
        mC = (r * 7 + ((skey >> 12) & 7)) & 31
        l = ring17b_mixA(l, r, skey, M0, N0, M1, N1, mA, rcon, r)
        l = ring17b_mixB(l, r, skey, M0, N0, M1, N1, mC, rcon, (r + 8) & 15)
        l = ring17b_sponge_r(l, r, skey, M0, N0, M1, N1, mA, bcon, (r + 3) & 15)
        l = ring17b_sponge_c(l, r, skey, bcon, (r + 11) & 15)
            var (sm, sn) = tadd2(l.M0, l.N0, l.M12, l.N12)
    l.M0 = sm
    l.N0 = sn
    var (pm, pn) = tmul2(l.M0, l.N0, l.M12, l.N12)
    l.M12 = (l.M12 ^ pm) & 0xFFFFFFFF
    l.N12 = (l.N12 ^ pn) & 0xFFFFFFFF
            var (sm, sn) = tadd2(l.M6, l.N6, l.M13, l.N13)
    l.M6 = sm
    l.N6 = sn
    var (pm, pn) = tmul2(l.M6, l.N6, l.M13, l.N13)
    l.M13 = (l.M13 ^ pm) & 0xFFFFFFFF
    l.N13 = (l.N13 ^ pn) & 0xFFFFFFFF
            var (sm, sn) = tadd2(l.M1, l.N1, l.M15, l.N15)
    l.M1 = sm
    l.N1 = sn
    var (pm, pn) = tmul2(l.M1, l.N1, l.M15, l.N15)
    l.M15 = (l.M15 ^ pm) & 0xFFFFFFFF
    l.N15 = (l.N15 ^ pn) & 0xFFFFFFFF
            var (sm, sn) = tadd2(l.M7, l.N7, l.M16, l.N16)
    l.M7 = sm
    l.N7 = sn
    var (pm, pn) = tmul2(l.M7, l.N7, l.M16, l.N16)
    l.M16 = (l.M16 ^ pm) & 0xFFFFFFFF
    l.N16 = (l.N16 ^ pn) & 0xFFFFFFFF
        r = r + 1
    }
    h[0] = (h[0] ^ l.M0 ^ rrp(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (h[1] ^ l.M1 ^ rrp(l.N1, 3)) & 0xFFFFFFFF
    h[2] = (h[2] ^ l.M2 ^ rrp(l.N2, 6)) & 0xFFFFFFFF
    h[3] = (h[3] ^ l.M3 ^ rrp(l.N3, 9)) & 0xFFFFFFFF
    h[4] = (h[4] ^ l.M4 ^ rrp(l.N4, 12)) & 0xFFFFFFFF
    h[5] = (h[5] ^ l.M5 ^ rrp(l.N5, 15)) & 0xFFFFFFFF
    h[6] = (h[6] ^ l.M6 ^ rrp(l.N6, 18)) & 0xFFFFFFFF
    h[7] = (h[7] ^ l.M7 ^ rrp(l.N7, 21)) & 0xFFFFFFFF
    h[8] = (h[8] ^ l.M8 ^ rrp(l.N8, 24)) & 0xFFFFFFFF
    h[9] = (h[9] ^ l.M9 ^ rrp(l.N9, 27)) & 0xFFFFFFFF
    h[10] = (h[10] ^ l.M10 ^ rrp(l.N10, 30)) & 0xFFFFFFFF
    h[11] = (h[11] ^ l.M11 ^ rrp(l.N11, 1)) & 0xFFFFFFFF
    h[12] = (h[12] ^ l.M12 ^ rrp(l.N12, 4)) & 0xFFFFFFFF
    h[13] = (h[13] ^ l.M13 ^ rrp(l.N13, 7)) & 0xFFFFFFFF
    h[14] = (h[14] ^ l.M14 ^ rrp(l.N14, 10)) & 0xFFFFFFFF
    h[15] = (h[15] ^ l.M15 ^ rrp(l.N15, 13)) & 0xFFFFFFFF
    h[16] = (h[16] ^ l.M16 ^ rrp(l.N16, 16)) & 0xFFFFFFFF
    fin_synth17b(h)
}

// === W=23 三轨特化内核（b，n=88/92/96/128/144）——轨A[0..8)、轨B[8..16)、海绵[16..23) rate2=4；R=14 ===
struct Lanes23b {
    var M0: i64 = 0
    var N0: i64 = 0
    var M1: i64 = 0
    var N1: i64 = 0
    var M2: i64 = 0
    var N2: i64 = 0
    var M3: i64 = 0
    var N3: i64 = 0
    var M4: i64 = 0
    var N4: i64 = 0
    var M5: i64 = 0
    var N5: i64 = 0
    var M6: i64 = 0
    var N6: i64 = 0
    var M7: i64 = 0
    var N7: i64 = 0
    var M8: i64 = 0
    var N8: i64 = 0
    var M9: i64 = 0
    var N9: i64 = 0
    var M10: i64 = 0
    var N10: i64 = 0
    var M11: i64 = 0
    var N11: i64 = 0
    var M12: i64 = 0
    var N12: i64 = 0
    var M13: i64 = 0
    var N13: i64 = 0
    var M14: i64 = 0
    var N14: i64 = 0
    var M15: i64 = 0
    var N15: i64 = 0
    var M16: i64 = 0
    var N16: i64 = 0
    var M17: i64 = 0
    var N17: i64 = 0
    var M18: i64 = 0
    var N18: i64 = 0
    var M19: i64 = 0
    var N19: i64 = 0
    var M20: i64 = 0
    var N20: i64 = 0
    var M21: i64 = 0
    var N21: i64 = 0
    var M22: i64 = 0
    var N22: i64 = 0
}

func ring23b_mixA(l: Lanes23b, r: i64
            , skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes23b {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0,
                    rrp(l.M2, rA), rrp(l.N2, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp(l.M3, (rB + 3) & 31), rrp(l.N3, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1,
                    rrp(l.M3, (rA + 5) & 31), rrp(l.N3, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp(l.M4, (rB + 10) & 31), rrp(l.N4, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M2, l.N2,
                    rrp(l.M4, (rA + 10) & 31), rrp(l.N4, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp(l.M5, (rB + 17) & 31), rrp(l.N5, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M3, l.N3,
                    rrp(l.M5, (rA + 15) & 31), rrp(l.N5, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp(l.M6, (rB + 24) & 31), rrp(l.N6, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M4, l.N4,
                    rrp(l.M6, (rA + 20) & 31), rrp(l.N6, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp(l.M7, (rB + 31) & 31), rrp(l.N7, (rB + 31) & 31))
    var (q5m, q5n) = tadd2(l.M5, l.N5,
                    rrp(l.M7, (rA + 25) & 31), rrp(l.N7, (rA + 25) & 31))
    var (s5m, s5n) = tadd2(q5m, q5n,
                    rrp(l.M0, (rB + 6) & 31), rrp(l.N0, (rB + 6) & 31))
    var (q6m, q6n) = tadd2(l.M6, l.N6,
                    rrp(l.M0, (rA + 30) & 31), rrp(l.N0, (rA + 30) & 31))
    var (s6m, s6n) = tadd2(q6m, q6n,
                    rrp(l.M1, (rB + 13) & 31), rrp(l.N1, (rB + 13) & 31))
    var (q7m, q7n) = tadd2(l.M7, l.N7,
                    rrp(l.M1, (rA + 3) & 31), rrp(l.N1, (rA + 3) & 31))
    var (s7m, s7n) = tadd2(q7m, q7n,
                    rrp(l.M2, (rB + 20) & 31), rrp(l.N2, (rB + 20) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    l.M2 = s2m
    l.N2 = s2n
    l.M3 = s3m
    l.N3 = s3n
    l.M4 = s4m
    l.N4 = s4n
    l.M5 = s5m
    l.N5 = s5n
    l.M6 = s6m
    l.N6 = s6n
    l.M7 = s7m
    l.N7 = s7n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M1 = (l.M1 ^ p0m) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M2 = (l.M2 ^ p1m) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M3 = (l.M3 ^ p2m) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s5m, s5n)
    l.M4 = (l.M4 ^ p3m) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s6m, s6n)
    l.M5 = (l.M5 ^ p4m) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ p4n) & 0xFFFFFFFF
    var (p5m, p5n) = tmul2(s5m, s5n, s7m, s7n)
    l.M6 = (l.M6 ^ p5m) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ p5n) & 0xFFFFFFFF
    var (p6m, p6n) = tmul2(s6m, s6n, s0m, s0n)
    l.M7 = (l.M7 ^ p6m) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ p6n) & 0xFFFFFFFF
    var (p7m, p7n) = tmul2(s7m, s7n, s1m, s1n)
    l.M0 = (l.M0 ^ p7m) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ p7n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M7 = (l.M7 ^ maj) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M0, l.N0, rrp(M0, mA), rrp(N0, mA))
    l.M0 = im
    l.N0 = in2
    var (jm, jn2) = tadd2(l.M1, l.N1, rrp(M1, (mA + 7) & 31), rrp(N1, (mA + 7) & 31))
    l.M1 = jm
    l.N1 = jn2
    l.M0 = (l.M0 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ rrp(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

func ring23b_mixB(l: Lanes23b, r: i64
            , skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes23b {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M8, l.N8,
                    rrp(l.M10, rA), rrp(l.N10, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp(l.M11, (rB + 3) & 31), rrp(l.N11, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M9, l.N9,
                    rrp(l.M11, (rA + 5) & 31), rrp(l.N11, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp(l.M12, (rB + 10) & 31), rrp(l.N12, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M10, l.N10,
                    rrp(l.M12, (rA + 10) & 31), rrp(l.N12, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp(l.M13, (rB + 17) & 31), rrp(l.N13, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M11, l.N11,
                    rrp(l.M13, (rA + 15) & 31), rrp(l.N13, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp(l.M14, (rB + 24) & 31), rrp(l.N14, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M12, l.N12,
                    rrp(l.M14, (rA + 20) & 31), rrp(l.N14, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp(l.M15, (rB + 31) & 31), rrp(l.N15, (rB + 31) & 31))
    var (q5m, q5n) = tadd2(l.M13, l.N13,
                    rrp(l.M15, (rA + 25) & 31), rrp(l.N15, (rA + 25) & 31))
    var (s5m, s5n) = tadd2(q5m, q5n,
                    rrp(l.M8, (rB + 6) & 31), rrp(l.N8, (rB + 6) & 31))
    var (q6m, q6n) = tadd2(l.M14, l.N14,
                    rrp(l.M8, (rA + 30) & 31), rrp(l.N8, (rA + 30) & 31))
    var (s6m, s6n) = tadd2(q6m, q6n,
                    rrp(l.M9, (rB + 13) & 31), rrp(l.N9, (rB + 13) & 31))
    var (q7m, q7n) = tadd2(l.M15, l.N15,
                    rrp(l.M9, (rA + 3) & 31), rrp(l.N9, (rA + 3) & 31))
    var (s7m, s7n) = tadd2(q7m, q7n,
                    rrp(l.M10, (rB + 20) & 31), rrp(l.N10, (rB + 20) & 31))
    l.M8 = s0m
    l.N8 = s0n
    l.M9 = s1m
    l.N9 = s1n
    l.M10 = s2m
    l.N10 = s2n
    l.M11 = s3m
    l.N11 = s3n
    l.M12 = s4m
    l.N12 = s4n
    l.M13 = s5m
    l.N13 = s5n
    l.M14 = s6m
    l.N14 = s6n
    l.M15 = s7m
    l.N15 = s7n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M9 = (l.M9 ^ p0m) & 0xFFFFFFFF
    l.N9 = (l.N9 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M10 = (l.M10 ^ p1m) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s4m, s4n)
    l.M11 = (l.M11 ^ p2m) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s5m, s5n)
    l.M12 = (l.M12 ^ p3m) & 0xFFFFFFFF
    l.N12 = (l.N12 ^ p3n) & 0xFFFFFFFF
    var (p4m, p4n) = tmul2(s4m, s4n, s6m, s6n)
    l.M13 = (l.M13 ^ p4m) & 0xFFFFFFFF
    l.N13 = (l.N13 ^ p4n) & 0xFFFFFFFF
    var (p5m, p5n) = tmul2(s5m, s5n, s7m, s7n)
    l.M14 = (l.M14 ^ p5m) & 0xFFFFFFFF
    l.N14 = (l.N14 ^ p5n) & 0xFFFFFFFF
    var (p6m, p6n) = tmul2(s6m, s6n, s0m, s0n)
    l.M15 = (l.M15 ^ p6m) & 0xFFFFFFFF
    l.N15 = (l.N15 ^ p6n) & 0xFFFFFFFF
    var (p7m, p7n) = tmul2(s7m, s7n, s1m, s1n)
    l.M8 = (l.M8 ^ p7m) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ p7n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M15 = (l.M15 ^ maj) & 0xFFFFFFFF
    l.N15 = (l.N15 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M8, l.N8, rrp(M0, mA), rrp(N0, mA))
    l.M8 = im
    l.N8 = in2
    var (jm, jn2) = tadd2(l.M9, l.N9, rrp(M1, (mA + 7) & 31), rrp(N1, (mA + 7) & 31))
    l.M9 = jm
    l.N9 = jn2
    l.M8 = (l.M8 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N15 = (l.N15 ^ rrp(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

func ring23b_sponge_r(l: Lanes23b, r: i64
            , skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes23b {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M16, l.N16,
                    rrp(l.M18, rA), rrp(l.N18, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp(l.M19, (rB + 3) & 31), rrp(l.N19, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M17, l.N17,
                    rrp(l.M19, (rA + 5) & 31), rrp(l.N19, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp(l.M16, (rB + 10) & 31), rrp(l.N16, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M18, l.N18,
                    rrp(l.M16, (rA + 10) & 31), rrp(l.N16, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp(l.M17, (rB + 17) & 31), rrp(l.N17, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M19, l.N19,
                    rrp(l.M17, (rA + 15) & 31), rrp(l.N17, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp(l.M18, (rB + 24) & 31), rrp(l.N18, (rB + 24) & 31))
    l.M16 = s0m
    l.N16 = s0n
    l.M17 = s1m
    l.N17 = s1n
    l.M18 = s2m
    l.N18 = s2n
    l.M19 = s3m
    l.N19 = s3n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M17 = (l.M17 ^ p0m) & 0xFFFFFFFF
    l.N17 = (l.N17 ^ p0n) & 0xFFFFFFFF
    var (p1m, p1n) = tmul2(s1m, s1n, s3m, s3n)
    l.M18 = (l.M18 ^ p1m) & 0xFFFFFFFF
    l.N18 = (l.N18 ^ p1n) & 0xFFFFFFFF
    var (p2m, p2n) = tmul2(s2m, s2n, s0m, s0n)
    l.M19 = (l.M19 ^ p2m) & 0xFFFFFFFF
    l.N19 = (l.N19 ^ p2n) & 0xFFFFFFFF
    var (p3m, p3n) = tmul2(s3m, s3n, s1m, s1n)
    l.M16 = (l.M16 ^ p3m) & 0xFFFFFFFF
    l.N16 = (l.N16 ^ p3n) & 0xFFFFFFFF
    var maj = quant3(s0m, s0n, s1m, s1n, s2m, s2n)
    l.M19 = (l.M19 ^ maj) & 0xFFFFFFFF
    l.N19 = (l.N19 ^ rrp(maj, (rB + 7) & 31)) & 0xFFFFFFFF
    var (im, in2) = tadd2(l.M16, l.N16, rrp(M0, mA), rrp(N0, mA))
    l.M16 = im
    l.N16 = in2
    var (jm, jn2) = tadd2(l.M17, l.N17, rrp(M1, (mA + 7) & 31), rrp(N1, (mA + 7) & 31))
    l.M17 = jm
    l.N17 = jn2
    l.M16 = (l.M16 ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    l.N19 = (l.N19 ^ rrp(rcon[(rcon_idx + 1) & 15], (r * 5) & 31)) & 0xFFFFFFFF
    return l
}

func ring23b_sponge_c(l: Lanes23b, r: i64
