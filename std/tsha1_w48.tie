    l.N27 = rrp16(h[28], 7)
    l.M28 = h[28] & 0xFFFFFFFF
    l.N28 = rrp16(h[0], 7)
    var sf: i64 = 0
    while sf < 4 {
        l = ring29h_mixF(l, sf, 0x13579BDF)
        sf = sf + 1
    }
    h[0] = (l.M0 ^ rrp16(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (l.M1 ^ rrp16(l.N1, 5)) & 0xFFFFFFFF
    h[2] = (l.M2 ^ rrp16(l.N2, 10)) & 0xFFFFFFFF
    h[3] = (l.M3 ^ rrp16(l.N3, 15)) & 0xFFFFFFFF
    h[4] = (l.M4 ^ rrp16(l.N4, 20)) & 0xFFFFFFFF
    h[5] = (l.M5 ^ rrp16(l.N5, 25)) & 0xFFFFFFFF
    h[6] = (l.M6 ^ rrp16(l.N6, 30)) & 0xFFFFFFFF
    h[7] = (l.M7 ^ rrp16(l.N7, 3)) & 0xFFFFFFFF
    h[8] = (l.M8 ^ rrp16(l.N8, 8)) & 0xFFFFFFFF
    h[9] = (l.M9 ^ rrp16(l.N9, 13)) & 0xFFFFFFFF
    h[10] = (l.M10 ^ rrp16(l.N10, 18)) & 0xFFFFFFFF
    h[11] = (l.M11 ^ rrp16(l.N11, 23)) & 0xFFFFFFFF
    h[12] = (l.M12 ^ rrp16(l.N12, 28)) & 0xFFFFFFFF
    h[13] = (l.M13 ^ rrp16(l.N13, 1)) & 0xFFFFFFFF
    h[14] = (l.M14 ^ rrp16(l.N14, 6)) & 0xFFFFFFFF
    h[15] = (l.M15 ^ rrp16(l.N15, 11)) & 0xFFFFFFFF
    h[16] = (l.M16 ^ rrp16(l.N16, 16)) & 0xFFFFFFFF
    h[17] = (l.M17 ^ rrp16(l.N17, 21)) & 0xFFFFFFFF
    h[18] = (l.M18 ^ rrp16(l.N18, 26)) & 0xFFFFFFFF
    h[19] = (l.M19 ^ rrp16(l.N19, 31)) & 0xFFFFFFFF
    h[20] = (l.M20 ^ rrp16(l.N20, 4)) & 0xFFFFFFFF
    h[21] = (l.M21 ^ rrp16(l.N21, 9)) & 0xFFFFFFFF
    h[22] = (l.M22 ^ rrp16(l.N22, 14)) & 0xFFFFFFFF
    h[23] = (l.M23 ^ rrp16(l.N23, 19)) & 0xFFFFFFFF
    h[24] = (l.M24 ^ rrp16(l.N24, 24)) & 0xFFFFFFFF
    h[25] = (l.M25 ^ rrp16(l.N25, 29)) & 0xFFFFFFFF
    h[26] = (l.M26 ^ rrp16(l.N26, 2)) & 0xFFFFFFFF
    h[27] = (l.M27 ^ rrp16(l.N27, 7)) & 0xFFFFFFFF
    h[28] = (l.M28 ^ rrp16(l.N28, 12)) & 0xFFFFFFFF
}

pub func compress_w29h(h: ref table<i64>, msg: string, pos: i64, nbytes: i64,
            t_lo: i64, t_hi: i64, last: bool,
            iv: table<i64>, rcon: table<i64>, R: i64) {
    var (M0, N0, M1, N1, Pw, skey) = w48_planes_skey(msg, pos, nbytes)
    var l = Lanes29h()
    l.M0 = h[0] & 0xFFFFFFFF
    l.N0 = rrp16(h[14], 7)
    l.M1 = h[1] & 0xFFFFFFFF
    l.N1 = rrp16(h[15], 7)
    l.M2 = h[2] & 0xFFFFFFFF
    l.N2 = rrp16(h[16], 7)
    l.M3 = h[3] & 0xFFFFFFFF
    l.N3 = rrp16(h[17], 7)
    l.M4 = h[4] & 0xFFFFFFFF
    l.N4 = rrp16(h[18], 7)
    l.M5 = h[5] & 0xFFFFFFFF
    l.N5 = rrp16(h[19], 7)
    l.M6 = h[6] & 0xFFFFFFFF
    l.N6 = rrp16(h[20], 7)
    l.M7 = h[7] & 0xFFFFFFFF
    l.N7 = rrp16(h[21], 7)
    l.M8 = h[8] & 0xFFFFFFFF
    l.N8 = rrp16(h[22], 7)
    l.M9 = h[9] & 0xFFFFFFFF
    l.N9 = rrp16(h[23], 7)
    l.M10 = h[10] & 0xFFFFFFFF
    l.N10 = rrp16(h[24], 7)
    l.M11 = h[11] & 0xFFFFFFFF
    l.N11 = rrp16(h[25], 7)
    l.M12 = h[12] & 0xFFFFFFFF
    l.N12 = rrp16(h[26], 7)
    l.M13 = h[13] & 0xFFFFFFFF
    l.N13 = rrp16(h[27], 7)
    l.M14 = h[14] & 0xFFFFFFFF
    l.N14 = rrp16(h[28], 7)
    l.M15 = h[15] & 0xFFFFFFFF
    l.N15 = rrp16(h[0], 7)
    l.M16 = h[16] & 0xFFFFFFFF
    l.N16 = rrp16(h[1], 7)
    l.M17 = h[17] & 0xFFFFFFFF
    l.N17 = rrp16(h[2], 7)
    l.M18 = h[18] & 0xFFFFFFFF
    l.N18 = rrp16(h[3], 7)
    l.M19 = h[19] & 0xFFFFFFFF
    l.N19 = rrp16(h[4], 7)
    l.M20 = h[20] & 0xFFFFFFFF
    l.N20 = rrp16(h[5], 7)
    l.M21 = h[21] & 0xFFFFFFFF
    l.N21 = rrp16(h[6], 7)
    l.M22 = h[22] & 0xFFFFFFFF
    l.N22 = rrp16(h[7], 7)
    l.M23 = h[23] & 0xFFFFFFFF
    l.N23 = rrp16(h[8], 7)
    l.M24 = h[24] & 0xFFFFFFFF
    l.N24 = rrp16(h[9], 7)
    l.M25 = h[25] & 0xFFFFFFFF
    l.N25 = rrp16(h[10], 7)
    l.M26 = h[26] & 0xFFFFFFFF
    l.N26 = rrp16(h[11], 7)
    l.M27 = h[27] & 0xFFFFFFFF
    l.N27 = rrp16(h[12], 7)
    l.M28 = h[28] & 0xFFFFFFFF
    l.N28 = rrp16(h[13], 7)
    l.M0 = (l.M0 ^ (iv[0] & 0xFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (iv[4] & 0xFFFF)) & 0xFFFFFFFF
    l.M1 = (l.M1 ^ (iv[1] & 0xFFFF)) & 0xFFFFFFFF
    l.N1 = (l.N1 ^ (iv[5] & 0xFFFF)) & 0xFFFFFFFF
    l.M2 = (l.M2 ^ (iv[2] & 0xFFFF)) & 0xFFFFFFFF
    l.N2 = (l.N2 ^ (iv[6] & 0xFFFF)) & 0xFFFFFFFF
    l.M3 = (l.M3 ^ (iv[3] & 0xFFFF)) & 0xFFFFFFFF
    l.N3 = (l.N3 ^ (iv[7] & 0xFFFF)) & 0xFFFFFFFF
    l.M4 = (l.M4 ^ (iv[4] & 0xFFFF)) & 0xFFFFFFFF
    l.N4 = (l.N4 ^ (iv[0] & 0xFFFF)) & 0xFFFFFFFF
    l.M5 = (l.M5 ^ (iv[5] & 0xFFFF)) & 0xFFFFFFFF
    l.N5 = (l.N5 ^ (iv[1] & 0xFFFF)) & 0xFFFFFFFF
    l.M6 = (l.M6 ^ (iv[6] & 0xFFFF)) & 0xFFFFFFFF
    l.N6 = (l.N6 ^ (iv[2] & 0xFFFF)) & 0xFFFFFFFF
    l.M7 = (l.M7 ^ (iv[7] & 0xFFFF)) & 0xFFFFFFFF
    l.N7 = (l.N7 ^ (iv[3] & 0xFFFF)) & 0xFFFFFFFF
    l.M8 = (l.M8 ^ (iv[0] & 0xFFFF)) & 0xFFFFFFFF
    l.N8 = (l.N8 ^ (iv[4] & 0xFFFF)) & 0xFFFFFFFF
    l.M9 = (l.M9 ^ (iv[1] & 0xFFFF)) & 0xFFFFFFFF
    l.N9 = (l.N9 ^ (iv[5] & 0xFFFF)) & 0xFFFFFFFF
    l.M10 = (l.M10 ^ (iv[2] & 0xFFFF)) & 0xFFFFFFFF
    l.N10 = (l.N10 ^ (iv[6] & 0xFFFF)) & 0xFFFFFFFF
    l.M11 = (l.M11 ^ (iv[3] & 0xFFFF)) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ (iv[7] & 0xFFFF)) & 0xFFFFFFFF
    l.M12 = (l.M12 ^ (iv[4] & 0xFFFF)) & 0xFFFFFFFF
    l.N12 = (l.N12 ^ (iv[0] & 0xFFFF)) & 0xFFFFFFFF
    l.M13 = (l.M13 ^ (iv[5] & 0xFFFF)) & 0xFFFFFFFF
    l.N13 = (l.N13 ^ (iv[1] & 0xFFFF)) & 0xFFFFFFFF
    l.M14 = (l.M14 ^ (iv[6] & 0xFFFF)) & 0xFFFFFFFF
    l.N14 = (l.N14 ^ (iv[2] & 0xFFFF)) & 0xFFFFFFFF
    l.M15 = (l.M15 ^ (iv[7] & 0xFFFF)) & 0xFFFFFFFF
    l.N15 = (l.N15 ^ (iv[3] & 0xFFFF)) & 0xFFFFFFFF
    l.M16 = (l.M16 ^ (iv[0] & 0xFFFF)) & 0xFFFFFFFF
    l.N16 = (l.N16 ^ (iv[4] & 0xFFFF)) & 0xFFFFFFFF
    l.M17 = (l.M17 ^ (iv[1] & 0xFFFF)) & 0xFFFFFFFF
    l.N17 = (l.N17 ^ (iv[5] & 0xFFFF)) & 0xFFFFFFFF
    l.M18 = (l.M18 ^ (iv[2] & 0xFFFF)) & 0xFFFFFFFF
    l.N18 = (l.N18 ^ (iv[6] & 0xFFFF)) & 0xFFFFFFFF
    l.M19 = (l.M19 ^ (iv[3] & 0xFFFF)) & 0xFFFFFFFF
    l.N19 = (l.N19 ^ (iv[7] & 0xFFFF)) & 0xFFFFFFFF
    l.M20 = (l.M20 ^ (iv[4] & 0xFFFF)) & 0xFFFFFFFF
    l.N20 = (l.N20 ^ (iv[0] & 0xFFFF)) & 0xFFFFFFFF
    l.M21 = (l.M21 ^ (iv[5] & 0xFFFF)) & 0xFFFFFFFF
    l.N21 = (l.N21 ^ (iv[1] & 0xFFFF)) & 0xFFFFFFFF
    l.M22 = (l.M22 ^ (iv[6] & 0xFFFF)) & 0xFFFFFFFF
    l.N22 = (l.N22 ^ (iv[2] & 0xFFFF)) & 0xFFFFFFFF
    l.M23 = (l.M23 ^ (iv[7] & 0xFFFF)) & 0xFFFFFFFF
    l.N23 = (l.N23 ^ (iv[3] & 0xFFFF)) & 0xFFFFFFFF
    l.M24 = (l.M24 ^ (iv[0] & 0xFFFF)) & 0xFFFFFFFF
    l.N24 = (l.N24 ^ (iv[4] & 0xFFFF)) & 0xFFFFFFFF
    l.M25 = (l.M25 ^ (iv[1] & 0xFFFF)) & 0xFFFFFFFF
    l.N25 = (l.N25 ^ (iv[5] & 0xFFFF)) & 0xFFFFFFFF
    l.M26 = (l.M26 ^ (iv[2] & 0xFFFF)) & 0xFFFFFFFF
    l.N26 = (l.N26 ^ (iv[6] & 0xFFFF)) & 0xFFFFFFFF
    l.M27 = (l.M27 ^ (iv[3] & 0xFFFF)) & 0xFFFFFFFF
    l.N27 = (l.N27 ^ (iv[7] & 0xFFFF)) & 0xFFFFFFFF
    l.M28 = (l.M28 ^ (iv[4] & 0xFFFF)) & 0xFFFFFFFF
    l.N28 = (l.N28 ^ (iv[0] & 0xFFFF)) & 0xFFFFFFFF
    l.N0 = (l.N0 ^ (t_lo & 0xFFFF)) & 0xFFFFFFFF
    l.N14 = (l.N14 ^ (t_hi & 0xFFFF)) & 0xFFFFFFFF
    if last {
        l.N14 = (l.N14 ^ 0xFFFFFFFF) & 0xFFFFFFFF
    }
    l = absorb29h(l, Pw, skey)
    var mA: i64 = 0
    var mC: i64 = 0
    var r: i64 = 0
    while r < R {
        mA = (r * 5 + ((skey >> 6) & 7)) & 31
        mC = (r * 7 + ((skey >> 12) & 7)) & 31
        l = ring29h_mixA(l, r, skey, M0, N0, M1, N1, mA, rcon, r)
        l = ring29h_mixB(l, r, skey, M0, N0, M1, N1, mC, rcon, (r + 8) & 15)
        r = r + 1
    }
    h[0] = (h[0] ^ l.M0 ^ rrp16(l.N0, 0)) & 0xFFFFFFFF
    h[1] = (h[1] ^ l.M1 ^ rrp16(l.N1, 3)) & 0xFFFFFFFF
    h[2] = (h[2] ^ l.M2 ^ rrp16(l.N2, 6)) & 0xFFFFFFFF
    h[3] = (h[3] ^ l.M3 ^ rrp16(l.N3, 9)) & 0xFFFFFFFF
    h[4] = (h[4] ^ l.M4 ^ rrp16(l.N4, 12)) & 0xFFFFFFFF
    h[5] = (h[5] ^ l.M5 ^ rrp16(l.N5, 15)) & 0xFFFFFFFF
    h[6] = (h[6] ^ l.M6 ^ rrp16(l.N6, 18)) & 0xFFFFFFFF
    h[7] = (h[7] ^ l.M7 ^ rrp16(l.N7, 21)) & 0xFFFFFFFF
    h[8] = (h[8] ^ l.M8 ^ rrp16(l.N8, 24)) & 0xFFFFFFFF
    h[9] = (h[9] ^ l.M9 ^ rrp16(l.N9, 27)) & 0xFFFFFFFF
    h[10] = (h[10] ^ l.M10 ^ rrp16(l.N10, 30)) & 0xFFFFFFFF
    h[11] = (h[11] ^ l.M11 ^ rrp16(l.N11, 1)) & 0xFFFFFFFF
    h[12] = (h[12] ^ l.M12 ^ rrp16(l.N12, 4)) & 0xFFFFFFFF
    h[13] = (h[13] ^ l.M13 ^ rrp16(l.N13, 7)) & 0xFFFFFFFF
    h[14] = (h[14] ^ l.M14 ^ rrp16(l.N14, 10)) & 0xFFFFFFFF
    h[15] = (h[15] ^ l.M15 ^ rrp16(l.N15, 13)) & 0xFFFFFFFF
    h[16] = (h[16] ^ l.M16 ^ rrp16(l.N16, 16)) & 0xFFFFFFFF
    h[17] = (h[17] ^ l.M17 ^ rrp16(l.N17, 19)) & 0xFFFFFFFF
    h[18] = (h[18] ^ l.M18 ^ rrp16(l.N18, 22)) & 0xFFFFFFFF
    h[19] = (h[19] ^ l.M19 ^ rrp16(l.N19, 25)) & 0xFFFFFFFF
    h[20] = (h[20] ^ l.M20 ^ rrp16(l.N20, 28)) & 0xFFFFFFFF
    h[21] = (h[21] ^ l.M21 ^ rrp16(l.N21, 31)) & 0xFFFFFFFF
    h[22] = (h[22] ^ l.M22 ^ rrp16(l.N22, 2)) & 0xFFFFFFFF
    h[23] = (h[23] ^ l.M23 ^ rrp16(l.N23, 5)) & 0xFFFFFFFF
    h[24] = (h[24] ^ l.M24 ^ rrp16(l.N24, 8)) & 0xFFFFFFFF
    h[25] = (h[25] ^ l.M25 ^ rrp16(l.N25, 11)) & 0xFFFFFFFF
    h[26] = (h[26] ^ l.M26 ^ rrp16(l.N26, 14)) & 0xFFFFFFFF
    h[27] = (h[27] ^ l.M27 ^ rrp16(l.N27, 17)) & 0xFFFFFFFF
    h[28] = (h[28] ^ l.M28 ^ rrp16(l.N28, 20)) & 0xFFFFFFFF
    fin_synth29h(h)
}

// === W=32 半宽双轨特化内核（r，n=88/92/96/128/144；rrp16/0xFFFF 掩码）——轨A lanes[0..16)、轨B lanes[16..32)；R=8 ===
struct Lanes32h {
    var M0: i64 = 0
    var N0: i64 = 0
    var M1: i64 = 0
    var N1: i64 = 0
    var M2: i64 = 0
    var N2: i64 = 0
    var M3: i64 = 0
    var N3: i64 = 0
    var M4: i64 = 0
    var N4: i64 = 0
    var M5: i64 = 0
    var N5: i64 = 0
    var M6: i64 = 0
    var N6: i64 = 0
    var M7: i64 = 0
    var N7: i64 = 0
    var M8: i64 = 0
    var N8: i64 = 0
    var M9: i64 = 0
    var N9: i64 = 0
    var M10: i64 = 0
    var N10: i64 = 0
    var M11: i64 = 0
    var N11: i64 = 0
    var M12: i64 = 0
    var N12: i64 = 0
    var M13: i64 = 0
    var N13: i64 = 0
    var M14: i64 = 0
    var N14: i64 = 0
    var M15: i64 = 0
    var N15: i64 = 0
    var M16: i64 = 0
    var N16: i64 = 0
    var M17: i64 = 0
    var N17: i64 = 0
    var M18: i64 = 0
    var N18: i64 = 0
    var M19: i64 = 0
    var N19: i64 = 0
    var M20: i64 = 0
    var N20: i64 = 0
    var M21: i64 = 0
    var N21: i64 = 0
    var M22: i64 = 0
    var N22: i64 = 0
    var M23: i64 = 0
    var N23: i64 = 0
    var M24: i64 = 0
    var N24: i64 = 0
    var M25: i64 = 0
    var N25: i64 = 0
    var M26: i64 = 0
    var N26: i64 = 0
    var M27: i64 = 0
    var N27: i64 = 0
    var M28: i64 = 0
    var N28: i64 = 0
    var M29: i64 = 0
    var N29: i64 = 0
    var M30: i64 = 0
    var N30: i64 = 0
    var M31: i64 = 0
    var N31: i64 = 0
}

func ring32h_mixA(l: Lanes32h, r: i64
            , skey: i64
            , M0: i64, N0: i64, M1: i64, N1: i64, mA: i64
            , rcon: table<i64>, rcon_idx: i64
            ) -> Lanes32h {
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var (q0m, q0n) = tadd2(l.M0, l.N0,
                    rrp16(l.M2, rA), rrp16(l.N2, rA))
    var (s0m, s0n) = tadd2(q0m, q0n,
                    rrp16(l.M3, (rB + 3) & 31), rrp16(l.N3, (rB + 3) & 31))
    var (q1m, q1n) = tadd2(l.M1, l.N1,
                    rrp16(l.M3, (rA + 5) & 31), rrp16(l.N3, (rA + 5) & 31))
    var (s1m, s1n) = tadd2(q1m, q1n,
                    rrp16(l.M4, (rB + 10) & 31), rrp16(l.N4, (rB + 10) & 31))
    var (q2m, q2n) = tadd2(l.M2, l.N2,
                    rrp16(l.M4, (rA + 10) & 31), rrp16(l.N4, (rA + 10) & 31))
    var (s2m, s2n) = tadd2(q2m, q2n,
                    rrp16(l.M5, (rB + 17) & 31), rrp16(l.N5, (rB + 17) & 31))
    var (q3m, q3n) = tadd2(l.M3, l.N3,
                    rrp16(l.M5, (rA + 15) & 31), rrp16(l.N5, (rA + 15) & 31))
    var (s3m, s3n) = tadd2(q3m, q3n,
                    rrp16(l.M6, (rB + 24) & 31), rrp16(l.N6, (rB + 24) & 31))
    var (q4m, q4n) = tadd2(l.M4, l.N4,
                    rrp16(l.M6, (rA + 20) & 31), rrp16(l.N6, (rA + 20) & 31))
    var (s4m, s4n) = tadd2(q4m, q4n,
                    rrp16(l.M7, (rB + 31) & 31), rrp16(l.N7, (rB + 31) & 31))
    var (q5m, q5n) = tadd2(l.M5, l.N5,
                    rrp16(l.M7, (rA + 25) & 31), rrp16(l.N7, (rA + 25) & 31))
    var (s5m, s5n) = tadd2(q5m, q5n,
                    rrp16(l.M8, (rB + 6) & 31), rrp16(l.N8, (rB + 6) & 31))
    var (q6m, q6n) = tadd2(l.M6, l.N6,
                    rrp16(l.M8, (rA + 30) & 31), rrp16(l.N8, (rA + 30) & 31))
    var (s6m, s6n) = tadd2(q6m, q6n,
                    rrp16(l.M9, (rB + 13) & 31), rrp16(l.N9, (rB + 13) & 31))
    var (q7m, q7n) = tadd2(l.M7, l.N7,
                    rrp16(l.M9, (rA + 3) & 31), rrp16(l.N9, (rA + 3) & 31))
    var (s7m, s7n) = tadd2(q7m, q7n,
                    rrp16(l.M10, (rB + 20) & 31), rrp16(l.N10, (rB + 20) & 31))
    var (q8m, q8n) = tadd2(l.M8, l.N8,
                    rrp16(l.M10, (rA + 8) & 31), rrp16(l.N10, (rA + 8) & 31))
    var (s8m, s8n) = tadd2(q8m, q8n,
                    rrp16(l.M11, (rB + 27) & 31), rrp16(l.N11, (rB + 27) & 31))
    var (q9m, q9n) = tadd2(l.M9, l.N9,
                    rrp16(l.M11, (rA + 13) & 31), rrp16(l.N11, (rA + 13) & 31))
    var (s9m, s9n) = tadd2(q9m, q9n,
                    rrp16(l.M12, (rB + 2) & 31), rrp16(l.N12, (rB + 2) & 31))
    var (q10m, q10n) = tadd2(l.M10, l.N10,
                    rrp16(l.M12, (rA + 18) & 31), rrp16(l.N12, (rA + 18) & 31))
    var (s10m, s10n) = tadd2(q10m, q10n,
                    rrp16(l.M13, (rB + 9) & 31), rrp16(l.N13, (rB + 9) & 31))
    var (q11m, q11n) = tadd2(l.M11, l.N11,
                    rrp16(l.M13, (rA + 23) & 31), rrp16(l.N13, (rA + 23) & 31))
    var (s11m, s11n) = tadd2(q11m, q11n,
                    rrp16(l.M14, (rB + 16) & 31), rrp16(l.N14, (rB + 16) & 31))
    var (q12m, q12n) = tadd2(l.M12, l.N12,
                    rrp16(l.M14, (rA + 28) & 31), rrp16(l.N14, (rA + 28) & 31))
    var (s12m, s12n) = tadd2(q12m, q12n,
                    rrp16(l.M15, (rB + 23) & 31), rrp16(l.N15, (rB + 23) & 31))
    var (q13m, q13n) = tadd2(l.M13, l.N13,
                    rrp16(l.M15, (rA + 1) & 31), rrp16(l.N15, (rA + 1) & 31))
    var (s13m, s13n) = tadd2(q13m, q13n,
                    rrp16(l.M0, (rB + 30) & 31), rrp16(l.N0, (rB + 30) & 31))
    var (q14m, q14n) = tadd2(l.M14, l.N14,
                    rrp16(l.M0, (rA + 6) & 31), rrp16(l.N0, (rA + 6) & 31))
    var (s14m, s14n) = tadd2(q14m, q14n,
                    rrp16(l.M1, (rB + 5) & 31), rrp16(l.N1, (rB + 5) & 31))
    var (q15m, q15n) = tadd2(l.M15, l.N15,
                    rrp16(l.M1, (rA + 11) & 31), rrp16(l.N1, (rA + 11) & 31))
    var (s15m, s15n) = tadd2(q15m, q15n,
                    rrp16(l.M2, (rB + 12) & 31), rrp16(l.N2, (rB + 12) & 31))
    l.M0 = s0m
    l.N0 = s0n
    l.M1 = s1m
    l.N1 = s1n
    l.M2 = s2m
    l.N2 = s2n
    l.M3 = s3m
    l.N3 = s3n
    l.M4 = s4m
    l.N4 = s4n
    l.M5 = s5m
    l.N5 = s5n
    l.M6 = s6m
    l.N6 = s6n
    l.M7 = s7m
    l.N7 = s7n
    l.M8 = s8m
    l.N8 = s8n
    l.M9 = s9m
    l.N9 = s9n
    l.M10 = s10m
    l.N10 = s10n
    l.M11 = s11m
