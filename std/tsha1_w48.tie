    l.N10 = s0n
    l.M11 = s1m
    l.N11 = s1n
    l.M12 = s2m
    l.N12 = s2n
    var (p0m, p0n) = tmul2(s0m, s0n, s2m, s2n)
    l.M11 = (l.M11 ^ p0m) & 0xFFFFFFFF
    l.N11 = (l.N11 ^ p0n) & 0xFFFFFFFF
