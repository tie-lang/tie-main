type tie<logic>
// std/tink_v2_probe.tie —— tink 帧协议 v2 探针（p.6.11.1 验收）
// 覆盖：编解码往返（任意字节含 0x00/0xFF/中文 UTF-8）、快校验 KAT、
//       强档 KAT、损坏帧拒绝、未知 ext key 跳过、版本不支持、分块流重组、
//       v1 兼容读、1MiB 无 O(n²) 冒烟。
// 每项 PASS 打 `tinkv2:<name>:OK`；失败 `tinkv2:<name>:FAIL` 并把返回码置 1。
// 全部 PASS 打印 `tinkv2:ALL:PASS` 且 exit 0。

import "./tink_v2.tie" as t2
import "./tsha1.tie" as tsha
import "./tink.tie" as tink
import "./time.tie" as time

// 跨语言 KAT 常量（首次运行由下面 println 打印实际值，固化后填回断言）。
// 快校验：tsha1f("",8,48) 与 tsha1f("123456789",8,48) 的 8 符号 48 进制串。
var ks_empty: string = "5juavlyl"
var ks_nine: string = "3Kz1piuc"
// 强档：tsha1_digest("f","123456789",48) 全宽 hex 前 64 字符（= 前 32 字节 hex）。
var ks_strong: string = "260c7340bcc60eb82c727e6df6f9c7620d040c2d4837ee96dc333f1a16fd76bf"

// 全局返回码：任一 FAIL 置 1，最终 main 返回。
var g_rc: i64 = 0

func expect(cond: bool, name: string) {
    if !cond {
        println("tinkv2:" + name + ":FAIL")
        g_rc = 1
    } else {
        println("tinkv2:" + name + ":OK")
    }
}

// ASCII 字符串 → 字节表
func ascii(s: string) -> table<i64> {
    var o = table_new_i64()
    var i: i64 = 0
    while i < str_len(s) {
        table_push(o, char_code(str_char(s, i)))
        i = i + 1
    }
    return o
}

// 字节表逐字节相等
func eqbytes(a: table<i64>, b: table<i64>) -> bool {
    if len(a) != len(b) { return false }
    var i: i64 = 0
    while i < len(a) {
        if a[i] != b[i] { return false }
        i = i + 1
    }
    return true
}

// 两字节表拼接（probe 本地助手，避免额外 import）
func cat2(a: table<i64>, b: table<i64>) -> table<i64> {
    var o = table_new_i64()
    var i: i64 = 0
    while i < len(a) {
        table_push(o, a[i])
        i = i + 1
    }
    i = 0
    while i < len(b) {
        table_push(o, b[i])
        i = i + 1
    }
    return o
}

// hex 串 → 字节表（两字符一组；强档 KAT 常量转原始校验字节用）
func hexb(s: string) -> table<i64> {
    var o = table_new_i64()
    var n = str_len(s)
    var i: i64 = 0
    while i < n {
        var hc = char_code(str_char(s, i))
        var lc: i64 = 0
        if i + 1 < n { lc = char_code(str_char(s, i + 1)) }
        var hv: i64 = 0
        if hc >= 48 && hc <= 57 { hv = hc - 48 }
        else if hc >= 97 && hc <= 102 { hv = hc - 97 + 10 }
        else if hc >= 65 && hc <= 70 { hv = hc - 65 + 10 }
        var lv: i64 = 0
        if lc >= 48 && lc <= 57 { lv = lc - 48 }
        else if lc >= 97 && lc <= 102 { lv = lc - 97 + 10 }
        else if lc >= 65 && lc <= 70 { lv = lc - 65 + 10 }
        table_push(o, ((hv & 15) << 4) | (lv & 15))
        i = i + 2
    }
    return o
}

func main() -> i64 {
    // ---- 1) 编解码往返（任意字节：0x00, 0xFF, 中文 UTF-8 "中文"=E4B8AD E69687） ----
    var pA = table_new_i64()
    table_push(pA, 0x00)
    table_push(pA, 0xFF)
    table_push(pA, 0xE4)
    table_push(pA, 0xB8)
    table_push(pA, 0xAD)
    table_push(pA, 0xE6)
    table_push(pA, 0x96)
    table_push(pA, 0x87)
    table_push(pA, 0x41)
    table_push(pA, 0x00)
    table_push(pA, 0xFF)
    var fr = t2.frame_encode(pA, 0, table_new_i64())
    var (ok1, fl1, el1, pl1, ex1, iok1, np1) = t2.frame_next(fr, 0)
    expect(ok1 == 1 && np1 == len(fr) && fl1 == 0 && iok1 == 1 && eqbytes(pl1, pA), "roundtrip")

    // ---- 2) 快校验 KAT（首次运行打印实际值，后固化为常量断言） ----
    var ke = tsha.tsha1f("", 8, 48)
    var kn = tsha.tsha1f("123456789", 8, 48)
    println("KAT-FAST-EMPTY:" + ke)
    println("KAT-FAST-NINE:" + kn)
    expect(ke == ks_empty && kn == ks_nine, "fast_kat")

    // ---- 3) 强档 KAT ----
    var dg = tsha.tsha1_digest("f", "123456789", 48)
    var dgl = str_len(dg)
    expect(dgl >= 64, "strong_len")
    var kh: string = ""
    var khk: i64 = 0
    while khk < 64 {
        kh = kh + str_char(dg, khk)
        khk = khk + 1
    }
    println("KAT-STRONG-HEX:" + kh)
    expect(kh == ks_strong, "strong_kat")
    // 强档 frame_encode/flags=1 → 解析 integrity_ok=1
    var pS = ascii("123456789")
    var frS = t2.frame_encode(pS, 1, table_new_i64())
    var (okS, flS, elS, plS, exS, iokS, npS) = t2.frame_next(frS, 0)
    expect(okS == 1 && iokS == 1, "strong_encode")
    // 篡改 payload 1 字节 → integrity_ok=0
    frS[10] = frS[10] + 1
    var (okS2, flS2, elS2, plS2, exS2, iokS2, npS2) = t2.frame_next(frS, 0)
    expect(iokS2 == 0, "strong_tamper")

    // ---- 3b) 帧级 KAT（跨语言关键：帧校验段字节 = 直接哈希同一 payload） ----
    // 快校验帧 "123456789" 的 integrity（末 8 字节）== 8 符号串 "3Kz1piuc" 的字节；
    // 强档帧 integrity（末 32 字节）== 强档 KAT hex 解码。
    var frK = t2.frame_encode(ascii("123456789"), 0, table_new_i64())
    var intgFast = table_new_i64()
    var kfi: i64 = len(frK) - 8
    while kfi < len(frK) { table_push(intgFast, frK[kfi]); kfi = kfi + 1 }
    expect(eqbytes(intgFast, ascii(ks_nine)), "frame_kat_fast")
    var frKS = t2.frame_encode(ascii("123456789"), 1, table_new_i64())
    var intgStr = table_new_i64()
    var ksi: i64 = len(frKS) - 32
    while ksi < len(frKS) { table_push(intgStr, frKS[ksi]); ksi = ksi + 1 }
    expect(eqbytes(intgStr, hexb(ks_strong)), "frame_kat_strong")

    // ---- 4) 损坏帧拒绝（翻转 payload 1 字节 → 快校验 integrity_ok=0） ----
    var frT = t2.frame_encode(pA, 0, table_new_i64())
    frT[10] = (frT[10] + 1) & 0xFF
    var (ok4, fl4, el4, pl4, ex4, iok4, np4) = t2.frame_next(frT, 0)
    expect(ok4 == 1 && iok4 == 0, "tamper_reject")

    // ---- 5) 未知 ext key 跳过（key=1234 未定义在前，已知 key2 在后仍读出） ----
    // 用强档帧：encode 与 next 都走 ext 解析，须先跳过 1234 再读 key2(48) 才能一致。
    var v1234 = table_new_i64()
    var vk: i64 = 1
    while vk <= 8 { table_push(v1234, vk); vk = vk + 1 }
    var bits48 = table_new_i64()
    table_push(bits48, 48)
    var extU = cat2(t2.ext_tlv(1234, v1234), t2.ext_tlv(2, bits48))
    var pU = ascii("abc")
    var frU = t2.frame_encode(pU, 1, extU)
    var (okU, flU, elU, plU, exU, iokU, npU) = t2.frame_next(frU, 0)
    expect(okU == 1 && iokU == 1, "unknown_ext_skip")

    // ---- 6) 版本不支持（magic 正确但 version=9 → ok=0） ----
    var badv = table_new_i64()
    table_push(badv, 0x74)
    table_push(badv, 0x6B)
    table_push(badv, 9)
    table_push(badv, 0)
    table_push(badv, 0)
    table_push(badv, 0)
    table_push(badv, 0)
    table_push(badv, 0)
    table_push(badv, 0)
    table_push(badv, 0)
    var (ok6, fl6, el6, pl6, ex6, iok6, np6) = t2.frame_next(badv, 0)
    expect(ok6 == 0, "version_reject")

    // ---- 7) 分块流：270000 字节 > 64KiB×2，拆 3+ 块重组全等 ----
    var big = table_new_i64()
    var bi: i64 = 0
    while bi < 270000 {
        table_push(big, (bi * 7) & 0xFF)
        bi = bi + 1
    }
    var frames = t2.stream_split(big, 65536, 42)
    var joined = t2.stream_join(frames)
    expect(eqbytes(joined, big), "stream_rejoin")
    // 损坏中间帧序号（第 2 帧 ext 内 STREAM_SEQ 高字节）→ stream_join 返回空（报告）
    var mid = t2.frame_skip(frames, 0)  // 第 2 帧起始
    var framesBad = table_new_i64()
    var ci: i64 = 0
    while ci < len(frames) {
        table_push(framesBad, frames[ci])
        ci = ci + 1
    }
    framesBad[mid + 22] = framesBad[mid + 22] + 1  // 中间帧 SESSION 后 key6 SEQ 高字节（ext 内 +22 偏移）
    var joinedBad = t2.stream_join(framesBad)
    expect(len(joinedBad) == 0, "stream_seq_damage")

    // ---- 8) v1 兼容读（CRC32 帧经 v2 解析，crc 通过 integrity_ok=1） ----
    var pV = ascii("123456789")
    var frV = tink.frame_encode(pV)
    var (ok8, fl8, el8, pl8, ex8, iok8, np8) = t2.frame_next(frV, 0)
    expect(ok8 == 1 && fl8 == 0 && iok8 == 1 && eqbytes(pl8, pV), "v1_compat")

    // ---- 9) 1MiB 无 O(n²) 冒烟（仅记录耗时，不设硬时限） ----
    var big1 = table_new_i64()
    var j1: i64 = 0
    while j1 < 1048576 {
        table_push(big1, (j1 * 13) & 0xFF)
        j1 = j1 + 1
    }
    var t0 = time.now_ms()
    var f1 = t2.frame_encode(big1, 0, table_new_i64())
    var t1ms = time.now_ms()
    var (ok9, fl9, el9, pl9, ex9, iok9, np9) = t2.frame_next(f1, 0)
    var t2ms = time.now_ms()
    expect(ok9 == 1 && iok9 == 1 && np9 == len(f1), "perf_1mib")
    println("PERF-1MiB: encode_ms=" + to_string(t1ms - t0) + " next_ms=" + to_string(t2ms - t1ms) + " payload_bytes=" + to_string(len(pl9)))

    // ---- 收尾 ----
    if g_rc == 0 {
        println("tinkv2:ALL:PASS")
    } else {
        println("tinkv2:ALL:FAIL")
    }
    return g_rc
}