type tie<class>
// std/tink_v2.tie —— tink 帧协议 v2（命名空间 tink2）
// ============================================================
// 线格式（全大端 BE，设计见 docs/superpowers/specs/2026-09-05-tink-v2-design.md）：
//   帧 = [magic u8[2]=0x74 0x6B][version u8=2][flags u8][len u32 BE]
//        [ext_len u16 BE][ext: ext_len 字节][payload: len 字节][integrity: 定长]
// flags 位：bit0 INTEGRITY_STRONG（0=快校验默认，1=强档）、bit1 COMPRESSED、
//   bit2 ENCRYPTED、bit3 STREAM、bit4 STREAM_END、bit5..7 保留。
// 校验段（integrity）：
//   - 快校验（bit0=0）：tsha1f(payload串, 8, 48)——8 符号 48 进制，ASCII 字节原样存（8 字节）
//   - 强档（bit0=1，默认模型 f、位长 48，可用 TLV key1/key2 覆盖）：
//     tsha1_digest(model, payload串, n) 全宽 hex → 转字节 → 取前 32 字节
// 扩展头 = key u16 BE + value_len u16 BE + value 的 TLV 序列（key：1=TSHA1_MODEL、
//   2=TSHA1_BITS、3=COMPRESS_ALGO、4=ENC_ALGO、5=STREAM_SESSION、6=STREAM_SEQ、
//   7=STREAM_TOTAL、9=EXT_META；其余未定义）。**未知 key 解析时必须跳过**。
// v1 兼容读（§5）：首两字节对不上 magic → 按 v1 帧（[len u32 BE][payload][crc u32 BE]，
//   CRC32-IEEE）解析（复用 tink 的 CRC32）。
//
// == 校验基准说明 ==
// 校验段 = tsha1 族直接作用于**原始 payload 字节**（设计 §3.3）：payload 字节表经
// string_builder + sb_append_byte 逐字节精确构串（二进制安全，含 0x00/0xFF），
// tsha1f/tsha1_digest 内部按字节处理（同 blake/blake3 哈希任意字节串），
// 任何语言实现按同一规则（直接哈希原始字节）即跨语言一致。
// 性能纪律：帧组装用 bytes.concat（byte_concat 编译器内联批量拷贝）整块拼；
// 校验对整 payload 一次计算；payload→串 sb_append_byte 摊销线性（非 O(n²)）。
// 错误约定：解析失败返回 ok=0 / skip -1 哨兵，不 panic。保留位（bit5..7）必须为 0，
// 置位视为格式错误 → ok=0（§5.3 未知位不可信策略）。

import "./bytes.tie" as bytes
import "./tsha1.tie" as tsha
import "./tink.tie" as tink
import "./x25519.tie" as x25519
import "./hkdf.tie" as hkdf
import "./ascon_mac.tie" as ascon

namespace tink2 {

// ---------- 常量 ----------
// 帧：magic = 0x74 0x6B（"tk"）；version = 2
// flags 位：1=STRONG 2=COMPRESSED 4=ENCRYPTED 8=STREAM 16=STREAM_END
// ext key：1=TSHA1_MODEL 2=TSHA1_BITS 5=STREAM_SESSION 6=STREAM_SEQ 7=STREAM_TOTAL
// 校验：快=8 字节；强=32 字节

pub func magic_first() -> i64 { return 0x74 }
pub func magic_second() -> i64 { return 0x6B }
pub func frame_version() -> i64 { return 2 }

// ---------- BE 字节读写助手（内部） ----------

func u16be(v: i64) -> table<i64> {
    var t = table_new_i64()
    table_push(t, (v >> 8) & 0xFF)
    table_push(t, v & 0xFF)
    return t
}

func u32be(v: i64) -> table<i64> {
    var t = table_new_i64()
    table_push(t, (v >> 24) & 0xFF)
    table_push(t, (v >> 16) & 0xFF)
    table_push(t, (v >> 8) & 0xFF)
    table_push(t, v & 0xFF)
    return t
}

func u64be(v: i64) -> table<i64> {
    var t = table_new_i64()
    var i: i64 = 7
    while i >= 0 {
        table_push(t, (v >> (i * 8)) & 0xFF)
        i = i - 1
    }
    return t
}

func u16rd(t: table<i64>, p: i64) -> i64 {
    return ((t[p] & 0xFF) << 8) | (t[p + 1] & 0xFF)
}

func u32rd(t: table<i64>, p: i64) -> i64 {
    return ((t[p] & 0xFF) << 24) | ((t[p + 1] & 0xFF) << 16) | ((t[p + 2] & 0xFF) << 8) | (t[p + 3] & 0xFF)
}

func u64rd(t: table<i64>, p: i64) -> i64 {
    var r: i64 = 0
    var i: i64 = 0
    while i < 8 {
        r = (r << 8) | (t[p + i] & 0xFF)
        i = i + 1
    }
    return r
}

// 字节表切片 bytes[a..b)（拷贝）
func slice(t: table<i64>, a: i64, b: i64) -> table<i64> {
    var o = table_new_i64()
    var i: i64 = a
    while i < b {
        table_push(o, t[i])
        i = i + 1
    }
    return o
}

// ---------- payload → 二进制安全原始字节串 ----------

// 每字节精确追加进 StringBuilder（string_builder/sb_append_byte 全库原语，二进制
// 安全——blake/blake3 哈希任意字节串同款；字节 0..255 原样落位，含 0x00/0xFF），
// 一次 sb_build 产串。校验 = tsha1 族直接作用于**原始 payload 字节**（设计 §3.3），
// 与任何语言实现（直接哈希原始字节）跨语言一致。
func payload_str(p: table<i64>) -> string {
    var sb = string_builder()
    var n = len(p)
    var i: i64 = 0
    while i < n {
        sb_append_byte(sb, p[i] & 0xFF)
        i = i + 1
    }
    return sb_build(sb)
}

func hexval(c: string) -> i64 {
    var cp = char_code(c)
    if cp >= 48 && cp <= 57 { return cp - 48 }       // '0'..'9'
    if cp >= 97 && cp <= 102 { return cp - 97 + 10 }  // 'a'..'f'
    if cp >= 65 && cp <= 70 { return cp - 65 + 10 }   // 'A'..'F'
    return 0
}

// hex 串 → 字节表（两字符一组）
func hexstr_bytes(h: string) -> table<i64> {
    var o = table_new_i64()
    var n = str_len(h)
    var i: i64 = 0
    while i < n {
        var hi = hexval(str_char(h, i))
        var lo: i64 = 0
        if i + 1 < n { lo = hexval(str_char(h, i + 1)) }
        table_push(o, ((hi & 15) << 4) | (lo & 15))
        i = i + 2
    }
    return o
}

// ---------- 校验段计算 ----------

// 快校验：8 符号 48 进制，ASCII 字节原样存（8 字节）。
func fast_integrity(p: table<i64>) -> table<i64> {
    var s = tsha.tsha1f(payload_str(p), 8, 48)
    return bytes.from_ascii(s)
}

// 强档校验：digest 全宽 hex → 转字节 → 取前 32 字节；模型/位长按 ext key1/key2 覆盖。
func strong_integrity(p: table<i64>, ext: table<i64>) -> table<i64> {
    var m = ext_u8(ext, 1)   // key1 TSHA1_MODEL（0/1/2/3 = f/r/b/x；缺省 f）
    var model: string = "f"
    if m == 1 { model = "r" } else if m == 2 { model = "b" } else if m == 3 { model = "x" }
    var nb = ext_u8(ext, 2)  // key2 TSHA1_BITS（缺省 48）
    var nbits: i64 = 48
    if nb >= 2 && nb <= 200 { nbits = nb }
    var dh = tsha.tsha1_digest(model, payload_str(p), nbits) // 全宽 hex 串
    var db = hexstr_bytes(dh)
    var out = table_new_i64()
    var k: i64 = 0
    while k < 32 {
        if k < len(db) {
            table_push(out, db[k])
        } else {
            table_push(out, 0)  // 状态池不足（正常不应发生）补齐
        }
        k = k + 1
    }
    return out
}

// ---------- ext TLV 读取（未知 key 跳过；缺 key 返回 -1） ----------

func ext_u8(ext: table<i64>, key: i64) -> i64 {
    var p: i64 = 0
    var n = len(ext)
    while p + 4 <= n {
        var k = u16rd(ext, p)
        var vl = u16rd(ext, p + 2)
        if p + 4 + vl > n { return -1 }  // 尾 TLV 格式坏
        if k == key {
            if vl >= 1 { return ext[p + 4] & 0xFF }
            return 0
        }
        p = p + 4 + vl
    }
    return -1
}

func ext_u32(ext: table<i64>, key: i64) -> i64 {
    var p: i64 = 0
    var n = len(ext)
    while p + 4 <= n {
        var k = u16rd(ext, p)
        var vl = u16rd(ext, p + 2)
        if p + 4 + vl > n { return -1 }
        if k == key {
            if vl >= 4 { return u32rd(ext, p + 4) }
            return 0
        }
        p = p + 4 + vl
    }
    return -1
}

pub func ext_u64(ext: table<i64>, key: i64) -> i64 {
    var p: i64 = 0
    var n = len(ext)
    while p + 4 <= n {
        var k = u16rd(ext, p)
        var vl = u16rd(ext, p + 2)
        if p + 4 + vl > n { return -1 }
        if k == key {
            if vl >= 8 { return u64rd(ext, p + 4) }
            return 0
        }
        p = p + 4 + vl
    }
    return -1
}

// ---------- TLV 构建 / 流式扩展头 ----------

// 拼一条 TLV：key u16 BE + value_len u16 BE + value
pub func ext_tlv(key: i64, value: table<i64>) -> table<i64> {
    var h = u16be(key)
    var vl = len(value)
    table_push(h, (vl >> 8) & 0xFF)
    table_push(h, vl & 0xFF)
    var i: i64 = 0
    while i < vl {
        table_push(h, value[i])
        i = i + 1
    }
    return h
}

// 首帧扩展头：key5 STREAM_SESSION(4B) + key7 STREAM_TOTAL(8B)
pub func ext_stream_header(session: i64, total: i64) -> table<i64> {
    return bytes.concat(ext_tlv(5, u32be(session)), ext_tlv(7, u64be(total)))
}

// 块帧扩展头：key5 STREAM_SESSION(4B) + key6 STREAM_SEQ(8B)
pub func ext_stream_chunk(session: i64, seq: i64) -> table<i64> {
    return bytes.concat(ext_tlv(5, u32be(session)), ext_tlv(6, u64be(seq)))
}

// ---------- 帧编码 ----------

pub func frame_encode(payload: table<i64>, flags: i64, ext: table<i64>) -> table<i64> {
    // 头（固定 10 + ext_len 字节）：magic + version + flags + len u32 + ext_len u16 + ext
    var header = table_new_i64()
    table_push(header, 0x74)
    table_push(header, 0x6B)
    table_push(header, 2)
    table_push(header, flags & 0xFF)
    var ln = len(payload)
    table_push(header, (ln >> 24) & 0xFF)
    table_push(header, (ln >> 16) & 0xFF)
    table_push(header, (ln >> 8) & 0xFF)
    table_push(header, ln & 0xFF)
    var el = len(ext)
    table_push(header, (el >> 8) & 0xFF)
    table_push(header, el & 0xFF)
    var i: i64 = 0
    while i < el {
        table_push(header, ext[i])
        i = i + 1
    }
    var integ = table_new_i64()
    if (flags & 1) != 0 {
        integ = strong_integrity(payload, ext)
    } else {
        integ = fast_integrity(payload)
    }
    var a = bytes.concat(header, payload)
    var frame = bytes.concat(a, integ)
    return frame
}

// ---------- 帧解析 ----------

// 从 bytes[pos..] 解析一帧 → (ok, flags, ext_len, payload, ext, integrity_ok, next_pos)。
// ok=1 解析成功（含 v1 兼容帧，此时 flags=0、integrity 校验=v1 crc 是否通过）、
// 0 失败（缓冲不足/魔数不符且非 v1/版本不支持）；integrity_ok 为校验统一出口。
pub func frame_next(bytes: table<i64>, pos: i64) -> (i64, i64, i64, table<i64>, table<i64>, i64, i64) {
    var empty = table_new_i64()
    var nb = len(bytes)
    if pos < 0 {
        return (0, 0, 0, empty, empty, 0, -1)
    }
    if pos + 1 >= nb {
        return (0, 0, 0, empty, empty, 0, -1)
    }
    var isv2: bool = (bytes[pos] == 0x74) && (bytes[pos + 1] == 0x6B)
    if isv2 {
        if pos + 9 >= nb {
            return (0, 0, 0, empty, empty, 0, -1)
        }
        var ver = bytes[pos + 2] & 0xFF
        if ver != 2 {
            return (0, 0, 0, empty, empty, 0, -1)  // 版本不支持
        }
        var fl = bytes[pos + 3] & 0xFF
        if (fl & 0xE0) != 0 {
            return (0, 0, 0, empty, empty, 0, -1)  // 保留位置位 → 不可信帧（§5.3）
        }
        var ln = u32rd(bytes, pos + 4)
        var el = u16rd(bytes, pos + 8)
        if ln < 0 {
            return (0, 0, 0, empty, empty, 0, -1)
        }
        var integ_len: i64 = 8
        if (fl & 1) != 0 { integ_len = 32 }
        if pos + 10 + el + ln + integ_len > nb {
            return (0, 0, 0, empty, empty, 0, -1)  // 缓冲不足
        }
        var pext = slice(bytes, pos + 10, pos + 10 + el)
        var pstart = pos + 10 + el
        var ppayload = slice(bytes, pstart, pstart + ln)
        var pstore = slice(bytes, pstart + ln, pstart + ln + integ_len)
        var pintegrity = table_new_i64()
        if (fl & 1) != 0 {
            pintegrity = strong_integrity(ppayload, pext)
        } else {
            pintegrity = fast_integrity(ppayload)
        }
        var iok: i64 = 0
        if len(pintegrity) == len(pstore) {
            var same: bool = true
            var i: i64 = 0
            while i < len(pstore) {
                if pintegrity[i] != pstore[i] { same = false }
                i = i + 1
            }
            if same { iok = 1 }
        }
        return (1, fl, el, ppayload, pext, iok, pstart + ln + integ_len)
    }
    // 无 magic → v1 兼容读：[len u32 BE][payload][crc u32 BE]（CRC32-IEEE）
    if pos + 7 >= nb {
        return (0, 0, 0, empty, empty, 0, -1)
    }
    var n = u32rd(bytes, pos)
    if n < 0 {
        return (0, 0, 0, empty, empty, 0, -1)
    }
    if pos + 8 + n > nb {
        return (0, 0, 0, empty, empty, 0, -1)
    }
    var vp = slice(bytes, pos + 4, pos + 4 + n)
    var crc = u32rd(bytes, pos + 4 + n)
    var vok: i64 = 0
    if tink.crc32(vp) == crc { vok = 1 }
    return (1, 0, 0, vp, empty, vok, pos + 8 + n)
}

// ---------- 帧跳过（零拷贝，不校验） ----------

pub func frame_skip(bytes: table<i64>, pos: i64) -> i64 {
    var nb = len(bytes)
    if pos < 0 {
        return -1
    }
    if pos + 1 >= nb {
        return -1
    }
    var isv2: bool = (bytes[pos] == 0x74) && (bytes[pos + 1] == 0x6B)
    if isv2 {
        if pos + 9 >= nb {
            return -1
        }
        if (bytes[pos + 2] & 0xFF) != 2 {
            return -1
        }
        var fl = bytes[pos + 3] & 0xFF
        if (fl & 0xE0) != 0 {
            return -1  // 保留位置位 → 不可信帧（§5.3）
        }
        var ln = u32rd(bytes, pos + 4)
        var el = u16rd(bytes, pos + 8)
        var integ_len: i64 = 8
        if (fl & 1) != 0 { integ_len = 32 }
        if pos + 10 + el + ln + integ_len > nb {
            return -1
        }
        return pos + 10 + el + ln + integ_len
    }
    if pos + 7 >= nb {
        return -1
    }
    var n = u32rd(bytes, pos)
    if pos + 8 + n > nb {
        return -1
    }
    return pos + 8 + n
}

// ---------- 分块流 ----------

// 单帧流构造：piece 为一段载荷，打 STREAM 标记与 SESSION/SEQ(+TOTAL) 扩展头。
pub func stream_chunk_make(piece: table<i64>, session: i64, seq: i64, total: i64, first: bool, last: bool) -> table<i64> {
    var ext = ext_stream_chunk(session, seq)
    if first {
        ext = bytes.concat(ext, ext_tlv(7, u64be(total)))
    }
    var fl: i64 = 8  // FLAG_STREAM
    if last { fl = fl | 16 }  // FLAG_STREAM_END
    return frame_encode(piece, fl, ext)
}

// 按 ≤chunk 分块：返回**逐帧字节的拼接**（每帧自定界，帧序即 seq 序 0..n-1）。
// tie 无动态嵌套表运行时构造（无 push-table 原语），故不返回 table<table<i64>>，
// 而返回拼接帧字节表，由 stream_join 逐帧重解析重组（见交付报告妥协点）。
pub func stream_split(payload: table<i64>, chunk: i64, session: i64) -> table<i64> {
    var out = table_new_i64()
    var total = len(payload)
    var c = chunk
    if c <= 0 { c = 65536 }
    var nchunks: i64 = total / c
    if (nchunks * c) < total { nchunks = nchunks + 1 }
    if nchunks == 0 { nchunks = 1 }
    var i: i64 = 0
    while i < nchunks {
        var cs = i * c
        var ce = cs + c
        if ce > total { ce = total }
        var piece = slice(payload, cs, ce)
        var first: bool = (i == 0)
        var last: bool = (i == nchunks - 1)
        var fr = stream_chunk_make(piece, session, i, total, first, last)
        var j: i64 = 0
        while j < len(fr) {
            table_push(out, fr[j])
            j = j + 1
        }
        i = i + 1
    }
    return out
}

// 重组成整载荷：逐帧解析（SESSION 一致性 + SEQ 顺序重组）；SESSION 不一致/丢帧/总长
// 不符返回**空表**（探针据此报告）。
pub func stream_join(frames: table<i64>) -> table<i64> {
    var empty = table_new_i64()
    var sess: i64 = -1
    var total: i64 = -1
    var seqs = table_new_i64()
    var starts = table_new_i64()
    var sizes = table_new_i64()
    var paybuf = table_new_i64()
    var count: i64 = 0
    var pos: i64 = 0
    while pos < len(frames) {
        var (ok, fl, el, ppayload, pext, iok, npos) = frame_next(frames, pos)
        if ok == 0 {
            return empty
        }
        var s = ext_u32(pext, 5)   // STREAM_SESSION
        if s < 0 {
            return empty
        }
        if sess == -1 {
            sess = s
        } else if s != sess {
            return empty  // SESSION 不一致
        }
        var sq = ext_u64(pext, 6)
        if sq < 0 {
            return empty
        }
        var pl = len(ppayload)
        var start = len(paybuf)
        var j: i64 = 0
        while j < pl {
            table_push(paybuf, ppayload[j])
            j = j + 1
        }
        table_push(seqs, sq)
        table_push(starts, start)
        table_push(sizes, pl)
        var tl = ext_u64(pext, 7)
        if tl >= 0 { total = tl }  // STREAM_TOTAL（首帧携带）
        count = count + 1
        pos = npos
    }
    if count == 0 {
        return empty
    }
    // 按 SEQ 升序选择排序，并校验序号连续（0..count-1，缺帧则失败）
    var i: i64 = 0
    while i < count {
        var mi = i
        var j: i64 = i + 1
        while j < count {
            if seqs[j] < seqs[mi] { mi = j }
            j = j + 1
        }
        if mi != i {
            var ts = seqs[i]; seqs[i] = seqs[mi]; seqs[mi] = ts
            var tst = starts[i]; starts[i] = starts[mi]; starts[mi] = tst
            var tsz = sizes[i]; sizes[i] = sizes[mi]; sizes[mi] = tsz
        }
        i = i + 1
    }
    i = 0
    while i < count {
        if seqs[i] != i { return empty }  // 丢帧/序号不连续
        i = i + 1
    }
    // 按序拼出整载荷
    var out = table_new_i64()
    i = 0
    while i < count {
        var s0 = starts[i]
        var e0 = s0 + sizes[i]
        var j = s0
        while j < e0 {
            table_push(out, paybuf[j])
            j = j + 1
        }
        i = i + 1
    }
    if total >= 0 && len(out) != total {
        return empty  // 总长不符
    }
    return out
}

// ---------- zrpc 信封（EXT_META key=9）----------
// 设计见 tink-v2-design.md §7：以 EXT_META 携带调用契约，支撑请求/响应匹配、
// 错误回传、流式与双向调用，为形态 B（hub）铺路。
// EXT_META value 固定 15 字节：[op u8][req_id u64 BE][stream_id u32 BE][error_code u16 BE]
//   op：0=CALL 1=REPLY 2=ACK 3=PING 4=PONG
//   req_id：请求-响应对 ID（CALL/REPLY/ACK 配对；PING/PONG 可复用）
//   stream_id：流式调用的流 ID（0=非流式）
//   error_code：0=成功，非零为错误码（REPLY 用）

pub func zrpc_op_call() -> i64 { return 0 }
pub func zrpc_op_reply() -> i64 { return 1 }
pub func zrpc_op_ack() -> i64 { return 2 }
pub func zrpc_op_ping() -> i64 { return 3 }
pub func zrpc_op_pong() -> i64 { return 4 }

// 构建 EXT_META 的 value（15 字节，不含 TLV 头）
func zrpc_meta_value(op: i64, req_id: i64, stream_id: i64, error_code: i64) -> table<i64> {
    var t = table_new_i64()
    table_push(t, op & 0xFF)
    var r = u64be(req_id)
    var i: i64 = 0
    while i < 8 { table_push(t, r[i]); i = i + 1 }
    var sid = u32be(stream_id)
    i = 0
    while i < 4 { table_push(t, sid[i]); i = i + 1 }
    var ec = u16be(error_code)
    table_push(t, ec[0])
    table_push(t, ec[1])
    return t
}

// 构建完整 EXT_META TLV（key=9）
pub func zrpc_meta_tlv(op: i64, req_id: i64, stream_id: i64, error_code: i64) -> table<i64> {
    return ext_tlv(9, zrpc_meta_value(op, req_id, stream_id, error_code))
}

// 从 ext 中解析 EXT_META → (ok, op, req_id, stream_id, error_code)；ok=0 表示缺失/格式坏
pub func zrpc_meta_decode(ext: table<i64>) -> (i64, i64, i64, i64, i64) {
    var p: i64 = 0
    var n = len(ext)
    while p + 4 <= n {
        var k = u16rd(ext, p)
        var vl = u16rd(ext, p + 2)
        if p + 4 + vl > n {
            return (0, 0, 0, 0, 0)
        }
        if k == 9 {
            if vl != 15 {
                return (0, 0, 0, 0, 0)
            }
            var op = ext[p + 4] & 0xFF
            var req_id = u64rd(ext, p + 5)
            var stream_id = u32rd(ext, p + 13)
            var error_code = u16rd(ext, p + 17)
            return (1, op, req_id, stream_id, error_code)
        }
        p = p + 4 + vl
    }
    return (0, 0, 0, 0, 0)
}

// 构建 CALL 帧：op=CALL，payload 为调用参数（zd 字节），stream_id=0 非流式
pub func zrpc_call_frame(payload: table<i64>, req_id: i64, stream_id: i64) -> table<i64> {
    var ext = zrpc_meta_tlv(0, req_id, stream_id, 0)
    return frame_encode(payload, 0, ext)
}

// 构建 REPLY 帧：op=REPLY，payload 为返回值（zd 字节），error_code=0 成功
pub func zrpc_reply_frame(payload: table<i64>, req_id: i64, stream_id: i64, error_code: i64) -> table<i64> {
    var ext = zrpc_meta_tlv(1, req_id, stream_id, error_code)
    return frame_encode(payload, 0, ext)
}

// 构建 ACK 帧：op=ACK，payload=[ack_seq u64 BE]（已确认的最大连续序号）
pub func zrpc_ack_frame(req_id: i64, ack_seq: i64) -> table<i64> {
    var ext = zrpc_meta_tlv(2, req_id, 0, 0)
    var p = u64be(ack_seq)
    return frame_encode(p, 0, ext)
}

// 构建 PING 帧：op=PING，payload 为空或携带时间戳
pub func zrpc_ping_frame(req_id: i64) -> table<i64> {
    var ext = zrpc_meta_tlv(3, req_id, 0, 0)
    return frame_encode(table_new_i64(), 0, ext)
}

// 构建 PONG 帧：op=PONG，对应 PING 的 req_id
pub func zrpc_pong_frame(req_id: i64) -> table<i64> {
    var ext = zrpc_meta_tlv(4, req_id, 0, 0)
    return frame_encode(table_new_i64(), 0, ext)
}

// 从 ACK 帧的 payload 解析 ack_seq
pub func zrpc_ack_seq(payload: table<i64>) -> i64 {
    if len(payload) < 8 { return -1 }
    return u64rd(payload, 0)
}

// ---------- 加密位（flags.ENCRYPTED bit2 + ENC_ALGO key=4）----------
// 设计见 tink-v2-design.md §3.1/§3.2/§7：flags bit2=ENCRYPTED，
// ENC_ALGO(key=4) value = [algo_id u8][nonce_prefix 3B]；
// AEAD 方案 algo_id=0：ascon_mac128 + HKDF（XOR-OTR 流密码 + MAC 认证）。
// 密钥派生：sym_key(16B) = HKDF(shared_x25519, info="tink-v2-aead", 16)
// 加密载荷 = [nonce 12B][ciphertext][tag 16B]
//   keystream = ascon_mac128(sym_key, nonce_str) 重复；ciphertext = pt XOR keystream
//   tag = ascon_mac128(sym_key, ciphertext)
// 解密：验 tag → XOR keystream 还原。篡改/密钥错 → ok=0。

pub func enc_algo_ascon() -> i64 { return 0 }

// 构建 ENC_ALGO TLV（key=4）：algo_id u8 + nonce_prefix 3B
pub func enc_algo_tlv(algo_id: i64, nonce_prefix: table<i64>) -> table<i64> {
    var v = table_new_i64()
    table_push(v, algo_id & 0xFF)
    var i: i64 = 0
    while i < 3 {
        if i < len(nonce_prefix) { table_push(v, nonce_prefix[i] & 0xFF) }
        else { table_push(v, 0) }
        i = i + 1
    }
    return ext_tlv(4, v)
}

// 从 ext 解析 ENC_ALGO → (ok, algo_id, nonce_prefix[3])
pub func enc_algo_decode(ext: table<i64>) -> (i64, i64, table<i64>) {
    var p: i64 = 0
    var n = len(ext)
    var empty = table_new_i64()
    while p + 4 <= n {
        var k = u16rd(ext, p)
        var vl = u16rd(ext, p + 2)
        if p + 4 + vl > n { return (0, 0, empty) }
        if k == 4 {
            if vl != 4 { return (0, 0, empty) }
            var aid = ext[p + 4] & 0xFF
            var np = table_new_i64()
            table_push(np, ext[p + 5] & 0xFF)
            table_push(np, ext[p + 6] & 0xFF)
            table_push(np, ext[p + 7] & 0xFF)
            return (1, aid, np)
        }
        p = p + 4 + vl
    }
    return (0, 0, empty)
}

// 从 x25519 共享密钥派生 16 字节对称密钥（hex 串，32 字符）
func derive_sym_key(shared_hex: string) -> string {
    return hkdf.derive("", shared_hex, "tink-v2-aead", 16)
}

// 生成 12 字节 nonce（基于帧序号 + 随机扰动；第一版用序号确定性生成便于探针）
func make_nonce(seq: i64) -> table<i64> {
    var n = table_new_i64()
    var b = u64be(seq)
    var i: i64 = 0
    while i < 8 { table_push(n, b[i]); i = i + 1 }
    table_push(n, 0x74)
    table_push(n, 0x6B)
    table_push(n, 0x02)
    table_push(n, 0x00)
    return n
}

// 加密载荷：pt 字节表 → [nonce 12B][ciphertext][tag 16B]
func encrypt_payload(pt: table<i64>, sym_key_hex: string, seq: i64) -> table<i64> {
    var nonce = make_nonce(seq)
    var nonce_str = payload_str(nonce)
    var ks_hex = ascon.ascon_mac128(sym_key_hex, nonce_str)  // 16B keystream
    var ks = hexstr_bytes(ks_hex)
    var klen = len(ks)
    var ct = table_new_i64()
    var n = len(pt)
    var i: i64 = 0
    while i < n {
        table_push(ct, (pt[i] & 0xFF) ^ (ks[i % klen] & 0xFF))
        i = i + 1
    }
    var ct_str = payload_str(ct)
    var tag_hex = ascon.ascon_mac128(sym_key_hex, ct_str)
    var tag = hexstr_bytes(tag_hex)
    var out = bytes.concat(nonce, ct)
    return bytes.concat(out, tag)
}

// 解密载荷：[nonce 12B][ciphertext][tag 16B] → (ok, plaintext)
func decrypt_payload(enc: table<i64>, sym_key_hex: string) -> (i64, table<i64>) {
    var empty = table_new_i64()
    var nb = len(enc)
    if nb < 28 { return (0, empty) }  // 12 nonce + 0 ct + 16 tag
    var nonce = slice(enc, 0, 12)
    var ct = slice(enc, 12, nb - 16)
    var tag = slice(enc, nb - 16, nb)
    var ct_str = payload_str(ct)
    var expect_tag_hex = ascon.ascon_mac128(sym_key_hex, ct_str)
    var expect_tag = hexstr_bytes(expect_tag_hex)
    if !eqbytes_internal(expect_tag, tag) {
        return (0, empty)
    }
    var nonce_str = payload_str(nonce)
    var ks_hex = ascon.ascon_mac128(sym_key_hex, nonce_str)
    var ks = hexstr_bytes(ks_hex)
    var klen = len(ks)
    var pt = table_new_i64()
    var n = len(ct)
    var i: i64 = 0
    while i < n {
        table_push(pt, (ct[i] & 0xFF) ^ (ks[i % klen] & 0xFF))
        i = i + 1
    }
    return (1, pt)
}

// 内部字节表相等（不导出，与探针的 eqbytes 独立）
func eqbytes_internal(a: table<i64>, b: table<i64>) -> bool {
    if len(a) != len(b) { return false }
    var i: i64 = 0
    while i < len(a) {
        if a[i] != b[i] { return false }
        i = i + 1
    }
    return true
}

// 构建加密帧：明文 payload → flags.ENCRYPTED=1 的 v2 帧
// shared_hex = x25519 共享密钥（64 hex）；seq = 帧序号（nonce 派生用）
pub func encrypt_frame(pt: table<i64>, shared_hex: string, seq: i64) -> table<i64> {
    var sym_key = derive_sym_key(shared_hex)
    var enc = encrypt_payload(pt, sym_key, seq)
    var nonce_prefix = slice(make_nonce(seq), 0, 3)
    var ext = enc_algo_tlv(0, nonce_prefix)
    return frame_encode(enc, 4, ext)  // flags bit2 = ENCRYPTED
}

// 解密帧：v2 帧字节 → (ok, plaintext_payload)；ok=0 表示未加密/校验失败/格式坏
pub func decrypt_frame(frame: table<i64>, shared_hex: string) -> (i64, table<i64>) {
    var empty = table_new_i64()
    var (ok, fl, el, pl, ex, iok, np) = frame_next(frame, 0)
    if ok == 0 || iok == 0 {
        return (0, empty)
    }
    if (fl & 4) == 0 {
        return (0, empty)  // 非加密帧
    }
    var sym_key = derive_sym_key(shared_hex)
    return decrypt_payload(pl, sym_key)
}

// x25519 握手辅助：A 侧用 seedA 生成密钥对，B 侧用 seedB；返回 (pkA_hex, pkB_hex, shared_hex)
pub func handshake(seedA_hex: string, seedB_hex: string) -> (string, string, string) {
    var pkA = x25519.keygen(seedA_hex)
    var pkB = x25519.keygen(seedB_hex)
    var sharedA = x25519.dh(seedA_hex, pkB)
    return (pkA, pkB, sharedA)
}

}   // namespace tink2