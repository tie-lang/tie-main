type tie<class>
// ============================================================================
// diff.tie：标准库——文本行级 diff（命名空间 diff，纯 tie）p.6.6.17
// Text line-level diff (namespace diff, pure-tie). p.6.6.17
//
// 定位（Positioning）：
//   对两份「文本行表」（table<string>，每元素一行，不含行尾 \n）计算行级差异，
//   返回平行 op 表（kind + a/b 行号），并提供 UNIFIED 格式文本输出。不读文件：
//   行由调用方组织成表喂入（可用 fs.read_lines 或探针内存构造）。
//
// 接口（Interface）：
//   - line_diff(a_lines, b_lines) -> DiffResult：
//       返回三张**平行等长**的表，元素序即操作序：
//         ops[i]   kind：0=keep（两行相同） 1=del（a 独有） 2=add（b 独有）
//         a_ln[i]  a 侧 1-based 行号（del 有、keep 有、add 为 0）
//         b_ln[i]  b 侧 1-based 行号（add 有、keep 有、del 为 0）
//   - unified(a_lines, b_lines) -> string：最小 UNIFIED 子集输出。
//       固定头 `--- a\n+++ b\n`；随后按 op 序列输出：keep 行前导空格（上下文
//       保形，**空行输出为单独空格行**）、del 行 `-<行>`、add 行 `+<行>`；
//       每次 del 块与其后 add 块相邻输出（标准 unified 同一变更展示 -/+ 相邻）。
//       不带 @@ hunk 头（最小子集；行号信息由 line_diff 承载）。
//       **结尾约定：不带末尾换行**（末行 op 后无 \n）。探针按此断言。
//
// 算法（Algorithm）：LCS 语义，但**禁止 O(n·m) 内存**。
//   - 公共前后缀剥离：逐行比较前部相同行、后部相同行，仅中间段进入 Myers；
//   - Myers O(ND) 经典贪心：V 数组长度 2*MAX+1（MAX=中段 n+m，k 以 +MAX 偏移），
//     每 D 步前把 V 快照进 trace 行（trace[row] = V_{d-1}，供回溯重建 op 序列）；
//   - 中段大且 D 超上限 c_max_d（800）时退化整段 del+add（兜底注释）：
//     防止极端相异输入耗尽内存/时间；
//   - 所有中间表为 i64 计数表（行号/下标，**不存储文本行副本**；行只按下标
//     参与比较）。性能红线 2×2K 近重复文本 sub-second（前后缀剥离后中段极小）。
//
// 语言约束（Language constraints）：
//   - 存取中间态均为 i64 表；修改类输出用局部表构建后整体赋回 struct 字段
//     （struct 值类型，字段表禁止 table_push/下标写，沿 httpc/sort 惯例）。
//   - 比较用 string == 运算符（IR 走 strcmp，码点序）。
//   - `text`、`port` 是 tie 保留字，本模块规避。
//   - 输出拼接用 string_builder（禁逐行 string+ 全量拷贝，O(n²)）。
// ============================================================================

// ---- DiffResult：一次行级 diff 的三张平行 op 表 ----
struct DiffResult {
    var ops: table<i64> = table_new_i64()   // kind：0=keep 1=del 2=add
    var a_ln: table<i64> = table_new_i64()  // a 侧 1-based 行号（del/keep 有，add 为 0）
    var b_ln: table<i64> = table_new_i64()  // b 侧 1-based 行号（add/keep 有，del 为 0）
}

namespace diff {

// ============================================================================
// 一、公共前后缀剥离 + Myers 中段
// ============================================================================

// 计算 a_lines 与 b_lines 的行级差异。见 DiffResult 字段语义。
// 算法：先剥离逐行相等的公共前缀/后缀（全 keep），中间段交给 myers；
// 中段保真按 myers 输出，尾部再补公共后缀 keep。不复制行内容，只用下标。
pub func line_diff(a_lines: table<string>, b_lines: table<string>) -> DiffResult {
    var res = DiffResult()
    var ops = table_new_i64()
    var aa = table_new_i64()
    var bb = table_new_i64()
    var n: i64 = len(a_lines)
    var m: i64 = len(b_lines)

    // 公共前缀：前部逐行相等
    var pre: i64 = 0
    while pre < n && pre < m {
        if a_lines[pre] != b_lines[pre] {
            break
        }
        pre = pre + 1
    }
    // 公共后缀：后部逐行相等（不与前缀重叠）
    var suf: i64 = 0
    while pre + suf < n && pre + suf < m {
        if a_lines[n - 1 - suf] != b_lines[m - 1 - suf] {
            break
        }
        suf = suf + 1
    }

    // 前缀全为 keep
    var i: i64 = 0
    while i < pre {
        table_push(ops, 0)
        table_push(aa, i + 1)
        table_push(bb, i + 1)
        i = i + 1
    }

    // 中段 [pre, n-suf) × [pre, m-suf)
    var ops2 = table_new_i64()
    var aa2 = table_new_i64()
    var bb2 = table_new_i64()
    myers(a_lines, pre, n - suf, b_lines, pre, m - suf, ops2, aa2, bb2)
    var j: i64 = 0
    while j < len(ops2) {
        table_push(ops, ops2[j])
        table_push(aa, aa2[j])
        table_push(bb, bb2[j])
        j = j + 1
    }

    // 后缀全为 keep（a/b 行编号到整体 1-based）
    i = 0
    while i < suf {
        table_push(ops, 0)
        table_push(aa, n - suf + i + 1)
        table_push(bb, m - suf + i + 1)
        i = i + 1
    }

    res.ops = ops
    res.a_ln = aa
    res.b_ln = bb
    return res
}

// ============================================================================
// 二、Myers O(ND)：中段 [a0,a1) × [b0,b1) 的 LCS 编辑脚本
// ============================================================================

// 对 a[a0..a1) 与 b[b0..b1) 计算最小编辑脚本，追加进 r_ops/r_al/r_bl（ref 回写）。
// 经典前向 Myers + trace 回溯重建。中段 D>c_max_d 时退化整段 del+add（兜底）。
// 所有中间表为 i64 计数表（V / trace / 断点表），不存文本行副本。
func myers(a: table<string>, a0: i64, a1: i64, b: table<string>, b0: i64, b1: i64,
           r_ops: ref table<i64>, r_al: ref table<i64>, r_bl: ref table<i64>) {
    var ops = table_new_i64()
    var al = table_new_i64()
    var bl = table_new_i64()
    var n: i64 = a1 - a0
    var m: i64 = b1 - b0

    // 退化：中段为空
    if n == 0 && m == 0 {
        r_ops = ops
        r_al = al
        r_bl = bl
        return
    }
    if n == 0 {
        var i: i64 = 0
        while i < m {
            table_push(ops, 2)
            table_push(al, 0)
            table_push(bl, b0 + i + 1)
            i = i + 1
        }
        r_ops = ops
        r_al = al
        r_bl = bl
        return
    }
    if m == 0 {
        var i: i64 = 0
        while i < n {
            table_push(ops, 1)
            table_push(al, a0 + i + 1)
            table_push(bl, 0)
            i = i + 1
        }
        r_ops = ops
        r_al = al
        r_bl = bl
        return
    }

    var off: i64 = n + m          // MAX；k 偏移 +off，使负 k 映射到非负下标
    var vsize: i64 = 2 * off + 1
    var V = table_new_i64()
    var vi: i64 = 0
    while vi < vsize {
        table_push(V, -1)
        vi = vi + 1
    }
    V[off + 1] = 0                // 起点：k=1 → x=0

    var trace = table_new_i64()   // 扁平：行(d)*vsize + (k+off)，行 d 存 V_{d-1} 快照
    var found: i64 = 0
    var fallback: i64 = 0
    var d: i64 = 0
    while d <= off && found == 0 && fallback == 0 {
        // 快照当前 V 至第 d 行（= V_{d-1}）
        vi = 0
        while vi < vsize {
            table_push(trace, V[vi])
            vi = vi + 1
        }
        var k: i64 = -d
        while k <= d {
            var km: i64 = k - 1
            var kp: i64 = k + 1
            var x: i64 = 0
            if k == -d || (k != d && V[off + km] < V[off + kp]) {
                x = V[off + kp]
            } else {
                x = V[off + km] + 1
            }
            var y: i64 = x - k
            while x < n && y < m && a[a0 + x] == b[b0 + y] {
                x = x + 1
                y = y + 1
            }
            V[off + k] = x
            if x >= n && y >= m {
                found = 1
                break
            }
            k = k + 2
        }
        if found == 0 && d >= 800 {
            fallback = 1
        }
        d = d + 1
    }

    if fallback == 1 {
        // 兜底：D 超上限，退化整段 del（a 全部）+ add（b 全部）。
        var fi: i64 = 0
        while fi < n {
            table_push(ops, 1)
            table_push(al, a0 + fi + 1)
            table_push(bl, 0)
            fi = fi + 1
        }
        var fj: i64 = 0
        while fj < m {
            table_push(ops, 2)
            table_push(al, 0)
            table_push(bl, b0 + fj + 1)
            fj = fj + 1
        }
        r_ops = ops
        r_al = al
        r_bl = bl
        return
    }

    // 命中的编辑距离 D
    var D: i64 = d - 1
    var vsz = vsize

    // 断点表：bpX/bpY 存每层 d 的 snake 终点；mv[d] 记录该层动作（1=down/add，2=del）
    var bpX = table_new_i64()
    var bpY = table_new_i64()
    var mv = table_new_i64()
    var zi: i64 = 0
    while zi < D + 1 {
        table_push(bpX, 0)
        table_push(bpY, 0)
        table_push(mv, 0)
        zi = zi + 1
    }
    bpX[D] = n
    bpY[D] = m
    var x: i64 = n
    var y: i64 = m
    var dd: i64 = D
    while dd >= 1 {
        var k: i64 = x - y
        // 快照惯例：行索引 r 存的是处理第 r 层前的 V（= V_{r-1}）。
        // 回溯第 dd 层需用 V_{dd-1}，故取行索引 dd（非 dd-1）。
        var rb: i64 = dd * vsz
        var vkm: i64 = trace[rb + off + (k - 1)]
        var vkp: i64 = trace[rb + off + (k + 1)]
        var prevK: i64 = 0
        if k == -dd || (k != dd && vkm < vkp) {
            prevK = k + 1
        } else {
            prevK = k - 1
        }
        var prevX: i64 = trace[rb + off + prevK]
        var prevY: i64 = prevX - prevK
        bpX[dd - 1] = prevX
        bpY[dd - 1] = prevY
        if prevK == k + 1 {
            mv[dd] = 1   // down 动作：先 ADD 再 snake
        } else {
            mv[dd] = 2   // right 动作：先 DEL 再 snake
        }
        x = prevX
        y = prevY
        dd = dd - 1
    }

    // 前向回放：d=0 初始 snake（0,0）→ bpX[0]
    var cx: i64 = 0
    var cy: i64 = 0
    while cx < bpX[0] {
        table_push(ops, 0)
        table_push(al, a0 + cx + 1)
        table_push(bl, b0 + cy + 1)
        cx = cx + 1
        cy = cy + 1
    }
    // 每层段：断点 (dd-1) → (dd)
    var d2: i64 = 1
    while d2 <= D {
        var bx0: i64 = bpX[d2 - 1]
        var by0: i64 = bpY[d2 - 1]
        var bx1: i64 = bpX[d2]
        var by1: i64 = bpY[d2]
        if mv[d2] == 1 {
            // down：先 ADD b[by0]，再 snake keep
            table_push(ops, 2)
            table_push(al, 0)
            table_push(bl, b0 + by0 + 1)
            var sx: i64 = bx0
            var sy: i64 = by0 + 1
            while sx < bx1 {
                table_push(ops, 0)
                table_push(al, a0 + sx + 1)
                table_push(bl, b0 + sy + 1)
                sx = sx + 1
                sy = sy + 1
            }
        } else {
            // right：先 DEL a[bx0]，再 snake keep
            table_push(ops, 1)
            table_push(al, a0 + bx0 + 1)
            table_push(bl, 0)
            var sx: i64 = bx0 + 1
            var sy: i64 = by0
            while sy < by1 {
                table_push(ops, 0)
                table_push(al, a0 + sx + 1)
                table_push(bl, b0 + sy + 1)
                sx = sx + 1
                sy = sy + 1
            }
        }
        d2 = d2 + 1
    }

    r_ops = ops
    r_al = al
    r_bl = bl
}

// ============================================================================
// 三、UNIFIED 最小子集输出
// ============================================================================

// 将 a→b 的行级 diff 输出为 UNIFIED 格式文本。
// 固定头 `--- a\n+++ b\n`；随后 keep 行前置空格（保形，空行输出为单独空格行）、
// del 行 `-<行>`、add 行 `+<行>`。不带 @@ hunk 头（最小子集）。结尾**不带末尾换行**。
pub func unified(a_lines: table<string>, b_lines: table<string>) -> string {
    var r = line_diff(a_lines, b_lines)
    var sb = string_builder()
    sb_append(sb, "--- a\n")
    sb_append(sb, "+++ b\n")
    var t: i64 = len(r.ops)
    var i: i64 = 0
    while i < t {
        var kind: i64 = r.ops[i]
        if kind == 0 {
            sb_append(sb, " ")
            sb_append(sb, a_lines[r.a_ln[i] - 1])
        } else if kind == 1 {
            sb_append(sb, "-")
            sb_append(sb, a_lines[r.a_ln[i] - 1])
        } else {
            sb_append(sb, "+")
            sb_append(sb, b_lines[r.b_ln[i] - 1])
        }
        if i + 1 < t {
            sb_append(sb, "\n")
        }
        i = i + 1
    }
    return sb_build(sb)
}
}