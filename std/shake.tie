type tie<class>
// ============================================================================
// shake.tie：标准库——SHAKE128/256（可扩展输出函数 XOF，命名空间 shake）
// 用途：FIPS 202 的 SHAKE XOF——把任意消息扩展为**任意长度**输出，是 SHA3 的
//   可扩展形态。SPHINCS+ / SLH-DSA 哈希树与 TweakedHash 的底层原语（FIPS 205）。
//   与 NIST / Python hashlib.shake_128 / shake_256 二进制兼容。
// 接口（输入为**小写十六进制字符串**，字节级；Out 为 hex，可任意长度）：
//   shake.shake128(msg_hex: string, outlen: i64) -> string   // rate=168，输出 outlen 字节 hex
//   shake.shake256(msg_hex: string, outlen: i64) -> string   // rate=136，输出 outlen 字节 hex
//
// 算法（FIPS 202 / Keccak）：
//   - 自持 Keccak-f[1600] 海绵内核：25 个 64 位 lane，24 轮（θ/ρ/π/χ/ι），
//     ρ/π 复合置换用 Keccak 参考 in-place 流水写法（与 std/sha3.tie 同构）。
//   - 与 sha3.tie 的差异在"域分隔"与"可扩展挤压"：
//       · 填充字节 **0x1f**（SHAKE 域，区别于 SHA3 的 0x06）；
//       · 挤压支持**任意长度**：outlen > rate 时反复置换继续挤（后者 squeezed
//         fetch 区不做吸收异或），outlen 无须为 8 的倍数。
//     sha3.tie 的 keccak 为私有（0x06 后缀、单次置换输出）不满足此二者，故本
//     模块自持内核，**不触碰 sha3.tie 既有 API**。
//   - 消息以 hex（字节级）传入（同 hmac/hkdf 约定），逐字节 XOR 进 rate 区；
//     多速率填充 pad10*1 + 域块 0x1f（末字节 0x80；只剩 1 字节时仅 XOR 0x80，
//     避免 0x1f 与 0x80 碰撞）。
//
// 标准向量（FIPS 202 / Python hashlib.shake_128/_256，已核对）：
//   SHAKE128("")  首 32B = 7f9c2ba4e88f827d616045507605853ed73b8093f6efbc88eb1a6eacfa66ef26
//   SHAKE128("abc")首 32B = 5881092dd818bf5cf8a3ddb793fbcba74097d5c526a6d35f97b83351940f2cc8
//   SHAKE256("")  首 32B = 46b9dd2b0ba88d13233b3feb743eeb243fcd52ea62b81b82b50c27646ed5762f
//   SHAKE256("abc")首 32B = 483366601360a8771c6863080cc4114d8db44530f8f1e1ee4f94ea37e78b5739
//   其中空串传 ""、"abc" 传 "616263"（hex）。outlen 非 32 倍、非 8 倍、跨 rate
//   （outlen 168/169）等边界见 tests/shake_probe/shake_probe.tie（Python 交叉）。
// 探针：tests/shake_probe/shake_probe.tie。
// 备注：命名空间内互调为裸调用，内部函数不加 shake_ 前缀。
// ============================================================================

var sk_rc: table<i64>;     // 24 轮轮常量 RC（每轮 [hi, lo] 半分 = 48 项）
var sk_rotc: table<i64>;   // ρ/π 流水轮转量（24 项）
var sk_piln: table<i64>;   // ρ/π 流水目的 lane（24 项）

namespace shake {

// 惰性构建 24 轮 RC 常量（[hi, lo] 交错，48 项）。
func ensure_rc() {
    if len(sk_rc) > 0 {
        return
    }
    var h = "0000000000000000800000008000000000000000000000008000000080000000" +
            "0000000000000000000000000000000000000000800000008000000080000000" +
            "8000000080000000000000008000000080000000800000000000000080000000"
    var l = "00000001000080820000808a800080000000808b800000018000808100008009" +
            "0000008a00000088800080098000000a8000808b0000008b0000808900008003" +
            "00008002000000800000800a8000000a80008081000080808000000180008008"
    var i: i64 = 0
    while i < 24 {
        table_push(sk_rc, parse_hex32(substr(h, i * 8, i * 8 + 8)))
        table_push(sk_rc, parse_hex32(substr(l, i * 8, i * 8 + 8)))
        i = i + 1
    }
}

// 惰性构建 ρ/π 流水常量（Keccak 参考源码 rotc 与 piln，各 24 项）。
func ensure_rp() {
    if len(sk_rotc) > 0 {
        return
    }
    var rt = [1, 3, 6, 10, 15, 21, 28, 36, 45, 55, 2, 14, 27, 41, 56, 8, 25, 43, 62, 18, 39, 61, 20, 44]
    var pl = [10, 7, 11, 17, 18, 3, 5, 16, 8, 21, 24, 4, 15, 23, 19, 13, 12, 2, 20, 14, 22, 9, 6, 1]
    var i: i64 = 0
    while i < 24 {
        table_push(sk_rotc, rt[i])
        table_push(sk_piln, pl[i])
        i = i + 1
    }
}

// 截取字符串 [a, b)（码点区间）——内联实现（不依赖 string.tie）。
func substr(s: string, a: i64, b: i64) -> string {
    var out: string = ""
    var i: i64 = a
    while i < b {
        out = out + str_char(s, i)
        i = i + 1
    }
    return out
}

// 单字符十六进制数字（0..15）；非十六进制返回 0（仅用于解析内部常量/hex 输入）。
func hex_nibble(c: string) -> i64 {
    var digits = "0123456789abcdef"
    var i: i64 = 0
    while i < 16 {
        if str_char(digits, i) == c {
            return i
        }
        i = i + 1
    }
    return 0
}

// 解析 8 个 hex 字符为 32 位 i64（恒 <2^32 正数）。
func parse_hex32(s: string) -> i64 {
    var v: i64 = 0
    var i: i64 = 0
    while i < 8 {
        v = ((v << 4) | hex_nibble(str_char(s, i))) & 0xFFFFFFFF
        i = i + 1
    }
    return v
}

// hex 字符串 → 字节表（每 2 位 hex 一个字节 0..255）。
func hex_to_bytes(h: string) -> table<i64> {
    var n: i64 = len(h) / 2
    var t = table_new_i64()
    var i: i64 = 0
    while i < n {
        var hi = hex_nibble(str_char(h, i * 2))
        var lo = hex_nibble(str_char(h, i * 2 + 1))
        table_push(t, (hi << 4) | lo)
        i = i + 1
    }
    return t
}

// 字节 → 2 位小写 hex。
func hex2(v: i64) -> string {
    var hex = "0123456789abcdef"
    return str_char(hex, (v >> 4) & 0xF) + str_char(hex, v & 0xF)
}

// 生成双元素表 [hi, lo]（64 位字载体；掩码保正）。
func w64(hi: i64, lo: i64) -> table<i64> {
    var o = table_new_i64()
    table_push(o, hi & 0xFFFFFFFF)
    table_push(o, lo & 0xFFFFFFFF)
    return o
}

// 64 位逻辑右移 r 位（r 0..63）→ [hi,lo]。
func lsr64(ah: i64, al: i64, r: i64) -> table<i64> {
    if r == 0 {
        return w64(ah, al)
    }
    if r < 32 {
        return w64((ah >> r), ((al >> r) | (ah << (32 - r))))
    }
    if r == 32 {
        return w64(0, ah)
    }
    return w64(0, (ah >> (r - 32)))
}

// 64 位逻辑左移 r 位（r 0..63）→ [hi,lo]。
func shl64(ah: i64, al: i64, r: i64) -> table<i64> {
    if r == 0 {
        return w64(ah, al)
    }
    if r < 32 {
        return w64(((ah << r) | (al >> (32 - r))), (al << r))
    }
    if r == 32 {
        return w64(al, 0)
    }
    return w64((al << (r - 32)), 0)
}

// 64 位循环左移 r 位（r 0..63）→ [hi,lo] = (W<<r)|(W>>(64-r))。
func rotl64(ah: i64, al: i64, r: i64) -> table<i64> {
    if r == 0 {
        return w64(ah, al)
    }
    var a = shl64(ah, al, r)
    var b = lsr64(ah, al, 64 - r)
    return w64((a[0] | b[0]), (a[1] | b[1]))
}

// 把单字节 val XOR 进 state 的 rate 字节位置 j（j<rate）。
func xor_byte(state: ref table<i64>, j: i64, val: i64) {
    var lane = j / 8
    var sub = j % 8
    if sub >= 4 {
        state[2 * lane] = state[2 * lane] ^ ((val << (8 * (sub - 4))) & 0xFFFFFFFF)
    } else {
        state[2 * lane + 1] = state[2 * lane + 1] ^ ((val << (8 * sub)) & 0xFFFFFFFF)
    }
}

// 取 state 中 lane 的第 b 字节（0..7，b<4 来自 lo 半分、b≥4 来自 hi 半分）。
func lane_byte(state: ref table<i64>, lane: i64, b: i64) -> i64 {
    if b < 4 {
        return (state[2 * lane + 1] >> (8 * b)) & 0xFF
    }
    return (state[2 * lane] >> (8 * (b - 4))) & 0xFF
}

// 一次 Keccak-f[1600] 置换（24 轮），原地作用于 state（25 lane × [hi,lo] = 50 项）。
func keccakf(state: ref table<i64>) {
    var c = table_new_i64()
    var k: i64 = 0
    while k < 10 {
        table_push(c, 0)
        k = k + 1
    }
    var round: i64 = 0
    while round < 24 {
        // ---- θ：C[x] = 列异或；D = C[x-1] ^ rotl(C[x+1],1)；A[x,y] ^= D ----
        var x: i64 = 0
        while x < 5 {
            c[2 * x] = state[2 * x] ^ state[2 * (x + 5)] ^ state[2 * (x + 10)] ^ state[2 * (x + 15)] ^ state[2 * (x + 20)]
            c[2 * x + 1] = state[2 * x + 1] ^ state[2 * (x + 5) + 1] ^ state[2 * (x + 10) + 1] ^ state[2 * (x + 15) + 1] ^ state[2 * (x + 20) + 1]
            x = x + 1
        }
        x = 0
        while x < 5 {
            var xm1 = (x + 4) % 5
            var xp1 = (x + 1) % 5
            var r1 = rotl64(c[2 * xp1], c[2 * xp1 + 1], 1)
            var dh = c[2 * xm1] ^ r1[0]
            var dl = c[2 * xm1 + 1] ^ r1[1]
            var yy: i64 = 0
            while yy < 5 {
                state[2 * (x + 5 * yy)] = state[2 * (x + 5 * yy)] ^ dh
                state[2 * (x + 5 * yy) + 1] = state[2 * (x + 5 * yy) + 1] ^ dl
                yy = yy + 1
            }
            x = x + 1
        }
        // ---- ρ + π：in-place 流水（t=s[1]；目的 lane=piln[i]，轮转 rotc[i]）----
        var th = state[2]
        var tl = state[3]
        var pi: i64 = 0
        while pi < 24 {
            var jp = sk_piln[pi]
            var nh = state[2 * jp]
            var nl = state[2 * jp + 1]
            var r = rotl64(th, tl, sk_rotc[pi])
            state[2 * jp] = r[0]
            state[2 * jp + 1] = r[1]
            th = nh
            tl = nl
            pi = pi + 1
        }
        // ---- χ：A[x,y] = B[x,y] ^ (~B[x+1,y] & B[x+2,y])，行内 x 环绕；先快照整行 ----
        var yy2: i64 = 0
        while yy2 < 5 {
            var i0 = 5 * yy2
            var h0 = state[2 * i0];     var l0 = state[2 * i0 + 1]
            var h1 = state[2 * (i0 + 1)]; var l1 = state[2 * (i0 + 1) + 1]
            var h2 = state[2 * (i0 + 2)]; var l2 = state[2 * (i0 + 2) + 1]
            var h3 = state[2 * (i0 + 3)]; var l3 = state[2 * (i0 + 3) + 1]
            var h4 = state[2 * (i0 + 4)]; var l4 = state[2 * (i0 + 4) + 1]
            state[2 * i0] = h0 ^ ((0xFFFFFFFF ^ h1) & h2)
            state[2 * i0 + 1] = l0 ^ ((0xFFFFFFFF ^ l1) & l2)
            state[2 * (i0 + 1)] = h1 ^ ((0xFFFFFFFF ^ h2) & h3)
            state[2 * (i0 + 1) + 1] = l1 ^ ((0xFFFFFFFF ^ l2) & l3)
            state[2 * (i0 + 2)] = h2 ^ ((0xFFFFFFFF ^ h3) & h4)
            state[2 * (i0 + 2) + 1] = l2 ^ ((0xFFFFFFFF ^ l3) & l4)
            state[2 * (i0 + 3)] = h3 ^ ((0xFFFFFFFF ^ h4) & h0)
            state[2 * (i0 + 3) + 1] = l3 ^ ((0xFFFFFFFF ^ l4) & l0)
            state[2 * (i0 + 4)] = h4 ^ ((0xFFFFFFFF ^ h0) & h1)
            state[2 * (i0 + 4) + 1] = l4 ^ ((0xFFFFFFFF ^ l0) & l1)
            yy2 = yy2 + 1
        }
        // ---- ι：A[0,0] ^= RC[round] ----
        state[0] = state[0] ^ sk_rc[2 * round]
        state[1] = state[1] ^ sk_rc[2 * round + 1]
        round = round + 1
    }
}

// Keccak XOF 海绵主入口：msg_hex 按 rate 吸收 + pad10*1(0x1f) + 置换，
// 再按需反复置换挤压 outlen 字节（squeezed-off 区不再吸收异或）。
func sponge(rate: i64, outlen: i64, msg_hex: string) -> string {
    ensure_rc()
    ensure_rp()
    var msg_b = hex_to_bytes(msg_hex)
    var n: i64 = len(msg_b)
    var state = table_new_i64()
    var i: i64 = 0
    while i < 50 {
        table_push(state, 0)
        i = i + 1
    }
    var pos: i64 = 0
    while pos + rate <= n {
        var j: i64 = 0
        while j < rate {
            xor_byte(state, j, msg_b[pos + j])
            j = j + 1
        }
        keccakf(state)
        pos = pos + rate
    }
    var rem = n - pos
    var jj: i64 = 0
    while jj < rem {
        xor_byte(state, jj, msg_b[pos + jj])
        jj = jj + 1
    }
    if rem == rate - 1 {
        xor_byte(state, rem, 0x80)
    } else {
        xor_byte(state, rem, 0x1f)
        xor_byte(state, rate - 1, 0x80)
    }
    keccakf(state)
    // 挤压：每轮取 rate 字节（lane 小端展开），不足一轮补置换继续挤。
    var out: string = ""
    var produced: i64 = 0
    while produced < outlen {
        var take = rate
        if produced + take > outlen {
            take = outlen - produced
        }
        var k: i64 = 0
        while k < take {
            out = out + hex2(lane_byte(state, k / 8, k % 8))
            k = k + 1
        }
        produced = produced + take
        if produced < outlen {
            keccakf(state)
        }
    }
    return out
}

// SHAKE128：rate=168，输出 outlen 字节。
pub func shake128(msg_hex: string, outlen: i64) -> string {
    return sponge(168, outlen, msg_hex)
}

// SHAKE256：rate=136，输出 outlen 字节。
pub func shake256(msg_hex: string, outlen: i64) -> string {
    return sponge(136, outlen, msg_hex)
}

}   // namespace shake