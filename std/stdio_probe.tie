type tie<logic>
// stdio_probe.tie：p.6.9.1 stdio 回显探针（stdin 字节 → stdout 字节逐字节一致）
// ============================================================
// 用法：cmd /c "type echo_in.bin | stdio_probe.exe > echo_out.bin"
// 验收：echo_out.bin 与 echo_in.bin 字节完全一致（回显循环 + EOF 空表终止）。
// EN: echo probe — read all stdin bytes (chunked, EOF → empty table stops
// the loop) and write them back verbatim to stdout; the runner compares the
// output bytes against the input bytes for identity.

import "./stdio.tie"

func main() -> i64 {
    // 回显循环：逐块读 stdin 直到 EOF 空表，逐块原样写回 stdout
    var n: i64 = 0
    while n < 1000 {  // 防失控上限（输入超 4MB 的场景本探针不支持）
        var chunk = stdio.read_bytes(4096)
        if len(chunk) == 0 {
            break
        }
        if stdio.write_bytes(chunk) != len(chunk) {
            println("echo:short-write")
            return 1
        }
        n = n + 1
    }
    return 0
}