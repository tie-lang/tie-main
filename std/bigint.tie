type tie<class>
// ============================================================================
// bigint.tie：标准库——纯 tie 无符号大整数（命名空间 bigint）
// 用途：密码学算法的共通数学底座（Ed25519/X25519、ML-KEM/ML-DSA、RSA 等）。
//   提供变长无符号大整数的十六进制编解码、加减乘除、模幂、模逆、位操作。
//
// == 表示方案（limb 布局与位宽）==
//   无符号整数 = 变长 32 位 limb 数组，小端（limb[0] 为最低位），类型 table<i64>。
//   - 每个 limb 恒为正且 < 2^32（0x100000000），存进 i64（符号位恒 0）。
//   - 归一化：最高 limb 非零；**数值 0 表示为空表（len==0）**。
//   - 为何 32 位/64 位 i64 槽：任意两 limb 乘积 < (2^32)^2 = 2^64，配合 u128
//     中间量进位永不溢出；每 limb 恰 8 个 hex 字符、32 bit，位运算整洁。
//   所有函数为纯函数：输入表只读（表以句柄传递会别名，调用方绝不被改动），
//   输出一律新建表（含内部工作拷贝显式 clone）。
//
// == 数值安全论证（对齐 std/crypto.tie 风格）==
//   i64 是有符号类型：`>>` 生成 ashr（算术右移；见 std/crypto.tie 头部、ir.rs
//   BinaryOp::Shr 逻辑）。本文件所有 limb 恒正 < 2^32 → 对正数 ashr 即逻辑右移。
//   所有可能溢出的乘/进位/试商估计一律在 u128（as_u128/as_i64）中计算，绝无
//   i64 静默回绕：
//     - add：t = va+vb+carry ≤ 3·(2^32-1) < 2^35，u128 充裕；
//     - mul：t = a[i]·b[j] + acc + carry ≤ (2^32-1)^2 + 2·(2^32-1) < 2^64，u128 充裕；
//     - divrem（Knuth 算法 D）试商 qhat ≈ (u{j+n}·B+u{j+n-1})/v{n-1}，2 limb 估、
//       校正与乘减全部 u128。
//   u128 为本库关键底座能力（tests/language/i128_full.tie 验收）；因此乘除免去
//   xxh3 的 16 位分块——内层全 32×32→u128，简洁且地址无溢出。
//
// == 常数时间注记（密码用途）==
//   powmod 采用平方乘、invmod 采用扩展欧几里得，二者迭代次数仅与被操作数的
//   位长相关、不依赖数值的机密性位——循环上界恒定（不按数据早退）。
//   **限制：tie 暂无数常数时间保证机制**（无 volatile/无乘除法恒定原语；分支
//   允许被后端自由重排）。因此本模块**在文档层标记**：敏感密码路径需在调用层
//   复核常数时间性；真正侧信道隔离须在汇编/平台层落实，本库不保证且不建议
//   依赖 powmod 分支耗时作为防侧信道手段。
//
// == 错误/边界约定 ==
//   - 除数/模数 0：divrem/div/mod 返回 0（q=0,r=0）；powmod 模 0 返回 0。
//     调用方应在业务层避免（密码模数恒非零）。
//   - 模 1：mod(a,1)=0；powmod(x,e,1)=0；invmod(a,1)=0（一切 ≡0 mod 1）。
//   - invmod 无逆元（gcd(a,m)>1）时返回 0（空表）。
//   - 减法 sub(a,b) 约定 a≥b；a<b 行为未定义（不检查，与低位大数通常一致）。
//   - from_hex 遇非法字符（非 0-9a-fA-F）返回 0；大小写均接受，可选 "0x" 前缀。
//   - to_hex 输出最小化小写 hex（无前导零，0 输出 "0"）。
//
// 依赖：仅原生原语（str_len/str_char/len/table_new_*/table_push/位运算 +
//   as_i128/as_u128/u128 算术），不 import 任何 std 模块，自包含。
// 命名规范：命名空间内互调为裸调用，公共 API 全部 pub（直接 bigint.xxx 调用）。
// ============================================================================

// 十六进制字符台（模块级顶层字符串全局，b48/poly1305 同模式）。
var hex_digits: string = "0123456789abcdef"

namespace bigint {

// ---------------------------------------------------------------------------
// 基础工具
// ---------------------------------------------------------------------------

// 复制表（tie 表赋值会句柄别名，需显式 clone；返回全新表）。
func clone(a: table<i64>) -> table<i64> {
    var r = table_new_i64()
    var i: i64 = 0
    while i < len(a) {
        table_push(r, a[i])
        i = i + 1
    }
    return r
}

// 判断是否 0（空表表示 0）。
pub func is_zero(a: table<i64>) -> bool {
    return len(a) == 0
}

// 生成 n 个 0 limb 的表（低位在前）。
func zeros(n: i64) -> table<i64> {
    var r = table_new_i64()
    var i: i64 = 0
    while i < n {
        table_push(r, 0)
        i = i + 1
    }
    return r
}

// 归一化：去掉最高端 0 limb（0 全去掉→空表）。输入为自有表（只读读取，返回新表）。
func trim(x: table<i64>) -> table<i64> {
    var n = len(x)
    var top = n
    while top > 0 && x[top - 1] == 0 {
        top = top - 1
    }
    var r = table_new_i64()
    var i: i64 = 0
    while i < top {
        table_push(r, x[i])
        i = i + 1
    }
    return r
}

// 十六进制字符 → 数值（0..15）；非法返回 -1。
func nibble(c: string) -> i64 {
    // 先数字 0-9，再 a-f，再 A-F
    var m: i64 = str_len(hex_digits)
    var j: i64 = 0
    while j < m {
        if str_char(hex_digits, j) == c {
            return j
        }
        j = j + 1
    }
    var up = "ABCDEF"
    m = str_len(up)
    j = 0
    while j < m {
        if str_char(up, j) == c {
            return 10 + j
        }
        j = j + 1
    }
    return -1
}

// 给最低 limb 加一个小值 d（0≤d<2^32，进位链至多到顶）。
func add_small(a: table<i64>, d: i64) -> table<i64> {
    var r = table_new_i64()
    var carry: i64 = d
    var i: i64 = 0
    while i < len(a) && carry > 0 {
        var s = a[i] + carry
        if s >= 0x100000000 {
            s = s - 0x100000000
            carry = 1
        } else {
            carry = 0
        }
        table_push(r, s)
        i = i + 1
    }
    while i < len(a) {
        table_push(r, a[i])
        i = i + 1
    }
    if carry > 0 {
        table_push(r, carry)
    }
    return r
}

// ---------------------------------------------------------------------------
// 编码/解码
// ---------------------------------------------------------------------------

// 大整数 → 最小化小写 hex（0 → "0"）。最高 limb 去除前导零 nibble。
pub func to_hex(a: table<i64>) -> string {
    if len(a) == 0 {
        return "0"
    }
    var out: string = ""
    var n = len(a)
    var i: i64 = n - 1
    while i >= 0 {
        var limb = a[i]
        var c: i64 = 7
        while c >= 0 {
            var nib: i64 = (limb >> (4 * c)) & 0xF
            if i == n - 1 {
                // 最高 limb：跳过前导 0（至多一位非 0 保证出现）
                if nib != 0 || len(out) > 0 {
                    out = out + str_char(hex_digits, nib)
                }
            } else {
                out = out + str_char(hex_digits, nib)
            }
            c = c - 1
        }
        i = i - 1
    }
    return out
}

// hex 字符串 → 大整数。接受 0x/0X 前缀与大小写；非法字符返回 0。
// 算法：自最高 nibble 向下 value = value*16 + d（乘 16 = 左移 4 位 + 加 d）。
pub func from_hex(s: string) -> table<i64> {
    var out = table_new_i64()
    var n = len(s)
    var i: i64 = 0
    if n >= 2 && str_char(s, 0) == "0" &&
       (str_char(s, 1) == "x" || str_char(s, 1) == "X") {
        i = 2
    }
    while i < n {
        var d = nibble(str_char(s, i))
        if d < 0 {
            return table_new_i64()   // 非法字符 → 0
        }
        out = shl_bits(out, 4)
        out = add_small(out, d)
        i = i + 1
    }
    return out
}

// ---------------------------------------------------------------------------
// 位操作
// ---------------------------------------------------------------------------

// 左移 k 位（k≥0）。内部供 from_hex/normalize 使用。
pub func shl_bits(a: table<i64>, k: i64) -> table<i64> {
    if len(a) == 0 || k <= 0 {
        return clone(a)
    }
    var limbShift = k / 32
    var bitShift = k % 32
    var r = zeros(limbShift)
    if bitShift == 0 {
        var i: i64 = 0
        while i < len(a) {
            table_push(r, a[i])
            i = i + 1
        }
    } else {
        var carry: i64 = 0
        var i: i64 = 0
        while i < len(a) {
            var v: u128 = (as_u128(a[i]) << bitShift) | as_u128(carry)
            table_push(r, as_i64(v & 0xFFFFFFFFu128))
            carry = as_i64(v >> 32)
            i = i + 1
        }
        if carry > 0 {
            table_push(r, carry)
        }
    }
    return r
}

// 逻辑右移 k 位（k≥0）。输入恒正 → 无符号右移语义。
pub func shr_bits(a: table<i64>, k: i64) -> table<i64> {
    if len(a) == 0 || k <= 0 {
        return clone(a)
    }
    var limbShift = k / 32
    var bitShift = k % 32
    if limbShift >= len(a) {
        return table_new_i64()
    }
    var r = table_new_i64()
    if bitShift == 0 {
        var i: i64 = limbShift
        while i < len(a) {
            table_push(r, a[i])
            i = i + 1
        }
        return r
    }
    // 每新 limb = 位窗口 [limbShift+i 的 bitShift .. bitShift+32)：u128 取 2 邻 limb。
    var nout = len(a) - limbShift
    var i: i64 = 0
    while i < nout - 1 {
        var p = i + limbShift
        var win: u128 = (as_u128(a[p + 1]) << 32) | as_u128(a[p])
        table_push(r, as_i64((win >> bitShift) & 0xFFFFFFFFu128))
        i = i + 1
    }
    // 末 limb 仅剩窗口
    var last: u128 = as_u128(a[len(a) - 1]) >> bitShift
    table_push(r, as_i64(last & 0xFFFFFFFFu128))
    return trim(r)
}

// 位长（bitlen）：0 → 0。
pub func bitlen(a: table<i64>) -> i64 {
    var n = len(a)
    if n == 0 {
        return 0
    }
    var top = a[n - 1]
    var bits: i64 = 0
    while top > 0 {
        top = top >> 1
        bits = bits + 1
    }
    return (n - 1) * 32 + bits
}

// 按位与（缺 limb 视为 0 → 结果长度 = min）。
pub func and(a: table<i64>, b: table<i64>) -> table<i64> {
    var n = len(a)
    if len(b) < n {
        n = len(b)
    }
    var r = table_new_i64()
    var i: i64 = 0
    while i < n {
        table_push(r, a[i] & b[i])
        i = i + 1
    }
    return trim(r)
}

// 按位或（缺 limb 视为 0 → 结果长度 = max）。
pub func or(a: table<i64>, b: table<i64>) -> table<i64> {
    var n = len(a)
    if len(b) > n {
        n = len(b)
    }
    var r = table_new_i64()
    var i: i64 = 0
    while i < n {
        var x: i64 = 0
        if i < len(a) {
            x = a[i]
        }
        var y: i64 = 0
        if i < len(b) {
            y = b[i]
        }
        table_push(r, x | y)
        i = i + 1
    }
    return trim(r)
}

// ---------------------------------------------------------------------------
// 加减
// ---------------------------------------------------------------------------

// 加法（进位链）。
pub func add(a: table<i64>, b: table<i64>) -> table<i64> {
    var r = table_new_i64()
    var na = len(a)
    var nb = len(b)
    var nmax: i64 = na
    if nb > nmax {
        nmax = nb
    }
    var carry: u128 = as_u128(0)
    var i: i64 = 0
    while i < nmax {
        var va: u128 = as_u128(0)
        if i < na {
            va = as_u128(a[i])
        }
        var vb: u128 = as_u128(0)
        if i < nb {
            vb = as_u128(b[i])
        }
        var t: u128 = va + vb + carry
        table_push(r, as_i64(t & 0xFFFFFFFFu128))
        carry = t >> 32
        i = i + 1
    }
    if carry != as_u128(0) {
        table_push(r, as_i64(carry & 0xFFFFFFFFu128))
    }
    // add 最高 limb 由进位决定，天然归一化（非空情形顶 limb 非 0）。
    return r
}

// 减法（借位；约定 a≥b，a<b 未定义）。
pub func sub(a: table<i64>, b: table<i64>) -> table<i64> {
    var r = table_new_i64()
    var na = len(a)
    var nb = len(b)
    var borrow: i64 = 0
    var i: i64 = 0
    while i < na {
        var vb: i64 = 0
        if i < nb {
            vb = b[i]
        }
        var d = a[i] - vb - borrow
        if d < 0 {
            d = d + 0x100000000
            borrow = 1
        } else {
            borrow = 0
        }
        table_push(r, d)
        i = i + 1
    }
    // a==b 或高位借位清掉 → 可能有多余 0 limb，归一化。
    return trim(r)
}

// 比较：-1 / 0 / 1。
pub func cmp(a: table<i64>, b: table<i64>) -> i64 {
    var na = len(a)
    var nb = len(b)
    if na != nb {
        if na > nb {
            return 1
        }
        return -1
    }
    var i: i64 = na - 1
    while i >= 0 {
        if a[i] != b[i] {
            if a[i] > b[i] {
                return 1
            }
            return -1
        }
        i = i - 1
    }
    return 0
}

// ---------------------------------------------------------------------------
// 乘法（schoolbook，u128 内层）
// ---------------------------------------------------------------------------

pub func mul(a: table<i64>, b: table<i64>) -> table<i64> {
    var na = len(a)
    var nb = len(b)
    if na == 0 || nb == 0 {
        return table_new_i64()
    }
    // 结果长度 na+nb，全 0 预置；逐列积 + 进位折入高位。
    var r = zeros(na + nb)
    var i: i64 = 0
    while i < na {
        var c: u128 = as_u128(0)
        var j: i64 = 0
        while j < nb {
            var t: u128 = as_u128(a[i]) * as_u128(b[j]) + as_u128(r[i + j]) + c
            r[i + j] = as_i64(t & 0xFFFFFFFFu128)
            c = t >> 32
            j = j + 1
        }
        // 把 c 折入 r[i+n]，可能 +1 进位向更高处传播（理论 c < B，见头部论证）。
        var addv: u128 = c + as_u128(r[i + nb])
        r[i + nb] = as_i64(addv & 0xFFFFFFFFu128)
        var cc = addv >> 32
        var k: i64 = i + nb + 1
        while cc != as_u128(0) && k < na + nb {
            var vv: u128 = as_u128(r[k]) + cc
            r[k] = as_i64(vv & 0xFFFFFFFFu128)
            cc = vv >> 32
            k = k + 1
        }
        i = i + 1
    }
    return trim(r)
}

// ---------------------------------------------------------------------------
// 长除法（Knuth 算法 D，base 2^32）
// ---------------------------------------------------------------------------

pub func divrem(a: table<i64>, b: table<i64>) -> (table<i64>, table<i64>) {
    var z = table_new_i64()
    if len(b) == 0 {
        return (clone(z), clone(z))   // 除 0 未定义，返回 (0,0)
    }
    if len(a) == 0 {
        return (clone(z), clone(z))
    }
    if cmp(a, b) < 0 {
        return (clone(z), clone(a))
    }
    var an = len(a)
    var bn = len(b)

    // ---- 单 limb 除数快路径 ----
    if bn == 1 {
        var v0: u128 = as_u128(b[0])
        var q = zeros(an)
        var r: u128 = as_u128(0)
        var i: i64 = an - 1
        while i >= 0 {
            var cur: u128 = (r << 32) | as_u128(a[i])
            var qi: u128 = cur / v0
            r = cur % v0
            q[i] = as_i64(qi & 0xFFFFFFFFu128)
            i = i - 1
        }
        var rt = table_new_i64()
        if r != as_u128(0) {
            table_push(rt, as_i64(r))
        }
        return (trim(q), rt)
    }

    // ---- 多 limb：归一化，使 v 最高 limb ≥ 2^31 ----
    var vtop = b[bn - 1]
    var k: i64 = 0
    var tt = vtop
    while tt < 0x80000000 {
        tt = tt << 1
        k = k + 1
    }
    var V = shl_bits(b, k)
    var n = len(V)
    var D = shl_bits(a, k)
    var M = len(D)
    // U = D 后补一个 0 limb（Knuth 的 u[n+m] 顶部占位）
    var U = table_new_i64()
    var ii: i64 = 0
    while ii < M {
        table_push(U, D[ii])
        ii = ii + 1
    }
    table_push(U, 0)
    var m = M - n
    var q = zeros(m + 1)

    var vn1: i64 = V[n - 1]
    var vn2: i64 = V[n - 2]
    var vn1s: u128 = as_u128(vn1)
    var vn2s: u128 = as_u128(vn2)

    var j: i64 = m
    while j >= 0 {
        var ujn = U[j + n]
        var ujn1 = U[j + n - 1]
        var ujn2 = U[j + n - 2]
        var a2: u128 = (as_u128(ujn) << 32) | as_u128(ujn1)
        var qhat: u128 = as_u128(0)
        var rhat: u128 = as_u128(0)
        if ujn == vn1 {
            qhat = 0xFFFFFFFFu128
            rhat = a2 - (qhat * vn1s)
        } else {
            qhat = a2 / vn1s
            rhat = a2 % vn1s
        }
        var topC: u128 = as_u128(ujn2)
        // 校正（D3）：至多 2 次，rhat≥B 即终止
        while true {
            var tooBig: bool = qhat > 0xFFFFFFFFu128
            var bigProd: bool = (qhat * vn2s) > ((rhat << 32) + topC)
            if !tooBig && !bigProd {
                break
            }
            qhat = qhat - as_u128(1)
            rhat = rhat + vn1s
            if rhat > 0xFFFFFFFFu128 {
                break
            }
        }
        // 乘减（D4）：U[j..j+n] -= qhat*V
        var borrow: u128 = as_u128(0)
        var i4: i64 = 0
        while i4 < n {
            var p: u128 = qhat * as_u128(V[i4]) + borrow
            var ucur: i64 = U[j + i4]
            var lo: i64 = as_i64(p & 0xFFFFFFFFu128)
            var nv: i64 = ucur - lo
            var cb: i64 = 0
            if nv < 0 {
                nv = nv + 0x100000000
                cb = 1
            }
            U[j + i4] = nv
            borrow = (p >> 32) + as_u128(cb)
            i4 = i4 + 1
        }
        var topVal: i64 = U[j + n] - as_i64(borrow & 0xFFFFFFFFu128)
        var addback: i64 = 0
        if topVal < 0 {
            // 借位过头（qhat 估大 1）：加回 V 并减 1
            var cAdd: i64 = 0
            var i5: i64 = 0
            while i5 < n {
                var s = U[j + i5] + V[i5] + cAdd
                if s >= 0x100000000 {
                    s = s - 0x100000000
                    cAdd = 1
                } else {
                    cAdd = 0
                }
                U[j + i5] = s
                i5 = i5 + 1
            }
            topVal = topVal + cAdd
            addback = 1
        }
        U[j + n] = topVal
        q[j] = as_i64(qhat & 0xFFFFFFFFu128) - addback
        j = j - 1
    }

    // 余数 = U[0..n-1] / 2^k
    var r0 = table_new_i64()
    var rr: i64 = 0
    while rr < n {
        table_push(r0, U[rr])
        rr = rr + 1
    }
    if k > 0 {
        r0 = shr_bits(r0, k)
    }
    return (trim(q), trim(r0))
}

// 除法（商）。
pub func div(a: table<i64>, b: table<i64>) -> table<i64> {
    var (q, r) = divrem(a, b)
    return q
}

// 取模（余数）。
pub func mod(a: table<i64>, b: table<i64>) -> table<i64> {
    var (q, r) = divrem(a, b)
    return r
}

// ---------------------------------------------------------------------------
// 模幂（平方乘，常数迭代次数按指数位长）
// ---------------------------------------------------------------------------

pub func powmod(base: table<i64>, exp: table<i64>, m: table<i64>) -> table<i64> {
    if len(m) == 0 {
        return table_new_i64()   // 模 0 → 0
    }
    var result = table_new_i64()
    table_push(result, 1)        // result = 1
    var b2 = mod(base, m)        // base ∈ [0,m)
    var e = clone(exp)
    var one0 = table_new_i64()
    table_push(one0, 1)
    // 迭代次数 = 指数位长，与指数值机密位无关（正方形扫描低位）。
    while !is_zero(e) {
        var low: i64 = e[0] & 1
        if low != 0 {
            result = mod(mul(result, b2), m)
        }
        e = shr_bits(e, 1)
        b2 = mod(mul(b2, b2), m)
    }
    // 模 1 时一切 ≡0；否则返回 1（指数 0）。
    return mod(result, m)
}

// ---------------------------------------------------------------------------
// 模逆（扩展欧几里得；系数以无符号+符号归一化，免负大数）
// ---------------------------------------------------------------------------

// 带符号减法 a-b：返回 (幅值, 是否负)。
func signed_sub(a: table<i64>, b: table<i64>) -> (table<i64>, bool) {
    var c = cmp(a, b)
    if c >= 0 {
        return (sub(a, b), false)
    }
    return (sub(b, a), true)
}

// 把带符号量 (mag, neg) 约化为 [0,m) 的非负值（≡原值 mod m）。
func coef_reduce(mag: table<i64>, neg: bool, m: table<i64>) -> table<i64> {
    var r = mod(mag, m)
    if neg && !is_zero(r) {
        r = sub(m, r)
    }
    return r
}

pub func invmod(a0: table<i64>, m0: table<i64>) -> table<i64> {
    if len(m0) == 0 {
        return table_new_i64()
    }
    var m = clone(m0)
    var a = mod(clone(a0), m)   // a ∈ [0,m)
    var r0 = clone(m)
    var r1 = clone(a)
    var sy0 = table_new_i64()   // 系数 s0=0（对应 r0=m）
    var sy1 = table_new_i64()
    table_push(sy1, 1)          // 系数 s1=1（对应 r1=a）
    // 扩展欧几里得：每次把系数约化 mod m（保号归一化），q 只依赖 r 序列。
    while !is_zero(r1) {
        var (qx, rem) = divrem(r0, r1)
        var prod = mul(qx, sy1)
        var (mag, neg) = signed_sub(sy0, prod)
        var red = coef_reduce(mag, neg, m)
        sy0 = clone(sy1)
        sy1 = red
        r0 = clone(r1)
        r1 = rem
    }
    // r0 = gcd。不等于 1 → 无逆元。
    var onex = table_new_i64()
    table_push(onex, 1)
    if cmp(r0, onex) != 0 {
        return table_new_i64()
    }
    return sy0   // 已是 [0,m) 的逆（a*sy0 ≡ 1 mod m）
}

}   // namespace bigint