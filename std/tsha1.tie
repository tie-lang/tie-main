type tie<class>
// ============================================================================
// tsha1.tie：标准库——TSHA1 v2 哈希族（TIE Secure Hash Algorithm 1.0，state-per-n）
// 用途：tie 平台自有通用安全哈希底座（插件审计链 / 完整性校验 / 指纹）。
// 现状：v2「状态随输出位长 n」重构——内部状态规模由 n 决定，消除「输出扩展被
//   内部状态封顶」。唯一语义源：tests/tsha_probe/gen_tsha1_core.py（逐式镜像）。
//   设计：docs/superpowers/specs/2026-08-30-tsha1-state-per-n-design.md、
//         docs/superpowers/specs/2026-08-30-tsha1-security-design.md
//
// 接口（公开四类函数 + 一个导出用诊断辅助）：
//   tsha.tsha1f(msg, n, base=48) -> string  快速模型（F_压缩 一通用环核，R_F=12）
//   tsha.tsha1b(msg, n, base=48) -> string  复杂模型（三轨+海绵率，R_B=14）
//   tsha.tsha1x(msg, n, base=48) -> string  加强模型（四轨+LFSR，R_X=16）
//   tsha.tsha1r(msg, n, base=48) -> string  轻量模型（16-trit 半宽，R_R=8）
//   tsha.tsha1_digest(model, msg, n)        （内部诊断：返回状态全宽 hex，探针用）
// 位长集合（新）：{2,3,4,6,8,12,16,24,32,48,64,69,88,92,96,128,144}。
//   非法位长 / 非法 base 一律返回空串。
// base = 输出进制 {2,3,8,16,48}，默认 48；n 始终表示「48 进制下的位数」，其它进制
//   按信息量换算（b0 = ⌊n·L48/8⌋ 字节，取状态池前缀重编码——状态足则截断、
//   不足（正常不应发生）返回空串，**无 XOF**）。
//
// == 结构（v2 通用 W 字压缩核，唯一语义源 gen_tsha1_core.py）==
//   每字 = (M 幅值, N 符号) 两个 32 位平面（2i 存 M、2i+1 存 N）；f/b/x 每字 32 trit、
//   r 每字 16 trit（r 的 M/N 低 16 位有效，旋转一律 rrp16 = rrp(·, r&15) 且掩 0xFFFF）。
//   · 字宽 W：f/b/x = max(1,⌈n·L48/32⌉)、r = max(1,⌈n·L48/TRIT16⌉)，L48=log2(48)。
//   · 轨分配退化（alloc_tracks）：W≥16 用模型原轨数（f/r 双轨、b 三轨[率+容]、
//     x 四轨[三双轨+海绵+LFSR]）；8≤W<16 双轨；W<8 单轨环式；W<4 直接置换（单环）。
//   · 通用 ring_mix：轨内环式扩散（tadd2 平衡加 + tmul2 平衡乘 + quant3 majority +
//     消息注入 + 轮常量错位注入），值语义对任意 W 机械确定。
//   · 轮数固定：f R_F=12、r R_R=8、b R_B=14、x R_X=16。
//   · 块压缩：计数器式（纯零填充 + 64 位计数器 t），压缩后 fin_synth S=4 终筛。
//   · 末块折回 h[i] ^= v[2i] ^ rrp(v[2i+1],(i*3)&31)。
//
// == 常量（可复现，非 BLAKE2 IV）==
//   SEED + SHA-256(SEED ‖ u64be(k)) 计数器流（k=0,1,...）依序取 4 字节/字：
//   各模型 IV 预取 32 字（W 最大 32）、RCON 16 字；b 海绵常量 bscon、x LFSR 常量
//   xdcon 各独立种子 16 字。r 取数后低 16 位有效（掩码在使用点完成）。
//   SEED_F = "TSHA1-2026-f-256-v1"、SEED_R = "TSHA1-2026-r-128-v1"、
//   SEED_B = "TSHA1-2026-b-256-v1"、SEED_X = "TSHA1-2026-x-256-v1"、
//   SEED_BS = "TSHA1-2026-b-sponge-v1"、SEED_XD = "TSHA1-2026-x-lfsr-v1"。
//   注意：RCON 为 IV 32 字之后的 16 字（与 v1「IV 8 字 + RCON 位于第 8..23 字」不同）。
//
// == 验证 ==
//   烟雾验证：n=48 全宽 hex（f/b/x W=9 → 72 hex、r W=11 → 88 hex）与
//   gen_tsha1_core.py 逐字一致。KAT/探针联动（tests/tsha_probe）后续波次对齐。
// 逐字节处理（str_byte + len），任意 UTF-8 原始字节可哈希；命名空间内互调为裸调用。
// ============================================================================

import "./base48.tie"
using b48;

var tsha_ivf: table<i64>;    // tsha1f IV（32 个 32 位字，按需取前 W）
var tsha_rcf: table<i64>;    // tsha1f 轮常量（16 字）
var tsha_ivr: table<i64>;    // tsha1r IV（32 字）
var tsha_rcr: table<i64>;    // tsha1r 轮常量（16 字）
var tsha_ivb: table<i64>;    // tsha1b IV（32 字）
var tsha_rcb: table<i64>;    // tsha1b 轮常量（16 字）
var tsha_bcon: table<i64>;   // tsha1b 海绵轨轮常量（16 字）
var tsha_ivx: table<i64>;    // tsha1x IV（32 字）
var tsha_rcx: table<i64>;    // tsha1x 轨 A/B 轮常量（16 字）
var tsha_xdcon: table<i64>;  // tsha1x 轨 D（LFSR）轮常量（16 字）

namespace tsha {

// ---- 通用小工具（库内自足，与 sha/blake 同风格）----

// 取字符串 [a_p, b_p) 区间子串（与 std string 库 substr 等价）。
func substr(s: string, a_p: i64, b_p: i64) -> string {
    var out: string = ""
    var i: i64 = a_p
    while i < b_p {
        out = out + str_char(s, i)
        i = i + 1
    }
    return out
}

// 十六进制字符 → 值（0..15）；非十六进制字符返回 0。
func hex_nibble(c: string) -> i64 {
    var digits = "0123456789abcdef"
    var i: i64 = 0
    while i < 16 {
        if str_char(digits, i) == c {
            return i
        }
        i = i + 1
    }
    return 0
}

// 8 个十六进制字符 → 32 位值（4 字节 = 8 hex）。
func parse_hex32(s: string) -> i64 {
    var v: i64 = 0
    var i: i64 = 0
    while i < 8 {
        v = ((v << 4) | hex_nibble(str_char(s, i))) & 0xFFFFFFFF
        i = i + 1
    }
    return v
}

// 单个十六进制字节 → 数值（0..255）：读 hex[i], hex[i+1]。
func hex_byte(hex: string, i: i64) -> i64 {
    var hi = hex_nibble(str_char(hex, i))
    var lo = hex_nibble(str_char(hex, i + 1))
    return hi * 16 + lo
}

// 32 位循环右移 n 位（v < 2^32 正数，>> 即逻辑右移）。
func rr32(v: i64, n: i64) -> i64 {
    return ((v >> n) | (v << (32 - n))) & 0xFFFFFFFF
}

// 32 位循环左移 n 位。
func rl32(v: i64, n: i64) -> i64 {
    return ((v << (n & 31)) | (v >> (32 - (n & 31)))) & 0xFFFFFFFF
}

// 循环右移 r & 31（32 位位平面）。
func rrp(v: i64, r: i64) -> i64 {
    return rr32(v, r & 31)
}

// 循环右移 r & 15，先掩 0xFFFF（r 模型的 16-trit 半宽旋转）。
func rrp16(v: i64, r: i64) -> i64 {
    return rr32(v & 0xFFFF, r & 15)
}

// 通用旋转：half=true（r 模型）走 rrp16，否则 rrp。
func rotlane(x: i64, r: i64, half: bool) -> i64 {
    if half {
        return rrp16(x, r)
    }
    return rrp(x, r)
}

// 32 位值 → 8 位小写 hex（大端）。
func hex8(v: i64) -> string {
    var hex = "0123456789abcdef"
    var out: string = ""
    var p: i64 = 0
    while p < 8 {
        var shift = 28 - p * 4
        var nib = (v >> shift) & 0xF
        out = out + str_char(hex, nib)
        p = p + 1
    }
    return out
}

// 平衡三进制（balanced mod 3）两位 trit 相加，位切片实现（全 &/^/|/<<）。
func tadd2(Ma: i64, Na: i64, Mb: i64, Nb: i64) -> (mo: i64, no: i64) {
    var nMa = Ma ^ 0xFFFFFFFF
    var nNa = Na ^ 0xFFFFFFFF
    var nMb = Mb ^ 0xFFFFFFFF
    var nNb = Nb ^ 0xFFFFFFFF
    var aP = Ma & nNa
    var aN = Ma & Na
    var bP = Mb & nNb
    var bN = Mb & Nb
    var o_pos = ((nMa & Mb & nNb) | (Ma & nNa & nMb) | (aN & bN)) & 0xFFFFFFFF
    var o_neg = ((nMa & Mb & Nb) | (Ma & Na & nMb) | (aP & bP)) & 0xFFFFFFFF
    return (o_pos | o_neg, o_neg)
}

// majority 量化：三组位平面逐 trit 取签，+1 计数 ≥2 则该位为 1（平局→0）。
func quant3(m0: i64, n0: i64, m1: i64, n1: i64, m2: i64, n2: i64) -> i64 {
    var A = m0 & (n0 ^ 0xFFFFFFFF)
    var B = m1 & (n1 ^ 0xFFFFFFFF)
    var C = m2 & (n2 ^ 0xFFFFFFFF)
    return ((A & B) | (B & C) | (C & A)) & 0xFFFFFFFF
}

// 平衡三进制两位 trit 相乘（±1·±1=±1，0 吸收为 0）。
func tmul2(Ma: i64, Na: i64, Mb: i64, Nb: i64) -> (mo: i64, no: i64) {
    var amp = (Ma & Mb) & 0xFFFFFFFF
    var no = ((Na ^ Nb) & amp) & 0xFFFFFFFF
    return (amp, no)
}

// ---- 位长 / 字宽 / 进制度量 ----

// 位长是否在允许集合 {2,3,4,6,8,12,16,24,32,48,64,69,88,92,96,128,144} 内。
func is_bits48(n: i64) -> bool {
    if n == 2 { return true }
    if n == 3 { return true }
    if n == 4 { return true }
    if n == 6 { return true }
    if n == 8 { return true }
    if n == 12 { return true }
    if n == 16 { return true }
    if n == 24 { return true }
    if n == 32 { return true }
    if n == 48 { return true }
    if n == 64 { return true }
    if n == 69 { return true }
    if n == 88 { return true }
    if n == 92 { return true }
    if n == 96 { return true }
    if n == 128 { return true }
    if n == 144 { return true }
    return false
}

// 输出进制是否允许（{2,3,8,16,48}）。
func is_base_ok(base: i64) -> bool {
    if base == 2 { return true }
    if base == 3 { return true }
    if base == 8 { return true }
    if base == 16 { return true }
    if base == 48 { return true }
    return false
}

// 字宽 W：model 码 0=f/2=b/3=x 每字 32 trit（K32/D32 ≈ L48/32）；
//   model 1（r）每字 16 trit（Ktr/Dtr ≈ L48/TRIT16，TRIT16=16·log2 3）。
// K32/D32 = 0.17453007814753613，Ktr/Dtr = 0.22023243839286438（ceil 精确）。
func words_for(n: i64, model: i64) -> i64 {
    var w: i64 = 0
    if model == 1 {
        w = (n * 2202324383928644 + 9999999999999999) / 10000000000000000
    } else {
        w = (n * 1745300781475361 + 9999999999999999) / 10000000000000000
    }
    if w < 1 {
        return 1
    }
    return w
}

// b 字节信息量在 base 进制下所需符号数 m = ceil(8b/log2(base))。
func base_chars(b: i64, base: i64) -> i64 {
    if base == 2 {
        return b * 8
    }
    if base == 3 {
        return (b * 504744 + 99999) / 100000
    }
    if base == 8 {
        return (b * 8 + 2) / 3
    }
    if base == 16 {
        return b * 2
    }
    return (b * 1432407) / 1000000 + 1
}

// 字节数组（hex 串，大端）→ base 进制字符串（长除法，补零到恰好 m 个符号）。
func pad_radix(hex: string, base: i64, m: i64) -> string {
    var b = table_new_i64()
    var L: i64 = len(hex) / 2
    var i: i64 = 0
    while i < L {
        table_push(b, hex_byte(hex, i * 2))
        i = i + 1
    }
    var digs = table_new_i64()
    while true {
        var rem: i64 = 0
        var nq = table_new_i64()
        var allz = true
        var j: i64 = 0
        while j < len(b) {
            var cur = rem * 256 + b[j]
            var q = cur / base
            var r = cur % base
            if q != 0 {
                allz = false
            }
            table_push(nq, q)
            rem = r
            j = j + 1
        }
        table_push(digs, rem)
        b = nq
        if allz {
            break
        }
    }
    var chars = "0123456789abcdef"
    var out: string = ""
    var k = len(digs) - 1
    while k >= 0 {
        out = out + str_char(chars, digs[k])
        k = k - 1
    }
    while len(out) < m {
        out = "0" + out
    }
    return out
}

// ---- 常量惰性构建（SEED + SHA-256 计数器流，逐字 push；r 低 16 位在使用点掩码）----

func ensure_ivf() {
    if len(tsha_ivf) > 0 {
        return
    }
    var hs = "6f316818201ca2758e20cd45f4c7b538293d6b8de29e1c968f30cc67ad81cc6b" +
             "0be4be38d3b994622e2ec7d603ac7d3079ce6a3441df35400f4659174d5f2f552" +
             "6d77d9563cbfc8a547b09e5eb9ae1bc7ca9205c619064ba2cd8ab9e3a603f54" +
             "3f1f16a3a9044df1956d21362cdfd96d1d518e07e49def028ce433befcd7e551"
    var i: i64 = 0
    while i < 32 {
        table_push(tsha_ivf, parse_hex32(substr(hs, i * 8, i * 8 + 8)))
        i = i + 1
    }
}

func ensure_rcf() {
    if len(tsha_rcf) > 0 {
        return
    }
    var cs = "7b440874437636f66dac446ced74969b9efe93b52a73975f59917ee17503e6d7e" +
             "e9bfe4844bc2fe32327586f8c4dbff7c7a81e4d91daee663cab77ce54de351c"
    var i: i64 = 0
    while i < 16 {
        table_push(tsha_rcf, parse_hex32(substr(cs, i * 8, i * 8 + 8)))
        i = i + 1
    }
}

func ensure_ivr() {
    if len(tsha_ivr) > 0 {
        return
    }
    var hs = "05fa7659307581dc83ba961333590aecfb10c4287faf9c882f4b33d437988d4a" +
             "780d5e42f89896e62d94fcff6ccf33a66ae08d27c2af20b34c50506573b3e1c3" +
             "4cc528da0a4a9a1037e9b398fa6b45051737570416a8f1adc9ae1d77b4b64d27" +
             "6c3c0be78737ce891aaa050bf89ceb405dddc70a01ad70a8e964b9e4aaa9f629"
    var i: i64 = 0
    while i < 32 {
        table_push(tsha_ivr, parse_hex32(substr(hs, i * 8, i * 8 + 8)))
        i = i + 1
    }
}

func ensure_rcr() {
    if len(tsha_rcr) > 0 {
        return
    }
    var cs = "5cf19bb1fa18ead6bb44f898ddb232f0458cdb6b797aa9d23096ab26306a4a2a" +
             "037652e3d3875b1b3b8201f0063d32c45b5d631c05064ba23ef84c18a48a28b5"
    var i: i64 = 0
    while i < 16 {
        table_push(tsha_rcr, parse_hex32(substr(cs, i * 8, i * 8 + 8)))
        i = i + 1
    }
}

func ensure_ivb() {
    if len(tsha_ivb) > 0 {
        return
    }
    var hs = "9fd4f900e3e6f22dfa833118f4c0bfac90e157757b9ff4fc5dd185cb328c1a93" +
             "87a9c36264bff4e2f2b584aa1b6e8a70fbbe48294aab44a071707f42dade3bae" +
             "09ea6a475494ac2a1bfeec65c38f7d5616ff70697edd0711c5311735a36d4ef8" +
             "f19d73ee1679fdc44ce27ec5459f55def6e29638f7d7ae47b51e32814f7da5a5"
    var i: i64 = 0
    while i < 32 {
        table_push(tsha_ivb, parse_hex32(substr(hs, i * 8, i * 8 + 8)))
        i = i + 1
    }
}

func ensure_rcb() {
    if len(tsha_rcb) > 0 {
        return
    }
    var cs = "0bc0f6df83f2db4e78b9118707a07c7a150e7560747444f6c49f0cfa4fbb6440" +
             "f59abe41f418e5997d63da93ec8dc2906f27ced97ebabfbe5d320ccac8cb06a5"
    var i: i64 = 0
    while i < 16 {
        table_push(tsha_rcb, parse_hex32(substr(cs, i * 8, i * 8 + 8)))
        i = i + 1
    }
}

// tsha1b 海绵轨轮常量（16 字）。注：与 gen_tsha1_core.py 逐字一致——
//   该参考生成器的 gen_bcon 以「每轮重建流」方式取词，故 bcon 实际为 16 个相同字
//   （各等于 SEED_BS 流第 0 字 e79905e7），此处照实镜像。
func ensure_bcon() {
    if len(tsha_bcon) > 0 {
        return
    }
    var w = parse_hex32("e79905e7")
    var i: i64 = 0
    while i < 16 {
        table_push(tsha_bcon, w)
        i = i + 1
    }
}

func ensure_ivx() {
    if len(tsha_ivx) > 0 {
        return
    }
    var hs = "d34fedc1c5edd4e0be1a07f00ff130a4ed184e7073f63944802c2725e000be1b" +
             "538c1260d3b124748a9865f37080f89716606bd6af06efb3448f5ad1295aa23f" +
             "7a91d48bd0e14aa0ffbcab9cc01e6237b60d55d084117caa74e7a2faa4ef02d6" +
             "820c7bf88c27920b8abc850703ba3f0bf5e15ef63dacd23cfe18c7b2fb6553a7"
    var i: i64 = 0
    while i < 32 {
        table_push(tsha_ivx, parse_hex32(substr(hs, i * 8, i * 8 + 8)))
        i = i + 1
    }
}

func ensure_rcx() {
    if len(tsha_rcx) > 0 {
        return
    }
    var cs = "66f6c68fbadee5f89368fb9c0c66360c68aa1f0fd041d1200661fb8839ce3c45" +
             "2b38bd04f3a862cc3a691315dd6c9c2a1d6b428f86b0ecca0f902c9be129190c"
    var i: i64 = 0
    while i < 16 {
        table_push(tsha_rcx, parse_hex32(substr(cs, i * 8, i * 8 + 8)))
        i = i + 1
    }
}

// tsha1x 轨 D（LFSR）轮常量（16 字）。注：与 gen_tsha1_core.py 逐字一致——
//   gen_xdcon 同 gen_bcon 之「每轮重建流」取词，故 xdcon 实际为 16 个相同字
//   （各等于 SEED_XD 流第 0 字 c27f115d），此处照实镜像。
func ensure_xdcon() {
    if len(tsha_xdcon) > 0 {
        return
    }
    var w = parse_hex32("c27f115d")
    var i: i64 = 0
    while i < 16 {
        table_push(tsha_xdcon, w)
        i = i + 1
    }
}

// ---- 消息预处理：64 字节块 → 两组 (M,N) 平面 + 24 基调度键（单遍扫描）----
// 越界字节按 0 处理（等价纯零填充 ljust(64,0)）。
func block_planes_skey(msg: string, pos: i64, nbytes: i64) -> (m0: i64, n0: i64, m1: i64, n1: i64, skey: i64) {
    var tvs = table_new_i64()
    var i: i64 = 0
    while i < 64 {
        table_push(tvs, 0)
        i = i + 1
    }
    var M0v: i64 = 0
    var N0v: i64 = 0
    var M1v: i64 = 0
    var N1v: i64 = 0
    var skey: i64 = 0
    var j: i64 = 0
    while j < 64 {
        var b: i64 = 0
        if pos + j < nbytes {
            b = str_byte(msg, pos + j)
        }
        var bits3 = b & 7
        var tf = (b >> 6) & 3
        var t = tf - 1
        var tv: i64 = 0
        if t < 0 {
            tv = -1
        } else if t == 0 {
            tv = 0
        } else {
            tv = 1
        }
        var dig = bits3 * 3 + (tv + 1)
        skey = (skey * 24 + dig) & 0xFFFFFFFF
        if tv != 0 {
            var wv = j / 32
            var bit = j % 32
            if wv == 0 {
                M0v = M0v | (1 << bit)
                if tv < 0 {
                    N0v = N0v | (1 << bit)
                }
            } else {
                M1v = M1v | (1 << bit)
                if tv < 0 {
                    N1v = N1v | (1 << bit)
                }
            }
        }
        j = j + 1
    }
    return (M0v & 0xFFFFFFFF, N0v & 0xFFFFFFFF, M1v & 0xFFFFFFFF, N1v & 0xFFFFFFFF, skey)
}

// ---- 通用环式扩散（值语义唯一定义；idx 为连续区间 [start, start+L)）----
func ring_mix(lanes: ref table<i64>, start: i64, L: i64, r: i64, skey: i64,
              rcon: table<i64>, half: bool, inj: bool,
              M0: i64, N0: i64, M1: i64, N1: i64,
              mA: i64, mB: i64, rcon_idx: i64) {
    if L == 0 {
        return
    }
    var rA = (r * 3 + (skey & 7)) & 31
    var rB = (r * 7 + ((skey >> 3) & 7)) & 31
    var S = table_new_i64()
    var i: i64 = 0
    while i < 2 * L {
        table_push(S, 0)
        i = i + 1
    }
    var k: i64 = 0
    while k < L {
        var iw = start + k
        var j2 = start + ((k + 2) % L)
        var j3 = start + ((k + 3) % L)
        var a = (rA + 5 * k) & 31
        var b = (rB + 7 * k + 3) & 31
        var (sm, sn) = tadd2(lanes[2 * iw], lanes[2 * iw + 1],
                             rotlane(lanes[2 * j2], a, half), rotlane(lanes[2 * j2 + 1], a, half))
        var (sm2, sn2) = tadd2(sm, sn,
                               rotlane(lanes[2 * j3], b, half), rotlane(lanes[2 * j3 + 1], b, half))
        S[2 * k] = sm2
        S[2 * k + 1] = sn2
        k = k + 1
    }
    k = 0
    while k < L {
        var iw = start + k
        lanes[2 * iw] = S[2 * k] & 0xFFFFFFFF
        lanes[2 * iw + 1] = S[2 * k + 1] & 0xFFFFFFFF
        k = k + 1
    }
    k = 0
    while k < L {
        var k2 = (k + 2) % L
        var (pm, pn) = tmul2(S[2 * k], S[2 * k + 1], S[2 * k2], S[2 * k2 + 1])
        var i1 = start + ((k + 1) % L)
        lanes[2 * i1] = (lanes[2 * i1] ^ pm) & 0xFFFFFFFF
        lanes[2 * i1 + 1] = (lanes[2 * i1 + 1] ^ pn) & 0xFFFFFFFF
        k = k + 1
    }
    var maj: i64 = 0
    if L >= 3 {
        maj = quant3(S[0], S[1], S[2], S[3], S[4], S[5])
    } else if L == 2 {
        maj = quant3(S[0], S[1], S[2], S[3], S[0], S[1])
    } else {
        maj = quant3(S[0], S[1], S[0], S[1], S[0], S[1])
    }
    var il = start + (L - 1)
    lanes[2 * il] = (lanes[2 * il] ^ maj) & 0xFFFFFFFF
    lanes[2 * il + 1] = (lanes[2 * il + 1] ^ rotlane(maj, (rB + 7) & 31, half)) & 0xFFFFFFFF
    if inj {
        var i0 = start
        var (sm, sn) = tadd2(lanes[2 * i0], lanes[2 * i0 + 1],
                             rotlane(M0, mA, half), rotlane(N0, mA, half))
        lanes[2 * i0] = sm & 0xFFFFFFFF
        lanes[2 * i0 + 1] = sn & 0xFFFFFFFF
        if L >= 2 {
            var i1 = start + 1
            var (sm2, sn2) = tadd2(lanes[2 * i1], lanes[2 * i1 + 1],
                                   rotlane(M1, (mA + 7) & 31, half), rotlane(N1, (mA + 7) & 31, half))
            lanes[2 * i1] = sm2 & 0xFFFFFFFF
            lanes[2 * i1 + 1] = sn2 & 0xFFFFFFFF
        }
    }
    var i0b = start
    lanes[2 * i0b] = (lanes[2 * i0b] ^ rcon[rcon_idx & 15]) & 0xFFFFFFFF
    var ilb = start + (L - 1)
    lanes[2 * ilb + 1] = (lanes[2 * ilb + 1] ^
                          rotlane(rcon[(rcon_idx + 1) & 15], (r * 5) & 31, half)) & 0xFFFFFFFF
}

// 轨对耦合：tadd2 写回 a，再 tmul2 异或回 b。
func couple(lanes: ref table<i64>, a: i64, b: i64, half: bool) {
    var (sm, sn) = tadd2(lanes[2 * a], lanes[2 * a + 1], lanes[2 * b], lanes[2 * b + 1])
    lanes[2 * a] = sm & 0xFFFFFFFF
    lanes[2 * a + 1] = sn & 0xFFFFFFFF
    var (pm, pn) = tmul2(lanes[2 * a], lanes[2 * a + 1], lanes[2 * b], lanes[2 * b + 1])
    lanes[2 * b] = (lanes[2 * b] ^ pm) & 0xFFFFFFFF
    lanes[2 * b + 1] = (lanes[2 * b + 1] ^ pn) & 0xFFFFFFFF
}

// LFSR 轨混洗（x 模型轨 D；interval [td_start, td_start+L)）。
func lfsr_mix(lanes: ref table<i64>, td_start: i64, L: i64, r: i64,
              M0: i64, N0: i64, rcon: table<i64>, half: bool) {
    if L == 0 {
        return
    }
    var k: i64 = 0
    while k < L {
        var iw = td_start + k
        var jw = td_start + ((k + 1) % L)
        var s0 = (r * 3 + 5 * k) & 31
        var s1 = (r * 5 + 3 * k) & 31
        lanes[2 * iw] = (lanes[2 * iw] ^ rotlane(M0, s0, half)) & 0xFFFFFFFF
        lanes[2 * iw + 1] = (lanes[2 * iw + 1] ^ rotlane(N0, s1, half)) & 0xFFFFFFFF
        var fb = ((lanes[2 * iw] >> 16) ^ lanes[2 * iw + 1]) & 0xFFFFFFFF
        lanes[2 * jw] = (lanes[2 * jw] ^ fb) & 0xFFFFFFFF
        lanes[2 * jw + 1] = (lanes[2 * jw + 1] ^ fb) & 0xFFFFFFFF
        lanes[2 * jw] = (lanes[2 * jw] ^ rcon[(r + k) & 15]) & 0xFFFFFFFF
        lanes[2 * jw + 1] = (lanes[2 * jw + 1] ^
                             rotlane(rcon[(r + k + 8) & 15], (r + 2 * k) & 31, half)) & 0xFFFFFFFF
        k = k + 1
    }
}

// ---- 单块压缩（model: 0=f 1=r 2=b 3=x；half = (model==1)）----
func compress(model: i64, h: ref table<i64>, msg: string, pos: i64, nbytes: i64,
              t_lo: i64, t_hi: i64, last: bool,
              iv: table<i64>, rcon: table<i64>, bcon: table<i64>, xdcon: table<i64>, half: bool) {
    var W = len(h)
    var (M0, N0, M1, N1, skey) = block_planes_skey(msg, pos, nbytes)
    var lanes = table_new_i64()
    var i: i64 = 0
    while i < 2 * W {
        table_push(lanes, 0)
        i = i + 1
    }
    var mplan: i64 = 0xFFFFFFFF
    if half {
        mplan = 0xFFFF
    }
    i = 0
    while i < W {
        lanes[2 * i] = h[i] & 0xFFFFFFFF
        lanes[2 * i + 1] = rotlane(h[(i + W / 2) % W], 7, half)
        i = i + 1
    }
    i = 0
    while i < W {
        lanes[2 * i] = (lanes[2 * i] ^ (iv[i % 8] & mplan)) & 0xFFFFFFFF
        lanes[2 * i + 1] = (lanes[2 * i + 1] ^ (iv[(i + 4) % 8] & mplan)) & 0xFFFFFFFF
        i = i + 1
    }
    lanes[1] = (lanes[1] ^ (t_lo & mplan)) & 0xFFFFFFFF
    var hi = 2 * (W / 2) + 1
    lanes[hi] = (lanes[hi] ^ (t_hi & mplan)) & 0xFFFFFFFF
    if last {
        var lk = 2 * ((W / 2) % W) + 1
        lanes[lk] = (lanes[lk] ^ 0xFFFFFFFF) & 0xFFFFFFFF
    }
    // 轨分配（alloc_tracks 退化）：start/len/kind/rate（kind: 0=dual 1=ring 2=sponge 3=lfsr）
    var t_start = table_new_i64()
    var t_len = table_new_i64()
    var t_kind = table_new_i64()
    var t_rate = table_new_i64()
    var tcount: i64 = 0
    if W >= 16 {
        if model == 0 || model == 1 {
            var LA = (W + 1) / 2
            table_push(t_start, 0); table_push(t_len, LA); table_push(t_kind, 0); table_push(t_rate, 0)
            table_push(t_start, LA); table_push(t_len, W - LA); table_push(t_kind, 0); table_push(t_rate, 0)
            tcount = 2
        } else if model == 2 {
            var LA2 = (W + 2) / 3
            var LB2 = (W + 2) / 3
            var LC2 = W - LA2 - LB2
            while LC2 < 1 {
                LA2 = LA2 - 1
                LC2 = W - LA2 - LB2
            }
            var rate2 = (LC2 + 1) / 2
            table_push(t_start, 0); table_push(t_len, LA2); table_push(t_kind, 0); table_push(t_rate, 0)
            table_push(t_start, LA2); table_push(t_len, LB2); table_push(t_kind, 0); table_push(t_rate, 0)
            table_push(t_start, LA2 + LB2); table_push(t_len, LC2); table_push(t_kind, 2); table_push(t_rate, rate2)
            tcount = 3
        } else {
            var a = (2 * W + 6) / 7
            while 3 * a >= W {
                a = a - 1
            }
            if a < 1 {
                a = 1
            }
            var d = W - 3 * a
            while d < 1 {
                a = a - 1
                d = W - 3 * a
            }
            table_push(t_start, 0); table_push(t_len, a); table_push(t_kind, 0); table_push(t_rate, 0)
            table_push(t_start, a); table_push(t_len, a); table_push(t_kind, 0); table_push(t_rate, 0)
            table_push(t_start, 2 * a); table_push(t_len, a); table_push(t_kind, 2); table_push(t_rate, (a + 1) / 2)
            table_push(t_start, 3 * a); table_push(t_len, d); table_push(t_kind, 3); table_push(t_rate, 0)
            tcount = 4
        }
    } else if W >= 8 {
        var LA3 = (W + 1) / 2
        table_push(t_start, 0); table_push(t_len, LA3); table_push(t_kind, 0); table_push(t_rate, 0)
        table_push(t_start, LA3); table_push(t_len, W - LA3); table_push(t_kind, 0); table_push(t_rate, 0)
        tcount = 2
    } else {
        table_push(t_start, 0); table_push(t_len, W); table_push(t_kind, 1); table_push(t_rate, 0)
        tcount = 1
    }
    var R: i64 = 0
    if model == 0 {
        R = 12
    } else if model == 1 {
        R = 8
    } else if model == 2 {
        R = 14
    } else {
        R = 16
    }
    var r: i64 = 0
    while r < R {
        var mA = (r * 5 + ((skey >> 6) & 7)) & 31
        var mB = (r * 11 + ((skey >> 9) & 7)) & 31
        var mC = (r * 7 + ((skey >> 12) & 7)) & 31
        var mD = (r * 13 + ((skey >> 15) & 7)) & 31
        var dual_seen: i64 = 0
        var tt: i64 = 0
        while tt < tcount {
            var kind = t_kind[tt]
            if kind == 0 {
                var injmA: i64 = mA
                var injmB: i64 = mB
                var rc: i64 = r
                if dual_seen > 0 {
                    injmA = mC
                    injmB = mD
                    rc = (r + 8) & 15
                }
                ring_mix(lanes, t_start[tt], t_len[tt], r, skey, rcon, half,
                         true, M0, N0, M1, N1, injmA, injmB, rc)
                dual_seen = dual_seen + 1
            } else if kind == 1 {
                ring_mix(lanes, t_start[tt], t_len[tt], r, skey, rcon, half,
                         true, M0, N0, M1, N1, mA, mB, r)
            } else if kind == 2 {
                var rate = t_rate[tt]
                ring_mix(lanes, t_start[tt], rate, r, skey, bcon, half,
                         true, M0, N0, M1, N1, mA, mB, (r + 3) & 15)
                var c_len = t_len[tt] - rate
                if c_len > 0 {
                    ring_mix(lanes, t_start[tt] + rate, c_len, r, skey, bcon, half,
                             false, 0, 0, 0, 0, 0, 0, (r + 11) & 15)
                }
            } else {
                lfsr_mix(lanes, t_start[tt], t_len[tt], r, M0, N0, xdcon, half)
            }
            tt = tt + 1
        }
        // 轨间耦合（仅 b 三轨 / x 四轨 的 W≥16 形态）
        if model == 2 && tcount == 3 {
            var ta_s = 0
            var ta_l = t_len[0]
            var tb_s = t_start[1]
            var tb_l = t_len[1]
            var tc_s = t_start[2]
            var tc_l = t_len[2]
            var rate3 = t_rate[2]
            var cap0 = tc_s + rate3
            var cap1 = tc_s + rate3
            if tc_l > rate3 + 1 {
                cap1 = tc_s + rate3 + 1
            }
            var a1 = ta_s
            if ta_l > 1 {
                a1 = ta_s + 1
            }
            var b1 = tb_s
            if tb_l > 1 {
                b1 = tb_s + 1
            }
            couple(lanes, ta_s, tc_s, half)
            var tc1 = tc_s
            if tc_l > 1 {
                tc1 = tc_s + 1
            }
            couple(lanes, tb_s, tc1, half)
            couple(lanes, a1, cap0, half)
            couple(lanes, b1, cap1, half)
        }
        if model == 3 && tcount == 4 {
            var ta_s = 0
            var ta_l = t_len[0]
            var tb_s = t_start[1]
            var tb_l = t_len[1]
            var tc_s = t_start[2]
            var tc_l = t_len[2]
            var rate4 = t_rate[2]
            var cap0 = tc_s + rate4
            var cap1 = tc_s + rate4
            if tc_l > rate4 + 1 {
                cap1 = tc_s + rate4 + 1
            }
            var a1 = ta_s
            if ta_l > 1 {
                a1 = ta_s + 1
            }
            var b1 = tb_s
            if tb_l > 1 {
                b1 = tb_s + 1
            }
            var tc1 = tc_s
            if tc_l > 1 {
                tc1 = tc_s + 1
            }
            couple(lanes, ta_s, tc_s, half)
            couple(lanes, tb_s, tc1, half)
            couple(lanes, a1, cap0, half)
            couple(lanes, b1, cap1, half)
            var kd: i64 = 0
            while kd < t_len[3] {
                couple(lanes, kd % ta_l, t_start[3] + kd, half)
                kd = kd + 1
            }
        }
        r = r + 1
    }
    // 末块折回链值 h
    i = 0
    while i < W {
        h[i] = (h[i] ^ lanes[2 * i] ^ rotlane(lanes[2 * i + 1], (i * 3) & 31, half)) & 0xFFFFFFFF
        i = i + 1
    }
    fin_synth(h, half)
}

// 最后综合（终筛）：S=4 轮全 W 字单环收束（rcon=0 表，skey=0x13579BDF），随后投影。
func fin_synth(h: ref table<i64>, half: bool) {
    var W = len(h)
    if W == 1 {
        return
    }
    var lanes = table_new_i64()
    var i: i64 = 0
    while i < 2 * W {
        table_push(lanes, 0)
        i = i + 1
    }
    i = 0
    while i < W {
        lanes[2 * i] = h[i] & 0xFFFFFFFF
        lanes[2 * i + 1] = rotlane(h[(i + 1) % W], 7, half)
        i = i + 1
    }
    var zrc = table_new_i64()
    var z: i64 = 0
    while z < 16 {
        table_push(zrc, 0)
        z = z + 1
    }
    var sf: i64 = 0
    while sf < 4 {
        ring_mix(lanes, 0, W, sf, 0x13579BDF, zrc, half,
                 false, 0, 0, 0, 0, 0, 0, sf)
        sf = sf + 1
    }
    i = 0
    while i < W {
        h[i] = (lanes[2 * i] ^ rotlane(lanes[2 * i + 1], (i * 5) & 31, half)) & 0xFFFFFFFF
        i = i + 1
    }
}

// ---- 摘要驱动 + 输出编码（无 XOF；状态全宽 → 池 hex；不足拒绝）----
// model: 0=f 1=r 2=b 3=x。返回状态全宽 hex（W 字 × 8 hex = 8W 字符）。
func digest(model: i64, msg: string, nbytes: i64, n: i64) -> string {
    if !is_bits48(n) {
        return ""
    }
    var W = words_for(n, model)
    var iv: table<i64> = table_new_i64()
    var rcon: table<i64> = table_new_i64()
    if model == 0 {
        ensure_ivf(); ensure_rcf()
        iv = tsha_ivf; rcon = tsha_rcf
    } else if model == 1 {
        ensure_ivr(); ensure_rcr()
        iv = tsha_ivr; rcon = tsha_rcr
    } else if model == 2 {
        ensure_ivb(); ensure_rcb(); ensure_bcon()
        iv = tsha_ivb; rcon = tsha_rcb
    } else {
        ensure_ivx(); ensure_rcx(); ensure_bcon(); ensure_xdcon()
        iv = tsha_ivx; rcon = tsha_rcx
    }
    var half = model == 1
    var mplan: i64 = 0xFFFFFFFF
    if half {
        mplan = 0xFFFF
    }
    var h = table_new_i64()
    var i: i64 = 0
    while i < W {
        table_push(h, iv[i] & mplan)
        i = i + 1
    }
    h[0] = (h[0] ^ 0x01010000 ^ 32) & 0xFFFFFFFF
    var bcon: table<i64> = table_new_i64()
    var xdcon: table<i64> = table_new_i64()
    if model == 2 || model == 3 {
        bcon = tsha_bcon
    }
    if model == 3 {
        xdcon = tsha_xdcon
    }
    var t_lo: i64 = 0
    var t_hi: i64 = 0
    var pos: i64 = 0
    while pos + 64 < nbytes {
        t_hi = (t_hi + ((t_lo + 64) >> 32)) & 0xFFFFFFFF
        t_lo = (t_lo + 64) & 0xFFFFFFFF
        compress(model, h, msg, pos, nbytes, t_lo, t_hi, false, iv, rcon, bcon, xdcon, half)
        pos = pos + 64
    }
    var rem = nbytes - pos
    t_hi = (t_hi + ((t_lo + rem) >> 32)) & 0xFFFFFFFF
    t_lo = (t_lo + rem) & 0xFFFFFFFF
    compress(model, h, msg, pos, nbytes, t_lo, t_hi, true, iv, rcon, bcon, xdcon, half)
    var out: string = ""
    i = 0
    while i < W {
        out = out + hex8(h[i])
        i = i + 1
    }
    return out
}

// ---- 对外输出层（encode）：base48 截断池前 n 符号；其它进制 b0 字节取池前缀重编码----

// 最小 base48（与 gen_tsha1_core.py 的 b48_encode 逐字一致：无定长左补零）。
// 说明：std/base48.encode 为「定长」左补零编码，而参考核心输出为「最小表示」——
//   定长会在值不足以填满 m 符号时多打前导 '0'，与参考不符，故此处实现最小版。
//   字符台同 base48（0..9,a..z,A..L，索引即值）。
func b48_min(hx: string) -> string {
    if len(hx) == 0 {
        return ""
    }
    var b = table_new_i64()
    var i: i64 = 0
    var L: i64 = len(hx) / 2
    while i < L {
        table_push(b, hex_byte(hx, i * 2))
        i = i + 1
    }
    var digits = table_new_i64()
    var pos: i64 = 0
    while pos < L {
        var rem: i64 = 0
        i = 0
        while i < L {
            var cur = rem * 256 + b[i]
            b[i] = cur / 48
            rem = cur % 48
            i = i + 1
        }
        while pos < L && b[pos] == 0 {
            pos = pos + 1
        }
        table_push(digits, rem)
    }
    var chars = "0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKL"
    var out: string = ""
    i = len(digits) - 1
    while i >= 0 {
        out = out + str_char(chars, digits[i])
        i = i - 1
    }
    if out == "" {
        return "0"
    }
    return out
}

func encode(model: i64, msg: string, n: i64, base: i64) -> string {
    if !is_bits48(n) {
        return ""
    }
    if !is_base_ok(base) {
        return ""
    }
    var nbytes: i64 = len(msg)
    var hexstr = digest(model, msg, nbytes, n)
    if hexstr == "" {
        return ""
    }
    if base == 48 {
        var full = b48_min(hexstr)
        return substr(full, 0, n)
    }
    var b0 = (n * 698121) / 1000000
    var pool = hexstr
    if len(pool) / 2 < b0 {
        return ""
    }
    var bb48 = substr(pool, 0, b0 * 2)
    if base == 16 {
        return bb48
    }
    var m = base_chars(b0, base)
    return pad_radix(bb48, base, m)
}

// ---- 公开 API ----

pub func tsha1f(msg: string, n: i64, base: i64 = 48) -> string {
    return encode(0, msg, n, base)
}

pub func tsha1b(msg: string, n: i64, base: i64 = 48) -> string {
    return encode(2, msg, n, base)
}

pub func tsha1x(msg: string, n: i64, base: i64 = 48) -> string {
    return encode(3, msg, n, base)
}

pub func tsha1r(msg: string, n: i64, base: i64 = 48) -> string {
    return encode(1, msg, n, base)
}

// 内部诊断辅助（探针/烟雾用）：返回 (model,msg,n) 状态全宽 hex（== digest 输出），
// 不属公开文档接口，仅便于与 gen_tsha1_core.py 的 digest() 逐字比对。
pub func tsha1_digest(model_id: string, msg: string, n: i64) -> string {
    var model: i64 = 0
    if model_id == "r" {
        model = 1
    } else if model_id == "b" {
        model = 2
    } else if model_id == "x" {
        model = 3
    }
    return digest(model, msg, len(msg), n)
}

}   // namespace tsha