type tie<class>
// ============================================================================
// tsha1.tie：标准库——TSHA1 哈希族（tie 自有安全哈希，命名空间 tsha）
// 用途：tie 平台自有通用安全哈希底座（插件审计链 / 完整性校验 / 指纹）。
// 来源：docs/superpowers/specs/2026-08-29-plugin-kernel-design.md §6.6
// 接口（本期实现 f/r/b 三档，x 留待后续）：
//   tsha.tsha1f(msg: string) -> string    tsha1f-256（快速，B 骨架）→ 默认 46 字符 base48
//   tsha.tsha1f_hex(msg) -> string        tsha1f-256 → 64 位十六进制（可选，旧 hex 保留）
//   tsha.tsha1r(msg: string) -> string    tsha1r-128（嵌入式，轻量 SPN）→ 默认 23 字符 base48
//   tsha.tsha1r_hex(msg) -> string        tsha1r-128 → 32 位十六进制（可选，旧 hex 保留）
//   tsha.tsha1b(msg: string) -> string    tsha1b-256（复杂，A 骨架双轨+SPN）→ 46 字符 base48
//   tsha.tsha1b_hex(msg) -> string        tsha1b-256 → 64 位十六进制（可选，旧 hex 保留）
// 默认输出为 base48 连续字符集编码（std/base48.tie，命名空间 b48）：短、可手抄，
//   适合指纹/审计链 ID 人类可抄读。_hex 后缀保留原有 hex 行为（回归兼容）。
//   内部哈希字节不变（f=256 位=32 字节→46 字符 base48；r=128 位=16 字节→23 字符），
//   仅在输出层切换编码：decode(tsha1f_hex(msg) 的 b48) == tsha1f_hex(msg) 字节一致。
// 逐**字节**处理（str_byte + len），任意 UTF-8 原始字节可哈希。
//
// == 结构（快速档 tsha1f-256）==
//   tsha1f = BLAKE-ARX 主体（G 函数与 BLAKE2s 同构，可交叉验证）
//          + T 轨旁路扰动（消息先经 trit 置换/扰动，打包成位平面后再入 ARX 轮）
//          + 24 基混合调度（每字节 3 位×3 + 1 trit = 0..23 数字参与轮调度）。
//   - 消息填充为纯零（无 0x80/无长度位），长度由计数器 t（64 位半分）承载；
//   - 12 轮（σ 置换 + rd 轮调制，rd 由 24 基 skey 派生）；
//   - 摘要按每字大端字节序（hex8）输出，共 8 字 = 64 hex。
//
// == trit 位平面表示（层内标准，必选设计）==
//   每个 u64 装 32 个 trit：高 32 位为幅值位平面 M、低 32 位为符号位平面 N
//   （等价 (M<<32)|N）。tie 以两个恒 <2^32 的 i64 半字 (M,N) 表示：
//     - M 的位 i = 1 ⇔ 第 i 个 trit 非零（幅值）；
//     - N 的位 i = 1 ⇔ 第 i 个 trit 为负（符号，即 -1）。
//   trit 值 tv ∈ {-1,0,+1} 经 `trit_val(to_trit(tf-1))` 获得
//   （tf = 字节高 2 位 → to_trit 饱和：0→-1、1→0、2/3→+1）。
//   打包/混合运算全部走 &/^/|/<<（无逐 trit 模 3 慢点）。
//
// == 常量定制（可复现，非 BLAKE2 IV）==
//   采用"标准种子 + PRNG 扩展固化"：扩展 = SHA-256(SEED || u64be(k)) 计数器流
//   （k=0,1,2,...），依序取字节填充常量。SEED_F = "TSHA1-2026-f-256-v1"（IV 8 字
//   + σ 置换 10×16）；SEED_R = "TSHA1-2026-r-128-v1"（IV 8 字 + S 盒 16 + 轮常量 16）。
//   与 BLAKE2 IV（6a09e667...）有意区分（不经异或参数块继承，常数由种子扩展
//   独立生成）。复现：tests/tsha_probe/gen_vectors.py。
//
// == 验证（已知答案向量，已核对生成器）==
//   tsha1f("")    = 049a7e459a4558bced881efef7b15a0f29a306bd95cd898645df15d9895fcd9e
//   tsha1f("abc") = 2c3fe6f973eb8ea150c24d8c5a20ea38f0a4d5590c58b868806dacd32eda3cd4
//   tsha1f(1000xa) = 9f74677d24005bc307237035d0ebacad5ca178b8378938f7b40c7976f1611336
//   tsha1r("")    = 1d41e39ece695096448cf4947429d6cd
//   tsha1r("abc") = 2539601d2671289458b7c0683324edd6
//   探针：tests/tsha_probe/tsha1f_probe.tie 与 tsha1r_probe.tie（多向量 + 块边界）。
// 备注：命名空间内互调为裸调用，内部函数不加 tsha_ 前缀（同 sha/blake）。
// ============================================================================

import "./base48.tie"
using b48;

var tsha_fiv: table<i64>;     // tsha1f IV（8 个 32 位字）
var tsha_fsig: table<i64>;    // tsha1f σ 置换（10 行×16 = 160 项）
var tsha_riv: table<i64>;     // tsha1r IV（8 个 32 位字）
var tsha_rsbox: table<i64>;   // tsha1r nibble S 盒（16 项，双射）
var tsha_rrcon: table<i64>;   // tsha1r 轮常量（16 个 32 位字）
var tsha_biv: table<i64>;     // tsha1b IV（8 个 32 位字）
var tsha_bsig: table<i64>;    // tsha1b σ 置换（10 行×16 = 160 项）
var tsha_bsbox: table<i64>;   // tsha1b nibble S 盒（16 项，SPN 强化层，双射）
var tsha_brcon: table<i64>;   // tsha1b 轮常量（16 个 32 位字，SPN 强化层）

namespace tsha {

// ---- 通用小工具（与 sha/blake 同风格，不依赖 string.tie）----

func substr(s: string, a_p: i64, b_p: i64) -> string {
    var out: string = ""
    var i: i64 = a_p
    while i < b_p {
        out = out + str_char(s, i)
        i = i + 1
    }
    return out
}

func hex_nibble(c: string) -> i64 {
    var digits = "0123456789abcdef"
    var i: i64 = 0
    while i < 16 {
        if str_char(digits, i) == c {
            return i
        }
        i = i + 1
    }
    return 0
}

func parse_hex32(s: string) -> i64 {
    var v: i64 = 0
    var i: i64 = 0
    while i < 8 {
        v = ((v << 4) | hex_nibble(str_char(s, i))) & 0xFFFFFFFF
        i = i + 1
    }
    return v
}

// 32 位循环右移 n 位（v < 2^32 正数，>> 即逻辑右移——数值安全注释同 sha256）。
func rr32(v: i64, n: i64) -> i64 {
    return ((v >> n) | (v << (32 - n))) & 0xFFFFFFFF
}

// 32 位循环左移 n 位。
func rl32(v: i64, n: i64) -> i64 {
    return ((v << (n & 31)) | (v >> (32 - (n & 31)))) & 0xFFFFFFFF
}

// 32 位值 → 8 位小写 hex（大端字节序，同 sha256 的 hex8）。
func hex8(v: i64) -> string {
    var hex = "0123456789abcdef"
    var out: string = ""
    var p: i64 = 0
    while p < 8 {
        var shift = 28 - p * 4
        var nib = (v >> shift) & 0xF
        out = out + str_char(hex, nib)
        p = p + 1
    }
    return out
}

// 消息块第 k 个 32 位小端字（4 字节，越界补 0）——零填充式读取。
func le_word(msg: string, n: i64, off: i64, k: i64) -> i64 {
    var v: i64 = 0
    var j: i64 = 0
    while j < 4 {
        var g2 = off + k * 4 + j
        var b: i64 = 0
        if g2 < n {
            b = str_byte(msg, g2)
        }
        v = (v | (b << (8 * j))) & 0xFFFFFFFF
        j = j + 1
    }
    return v
}

// 32 位加法进位（0 或 1）：a,b 均 <2^32。
func carry32(a: i64, b: i64) -> i64 {
    return (a + b) >> 32
}

// ---- trit 层：字节 → 24 基数字 + 位平面打包 ----

// 单字节 bits3 = 低 3 位（0..7）。24 基调度数字 = bits3*3 + (tv+1) ∈ 0..23。
func byte_bits3(b: i64) -> i64 {
    return b & 7
}
// 单字节 trit 值（-1/0/1）：tf = 高 2 位，to_trit 饱和：0→-1、1→0、2/3→+1。
func byte_tv(b: i64) -> i64 {
    var tf = (b >> 6) & 3
    return trit_val(to_trit(tf - 1))
}

// 把 [off+start .. off+start+count) 共 count 个字节的 trit 打包成长平面 (M, N)：
//   M（幅值）位 i = 第 i 个 trit 非零；N（符号）位 i = 第 i 个 trit 为负。
// 64 字节 → 64 trit → 包 0（trit0..31）与 包 1（trit32..63）。
func pack_planes(msg: string, n: i64, off: i64, start: i64, count: i64) -> (mp: i64, np: i64) {
    var m: i64 = 0
    var npw: i64 = 0
    var i: i64 = 0
    while i < count {
        var j = start + i
        var b: i64 = 0
        if off + j < n {
            b = str_byte(msg, off + j)
        }
        var tv = byte_tv(b)
        if tv != 0 {
            m = m | (1 << i)
            if tv < 0 {
                npw = npw | (1 << i)
            }
        }
        i = i + 1
    }
    return (m, npw)
}

// 64 字节块 → (M0,N0),(M1,N1) 两组位平面（每组 32 trit）。
func block_planes(msg: string, n: i64, off: i64) -> (m0: i64, n0: i64, m1: i64, n1: i64) {
    var (m0, n0) = pack_planes(msg, n, off, 0, 32)
    var (m1, n1) = pack_planes(msg, n, off, 32, 32)
    return (m0, n0, m1, n1)
}

// 24 基调度键 skey：逐字节 skey = (skey*24 + digit) & 0xFFFFFFFF（digit = 3 位×3+1 trit）。
func block_skey(msg: string, n: i64, off: i64) -> i64 {
    var skey: i64 = 0
    var j: i64 = 0
    while j < 64 {
        var b: i64 = 0
        if off + j < n {
            b = str_byte(msg, off + j)
        }
        var bits3 = byte_bits3(b)
        var tv = byte_tv(b)
        var dig = bits3 * 3 + (tv + 1)
        skey = (skey * 24 + dig) & 0xFFFFFFFF
        j = j + 1
    }
    return skey
}

// 惰性构建 tsha1f 常量（seed 扩展，见头部）。
func ensure_fiv() {
    if len(tsha_fiv) > 0 {
        return
    }
    var hs = "6f316818201ca2758e20cd45f4c7b538293d6b8de29e1c968f30cc67ad81cc6b"
    var i: i64 = 0
    while i < 8 {
        table_push(tsha_fiv, parse_hex32(substr(hs, i * 8, i * 8 + 8)))
        i = i + 1
    }
}

func ensure_fsig() {
    if len(tsha_fsig) > 0 {
        return
    }
    var rs = "025ef1c6ad97483b76c95bef83d42a10d2c13084b9657eafbd35489ec2f1760a" +
             "0fbcd5481293e76a5032fc48ab719de668c29bed5f4170a3d4bf2106957e3a8c" +
             "e7cb52168d3f40a9c461e0d9278fab53"
    var i: i64 = 0
    while i < 160 {
        table_push(tsha_fsig, hex_nibble(str_char(rs, i)))
        i = i + 1
    }
}

// ---- tsha1f-256（B 骨架）----

// ARX G 函数（与 BLAKE2s 完全同构，可交叉验证）。
func g_f(v: ref table<i64>, a: i64, b: i64, c: i64, d: i64, x: i64, y: i64) {
    var va = v[a]; var vb = v[b]; var vc = v[c]; var vd = v[d]
    va = (va + vb + x) & 0xFFFFFFFF
    vd = rr32(vd ^ va, 16)
    vc = (vc + vd) & 0xFFFFFFFF
    vb = rr32(vb ^ vc, 12)
    va = (va + vb + y) & 0xFFFFFFFF
    vd = rr32(vd ^ va, 8)
    vc = (vc + vd) & 0xFFFFFFFF
    vb = rr32(vb ^ vc, 7)
    v[a] = va; v[b] = vb; v[c] = vc; v[d] = vd
}

// 单 64 字节块压缩；t 为 64 位计数器（t_lo/t_hi）。
func compress_f(h: ref table<i64>, msg: string, n: i64, off: i64, t_lo: i64, t_hi: i64, last: bool) {
    // 16 个消息字（小端）
    var m = table_new_i64()
    var k: i64 = 0
    while k < 16 {
        table_push(m, le_word(msg, n, off, k))
        k = k + 1
    }
    // trit 位平面（T 轨旁路）与 24 基调度键
    var (M0, N0, M1, N1) = block_planes(msg, n, off)
    var skey = block_skey(msg, n, off)
    // 工作状态 v = h || IV
    var v = table_new_i64()
    var i: i64 = 0
    while i < 8 {
        table_push(v, h[i])
        i = i + 1
    }
    i = 0
    while i < 8 {
        table_push(v, tsha_fiv[i])
        i = i + 1
    }
    v[12] = v[12] ^ t_lo
    v[13] = v[13] ^ t_hi
    if last {
        v[14] = v[14] ^ 0xFFFFFFFF
    }
    var r: i64 = 0
    while r < 12 {
        var sr = r
        if sr >= 10 {
            sr = sr - 10
        }
        var base = sr * 16
        var rd = (skey + r * 7) & 15
        g_f(v, 0, 4, 8, 12, m[(tsha_fsig[base + 0] + rd) & 15], m[(tsha_fsig[base + 1] + rd) & 15])
        g_f(v, 1, 5, 9, 13, m[(tsha_fsig[base + 2] + rd) & 15], m[(tsha_fsig[base + 3] + rd) & 15])
        g_f(v, 2, 6, 10, 14, m[(tsha_fsig[base + 4] + rd) & 15], m[(tsha_fsig[base + 5] + rd) & 15])
        g_f(v, 3, 7, 11, 15, m[(tsha_fsig[base + 6] + rd) & 15], m[(tsha_fsig[base + 7] + rd) & 15])
        g_f(v, 0, 5, 10, 15, m[(tsha_fsig[base + 8] + rd) & 15], m[(tsha_fsig[base + 9] + rd) & 15])
        g_f(v, 1, 6, 11, 12, m[(tsha_fsig[base + 10] + rd) & 15], m[(tsha_fsig[base + 11] + rd) & 15])
        g_f(v, 2, 7, 8, 13, m[(tsha_fsig[base + 12] + rd) & 15], m[(tsha_fsig[base + 13] + rd) & 15])
        g_f(v, 3, 4, 9, 14, m[(tsha_fsig[base + 14] + rd) & 15], m[(tsha_fsig[base + 15] + rd) & 15])
        // T 轨旁路扰动：幅值/符号两组位平面分别旋转后 XOR 进 ARX 状态
        v[2] = v[2] ^ rl32(M0, (r * 3) & 31)
        v[6] = v[6] ^ rl32(N0, (r * 5) & 31)
        v[10] = v[10] ^ rl32(M1, (r * 7) & 31)
        v[14] = v[14] ^ rl32(N1, (r * 11) & 31)
        r = r + 1
    }
    i = 0
    while i < 8 {
        h[i] = h[i] ^ v[i] ^ v[i + 8]
        i = i + 1
    }
}

// tsha1f-256 内部哈希：计数器式（纯零填充），12 轮，输出 8 字大端 hex = 64 hex。
// （算法主体与旧 tsha1f 完全一致，仅把外部编码拆到 _hex/b48 封装，内部字节不变。）
func digest_f(msg: string) -> string {
    ensure_fiv()
    ensure_fsig()
    var n: i64 = len(msg)
    var h = table_new_i64()
    var i: i64 = 0
    while i < 8 {
        table_push(h, tsha_fiv[i])
        i = i + 1
    }
    h[0] = h[0] ^ 0x01010000 ^ 32
    var t_lo: i64 = 0
    var t_hi: i64 = 0
    var pos: i64 = 0
    while pos + 64 < n {
        t_hi = (t_hi + carry32(t_lo, 64)) & 0xFFFFFFFF
        t_lo = (t_lo + 64) & 0xFFFFFFFF
        compress_f(h, msg, n, pos, t_lo, t_hi, false)
        pos = pos + 64
    }
    var rem = n - pos
    t_hi = (t_hi + carry32(t_lo, rem)) & 0xFFFFFFFF
    t_lo = (t_lo + rem) & 0xFFFFFFFF
    compress_f(h, msg, n, pos, t_lo, t_hi, true)
    var out: string = ""
    i = 0
    while i < 8 {
        out = out + hex8(h[i])
        i = i + 1
    }
    return out
}

// tsha1f-256：默认输出 46 字符 base48（无歧义，见 std/base48.tie）。
pub func tsha1f(msg: string) -> string {
    return b48.encode(digest_f(msg))
}

// tsha1f-256：64 位十六进制（旧 hex 行为，回归兼容保留）。
pub func tsha1f_hex(msg: string) -> string {
    return digest_f(msg)
}

// ---- tsha1r-128（嵌入式，轻量 SPN Ascon 型）----

// 惰性构建 tsha1r 常量（seed 扩展，见头部）。
func ensure_riv() {
    if len(tsha_riv) > 0 {
        return
    }
    var hs = "05fa7659307581dc83ba961333590aecfb10c4287faf9c882f4b33d437988d4a"
    var i: i64 = 0
    while i < 8 {
        table_push(tsha_riv, parse_hex32(substr(hs, i * 8, i * 8 + 8)))
        i = i + 1
    }
}

func ensure_rsbox() {
    if len(tsha_rsbox) > 0 {
        return
    }
    var ss = "26347ecb509f1ad8"
    var i: i64 = 0
    while i < 16 {
        table_push(tsha_rsbox, hex_nibble(str_char(ss, i)))
        i = i + 1
    }
}

func ensure_rrcon() {
    if len(tsha_rrcon) > 0 {
        return
    }
    var cs = "a66ae08d27c2af20b34c50506573b3e1c34cc528da0a4a9a1037e9b398fa6b45051737570416a8f1adc9ae1d77b4b64d276c3c0be78737ce891aaa050bf89ceb"
    var i: i64 = 0
    while i < 16 {
        table_push(tsha_rrcon, parse_hex32(substr(cs, i * 8, i * 8 + 8)))
        i = i + 1
    }
}

// 一轮置换（256 位内态 s[0..7]）：nibble S 盒 -> 旋-异或线性扩散 -> 轮常量 -> trit 扰动。
func r_perm(s: ref table<i64>, r: i64, Mpn: i64, npn: i64) {
    // S 盒层：每字 8 个 nibble 独立替换
    var w2: i64 = 0
    while w2 < 8 {
        var x = s[w2]
        var nx: i64 = 0
        var nb: i64 = 0
        while nb < 8 {
            var idx = (x >> (4 * nb)) & 0xF
            nx = nx | (tsha_rsbox[idx] << (4 * nb))
            nb = nb + 1
        }
        s[w2] = nx & 0xFFFFFFFF
        w2 = w2 + 1
    }
    // 旋-异或线性扩散（顺序更新，须与参考实现一致）
    s[0] = s[0] ^ rr32(s[0], 7) ^ rr32(s[1], 19)
    s[1] = s[1] ^ rr32(s[1], 11) ^ rr32(s[2], 23)
    s[2] = s[2] ^ rr32(s[2], 13) ^ rr32(s[3], 29)
    s[3] = s[3] ^ rr32(s[3], 17) ^ rr32(s[1], 31)
    s[4] = s[4] ^ rr32(s[4], 5) ^ rr32(s[5], 21)
    s[5] = s[5] ^ rr32(s[5], 3) ^ rr32(s[6], 27)
    s[6] = s[6] ^ rr32(s[6], 9) ^ rr32(s[7], 15)
    s[7] = s[7] ^ rr32(s[7], 25) ^ rr32(s[5], 7)
    s[0] = s[0] ^ s[4]
    s[1] = s[1] ^ s[5]
    s[2] = s[2] ^ s[6]
    s[3] = s[3] ^ s[7]
    s[4] = s[4] ^ s[0]
    s[5] = s[5] ^ s[1]
    s[6] = s[6] ^ s[2]
    s[7] = s[7] ^ s[3]
    s[0] = s[0] ^ ((tsha_rrcon[r & 15] + r) & 0xFFFFFFFF)
    s[2] = s[2] ^ Mpn                              // trit 幅值位平面
    s[3] = s[3] ^ (npn & 0xFFFFFFFF)                // trit 符号位平面
}

// tsha1r-128 内部哈希：128 位速率吸收 + 长度绑定 + 终筛轮，状态压缩到 128 位
// 输出 32 hex（算法主体与旧 tsha1r 完全一致，仅拆输出层编码到 _hex/b48 封装）。
func digest_r(msg: string) -> string {
    ensure_riv()
    ensure_rsbox()
    ensure_rrcon()
    var n: i64 = len(msg)
    var s = table_new_i64()
    var i: i64 = 0
    while i < 8 {
        table_push(s, tsha_riv[i])
        i = i + 1
    }
    var pos: i64 = 0
    while pos + 16 <= n {
        var k: i64 = 0
        while k < 4 {
            s[k] = s[k] ^ le_word(msg, n, pos, k)
            k = k + 1
        }
        var (Mpn, npn) = pack_planes(msg, n, pos, 0, 16)
        var r2: i64 = 0
        while r2 < 6 {
            r_perm(s, r2, Mpn, npn)
            r2 = r2 + 1
        }
        pos = pos + 16
    }
    // 末块（零填充到 16 字节）+ 长度绑定
    var k2: i64 = 0
    while k2 < 4 {
        s[k2] = s[k2] ^ le_word(msg, n, pos, k2)
        k2 = k2 + 1
    }
    s[7] = s[7] ^ (n & 0xFFFFFFFF)
    // 末块 trit 位平面（零填充后计算）-> 终筛轮带上扰动，短消息亦激活 trit 层
    var (Mf, Nf) = pack_planes(msg, n, pos, 0, 16)
    var rf: i64 = 0
    while rf < 8 {
        r_perm(s, rf, Mf, Nf)
        rf = rf + 1
    }
    var out: string = ""
    var ow: i64 = 0
    while ow < 4 {
        out = out + hex8((s[ow] ^ s[ow + 4]) & 0xFFFFFFFF)   // 状态压缩 256->128
        ow = ow + 1
    }
    return out
}

// tsha1r-128：默认输出 23 字符 base48（无歧义，见 std/base48.tie）。
pub func tsha1r(msg: string) -> string {
    return b48.encode(digest_r(msg))
}

// tsha1r-128：32 位十六进制（旧 hex 行为，回归兼容保留）。
pub func tsha1r_hex(msg: string) -> string {
    return digest_r(msg)
}

// ---- tsha1b-256（复杂档，A 骨架双轨并行 + SPN 强化）----
// 设计（docs/superpowers/specs/2026-08-29-plugin-kernel-design.md §6.6）：
//   与 tsha1f 差异：A 骨架双轨并行——B 轨 = tsha1f 同构 ARX G 网络（g_f + σ 调度）；
//   T 轨 = trit 位平面扩散（见下文 tadd2/quant3，全走 &/^/|/<<）；每轮互转（B→T 分段
//   展开入 T 轨、T→B majority 量化回 B 轨）；每 3 轮插一层 SPN 强化（Ascon 型 nibble
//   S 盒 + 旋-异或线性扩散 + 轮常量）。B 轨轮数 14 ≥ tsha1f(12)，保守强化。
//   常量来源：SEED_B = "TSHA1-2026-b-256-v1"（标准种子 + PRNG 扩展，与 f/r 有意区分），
//   复现：tests/tsha_probe/gen_tsha1bx.py。输出 256 位（32 字节 → b48 46 字符）。
//   验证向量（与 f 档向量完全独立）：见下方 pub 注释与 tests/tsha_probe/tsha1b_probe.tie。

// 惰性构建 tsha1b 常量（seed 扩展）。
func ensure_biv() {
    if len(tsha_biv) > 0 {
        return
    }
    var hs = "9fd4f900e3e6f22dfa833118f4c0bfac90e157757b9ff4fc5dd185cb328c1a93"
    var i: i64 = 0
    while i < 8 {
        table_push(tsha_biv, parse_hex32(substr(hs, i * 8, i * 8 + 8)))
        i = i + 1
    }
}

func ensure_bsig() {
    if len(tsha_bsig) > 0 {
        return
    }
    var rs = "89c350621abefd476c3a249fe1d578b0f12673c8d45a0e9b6b41a78c0ed3925f7" +
             "ad09b26e5fc18438c13ad20eb467f95b4acf576310d8e92b8dc1056ae347f2928d" +
             "b6fe51a073c948274fb60cde3a159"
    var i: i64 = 0
    while i < 160 {
        table_push(tsha_bsig, hex_nibble(str_char(rs, i)))
        i = i + 1
    }
}

func ensure_bsbox() {
    if len(tsha_bsbox) > 0 {
        return
    }
    var ss = "23781de65c40b9af"
    var i: i64 = 0
    while i < 16 {
        table_push(tsha_bsbox, hex_nibble(str_char(ss, i)))
        i = i + 1
    }
}

func ensure_brcon() {
    if len(tsha_brcon) > 0 {
        return
    }
    var cs = "18282397bcb31a43f345bffda404df534475e66860444dddc44d027c9c3bf9e63" +
             "d0cd58baa13094f43ee8c198b634412f7bdba10d1b9c7b0d234ad4d3fd145f4"
    var i: i64 = 0
    while i < 16 {
        table_push(tsha_brcon, parse_hex32(substr(cs, i * 8, i * 8 + 8)))
        i = i + 1
    }
}

// 平衡三进制（balanced mod 3）两位 trit 相加，位切片实现（无进位，作扩散混合）。
// 入参/出参均为位平面 (M 幅值, N 符号)，运算全走 &/^/|/<<（~ 用 xor 掩码替代，保 i64 正）。
func tadd2(Ma: i64, Na: i64, Mb: i64, Nb: i64) -> (mo: i64, no: i64) {
    var nMa = Ma ^ 0xFFFFFFFF
    var nNa = Na ^ 0xFFFFFFFF
    var nMb = Mb ^ 0xFFFFFFFF
    var nNb = Nb ^ 0xFFFFFFFF
    var aP = Ma & nNa
    var aN = Ma & Na
    var bP = Mb & nNb
    var bN = Mb & Nb
    var o_pos = ((nMa & Mb & nNb) | (Ma & nNa & nMb) | (aN & bN)) & 0xFFFFFFFF
    var o_neg = ((nMa & Mb & Nb) | (Ma & Na & nMb) | (aP & bP)) & 0xFFFFFFFF
    return (o_pos | o_neg, o_neg)
}

// majority 量化：三组位平面逐 trit 取签，+1 计数 ≥2 则该位为 1，否则 0（含平局→0）。
func quant3(m0: i64, n0: i64, m1: i64, n1: i64, m2: i64, n2: i64) -> i64 {
    var A = m0 & (n0 ^ 0xFFFFFFFF)
    var B = m1 & (n1 ^ 0xFFFFFFFF)
    var C = m2 & (n2 ^ 0xFFFFFFFF)
    return ((A & B) | (B & C) | (C & A)) & 0xFFFFFFFF
}

// SPN 强化层（Ascon 型 nibble S 盒 + 旋-异或线性扩散 + 轮常量），作用于工作态 v[0..7]。
func spn_b(v: ref table<i64>, r: i64) {
    var w2: i64 = 0
    while w2 < 8 {
        var x = v[w2]
        var nx: i64 = 0
        var nb: i64 = 0
        while nb < 8 {
            var idx = (x >> (4 * nb)) & 0xF
            nx = nx | (tsha_bsbox[idx] << (4 * nb))
            nb = nb + 1
        }
        v[w2] = nx & 0xFFFFFFFF
        w2 = w2 + 1
    }
    v[0] = (v[0] ^ rr32(v[0], 5) ^ rr32(v[1], 25)) & 0xFFFFFFFF
    v[1] = (v[1] ^ rr32(v[1], 7) ^ rr32(v[2], 19)) & 0xFFFFFFFF
    v[2] = (v[2] ^ rr32(v[2], 9) ^ rr32(v[3], 21)) & 0xFFFFFFFF
    v[3] = (v[3] ^ rr32(v[3], 11) ^ rr32(v[0], 27)) & 0xFFFFFFFF
    v[4] = (v[4] ^ rr32(v[4], 13) ^ rr32(v[5], 29)) & 0xFFFFFFFF
    v[5] = (v[5] ^ rr32(v[5], 15) ^ rr32(v[6], 3)) & 0xFFFFFFFF
    v[6] = (v[6] ^ rr32(v[6], 17) ^ rr32(v[7], 23)) & 0xFFFFFFFF
    v[7] = (v[7] ^ rr32(v[7], 1) ^ rr32(v[4], 31)) & 0xFFFFFFFF
    v[0] = (v[0] ^ v[4]) & 0xFFFFFFFF
    v[1] = (v[1] ^ v[5]) & 0xFFFFFFFF
    v[2] = (v[2] ^ v[6]) & 0xFFFFFFFF
    v[3] = (v[3] ^ v[7]) & 0xFFFFFFFF
    v[4] = (v[4] ^ v[0]) & 0xFFFFFFFF
    v[5] = (v[5] ^ v[1]) & 0xFFFFFFFF
    v[6] = (v[6] ^ v[2]) & 0xFFFFFFFF
    v[7] = (v[7] ^ v[3]) & 0xFFFFFFFF
    v[0] = (v[0] ^ ((tsha_brcon[r & 15] + r) & 0xFFFFFFFF)) & 0xFFFFFFFF
    v[2] = (v[2] ^ ((tsha_brcon[(r + 1) & 15] + r + 1) & 0xFFFFFFFF)) & 0xFFFFFFFF
}

// 单 64 字节块压缩（A 骨架：B 轨 ARX + T 轨 trit 位平面扩散 + 每轮互转 + 每 3 轮 SPN）。
func compress_b(h: ref table<i64>, msg: string, n: i64, off: i64, t_lo: i64, t_hi: i64, last: bool) {
    var m = table_new_i64()
    var k: i64 = 0
    while k < 16 {
        table_push(m, le_word(msg, n, off, k))
        k = k + 1
    }
    var (M0, N0, M1, N1) = block_planes(msg, n, off)
    var skey = block_skey(msg, n, off)
    var PM = M0                       // T 轨位平面累加器（幅值）
    var PN = N0                       // T 轨位平面累加器（符号）
    var v = table_new_i64()
    var i: i64 = 0
    while i < 8 {
        table_push(v, h[i])
        i = i + 1
    }
    i = 0
    while i < 8 {
        table_push(v, tsha_biv[i])
        i = i + 1
    }
    v[12] = v[12] ^ t_lo
    v[13] = v[13] ^ t_hi
    if last {
        v[14] = v[14] ^ 0xFFFFFFFF
    }
    var r: i64 = 0
    while r < 14 {
        var sr = r
        if sr >= 10 {
            sr = sr - 10
        }
        var base = sr * 16
        var rd = (skey + r * 7) & 15
        // B 轨：ARX G 网络（复用 g_f 与 σ 调度列）
        g_f(v, 0, 4, 8, 12, m[(tsha_bsig[base + 0] + rd) & 15], m[(tsha_bsig[base + 1] + rd) & 15])
        g_f(v, 1, 5, 9, 13, m[(tsha_bsig[base + 2] + rd) & 15], m[(tsha_bsig[base + 3] + rd) & 15])
        g_f(v, 2, 6, 10, 14, m[(tsha_bsig[base + 4] + rd) & 15], m[(tsha_bsig[base + 5] + rd) & 15])
        g_f(v, 3, 7, 11, 15, m[(tsha_bsig[base + 6] + rd) & 15], m[(tsha_bsig[base + 7] + rd) & 15])
        g_f(v, 0, 5, 10, 15, m[(tsha_bsig[base + 8] + rd) & 15], m[(tsha_bsig[base + 9] + rd) & 15])
        g_f(v, 1, 6, 11, 12, m[(tsha_bsig[base + 10] + rd) & 15], m[(tsha_bsig[base + 11] + rd) & 15])
        g_f(v, 2, 7, 8, 13, m[(tsha_bsig[base + 12] + rd) & 15], m[(tsha_bsig[base + 13] + rd) & 15])
        g_f(v, 3, 4, 9, 14, m[(tsha_bsig[base + 14] + rd) & 15], m[(tsha_bsig[base + 15] + rd) & 15])
        // B→T 互转：B 轨输出 v0,v1 分段展开入 T 轨（balanced trit 混合）
        var (bp_m, bp_n) = tadd2(PM, PN, rl32(v[0] & 0xFFFFFFFF, (r * 3) & 31), rl32(v[1] & 0xFFFFFFFF, (r * 5) & 31))
        PM = bp_m
        PN = bp_n
        // T 轨 trit 位平面扩散（全位运算：balanced add + 旋转 + 混洗）
        var (dp_m, dp_n) = tadd2(PM, PN, rr32((M1 + r) & 0xFFFFFFFF, (r * 2) & 31), rr32(rl32(N1, (r * 3) & 31), (r * 7) & 31))
        PM = dp_m
        PN = dp_n
        PM = (PM ^ rl32(PN, (r * 5) & 31)) & 0xFFFFFFFF
        PN = (PN ^ rl32(PM, (r * 2) & 31)) & 0xFFFFFFFF
        PM = (rl32(PM, 16) ^ PM) & 0xFFFFFFFF        // 16 位半字混洗（交换两半后异或回）
        // T→B 互转：majority 量化回 B 轨（最近邻量化）
        var W0 = quant3(M0, N0, PM, PN, rl32(M1, (r * 9) & 31), rl32(N1, (r * 11) & 31))
        var W1 = quant3(rl32(M1, 13), rl32(N1, 7), PM, PN, rl32(M0, (r * 3) & 31), rl32(N0, (r * 5) & 31))
        v[2] = (v[2] ^ rl32(W0, (r * 7) & 31)) & 0xFFFFFFFF
        v[6] = (v[6] ^ rl32(W1, (r * 11) & 31)) & 0xFFFFFFFF
        v[10] = (v[10] ^ rr32(PM, (r * 3) & 31)) & 0xFFFFFFFF
        v[14] = (v[14] ^ rl32(PN, (r * 5) & 31)) & 0xFFFFFFFF
        if r % 3 == 2 {
            spn_b(v, r)                              // 每 3 轮插一层 SPN 强化
        }
        r = r + 1
    }
    i = 0
    while i < 8 {
        h[i] = (h[i] ^ v[i] ^ v[i + 8]) & 0xFFFFFFFF
        i = i + 1
    }
}

// tsha1b-256 内部哈希：计数器式（纯零填充），14 轮，输出 8 字大端 hex = 64 hex。
func digest_b(msg: string) -> string {
    ensure_biv()
    ensure_bsig()
    ensure_bsbox()
    ensure_brcon()
    var n: i64 = len(msg)
    var h = table_new_i64()
    var i: i64 = 0
    while i < 8 {
        table_push(h, tsha_biv[i])
        i = i + 1
    }
    h[0] = h[0] ^ 0x01010000 ^ 32
    var t_lo: i64 = 0
    var t_hi: i64 = 0
    var pos: i64 = 0
    while pos + 64 < n {
        t_hi = (t_hi + carry32(t_lo, 64)) & 0xFFFFFFFF
        t_lo = (t_lo + 64) & 0xFFFFFFFF
        compress_b(h, msg, n, pos, t_lo, t_hi, false)
        pos = pos + 64
    }
    var rem = n - pos
    t_hi = (t_hi + carry32(t_lo, rem)) & 0xFFFFFFFF
    t_lo = (t_lo + rem) & 0xFFFFFFFF
    compress_b(h, msg, n, pos, t_lo, t_hi, true)
    var out: string = ""
    i = 0
    while i < 8 {
        out = out + hex8(h[i])
        i = i + 1
    }
    return out
}

// tsha1b-256：默认输出 46 字符 base48（无歧义，见 std/base48.tie）。
// 验证向量（用 gen_tsha1bx.py 生成，与 f 档独立）：
//   tsha1b("")    = f4564d606304f76c7de5e2578d6afeb3e7178f54866373a53169e59cbfa7c514
//   tsha1b("abc") = 90769d04e106469ca28f577fd911a8fd17a4f277a76eb39db192543bcd10f8b9
//   tsha1b(1000xa) = 0fbb990a8b709e108f032c6e2b47804cd31d9cc3bc78e7b4c9dcc832495c2624
pub func tsha1b(msg: string) -> string {
    return b48.encode(digest_b(msg))
}

// tsha1b-256：64 位十六进制（_hex 可选，旧 hex 行为保持对称）。
pub func tsha1b_hex(msg: string) -> string {
    return digest_b(msg)
}
}   // namespace tsha



