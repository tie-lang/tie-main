type tie<class>
// ============================================================================
// csprng.tie：标准库——加密安全随机（命名空间 csrnd，Windows BCryptGenRandom）。
// 用途：TLS 密钥材料（x25519/P-256 临时私钥）、ClientHello random、session id
// 等密码学场景的随机源（r.1.2.1）。std/random.tie 的 rand_range/int 底座为非
// 密码学安全（头注已声明），禁止用于密钥材料。
//
// 接口：
//   csrnd.strong_bytes(n) -> table<i64>   n 个加密安全随机字节（0..255）；
//                                         失败（n<=0 或系统 RNG 不可用）返回空表，
//                                         调用方按哨兵拒绝（不降级到伪随机）。
//
// 实现：BCryptGenRandom(NULL, buf, n, BCRYPT_USE_SYSTEM_PREFERRED_RNG=0x2)。
// 实测本平台 NULL 句柄 + dwFlags=0 返回 0xC0000008（STATUS_INVALID_HANDLE）；
// dwFlags=0x2（系统首选 RNG，Win10 1607+）则成功（FIPS 认可的 CSPRNG）。
// 只声明 BCryptGenRandom 一个 extern：ext/ecdsa.tie 已声明其余 BCrypt 原语，
// tie 禁止跨模块重复声明 extern，故本文件不复用提供者打开原语。
// bcrypt.lib 已由 toolchain 默认链入（同 ext/ecdsa）。
// ============================================================================

// ---- BCrypt extern（bcrypt.dll）：句柄/指针 i64、ULONG u32 ----
unsafe extern fn BCryptGenRandom(hAlgorithm: i64, pbBuffer: ptr<u8>, cbBuffer: u32, dwFlags: u32) -> i32

namespace csrnd {

// n 个加密安全随机字节（0..255）。n<=0 或系统 RNG 失败 → 返回空表。
pub func strong_bytes(n: i64) -> table<i64> {
    var out = table_new_i64()
    if n <= 0 {
        return out
    }
    unsafe {
        var p: ptr<u8> = alloc(n)
        // hAlgorithm=NULL + BCRYPT_USE_SYSTEM_PREFERRED_RNG（系统首选 CSPRNG）
        if BCryptGenRandom(0, p, as_u32(n), 2u32) != 0 {
            return table_new_i64()
        }
        var i: i64 = 0
        while i < n {
            table_push(out, as_i64(deref(ptr_add(p, i))))
            i = i + 1
        }
    }
    return out
}

}   // namespace csrnd
