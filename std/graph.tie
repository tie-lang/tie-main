type tie<class>
// graph.tie：标准库——图算法（命名空间 graph）
// 内容：Dijkstra（单源最短路）、Floyd（全源最短路）、Prim（最小生成树）、
// Bellman-Ford（负权最短路 + 负环检测）、最大流（Ford-Fulkerson）、二分匹配（匈牙利）。
// 接口约定：图数据用**真表**传参——n×n 邻接/容量矩阵按行展平为 table<i64>，
// 无边用 999 表示（与原字符串编码语义一致）。table<i64> 参数元素类型静态已知，
// 函数内可直接下标读取。返回距离/路径/匹配结果为局部 i64 表（table<i64>）。
// 调用：import 后 graph.dijkstra(adj, n, src) / graph.floyd(adj, n) 等

namespace graph {
// Dijkstra 单源最短路：返回 dist 表（src 到各点最短距离，i64）。
// adj：n×n 邻接矩阵展平 table<i64>（无边用 999）；n：顶点数；src：源点。
pub func dijkstra(adj: table<i64>, n: i64, src: i64) -> table<i64> {
    // dist[i]：src 到 i 的距离；visited[i]：是否已确定
    var dist = table_new_i64()
    var visited = table_new_i64()
    var i: i64 = 0
    while i < n {
        table_push(dist, adj[src * n + i])
        table_push(visited, 0)
        i = i + 1
    }
    dist[src] = 0
    var count: i64 = 0
    while count < n {
        // 找未访问中 dist 最小者
        var u: i64 = -1
        var best: i64 = 999999
        var j: i64 = 0
        while j < n {
            if visited[j] == 0 && dist[j] < best {
                best = dist[j]
                u = j
            }
            j = j + 1
        }
        if u < 0 {
            // 剩余不可达
            count = n
        } else {
            visited[u] = 1
            // 松弛
            var k: i64 = 0
            while k < n {
                var w = adj[u * n + k]
                if visited[k] == 0 && w < 999 && dist[u] + w < dist[k] {
                    dist[k] = dist[u] + w
                }
                k = k + 1
            }
            count = count + 1
        }
    }
    return dist
}

// Floyd 全源最短路：返回扁平 dist 表（dist[i*n+j] = i 到 j 最短路，i64）。
pub func floyd(adj: table<i64>, n: i64) -> table<i64> {
    // 复制到局部表（就地更新，不写回调用方实参）
    var dist = table_new_i64()
    var ii: i64 = 0
    while ii < n * n {
        table_push(dist, adj[ii])
        ii = ii + 1
    }
    var k: i64 = 0
    while k < n {
        var i: i64 = 0
        while i < n {
            var j: i64 = 0
            while j < n {
                var via = dist[i * n + k] + dist[k * n + j]
                if dist[i * n + k] < 999 && dist[k * n + j] < 999 && via < dist[i * n + j] {
                    dist[i * n + j] = via
                }
                j = j + 1
            }
            i = i + 1
        }
        k = k + 1
    }
    return dist
}

// Prim 最小生成树：返回 MST 总权重（i64）。adj：无向加权邻接矩阵展平 table<i64>。
pub func prim_mst(adj: table<i64>, n: i64) -> i64 {
    if n == 0 {
        return 0
    }
    // key[i]：到已选集合的最小边；in_mst[i]：是否已选
    var key = table_new_i64()
    var in_mst = table_new_i64()
    var i: i64 = 0
    while i < n {
        table_push(key, 999999)
        table_push(in_mst, 0)
        i = i + 1
    }
    key[0] = 0
    var total: i64 = 0
    var count: i64 = 0
    while count < n {
        // 找 key 最小未选
        var u: i64 = -1
        var best: i64 = 999999
        var j: i64 = 0
        while j < n {
            if in_mst[j] == 0 && key[j] < best {
                best = key[j]
                u = j
            }
            j = j + 1
        }
        if u < 0 {
            return total
        }
        in_mst[u] = 1
        total = total + key[u]
        // 更新邻接点 key
        var k: i64 = 0
        while k < n {
            var w = adj[u * n + k]
            if in_mst[k] == 0 && w < 999 && w < key[k] {
                key[k] = w
            }
            k = k + 1
        }
        count = count + 1
    }
    return total
}

// Bellman-Ford：单源最短路（支持负权）。返回 (dist 表, 是否负环) 编码。
// adj：n×n 邻接矩阵展平 table<i64>（无边=999，负权边直接用其负权重）。
// 返回格式：前 n 个是 dist，最后 1 个是标志（1 = 有负环，0 = 无）。
pub func bellman_ford(adj: table<i64>, n: i64, src: i64) -> table<i64> {
    var dist = table_new_i64()
    var i: i64 = 0
    while i < n {
        table_push(dist, 999999)
        i = i + 1
    }
    dist[src] = 0
    // n-1 轮松弛：对每条有向边 (u,v,w)（矩阵内 w<999 即存在边）
    var iter: i64 = 0
    while iter < n - 1 {
        var u: i64 = 0
        while u < n {
            var v: i64 = 0
            while v < n {
                var w = adj[u * n + v]
                if w < 999 && dist[u] < 999999 && dist[u] + w < dist[v] {
                    dist[v] = dist[u] + w
                }
                v = v + 1
            }
            u = u + 1
        }
        iter = iter + 1
    }
    // 第 n 次松弛检测负环
    var neg_cycle: i64 = 0
    var u2: i64 = 0
    while u2 < n {
        var v2: i64 = 0
        while v2 < n {
            var w2 = adj[u2 * n + v2]
            if w2 < 999 && dist[u2] < 999999 && dist[u2] + w2 < dist[v2] {
                neg_cycle = 1
            }
            v2 = v2 + 1
        }
        u2 = u2 + 1
    }
    table_push(dist, neg_cycle)
    return dist
}

// 最大流（Ford-Fulkerson，BFS 增广）：返回最大流量（i64）。
// cap：n×n 容量矩阵展平 table<i64>；s：源点；t：汇点。
pub func max_flow(cap: table<i64>, n: i64, s: i64, t: i64) -> i64 {
    // 复制到局部表（增广更新就地修改，不写回调用方实参）
    var copy = table_new_i64()
    var ii: i64 = 0
    while ii < n * n {
        table_push(copy, cap[ii])
        ii = ii + 1
    }
    cap = copy
    var flow: i64 = 0
    // 反复 BFS 找增广路（限制最多 n*n 轮防止无限循环）
    var round: i64 = 0
    var augmented: bool = true
    while augmented && round < n * n {
        augmented = false
        // prev 记录前驱
        var prev = table_new_i64()
        var i: i64 = 0
        while i < n {
            table_push(prev, -1)
            i = i + 1
        }
        var visited = table_new_i64()
        i = 0
        while i < n {
            table_push(visited, 0)
            i = i + 1
        }
        // BFS 找增广路（队列 + head 指针只增）
        var queue = table_new_i64()
        table_push(queue, s)
        visited[s] = 1
        var head: i64 = 0
        while head < len(queue) && prev[t] < 0 {
            var u = queue[head]
            head = head + 1
            var v: i64 = 0
            while v < n {
                if visited[v] == 0 && cap[u * n + v] > 0 {
                    visited[v] = 1
                    prev[v] = u
                    table_push(queue, v)
                }
                v = v + 1
            }
        }
        // 找到增广路：计算瓶颈容量
        if prev[t] >= 0 {
            var bottleneck: i64 = 999999
            var v2 = t
            while v2 != s {
                var u2 = prev[v2]
                if cap[u2 * n + v2] < bottleneck {
                    bottleneck = cap[u2 * n + v2]
                }
                v2 = u2
            }
            // 更新容量
            var v3 = t
            while v3 != s {
                var u3 = prev[v3]
                cap[u3 * n + v3] = cap[u3 * n + v3] - bottleneck
                cap[v3 * n + u3] = cap[v3 * n + u3] + bottleneck
                v3 = u3
            }
            flow = flow + bottleneck
            augmented = true
        }
        round = round + 1
    }
    return flow
}

// 二分匹配（匈牙利算法）：返回最大匹配数（i64）。
// adj：n 个左顶点 × m 个右顶点的邻接（0/1，1 = 有边）；n：左点数；m：右点数。
// 序列长度 = n*m，行优先（左点 i 连右点 j 则 adj[i*m+j] = 1）。
pub func bipartite_match(adj: table<i64>, n: i64, m: i64) -> i64 {
    // match_r[j]：右点 j 匹配的左点（-1 未匹配）
    var match_r = table_new_i64()
    var j: i64 = 0
    while j < m {
        table_push(match_r, -1)
        j = j + 1
    }
    var result: i64 = 0
    var u: i64 = 0
    while u < n {
        var matched: bool = false
        var v: i64 = 0
        while v < m && !matched {
            if adj[u * m + v] == 1 {
                if match_r[v] < 0 {
                    // 右点空闲：直接匹配
                    match_r[v] = u
                    matched = true
                } else {
                    // 右点被占：尝试为原配 match_r[v] 找新右点（跳过 v）
                    var old = match_r[v]
                    var found: bool = false
                    var w: i64 = 0
                    while w < m && !found {
                        if w != v && adj[old * m + w] == 1 && match_r[w] < 0 {
                            match_r[w] = old
                            match_r[v] = u
                            found = true
                            matched = true
                        }
                        w = w + 1
                    }
                }
            }
            v = v + 1
        }
        if matched {
            result = result + 1
        }
        u = u + 1
    }
    return result
}
}