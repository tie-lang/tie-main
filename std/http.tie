type tie<class>
// http.tie：标准库——HTTP 客户端兼容层（命名空间 http）。
// p.6.6.2：底层转发到 std/httpc.tie（命名空间 httpc）完整实现（https/POST/
// cookies/重定向）；签名与 Result 语义保持不变。数据平面与能力说明见 httpc.tie。
// library-v2：get 返回 Result<string, string>；连接失败/非 2xx/超时返回 Err（不再
// 触发进程退出）。成功正文按 ASCII/UTF-8 文本字节转字符串。

import "./result.tie"
import "./httpc.tie" as httpc

namespace http {
// HTTP GET 指定 URL，返回响应正文。成功 Ok(正文文本)；
// 失败（连接失败 / 非 2xx / 解析失败）返回 Err(原因)。
pub func get(url: string) -> Result<string, string> {
    var headers = table_new_string()
    var r = httpc.get(url, headers)
    if r.ok {
        return Result.Ok(httpc.body_text(r))
    }
    if str_len(r.err) > 0 {
        return Result.Err(r.err)
    }
    return Result.Err("HTTP 请求失败（状态 " + to_string(r.status) + "）")
}

// HTTP GET 下载到本地文件；成功返回 true，失败返回 false（可安全用于下载判断）。
pub func get_file(url: string, path: string) -> bool {
    return httpc.get_file(url, path)
}
}
