type tie<logic>
// stdio_line_probe.tie：p.6.9.1 read_line 探针（stdin 行读）
// ============================================================
// 用法：cmd /c "echo hello | stdio_line_probe.exe"
// 验收：读入 "hello"（\r\n 剥除），回写 + 断言相等 → 打印 read_line:OK，exit 0。
// 连续两行：行间以 \n 分隔（第二行无输入 → 空串）。
// EN: read_line probe — read one stdin line ("hello"), echo it back, assert
// equality against the expected literal, print read_line:OK and exit 0.

func main() -> i64 {
    var got = read_line()
    if got == "hello" {
        println("read_line:OK:" + got)
        return 0
    }
    println("read_line:FAIL:[" + got + "]")
    return 1
}