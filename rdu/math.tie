type tie<class>
// math.tie：嵌入式基础层（rdu）——基础数学模块（命名空间 rdu_math）
// 层级定位：rdu = Reusable Device Utils，嵌入式基础层——面向裸机/无操作系统的
// 底层场景提供纯计算工具，编译出的 .a 零运行时依赖（freestanding 可直接链接）。
//
// 无栈纪律（本模块全部满足）：
//   1. 零原语调用：只用算术（+ - * / %）与比较，不调用任何语言底座内建函数；
//   2. 零动态内存：参数全部为 i64 / f64 / bool 标量；
//   3. 无递归；
//   4. 无顶层全局变量（纯函数，同输入同输出）；
//   5. 编译出的 .a 无任何外部函数声明（IR 中无 declare），裸机可直接链接。
//
// 泛型说明（library-v2 新特性）：abs/max/min/clamp 用泛型同时服务 i64 与 f64，
// 调用点单态化展开（零运行时开销）。模板体内**不写整数字面量**（如 `x < 0` 的 0
// 在单态化为 f64 时字面类型固化仍为 i64，比较类型不匹配）——比较一律用参数或
// 由参数推出的值（如 abs 用 `x - x` 得到 T 型零值）。
// avg_f/pow_i/sign_i/deg_to_rad/rad_to_deg 语义与类型相关，保留独立函数。
//
// 调用：import 后 rdu_math.max<i64>(...) / rdu_math.gcd(...)（泛型可推断或显式）。
// 命名规范：命名空间内函数不加 rdu_math_ 前缀。

namespace rdu_math {
// 绝对值：负数取反，非负数原样返回（泛型：i64/f64 均可用）
// 注：`x - x` 得到 T 型零值（整数 0 / 浮点 0.0），规避模板体内整数字面量类型固化
pub func abs<T>(x: T) -> T {
    var tz = x - x
    if x < tz {
        return -x
    }
    return x
}

// 两个数取较大者（泛型：i64/f64 均可用，比较语义一致）
pub func max<T>(a: T, b: T) -> T {
    if a > b {
        return a
    }
    return b
}

// 两个数取较小者（泛型：i64/f64 均可用）
pub func min<T>(a: T, b: T) -> T {
    if a < b {
        return a
    }
    return b
}

// 限幅：把 x 限制在 [lo, hi] 区间内（小于 lo 取 lo，大于 hi 取 hi；泛型）
pub func clamp<T>(x: T, lo: T, hi: T) -> T {
    if x < lo {
        return lo
    }
    if x > hi {
        return hi
    }
    return x
}

// 判断整数是否为奇数（取模 2 余非零；负数取模余数非零同样判为奇数）
pub func is_odd(x: i64) -> bool {
    return x % 2 != 0
}

// 判断整数是否为偶数（取模 2 余零）
pub func is_even(x: i64) -> bool {
    return x % 2 == 0
}

// 两个浮点取平均值（f64 专属：整数除法语义不同，故不泛型化）
pub func avg_f(a: f64, b: f64) -> f64 {
    return (a + b) / 2.0
}

// 整数符号：负数返回 -1，正数返回 1，零返回 0
pub func sign_i(x: i64) -> i64 {
    if x < 0 {
        return -1
    }
    if x > 0 {
        return 1
    }
    return 0
}

// 角度转弧度：deg * π / 180（π 取双精度近似值）
pub func deg_to_rad(deg: f64) -> f64 {
    return deg * 3.141592653589793 / 180.0
}

// 弧度转角度：rad * 180 / π（π 取双精度近似值）
pub func rad_to_deg(rad: f64) -> f64 {
    return rad * 180.0 / 3.141592653589793
}

// 两个整数的最大公约数（欧几里得辗转相除；负数取绝对值，0 与 x 的 gcd 为 |x|）
pub func gcd(a: i64, b: i64) -> i64 {
    var x: i64 = a
    var y: i64 = b
    // 负数取绝对值（i64::MIN 取反回绕为自身，数学上 gcd 符号无意义）
    if x < 0 {
        x = -x
    }
    if y < 0 {
        y = -y
    }
    while y != 0 {
        var r: i64 = x % y
        x = y
        y = r
    }
    return x
}

// 两个整数的最小公倍数：|a*b| / gcd(a, b)；任一为 0 → 0
pub func lcm(a: i64, b: i64) -> i64 {
    if a == 0 || b == 0 {
        return 0
    }
    var g = gcd(a, b)
    // |a / g * b|：先除后乘避免中间溢出（a/g 与 b 的乘积仍可能溢出，本期接受）
    var q: i64 = a / g
    var r: i64 = q * b
    if r < 0 {
        r = -r
    }
    return r
}

// 整数幂 x^n（n >= 0 循环乘）；n < 0 返回 0（整数负指数无意义，与多数语言一致）
pub func pow_i(x: i64, n: i64) -> i64 {
    if n < 0 {
        return 0
    }
    var result: i64 = 1
    var i: i64 = 0
    while i < n {
        result = result * x
        i = i + 1
    }
    return result
}
}