type tie<class>
// crc.tie：嵌入式基础层（rdu）——增量式校验模块（命名空间 rdu_crc）
// 层级定位：rdu = Reusable Device Utils，嵌入式基础层——面向裸机/无操作系统的
// 底层场景提供纯计算工具，编译出的 .a 零运行时依赖（freestanding 可直接链接）。
// 用途：逐字节校验和 / 哈希（**非加密安全**，可碰撞，勿用于密码/签名/防篡改）。
//
// 无栈纪律（本模块全部满足）：
//   1. 零原语调用：只用位运算（& | ^ << >>）与算术/比较，不调用任何语言底座
//      内建函数；不创建表（无 CRC 查表）、不拼接字符串；
//   2. 零动态内存：状态为 struct 值类型（i64 字段），无堆、无运行时；
//   3. 无递归；
//   4. 无顶层全局变量（纯函数，同输入同输出）；
//   5. 编译出的 .a 无任何外部函数声明（IR 中无 declare），裸机可直接链接。
//
// 状态封装（library-v2 新特性）：每个算法一个 struct 状态类型（Crc8/Crc16/
// Crc32/Fnv1a，各含 i64 字段），由调用方逐字节喂入并回写——
//   var c = rdu_crc.crc32_new()
//   c = rdu_crc.crc32_update(c, 49)   // 喂一个字节，返回新状态
//   c = rdu_crc.crc32_update(c, 50)
//   var sum: i64 = rdu_crc.crc32_value(c)   // 收尾（CRC 含最终异或）并取值
//
// == 移位语义 ==
//   i64 的 `>>` 生成 ashr（算术右移）。本模块所有移位操作数恒为正（crc 值每步
//   & 掩码 / 除以 2 后 < 2^32 且符号位恒为 0），算术右移即等价逻辑右移，高位补 0，
//   逐字节位运算正确（与旧版 rdu_crc / std/crypto 的论证一致）。
//
// == crc8 算法选择说明（对齐标准校验向量）==
//   CRC-8/ATM（多项式 0x07）官方校验向量 "123456789" = 0xF4=244。标准逐位算法
//   为 MSB-first（非反射）：判断最高位，c 左移，最高位为 1 则异或 0x07。
//
// == crc32/fnv1a 数值安全 ==
//   crc32 每步结果恒 < 2^32 且恒正（0xEDB88320 < 2^32，c>>1 < 2^31，异或后仍
//   < 2^32），value 输出 ^ 0xFFFFFFFF 亦 < 2^32。fnv1a 乘法 (2^32-1)*0x01000193
//   ≈ 7.2e16 << i64::MAX（9.2e18），永不溢出；每步 & 0xFFFFFFFF 掩码保证恒正。
//
// 调用：import 后 rdu_crc.crc32_new() / rdu_crc.crc32_update(...)。
// 命名规范：crc8/crc16/crc32/fnv1a 是算法族名（非模块冗余前缀），保留区分。

// ==================== 状态类型（值语义，纯 i64 字段）====================
struct Crc8 {
    var v: i64
}
struct Crc16 {
    var v: i64
}
struct Crc32 {
    var v: i64
}
struct Fnv1a {
    var v: i64
}

namespace rdu_crc {
// ==================== CRC-8（CRC-8/ATM，多项式 0x07，非反射）====================
// 新建状态：初始校验值 0（CRC-8/ATM init = 0x00，xorout = 0x00）
pub func crc8_new() -> Crc8 {
    return Crc8(0)
}

// 更新：喂入一个字节，返回新的 8 位状态（值恒 < 256）
// 非反射 MSB-first 逐位算法：c ^= byte，8 次「最高位为 1 则 (c<<1)^0x07 否则 c<<1」，
// 左移后用 & 0xFF 截断回 8 位（0x07 的位全在低 8 位，截断顺序不影响结果）
pub func crc8_update(s: Crc8, byte: i64) -> Crc8 {
    var c: i64 = s.v ^ byte
    var k: i64 = 0
    while k < 8 {
        if (c & 0x80) != 0 {
            c = ((c << 1) ^ 0x07) & 0xFF
        } else {
            c = (c << 1) & 0xFF
        }
        k = k + 1
    }
    return Crc8(c)
}

// 取值：当前 8 位校验值（CRC-8/ATM xorout = 0x00，无需终值异或）
pub func crc8_value(s: Crc8) -> i64 {
    return s.v
}

// ==================== CRC-16（CRC-16/IBM，反射多项式 0xA001）====================
// 新建状态：初始校验值 0（CRC-16/IBM init = 0x0000，xorout = 0x0000）
pub func crc16_new() -> Crc16 {
    return Crc16(0)
}

// 更新：喂入一个字节，返回新的 16 位状态（值恒 < 65536）
// 反射式逐位算法：c ^= byte，8 次「最低位为 1 则 (c>>1)^0xA001 否则 c>>1」；
// 0xA001 < 2^16，c 每步 < 2^16，正数算术右移即逻辑右移
pub func crc16_update(s: Crc16, byte: i64) -> Crc16 {
    var c: i64 = s.v ^ byte
    var k: i64 = 0
    while k < 8 {
        var lsb: i64 = c & 1
        c = c >> 1
        if lsb != 0 {
            c = c ^ 0xA001
        }
        k = k + 1
    }
    return Crc16(c)
}

// 取值：当前 16 位校验值（xorout = 0x0000，无需终值异或）
pub func crc16_value(s: Crc16) -> i64 {
    return s.v
}

// ==================== CRC-32（CRC-32/IEEE 802.3，反射多项式 0xEDB88320）========
// 新建状态：初始校验值 0xFFFFFFFF（IEEE 802.3 init = 0xFFFFFFFF）
pub func crc32_new() -> Crc32 {
    return Crc32(0xFFFFFFFF)
}

// 更新：喂入一个字节，返回新的 32 位状态（值恒 < 2^32）
// 反射式逐位算法：c ^= byte，8 次「最低位为 1 则 (c>>1)^0xEDB88320 否则 c>>1」；
// 0xEDB88320 < 2^32，c 每步 < 2^32 恒正，算术右移即逻辑右移
pub func crc32_update(s: Crc32, byte: i64) -> Crc32 {
    var c: i64 = s.v ^ byte
    var k: i64 = 0
    while k < 8 {
        var lsb: i64 = c & 1
        c = c >> 1
        if lsb != 0 {
            c = c ^ 0xEDB88320
        }
        k = k + 1
    }
    return Crc32(c)
}

// 取值：输出异或 0xFFFFFFFF（IEEE 802.3 xorout = 0xFFFFFFFF），结果恒 < 2^32。
// 标准校验向量：crc32("123456789") 逐字节喂入后 value == 0xCBF43926 == 3421780262
pub func crc32_value(s: Crc32) -> i64 {
    return s.v ^ 0xFFFFFFFF
}

// ==================== FNV-1a（32 位）============================================
// 新建状态：偏移基数 0x811C9DC5（2166136261）
pub func fnv1a_new() -> Fnv1a {
    return Fnv1a(0x811C9DC5)
}

// 更新：喂入一个字节，返回新的 32 位 FNV-1a 状态（值恒 < 2^32）
// 算法：(h ^ 字节) * 0x01000193，再 & 0xFFFFFFFF 截断回 32 位；
// 乘法数值 (2^32-1)*0x01000193 ≈ 7.2e16 < i64::MAX 9.2e18，安全不溢出
pub func fnv1a_update(s: Fnv1a, byte: i64) -> Fnv1a {
    var h: i64 = (s.v ^ byte) & 0xFFFFFFFF
    h = (h * 0x01000193) & 0xFFFFFFFF
    return Fnv1a(h)
}

// 取值：当前 32 位 FNV-1a 哈希（FNV 无终值异或，直接取状态）
pub func fnv1a_value(s: Fnv1a) -> i64 {
    return s.v
}
}