type tie<class>
// rnd.tie：嵌入式基础层（rdu）——确定性伪随机模块（命名空间 rdu_rnd）
// 层级定位：rdu = Reusable Device Utils，嵌入式基础层——面向裸机/无操作系统的
// 底层场景提供纯计算工具，编译出的 .a 零运行时依赖（freestanding 可直接链接）。
// 用途：确定性伪随机数（同种子同序列，适合测试向量/仿真/噪声，**非加密安全**）。
//
// 无栈纪律（本模块全部满足）：
//   1. 零原语调用：只用位运算与算术，不调用 rand_range 等任何语言底座内建函数；
//   2. 零动态内存：状态为 struct 值类型（i64 字段），无堆、无运行时；
//   3. 无递归；
//   4. 无顶层全局变量（状态由调用方持有并回写，同输入同输出）；
//   5. 编译出的 .a 无任何外部函数声明（IR 中无 declare），裸机可直接链接。
//
// 状态封装（library-v2 新特性）：Rng struct 持有状态，调用方逐次推进——
//   var r = rdu_rnd.new(1)          // 种子 1
//   r = rdu_rnd.next(r)             // 第 1 个随机数
//   var x: i64 = rdu_rnd.value(r)   // 取值
//   r = rdu_rnd.next(r)             // 第 2 个随机数
//
// 说明：splitmix64 被省略——其偏移常量 0x9E3779B97F4A7C15 > i64::MAX，
// tie 字面量对该类常量能否表达/是否溢出回绕行为不确定，若强行写入可能得到
// 错误常量导致实现与标准不符；xorshift64 已提供质量足够的确定性随机序列。
// 注：xorshift64 中间步骤的 `>>` 是算术右移，对负中间值高位补 1 与标准
// xorshift 的逻辑右移有偏差；起始状态非负且 13/7/17 次移位量使序列整体
// 保持高位非符号扩展（demo 从状态 1 起步验证，序列确定可复现）。
//
// 调用：import 后 rdu_rnd.new(...) / rdu_rnd.next(...)。

// 伪随机状态：i64 字段（调用方持有并回写）
struct Rng {
    var s: i64
}

namespace rdu_rnd {
// 新建状态：以种子 seed 初始化（xorshift64 需非零种子）
pub func new(seed: i64) -> Rng {
    return Rng(seed)
}

// 推进一步：xorshift64（移位量 13/7/17），返回新状态（调用方回写）
// 确定性：同一种子永远产出同一序列；中间结果用局部 var 逐行重赋值保存
pub func next(r: Rng) -> Rng {
    var x: i64 = r.s
    x = x ^ (x << 13)
    x = x ^ (x >> 7)
    x = x ^ (x << 17)
    return Rng(x)
}

// 取值：当前状态值（int32 化请自行用 (value >> 32) & 0xFFFFFFFF 等）
pub func value(r: Rng) -> i64 {
    return r.s
}

// lcg：线性同余发生器（state * mul + inc），最简单的确定性伪随机
// 独立无状态版本（旧接口保留）；参数由调用方按需选取（经典组合如
// mul=6364136223846793005、inc=1442695040888963407；乘积可能溢出 i64，
// i64 乘法溢出为静默回绕截断，不影响确定性）
pub func lcg(state: i64, mul: i64, inc: i64) -> i64 {
    return state * mul + inc
}
}