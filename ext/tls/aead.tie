type tie<class>
// ============================================================================
// aead.tie：ext/tls——ChaCha20-Poly1305 AEAD（RFC 8439 §2.8，命名空间 aead，纯 tie）
// 用途：TLS 1.3 握手与应用数据 AEAD 底座（对应 RFC 8446 AEAD 要求）。
// 全部以 table<i64>（0..255）承载二进制数据（tie 字符串不能承载 ≥0x80）。
//
// == 组件 ==
//   - 流密码：复用 ext/chacha20.tie 的 chacha.chacha20_encrypt（hex 中转，counter=1）。
//   - Poly1305：内部字节表版实现（输入 table<i64>），把 std/poly1305.tie 的 5×26-bit
//     肢算术核心移植为字节表输入，未引用任何 extern / 非 tie 实现。
//   - AEAD 构造（RFC 8439 §2.8.1）：
//       poly_key = chacha20(key, nonce, counter=0) 密钥流前 32 字节
//       ct       = chacha20(key, nonce, counter=1, pt)
//       mac_data = aad || pad16(aad) || ct || pad16(ct) || len(aad)_LE8 || len(ct)_LE8
//       tag      = poly1305(poly_key, mac_data)
//   - seal 返回 ct||tag；open 先验 tag 后解密，认证失败返空表。
//
// == 权威向量（RFC 8439 §2.8.2，已与官方向量逐字节核对）==
//   key=808182…9f nonce=070000004041424344454647 aad=50515253c0c1c2c3c4c5c6c7
//   明文 114 字节 "Ladies and Gentlemen…" → 密文 114 字节 + tag=1ae10b594f09e26a7e902ecbd0600691
//   （tests/tls_probe/chacha_poly_probe.tie 内硬编码断言。）
// 接口：
//   aead.seal(key_hex, nonce:表12字节, aad:表, pt:表) -> 表  返回 ct||tag（16 字节标签）
//   aead.open(key_hex, nonce, aad, ct, tag) -> 表          认证通过返 pt，否则空表
//   aead.poly1305(key:表32字节, msg:表) -> 表               底层 Poly1305 原始接口（供探针/复用）
// 备注：命名空间内互调为裸调用，内部辅助函数不加 aead_ 前缀。
// ============================================================================

import "../chacha20.tie"
import "./tool.tie"

namespace aead {

// ---- 小工具 ----

// 从 hex 串取 from 起 n 个字符（用于截取 poly 子密钥的 64 个 hex 字符）。
func hex_sub(h: string, from: i64, n: i64) -> string {
    var out: string = ""
    var i: i64 = 0
    while i < n {
        out = out + str_char(h, from + i)
        i = i + 1
    }
    return out
}

// 含 n 个 '0' 的 hex 串（构造 counter=0 的 64 零字节输入）。
func zeros_hex(n: i64) -> string {
    var out: string = ""
    var i: i64 = 0
    while i < n {
        out = out + "0"
        i = i + 1
    }
    return out
}

// ---- 内部字节表版 Poly1305（RFC 8439 §2.5，移植自 std/poly1305.tie 的 5×26-bit 肢算术）----

// 从 16 字节基数偏移 base 处读 4 个 32 位小端字到表 w[0..3]。
func words(key: table<i64>, base: i64) -> table<i64> {
    var w = table_new_i64()
    var j: i64 = 0
    while j < 4 {
        var v: i64 = 0
        var b4: i64 = 0
        while b4 < 4 {
            v = v | (key[base + j * 4 + b4] << (8 * b4))
            b4 = b4 + 1
        }
        table_push(w, v)
        j = j + 1
    }
    return w
}

// 从 4 个 32 位小端字中取第 off 位（26 的倍数）起的 26-bit 肢。
func limb_at(w: table<i64>, off: i64) -> i64 {
    var w0 = w[0]; var w1 = w[1]; var w2 = w[2]; var w3 = w[3]
    var v: i64 = 0
    if off == 0 {
        v = w0 & 0x3ffffff
    } else if off == 26 {
        v = ((w0 >> 26) & 0x3f) | ((w1 & 0xfffff) << 6)
    } else if off == 52 {
        v = ((w1 >> 20) & 0xfff) | ((w2 & 0x3fff) << 12)
    } else if off == 78 {
        v = ((w2 >> 14) & 0x3ffff) | ((w3 & 0xff) << 18)
    } else {
        v = (w3 >> 8) & 0x3ffffff
    }
    return v & 0x3ffffff
}

// 消息从字节 off 起 cnt 字节一块：小端数 + 高位 1（2^(8*cnt)）→ 5 个 26-bit 肢。
func block_limbs(msg: table<i64>, off: i64, cnt: i64) -> table<i64> {
    var w = table_new_i64()
    var j: i64 = 0
    while j < 4 {
        var v: i64 = 0
        var b4: i64 = 0
        while b4 < 4 {
            var bx = off + j * 4 + b4
            var byte: i64 = 0
            if bx < off + cnt {
                byte = msg[bx]
            }
            v = v | (byte << (8 * b4))
            b4 = b4 + 1
        }
        table_push(w, v)
        j = j + 1
    }
    if cnt < 16 {   // 偏块：高位在 2^(8*cnt)（存进对应字）
        var wIdx = (8 * cnt) / 32
        var bit = (8 * cnt) % 32
        w[wIdx] = w[wIdx] | (1 << bit)
    }
    var t = table_new_i64()
    var k: i64 = 0
    while k < 5 {
        table_push(t, limb_at(w, 26 * k))
        k = k + 1
    }
    if cnt == 16 {   // 满块：第 128 位（2^128）落在肢 4 的位 24
        t[4] = t[4] + 0x1000000
    }
    return t
}

// h = (h + t) * r  mod 2^130-5，肢归一化。
func addmul(h: ref table<i64>, r: table<i64>, t: table<i64>) {
    var h0 = h[0] + t[0]
    var h1 = h[1] + t[1]
    var h2 = h[2] + t[2]
    var h3 = h[3] + t[3]
    var h4 = h[4] + t[4]
    var r0 = r[0]; var r1 = r[1]; var r2 = r[2]; var r3 = r[3]; var r4 = r[4]
    var d0 = h0 * r0
    var d1 = h0 * r1 + h1 * r0
    var d2 = h0 * r2 + h1 * r1 + h2 * r0
    var d3 = h0 * r3 + h1 * r2 + h2 * r1 + h3 * r0
    var d4 = h0 * r4 + h1 * r3 + h2 * r2 + h3 * r1 + h4 * r0
    var d5 = h1 * r4 + h2 * r3 + h3 * r2 + h4 * r1
    var d6 = h2 * r4 + h3 * r3 + h4 * r2
    var d7 = h3 * r4 + h4 * r3
    var d8 = h4 * r4
    // 折高位肢（2^130 ≡ 5 mod 2^130-5）
    d3 = d3 + 5 * d8
    d2 = d2 + 5 * d7
    d1 = d1 + 5 * d6
    d0 = d0 + 5 * d5
    // 进位链
    var m = 0x3ffffff
    var c = d0 >> 26; h0 = d0 & m; d1 = d1 + c
    c = d1 >> 26; h1 = d1 & m; d2 = d2 + c
    c = d2 >> 26; h2 = d2 & m; d3 = d3 + c
    c = d3 >> 26; h3 = d3 & m; d4 = d4 + c
    c = d4 >> 26; h4 = d4 & m; h0 = h0 + c * 5
    c = h0 >> 26; h0 = h0 & m; h1 = h1 + c
    c = h1 >> 26; h1 = h1 & m; h2 = h2 + c
    c = h2 >> 26; h2 = h2 & m; h3 = h3 + c
    c = h3 >> 26; h3 = h3 & m; h4 = h4 + c
    c = h4 >> 26; h4 = h4 & m; h0 = h0 + c * 5
    h[0] = h0; h[1] = h1; h[2] = h2; h[3] = h3; h[4] = h4
}

// 终处理：(h mod P) + s 的低 128 位 → 标签肢（就地写回 h）。
func finish(h: ref table<i64>, s: table<i64>) {
    var m = 0x3ffffff
    // 完全进位 h
    var c = h[4] >> 26; h[4] = h[4] & m; h[0] = h[0] + c * 5
    c = h[0] >> 26; h[0] = h[0] & m; h[1] = h[1] + c
    c = h[1] >> 26; h[1] = h[1] & m; h[2] = h[2] + c
    c = h[2] >> 26; h[2] = h[2] & m; h[3] = h[3] + c
    c = h[3] >> 26; h[3] = h[3] & m; h[4] = h[4] + c
    var h0 = h[0]; var h1 = h[1]; var h2 = h[2]; var h3 = h[3]; var h4 = h[4]
    // h - P
    var g0 = h0 + 5; c = g0 >> 26; g0 = g0 & m
    var g1 = h1 + c; c = g1 >> 26; g1 = g1 & m
    var g2 = h2 + c; c = g2 >> 26; g2 = g2 & m
    var g3 = h3 + c; c = g3 >> 26; g3 = g3 & m
    var g4 = h4 + c - 0x4000000
    // h>=P（g4>=0）时取 g，否则取 h
    var useg: i64 = 0
    if g4 >= 0 {
        useg = -1
    }
    var useh: i64 = -1 - useg
    g0 = g0 & useg; g1 = g1 & useg; g2 = g2 & useg; g3 = g3 & useg; g4 = g4 & useg
    h0 = (h0 & useh) | g0
    h1 = (h1 & useh) | g1
    h2 = (h2 & useh) | g2
    h3 = (h3 & useh) | g3
    h4 = (h4 & useh) | g4
    // h += s（s 也是 5 肢）
    var s0 = s[0]; var s1 = s[1]; var s2 = s[2]; var s3 = s[3]; var s4 = s[4]
    c = h4
    h4 = s4
    h0 = h0 + s0
    var c1 = h0 >> 26; h0 = h0 & m; h1 = h1 + s1 + c1; c1 = h1 >> 26; h1 = h1 & m
    h2 = h2 + s2 + c1; c1 = h2 >> 26; h2 = h2 & m
    h3 = h3 + s3 + c1; c1 = h3 >> 26; h3 = h3 & m
    h4 = h4 + c + c1
    // 折 h4 进位（mod 2^130-5）
    c1 = h4 >> 26; h4 = h4 & m; h0 = h0 + c1 * 5
    c1 = h0 >> 26; h0 = h0 & m; h1 = h1 + c1
    c1 = h1 >> 26; h1 = h1 & m; h2 = h2 + c1
    c1 = h2 >> 26; h2 = h2 & m; h3 = h3 + c1
    c1 = h3 >> 26; h3 = h3 & m; h4 = h4 + c1
    h[0] = h0; h[1] = h1; h[2] = h2; h[3] = h3; h[4] = h4
}

// 从 5 肢标签取第 j 个输出字节（小端，位 8j..8j+7，可能跨两肢）。
func tag_byte(t: table<i64>, j: i64) -> i64 {
    var bitlo = 8 * j
    var li = bitlo / 26
    var ro = bitlo % 26
    var v: i64 = (t[li] >> ro) & 0xFF
    var need = ro + 8 - 26
    if need > 0 {
        v = v | (((t[li + 1] & ((1 << need) - 1)) << (8 - need)) & 0xFF)
    }
    return v & 0xFF
}

// 底层 Poly1305：key=32 字节表，msg=字节表，返回 16 字节标签表。
pub func poly1305(key: table<i64>, msg: table<i64>) -> table<i64> {
    var wr = words(key, 0)   // r 的 4 字
    wr[0] = wr[0] & 0x0FFFFFFF
    wr[1] = wr[1] & 0x0FFFFFFC
    wr[2] = wr[2] & 0x0FFFFFFC
    wr[3] = wr[3] & 0x0FFFFFFC
    var ws = words(key, 16)  // s 的 4 字
    var r = table_new_i64()
    var s = table_new_i64()
    var k: i64 = 0
    while k < 5 {
        table_push(r, limb_at(wr, 26 * k))
        table_push(s, limb_at(ws, 26 * k))
        k = k + 1
    }
    var h = table_new_i64()
    k = 0
    while k < 5 {
        table_push(h, 0)
        k = k + 1
    }
    var n: i64 = len(msg)
    var nblocks: i64 = (n + 15) / 16
    var pos: i64 = 0
    var b: i64 = 0
    while b < nblocks {
        var remb = n - pos
        var cnt: i64 = 16
        if remb < 16 {
            cnt = remb
        }
        var t = block_limbs(msg, pos, cnt)
        addmul(h, r, t)
        pos = pos + cnt
        b = b + 1
    }
    finish(h, s)
    var out = table_new_i64()
    var j: i64 = 0
    while j < 16 {
        table_push(out, tag_byte(h, j))
        j = j + 1
    }
    return out
}

// ---- AEAD 编排（RFC 8439 §2.8.1）----

// 补到 16 字节边界（已满则补 0 字节）。
func pad16(t: table<i64>) -> table<i64> {
    var out = table_new_i64()
    var i: i64 = 0
    while i < len(t) {
        table_push(out, t[i])
        i = i + 1
    }
    var rem = len(t) % 16
    var pad: i64 = 0
    if rem != 0 {
        pad = 16 - rem
    }
    i = 0
    while i < pad {
        table_push(out, 0)
        i = i + 1
    }
    return out
}

// v → 8 字节小端。
func le64_bytes(v: i64) -> table<i64> {
    var out = table_new_i64()
    var i: i64 = 0
    while i < 8 {
        table_push(out, (v >> (8 * i)) & 0xFF)
        i = i + 1
    }
    return out
}

// Poly1305 输入串联：aad||pad16(aad)||ct||pad16(ct)||len(aad)_LE8||len(ct)_LE8。
func mac_data(aad: table<i64>, ct: table<i64>) -> table<i64> {
    var m = tbt.concat(pad16(aad), pad16(ct))
    m = tbt.concat(m, le64_bytes(len(aad)))
    m = tbt.concat(m, le64_bytes(len(ct)))
    return m
}

// 派生 Poly1305 一次性子密钥：counter=0 密钥流前 32 字节。
func poly_key(key_hex: string, nonce: table<i64>) -> table<i64> {
    var kstream = chacha.chacha20_encrypt(key_hex, tbt.bytes_to_hex(nonce), 0, zeros_hex(128))
    return tbt.hex_to_bytes(hex_sub(kstream, 0, 64))
}

// ---- 公有接口 ----

// 认证加密：返回 ct||tag。
pub func seal(key_hex: string, nonce: table<i64>, aad: table<i64>, pt: table<i64>) -> table<i64> {
    var pk = poly_key(key_hex, nonce)
    var ct = tbt.hex_to_bytes(chacha.chacha20_encrypt(key_hex, tbt.bytes_to_hex(nonce), 1, tbt.bytes_to_hex(pt)))
    var tag = poly1305(pk, mac_data(aad, ct))
    return tbt.concat(ct, tag)
}

// 认证解密：通过返回明文表，认证失败返回空表。
pub func open(key_hex: string, nonce: table<i64>, aad: table<i64>, ct: table<i64>, tag: table<i64>) -> table<i64> {
    var pk = poly_key(key_hex, nonce)
    var calc = poly1305(pk, mac_data(aad, ct))
    if !tbt.eq(calc, tag) {
        return table_new_i64()
    }
    return tbt.hex_to_bytes(chacha.chacha20_encrypt(key_hex, tbt.bytes_to_hex(nonce), 1, tbt.bytes_to_hex(ct)))
}

}   // namespace aead