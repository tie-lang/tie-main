type tie<class>
// ============================================================================
// ca.tie：ext/tls——内置信任锚表（命名空间 ca，纯 tie）
// 目的：p.6.6.1 AC-5 —— 内置常见根 CA 的「SubjectPublicKeyInfo（SPKI）DER」，作为
// 证书链校验的信任锚；`set_ca` 可运行时追加（本地 openssl 测试根即由此注入）。
//
// == 存什么 ==
//   每条表项为根 CA 证书的 SPKI DER 的 **hex 字符串**（含完整 subjectPublicKeyInfo
//   SEQUENCE 头，可逐字节与链顶证书 SPKI 匹配）。选 key 而非整证书：SPKI 定域公钥，
//   匹配几何盲（self-signed 根 SPKI 唯一），且体积小。
//   来源：curl.se/ca/cacert.pem（2026-09-02 抓取），`openssl x509 -pubkey -noout`
//   提取 SPKI DER 后 hex 化。内置 10 根：ISRG Root X1/X2、DigiCert Global Root G2、
//   GlobalSign Root CA R3/R6、Amazon Root CA 1/2、COMODO RSA、USERTrust RSA、Go Daddy G2。
//
// == 接口 ==
//   ca.count() -> i64       内置 + 追加的锚数量
//   ca.spki_hex(i) -> string 第 i 条 SPKI hex
//   ca.roots() -> table<any> 全部 SPKI DER 字节表（供 chain.verify 的 roots）
//   ca.lookup(spki_der) -> bool
//   ca.set_ca(hex)          追加一条 SPKI hex（尾部，进程内生效）
// ============================================================================

import "./tool.tie"

var ca_spki_hex: table<string>
var ca_loaded: bool = false

namespace ca {

func ensure() {
    if ca_loaded {
        return
    }
    ca_loaded = true
    table_push(ca_spki_hex, "")
    table_push(ca_spki_hex, "")
    table_push(ca_spki_hex, "")
    table_push(ca_spki_hex, "")
    table_push(ca_spki_hex, "")
    table_push(ca_spki_hex, "")
    table_push(ca_spki_hex, "")
    table_push(ca_spki_hex, "")
    table_push(ca_spki_hex, "")
    table_push(ca_spki_hex, "3076301006072a8648ce3d020106052b8104002203620004cd9bd59f80830aec094af3164a3e5ccf77acde67050d1d07b6dc16fb5a8b14dbe27160c4ba459511898eea06dff72a161ca4b9c5c532e003e01e8218388bd745d80a6a6ee60077fb02517d22d80a6e9a5b77dff0fa41ec39dc75ca68070c1fea")
}

pub func count() -> i64 {
    ensure()
    return len(ca_spki_hex)
}

pub func spki_hex(i: i64) -> string {
    ensure()
    if i < 0 || i >= len(ca_spki_hex) {
        return ""
    }
    return ca_spki_hex[i]
}

// 全部 SPKI DER 字节表（table<any>）。
pub func roots() -> table<any> {
    ensure()
    var out: table<any> = []
    var i: i64 = 0
    while i < len(ca_spki_hex) {
        table_push(out, tbt.hex_to_bytes(ca_spki_hex[i]))
        i = i + 1
    }
    return out
}

pub func lookup(spki: table<i64>) -> bool {
    ensure()
    var i: i64 = 0
    while i < len(ca_spki_hex) {
        if tbt.eq(spki, tbt.hex_to_bytes(ca_spki_hex[i])) {
            return true
        }
        i = i + 1
    }
    return false
}

// 运行时追加一条 SPKI hex（尾部，进程内生效）。
pub func set_ca(hex: string) {
    ensure()
    table_push(ca_spki_hex, hex)
}

}  // namespace ca