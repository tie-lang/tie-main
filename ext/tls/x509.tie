type tie<class>
// ============================================================================
// x509.tie：ext/tls——X.509 证书结构解析（命名空间 x509，纯 tie）
// 目的：p.6.6.1 AC-5 —— 解析证书 DER（RFC 5280），供链校验与内置 CA 匹配。
// 全链路以 table<i64>（0..255）承载二进制（tie 字符串不能承载 ≥0x80）。
//
// == 结构 ==
//   一次 `x509.parse(cert_der) -> bool` 调用 der.parse 把整条证书解析为平行节点表，
//   并定位 tbsCertificate 内的各 TLV 节点 id（version/serial/signature/issuer/
//   validity/subject/spki/extensions）。随后 accessor 从节点表提取所需内容：
//     tbs()/spki()/subject_der()/issuer_der()/sig_value()  -> table<i64> 字节表
//     not_before()/not_after()                             -> i64 unix 秒
//     is_ca()                                              -> bool
//     san_list()                                           -> table<string> 主机名
//     cn()                                                 -> string
//     is_rsa()/is_ec()  + rsa_n_bytes()/rsa_e_bytes()/ec_point()
//     sig_id()  签名算法判定: 0=RSA-PKCS1-SHA256 1=RSA-PSS-SHA256 2=ECDSA-SHA256 -1=其他
//   由于 X.509 Name / SPKI 需字节精确比较，issuer/subject 提供原始 DER 字节表；
//   文本型（CN / SAN dNSName）因字符串不可承载 ≥0x80，仅取可打印 ASCII（0x20..0x7E）。
//
// == 嵌套 DER 解析约束 ==
//   der.parse 持模块全局节点表（每次解析重置），故本模块在 parse() 内**先把所有
//   外层原始字节一次性取出**（tbs/sig/issuer/subject/有效期/扩展 value/SPKI 比特串），
//   把局部内层 DER（SAN value、BasicConstraints value、RSAPublicKey、subject Name）
//   交给各自的独立函数再 der.parse。这样任何内层 parse 都不会污染已取出的外层级结果。
//
// == 依赖 ==
//   der.parse（节点表）/ tbt（字节表运算）/ thash.sha256（指纹）。
//   OID 判定全部用 value 字节比较，不做字符串 OID。
// ============================================================================

import "./tool.tie"
import "./der.tie"
import "./hash.tie"

// ---- 模块全局：已解析证书的原始字段 ----
var g_valid: bool = false
var g_tbs: table<i64>        // tbsCertificate 完整 DER TLV 字节（含头）
var g_sig: table<i64>        // signatureValue 内容（BIT STRING，去 unused-bits 头）
var g_subj: table<i64>       // subject Name 完整 DER TLV 字节（含头）
var g_iss: table<i64>        // issuer Name 完整 DER TLV 字节（含头）
var g_spki: table<i64>       // SPKI 完整 DER TLV 字节（含头）
var g_nb: i64 = 0            // notBefore (unix)
var g_na: i64 = 0            // notAfter (unix)
var g_isca: bool = false
var g_sans: table<string>
var g_cn: string = ""
var g_isrsa: bool = false
var g_isec: bool = false
var g_rsa_n: table<i64>      // RSA n 字节（RSAPublicKey 内 INTEGER content, 含前导 0x00）
var g_rsa_e: table<i64>      // RSA e 字节
var g_ec_point: table<i64>   // EC 公钥点字节（0x04||X||Y，65 字节 P-256）
var g_sigid: i64 = -1        // 0/1/2/-1

// OID 常量（value 字节比较）
var C_RSAPUB: table<i64>;     // 1.2.840.113549.1.1.1
var C_RSA_PKCS1: table<i64>;  // 1.2.840.113549.1.1.11 sha256WithRSAEncryption
var C_RSA_PSS: table<i64>;    // 1.2.840.113549.1.1.10 rsassaPss
var C_ECPUB: table<i64>;      // 1.2.840.10045.2.1 id-ecPublicKey
var C_ECDSA: table<i64>;      // 1.2.840.10045.4.3.2 ecdsa-with-SHA256
var O_SECP256R1: table<i64>;  // 1.2.840.10045.3.1.7 prime256v1
var O_CN: table<i64>;         // 2.5.4.3
var O_SAN: table<i64>;        // 2.5.29.17
var O_BCP: table<i64>;        // 2.5.29.19 basicConstraints

namespace x509 {

// 惰性建 OID 常量。
func ensure() {
    if len(C_RSAPUB) > 0 {
        return
    }
    C_RSAPUB = tbt.hex_to_bytes("2a864886f70d010101")
    C_RSA_PKCS1 = tbt.hex_to_bytes("2a864886f70d01010b")
    C_RSA_PSS = tbt.hex_to_bytes("2a864886f70d01010a")
    C_ECPUB = tbt.hex_to_bytes("2a864886ce3d0201")
    C_ECDSA = tbt.hex_to_bytes("2a864886ce3d040302")
    O_SECP256R1 = tbt.hex_to_bytes("2a8648ce3d030107")
    O_CN = tbt.hex_to_bytes("550403")
    O_SAN = tbt.hex_to_bytes("551d11")
    O_BCP = tbt.hex_to_bytes("551d13")
}

// is Time 节点（UTCTime 0x17 / GeneralizedTime 0x18）。
func is_time(nid: i64) -> bool {
    var t: i64 = der.tag_at(nid)
    return t == 0x17 || t == 0x18
}

// 可打印 ASCII 字节表 -> string（≥0x80 记为 '?'，不进入字符串）。
func bytes_to_printable(b: table<i64>) -> string {
    var out: string = ""
    var i: i64 = 0
    while i < len(b) {
        var v = b[i]
        if v >= 0x20 && v <= 0x7e {
            out = out + ascii_to_char(v)
        } else {
            out = out + "?"
        }
        i = i + 1
    }
    return out
}

// 字节(可打印 ASCII) -> 单字符串，查表同 ascii.to_char。
func ascii_to_char(cp: i64) -> string {
    var chars = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~"
    if cp < 0x20 || cp > 0x7e {
        return ""
    }
    return str_char(chars, cp - 0x20)
}

// OID 节点 content 与常量比较。
func oid_eq(nid: i64, want: table<i64>) -> bool {
    if nid < 0 {
        return false
    }
    return tbt.eq(der.value_at(nid), want)
}

// 在 pid 的直属子树中找 tag==t（深度优先）；-1 若无。
func find_deep(pid: i64, t: i64) -> i64 {
    var f = der.find_first(pid, t)
    if f >= 0 {
        return f
    }
    if der.is_constructed(pid) {
        var n: i64 = der.child_count(pid)
        var i: i64 = 0
        while i < n {
            var c = der.child(pid, i)
            var r = find_deep(c, t)
            if r >= 0 {
                return r
            }
            i = i + 1
        }
    }
    return -1
}

// ---- Time：UTC 归一化 ----
// UTCTime "YYMMDDHHMMSSZ"（0x17）/ GeneralizedTime "YYYYMMDDHHMMSSZ"（0x18），
// 统一解析为自 1970-01-01 的 UTC 秒，供有效期窗口比较（std/time.now 同基准）。

// ASCII 数字字节表 -> int（从 off 起 n 位）。
func ascii_num(b: table<i64>, off: i64, nchr: i64) -> i64 {
    var v: i64 = 0
    var i: i64 = 0
    while i < nchr {
        v = v * 10 + (b[off + i] - 48)
        i = i + 1
    }
    return v
}

// 格里历日期 -> 自 1970-01-01 的天数（Howard Hinnant civil 算法）。
func days_from_civil(y: i64, m: i64, d: i64) -> i64 {
    var yy: i64 = y
    var mm: i64 = m
    yy = yy - (mm <= 2 ? 1 : 0)
    var era: i64 = (yy >= 0 ? yy : yy - 399) / 400
    var yoe: i64 = yy - era * 400
    var doy: i64 = (153 * (mm + (mm > 2 ? -3 : 9)) + 2) / 5 + d - 1
    var doe: i64 = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
}

// Time 节点 content 字节 -> unix 秒（isutc=true 表示 UTCTime，false 表示 GeneralizedTime）。
func time_to_epoch(v: table<i64>, isutc: bool) -> i64 {
    var y: i64 = 0
    var mo: i64 = 0
    var d: i64 = 0
    var h: i64 = 0
    var mi: i64 = 0
    var s: i64 = 0
    if isutc && len(v) >= 13 {
        var yy = ascii_num(v, 0, 2)
        if yy < 50 {
            y = 2000 + yy
        } else {
            y = 1900 + yy
        }
        mo = ascii_num(v, 2, 2)
        d = ascii_num(v, 4, 2)
        h = ascii_num(v, 6, 2)
        mi = ascii_num(v, 8, 2)
        s = ascii_num(v, 10, 2)
    } else if isutc == false && len(v) >= 15 {
        y = ascii_num(v, 0, 4)
        mo = ascii_num(v, 4, 2)
        d = ascii_num(v, 6, 2)
        h = ascii_num(v, 8, 2)
        mi = ascii_num(v, 10, 2)
        s = ascii_num(v, 12, 2)
    } else {
        return 0
    }
    return days_from_civil(y, mo, d) * 86400 + h * 3600 + mi * 60 + s
}

// ---- 内层 DER 解析（各自独立 der.parse，不依赖外层树）----

// 解析 SAN「扩展 value DER」为 GeneralNames，收集 dNSName（tag 0x82）主机名。
func parse_san_value(oct: table<i64>) -> table<string> {
    var out = table_new_string()
    var gn = der.parse(oct)
    if gn >= 0 && der.is_constructed(gn) {
        var n: i64 = der.child_count(gn)
        var j: i64 = 0
        while j < n {
            var gg = der.child(gn, j)
            if der.tag_at(gg) == 0x82 {
                table_push(out, bytes_to_printable(der.value_at(gg)))
            }
            j = j + 1
        }
    }
    return out
}

// 解析 BasicConstraints value，返回 cA 布尔。
func parse_bc_value(oct: table<i64>) -> bool {
    var bd = der.parse(oct)
    if bd >= 0 {
        var bn: i64 = der.child_count(bd)
        var j: i64 = 0
        while j < bn {
            var bb = der.child(bd, j)
            if der.tag_at(bb) == 0x01 {
                var vv = der.value_at(bb)
                if len(vv) >= 1 && vv[0] == 0xFF {
                    return true
                }
                return false
            }
            j = j + 1
        }
    }
    return false
}

// 解析 RSAPublicKey DER（SEQUENCE{ INTEGER n, INTEGER e }），存入 g_rsa_n/e。
func parse_rsa_pubkey(inner: table<i64>) {
    var rd = der.parse(inner)
    if rd >= 0 {
        g_rsa_n = der.value_at(der.child(rd, 0))
        var eid = der.child(rd, 1)
        if eid >= 0 {
            g_rsa_e = der.value_at(eid)
        }
    } else {
        g_rsa_n = inner
    }
}

// 从 subject Name DER 提取 CN（OID 2.5.4.3）。独立 der.parse。
func extract_cn(subj: table<i64>) -> string {
    var out: string = ""
    var name = der.parse(subj)
    if name >= 0 && der.is_constructed(name) {
        var nr: i64 = der.child_count(name)
        var r: i64 = 0
        while r < nr {
            var rdn = der.child(name, r)          // SET
            if rdn >= 0 && der.is_constructed(rdn) {
                var a: i64 = der.child_count(rdn)
                var k: i64 = 0
                while k < a {
                    var atv = der.child(rdn, k)
                    if atv >= 0 && der.tag_at(atv) == 0x30 && der.child_count(atv) >= 2 &&
                       oid_eq(der.child(atv, 0), O_CN) {
                        return bytes_to_printable(der.value_at(der.child(atv, 1)))
                    }
                    k = k + 1
                }
            }
            r = r + 1
        }
    }
    return out
}

// ---- 签名算法判定 ----
// 由证书 signature AlgorithmIdentifier 的 OID 字节判定。
func classify_sig(oidb: table<i64>) -> i64 {
    if tbt.eq(oidb, C_RSA_PKCS1) {
        return 0
    }
    if tbt.eq(oidb, C_RSA_PSS) {
        return 1
    }
    if tbt.eq(oidb, C_ECDSA) {
        return 2
    }
    return -1
}

// ---- 主入口：parse ----

// 解析整条证书 DER；成功返回 true，失败 false。
pub func parse(cert: table<i64>) -> bool {
    ensure()
    var root = der.parse(cert)
    if root < 0 {
        return false
    }
    if der.tag_at(root) != 0x30 || der.child_count(root) < 3 {
        return false
    }
    var tbs = der.child(root, 0)
    if tbs < 0 || der.tag_at(tbs) != 0x30 {
        return false
    }
    // ---- 先一次性取外层原始字节（此后内层 parse 将重置 der 全局树）----
    g_tbs = der.node_bytes(tbs)

    // signatureValue
    var sigTlv = der.child(root, 2)
    if sigTlv < 0 || der.tag_at(sigTlv) != 0x03 {
        return false
    }
    var sv = der.value_at(sigTlv)
    if len(sv) >= 1 {
        g_sig = tbt.sub(sv, 1, len(sv) - 1)
    } else {
        g_sig = table_new_i64()
    }

    // 定位 validity / issuer / subject
    var cn: i64 = der.child_count(tbs)
    var found_val: i64 = -1
    var nb_bytes = table_new_i64()
    var na_bytes = table_new_i64()
    var nb_isutc: bool = true
    var na_isutc: bool = true
    var i: i64 = 0
    while i < cn {
        var c = der.child(tbs, i)
        if c >= 0 && der.tag_at(c) == 0x30 && der.child_count(c) == 2 &&
           is_time(der.child(c, 0)) && is_time(der.child(c, 1)) {
            found_val = i
            var t0 = der.child(c, 0)
            var t1 = der.child(c, 1)
            nb_bytes = der.value_at(t0)
            na_bytes = der.value_at(t1)
            nb_isutc = (der.tag_at(t0) == 0x17)
            na_isutc = (der.tag_at(t1) == 0x17)
        }
        i = i + 1
    }
    g_nb = time_to_epoch(nb_bytes, nb_isutc)
    g_na = time_to_epoch(na_bytes, na_isutc)

    if found_val >= 0 {
        var s: i64 = found_val - 1
        while s >= 0 {
            var c = der.child(tbs, s)
            if c >= 0 && der.tag_at(c) == 0x30 {
                g_iss = der.node_bytes(c)
                break
            }
            s = s - 1
        }
        var p: i64 = found_val + 1
        while p < cn {
            var c = der.child(tbs, p)
            if c >= 0 && der.tag_at(c) == 0x30 {
                g_subj = der.node_bytes(c)
                break
            }
            p = p + 1
        }
    }

    // 扩展区：SAN / BasicConstraints
    var san_oct = table_new_i64()
    var bc_oct = table_new_i64()
    var has_san: bool = false
    var has_bc: bool = false
    var extroot = der.find_first(tbs, 0xA3)
    if extroot >= 0 {
        var seq = find_deep(extroot, 0x30)
        if seq >= 0 {
            var en: i64 = der.child_count(seq)
            var e: i64 = 0
            while e < en {
                var ex = der.child(seq, e)
                if der.tag_at(ex) == 0x30 && der.child_count(ex) >= 2 {
                    if oid_eq(der.child(ex, 0), O_SAN) {
                        var os: i64 = -1
                        var k: i64 = 1
                        while k < der.child_count(ex) {
                            if der.tag_at(der.child(ex, k)) == 0x04 {
                                os = der.child(ex, k)
                            }
                            k = k + 1
                        }
                        if os >= 0 {
                            san_oct = der.value_at(os)
                            has_san = true
                        }
                    }
                    if oid_eq(der.child(ex, 0), O_BCP) {
                        var ob: i64 = -1
                        var k: i64 = 1
                        while k < der.child_count(ex) {
                            if der.tag_at(der.child(ex, k)) == 0x04 {
                                ob = der.child(ex, k)
                            }
                            k = k + 1
                        }
                        if ob >= 0 {
                            bc_oct = der.value_at(ob)
                            has_bc = true
                        }
                    }
                }
                e = e + 1
            }
        }
    }

    // SPKI + 证书签名算法 OID
    var spki_seq: i64 = -1
    i = 0
    while i < cn {
        var c = der.child(tbs, i)
        if der.tag_at(c) == 0x30 && der.find_first(c, 0x03) >= 0 {
            spki_seq = c
        }
        i = i + 1
    }
    // 证书签名算法 OID（tbs 内第一个 0x30 的 OID）。
    // 注意：须在 parse_spki 触发内层 der.parse 之前取出（内层会复位全局节点表）。
    var sig_oid = table_new_i64()
    i = 0
    while i < cn {
        var c = der.child(tbs, i)
        if der.tag_at(c) == 0x30 {
            var o2 = der.child(c, 0)
            if o2 >= 0 && der.tag_at(o2) == 0x06 {
                sig_oid = der.value_at(o2)
                break
            }
        }
        i = i + 1
    }
    g_sigid = classify_sig(sig_oid)

    // SPKI（含 RSAPublicKey 内层解析，会复位 der 全局树）
    if spki_seq >= 0 {
        g_spki = der.node_bytes(spki_seq)
        var alg = der.child(spki_seq, 0)
        var oid = der.child(alg, 0)
        var ek = der.find_first(spki_seq, 0x03)   // BIT STRING
        if oid_eq(oid, C_RSAPUB) && ek >= 0 {
            g_isrsa = true
            var bb = der.value_at(ek)
            parse_rsa_pubkey(tbt.sub(bb, 1, len(bb) - 1))
        } else if oid_eq(oid, C_ECPUB) && ek >= 0 {
            g_isec = true
            var bb = der.value_at(ek)
            var params = der.child(alg, 1)
            if params >= 0 && oid_eq(params, O_SECP256R1) {
                if len(bb) == 66 && bb[1] == 0x04 {
                    g_ec_point = tbt.sub(bb, 1, 65)
                }
            }
        }
    }

    // ---- 内层 DER 解析（隔离）----
    var sans: table<string> = table_new_string()
    if has_san {
        sans = parse_san_value(san_oct)
    }
    g_sans = sans
    if has_bc {
        g_isca = parse_bc_value(bc_oct)
    } else {
        g_isca = false
    }
    g_cn = ""
    if len(g_subj) > 0 {
        g_cn = extract_cn(g_subj)
    }

    g_valid = true
    return true
}

// ---- accessor ----

pub func ok() -> bool { return g_valid }

// tbsCertificate 完整 DER（被签名数据）。
pub func tbs() -> table<i64> { return g_tbs }

// signatureValue 内容（去 BIT STRING unused-bits 头）。
pub func sig() -> table<i64> { return g_sig }

// subject Name 完整 DER TLV。
pub func subject_der() -> table<i64> { return g_subj }

// issuer Name 完整 DER TLV。
pub func issuer_der() -> table<i64> { return g_iss }

// SPKI 完整 DER TLV（含头，用于 CA 表匹配与 verify_cver）。
pub func spki() -> table<i64> { return g_spki }

pub func not_before() -> i64 { return g_nb }
pub func not_after() -> i64 { return g_na }
pub func is_ca() -> bool { return g_isca }

// SAN dNSName 主机名列表。
pub func san_list() -> table<string> { return g_sans }

// 通用名（无 SAN 时的回退主机名匹配）。
pub func cn() -> string { return g_cn }

pub func is_rsa() -> bool { return g_isrsa }
pub func is_ec() -> bool { return g_isec }

// RSA n 字节（大端，含前导 0）。
pub func rsa_n_bytes() -> table<i64> { return g_rsa_n }
// RSA e 字节。
pub func rsa_e_bytes() -> table<i64> { return g_rsa_e }
// EC 公钥点字节（0x04||X||Y，65B）。
pub func ec_point() -> table<i64> { return g_ec_point }

// 签名算法 id：0 RSA-PKCS1-SHA256 / 1 RSA-PSS-SHA256 / 2 ECDSA-SHA256 / -1 other
pub func sig_id() -> i64 { return g_sigid }

// 指纹：sha256(整条 DER)。
pub func fingerprint(cert: table<i64>) -> table<i64> {
    return thash.sha256(cert)
}

}  // namespace x509