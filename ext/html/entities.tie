// entry 是否实体 key（entry 以 key + "=" 开头；key 长度须 < entry）
func hit(e: string, k: string) -> bool {
    var klen = len(k)
    if len(e) <= klen {
        return false
    }
    var i: i64 = 0
    while i < klen {
        if str_byte(e, i) != str_byte(k, i) {
            return false
        }
        i = i + 1
    }
    return str_byte(e, i) == 61   // 61 = '='
}

// 取 entry 在 '=' 之后的值（UTF-8 安全）
func val_of(e: string) -> string {
    var n = len(e)
    var i: i64 = 0
    while i < n && str_byte(e, i) != 61 {
        i = i + 1
    }
    i = i + 1
    var sb = string_builder()
    while i < n {
        sb_append_byte(sb, str_byte(e, i))
        i = i + 1
    }
    return sb_build(sb)
}

// 命名实体查找：found=true 时 rep 为替换串；false 表示未命中（原样输出 '&'）。
pub func lookup(name: string) -> (bool, string) {
    if E_READY == false {
        build()
    }
    var lo: i64 = 0
    var hi: i64 = len(E_ENT)
    while lo < hi {
        var mid = lo + (hi - lo) / 2
        if cmp_ent(E_ENT[mid], name) < 0 {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    if lo < len(E_ENT) && hit(E_ENT[lo], name) {
        return (true, val_of(E_ENT[lo]))
    }
    return (false, "")
}

}   // namespace entitytab
