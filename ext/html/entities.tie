type tie<class>
// ============================================================================
// entities.tie：ext/html——HTML5 命名实体查表（命名空间 entitytab，纯 tie）p.6.6.4
// HTML5 named-entity lookup table (namespace entitytab, pure-tie). p.6.6.4
//
// 数据与来源（Data & provenance）：以 Python 标准库 html.entities.html5（WHATWG
// entities.json 派生表，含 ';' 的命名实体，2125 条）为基准生成；条目按 UTF-8 字节
// 字典序排列，进程内常驻一条 prepend 构建。lookup 二分（O(logN) 次短字节比较）。
// 与 token.tie 的数字实体（&#NN; / &#xHH;）解耦：本模块只管命名实体；
// HTML 模式查表，XML 模式不查（&apos; 等 XML 集由 token 侧处理）。
// 本文件由一次性生成脚本产出（不入库）；手工改表请同步改生成源与脚本约定。
// ============================================================================

// ---- 实体表（有序 name=value 条目；懒构建，进程内常驻）----
var E_ENT: table<string>;
var E_READY: bool = false;

namespace entitytab {

// 逐字节字典序比较 entry（name=value）与 key（实体名）：
//   返回 -1 = entry < key；1 = entry > key（key 是 entry 前缀时 entry 更大）
func cmp_ent(e: string, k: string) -> i64 {
    var i: i64 = 0
    while i < len(e) && i < len(k) {
        var a = str_byte(e, i)
        var b = str_byte(k, i)
        if a != b {
            if a < b {
                return -1
            }
            return 1
        }
        i = i + 1
    }
    if i < len(k) {
        return -1   // e 是 k 的前缀（e 更短）
    }
    return 1        // e 更长（含 '='）
}

