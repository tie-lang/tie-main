type tie<logic>
// gen_thunk.tie —— tie 写的 thunk 生成器（p.6.8.6）
// EN: tie-written thunk generator. Central signature registry -> tie binding module.
//
// 职责 / Duties：
//   * 集中登记 extern "C" thunk 的签名（C 名 → 参数/返回类型表）——单一事实源。
//   * 生成 tie 侧绑定模块 ext/gfx/thunk_binding.tie（`unsafe extern fn` 声明 +
//     repr(C) 结构 TSkPaint/TSkImageInfo），供探针 `import + using` 使用。
//   * --emit-c：额外打印 C 头声明片段（人工对照 ext/gfx/skia/thunk/thunk.h 核对
//     声明一致性；机器级一致性由探针 thunk 调用 + 布局 ref.c 兜底）。
//
// 用法 / Usage（仓库根运行；输出相对仓库根）：
//   compiler\tiec.exe ext\gfx\skia\thunk\gen_thunk.tie -o ext\gfx\skia\thunk\gen_thunk.exe
//   ext\gfx\skia\thunk\gen_thunk.exe              → 写 ext/gfx/thunk_binding.tie
//   ext\gfx\skia\thunk\gen_thunk.exe --emit-c     → 另打印 C 头片段
//
// 注：字符串拼接全用 `+`（build.tie 历练路径），避免 string_builder + 条件分支
// 组合触发的 irgen 指令支配缺陷。

// ---------- 字符串工具 ----------
func str_at(s: string, i: i64) -> string {
    return str_char(s, i)
}
func seg(s: string, a: i64, b: i64) -> string {
    var out: string = ""
    var i: i64 = a
    while i < b {
        out = out + str_at(s, i)
        i = i + 1
    }
    return out
}
func split_fields(s: string) -> table<string> {
    var out = table_new_string()
    var n: i64 = str_len(s)
    var cur: string = ""
    var i: i64 = 0
    while i < n {
        var c = str_at(s, i)
        if c == ":" {
            table_push(out, cur)
            cur = ""
        } else {
            cur = cur + c
        }
        i = i + 1
    }
    table_push(out, cur)
    return out
}

// ---------- 类型 token → tie 声明片段映射 ----------
func t_tie(t: string) -> string {
    if t == "i32" {
        return "i32"
    }
    if t == "u32" {
        return "u32"
    }
    if t == "i64" {
        return "i64"
    }
    if t == "f64" {
        return "f64"
    }
    if t == "ptr" {
        return "ptr<u8>"
    }
    if t == "i64ptr" {
        return "ptr<i64>"
    }
    if t == "str" {
        return "string"
    }
    if t == "pinfo" {
        return "ptr<TSkImageInfo>"
    }
    if t == "ppaint" {
        return "ptr<TSkPaint>"
    }
    return "i64"
}
func t_c(t: string) -> string {
    if t == "i32" {
        return "int"
    }
    if t == "u32" {
        return "unsigned int"
    }
    if t == "i64" {
        return "long long"
    }
    if t == "f64" {
        return "double"
    }
    if t == "ptr" {
        return "void*"
    }
    if t == "i64ptr" {
        return "long long*"
    }
    if t == "str" {
        return "const char*"
    }
    if t == "pinfo" {
        return "TSkImageInfo*"
    }
    if t == "ppaint" {
        return "const TSkPaint*"
    }
    return "void*"
}
func is_void_tok(t: string) -> bool {
    return t == "void"
}

// ---------- 静态签名登记表 / registry ----------
// 格式："C函数名:返回token:参数token..."（返回 void = 空段）。
// 与 ext/gfx/skia/thunk/thunk.h 逐一对应；改 thunk.h 必须同步本表，否则生成
// 模块与 thunk 实现不一致 → 链接时缺符号/签名错位（由探针调用 + 布局 ref.c 兜底）。
func registry() -> table<string> {
    var r = table_new_string()
    table_push(r, "sk_surface_create:ptr:i32:i32")
    table_push(r, "sk_surface_canvas:ptr:ptr")
    table_push(r, "sk_surface_snapshot:ptr:ptr")
    table_push(r, "sk_surface_peek_pixels:void:ptr:pinfo")
    table_push(r, "sk_image_encode_png:ptr:ptr:i64ptr")
    table_push(r, "sk_data_bytes:ptr:ptr")
    table_push(r, "sk_data_write_file:i32:ptr:str")
    table_push(r, "sk_canvas_clear:void:ptr:u32")
    table_push(r, "sk_canvas_draw_line:void:ptr:f64:f64:f64:f64:ppaint")
    table_push(r, "sk_canvas_draw_rect:void:ptr:f64:f64:f64:f64:ppaint")
    table_push(r, "sk_obj_release:void:ptr:i32")
    table_push(r, "sk_flush_std:void")
    table_push(r, "ExitProcess:void:i32")
    return r
}

// 生成单个 extern fn 声明行（tie）。
func gen_extern_line(name: string, fields: table<string>) -> string {
    var line: string = "unsafe extern fn " + name + "("
    var n: i64 = len(fields)
    var i: i64 = 2
    var first: bool = true
    while i < n {
        if first {
            line = line + "p" + to_string(i - 2) + ": " + t_tie(fields[i])
        } else {
            line = line + ", p" + to_string(i - 2) + ": " + t_tie(fields[i])
        }
        first = false
        i = i + 1
    }
    line = line + ") "
    var ret = fields[1]
    if !is_void_tok(ret) {
        line = line + "-> " + t_tie(ret)
    }
    line = line + ";"
    return line
}

// 生成整个绑定模块文本。
func render() -> string {
    var out: string = ""
    out = out + "type tie<data>\n"
    out = out + "// GENERATED by ext/gfx/skia/thunk/gen_thunk.tie -- do not edit by hand.\n"
    out = out + "// tie 侧 thunk 绑定模块（p.6.8.6）：repr(C) 结构 + unsafe extern 声明。\n"
    out = out + "// 探针：`import \"../../ext/gfx/thunk_binding.tie\" as tb` + `using tb;`。\n"
    out = out + "\n"
    out = out + "repr(C) struct TSkPaint {\n"
    out = out + "    var color: u32\n"
    out = out + "    var style: i32\n"
    out = out + "    var antialias: i32\n"
    out = out + "    var stroke_width: f64\n"
    out = out + "}\n"
    out = out + "repr(C) struct TSkImageInfo {\n"
    out = out + "    var width: i32\n"
    out = out + "    var height: i32\n"
    out = out + "    var color_type: i32\n"
    out = out + "    var alpha_type: i32\n"
    out = out + "    var row_bytes: i32\n"
    out = out + "    var pixels: i64\n"
    out = out + "}\n"
    out = out + "\n"
    var reg = registry()
    var n: i64 = len(reg)
    var i: i64 = 0
    while i < n {
        var fields = split_fields(reg[i])
        out = out + gen_extern_line(fields[0], fields)
        out = out + "\n"
        i = i + 1
    }
    return out
}

func has_flag(f: string) -> bool {
    var n: i64 = arg_count()
    var i: i64 = 0
    while i < n {
        if arg_string(i) == f {
            return true
        }
        i = i + 1
    }
    return false
}

// --emit-c：打印 C 头声明片段（人工对照 thunk.h）。
func emit_c() {
    println("--- C header fragment (compare with ext/gfx/skia/thunk/thunk.h) ---")
    println("typedef struct TSkPaint { unsigned color; int style; int antialias; double stroke_width; } TSkPaint;")
    println("typedef struct TSkImageInfo { int width; int height; int color_type; int alpha_type; int row_bytes; void* pixels; } TSkImageInfo;")
    var reg = registry()
    var n: i64 = len(reg)
    var i: i64 = 0
    while i < n {
        var fields = split_fields(reg[i])
        var name = fields[0]
        var ret = fields[1]
        var line: string = ""
        if is_void_tok(ret) {
            line = "void "
        } else {
            line = t_c(ret) + " "
        }
        line = line + name + "("
        var m: i64 = len(fields)
        var k: i64 = 2
        var first: bool = true
        while k < m {
            if first {
                line = line + t_c(fields[k])
            } else {
                line = line + ", " + t_c(fields[k])
            }
            first = false
            k = k + 1
        }
        line = line + ");"
        println(line)
        i = i + 1
    }
    println("--- end ---")
}

var g_out_path: string = "ext/gfx/thunk_binding.tie"

func main() {
    if has_flag("--emit-c") {
        emit_c()
        return
    }
    var txt = render()
    if file_write(g_out_path, txt) {
        println("[gen_thunk.tie] wrote " + g_out_path + " bytes=" + to_string(str_len(txt)))
    } else {
        println("[gen_thunk.tie] ERROR: write failed " + g_out_path)
        exit(1)
    }
}