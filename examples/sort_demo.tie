type tie<logic>
// sort_demo.tie：std/sort 排序数组 + 二分查找演示（D3）
// 覆盖：有序插入（i64/string）、二分命中/未命中、index_of、冒泡排序、空表边界
// library-v2 新接口：sort_*/insert_sorted_* 用 ref 表参数（原地修改，写回调用方），
// contains_*/index_of_* 只读；断言用 assert 泛型 + 逐元素比较。
// 编译运行：cargo run -p tie -- examples/sort_demo.tie

import "../std/sort.tie"
import "../std/assert.tie"

// 比较 i64 表 t 与期望表 vals 是否逐元素相等
func i64_seq_eq(t: table<i64>, vals: table<i64>) -> bool {
    if len(t) != len(vals) {
        return false
    }
    var i: i64 = 0
    while i < len(t) {
        if t[i] != vals[i] {
            return false
        }
        i = i + 1
    }
    return true
}

// 比较字符串表 t 与期望表 vals 是否逐元素相等
func str_seq_eq(t: table<string>, vals: table<string>) -> bool {
    if len(t) != len(vals) {
        return false
    }
    var i: i64 = 0
    while i < len(t) {
        if t[i] != vals[i] {
            return false
        }
        i = i + 1
    }
    return true
}

func main() {
    // ---- 有序插入（i64）----
    // 输入须为升序序列；新值从尾部向前冒泡归位，其余元素相对顺序不变
    var s1: table<i64> = [1,2,3]
    sort.insert_sorted_i64(s1, 0)
    assert.assert(i64_seq_eq(s1, [0,1,2,3]))
    var s2: table<i64> = [1,2,3]
    sort.insert_sorted_i64(s2, 4)
    assert.assert(i64_seq_eq(s2, [1,2,3,4]))
    var s3: table<i64> = [1,3,4]
    sort.insert_sorted_i64(s3, 2)
    assert.assert(i64_seq_eq(s3, [1,2,3,4]))
    var s4: table<i64> = []
    sort.insert_sorted_i64(s4, 5)
    assert.assert(i64_seq_eq(s4, [5]))
    var s5: table<i64> = [2,2,2]
    sort.insert_sorted_i64(s5, 2)
    assert.assert(i64_seq_eq(s5, [2,2,2,2]))
    // 无序输入：仅保证新值归位（0 < 所有元素 → 冒泡到表头），其余相对顺序不变
    var s0: table<i64> = [3,1,2]
    sort.insert_sorted_i64(s0, 0)
    assert.assert(i64_seq_eq(s0, [0,3,1,2]))
    println("insert_sorted_i64: PASS")

    // ---- 有序插入（string）----
    var t1: table<string> = ["apple","orange"]
    sort.insert_sorted_string(t1, "banana")
    assert.assert(str_seq_eq(t1, ["apple","banana","orange"]))
    var t2: table<string> = ["a","c","d"]
    sort.insert_sorted_string(t2, "b")
    assert.assert(str_seq_eq(t2, ["a","b","c","d"]))
    var t3: table<string> = table_new_string()
    sort.insert_sorted_string(t3, "x")
    assert.assert(str_seq_eq(t3, ["x"]))
    var t4: table<string> = ["a","a","c"]
    sort.insert_sorted_string(t4, "a")
    assert.assert(str_seq_eq(t4, ["a","a","a","c"]))
    println("insert_sorted_string: PASS")

    // ---- 二分命中 / 未命中（i64）----
    var bin_i: table<i64> = [1,3,5,7,9]
    assert.assert(sort.contains_i64(bin_i, 5))
    assert.assert(sort.contains_i64(bin_i, 1))
    assert.assert(sort.contains_i64(bin_i, 9))
    assert.assert(!sort.contains_i64(bin_i, 4))
    assert.assert(!sort.contains_i64(bin_i, 0))
    assert.assert(!sort.contains_i64(bin_i, 10))
    assert.assert_eq(sort.index_of_i64(bin_i, 7), 3)
    assert.assert_eq(sort.index_of_i64(bin_i, 1), 0)
    assert.assert_eq(sort.index_of_i64(bin_i, 9), 4)
    assert.assert_eq(sort.index_of_i64(bin_i, 2), -1)
    println("binary search i64: PASS")

    // ---- 二分命中 / 未命中（string）----
    var bin_s: table<string> = ["apple","banana","cherry"]
    assert.assert(sort.contains_string(bin_s, "banana"))
    assert.assert(sort.contains_string(bin_s, "apple"))
    assert.assert(sort.contains_string(bin_s, "cherry"))
    assert.assert(!sort.contains_string(bin_s, "durian"))
    assert.assert(!sort.contains_string(bin_s, "apricot"))
    assert.assert(!sort.contains_string(bin_s, "pear"))
    println("binary search string: PASS")

    // ---- 空表边界（二分）----
    var empty_i: table<i64> = []
    var empty_s: table<string> = table_new_string()
    assert.assert_eq(sort.index_of_i64(empty_i, 5), -1)
    assert.assert(!sort.contains_i64(empty_i, 5))
    assert.assert(!sort.contains_string(empty_s, "x"))
    println("empty boundary: PASS")

    // ---- 无序表排序（i64）----
    var sorted1: table<i64> = [5,2,8,1,9,3]
    sort.sort_i64(sorted1)
    assert.assert(i64_seq_eq(sorted1, [1,2,3,5,8,9]))
    var sorted2: table<i64> = [1,2,3]
    sort.sort_i64(sorted2)
    assert.assert(i64_seq_eq(sorted2, [1,2,3]))
    var sorted3: table<i64> = [3,2,1]
    sort.sort_i64(sorted3)
    assert.assert(i64_seq_eq(sorted3, [1,2,3]))
    var sorted4: table<i64> = []
    sort.sort_i64(sorted4)
    assert.assert(i64_seq_eq(sorted4, []))
    var sorted5: table<i64> = [7,7,7,7]
    sort.sort_i64(sorted5)
    assert.assert(i64_seq_eq(sorted5, [7,7,7,7]))
    println("sort_i64: PASS")

    // ---- 无序表排序（string）----
    var st1: table<string> = ["pear","apple","cherry"]
    sort.sort_string(st1)
    assert.assert(str_seq_eq(st1, ["apple","cherry","pear"]))
    var st2: table<string> = ["banana","apple","banana"]
    sort.sort_string(st2)
    assert.assert(str_seq_eq(st2, ["apple","banana","banana"]))
    var st3: table<string> = table_new_string()
    sort.sort_string(st3)
    assert.assert(str_seq_eq(st3, table_new_string()))
    println("sort_string: PASS")

    // ---- 端到端：排序后插入 + 二分（符号表过渡场景）----
    var ids: table<i64> = [9,3,7,1,5]
    sort.sort_i64(ids)
    sort.insert_sorted_i64(ids, 4)
    assert.assert(i64_seq_eq(ids, [1,3,4,5,7,9]))
    assert.assert_eq(sort.index_of_i64(ids, 7), 4)
    assert.assert(!sort.contains_i64(ids, 8))
    assert.assert(sort.contains_i64(ids, 1))
    println("end-to-end: PASS")

    println("ALL PASS")
}