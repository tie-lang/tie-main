type tie<logic>
// examples/zdpack.tie —— 非平凡应用：zd 容器应力打包器（p.6.1.7 复现场所）
// ============================================================================
// 定位：p.6.1.7（编译器对大程序/大数据路径产崩溃产物）修复后复查与回归的
// **开源复现场所**，替代原闭源 tie-jcc-core 角色。本应用为一套自包含 CLI
// 应力打包器：确定性合成数据集 → 编码/压缩，覆盖家族三形态：
//   * blob    大载荷 zstd 压缩（复现：compress_bytes 大输入挂起）
//   * records n 条长中文文本记录逐条编码累积（复现：长文本记录编码挂起/崩）
//   * array   大扁平表数组编码（对照形态：应正常完成）
// 所有数据合成（确定性）生成，不依赖任何外部/闭源数据；亦可当压缩压测工具用。
// 用法（tie-main 根目录）：
//   tiec examples/zdpack.tie -o examples/zdpack.exe
//   zdpack.exe selfcheck                  三模式小规模自检（读回断言）
//   zdpack.exe stress blob <MB>           合成并压缩大载荷
//   zdpack.exe stress records <n>         合成 n 条长中文记录并编码
//   zdpack.exe stress array <n>           大扁平数组编码（<n> 组 × 9216=万级）
// 说明：std/fs 无二进制写，本工具只打印长度/耗时信号不做落盘。
// ============================================================================
import "../ext/codec/zstd.tie"
import "../std/string.tie" as str

// 确定性伪随机字节（线性同余，可复现；不依赖 std/rnd）
func synth_byte(seed: i64) -> i64 {
    var s = seed * 6364136223846793005 + 1442695040888963407
    if s < 0 {
        s = -s
    }
    return (s >> 33) & 0xFF
}

// 字节表 → 字符串（0..255 码点；string_builder 一次产串，防逐字节 +=）
func b2s(b: table<i64>) -> string {
    var sb = string_builder()
    var i: i64 = 0
    while i < len(b) {
        sb_append(sb, str_from_code(b[i]))
        i = i + 1
    }
    return sb_build(sb)
}

// 合成大载荷：base 重复 + 确定性扰动（MB 整基数 262144 字节）
func synth_blob(mb: i64) -> table<i64> {
    var base = "金铲铲之战识别与计算核心包体测试数据2026-09 万物拟真生存模组数据包:"
    var bl = str_len(base)
    var total = mb * 262144
    var out = table_new_i64()
    var i: i64 = 0
    while i < total {
        table_push(out, str_byte(base, i % bl) + synth_byte(i))
        i = i + 1
    }
    return out
}

// 合成长中文记录段：n 条，每条 "id=<i>|desc=<长中文文本>\n"
func synth_records(n: i64) -> (table<i64>, i64) {
    var desc = str.repeat("锁血运营前中期稳血后期发力阵容独特克制主流环境关键连招资源节奏把控", 40)
    var dl = str_len(desc)
    var body = table_new_i64()
    var total: i64 = 0
    var i: i64 = 0
    while i < n {
        var idtxt = "id=" + to_string(i) + "|desc="
        var k: i64 = 0
        while k < str_len(idtxt) {
            table_push(body, str_byte(idtxt, k))
            k = k + 1
        }
        var m: i64 = 0
        while m < dl {
            table_push(body, str_byte(desc, m))
            m = m + 1
        }
        table_push(body, 10)  // '\n'
        total = total + str_len(idtxt) + dl + 1
        i = i + 1
    }
    return (body, total)
}

// 大扁平数组（万级，65×9216 形态）：对照形态
func synth_array(n: i64) -> table<i64> {
    var out = table_new_i64()
    var g: i64 = 0
    var per: i64 = 9216
    while g < n {
        var k: i64 = 0
        while k < per {
            table_push(out, g * 31 + k)
            k = k + 1
        }
        g = g + 1
    }
    return out
}

// ---------- 模式：大载荷压缩 ----------
func mode_blob(mb: i64) {
    println("[blob] 合成 " + to_string(mb) + "MB 载荷...")
    var blob = synth_blob(mb)
    println("[blob] 载荷字节 " + to_string(len(blob)) + "，开始 zstd 压缩...")
    var comp = zstd.compress(b2s(blob))
    println("[blob] 压缩完成 len=" + to_string(str_len(comp)))
}

// ---------- 模式：长文本记录编码 ----------
func mode_records(n: i64) {
    println("[records] 合成 " + to_string(n) + " 条长中文记录并编码...")
    var (body, total) = synth_records(n)
    println("[records] 编码完成 字节 " + to_string(len(body)) + "（声明 " + to_string(total) + "）")
    var comp = zstd.compress(b2s(body))
    println("[records] 压缩 len=" + to_string(str_len(comp)))
}

// ---------- 模式：大扁平数组（对照） ----------
func mode_array(thousand: i64) {
    println("[array] 合成 " + to_string(thousand * 9216) + " 元素扁平数组（65×9216 形态）...")
    var tab = synth_array(thousand)
    println("[array] 完成 len=" + to_string(len(tab)))
}

// ---------- 自检：三模式小规模读回断言 ----------
func selfcheck() {
    println("[selfcheck] blob 1MB...")
    var blob = synth_blob(1)
    var back = zstd.decompress(zstd.compress(b2s(blob)))
    if str_len(back) != 262144 {
        println("[selfcheck] blob 往返 FAIL len=" + to_string(str_len(back)))
        exit(1)
    }
    println("[selfcheck] records 16 条...")
    var (b1, t1) = synth_records(16)
    if len(b1) != t1 {
        println("[selfcheck] records FAIL len=" + to_string(len(b1)) + " want " + to_string(t1))
        exit(1)
    }
    println("[selfcheck] array 2×9216...")
    var a1 = synth_array(2)
    if len(a1) != 2 * 9216 {
        println("[selfcheck] array FAIL len=" + to_string(len(a1)))
        exit(1)
    }
    println("ZDPACK SELFCHECK OK")
}

// 迷你十进制解析（纯 tie 自包含；返回 -1 表示非法）
func parse_decimal(s: string) -> i64 {
    var v: i64 = 0
    var i: i64 = 0
    while i < str_len(s) {
        var c = str_char(s, i)
        if c == "0" {
            v = v * 10
        } else if c == "1" {
            v = v * 10 + 1
        } else if c == "2" {
            v = v * 10 + 2
        } else if c == "3" {
            v = v * 10 + 3
        } else if c == "4" {
            v = v * 10 + 4
        } else if c == "5" {
            v = v * 10 + 5
        } else if c == "6" {
            v = v * 10 + 6
        } else if c == "7" {
            v = v * 10 + 7
        } else if c == "8" {
            v = v * 10 + 8
        } else if c == "9" {
            v = v * 10 + 9
        } else {
            return -1
        }
        i = i + 1
    }
    return v
}

func main() {
    var nargs = arg_count()
    if nargs < 1 {
        println("用法：zdpack <selfcheck|stress> [blob|records|array] [量]")
        exit(1)
    }
    var cmd = arg_string(0)
    if cmd == "selfcheck" {
        selfcheck()
        return
    }
    if cmd == "stress" && nargs >= 3 {
        var mode = arg_string(1)
        var amt = arg_string(2)
        if mode == "blob" {
            mode_blob(parse_decimal(amt))
            return
        }
        if mode == "records" {
            mode_records(parse_decimal(amt))
            return
        }
        if mode == "array" {
            mode_array(parse_decimal(amt))
            return
        }
    }
    println("用法：zdpack selfcheck | zdpack stress <blob|records|array> <量>")
    exit(1)
}