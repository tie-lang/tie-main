{
  "name": "vscode-tie",
  "displayName": "tie Language Support",
  "description": "tie 语言支持：语法高亮、智能缩进、代码片段 + 语言服务器（诊断 / hover / 跳转定义 / 补全），启动 tie --lsp",
  "version": "0.2.0",
  "publisher": "tie",
  "license": "MIT",
  "icon": "./icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:tie"],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "tie",
        "aliases": ["tie", "tie language"],
        "extensions": [".tie"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tie",
        "scopeName": "source.tie",
        "path": "./syntaxes/tie.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "tie",
      "properties": {
        "tie.lsp.command": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["auto"],
          "description": "启动 tie 语言服务器的命令。默认 'auto'：自动探测 tsp.exe（扩展 vendor/→仓库 compiler/lsp/→PATH），最后回退 ['tie','--lsp']；可设绝对路径如 ['F:/.../tsp.exe']"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && node esbuild.mjs",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.75.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
