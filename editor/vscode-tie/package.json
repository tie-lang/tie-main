{
  "name": "vscode-tie",
  "displayName": "tie Language Support",
  "description": "tie 语言支持：语法高亮、智能缩进、代码片段 + 语言服务器（诊断 / hover / 跳转定义 / 补全），启动 tie --lsp",
  "version": "0.2.0",
  "publisher": "tie",
  "license": "MIT",
  "icon": "./icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:tie"],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "tie",
        "aliases": ["tie", "tie language"],
        "extensions": [".tie"],
        "configuration": "./language-configuration.json"
      }
    ],
    "configurationDefaults": {
      "[tie]": {
        "editor.tokenColorCustomizations": {
          "textMateRules": [
            { "scope": "keyword.control.tie", "settings": { "foreground": "#C586C0" } },
            { "scope": "keyword.operator.tie", "settings": { "foreground": "#D4D4D4" } },
            { "scope": "constant.language.tie", "settings": { "foreground": "#569CD6" } },
            { "scope": "storage.type.tie", "settings": { "foreground": "#4EC9B0" } },
            { "scope": "entity.name.function.tie", "settings": { "foreground": "#DCDCAA" } },
            { "scope": "support.function.builtin.tie", "settings": { "foreground": "#4FC1FF" } },
            { "scope": "support.function.tie", "settings": { "foreground": "#4FC1FF" } },
            { "scope": "entity.name.namespace.tie", "settings": { "foreground": "#FFD700" } },
            { "scope": "support.namespace.tie", "settings": { "foreground": "#FFD700" } },
            { "scope": "entity.name.type.tie", "settings": { "foreground": "#4EC9B0" } },
            { "scope": "variable.declaration.tie", "settings": { "foreground": "#9CDCFE" } },
            { "scope": "variable.parameter.tie", "settings": { "foreground": "#9CDCFE" } },
            { "scope": "variable.other.tie", "settings": { "foreground": "#9CDCFE" } },
            { "scope": "variable.other.member.tie", "settings": { "foreground": "#C8C8C8" } },
            { "scope": "variable.other.property.tie", "settings": { "foreground": "#9CDCFE" } },
            { "scope": "string.quoted.double.tie", "settings": { "foreground": "#CE9178" } },
            { "scope": "string.quoted.single.tie", "settings": { "foreground": "#CE9178" } },
            { "scope": "constant.numeric.tie", "settings": { "foreground": "#B5CEA8" } },
            { "scope": "comment.line.double-slash.tie", "settings": { "foreground": "#6A9955" } },
            { "scope": "comment.block.tie", "settings": { "foreground": "#6A9955" } }
          ]
        }
      }
    },
    "grammars": [
      {
        "language": "tie",
        "scopeName": "source.tie",
        "path": "./syntaxes/tie.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "tie",
      "properties": {
        "tie.lsp.command": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["auto"],
          "description": "启动 tie 语言服务器的命令。默认 'auto'：自动探测 tsp.exe（扩展 vendor/→仓库 compiler/lsp/→PATH），最后回退 ['tie','--lsp']；可设绝对路径如 ['F:/.../tsp.exe']"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && node esbuild.mjs",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^8.1.0"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.75.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  }
}
