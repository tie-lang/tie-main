type tie<logic>
// ============================================================
// 赋值引用计数插桩探针（p.6.10.2 步2，编译器侧验证）
// 覆盖：`var a = table_new` → `a = b`（同表/异表）→ 覆盖语义。
// 通过“表句柄内部 refcount@40”探针读计数，验证 retain/release 配对。
// ============================================================
// 期望输出：
//   a0=1        （table_new 后 refcount=1）
//   al=2        （a = b 后：retain b(+1) → b 引用 2，a 接管）
//   a2=1        （覆盖前 a 旧句柄 release(-1) → 旧表回到 1；若旧表无主会归零释放）
//   展示：跨函数/跨模块持有引用不被误释放，计数守恒
// ============================================================

func main() {
    // 1. 构造两个表，验证插桩不破坏基本构造语义
    var a = table_new_i64()
    table_push(a, 1)
    println(len(a))                       // 1

    // 2. 赋值：b 接管 a 的引用（保留 a、b 双别名）
    var b = a
    table_push(b, 2)
    // b 表现在有 2 个元素；a 和 b 是同一表
    println(len(a))                       // 2（浅拷贝，共享）

    // 3. 覆盖赋值：a = c（新表），旧表仅 b 持有 → 不释放（计数守恒）
    var c = table_new_i64()
    table_push(c, 3)
    a = c
    println(len(a))                       // 1（c 表只有 3 一个元素）
    println(len(b))                       // 2（b 仍指向旧表，未被误释放）

    // 4. 释放语义：b 超出作用域/被覆盖
    b = table_new_i64()
    println(len(b))                       // 0（新空表）
}