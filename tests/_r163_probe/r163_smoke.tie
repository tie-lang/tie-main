type tie<logic>
// r.1.6.3 交叉冒烟探针（待 CI，Windows 仅验证 IR/链接阶段）：
//   exec_output / exec_code / cwd / get_env / set_env / arg_count / arg_string
//   / read_line / stdin_read / stdout_write_str / stdout_write_bytes
// 编译：tiec tests/_r163_probe/r163_smoke.tie --target linux-x64 --emit-ir
// 检查：--emit-ir 产物不得含 Win32 符号（CreateProcessW/CommandLineToArgvW/
// GetEnvironmentVariableW/GetCurrentDirectoryW/SetEnvironmentVariableW/
// GetStdHandle/ReadFile/WriteFile）；应含 POSIX 符号（pipe/fork/dup2/execl/
// waitpid/getcwd/setenv/read/write）。
func main() {
    var o1 = exec_output("echo hello-r163")
    print("exec_output len=")
    println(to_string(str_len(o1)))
    var c0 = exec_code("true")
    print("exec_code=")
    println(to_string(c0))
    var wd = cwd()
    print("cwd len=")
    println(to_string(str_len(wd)))
    set_env("TIE_R163_VAR", "r163-val")
    var ev = get_env("TIE_R163_VAR")
    print("env=")
    println(ev)
    var n = arg_count()
    print("argc=")
    println(to_string(n))
    var a0 = arg_string(0)
    print("arg0=")
    println(a0)
    var line = read_line()
    print("line len=")
    println(to_string(str_len(line)))
    var nb = stdin_read(4)
    print("bytes=")
    println(to_string(len(nb)))
    var w1 = stdout_write_str("out-str\n")
    print("wstr=")
    println(to_string(w1))
    var tb: table<i64> = []
    var w2 = stdout_write_bytes(tb)
    print("wbytes=")
    println(to_string(w2))
    exit(0)
}
