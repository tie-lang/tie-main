type tie<logic>
// tests/_p725_probe/reg_probe.tie —— Keel 龙骨 p.7.2.5 registry 包注册中心探针
// ============================================================
// 里程碑：2026.2 路线图 p.7.2.5「包注册中心 registry 起步」。
// 验收：registry 目录结构 + 三操作（publish/info/versions）探针全过；
//       zd 发布单元可经 zdpub.load 指纹核验（篡改拒绝语义来自 p.7.1.4）。
// 断言：
//   1) publish v1.0.0 + v1.1.0（同一包两个版本）返回 0；
//   2) versions 返回 2 且顺序升序（v1.0.0 → v1.1.0）；
//   3) info 打印最新版本元数据（version=v1.1.0、description 非空）并返回 0；
//   4) 发布单元 pkg.zd 指纹一致：zdpub.load 返回 0；
//   5) 负例：源文件不存在 publish 返回 -1；空名 publish 返回 -1；
//      未发布包 info/versions 返回 -1。
// 全过打印「registry p.7.2.5 自检通过」exit 0；任一失败 exit 1。
//
// # import 说明（语言边界）
// 探针只 import keel_registry_cli.tie（其链式引 zdpub → tdzd/config/
// zdwrite + std/tsha1）；不单独 re-import tsha1，避免依赖顺序歧义。
import "../../compiler/keel/keel_registry_cli.tie"

var fails: i64 = 0

func check(cond: bool, msg: string) {
    if cond {
        println("PASS " + msg)
    } else {
        println("FAIL " + msg + "（" + keelpkg.err_msg() + "）")
        fails = fails + 1
    }
}

func main() {
    // 独立注册根（探针私有目录，运行后由工具清理）
    var reg = "tests/_p725_probe/.tie-registry"
    if file_exists(reg) || file_is_dir(reg) {
        var _r = remove_dir_all(reg)
    }
    keelpkg.set_root(reg)

    // 1) publish 两个版本
    var r1 = keelpkg.publish("Demo", "1.0.0", "tests/_p725_probe/demo_v1.data.tie", "first version")
    check(r1 == 0, "publish demo v1.0.0 返回 0")
    var r2 = keelpkg.publish("demo", "1.1.0", "tests/_p725_probe/demo_v2.data.tie", "second version")
    check(r2 == 0, "publish demo v1.1.0 返回 0")

    // 2) versions：2 个版本，升序
    var vc = keelpkg.versions("demo")
    check(vc == 2, "versions 返回 2（实际 " + to_string(vc) + "）")

    // 3) info：最新版本元数据
    var ri = keelpkg.info("demo")
    check(ri == 0, "info demo 返回 0")

    // 4) 发布单元指纹一致（zdpub.load 核验 v1.0.0 的 .zd + .fp）
    var zdp = reg + "\\demo\\1.0.0\\pkg.zd"
    var rl = zdpub.load(zdp)
    check(rl == 0, "zdpub.load(pkg.zd) 指纹一致返回 0")

    // 5) 负例
    var rn1 = keelpkg.publish("demo", "1.2.0", "tests/_p725_probe/no_such.data.tie", "x")
    check(rn1 == -1, "源文件不存在 publish 返回 -1")
    var rn2 = keelpkg.publish("!!!", "1.0.0", "tests/_p725_probe/demo_v1.data.tie", "x")
    check(rn2 == -1, "空包名 publish 返回 -1")
    var rn3 = keelpkg.info("unknown_pkg")
    check(rn3 == -1, "未发布包 info 返回 -1")
    var rn4 = keelpkg.versions("unknown_pkg")
    check(rn4 == -1, "未发布包 versions 返回 -1")

    // registry 目录结构快照（根/包/版本层级）
    var d1 = file_is_dir(reg + "\\demo")
    var d2 = file_is_dir(reg + "\\demo\\1.0.0")
    var d3 = file_exists(reg + "\\demo\\1.0.0\\pkg.zd")
    var d4 = file_exists(reg + "\\demo\\1.0.0\\pkg.zd.fp")
    var d5 = file_exists(reg + "\\demo\\1.0.0\\info.td")
    var d6 = file_exists(reg + "\\demo\\index.td")
    check(d1 && d2 && d3 && d4 && d5 && d6, "registry 目录结构就位（根/包/版本 + .zd/.fp/info.td/index.td）")

    if fails > 0 {
        println("registry p.7.2.5 自检失败 total=" + to_string(fails))
        exit(1)
    }
    println("registry p.7.2.5 自检通过")
}