type tie<logic>
import "../../ext/tls/tool.tie" as tbt
import "../../ext/tls/der.tie" as der

var fails: i64 = 0
func t(cond: bool, msg: string) {
    if cond == false {
        fails = fails + 1
        println("FAIL: " + msg)
    }
}
func is_time(n: i64) -> bool {
    var tg: i64 = der.tag_at(n)
    return tg == 0x17 || tg == 0x18   // UTCTime / GeneralizedTime
}

func main() {
    // Self-signed RSA-2048 cert (openssl req -x509, DER form) - the full hex.
    var hex = ""
    var bs = tbt.hex_to_bytes(hex)
    var root = der.parse(bs)
    t(root >= 0, "root parse ok")
    if root < 0 {
        println("FAIL parse returned -1")
        return
    }

    // root SEQUENCE with exactly 3 children (tbs / sigAlg / sigValue)
    t(der.tag_at(root) == 0x30, "root tag SEQUENCE(0x30) got " + to_string(der.tag_at(root)))
    t(der.is_constructed(root), "root is constructed")
    t(der.child_count(root) == 3, "root has 3 children got " + to_string(der.child_count(root)))

    var tbs = der.child(root, 0)
    t(der.tag_at(tbs) == 0x30, "child0 tbs is SEQUENCE")
    t(der.is_constructed(tbs), "tbs is constructed")

    // tbs contains version (context [0]) and serial (INTEGER) and it is constructed
    var ver = der.find_first(tbs, 0xA0)
    t(ver >= 0, "tbs contains version context[0] A0")
    t(der.is_constructed(ver), "version is constructed")
    t(der.value_len(ver) == 3, "version content len 3 got " + to_string(der.value_len(ver)))
    var serial = der.find_first(tbs, 0x02)
    t(serial >= 0 && der.tag_at(serial) == 0x02, "tbs contains serial INTEGER")
    t(der.value_len(serial) == 20, "serial len 20 got " + to_string(der.value_len(serial)))
    var sval = der.value_at(serial)
    t(len(sval) == 20, "serial value_at length 20")

    // validity: a SEQUENCE of two time nodes (UTCTime/GeneralizedTime tag)
    var vald: i64 = -1
    var i: i64 = 0
    while i < der.child_count(tbs) {
        var c = der.child(tbs, i)
        if der.tag_at(c) == 0x30 && der.child_count(c) == 2 &&
           is_time(der.child(c, 0)) == true && is_time(der.child(c, 1)) == true {
            vald = c
        }
        i = i + 1
    }
    t(vald >= 0, "validity found as two-time SEQUENCE")
    t(der.is_constructed(vald), "validity is SEQUENCE")
    var t1: i64 = der.tag_at(der.child(vald, 0))
    var t2: i64 = der.tag_at(der.child(vald, 1))
    t((t1 == 0x17 || t1 == 0x18) && (t2 == 0x17 || t2 == 0x18), "validity time tags are UTCTime/GeneralizedTime")

    // SPKI: a SEQUENCE holding an algorithm SEQUENCE and a BIT STRING
    var spki: i64 = -1
    var j: i64 = 0
    while j < der.child_count(tbs) {
        var c2 = der.child(tbs, j)
        if der.tag_at(c2) == 0x30 && der.find_first(c2, 0x03) >= 0 && der.find_first(c2, 0x30) >= 0 {
            spki = c2
        }
        j = j + 1
    }
    t(spki >= 0, "SPKI found as child of tbs")
    t(der.find_first(spki, 0x30) >= 0, "SPKI holds algorithm SEQUENCE")
    var sp_bit = der.find_first(spki, 0x03)
    t(sp_bit >= 0 && der.tag_at(sp_bit) == 0x03, "SPKI holds BIT STRING (0x03)")
    t(der.is_constructed(sp_bit) == false, "SPKI BIT STRING is primitive")
    t(der.value_len(sp_bit) == 271, "SPKI BIT STRING content len 271 got " + to_string(der.value_len(sp_bit)))

    // signature value: child2 of root is the BIT STRING
    var sig = der.child(root, 2)
    t(sig >= 0 && der.tag_at(sig) == 0x03, "root child2 is signature BIT STRING")
    t(der.is_constructed(sig) == false, "signature is primitive")
    t(der.value_len(sig) == 257, "signature content len 257 got " + to_string(der.value_len(sig)))
    var sigalg = der.child(root, 1)
    t(sigalg >= 0 && der.tag_at(sigalg) == 0x30, "root child1 is signature algorithm SEQUENCE")

    if fails == 0 {
        println("PASS der cert TLV assertions")
    } else {
        println("FAIL (assertions above)")
    }
}
