type tie<logic>
// p.6.1.8 聚焦探针：struct 表字段赋值引用计数验证。
// 场景：make() 从局部表填 S 字段并返回；调用方随后多次读写该表。
// 修复前（无 retain）：返回时源局部 release 到 0 → 字段悬垂 → 使用即崩/数据损坏。
struct S {
    var id: i64 = 0
    var t: table<i64> = table_new_i64()
}

func make(v: i64) -> S {
    var tab = table_new_i64()
    var i: i64 = 0
    while i < 1000 {
        table_push(tab, v * 1000 + i)
        i = i + 1
    }
    var s = S()
    s.id = v
    s.t = tab
    return s
}

func main() {
    var a = make(1)
    var b = make(2)
    // 返回后多次读字段表（悬垂时崩溃/错值）
    var sum: i64 = 0
    var i: i64 = 0
    while i < 1000 {
        sum = sum + a.t[i]
        sum = sum + b.t[i]
        i = i + 1
    }
    println("sum=" + to_string(sum))
    // a=make(1): t[i]=1000+i → 1000*1000 + 0..999 之和 = 1499500；
    // b=make(2): t[i]=2000+i → 2000*1000 + 0..999 之和 = 2499500；总计 3999000。
    if sum == 1499500 + 2499500 {
        println("PASS field-table refcount")
    } else {
        println("FAIL sum mismatch")
    }
}