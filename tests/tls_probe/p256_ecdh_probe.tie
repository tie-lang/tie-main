type tie<logic>
// p256_ecdh_probe.tie：p.6.1.8 遗留——P-256 ECDH 向量探针（ext/tls/p256.tie）。
// 向量：openssl 3.6.1 ecparam -name prime256v1 -genkey + pkeyutl -derive 确定性生成
// （私钥 dA/dB、公钥 pbA/pbB、共享 Z = dA×pbB = dB×pbA）。
// 断言：
//   1) pubkey(dA) == pbA；pubkey(dB) == pbB
//   2) dh(dA, pbB) == Z（大端共享 x 坐标 32 字节）
//   3) dh(dB, pbA) == Z（ECDH 对称性）
//   4) 篡改对端点 → 失败（空表）
import "../../ext/tls/p256.tie" as p256
import "../../ext/tls/tool.tie" as tbt

var dA: string = "4036f83ce4e056eac3af7fe97eaacd1472dbb8585b22e99ab24b7344e19deb0f"
var dB: string = "2c53fe83b33a1cda689a40c366ff6c2aa8fe8fc2c3b28eb9e533a23e66212875"
var pbA_hex: string = "041ebe653d9d2ac147e4e25a3f567e1c513ae4b5f3d1d5404719d352b0a5965f5da22677ae5c3ff6cda8719eff959f40aa25e56e7e4cf3ff32e45fb974d3fa9930"
var pbB_hex: string = "04fdfdba9fe11c39194972cd5e1a87e24ac5a05ecf638d8c1c452813a2419fcb24144b989fc6a95fbb2f2f2adf54a7488f56f21dd39cdd6172c17ecd256644db93"
var Z_hex: string = "3b9c4e629cd58ee1f653314c222ff1013235e4f2603fef44c0eca1f501e1e9eb"

func chk_hex(name: string, got_hex: string, want_hex: string) {
    if got_hex == want_hex {
        println("PASS " + name)
    } else {
        println("FAIL " + name + " got=" + got_hex + " want=" + want_hex)
        exit(1)
    }
}

func main() {
    // 1) 公钥导出
    chk_hex("pubkey(dA)", tbt.bytes_to_hex(p256.pubkey(dA)), pbA_hex)
    chk_hex("pubkey(dB)", tbt.bytes_to_hex(p256.pubkey(dB)), pbB_hex)

    // 2) ECDH 主方向
    var z1 = p256.dh(dA, tbt.hex_to_bytes(pbB_hex))
    chk_hex("dh(dA,pbB)", tbt.bytes_to_hex(z1), Z_hex)

    // 3) 对称性
    var z2 = p256.dh(dB, tbt.hex_to_bytes(pbA_hex))
    chk_hex("dh(dB,pbA)", tbt.bytes_to_hex(z2), Z_hex)

    // 4) 篡改/非法输入 → 失败哨兵（空表）
    var bad_hex: string = "04"
    var bi: i64 = 0
    while bi < 64 {
        bad_hex = bad_hex + "00"
        bi = bi + 1
    }
    var bad = p256.dh(dA, tbt.hex_to_bytes(bad_hex))
    if len(bad) == 0 {
        println("PASS dh-bad-point-rejected")
    } else {
        println("FAIL dh-bad-point-rejected len=" + to_string(len(bad)))
        exit(1)
    }
    var zkey_hex: string = ""
    bi = 0
    while bi < 32 {
        zkey_hex = zkey_hex + "00"
        bi = bi + 1
    }
    var bad2 = p256.dh(zkey_hex, tbt.hex_to_bytes(pbB_hex))
    if len(bad2) == 0 {
        println("PASS dh-zero-key-rejected")
    } else {
        println("FAIL dh-zero-key-rejected")
        exit(1)
    }
    var bad3 = p256.dh(dA, tbt.hex_to_bytes(pbB_hex))
    if len(bad3) == 32 {
        println("PASS dh-len-32")
    } else {
        println("FAIL dh-len-32 len=" + to_string(len(bad3)))
        exit(1)
    }

    println("p256 ECDH 探针全部通过")
}