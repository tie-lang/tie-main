type tie<logic>
// tests/_p67_probe/wg_par_probe.tie —— p.6.7.11 验收：结构化并发 WaitGroup（简单形态）。
// 无任何 import（纯内置）：wg_new/wg_add/wg_done/wg_wait（Go sync.WaitGroup 语义，
// trm_lite_wg$* 静态链接）。
// 场景：3 波 × 4 组 × 8 任务并发 wg_done——每任务把自编码（g 组 × 1000 + i）push
// 共享表 + wg_done(组句柄)；主线程 wg_wait(组) 等各组归零后校验。
// 断言：
//   1) wg_wait 返回后每组任务全部完成（len 精确 96、无重复、区间合法）
//   2) 自编码分组和精确（3 波：Σg*8*1000*3 + Σi*4*3 = 144000 + 336）
//   3) 3 波结果一致（波间状态独立）
// 期望：len=96 sum=9744336 精确 PASS / exit 0；连跑 3 次全 PASS。
var g_data: table<i64> = []
var g_wg_acc: i64 = 0

func main() {
    var ok: i64 = 1
    var wave: i64 = 0
    while wave < 3 {
        var g: i64 = 0
        while g < 4 {
            var h = wg_new()
            wg_add(h, 8)
            var i: i64 = 0
            while i < 8 {
                // 闭包按槽捕获：循环变量/句柄须逐迭代固化到新局部（否则迭代间共享
                // 槽位 → wg_done 落错句柄 → wg_wait 永不归零挂死）
                var wv = wave
                var gv = g
                var iv = i
                var hv = h
                spawn(func() -> i64 {
                    var w: i64 = gv * 1000 + iv
                    var f: i64 = 0
                    while f < 20000 {
                        w = (w * 3 + f) % 1000003
                        f = f + 1
                    }
                    table_push(g_data, wv * 100000 + gv * 1000 + iv)
                    wg_done(hv)
                    return w
                })
                i = i + 1
            }
            wg_wait(h)
            g = g + 1
        }
        wave = wave + 1
    }
    // 校验：len、区间、重复、分组和
    var L = len(g_data)
    var bad: i64 = 0
    var i: i64 = 0
    while i < L {
        if g_data[i] < 0 || g_data[i] >= 400000 {
            bad = 1
        }
        i = i + 1
    }
    var dup: i64 = 0
    i = 0
    while i < L && dup == 0 {
        var j = i + 1
        while j < L {
            if g_data[i] == g_data[j] {
                dup = 1
            }
            j = j + 1
        }
        i = i + 1
    }
    var sum: i64 = 0
    i = 0
    while i < L {
        sum = sum + g_data[i]
        i = i + 1
    }
    // 期望：波权重 Σwave*100000*32 + Σg*8*1000*3 + Σi*4*3 = 9600000 + 144000 + 336
    var expect: i64 = 9600000 + 144336
    println("len=" + to_string(L) + " dup=" + to_string(dup) + " bad=" + to_string(bad) + " sum=" + to_string(sum) + " expect=" + to_string(expect))
    if L != 96 || dup != 0 || bad != 0 || sum != expect {
        ok = 0
    }
    if ok == 1 {
        println("PASS")
    } else {
        println("FAIL")
    }
    println("done")
}