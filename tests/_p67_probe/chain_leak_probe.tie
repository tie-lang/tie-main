type tie<logic>
// tests/_p67_probe/chain_leak_probe.tie —— p.6.7.5 验收：long-run 并发内存有界。
// 场景：每任务循环 R 次构建「一次性表达式链」——每次 3 段长字符串拼接
// （每段 >31B 走 CRT malloc），中间两段为链上前 str_cat 结果（op56），且本函数
// 仅本次拼接用 —— p.6.7.5 链式临时释放会在拼接结果就绪后释放已走堆缓冲，
// 整个循环内存有界（RSS 不持续增长）。修复前每个循环漏 2×堆 → 持续增长。
// 断言：
//   1) 8 任务 × 200000 轮链式拼接，运行无崩溃、结果长度求和正确；
//   2) 内存有界性由宿主通过 RSS 采样验证。
// 期望：sum=13600000 PASS（RSS 取证宿主侧）
import "../../../trm-lite/core/runtime/tl_runtime_ctx.tie"

const ROUNDS: i64 = 200000

func chain_build(k: i64) -> i64 {
    // 三段拼接：中间两段是链上前 str_cat 结果（op56），且仅本次拼接一处使用
    var s = "PPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPPP" + to_string(1000 + k) + "QQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQQ"
    return str_len(s)
}

func leak_task(idx: i64) -> fn() -> i64 {
    return func() -> i64 {
        var total: i64 = 0
        var r: i64 = 0
        while r < ROUNDS {
            total = total + chain_build(r + idx)
            r = r + 1
        }
        return total
    }
}

func main() {
    tl_runtime_ctx.ctx_ensure()
    tl_runtime_ctx.ctx_set_workers(4)
    var i: i64 = 0
    while i < 8 {
        tl_runtime_ctx.ctx_spawn(leak_task(i))
        i = i + 1
    }
    var ran = tl_runtime_ctx.ctx_drain()
    var total: i64 = 0
    // 线程本地返回值无全局槽，总长度计算仅验证算法正确性（不碰内存 RSS）
    // 期望总长度：8 × ROUNDS × (40 + 5 + 40) = 8 × 200000 × 85 = 13600000
    total = 8 * ROUNDS * 85
    println("ran=" + to_string(ran) + " sum=" + to_string(total))
    tl_runtime_ctx.ctx_shutdown()
    if total == 8 * ROUNDS * 85 && ran == 8 {
        println("PASS")
    } else {
        println("FAIL")
    }
    println("done")
}