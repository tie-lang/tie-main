type tie<logic>
// tests/_p67_probe/s_deque_probe.tie —— p.6.7.7 验收：简单形态窃取队列（S-deque）。
// 无任何 import（纯内置）：spawn 投递 → 常驻 worker per-worker 双端队列并行抢执行
// （owner 段尾 LIFO / 他人段头 FIFO 窃取 / 段满溢出全局，复刻 sched_ws 独立实现）；
// yield = 同步点（等 pend==0）。
// 场景：
//   A) 失衡负载：1 个「制造者」任务内 spawn 600 子任务（成本异构：i%6==0 重载
//      ~300K 迭代、其余轻载）——重载任务拖慢其本段 owner，轻载 worker 段先排空 →
//      窃取路径大概率触发（stolen>0 观察量）；每子任务共享表 push 自编码 id + 独立
//      槽位记执行线程 tid。
//   B) 池复用：批次 A yield 排空后，再从主线程 spawn 300 轻任务批次（复用常驻池，
//      gate=1 不再重建线程）。
//   C) 完整性：共享表 len 精确（600+300=900）、id 区间合法、两两无重复。
//   D) 同步点：yield 返回后全部任务已跑完（len 恰 900）。
// 断言（spec §4 二元验收）：stolen>0 或 子任务执行线程 tid 覆盖 ≥2；且结果全对。
// 期望：stolen>0 / tid≥2 / len=900 dup=0 bad=0 / PASS / exit 0；连跑 3 次全 PASS。

var g_push: table<i64> = []     // 共享表：每子任务 push 自编码 id（每表锁并发安全）
var g_tid: table<i64> = []      // 每子任务执行线程 tid（独立槽位，S2 模式）
var g_sub_cur: i64 = 0          // 子任务 id 分发（仅制造者串行自增，单生产者时段）

unsafe extern fn GetCurrentThreadId() -> i64
unsafe extern fn stolen_count_s() -> i64

func tid_now() -> i64 {
    unsafe {
        return GetCurrentThreadId()
    }
}

// 重载填充（结果写临终槽防死代码消除）。
func filler(h: i64) -> i64 {
    var w: i64 = h
    var f: i64 = 0
    while f < 300000 {
        w = (w * 7 + f) % 1000000007
        f = f + 1
    }
    return w
}

// 制造者任务：spawn n 个子任务（id 自 g_sub_cur 起串行分发）。
// hv=1 → 子任务成本异构（i%6==0 重载，拖慢本段 owner → 刺激窃取）。
func make_producer(n: i64, hv: i64) -> fn() -> i64 {
    return func() -> i64 {
        var i: i64 = 0
        while i < n {
            var id = g_sub_cur
            g_sub_cur = g_sub_cur + 1
            var is_heavy: i64 = 0
            if hv == 1 && (i % 6) == 0 {
                is_heavy = 1
            }
            spawn(func() -> i64 {
                var w: i64 = id
                if is_heavy == 1 {
                    w = filler(w)
                }
                table_push(g_push, id)
                g_tid[id] = tid_now()
                return w
            })
            i = i + 1
        }
        return n
    }
}

// 主线程批次：直接 spawn n 个轻任务（池复用验证）。
func push_batch(n: i64) {
    var i: i64 = 0
    while i < n {
        var id = g_sub_cur
        g_sub_cur = g_sub_cur + 1
        spawn(func() -> i64 {
            table_push(g_push, id)
            g_tid[id] = tid_now()
            return id
        })
        i = i + 1
    }
}

func main() {
    // 预分配 tid 槽（900 子任务 + 余量）
    var i: i64 = 0
    while i < 1000 {
        table_push(g_tid, 0)
        i = i + 1
    }
    // 批次 A：失衡负载（制造者 + 600 异构子任务）
    spawn(make_producer(600, 1))
    yield()
    // 批次 B：主线程 300 轻任务（池复用）
    push_batch(300)
    yield()

    var n = len(g_push)
    // 区间校验：id ∈ [0,900) 且 批次 A <600、批次 B ≥600
    var bad: i64 = 0
    i = 0
    while i < n {
        var v = g_push[i]
        if v < 0 || v >= 900 {
            bad = 1
        }
        i = i + 1
    }
    // 两两去重（900²≈810K 次）
    var dup: i64 = 0
    i = 0
    while i < n && dup == 0 {
        var j = i + 1
        while j < n {
            if g_push[i] == g_push[j] {
                dup = 1
            }
            j = j + 1
        }
        i = i + 1
    }
    // tid 去重（真并行/多 worker 证据）
    var tid_set: i64 = 0
    i = 0
    while i < 900 {
        var seen: i64 = 0
        var j2: i64 = 0
        while j2 < i {
            if g_tid[j2] == g_tid[i] && g_tid[i] != 0 {
                seen = 1
            }
            j2 = j2 + 1
        }
        if seen == 0 && g_tid[i] != 0 {
            tid_set = tid_set + 1
        }
        i = i + 1
    }
    var stolen: i64 = 0
    unsafe {
        stolen = stolen_count_s()
    }
    println("stolen=" + to_string(stolen) + " tid_set=" + to_string(tid_set) + " len=" + to_string(n) + " dup=" + to_string(dup) + " bad=" + to_string(bad))
    var ok: i64 = 1
    if n != 900 || dup != 0 || bad != 0 || tid_set < 2 {
        ok = 0
    }
    if ok == 1 {
        println("PASS")
    } else {
        println("FAIL")
    }
    println("done")
}