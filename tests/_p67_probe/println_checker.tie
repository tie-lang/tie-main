type tie<logic>
// tests/_p67_probe/println_checker.tie —— p.6.7.4 验收：并发 println 输出行校验。
// 读 tests/_p67_probe/println_out.txt，逐行校验：
//   1) 总行数 == 400（无丢失/无重复行）
//   2) 每行定长 47：'T' + 任务位(0-7) + ':' + 序号位(100-149) + ':' + 40×'X' 负载
// 撕裂/合并/截断 → 长度或内容不匹配即检出。
// 期望：lines=400 ok=400 / PASS / exit 0
var g_fname: string = "tests/_p67_probe/println_out.txt"

func all_x(s: string) -> bool {
    var i: i64 = 0
    var ok: i64 = 1
    var n = str_len(s)
    while i < n {
        if str_char(s, i) != "X" {
            ok = 0
        }
        i = i + 1
    }
    return ok == 1
}

func main() {
    var raw = file_read(g_fname)
    var L = str_len(raw)
    var task_lines: i64 = 0
    var ok: i64 = 0
    var per_ok: i64 = 0
    var pos: i64 = 0
    while pos < L {
        // 找行尾 '\n'
        var e = pos
        while e < L && str_char(raw, e) != "\n" {
            e = e + 1
        }
        var line_end = e
        if line_end > pos && str_char(raw, line_end - 1) == "\r" {
            line_end = line_end - 1   // Windows CRLF：剥 \r
        }
        var line = str_sub_bytes(raw, pos, line_end)
        if str_len(line) > 0 {
            if str_char(line, 0) == "T" {
                task_lines = task_lines + 1
            }
        }
        var nl = str_len(line)
        var this_ok: i64 = 0
        if nl == 47 {
            var c0 = str_char(line, 0)
            var c1 = str_char(line, 1)
            var c2 = str_char(line, 2)
            var cd = str_char(line, 3)
            var c6 = str_char(line, 6)
            var seq_s = str_sub_bytes(line, 3, 6)   // 序号 "1xx"
            var payload = str_sub_bytes(line, 7, 47) // 常数 40
            var seq = parse_int(seq_s)
            var k: i64 = 0
            if c1 == "0" { k = 0 } else if c1 == "1" { k = 1 } else if c1 == "2" { k = 2 }
            else if c1 == "3" { k = 3 } else if c1 == "4" { k = 4 } else if c1 == "5" { k = 5 }
            else if c1 == "6" { k = 6 } else if c1 == "7" { k = 7 } else { k = -1 }
            if c0 == "T" && c2 == ":" && cd == "1" && c6 == ":" && k >= 0 && seq >= 100 && seq <= 149 && all_x(payload) {
                this_ok = 1
            }
        }
        if this_ok == 1 {
            per_ok = per_ok + 1
        }
        pos = e + 1
    }
    if task_lines == 400 && per_ok == 400 {
        ok = 1
    }
    println("task_lines=" + to_string(task_lines) + " per_line_ok=" + to_string(per_ok))
    if ok == 1 {
        println("PASS")
    } else {
        println("FAIL")
    }
    println("done")
}