type tie<logic>
// r.1.6.4 交叉冒烟探针（Windows 实机 + Linux IR/CI 双用途）：
//   TCP 回环（listen→connect→accept→send/recv→send_bytes/recv_bytes→close）
//   与 UDP 回环（bind→send/recv→send_bytes/recv_bytes→close），127.0.0.1。
// 编译：tiec tests/_r164_probe/r164_smoke.tie --target linux-x64 --emit-ir
// 检查（--emit-ir 产物）：不得含 Winsock2 符号（WSAStartup/WSAGetLastError/
// gethostbyname 视平台/closesocket）；应含 POSIX socket 符号（socket/connect/
// bind/listen/accept/send/recv/sendto/recvfrom/gethostbyname/close）。
func main() {
    // TCP 回环
    var ls = net_tcp_listen(19235)
    println("tcp_listen=" + to_string(ls))
    var cl = net_tcp_connect("127.0.0.1", 19235)
    println("tcp_connect=" + to_string(cl))
    if ls >= 0 && cl >= 0 {
        var acc = net_tcp_accept(ls)
        println("tcp_accept=" + to_string(acc))
        var w = net_tcp_send(cl, "ping-r164")
        println("tcp_send=" + to_string(w))
        var r = net_tcp_recv(acc, 64)
        println("tcp_recv=" + r)
        var wb = net_tcp_send_bytes(cl, [112, 111, 110, 103])  // "pong"
        println("tcp_send_bytes=" + to_string(wb))
        var rb = net_tcp_recv_bytes(acc, 64)
        println("tcp_recv_bytes_len=" + to_string(len(rb)))
        println("tcp_close_acc=" + to_string(net_close(acc)))
        println("tcp_close_cl=" + to_string(net_close(cl)))
    }
    println("tcp_close_ls=" + to_string(net_close(ls)))
    // UDP 回环（同 socket 发自身回环地址）
    var ub = net_udp_bind(19236)
    println("udp_bind=" + to_string(ub))
    var us = net_udp_send(ub, "127.0.0.1", 19236, "udp-r164")
    println("udp_send=" + to_string(us))
    var ur = net_udp_recv(ub, 64)
    println("udp_recv=" + ur)
    var usb = net_udp_send_bytes(ub, "127.0.0.1", 19236, [117, 100, 112])  // "udp"
    println("udp_send_bytes=" + to_string(usb))
    var urb = net_udp_recv_bytes(ub, 64)
    println("udp_recv_bytes_len=" + to_string(len(urb)))
    println("udp_close=" + to_string(net_close(ub)))
    exit(0)
}