type tie<class>
// tests/_r151_probe/r151_string_abi.tie —— r.1.5.1 tie string 跨 FFM 返回 ABI 探针
// ============================================================
// 目的：验证 tie string 跨 DLL 边界的返回布局（{ptr,len} 单指针表示）：
//   返回符号：namespace::func → r151$func（dllexport，pub func）。
//   返回值  ：单个 ptr = UTF-8 数据指针（Win64 RAX）；
//             长度头 i64（小端）位于数据指针 -8；数据尾 NUL（边界自动）。
// 由同目录 R151StringAbiProbe.java（Java 25 FFM MethodHandle downcall）消费断言。
//
// 探针集：
//   ascii       短 ASCII 字面量（.rodata 静态）
//   chinese     中文 UTF-8 多字节（.rodata 静态，验证字节数 ≠ 码点数）
//   binary      内嵌 \0 / \t 的二进制字节串（验证以长度头为准、二进制安全）
//   empty       空串（长度头 = 0，数据指针非 null）
//   concat_long 运行时拼接 >31 字节（str_cat → tie_sso_alloc → malloc 堆路径）
//   version     Mantle p.0.1 冒烟曾以 i64 版本码替代的函数（现在真返回 string）
//
// 编译（r.1 轨，compiler\tiec.exe）：
//   compiler\tiec.exe tests\_r151_probe\r151_string_abi.tie --shared -o tests\_r151_probe\r151_string_abi.dll
// 仅 library 角色（无 main），--shared 触发动态库模式。

namespace r151 {

pub func ascii() -> string {
    return "Hello, tie!"
}

pub func chinese() -> string {
    return "你好，tie 世界！"
}

// 内嵌 NUL 与制表符的二进制字节串：字面量 \0 转义在 r.1 管线中会丢 NUL
//（见 _tmp_fix_146/nul_probe 实测），故用 string_builder + sb_append_byte 在
// 运行时构造（sb_append_byte 二进制安全含 \0）——长度头为准、二进制安全
pub func binary() -> string {
    var sb = string_builder()
    sb_append_byte(sb, 65)  // 'A'
    sb_append_byte(sb, 0)   // NUL（0x00）
    sb_append_byte(sb, 66)  // 'B'
    sb_append_byte(sb, 9)   // TAB（0x09）
    sb_append_byte(sb, 67)  // 'C'
    return sb_build(sb)
}

pub func empty() -> string {
    return ""
}

// 运行时拼接 50 字节（>31 走 malloc 堆路径，非 .rodata）：
// 链式 str_cat 全为临时值，最终返回串不被 tie 运行时释放
pub func concat_long() -> string {
    return "0123456789" + "0123456789" + "0123456789" + "0123456789" + "0123456789"
}

// Mantle p.0.1 ABI 冒烟缺口：version() 真返回 string 而非 i64 版本码
pub func version() -> string {
    return "0.1.0"
}

}
