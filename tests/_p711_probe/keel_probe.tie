type tie<logic>
// tests/_p711_probe/keel_probe.tie —— p.7.1.1 Keel 骨架层验收
// ============================================================
// 里程碑：2026.2 路线图 p.7.1.1「Keel 龙骨架构核心微内核化第一步」骨架层。
// 验收点：
//   1. boot() 后注册项总数 >= 6（5 pass + 1 pipeline）；
//   2. find 反查 + 重复 register 幂等（返回原 id，不重复登记）；
//   3. kind 正确（pass 注册项是 "pass"，pipeline 注册项是 "pipeline"）；
//   4. 按名执行 run_pipeline_by_name("tiec::pipeline_default") 返回 0
//      （front→irgen→tieir→emit→link 5 个 noop 占位全过）；
//   5. 分派默认分支：执行一个未登记 impl_name 的 pass → 返回 -1 且内部
//      错误标记置位。
// 全部通过打印「keel p.7.1.1 骨架自检通过」exit 0；任一失败打印明细 exit 1。
//
// # import 顺序（语言边界）
//   本文件一次性 import 三个 keel 文件。keel_registry/boot/executor 内部
//   相互不 import（避免 import 内联重复定义），先 import registry，再
//   boot（用 keelreg），最后 executor（用 keelreg + keelboot）。

import "../../compiler/keel/keel_registry.tie"
import "../../compiler/keel/keel_boot.tie"
import "../../compiler/keel/keel_executor.tie"

// 断言辅助：失败打印明细并返回 false；main 累积全部结果。
func check(ok: bool, what: string) -> bool {
    if !ok {
        println("keel 自检失败: " + what)
    }
    return ok
}

func main() {
    var ok: bool = true

    // ---------- 引导 ----------
    var plid = keelboot.boot()

    // 1) 注册项总数 >= 6（5 pass + 1 pipeline）
    if !check(keelreg.count() >= 6, "boot 后注册项数 >= 6（实际 " + to_string(keelreg.count()) + "）") {
        ok = false
    }
    // boot 幂等：重复引导不重复登记（count 不增）
    var c_before = keelreg.count()
    keelboot.boot()
    if !check(keelreg.count() == c_before, "boot 幂等（重复引导 count 不变）") {
        ok = false
    }

    // 2) find 反查 + 重复 register 幂等
    var front_id = keelreg.find("tiec::pass_front")
    if !check(front_id >= 0, "find pass_front 命中") {
        ok = false
    }
    var dup_id: i64 = 0
    if front_id >= 0 {
        var deps: table<i64> = table_new_i64()
        dup_id = keelreg.register("tiec::pass_front", "pass", "anything_new", deps)
    }
    if !check(dup_id == front_id, "重复 register 幂等返回原 id") {
        ok = false
    }
    // 幂等后 kind 不被覆盖
    if !check(keelreg.kind_of(front_id) == "pass", "幂等不覆盖原 kind") {
        ok = false
    }

    // 3) kind 正确（pass 是 "pass"，pipeline 是 "pipeline"）
    if !check(plid >= 0 && keelreg.kind_of(plid) == "pipeline", "pipeline:default 是 pipeline") {
        ok = false
    }
    if !check(keelreg.kind_of(front_id) == "pass", "pass_front 是 pass") {
        ok = false
    }

    // 4) 按名执行默认管线（5 个 noop 占位全过返回 0）
    if !check(keelreg.find("tiec::pipeline_default") == plid, "find pipeline_default") {
        ok = false
    }
    var rc = keelexec.run_pipeline_by_name("tiec::pipeline_default")
    if !check(rc == 0, "默认管线执行成功（返回 0，实际 " + to_string(rc) + "）") {
        ok = false
    }

    // 5) 分派默认分支：未登记 impl_name 的 pass → -1 + 内部错误标记置位
    keelexec.clear_err()
    var bad_deps: table<i64> = table_new_i64()
    var bad_id = keelreg.register("tiec::pass_unknown", "pass", "keelboot_no_such_impl", bad_deps)
    var bpipe_deps: table<i64> = table_new_i64()
    table_push(bpipe_deps, bad_id)
    var bpipe_id = keelreg.register("tiec::pipeline_unknown", "pipeline", "", bpipe_deps)
    var brc = keelexec.run_pipeline(bpipe_id)
    if !check(brc == -1, "未登记 impl 的 pass 执行返回 -1（实际 " + to_string(brc) + "）") {
        ok = false
    }
    if !check(keelexec.errflag() == 1, "内部错误标记置位") {
        ok = false
    }

    // ---------- 汇总 ----------
    if !ok {
        exit(1)
    }
    println("keel p.7.1.1 骨架自检通过")
}