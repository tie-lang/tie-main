type tie<logic>
// tests/p6811_probe/build_p6811.tie —— p.6.8.11 构建驱动（tie 写；构建/链接逻辑全 tie）
// EN: p.6.8.11 build driver, written in tie (no PowerShell for build/link logic).
//
// 职责 / Duties（仓库根运行）：
//   1) clang-cl /MT 编译 ext/gfx/skia/thunk/thunk.cpp → thunk.obj（Skia 离屏渲染）
//   2) clang-cl /MT 编译 ext/gfx/win/win.cpp → win.obj（窗口嵌入层；本子项不改 thunk）
//   3) tiec_7A6100 --emit-ir 编译探针（transitively imports gfx/commands/port/app/window/
//      event/thunk_binding） → .ll → clang -c → .obj
//   4) clang -fuse-ld=link 链接 探针.obj + thunk.obj + win.obj + skia.lib + trm_lite.a
//      → 探针.exe（trm_lite.a 提供 table<T> 运行时 tl_tbl$* 与 gfx arena 记账）
//   5) 运行探针（cwd=仓库根，SKIA 窗口短暂可见）；rc==0 → PASS
//
// 说明：沿用 p.6.8.8/6.8.9/6.8.10 固定稳定现役 tiec_7A6100.exe（SHA256 7A6100FC…BC44），
// 不与并发子代理改 compiler/ 冲突。p.6.8.11 只新增 tie 模块（app.tie / port.tie）+ 探针，
// 不改 thunk.cpp / win.h / win.cpp（同 6.8.10 惯例，thunk.obj + win.obj 并入探针 exe）。

import "../../std/process.tie" as process

func logmsg(m: string) {
    println("[build_p6811.tie] " + m)
}
func fail(m: string) {
    println("[build_p6811.tie] ERROR: " + m)
    exit(1)
}
func run(cmd: string) -> i64 {
    var rc = process.exec_code(cmd)
    if rc != 0 {
        println("[build_p6811.tie] command failed (rc=" + to_string(rc) + "): " + cmd)
    }
    return rc
}

var g_tiec: string = "compiler\\tiec_7A6100.exe"
var g_thunk_cpp: string = "ext\\gfx\\skia\\thunk\\thunk.cpp"
var g_thunk_obj: string = "ext\\gfx\\skia\\thunk\\thunk.obj"
var g_win_cpp: string = "ext\\gfx\\win\\win.cpp"
var g_win_obj: string = "ext\\gfx\\win\\win.obj"
var g_probe_src: string = "tests\\p6811_probe\\p6811_probe.tie"
var g_probe_ll: string = "tests\\p6811_probe\\p6811_probe.ll"
var g_probe_obj: string = "tests\\p6811_probe\\p6811_probe.obj"
var g_probe_exe: string = "tests\\p6811_probe\\p6811_probe.exe"
var g_skia_lib: string = "ext\\gfx\\lib\\skia.lib"
var g_skia_src: string = "ext\\gfx\\skia"
var g_trmlite: string = "..\\trm-lite\\trm_lite.a"

func main() {
    // 1) thunk.cpp → thunk.obj（/MT 匹配 skia）
    if run("clang-cl /MT /std:c++17 /O2 /EHsc /c " + g_thunk_cpp +
        " /I " + g_skia_src + " /Fo:" + g_thunk_obj) != 0 {
        fail("thunk.cpp compile failed")
    }
    logmsg("thunk.obj built")

    // 2) win.cpp → win.obj（窗口嵌入层；/MT 与 skia 一致）
    if run("clang-cl /MT /O2 /c " + g_win_cpp + " /Fo:" + g_win_obj) != 0 {
        fail("win.cpp compile failed")
    }
    logmsg("win.obj built")

    // 3) 探针 → .ll → .obj（transitively imports gfx/commands/port/app/window/event/thunk_binding）
    if run(g_tiec + " " + g_probe_src + " --emit-ir -o " + g_probe_ll) != 0 {
        fail("probe IR failed (tiec)")
    }
    if run("clang -O2 -c " + g_probe_ll + " -o " + g_probe_obj) != 0 {
        fail("probe obj failed (clang)")
    }
    logmsg("probe.obj built")

    // 4) 链接（clang 驱动 → link.exe；CRT=静态；skia + win thunk + trm_lite 表运行时）
    var lcmd = "clang -fuse-ld=link " + g_probe_obj + " " + g_thunk_obj + " " + g_win_obj +
        " " + g_skia_lib + " " + g_trmlite + " -o " + g_probe_exe +
        " -luser32 -lgdi32 -lshell32 -ldwrite -lole32 -loleaut32 -ladvapi32 -lwindowscodecs -rtlib=compiler-rt"
    if run(lcmd) != 0 {
        fail("probe link failed")
    }
    logmsg("probe.exe linked")

    // 5) 运行（cwd=仓库根；SKIA 窗口短暂可见，进程内自建/销毁）
    var rc = process.exec_code(g_probe_exe)
    if rc != 0 {
        fail("probe run failed rc=" + to_string(rc) + " (探针内部 FAIL / 退出非 0)")
    }
    logmsg("PROBE PASS (rc=0)")
}