type tie<logic>
import "../../std/result.tie"
import "../../std/assert.tie"
import "../../std/fs.tie"
using assert;
using fs;

func contains(s: string, sub: string) -> bool {
    var n: i64 = str_len(s)
    var m: i64 = str_len(sub)
    var i: i64 = 0
    while i + m <= n {
        var j: i64 = 0
        var ok: bool = true
        while j < m {
            if str_char(s, i + j) != str_char(sub, j) {
                ok = false
            }
            j = j + 1
        }
        if ok {
            return true
        }
        i = i + 1
    }
    return false
}

func main() {
    var root = "C:/Users/Jiro/AppData/Local/Temp/opencode/t6fsx"
    if fs.exists(root) {
        assert.assert(fs.remove_all(root))
    }
    assert.assert(!fs.exists(root))
    var d1 = root + "/层一"
    var d12 = d1 + "/子层二"
    var dA = root + "/层三/深/更深"
    assert.assert(fs.create_dir_all(d12))
    assert.assert(fs.create_dir_all(dA))
    assert.assert(fs.is_dir(d12))
    var f1 = d1 + "/文件甲.txt"
    var f2 = d12 + "/文件乙.txt"
    assert.assert(fs.write_text(f1, "内容甲"))
    assert.assert(fs.write_text(f2, "内容乙"))
    assert.assert(fs.exists(f1))
    assert.assert(fs.is_file(f1))
    assert.assert(fs.size(f1) == 9)
    var entries = fs.read_dir(root)
    assert.assert(len(entries) >= 2)
    var ct = ""
    var i: i64 = 0
    while i < len(entries) {
        ct = ct + "|" + entries[i] + "|"
        i = i + 1
    }
    assert.assert(contains(ct, "层一"))
    assert.assert(contains(ct, "层三"))
    assert.assert(!contains(ct, "/"))
    var all = fs.walk(root)
    assert.assert(len(all) >= 5)
    var wa = ""
    var k: i64 = 0
    while k < len(all) {
        wa = wa + "|" + all[k] + "|"
        k = k + 1
    }
    assert.assert(contains(wa, "文件乙.txt"))
    assert.assert(contains(wa, "更深"))
    var f1c = root + "/复制甲.txt"
    assert.assert(fs.copy(f1, f1c))
    assert.assert(fs.exists(f1c))
    assert.assert(fs.size(f1c) == 9)
    var f2m = root + "/移动乙.txt"
    assert.assert(fs.rename(f2, f2m))
    assert.assert(fs.exists(f2m))
    assert.assert(!fs.exists(f2))
    var dc = root + "/复制层"
    assert.assert(fs.copy_dir(d1, dc))
    assert.assert(fs.is_dir(dc))
    var fdc = dc + "/文件甲.txt"
    assert.assert(fs.exists(fdc))
    assert.assert(fs.remove(f1c))
    assert.assert(fs.remove(f2m))
    assert.assert(fs.remove(fdc))
    assert.assert(fs.remove_all(root))
    assert.assert(!fs.exists(root))
    println("fs_inline2 OK")
}