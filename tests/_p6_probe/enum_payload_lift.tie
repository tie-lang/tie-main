type tie<logic>
// ============================================================
// p.6.2.1 探针：enum payload 白名单放开 f64/table/map（2026-09-01）
//
// 目标：白名单从「整数族/bool/char/trit/string」扩展到
//   + f64（bitcast 桥） + table<T>/map<V>（ptrtoint/inttoptr 桥）。
// struct/嵌套 enum 仍拒绝。
// 覆盖：
//   1. Result<table<i64>, string> 构造 + switch case 绑定解包
//   2. Result<table<string>, string>（多槽变体最大槽 K=1）
//   3. f64 payload 构造 + switch case 绑定
//   4. map payload 构造 + switch case 绑定
//   5. ? 解包（table payload，跨函数）
//   6. 负例形态保留：struct/嵌套 enum 仍编译不过（见 tests/errors/golden/err_064）
// ============================================================

import "../../std/result.tie"

// ---- 1/2/5: table payload（经泛型 Result 实例化）----
func read_bytes(path: string) -> Result<table<i64>, string> {
    var t = table_new_i64()
    table_push(t, 1)
    table_push(t, 2)
    table_push(t, 3)
    return Result.Ok(t)
}

func read_lines() -> Result<table<string>, string> {
    var t = table_new_string()
    table_push(t, "a")
    table_push(t, "中")
    return Result.Ok(t)
}

// ---- 3: f64 payload ----
enum Val {
    Int(i64)
    Flt(f64)
}

// ---- 4: map payload ----
enum Holder {
    MapV(map<string>)
    IntV(i64)
}

// ---- 5: ? 解包承载函数（仅限返回同枚举实例）----
func probe_try() -> Result<table<i64>, string> {
    var r = read_bytes("x")
    var t = r ?   // Err → 提前 return Err；Ok → 解包 table payload
    var u = table_new_i64()
    table_push(u, 100)
    table_push(u, 200)
    return Result.Ok(u)
}

func main() -> i64 {
    // 1. table<i64> payload：构造 + switch 解构
    var r = read_bytes("f")
    var ok1: bool = false
    switch r {
        case Result.Ok(v):
            ok1 = len(v) == 3 && v[0] == 1 && v[1] == 2 && v[2] == 3
        case Result.Err(e):
            println("FAIL unexpected err: " + e)
    }
    if !ok1 {
        println("FAIL table<i64> payload")
        return 1
    }
    println("PASS table<i64> payload (switch bind)")

    // 2. table<string> payload
    var r2 = read_lines()
    var ok2: bool = false
    switch r2 {
        case Result.Ok(v):
            ok2 = len(v) == 2 && v[0] == "a" && v[1] == "中"
        case Result.Err(e):
            println("FAIL unexpected err: " + e)
    }
    if !ok2 {
        println("FAIL table<string> payload")
        return 1
    }
    println("PASS table<string> payload (switch bind)")

    // 3. f64 payload
    var f = Val.Flt(3.5)
    var ok3: bool = false
    switch f {
        case Val.Flt(x):
            ok3 = x == 3.5
        case Val.Int(n):
            println("FAIL wrong variant Int(" + to_string(n) + ")")
    }
    if !ok3 {
        println("FAIL f64 payload")
        return 1
    }
    println("PASS f64 payload (switch bind)")

    // 4. map payload
    var m: map<string> = ["k": "v"]
    var h = Holder.MapV(m)
    var ok4: bool = false
    switch h {
        case Holder.MapV(mv):
            ok4 = map_contains(mv, "k") && mv["k"] == "v"
        case Holder.IntV(n):
            println("FAIL wrong variant IntV(" + to_string(n) + ")")
    }
    if !ok4 {
        println("FAIL map payload")
        return 1
    }
    println("PASS map payload (switch bind)")

    // 5. ? 解包（table payload）
    var tr = probe_try()
    switch tr {
        case Result.Ok(v):
            ok2 = len(v) == 2 && v[0] == 100 && v[1] == 200
        case Result.Err(e):
            println("FAIL unexpected err: " + e)
    }
    if !ok2 {
        println("FAIL probe_try result")
        return 1
    }
    println("PASS ? unbox carrier (table payload)")
    println("ALL PASS")
    return 0
}
