type tie<logic>
// tests/_r167_probe/csprng_linux_probe.tie —— r.1.6.9 验收探针：std/csprng 加密安全随机
// （namespace csrnd，唯一公开 `csrnd.strong_bytes`）。
// 双平台兼容：
//   - Windows：走 bcrypt.dll 原生 BCryptGenRandom（自举随 compiler\tiec.exe 直接本机跑）；
//   - Linux：经 trm_lite_linux.a 的 compat 成员 BCryptGenRandom getrandom(2) POSIX shim
//     （r.1.6.8），tie 侧零改动。
// 断言 strong_bytes 语义：返回长度正确、元素域 [0,255]、随机源非全零（不成块/低频不可信
// 到全零概率可忽略）；另以 2048 字节大样本单次成块调用冒烟（性能纪律：单次调用 + 结果表
// 预购并，禁止循环拼接）。期望全部 PASS / exit 0。
import "../../std/csprng.tie" as csrnd

var fails: i64 = 0

func check(cond: bool, msg: string) {
    if cond {
        println("PASS " + msg)
    } else {
        println("FAIL " + msg)
        fails = fails + 1
    }
}

// 元素域校验并统计非零字节数（全部 ∈ [0,255]；非全零判据任意采样字节异于 0）。
func scan_bytes(t: table<i64>, want_len: i64, msg: string) {
    // len 正确
    check(len(t) == want_len, msg + " len=" + to_string(len(t)))
    // 元素域 [0,255] + 非全零（首字节采样）
    var in_range = true
    var nonzero = false
    var i: i64 = 0
    while i < want_len {
        var v = t[i]
        if v < 0 || v > 255 {
            in_range = false
        }
        if v != 0 {
            nonzero = true
        }
        i = i + 1
    }
    check(in_range, msg + " elements in [0,255]")
    check(nonzero, msg + " not-all-zero")
}

func main() {
    // 32 字节：len 正确 + 域 [0,255] + 非全零
    var t32 = csrnd.strong_bytes(32)
    scan_bytes(t32, 32, "strong_bytes(32)")

    // 64 字节：长度精确（成块填充语义）
    var t64 = csrnd.strong_bytes(64)
    scan_bytes(t64, 64, "strong_bytes(64)")

    // 2048 字节大样本冒烟：单次成块调用，len 精确 + 非全零
    var t2048 = csrnd.strong_bytes(2048)
    scan_bytes(t2048, 2048, "strong_bytes(2048)")

    if fails == 0 {
        println("ALL PASS " + to_string(3) + " blocks")
    } else {
        println("FAILURES=" + to_string(fails))
    }
}