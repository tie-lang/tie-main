type tie<logic>
// p.6.4.9 probe: http_get/http_get_file + untar_gz/unzip (inline IR)
func main() {
    var pass: bool = true
    // ---- http_get ----
    var body = http_get("http://localhost:8123/hello.txt")
    println("http_get len=" + to_string(len(body)))
    println("http_get head: " + str_char(body, 0) + str_char(body, 1) + str_char(body, 2) + str_char(body, 3) + str_char(body, 4))
    pass = pass && len(body) == 29
    pass = pass && str_char(body, 0) == "h" && str_char(body, 4) == "o" && str_char(body, 28) == "9"
    // https → 空串
    var hs = http_get("https://example.com/")
    pass = pass && len(hs) == 0
    // ---- http_get_file（含 NUL 字节，测二进制写）----
    var okf = http_get_file("http://localhost:8123/subdir/nested.txt", "C:/Users/Jiro/AppData/Local/Temp/p649/out_http/nested.txt")
    var d2 = byte_read("C:/Users/Jiro/AppData/Local/Temp/p649/out_http/nested.txt")
    println("http_get_file ok=" + (okf ? "true" : "false") + " len=" + to_string(len(d2)))
    pass = pass && okf
    pass = pass && len(d2) == 35
    pass = pass && d2[0] == 110 && d2[20] == 0 && d2[34] == 101  // 'n', NUL, 'e'
    // ---- untar_gz ----
    var ok1 = untar_gz("C:/Users/Jiro/AppData/Local/Temp/p649/test.tar.gz", "C:/Users/Jiro/AppData/Local/Temp/p649/out_tar")
    var da = byte_read("C:/Users/Jiro/AppData/Local/Temp/p649/out_tar/a.txt")
    var db = byte_read("C:/Users/Jiro/AppData/Local/Temp/p649/out_tar/subdir/b.bin")
    println("untar_gz ok=" + (ok1 ? "true" : "false") + " a.txt=" + to_string(len(da)) + " b.bin=" + to_string(len(db)))
    pass = pass && ok1
    pass = pass && len(da) == 25
    pass = pass && da[0] == 97 && da[1] == 108   // 'a','l'
    pass = pass && len(db) == 1024
    pass = pass && db[0] == 0 && db[255] == 255 && db[256] == 0 && db[1023] == 255
    // ---- untar_gz 未压缩 tar 兜底路径 ----
    var ok2 = untar_gz("C:/Users/Jiro/AppData/Local/Temp/p649/test.tar", "C:/Users/Jiro/AppData/Local/Temp/p649/out_tar_raw")
    var dr = byte_read("C:/Users/Jiro/AppData/Local/Temp/p649/out_tar_raw/a.txt")
    println("untar raw ok=" + (ok2 ? "true" : "false") + " len=" + to_string(len(dr)))
    pass = pass && ok2
    pass = pass && len(dr) == 25 && dr[0] == 97
    // ---- unzip（deflate）----
    var ok3 = unzip("C:/Users/Jiro/AppData/Local/Temp/p649/test.zip", "C:/Users/Jiro/AppData/Local/Temp/p649/out_zip")
    var za = byte_read("C:/Users/Jiro/AppData/Local/Temp/p649/out_zip/a.txt")
    var zb = byte_read("C:/Users/Jiro/AppData/Local/Temp/p649/out_zip/subdir/b.bin")
    println("unzip ok=" + (ok3 ? "true" : "false") + " a.txt=" + to_string(len(za)) + " b.bin=" + to_string(len(zb)))
    pass = pass && ok3
    pass = pass && len(za) == 25 && za[0] == 97
    pass = pass && len(zb) == 1024 && zb[255] == 255 && zb[1023] == 255
    // ---- unzip（stored）----
    var ok4 = unzip("C:/Users/Jiro/AppData/Local/Temp/p649/test_stored.zip", "C:/Users/Jiro/AppData/Local/Temp/p649/out_zip_stored")
    var sa = byte_read("C:/Users/Jiro/AppData/Local/Temp/p649/out_zip_stored/a.txt")
    println("unzip stored ok=" + (ok4 ? "true" : "false") + " len=" + to_string(len(sa)))
    pass = pass && ok4
    pass = pass && len(sa) == 25 && sa[0] == 97
    // ---- 失败路径：不存在文件 → false ----
    var ok5 = untar_gz("C:/Users/Jiro/AppData/Local/Temp/p649/no_such.tar.gz", "C:/Users/Jiro/AppData/Local/Temp/p649/out_x")
    pass = pass && !ok5
    if pass {
        println("PROBE_PASS")
    } else {
        println("PROBE_FAIL")
    }
}
