type tie<logic>
// r.1.1.7 正例语料：同模块混合 i64/string 表的 ref push 元素类型推断。
// 直接 table_push(ref参数, v) / 下标交换 / 原地算法（编译器按目标表元素静态
// 类型选桥，不再误选 string 桥）。期望输出逐行：
//   1 42 / 1 hi / 3 1 / 3 2 / 3 3 / 3 a / 3 b / 3 c / 5 / 4 1 2 3
import "../../std/collection.tie"
import "../../std/sort.tie"

func push_i64(t: ref table<i64>, v: i64) {
    table_push(t, v)
}

func push_string(t: ref table<string>, v: string) {
    table_push(t, v)
}

func main() {
    // 1. 混合模块 ref push（i64 与 string 同模块共存）
    var ti = table_new_i64()
    push_i64(ti, 42)
    println(to_string(len(ti)) + " " + to_string(ti[0]))
    var ts = table_new_string()
    push_string(ts, "hi")
    println(to_string(len(ts)) + " " + ts[0])
    // 2. coll 原地 heap_push / stack_push（原规避已拆除）
    var h = table_new_i64()
    coll.heap_push(h, 2)
    coll.heap_push(h, 1)
    coll.heap_push(h, 3)
    println(to_string(len(h)) + " " + to_string(h[0]))
    println(to_string(coll.heap_pop(h)) + " " + to_string(coll.heap_pop(h)) + " " + to_string(coll.heap_pop(h)))
    var st = table_new_i64()
    coll.stack_push(st, 1)
    coll.stack_push(st, 2)
    coll.stack_push(st, 3)
    println(to_string(coll.stack_pop(st)) + " " + to_string(coll.stack_pop(st)) + " " + to_string(coll.stack_pop(st)))
    // 3. sort 原地冒泡 + 有序插入（i64 与 string 同模块）
    var s = table_new_i64()
    table_push(s, 3)
    table_push(s, 1)
    table_push(s, 2)
    sort.sort_i64(s)
    println(to_string(len(s)))
    println(to_string(s[0]) + " " + to_string(s[1]) + " " + to_string(s[2]))
    var sst = table_new_string()
    table_push(sst, "c")
    table_push(sst, "a")
    table_push(sst, "b")
    sort.sort_string(sst)
    println(sst[0] + " " + sst[1] + " " + sst[2])
    var ins = table_new_i64()
    table_push(ins, 1)
    table_push(ins, 3)
    sort.insert_sorted_i64(ins, 2)
    println(to_string(ins[0]) + " " + to_string(ins[1]) + " " + to_string(ins[2]))
}
