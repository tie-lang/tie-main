type tie<class>
// tests/m5_dynlib/dynlib_boundary_neg.tie —— M5 动态库边界负例（dev33 批次 12，S10 修订）
// 动态库模式下导出函数（顶层 + 命名空间 pub func）的参数/返回允许标量/string/
// slice<T>/repr(C) pod struct；但 table/map/enum/非 pod struct（含指针或字符串
// 字段的堆布局 struct）不得跨动态库边界。
// 由 scripts/regress-m5-dynlib.ps1 以 `--shared` 编译验证应报「动态库边界错误」。
// 注意：本目录（tests/m5_dynlib/）不入 regress-s21 负例段——负例需 --shared 开关。

// 违例 2 目标：非 pod struct 返回（含 string 字段 → 有指针的堆布局，非 pod 不可跨库）
struct Point {
    var x: i64 = 0
    var name: string = ""
}

namespace badlib {
// 违例 1：导出函数参数为 table（ref 表参数亦同）
pub func sum_table(t: ref table<i64>) -> i64 {
    return len(t)
}

// 违例 2：导出函数返回非 pod struct（含 string 字段）
pub func origin() -> Point {
    return Point(0, "o")
}
}
