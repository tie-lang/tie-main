type tie<logic>
// repro3_cross.tie —— 场景3最小复现：跨模块大表传参/整体迭代栈损坏。
import "./callee3.tie" as callee3

func main() {
    var n: i64 = 100000
    var t = table_new_i64()
    callee3.fill(t, n)
    var total: i64 = callee3.sum(t)
    // 期望 sum(i*3, i=0..n-1) = 3*n*(n-1)/2
    var expect: i64 = 3 * n * (n - 1) / 2
    if total == expect {
        println("PASS sum=" + to_string(total))
    } else {
        println("FAIL sum=" + to_string(total) + " expect=" + to_string(expect))
    }
    exit(0)
}