type tie<logic>
// p.6.1.7 §四 触发形态骨架（适配 ties 语义）：长循环 + 逐轮建表 + struct 字段整体写回
struct Rec {
    var id: string = ""
    var items: table<i64> = []
}
var g_tgt: table<Rec>
func hammer(n: i64) -> i64 {
    var k: i64 = 0
    while k < n {
        var tab = table_new_i64()
        var j: i64 = 0
        while j < 8 {
            table_push(tab, k * 31 + j)
            j = j + 1
        }
        var r = Rec()
        r.id = "r" + to_string(k)
        r.items = tab
        table_push(g_tgt, r)
        k = k + 1
    }
    return len(g_tgt)
}
func main() {
    var n = hammer(100000)
    println("n=" + to_string(n))
    if n == 100000 {
        println("PASS")
    } else {
        println("FAIL")
    }
    exit(0)
}