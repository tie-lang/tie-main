type tie<logic>
// tests/_p715_probe/audit_probe.tie —— Keel 龙骨 p.7.1.5 安全审计链探针
// ============================================================
// 验收：「篡改 / 冒名 / 换钥」三类负例全拦截 + 全链路审计正例 0。
//   1) 建 2-3 个 *.tie 文件 → fingerprint_tree 算包树根（非空）。
//   2) 篡改其中一文件一个字节 → 树根变 → verify_tree(旧,新) == -1（篡改拦截）；
//      恢复后 verify_tree == 0。
//   3) 固定测试公私钥（现场生成：固定 seed → 公钥；坏 seed → 坏公钥）：
//      ed25519.sign(tree 字节) 正确签名 → verify_signature == 0；
//      用坏公钥验同一签名 → -1（冒名拦截）。
//   4) anchor(tree) 首次写 → check_anchor(tree) == 0；check_anchor(其它 fp) == -1
//      （换钥拦截）。
//   5) 全链路 audit(tree, 好公钥, 好签名, tree) == 0（正例）。
// 可重跑：main 开头清理残留锚文件 .tie.lock。
// 运行目录 = tests/_p715_probe/（相对路径指向本目录）。
//
// # import 说明
//   keel_auditor 内部已 import tsha1 + ed25519（跨文件 import 文本内联去重）；
//   探针自用 ed25519 的 keygen/sign（命名空间前缀 ed25519.，无需 using）。

import "../../compiler/keel/keel_auditor.tie"
import "../../std/ed25519.tie"

var fails: i64 = 0

func check(cond: bool, msg: string) {
    if cond {
        println("PASS " + msg)
    } else {
        println("FAIL " + msg + "（" + keelaud.err_msg() + "）")
        fails = fails + 1
    }
}

// 字符串字节 → hex（与 keelaud 内约定一致：签名消息 = 树根字符串字节的 hex）。
func hexstr(s: string) -> string {
    var hex = "0123456789abcdef"
    var out: string = ""
    var i: i64 = 0
    var n: i64 = len(s)
    while i < n {
        var b = str_byte(s, i)
        out = out + str_char(hex, (b >> 4) & 0xF) + str_char(hex, b & 0xF)
        i = i + 1
    }
    return out
}

func main() {
    var pkg = "pkg-src"
    // 清理残留：锚文件 + 样本源目录（保证可重跑）
    if file_exists(".tie.lock") {
        file_delete(".tie.lock")
    }
    if file_exists(pkg + "/alpha.tie") {
        file_delete(pkg + "/alpha.tie")
    }
    if file_exists(pkg + "/beta.tie") {
        file_delete(pkg + "/beta.tie")
    }
    if file_exists(pkg + "/gamma.tie") {
        file_delete(pkg + "/gamma.tie")
    }

    // ---------- 建 2-3 个 *.tie 样本 ----------
    mkdir_all(pkg)
    file_write(pkg + "/alpha.tie", "type tie<data>\n[ \"service\": \"alpha\", \"v\": 1 ]\n")
    file_write(pkg + "/beta.tie", "type tie<data>\n[ \"service\": \"beta\", \"v\": 2 ]\n")
    file_write(pkg + "/gamma.tie", "type tie<logic>\nfunc main() { println(\"gamma\") }\n")

    // ---------- ① 指纹树 ----------
    var tree = keelaud.fingerprint_tree(pkg)
    check(str_len(tree) > 0, "fingerprint_tree 算得树根（非空）")

    // ---------- ② 验签（固定测试公私钥，现场生成） ----------
    var seed_good = "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"
    var seed_bad = "deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef"
    var good_pub = ed25519.keygen(seed_good)
    var bad_pub = ed25519.keygen(seed_bad)
    if good_pub == bad_pub {
        check(good_pub != bad_pub, "固定测试公私钥对可区分")
    }
    var good_sig = ed25519.sign(hexstr(tree), good_pub, seed_good)
    check(keelaud.verify_signature(tree, good_pub, good_sig) == 0, "正确 pubkey+sig → verify_signature 0")
    check(keelaud.verify_signature(tree, bad_pub, good_sig) == -1, "错误 pubkey → verify_signature -1（冒名拦截）")

    // ---------- ③ TOFU 信任锚 ----------
    check(keelaud.anchor(tree) == 0, "anchor 首次写入信任锚返回 0")
    check(keelaud.check_anchor(tree) == 0, "check_anchor 固化指纹一致返回 0")
    var other_fp = "deadbeef-not-the-anchor-fp"
    check(keelaud.check_anchor(other_fp) == -1, "check_anchor 异指纹返回 -1（换钥拦截）")

    // ---------- 全链路 audit（正例） ----------
    check(keelaud.audit(tree, good_pub, good_sig, tree) == 0, "全链路 audit 正例返回 0")
    check(keelaud.audit(tree, bad_pub, good_sig, tree) == -1, "全链路 audit 冒名返回 -1")

    // ---------- ① 篡改负例 ----------
    var b = byte_read(pkg + "/alpha.tie")
    if len(b) > 4 {
        b[0] = b[0] ^ 0x40
        byte_write(pkg + "/alpha.tie", b)
    }
    var tree2 = keelaud.fingerprint_tree(pkg)
    check(tree != tree2, "篡改一字节后树根变化")
    check(keelaud.verify_tree(tree, tree2) == -1, "verify_tree 篡改拦截返回 -1")

    // 恢复原内容 → 树根复原
    file_write(pkg + "/alpha.tie", "type tie<data>\n[ \"service\": \"alpha\", \"v\": 1 ]\n")
    var tree3 = keelaud.fingerprint_tree(pkg)
    check(keelaud.verify_tree(tree, tree3) == 0, "恢复后 verify_tree 一致返回 0")

    if fails > 0 {
        println("keel p.7.1.5 审计链自检失败 total=" + to_string(fails))
        exit(1)
    }
    println("keel p.7.1.5 审计链自检通过（篡改/冒名/换钥全拦截 + 全链路 0）")
}