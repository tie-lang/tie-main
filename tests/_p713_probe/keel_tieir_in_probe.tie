type tie<logic>
// tests/_p713_probe/keel_tieir_in_probe.tie —— p.7.1.3 tieir 消费入口验收探针
// ============================================================
// 里程碑：2026.2 路线图 p.7.1.3「tieir 消费入口：import tieir 包（消费方免前端）」。
// 端到端验收：`.tieir → 反序列化(还原 IR) → 经既有 llvmgen 继续编译 → .ll`。
//
// # 探针结构（一段跑完，内部先造样本再消费）
//   1) 用 ir.*/ir_meta.*/types 在进程内**手工构建最小源 `func add(a:i64,b:i64)->i64
//      { return a+b }`** 的列式 IR（函数表/块/指令 add+ret / 参数段）；
//      设定包头 pkg=sample.add@0.1.0，登记符号表 + 导出表。
//   2) tieir.write(样本.tieir) 产出 .tieir 分发单元。
//   3) keeltieirin.load(样本.tieir) —— 反序列化还原 IR（免前端）。
//   4) keeltieirin.ready() / pkg_name / pkg_version / describe 校验交付。
//   5) keeltieirin.emit_ll() —— 还原 IR 经后端门 → .ll 文本，断言含 add 的 IR。
//   6) keeltieirin.write_ll(样本.ll) 落盘证明「产出 .ll」。
// 全过打印自检通过 exit 0；任一失败打印明细 exit 1。
//
// # import 说明（语言边界）
//   import keel_tieir_in（其链载 tieir_ser→ir_meta→ir+interner+bytes）获得
//   ir/ir_meta/interner/keeltieirin；再 import types 取类型 id（只读 middle）。
//   全部符号经 import 归一化路径去重、树式展开唯一路径可达。
import "../../compiler/keel/keel_tieir_in.tie"
// 探针侧手工构建最小 IR 需要类型 id（只读 middle 模块；types.named 取 i64 命名 id）。
import "../../compiler/middle/types.tie"

var fails: i64 = 0

func check(cond: bool, msg: string) {
    if cond {
        println("PASS " + msg)
    } else {
        println("FAIL " + msg + "（" + keeltieirin.err_msg() + "）")
        fails = fails + 1
    }
}

// 子串包含判断（str 库在探针侧可达性不确定，用字符级自实现，避免依赖面漂移）。
func contains(hay: string, needle: string) -> bool {
    var hn = str_len(hay)
    var nn = str_len(needle)
    if nn == 0 {
        return true
    }
    if nn > hn {
        return false
    }
    var si: i64 = 0
    while si + nn <= hn {
        var j: i64 = 0
        var m: i64 = 1
        while j < nn {
            if str_char(hay, si + j) != str_char(needle, j) {
                m = 0
            }
            j = j + 1
        }
        if m == 1 {
            return true
        }
        si = si + 1
    }
    return false
}

func main() {
    var sample = "tests/_p713_probe/sample.tierpg.tieir"
    var outll = "tests/_p713_probe/sample_out.ll"

    // ---------- 1) 手工构建最小 IR（最小源 add 的列式表达，等价绕过前端） ----------
    ir.new_module()
    ir_meta.reset_meta()
    var T64 = types.named(TK_I64)
    // 包头
    ir_meta.set_pkg_name(interner.intern("sample.add"))
    ir_meta.set_pkg_version(interner.intern("0.1.0"))
    ir_meta.set_ir_version(1)
    // 函数 add(i64,i64)->i64
    var fn_id = interner.intern("add")
    var params: table<i64> = table_new_i64()
    table_push(params, T64)
    table_push(params, T64)
    var fid = ir.new_func(fn_id, T64, params)
    var bid = ir.new_block(fid, -1)
    // %2 = add i64 %0, %1（op=0 算术加，操作数 = 两参数值 id 0/1，OK_VALUE）
    var ai = ir.new_inst(bid, 0, T64)
    ir.add_operand(ai, ir.param_val(fid, 0), 0)
    ir.add_operand(ai, ir.param_val(fid, 1), 0)
    // ret i64 %2（op=32 返回，无结果 ty=-1，操作数 = add 结果值 id）
    var ri = ir.new_inst(bid, 32, -1)
    ir.add_operand(ri, ir.ins_val(ai), 0)
    ir.func_export_set(fid, 1)
    // 侧表：符号 + 导出
    ir_meta.set_sym(fn_id, interner.intern("(i64,i64)->i64"), 0, 1, 1, 1)
    ir_meta.export_add(fn_id, interner.intern("(i64,i64)->i64"), 1, 1)

    // ---------- 2) 写出 .tieir 分发单元 ----------
    var wok = tieir.write(sample)
    check(wok, "tieir.write 产出 .tieir 样本")

    // ---------- 3) 消费：反序列化还原 IR（免前端） ----------
    var rc = keeltieirin.load(sample)
    check(rc == 0, "keeltieirin.load 反序列化还原 IR（返回 0）")

    // ---------- 4) 校验交付 ----------
    check(keeltieirin.ready(), "ready() 校验交付：已加载且 IR 非空")
    check(keeltieirin.pkg_name() == "sample.add", "包名还原 sample.add（实际 " + keeltieirin.pkg_name() + "）")
    check(keeltieirin.pkg_version() == "0.1.0", "包版本还原 0.1.0（实际 " + keeltieirin.pkg_version() + "）")
    check(ir.func_count() == 1, "还原后函数数=1（" + keeltieirin.describe() + "）")
    check(ir.block_count() == 1 && ir.inst_count() == 2, "还原后 IR 主体 块/指令 =1/2（" + keeltieirin.describe() + "）")

    // ---------- 5) 交付：还原 IR → 后端门 → .ll ----------
    var ll = keeltieirin.emit_ll()
    var has_define = contains(ll, "define i64 @add")
    var has_add = contains(ll, "add i64")
    check(str_len(ll) > 0, "emit_ll 产出 .ll 文本（长度 " + to_string(str_len(ll)) + "）")
    check(has_define, ".ll 含 @add 函数定义")
    check(has_add, ".ll 含 add i64 指令（还原 IR 已进后端产出）")

    // ---------- 6) 落盘证据 ----------
    var fok = keeltieirin.write_ll(outll, ll)
    check(fok && file_exists(outll), "write_ll 落盘 .ll 证据文件")

    if fails > 0 {
        println("keel tieir-in p.7.1.3 自检失败 total=" + to_string(fails))
        exit(1)
    }
    println("keel tieir-in p.7.1.3 自检通过（.tieir→还原IR→后端门产出.ll，免前端）")
}