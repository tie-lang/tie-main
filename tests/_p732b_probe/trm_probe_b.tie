type tie<logic>
// tests/_p732b_probe/trm_probe_b.tie —— trm 引擎 p.7.3.2-b 探针：库层起步 + 平台桥
// ============================================================
// 里程碑：2026.2 路线图 p.7.3.2-b「库层起步（terminal/process/fs/env/session）+
// 平台桥（扩展链面）+ 动态库集成」。
// 验收：桥注册表存在性（指定平台可选）+ 绑定 fivenv / fs 存在性 + 跨平台（win32/posix）
// 选择器命中 + 文件/环境查询断言；未导出平台动态库可执行路径不绑定，但桥契约对齐。
// 全过打印「trm 引擎 p.7.3.2-b 自检通过」exit 0；任一失败 exit 1。

import "../../compiler/trm/trm.tie"

var fails: i64 = 0

func check(cond: bool, msg: string) {
    if cond {
        println("PASS " + msg)
    } else {
        println("FAIL " + msg + "（" + trm.err_msg() + "）")
        fails = fails + 1
    }
}

func main() {
    // ---------- 1) 引擎初始化带 sys_boot ----------
    var e0 = trm.init()
    check(e0 == 0, "trm.init 包含 trm.sys_boot 返回 0")
    check(trm.bridge_count() >= 4, "桥注册表至少 4 项（fs.exists, fs.is_dir, fs.delete, env.get）")
    check(trm.bridge_find("fs", "exists") == 0, "桥注册表找到 fs.exists sel=0")
    check(trm.bridge_find("fs", "is_dir") == 1, "桥注册表找到 fs.is_dir sel=1")
    check(trm.bridge_find("fs", "delete") == 2, "桥注册表找到 fs.delete sel=2")
    check(trm.bridge_find("env", "get") == 3, "桥注册表找到 env.get sel=3")
    check(trm.bridge_find("no", "such") == -1, "桥注册表未找到 (no, such) 返回 -1")

    // ---------- 2) 平台表 ----------
    check(trm.bridge_platforms() == 2, "支持平台表 2 项（posix + win32）")
    check(trm.bridge_platform_at(0) == "posix", "平台 0 = posix")
    check(trm.bridge_platform_at(1) == "win32", "平台 1 = win32")
    var def = trm.bridge_platform()
    // 默认 win32（编译器默认开发机）
    check(def == "win32", "默认平台亲缘 win32（正确为默认编译宿主）")
    var sp0 = trm.bridge_set_platform("posix")
    check(sp0 == 0, "切换平台到 posix 成功（在表内）")
    check(trm.bridge_platform() == "posix", "切换后当前平台 posix")
    var sm = trm.bridge_set_platform("no")
    check(sm == -1, "切换到不存在平台返回 -1")
    var sp1 = trm.bridge_set_platform("win32")
    check(sp1 == 0, "切回 win32 成功")
    check(trm.bridge_platform() == "win32", "切回后当前平台 win32")

    // ---------- 3) 库层 fs/env ----------
    // fs.exists 本探针源文件
    var this_path = "tests/_p732b_probe/trm_probe_b.tie"
    check(trm.lib_fs_exists(this_path) == 1, "lib_fs_exists(本探针) = 1")
    check(trm.lib_fs_is_dir(this_path) == 0, "lib_fs_is_dir(本探针) = 0（文件不是目录）")
    check(trm.lib_fs_is_dir("compiler") == 1, "lib_fs_is_dir(compiler) = 1（路径存在目录）")

    // env.get：找 PATH（一定存在）
    var rc_path = trm.lib_env_get("PATH")
    check(rc_path == 0, "lib_env_get(PATH) 存在（0 命中）")
    var val_path = trm.env_last()
    check(str_len(val_path) > 0, "PATH 值非空（env_last 可取到串）")

    // env.get：不存在键
    var rc_nope = trm.lib_env_get("THIS_PATH_MUST_NOT_EXIST_XXXX")
    check(rc_nope == -1, "lib_env_get(不存在键) = -1 未命中")
    var val_nope = trm.env_last()
    check(str_len(val_nope) == 0, "不存在键 env_last 是空串（侧信道约定正确）")

    // ---------- 4) 桥调用契约 ----------
    var sel = trm.bridge_find("fs", "exists")
    check(sel == 0, "bridge_find 返回 sel=0 给 fs.exists")
    var rcall = trm.bridge_call(sel, 0, this_path)
    check(rcall == 1, "bridge_call(sel=0, this_path) = 1 = 存在（契约对齐 lib 层）")
    // 未知选择器
    var runk = trm.bridge_call(999, 0, "dummy")
    check(runk == -2, "未知选择器返回 -2（约定）")

    if fails > 0 {
        println("trm 引擎 p.7.3.2-b 自检失败 total=" + to_string(fails))
        exit(1)
    }
    println("trm 引擎 p.7.3.2-b 自检通过（库层 fs/env + 平台桥注册表 + C1 选择器契约）")
}