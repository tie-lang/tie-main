        check_eq("bndr b zero1000 n" + radix10(n), tsha.tsha1b(repbyte(0, 1000), n, 16), zkb[idx])
        check_eq("bndr x zero1000 n" + radix10(n), tsha.tsha1x(repbyte(0, 1000), n, 16), zkx[idx])
        check_eq("bndr f one16 n" + radix10(n), tsha.tsha1f(repbyte(255, 16), n, 16), o16f[idx])
        check_eq("bndr r one16 n" + radix10(n), tsha.tsha1r(repbyte(255, 16), n, 16), o16r[idx])
        check_eq("bndr b one16 n" + radix10(n), tsha.tsha1b(repbyte(255, 16), n, 16), o16b[idx])
        check_eq("bndr x one16 n" + radix10(n), tsha.tsha1x(repbyte(255, 16), n, 16), o16x[idx])
        check_eq("bndr f one64 n" + radix10(n), tsha.tsha1f(repbyte(255, 64), n, 16), o64f[idx])
        check_eq("bndr r one64 n" + radix10(n), tsha.tsha1r(repbyte(255, 64), n, 16), o64r[idx])
        check_eq("bndr b one64 n" + radix10(n), tsha.tsha1b(repbyte(255, 64), n, 16), o64b[idx])
        check_eq("bndr x one64 n" + radix10(n), tsha.tsha1x(repbyte(255, 64), n, 16), o64x[idx])
    }
}

// (c) W 档级边界。
func w_boundary_assert() {
    var msg = "abc"
    var m1000 = gen_msg(1000)
    check_ne("W f n64!=69 abc", tsha.tsha1f(msg, 64, 16), tsha.tsha1f(msg, 69, 16))
    check_ne("W f n88!=92 abc", tsha.tsha1f(msg, 88, 16), tsha.tsha1f(msg, 92, 16))
    check_ne("W f n64!=69 a1000", tsha.tsha1f(m1000, 64, 16), tsha.tsha1f(m1000, 69, 16))
    var models: table<string> = ["f", "b", "x"]
    var mn: string = ""
    for mn in models {
        var s92 = model_hash(mn, msg, 92, 16)
        var s96 = model_hash(mn, msg, 96, 16)
        if len(s96) < len(s92) {
            chk_fail("W " + mn + " prefix abc", "n96 shorter")
        }
        check_eq("W " + mn + " pref96/92 abc", prefix(s96, len(s92)), s92)
        var t92 = model_hash(mn, m1000, 92, 16)
        var t96 = model_hash(mn, m1000, 96, 16)
        if len(t96) < len(t92) {
            chk_fail("W " + mn + " prefix a1000", "n96 shorter")
        }
        check_eq("W " + mn + " pref96/92 a1000", prefix(t96, len(t92)), t92)
    }
}

func main() {
    table_push(PASS_COUNT, 0)
    len_ext_assert()
    boundary_assert()
    w_boundary_assert()
    println("tsha1_len_ext 探针全部通过，PASS 总数=" + radix10(PASS_COUNT[0]))
}