type tie<logic>
// tsha1 无长度扩展确认 + 边界探针（len_ext probe）。
//   (a) 无长度扩展：对 200 组随机 (m,x)，x ∈ 1..3 字节（m 长差 1..3），断言
//       tsha1f(m+x,48,16) != tsha1f(m,48,16)。TSHA1 块压缩为计数器式（纯零填充 +
//       64 位计数器 t）且状态随输出位长 n，追加字节改变块边界与计数器，理论上 h(m+x)
//       不能由 h(m) 续算，故两者应不同。
//   (b) 全零/全一消息边界：对 ""、全零 1/16/64/65/1000B、全一 16/64B，经二进制安全的
//       string_builder 构造（tie 字符串字面量无法直接承载 0x00/0xFF），断言 4 模型在
//       n∈{48,69,92} 输出与 python gen_tsha1_core.py 的 encode(model,msg,n,16)
//       逐字一致（参考值由小脚本 import core dump，本文件内嵌字面量）。
//   (c) W（字宽）档级边界：f/b/x 的 n=92(64B=128hex) 与 n=96(67B=134hex) 同 W=17 即
//       同一内部状态 → base16 为同一状态池前缀，n96 前 128 hex == n92 全 128 hex；
//       f 在 W12→13（n64/69）、W16→17（n88/92）摘要（base16）必不同。
import "../../std/tsha1.tie"
using tsha;
import "../../std/random.tie"
using rnd;

var PASS_COUNT: table<i64>

func radix10(v: i64) -> string {
    if v == 0 {
        return "0"
    }
    var digits = "0123456789"
    var out: string = ""
    var x = v
    while x > 0 {
        out = str_char(digits, x % 10) + out
        x = x / 10
    }
    return out
}

func chk_ok(name: string) {
    PASS_COUNT[0] = PASS_COUNT[0] + 1
    println("PASS " + name)
}

func chk_fail(name: string, info: string) {
    println("FAIL " + name + " " + info)
    exit(1)
}

func check_eq(name: string, got: string, want: string) {
    if got == want {
        chk_ok(name)
    } else {
        chk_fail(name, "got=" + got + " want=" + want)
    }
}

func check_ne(name: string, a: string, b: string) {
    if a != b {
        chk_ok(name)
    } else {
        chk_fail(name, "两款摘要相等，长度扩展/档级边界被破坏")
    }
}

// 二进制安全重复字节串：n 个值为 b（0..255）的字节。
func repbyte(b: i64, n: i64) -> string {
    var sb = string_builder()
    var i: i64 = 0
    while i < n {
        sb_append_byte(sb, b)
        i = i + 1
    }
    return sb_build(sb)
}

// 随机可打印 ASCII 串（构造消息体用于 (a)，避免涉入不可打印字节字面量）。
var CHARS: string = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
func gen_msg(n: i64) -> string {
    var out: string = ""
    var i: i64 = 0
    while i < n {
        out = out + str_char(CHARS, rnd.int(0, 61))
        i = i + 1
    }
    return out
}

func model_hash(m: string, msg: string, n: i64, base: i64) -> string {
    if m == "f" {
        return tsha.tsha1f(msg, n, base)
    }
    if m == "r" {
        return tsha.tsha1r(msg, n, base)
    }
    if m == "b" {
        return tsha.tsha1b(msg, n, base)
    }
    return tsha.tsha1x(msg, n, base)
}

func prefix(s: string, k: i64) -> string {
    var out: string = ""
    var i: i64 = 0
    while i < k {
        out = out + str_char(s, i)
        i = i + 1
    }
    return out
}

// (a) 无长度扩展：200 组随机 (m,x)，断言 h(m+x) != h(m)。m 长度 0..77 抽样。
func len_ext_assert() {
    var bad: i64 = 0
    var g: i64 = 0
    while g < 200 {
        var mlen = rnd.int(0, 77)
        var xlen = rnd.int(1, 3)
        var m = gen_msg(mlen)
        var x = gen_msg(xlen)
        var hmx = tsha.tsha1f(m + x, 48, 16)
        var hm = tsha.tsha1f(m, 48, 16)
        if hmx == hm {
            bad = bad + 1
        }
        g = g + 1
    }
    if bad == 0 {
        chk_ok("len-ext nonext (200 random m,x)")
    } else {
        chk_fail("len-ext nonext", "bad=" + radix10(bad) + "/200")
    }
}

