        var n = ns[idx]
        check_eq("bndr f empty n" + radix10(n), tsha.tsha1f("", n, 16), ef[idx])
        check_eq("bndr f zero1  n" + radix10(n), tsha.tsha1f(repbyte(0, 1), n, 16), ef[idx])
