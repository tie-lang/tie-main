type tie<logic>
// tsha1r-128 探针：默认输出 base48（23 字符）+ `_hex` 保留 32 位十六进制 +
//   b48↔hex 往返一致性（decode(tsha1r(msg)) == tsha1r_hex(msg) 字节一致）。
// 正向向量：空串/abc/1000x'a'/15/16/17/31/32/33/128/256 字节（同 gen_tsha1fr.py）。
// 说明：tsha1r 内部哈希字节不变（r=128 位=16 字节），仅输出层编码在 base48 与 hex 间切换。
import "../../std/tsha1.tie"
using tsha;
import "../../std/base48.tie"
using b48;

func check(name: string, got: string, want: string) {
    if got == want {
        println("PASS " + name)
    } else {
        println("FAIL " + name + " got=" + got)
        println("     want=" + want)
        exit(1)
    }
}

func rep(c: string, n: i64) -> string {
    var out: string = ""
    var i: i64 = 0
    while i < n {
        out = out + c
        i = i + 1
    }
    return out
}

func prefix(s: string, k: i64) -> string {
    var out: string = ""
    var i: i64 = 0
    while i < k {
        out = out + str_char(s, i)
        i = i + 1
    }
    return out
}

// 断言：tsha1r(msg)==b48（默认 48 进制）、tsha1r_hex(msg)==hex（_hex 可选），
// 且 b48.decode(b48)==hex（encode 前向一致）、b48.decode(tsha1r(msg))==hex（往返一致）。
func assert_vec(name: string, msg: string, hex: string) {
    check(name + " hex", tsha.tsha1r_hex(msg), hex)
    check(name + " b48p", prefix(tsha.tsha1r(msg, 48), 23), b48.encode(hex))
}

func main() {
    assert_vec("r empty", "",
        "35a4dc9779e6e2e65b05790f491a533f")
    assert_vec("r abc", "abc",
        "314db448edf50a4264d29b00bdedca6f")
    assert_vec("r a1000", rep("a", 1000),
        "19f291e41241e4bb89d0c95d06e2b810")
    assert_vec("r b15", rep("a", 15),
        "6145e82ee3d7057151b9a644d2904de6")
    assert_vec("r b16", rep("a", 16),
        "94783626c8a19797930aadc989140f17")
    assert_vec("r b17", rep("a", 17),
        "aacc0cdd11a0736e43d2c84fbd7ecb96")
    assert_vec("r b31", rep("a", 31),
        "fab2a389e4b734efb3e71f367484f094")
    assert_vec("r b32", rep("a", 32),
        "75712bcfb49d9594d927f26e8c3b8164")
    assert_vec("r b33", rep("a", 33),
        "73908b39393db32f70ec433c35137294")
    assert_vec("r b128", rep("a", 128),
        "20b5ea09638a57139543a38390d71431")
    assert_vec("r b256", rep("a", 256),
        "5ebfd3e7b87232017a85e1d38c5fcbd1")
    println("tsha1r 探针全部通过")
}