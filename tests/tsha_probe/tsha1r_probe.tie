    assert_vec("R n96", "", 96, "f6abG1qqnGbaC5yzKl49DA0lvvwDLql4xCbFGza2An68hkFkqK1dmji6mLma1fHvr7zpCHdqGBbam1BiKha5bKq0K7ptcicz", "41c7f28321d0baabb590b37afd1600127e1e2013a51eca765728061f00102287131a5644687014028c00a1523b156bad96d289e3a84280eb2a36f2237b006fe559406b")
