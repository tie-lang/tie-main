type tie<logic>
// tsha1r-128 探针：嵌入式（轻量 SPN Ascon 型 + trit 混合扰动 + 状态压缩）正例
// 多向量 + 长消息/块边界（空串/abc/1000x'a'/15/16/17/31/32/33/128/256 字节，
// 触及 16 字节块边界与末块零填充分支）。短消息（<16 字节）走末块终筛扰动路径，
// 已核对末块 trit 位平面亦有激活。期望输出全部 PASS。
// 向量来源：tests/tsha_probe/gen_vectors.py（私有种子扩展参考生成器，已核对）。
import "../../std/tsha1.tie"
using tsha;

func check(name: string, got: string, want: string) {
    if got == want {
        println("PASS " + name)
    } else {
        println("FAIL " + name + " got=" + got)
        println("     want=" + want)
        exit(1)
    }
}

func rep(c: string, n: i64) -> string {
    var out: string = ""
    var i: i64 = 0
    while i < n {
        out = out + c
        i = i + 1
    }
    return out
}

func main() {
    check("r empty", tsha.tsha1r(""),
        "1d41e39ece695096448cf4947429d6cd")
    check("r abc", tsha.tsha1r("abc"),
        "2539601d2671289458b7c0683324edd6")
    check("r a1000", tsha.tsha1r(rep("a", 1000)),
        "6eeceed1b7e425e0e6ec3d599f0810f6")
    check("r b15", tsha.tsha1r(rep("a", 15)),
        "ac28659b3067b525055a93beb915dc62")
    check("r b16", tsha.tsha1r(rep("a", 16)),
        "87f1abe9412295eea98878dd89297675")
    check("r b17", tsha.tsha1r(rep("a", 17)),
        "061791308d040a6fef8edaa0cf983c10")
    check("r b31", tsha.tsha1r(rep("a", 31)),
        "93ee91d9f3a9283e4a1c5b8b6bc348b3")
    check("r b32", tsha.tsha1r(rep("a", 32)),
        "5c1418590bc6df5890a7e05e931f5df8")
    check("r b33", tsha.tsha1r(rep("a", 33)),
        "087ef9354719d55e26070683a80bbf8f")
    check("r b128", tsha.tsha1r(rep("a", 128)),
        "b44f6a2f99afc3ce2a3883bf5c35fae5")
    check("r b256", tsha.tsha1r(rep("a", 256)),
        "00aa837c85abd811d0cc93fe3e7dbbc2")
    println("tsha1r 探针全部通过")
}
