type tie<logic>
// TSHA1R-r轻量 探针 v2（state-per-n）：公开接口 tsha.tsha1r(msg,n,base=48)。
// 语义源：gen_tsha1fr.py（→ gen_tsha1_core.py 唯一定义）。断言：
//   tsha.tsha1r(msg,n,48) == 生成器 b48 值；tsha.tsha1r(msg,n,16) == 生成器 b16 值。
// 消息集：empty/abc/a1000/a55/a56/a63/a64/a65/a127/a128/a129/a256。
// 位长抽检：{2,8,16,48,64,69,88,92,96,128,144}。
// 非法位长（0/46/23）与非法 base（5/7）断言返回空串（无 XOF，非法拒绝）。
import "../../std/tsha1.tie"
using tsha;

func check(name: string, got: string, want: string) {
    if got == want {
        println("PASS " + name)
    } else {
        println("FAIL " + name + " got=" + got)
        println("     want=" + want)
        exit(1)
    }
}

func rep(c: string, n: i64) -> string {
    var out: string = ""
    var i: i64 = 0
    while i < n {
        out = out + c
        i = i + 1
    }
    return out
}

func assert_vec(name: string, msg: string, n: i64, b48: string, b16: string) {
    check(name + " b48", tsha.tsha1r(msg, n, 48), b48)
    check(name + " b16", tsha.tsha1r(msg, n, 16), b16)
}

func main() {
    assert_vec("R n2", "", 2, "3b", "31")
    assert_vec("R n8", "", 8, "4Bgj80lH", "cea3fb39cc")
    assert_vec("R n16", "", 16, "ao1vwiwhmhFnmrLq", "4cb925260c92d5d796dad7")
    assert_vec("R n48", "", 48, "hLa6LxtCiDBlDerJos01sd6iHugEurju6at68CHw3HpKo1zl", "56996858bf121ab271d6379857b477d04492abb3a5800b95d2fd5bfc59149b948e")
    assert_vec("R n64", "", 64, "drxfCcCH12h1JD4L5gfob5iiyh21ym2nJDfL7ynjamhfCjxjy7aE426JcjHtA7nm", "599140d6c21c04732a3284405836424654a86f7bb106c7d77460c7f90f408d28fd0126129ba8964e6b02480a")
    assert_vec("R n69", "", 69, "9B1qbI1mkom3y5Kevwm8466cB275t3eIdIdbjjmBCoBiqzr4nsdoCvC5Hqdt079xx5kli", "b79153d4dcbc2f38e6d2baba5ec06a3a77e86038c086c2aed178c0a61092bc59b3950920e41885244156433c03926b0b")
    assert_vec("R n88", "", 88, "50EbErcz0eKn83v5lhrB924Igj8pL8x8yf2tK913JjC6jHHJrwkhBw6pt8nzyFE9D41dcDoc37KvJC1kbhio8qaJ", "812160a13022be5fb6fab96ad27e7ceff1661def452698ebaee8927b66d8ab2f85d82242f424c29117f106bf2cf819e89bea10e7a1ac1ebece0859abb4")
