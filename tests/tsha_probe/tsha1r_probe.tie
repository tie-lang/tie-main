    assert_vec("R-a129 n144", rep("a", 129), 144, "ae6EzKA0w384GLdlmKyq6144KrJ9dpyFuwiHwB4nl5tDdiEDjuxmft9iJHI8Hxo0dq9FgDca1prI1v8z0pLAzbuliFuoafL6uDACtwLmEBheibcjt2Flf59h3du2nHHBiyFxxdIGkuIIIhF2", "0e3120c96204cbb3630461661a745195f6788647d7380f4a7fc855d83c8ca178ffa00b495dc08fe3c65a1c944a464dda99d629a9db7c1c92cb78dfe544e835af2aa1246a43b4eaaaa564622fd79072baf916c47e9b864c3548bc05952994e77cef92050c")
    assert_vec("R-a256 n2", rep("a", 256), 2, "cB", "c2")
    assert_vec("R-a256 n8", rep("a", 256), 8, "3oHfHJxm", "982f21f6b1")
    assert_vec("R-a256 n16", rep("a", 256), 16, "aKkl4lBfEyutv2uA", "5021af0488601f8ea0d017")
    assert_vec("R-a256 n48", rep("a", 256), 48, "H36iID4jgIkj2i58A96b4nEItgeDLoJdhHC0Ikp8zpsyxyCI", "cf611ad81f3cc7dc292a54f960b8006e2c842f2a3e60b4abdc313080dd245b7f2d")
    assert_vec("R-a256 n64", rep("a", 256), 64, "2b8FqJChfiglG2Lo82CjkJcuEIByI1iejq3ea4fz8p3gakbHc30n11zj7dBIucwt", "0ebb316f06e4949b2c60a350bc2803477c145e5269d6a22fbca4852bd03c95029b2f058f4ee40c40ce48f7db")
    assert_vec("R-a256 n69", rep("a", 256), 69, "dsbBwboKcF4qeFmDH4mce9rH8kwc7v5kdgFldHmC2on936kkHxzBvvH9v09qoyv5lw4Fv", "ff45da75f72e9a0487c4b64222b6f2e23b462bb00a06036a23ae83b86d8c72b6e3910430e9188615110027c3c78c3586")
    assert_vec("R-a256 n88", rep("a", 256), 88, "17b7haI4bAFIsGwLg7zCHm5rgD5HeKByEzDyzdr8BtCrkHew208azFsxspKo9qIIl4osClBmg42A5hkHoaeF4gjE", "1d9d2b11c306dc4181a2fc0e287a10990dced9ee4d0a14ad477c0015a138e9b54430315f721a124b267b54ef2770384d6b84897ef1a0a979b4b8a073d2")
    assert_vec("R-a256 n92", rep("a", 256), 92, "25c9tF2z5emHgamC8ruAnfyg71F1jm7v3J8m14t9HdzEsqFDzligeLbj4ix5iB85uyhHrhsJ1Kkkoc9Gn1jwppcx1daJ", "9a9903dea2a8409d40201cf374ce325af388d1762f280c0d606c022dd7bca3f7b3b4031d2ea80d1f61b2627313373922ed2e80a76738843c7ee8f0a44a4e05d5")
    assert_vec("R-a256 n96", rep("a", 256), 96, "175o4a7bmls1ICiILm4h1s7K4IcezawHk8qJk2BwLqmy8hiA7DwvfgEBJq8dE8CjL4IJlawurJH4dHCeibIIjGldfwasLG61", "efa1c01e5050c13d4c40e889542c2d9fa446f8f2af14057b7f38021ae600f20640800f655da28a1f3490688cceb170ccd1a2a084fc76ad6ff2e0a1aa70c836b8782220")
    assert_vec("R-a256 n128", rep("a", 256), 128, "gh6EcrpfKllDykIEKBv4pBj0z2mEfouD2bH2dJdwaco5KluIh85mHjnqGvvGohj5wxK21L4e7h0CrvKqbofaezG8vduKcBltBxyxED6k8I4HoD2Ik1E5m8jrljwHHj6q", "2edf48e016a284f9fb00893fd3fe931ea78891fdd4eaa9a12194a3df8888697caeca9c1a9c3e2fa2470242a88b4a0f508ce65ece21d28ac6aa982f0da5c91ea1b9a8902e6812b3633214806751aac87b7de2ab625d805adb86")
    assert_vec("R-a256 n144", rep("a", 256), 144, "1omDfdBegL65lD9C0kuoc9xdLxDz3LCFmJ2uAq973zemolpLiocj3aEr5Cl42Ip5CC5ywGFCtCuE2hnI4guvE5FJE0oHH4A9qnBFAf8DnAdoDonxsLi4Iyb9jEs8bIvlu5c9JyfIxlLF3xJ3", "63e99f8cb1dcfdda464c786cc9400377e2e8130342a8eff1dd9400f6d3d4118d831eef12d6b84310821455af6594757a062e2560ac9282c119601325ee680b0977edc30d97aa2258ed8aa62ba68e72356e826e3f74e8cf5d640c03db29ae2116f3c0c9ad")
    // 非法位长 / 非法 base：一律返回空串
    check("r illegal n0", tsha.tsha1r("abc", 0, 48), "")
    check("r illegal n46", tsha.tsha1r("abc", 46, 48), "")
    check("r illegal n23", tsha.tsha1r("abc", 23, 48), "")
    check("r illegal base5", tsha.tsha1r("abc", 48, 5), "")
    check("r illegal base7", tsha.tsha1r("abc", 48, 7), "")
    println("tsha1r 探针全部通过")
}
