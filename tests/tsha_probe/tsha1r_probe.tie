type tie<logic>
// TSHA1R-r轻量 探针 v2（state-per-n）：公开接口 tsha.tsha1r(msg,n,base=48)。
// 语义源：gen_tsha1fr.py（→ gen_tsha1_core.py 唯一定义）。断言：
//   tsha.tsha1r(msg,n,48) == 生成器 b48 值；tsha.tsha1r(msg,n,16) == 生成器 b16 值。
// 消息集：empty/abc/a1000/a55/a56/a63/a64/a65/a127/a128/a129/a256。
// 位长抽检：{2,8,16,48,64,69,92,96,128,144}（文末合法集内 48/69/92/96/128/144 必含）。
// 非法位长（0/46/23）断言返回空串（无 XOF，非法拒绝）。
import "../../std/tsha1.tie"
using tsha;

func check(name: string, got: string, want: string) {
    if got == want {
        println("PASS " + name)
    } else {
        println("FAIL " + name + " got=" + got)
        println("     want=" + want)
        exit(1)
    }
}

func rep(c: string, n: i64) -> string {
    var out: string = ""
    var i: i64 = 0
    while i < n {
        out = out + c
        i = i + 1
    }
    return out
}

func assert_vec(name: string, msg: string, n: i64, b48: string, b16: string) {
    check(name + " b48", tsha.tsha1r(msg, n, 48), b48)
    check(name + " b16", tsha.tsha1r(msg, n, 16), b16)
}

func main() {
    assert_vec("R n2", "", 2, "6j", "61")
    assert_vec("R n8", "", 8, "3C2gDCaJ", "a40771afac")
    assert_vec("R n16", "", 16, "xly00frLxIB6B8K2", "f46b015aec62ef439c149a")
    assert_vec("R n48", "", 48, "s1z881C7x3z5B118wDqi5o5iJqGrfGit6E01zaqimahEfAd7", "8701c07090a8e44bb9b0add7874c3bd7cca8acfd97824ff595596f6afcdaf3c6a1")
    assert_vec("R n64", "", 64, "56ro4EqcLfCzKbEJglju0KLgcnc81Kymstmqq4z4tfaCFB7pFFhLw7034Ftq5ase", "21e3701479704aab774e11287c78080e54b0ec13bb8418372058007ec0a60322cd253dccfff803dcffc8d095")
    assert_vec("R n69", "", 69, "2d82ccGzcA141gzLij6JEpvftztx1byAGLuxct78EtlIBtowJkCdxKHxiGfypyjIojsIi", "2ab9bc8ec8804da100026dcba0f86966a980e38c40464439d82c514297083016d9c714aadc10022fd928817753205ab6")
    assert_vec("R n92", "", 92, "1IkFE0KagJlyyxumFzjsj180i7JlLBq7nJBi11ivIJdfCbe4z1prqkuiq53B10Cw1FdeuagC1k9e2e1ndx5EIh7rmELC", "8d21d008280043de5c0e4e48bf8a0272bff2ae4aee0e46638ce0126e5c34aba2c0300625e3e2026768221ad2fb2b2365d24613e0e8444b00f74c0afe6e009afd")
    assert_vec("R n96", "", 96, "88E8d0ul7uDBvC0Bp8fz744n3KyqhqbBH5781Gsa0xz6b9Eqm7isxBEfa30DkgH8JyzCG2LdddB5L6FgA29mduf0z98hzkb9", "239560bd899645ebc45e54b16e32328033629fabb196572da8c4319a68e4a9bd480024e565120961edc60001f7a302b5dc8c09b56e20504669ba44811dfceafbf918c1")
    assert_vec("R n128", "", 128, "8brlC3K2LIrfLDk548zDsjt2a3c1xLooLiqnlf9pjfziy02sc7jxk8yrlr6I5os0quE202f9ej292FEBHbFboBsxeyAe61ckyggg18J9JLLf3jBjvv1HH80wBcrEJuGu", "179d808ed1eae6b480c2af0414dc0713e2ac43b128049c5b0b8c9023e36cf2f3215609bce4ba9867b938294f507842c2dfbe90d7e2fc91e50e58d2a3db1331f5c79038a24aace18a698820c6fd3e14e1f58c40a7b68c89fa7d")
