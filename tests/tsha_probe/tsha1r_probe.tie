type tie<logic>
// TSHA1R-r轻量 探针 v2（state-per-n）：公开接口 tsha.tsha1r(msg,n,base=48)。
// 语义源：gen_tsha1fr.py（→ gen_tsha1_core.py 唯一定义）。断言：
//   tsha.tsha1r(msg,n,48) == 生成器 b48 值；tsha.tsha1r(msg,n,16) == 生成器 b16 值。
// 消息集：empty/abc/a1000/a55/a56/a63/a64/a65/a127/a128/a129/a256。
// 位长抽检：{2,8,16,48,64,69,88,92,96,128,144}。
// 非法位长（0/46/23）与非法 base（5/7）断言返回空串（无 XOF，非法拒绝）。
import "../../std/tsha1.tie"
using tsha;

func check(name: string, got: string, want: string) {
    if got == want {
        println("PASS " + name)
    } else {
        println("FAIL " + name + " got=" + got)
        println("     want=" + want)
        exit(1)
    }
}

func rep(c: string, n: i64) -> string {
    var out: string = ""
    var i: i64 = 0
    while i < n {
        out = out + c
        i = i + 1
    }
    return out
}

func assert_vec(name: string, msg: string, n: i64, b48: string, b16: string) {
    check(name + " b48", tsha.tsha1r(msg, n, 48), b48)
    check(name + " b16", tsha.tsha1r(msg, n, 16), b16)
}

func main() {

    assert_vec("R n2", "", 2, "1l", "15")
    assert_vec("R n8", "", 8, "23yLpimi", "59db7f7cc5")
    assert_vec("R n16", "", 16, "sB18ELubegD4Bgzs", "d23790cc081eac69115ca0")
    assert_vec("R n48", "", 48, "jAiA7kDa4FHajIFu0AHylqG99KlKvwpwjLEnt2brzHGI0mtt", "5f250615674038dfb21816acd9c495f8e570b04914a0b11ffcff092db02c166d11")
    assert_vec("R n64", "", 64, "Bz3v0m1phvwCq779ls1uqLmGkDpDAm3spL086g3jtJA3qmkc5aghwa6nB7JLEDmc", "f8e9014a0088cf2ab9c2fa50e514d8407834555aab3c42e8aa90645e9bf610a603a106fff790c0ce2c2c85d8")
    assert_vec("R n69", "", 69, "c6B80tpLwa77IqAKHu37olbjIekKKs9wEpqobpgBfH8jjEIG2v4ej0se1IJ7I0f7CtwA8", "e41563038056d328d15af11c32121db0f43406005838ae1de6a00a8354e2472d26c10ce1b4800cf227bac70e4f103100")
    assert_vec("R n88", "", 88, "8ddGEEhg56tbzG2scuor21ALDKr7ziEDBqrcDbliLz4Ay288CtKm2I6KxEc4AD2Cwprii7oDmIwAiAGAuACK7oat", "d503c36e4596fbfaa45ef0b0fdfab7062438c71f460c0d75d398087ad582b20cdda8515ec0e87820b973d8f6ed9e198dec2a2dbe2a389a88ab3019013d")
