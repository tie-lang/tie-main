type tie<logic>
// TSHA1F-f高速 探针 v2（state-per-n）：公开接口 tsha.tsha1f(msg,n,base=48)。
// 语义源：gen_tsha1fr.py（→ gen_tsha1_core.py 唯一定义）。断言：
//   tsha.tsha1f(msg,n,48) == 生成器 b48 值；tsha.tsha1f(msg,n,16) == 生成器 b16 值。
// 消息集：empty/abc/a1000/a55/a56/a63/a64/a65/a127/a128/a129/a256。
// 位长抽检：{2,8,16,48,64,69,92,96,128,144}（文末合法集内 48/69/92/96/128/144 必含）。
// 非法位长（0/46/23）断言返回空串（无 XOF，非法拒绝）。
import "../../std/tsha1.tie"
using tsha;

func check(name: string, got: string, want: string) {
    if got == want {
        println("PASS " + name)
    } else {
        println("FAIL " + name + " got=" + got)
        println("     want=" + want)
        exit(1)
    }
}

func rep(c: string, n: i64) -> string {
    var out: string = ""
    var i: i64 = 0
    while i < n {
        out = out + c
        i = i + 1
    }
    return out
}

func assert_vec(name: string, msg: string, n: i64, b48: string, b16: string) {
    check(name + " b48", tsha.tsha1f(msg, n, 48), b48)
    check(name + " b16", tsha.tsha1f(msg, n, 16), b16)
}

func main() {
    assert_vec("F n2", "", 2, "fD", "f0")
    assert_vec("F n8", "", 8, "4GIfA4jr", "d3ab7df44d")
    assert_vec("F n16", "", 16, "13CLjw4fAyg7Lc9C", "84f065c41ae315c3bcac8e")
    assert_vec("F n48", "", 48, "6yejy5junnw0CcqquHwbDhyA1bjE7oaA6vaBCrytfl9A0z61", "03fcc1d22aa2d51ee066cad12aee9452bf045d20b8381e84f6cf586b8432bad3d5")
    assert_vec("F n64", "", 64, "b1L8vgC3cCBDj0DtDj46CkAv9d8fgEtIj5fywdvsIHp2g6hezLl5ynun46ACLq8b", "97683b904b133bf47fb67e78cfee78295c03fbfae3aea21371f47c119face407fdb9533549fb1d9e11bd41a8")
    assert_vec("F n69", "", 69, "2pjkhqw7hpesfmHDAFdwihCxo4jvdwHClJ9g1ad1BhpgIcBrebJE14fnD2hsE98lJauHz", "62c41916d23dd2dee1edf2c3a118e92be62450734163679f86575218b9eaa8a5e6c183bf758d4aee4065902ae3304b18")
    assert_vec("F n92", "", 92, "i979v6jKcg1wjnavKz9wpjmnfj3sKGsJ5axivsiqJGCjfqid0zxqjnzB9I5oEA5eal6vn1sbgH3Ko0wHFFmxeabs0cpI", "1446042226215dc115a414924b40ebe766f0430e3a24736b0abffb306204528a58e1bed6548d087efad9a46a7469025e11623b3bc0c77d9a40929ae7bb4ab6f2")
    assert_vec("F n96", "", 96, "i979v6jKcg1wjnavKz9wpjmnfj3sKGsJ5axivsiqJGCjfqid0zxqjnzB9I5oEA5eal6vn1sbgH3Ko0wHFFmxeabs0cpI8Lbk", "1446042226215dc115a414924b40ebe766f0430e3a24736b0abffb306204528a58e1bed6548d087efad9a46a7469025e11623b3bc0c77d9a40929ae7bb4ab6f21017b6")
    assert_vec("F n128", "", 128, "kf3x6G14G810BamwwoBBdLspkffgdgIFwfe2ct76vApiqx0D88zfxInws44CxkeeHvf32fBECc4jeKoinlD0czy9Jig586xr35ju98ItI82Cuop475yjeHtxxyy4n2aI", "fb83b08ca1d1e94489fe07ae8e222bc9183a09f34942a386c0302ede7712544a1729fae23f6d5dfd8a40cfce99d19740e5ad8acf5d59aaf3699fe7f73a768792dab646f6e2cee9ea51ed8453cf95c8f98f6278b72dfcf73227")
