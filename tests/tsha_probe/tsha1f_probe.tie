    assert_vec("F-a256 n144", rep("a", 256), 144, "6DtmlAv9r5I09AyC2BjGhsd5lzroAiKEysFaCltg5oqsbh0iuCxgH6GjqkyG1IgHDwdf5xJg4lymswH6qLJG7p8LodrA28lJnnwFi493loKz6x7sBHEnhdxwcIBs87gmA7Dihrm8a0rnmF4g", "28a78845f1df12086bdc4dd079d1bc4d511f045d47305da0317ce6926b7ae391c942cc6229ce3340cc499dfd4c49cc8131f183947c42e7a5b8436bfa1b799122fcfc9d4949bbb18385a8967e60b61ca8cb05f1cb954e48641812cd0c524280dd0faea316")
    // 非法位长：一律返回空串
    check("F illegal n0", tsha.tsha1f("abc", 0, 48), "")
    check("F illegal n46", tsha.tsha1f("abc", 46, 48), "")
    check("F illegal n23", tsha.tsha1f("abc", 23, 48), "")
    println("tsha1f 探针全部通过")
}
