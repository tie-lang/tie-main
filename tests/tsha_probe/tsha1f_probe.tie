type tie<logic>
// tsha1f-256 探针：默认输出 base48（46 字符）+ `_hex` 保留 64 位十六进制 +
//   b48↔hex 往返一致性（decode(tsha1f(msg)) == tsha1f_hex(msg) 字节一致）。
// 正向向量：空串/abc/1000x'a'/55/56/63/64/65/127/128/129/256 字节（同 gen_tsha1fr.py）。
// 说明：tsha1f 内部哈希字节不变（f=256 位），仅输出层编码在 base48 与 hex 间切换。
import "../../std/tsha1.tie"
using tsha;
import "../../std/base48.tie"
using b48;

func check(name: string, got: string, want: string) {
    if got == want {
        println("PASS " + name)
    } else {
        println("FAIL " + name + " got=" + got)
        println("     want=" + want)
        exit(1)
    }
}

func rep(c: string, n: i64) -> string {
    var out: string = ""
    var i: i64 = 0
    while i < n {
        out = out + c
        i = i + 1
    }
    return out
}

func prefix(s: string, k: i64) -> string {
    var out: string = ""
    var i: i64 = 0
    while i < k {
        out = out + str_char(s, i)
        i = i + 1
    }
    return out
}

// 断言：tsha1f(msg)==b48（默认 48 进制）、tsha1f_hex(msg)==hex（_hex 可选），
// 且 b48.decode(b48)==hex（encode 前向一致）、b48.decode(tsha1f(msg))==hex（往返一致）。
func assert_vec(name: string, msg: string, hex: string) {
    check(name + " hex", tsha.tsha1f_hex(msg), hex)
    check(name + " b48p", prefix(tsha.tsha1f(msg, 64), 46), b48.encode(hex))
}

func main() {
    assert_vec("f empty", "",
        "45f2029d37ad41cf835735aa3f0c1b64a2980fe264f83d3508d1011964713550")
    assert_vec("f abc", "abc",
        "f38e5ae5a532e4783578d24c7ade7a9cfcb1f3849a295c9992043c179d8d26c0")
    assert_vec("f a1000", rep("a", 1000),
        "27bce16351ee687d56541ea8b0339f01b9c76931c57650982488e331ceb54ebd")
    assert_vec("f b55", rep("a", 55),
        "edcba1590b21d9fbbe48976bfbb591b1bb66be4077d19d2cd5006a22a7efdf2b")
    assert_vec("f b56", rep("a", 56),
        "0f6fd8de8bcc355122b641d95e90c87a8d19d2595746deb023529c48a9b7b7b0")
    assert_vec("f b63", rep("a", 63),
        "8c4882ed6397154efc5e12b85713fd441fcbe0f41d80c1689be184e12e0a5fdc")
    assert_vec("f b64", rep("a", 64),
        "a1a02538307f84b910cab49fdb4e8eefe616e9dbd36f23bb9fd7bbe47b569a50")
    assert_vec("f b65", rep("a", 65),
        "36456c014a1110e591c00394ce8eef4ea3935369a375e393167536aa9c53773b")
    assert_vec("f b127", rep("a", 127),
        "fd8358daad3dba380035e606ee46c99f8630d4441de2b28497bec085523eb566")
    assert_vec("f b128", rep("a", 128),
        "d5c0cee7fa85226a33933f0f2457919ea215aac46e950ad1bd821df4046daee1")
    assert_vec("f b129", rep("a", 129),
        "253993981ba2f11c427483ce5d0b337bf81b340ff84c511c77880af309545fc9")
    assert_vec("f b256", rep("a", 256),
        "e4f3982c290b79dcdc9fc5aeafd787325e22ead35baa4d5a99ddafce0f983b40")
    println("tsha1f 探针全部通过")
}