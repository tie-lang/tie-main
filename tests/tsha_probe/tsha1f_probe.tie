    assert_vec("F-a256 n8", rep("a", 256), 8, "lru8rCod", "1370a182ab")
    assert_vec("F-a256 n16", rep("a", 256), 16, "D2bt10jAvlG9Ag7o", "02165280b8fba8ff9df651")
    assert_vec("F-a256 n48", rep("a", 256), 48, "6aK4E03kqh9JidyzpF1yc4p49IHcxhlb2uDdfF4HnJBF3v1B", "b1883520542cff4d818108a4383f402b5952076bd2194cea9206e29d63356eab72")
