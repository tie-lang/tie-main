type tie<logic>
// tsha1f-256 探针：默认输出 base48（46 字符）+ `_hex` 保留 64 位十六进制 +
//   b48↔hex 往返一致性（decode(tsha1f(msg)) == tsha1f_hex(msg) 字节一致）。
// 正向向量：空串/abc/1000x'a'/55/56/63/64/65/127/128/129/256 字节（同 gen_vectors.py）。
// 说明：tsha1f 内部哈希字节不变（f=256 位），仅输出层编码在 base48 与 hex 间切换。
import "../../std/tsha1.tie"
using tsha;
import "../../std/base48.tie"
using b48;

func check(name: string, got: string, want: string) {
    if got == want {
        println("PASS " + name)
    } else {
        println("FAIL " + name + " got=" + got)
        println("     want=" + want)
        exit(1)
    }
}

func rep(c: string, n: i64) -> string {
    var out: string = ""
    var i: i64 = 0
    while i < n {
        out = out + c
        i = i + 1
    }
    return out
}

// 断言：tsha1f(msg)==b48（默认 48 进制）、tsha1f_hex(msg)==hex（_hex 可选），
// 且 b48.decode(b48)==hex（encode 前向一致）、b48.decode(tsha1f(msg))==hex（往返一致）。
func assert_vec(name: string, msg: string, hex: string, b48str: string) {
    check(name + " b48", tsha.tsha1f(msg), b48str)
    check(name + " hex", tsha.tsha1f_hex(msg), hex)
    check(name + " dec", b48.decode(b48str), hex)
    check(name + " rt ", b48.decode(tsha.tsha1f(msg)), hex)
}

func main() {
    assert_vec("f empty", "",
        "049a7e459a4558bced881efef7b15a0f29a306bd95cd898645df15d9895fcd9e",
        "0m3u3wCBm8jIfi5rrFtxAwmcwoy0LJ2z8JkHfiveDyK53e")
    assert_vec("f abc", "abc",
        "2c3fe6f973eb8ea150c24d8c5a20ea38f0a4d5590c58b868806dacd32eda3cd4",
        "4k9fLH4umbD1AJa8m9mAeEixfxyJLAHva9n881i7vsrj9A")
    assert_vec("f a1000", rep("a", 1000),
        "9f74677d24005bc307237035d0ebacad5ca178b8378938f7b40c7976f1611336",
        "fIv624belFnfDprJiIoCJf7q1EKKmu15Bss6kbpEef1b16")
    assert_vec("f b55", rep("a", 55),
        "76d2b4e936ff645c0236892ad9871ecf5f36cf7e42319a2c31043659a0caf68a",
        "bFCry32uI3htp4oxA8oxGg6xggCB8vlLzDbgvb8vegfKJq")
    assert_vec("f b56", rep("a", 56),
        "4bf3d38aeac9db1135b302387c0b8e0fc75cfac321f09f7eddb07e64fe991b6d",
        "7savubC3Hh3nxn9zw4lv696kIfkpA1AitEdws8Bw7dq6sJ")
    assert_vec("f b63", rep("a", 63),
        "256aa8c064490ac5803067d8a979ec6f49521a05f410ed23891a2238315f5f7e",
        "3zkp8rILchAGm7m5dsDu486EEIerr9tHzu3A64yCab2siu")
    assert_vec("f b64", rep("a", 64),
        "61d24c5db1b2697021db71261e4b4c0d53b65851fabfafb489cea6d5910976b7",
        "9B4luEBiaA3k15h5lJ0LncJiDaz98sDCjv4KwLqzhc7KKn")
    assert_vec("f b65", rep("a", 65),
        "e88b6b13b9ae0f0f6d19821784805d0d1d43efec194dcb59ea090d8911610f62",
        "nb6Gq9xejeAs0exyakqA02A2alDsG8kq8mwIbvkqCjABcy")
    assert_vec("f b127", rep("a", 127),
        "3f686db05da9cc56c7a9fce744753a6f2d6c517ced4553202c9e135ac6fae824",
        "6g38eD9zDvKcJqwoquELev7zG8Ew8jCknJoBxzw6bvgpC4")
    assert_vec("f b128", rep("a", 128),
        "a676a707c3e6a21cab96f033617ef5bf77bef7f7814fa357e410e2ab6ae42c9d",
        "gucjarpioqceBsvwKFsckjjAfsmjw273Ffp020FAc21dEt")
    assert_vec("f b129", rep("a", 129),
        "1a65838bdc779d2f19c278d393caea5c11507eca23535232cf63e7ffc93761d8",
        "2urIsu7u10zbB7uaE7IzLa5rB9LI4iEAH2Ebv1AuaaqGFE")
    assert_vec("f b256", rep("a", 256),
        "6dd037f01f5d1f8fdc35e14b1b4cc9e2af75b832557bbc988bcb974e3f5f0ee8",
        "aKsyLrLhwD4aeagunyix664fdfCdnd0unh5LLcxtgnecfo")
    println("tsha1f 探针全部通过")
}