type tie<logic>
// TSHA1F-f高速 探针 v2（state-per-n）：公开接口 tsha.tsha1f(msg,n,base=48)。
// 语义源：gen_tsha1fr.py（→ gen_tsha1_core.py 唯一定义）。断言：
//   tsha.tsha1f(msg,n,48) == 生成器 b48 值；tsha.tsha1f(msg,n,16) == 生成器 b16 值。
// 消息集：empty/abc/a1000/a55/a56/a63/a64/a65/a127/a128/a129/a256。
// 位长抽检：{2,8,16,48,64,69,88,92,96,128,144}。
// 非法位长（0/46/23）与非法 base（5/7）断言返回空串（无 XOF，非法拒绝）。
import "../../std/tsha1.tie"
using tsha;

func check(name: string, got: string, want: string) {
    if got == want {
        println("PASS " + name)
    } else {
        println("FAIL " + name + " got=" + got)
        println("     want=" + want)
        exit(1)
    }
}

func rep(c: string, n: i64) -> string {
    var out: string = ""
    var i: i64 = 0
    while i < n {
        out = out + c
        i = i + 1
    }
    return out
}

func assert_vec(name: string, msg: string, n: i64, b48: string, b16: string) {
    check(name + " b48", tsha.tsha1f(msg, n, 48), b48)
    check(name + " b16", tsha.tsha1f(msg, n, 16), b16)
}

func main() {
    assert_vec("F n2", "", 2, "b3", "a8")
    assert_vec("F n8", "", 8, "5juavlyl", "e9ee35b528")
    assert_vec("F n16", "", 16, "2Bj5usI4DKgC7iHw", "07217255c5e185067376e9")
    assert_vec("F n48", "", 48, "2d3GdBwF55vIHExJ95jGyrEmBDd6p9e0DCEnwHbuFqyBB5dC", "40c68f5ad8435b8ede3430297b94da09f8fbd5b6afea8989beaa9d1e3f9584757e")
    assert_vec("F n64", "", 64, "dmgk5hJ4DB5p2hFeyFyJD9Ev5fykg0JgmFGtFfw9L2Av6I2GD5vqdj0A6ag217Gx", "b8a624b43be7f05d1628157970c04bf33556753304f3c1af363fe6023499549ce6a865fc523bc8fb11572a37")
    assert_vec("F n69", "", 69, "1oH8i7u4pxtArqrrFeyLbHf6hrGhLlmbbgIpGJ6g7bDbh2KlEs7p1C8Lk3CFzvfyCviL9", "3b4e42a0f57ce0cd4bf7c0a8198a615d33ab57f7dc74dd651fe59fbf865176ac6618c32f54465688eb89436ba8385454")
    assert_vec("F n88", "", 88, "8JzIFxEbrfI9KIstmyjIhvxwpJEdhL75DFwLBbd1hAovz86wHgppCA5jCaLKKGfyIxAE6F5xAiveq34Abl34bHly", "a8316c1b38c02347b2a6bccb30664356161e0cdbe4330be706d8d96c0c3fb7e3276f933978d316978f9c32d27d9c14808520ac7f52b87d791c5b446f4c")
