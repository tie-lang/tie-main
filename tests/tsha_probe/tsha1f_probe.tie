    assert_vec("F-a256 n92", rep("a", 256), 92, "bFlLyupCnx9Jk98zqstJ2dKEGaxmjg8l3hmdlJdHbsdlh3owK8msxJkfAza9djdHDbKb1d33xc0Gk8E9d4eqjxdjkKbH", "0d38de229d27f331bed649312435f53c65f78ddf524fe8248b7d2a5232b5070ff01d8c3043607c8d27a2cee831346bdca98e6e396e60b5f7fbd5f680470cabd5")
    assert_vec("F-a256 n96", rep("a", 256), 96, "bFlLyupCnx9Jk98zqstJ2dKEGaxmjg8l3hmdlJdHbsdlh3owK8msxJkfAza9djdHDbKb1d33xc0Gk8E9d4eqjxdjkKbH0q39", "0d38de229d27f331bed649312435f53c65f78ddf524fe8248b7d2a5232b5070ff01d8c3043607c8d27a2cee831346bdca98e6e396e60b5f7fbd5f680470cabd5803bfc")
    assert_vec("F-a256 n128", rep("a", 256), 128, "9wszdD4pAsk0gmBAesllmm3mtjxcLHz14sCuoG47uEtddhctD8rE0rsjpJ2dAgst30nDuyi89d4IiErl3kKxsuBgvJ6bck8a5joAdKkFLjmLBJ0EnHJm1CLB5cf8JBHp", "77d70d185f9c226ba6fecd95333258fe49f17a602c135998c41790cf51fac045e4264feac19b79b5ad92e79ca6e99d02cac42788841d755a14021787f24bdd110343d5d733d91cc0773dc8460e4415e99a3d9423cefc564ae2")
    assert_vec("F-a256 n144", rep("a", 256), 144, "eh9fgdJrs52rdr7BmsaB8eupfIB9uHwB8fscacgEInte4EL5LKuvrq56iJ384m9olldEHjvpCEkamF2maiI9EGCs5vt4e4ot3iHa3HIx5d5bqg0q0ltf8Eza7d9dAICjpii4mdk5zL9AyrhG", "55861898f8e0580c1a72d82f963a6083053d86804b1a03e9f2e3a723344652526b2c22f4bf133954ab8cbe878814709cb75eb25eaa58db278664b1e31f7c377d6e7d613c1e6ab558ceca3cab3e865133a712f310b22fae17c16e1fa0341213b06160b5bf")
    // 非法位长 / 非法 base：一律返回空串
    check("f illegal n0", tsha.tsha1f("abc", 0, 48), "")
    check("f illegal n46", tsha.tsha1f("abc", 46, 48), "")
    check("f illegal n23", tsha.tsha1f("abc", 23, 48), "")
    check("f illegal base5", tsha.tsha1f("abc", 48, 5), "")
    check("f illegal base7", tsha.tsha1f("abc", 48, 7), "")
    println("tsha1f 探针全部通过")
}
