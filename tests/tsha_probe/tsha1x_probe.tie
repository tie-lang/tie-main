    assert_vec("x a129 n=128", rep("a", 129), 128, "1f7dptorrH8iItc2aLrJt7Hd1EHEDtzF4K3n5lpL12JBxzeyk4057qJtt5mpKjkmmq5be94E13oj44D6ebtAKA6okyfzaj3z8Hb3oeDrf0shGc9mDdyHjdAmunEr1k0p", "104a200262385eea4c00ba547cc0d927bdb61cdc7c98fd9cfd91be3e5daf490704ea6ae7c9607a90e18f9a1beadf362de586d841a0a5a58effefba985a65298096f295e36385f6b36fa3999903e50dd942a4d7635d68bb3cac")
    assert_vec("x a129 n=144", rep("a", 129), 144, "o8z655rKqs5I4EgeBdKysuFGqhv000cLpoE63FCli2ysmw3qswo47yJdIyrE6nv8jabdctEaxk3m9F2GzA7ha6Dfs7ji52jKonjI3ljavqez2tm6vLalKKLABwKk4247w8GCKJasy3pzBCEd", "9009c0519bc004a873bfa282b050fd50cae936d54d79d7fc98eec3456d631d487d59a45102385819494e128b39cf013bb2b9d0c4d13b2835d90879fd3234c0c38dbeb2520c386006bbb85f1be8a24ef93111e73c795c1239c63fa5955ca2a614aa338a91")
    assert_vec("x a256 n=2", rep("a", 256), 2, "cG", "c3")
    assert_vec("x a256 n=8", rep("a", 256), 8, "5enzJvb4", "e54dcdb2df")
    assert_vec("x a256 n=16", rep("a", 256), 16, "hIusogD5hntf7w2c", "2e011ec79510863c4b3d14")
    assert_vec("x a256 n=48", rep("a", 256), 48, "4fg0CIkHljvrdCoyrL8s0Eagijc55xKziKzmam4DjK6pza8f", "7b1f0903bf9dbd6459650a68e4199fe6ba8c572653183fcc066abc99dbc2d6a608")
    assert_vec("x a256 n=64", rep("a", 256), 64, "aocJgGF32gmi9LtrcIt56smfsIuigrbxmp1ebbt6EdK137bjmL8vAziLst6DomGw", "900fb2c3bdc474b584164a6784e9a18e88fc3a558836ddef55d5bc62af71300c9c943b412b09634ac888c2a0")
    assert_vec("x a256 n=69", rep("a", 256), 69, "6mmmuhxn15deutDGAxhKqlhcnmnxLe9a4h9665yji820xbLft9eC8wh9JCmriHnaDnC4C", "fc93056b2b0b256044f859a5060e1fd292871017f2f26aaaf23dd3575d0ebf1a078590bc54b7cd458e3d1096afc9f5c5")
    assert_vec("x a256 n=88", rep("a", 256), 88, "2c3uoFzwaryHz3Iw5Ipzg1qshHnatkE9FmK3ghIGq2sG90tlECl57395cr4bBrhd6IIj3y4qs631ilmeFx6x7B4a", "2a4c563846f1dc7fca5cdb0bc6254db9a13524cd6e500b6fbfeb7b8a547bd5376c3c35ed4517b8e68e1ec0e5442eb472fce4eddb98a75116215d20076c")
    assert_vec("x a256 n=92", rep("a", 256), 92, "5ktn5F25Ays9xmv3JayFreah7ipGLuygndA6AHwDiGq7z6gHJLkbI0k58B2279H4u72oahCdu8x9lwEomEmxFrb1flk3", "060d1832d18831f4b4af2bdbacc01dafc7a1588b1c55e1c3f9e4704de0750df37e2b897575d8361e9510c0e86247d913913fc053baba6d785d63633bdc702d0e")
    assert_vec("x a256 n=96", rep("a", 256), 96, "5ktn5F25Ays9xmv3JayFreah7ipGLuygndA6AHwDiGq7z6gHJLkbI0k58B2279H4u72oahCdu8x9lwEomEmxFrb1flk38shy", "060d1832d18831f4b4af2bdbacc01dafc7a1588b1c55e1c3f9e4704de0750df37e2b897575d8361e9510c0e86247d913913fc053baba6d785d63633bdc702d0e9447df")
    assert_vec("x a256 n=128", rep("a", 256), 128, "63a3oHJAw5yhrDGCcA6iDxenj5rydp1jCkEweEDoGpxmfg2gnIcj3tKxw3wixmvklCJB2o3IffxsptIx2no0l5lz2xq5EKGpEbv3qewrr9Ffec6kDmud3v7wvi2C6jwf", "4b1d976950614dd50570e98997c96c23bce1b684a890c608df3565b6c357d6ada9744cf4f534e7d5afb235140b01937bba479fd144b774fdcad292a22c89eeeb6a58a9ce00097aab00e145e76f4d14d9e39dc1822e6b9fb226")
    assert_vec("x a256 n=144", rep("a", 256), 144, "80I93twzG5h83kHbfK77ybKJgFLEHatBqC7pqtCKnIq5HzBpyHfjx0e6BFlddu0eagengdiH0kCfhggnLDauxai89i8IjwEBKirvfK47GKGH9sGpJFaal13zk4BueFodBJqC0wB8Lx9Dxtz3", "2fc408619f665ebb69b69472b9a209637dd18a00b6b6dc3c1a86cd906bfb6190b98f7e90f0a82603e0522a7f573ad392c6cbd9dde159f0bfd273141f1439ec8e0a52814ec1a78bbac17e3e9f1fee56bb83b46009b2e7315d1489095d3dbc87fb23cf67f0")

    // 非法位长/非法进制 → 空串
    check("x badlen 5",     tsha.tsha1x("abc", 5, 48), "")
    check("x badlen 5.b16",  tsha.tsha1x("abc", 5, 16), "")
    check("x badlen 7",     tsha.tsha1x("abc", 7, 48), "")
    check("x badlen 100",  tsha.tsha1x("abc", 100, 48), "")
    check("x badlen 13.b16",  tsha.tsha1x("abc", 13, 16), "")
    check("x badbase 7",     tsha.tsha1x("abc", 48, 7), "")
    check("x badbase 15",  tsha.tsha1x("abc", 64, 15), "")
    println("tsha1x 探针全部通过")
}
