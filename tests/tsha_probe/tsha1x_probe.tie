    assert_vec("x a129 n=128", rep("a", 129), 128, "b8en5qlfKDyqv5rhsskkfHtdJntowDD6yj6lhgLkErtu3qu43p7fe6jADdC8Enrfprz9jshHEGjKiD9ui5pEFLeoCJ9IF6AJesA1EpDa1L4bggvJJAKxecf9D6vf0vwb", "8a55d9d1da0674088f69b59ee5aac0cc9a453069bfa25d767fbae65e63f24061881ebec92a5de9e30a8ab96d6c8d37600dc20d79f43add42af3313a66adc44e4998b67da387d1efc52d82762de9b988d44429b0679fb3e9930")
    assert_vec("x a129 n=144", rep("a", 129), 144, "xndwG5pEoh98qlbhjKKHG5df3sgjIAomEjBxiqH2shpiCHhIK0yFqDpIcoFyEbuKkerJ8oai7EgfIssA2Lv9gkh3rHckmJ6kC3ihff9mrw9ahroIFEu70uHdAAH9JKAre27oKn6htxpcc9t0", "c773b600b8d47e41948d0c00f24bfc67117f8a43268dc0c069a8344da273262ae7dc1b97747f6809b2cfcdf8e53d8276a2ad6ce2f3c7cc658d069354cc3f3890e8d3774cca9d2d1f3bb9a304b5396c92f0486daed1bb4a30a79a35b3b27e3e568a7413ec")
    assert_vec("x a256 n=2", rep("a", 256), 2, "bG", "b4")
    assert_vec("x a256 n=8", rep("a", 256), 8, "2GGf0Axi", "7d226eb77f")
    assert_vec("x a256 n=16", rep("a", 256), 16, "1z5tq6xo9ajkH64y", "d542a20fac87d25a92fdf2")
    assert_vec("x a256 n=48", rep("a", 256), 48, "7Ii1l4IzxnaKgGhouavbLII3795Kwk4ek3qjz54Az0fqrhs0", "e1e102ea37aeb6dbca30c360308e8b4780a7a3d791d113ee7eed582539a3cdc6a2")
    assert_vec("x a256 n=64", rep("a", 256), 64, "4xCrA9u1Hbey9H4xr9uF1mdDHvekjF0ecq0tGsGL0C0FEg6dc5cvtyo0G8k6a9ca", "4082201ac035a9b135371bf98c5fa07edeed4ae905e2809c29b6523f73c2a9c6f3b054b27b638439b9aa8e5b")
    assert_vec("x a256 n=69", rep("a", 256), 69, "28vtg3pduGLmeIBAgJKgdG0CAF0tHpc6GogaueF76K8B4j5gtFim5tHu9m6ttgal3pIfl", "55248102e238f01eedffde1bcd5a6141e647b502bff8e364f55134ef0bc86eced75efbd4e647eb772e935d2d1ed3fd9c")
    assert_vec("x a256 n=88", rep("a", 256), 88, "ci3hhdgnywviwyzHCK6wErGEKewrCiBl9jAGjHI61BvwgazndkCslkxGhmH04BbfGE7ub8L5LxIonvEbtaa7vyBe", "e881210eb0d21fab85b86c9d64f4ccd2d367d0758ca0ee95058df725d5a2c8be01bb756ed200d08d2e3c4f6251491d8431b7dc08f37a8f7529455c3758")
    assert_vec("x a256 n=92", rep("a", 256), 92, "16DyKwirKCecIsgC4tKxEGqd0zj6vcAxie5tduJCftij6y85fzoIprzbhxmxz47y7FKeq1DvoHsbF2neHJEKELko0kjc", "3d1b083d3a30117090f9b9122c9e179f1f028c4b17ae147a4b3c3527903833e68d764b36b3ebea38a84c1fe330bd2fc43d187f3caf7dd9a186bcda0a655aa2dd")
    assert_vec("x a256 n=96", rep("a", 256), 96, "16DyKwirKCecIsgC4tKxEGqd0zj6vcAxie5tduJCftij6y85fzoIprzbhxmxz47y7FKeq1DvoHsbF2neHJEKELko0kjcJnB6", "3d1b083d3a30117090f9b9122c9e179f1f028c4b17ae147a4b3c3527903833e68d764b36b3ebea38a84c1fe330bd2fc43d187f3caf7dd9a186bcda0a655aa2ddeef5a9")
    assert_vec("x a256 n=128", rep("a", 256), 128, "9gli0qBDGGBtes5Ff7gLeD9ssJrwll0y51n19cAJaFEjKhDHgil8vGF23w28d4g0ghEjsnbki2kiECAeJu85Lfzc8aGj747vDEtvpKpjCBLc6Cszwaw5HJ3e9z0JqtoH", "73ac64156c23bf3d11e17680b9dbd5fc417689ec77cb745846c42818716ae2df65f35344db1a3b167a6d718c1216ad14bdb6aff2a398e060f88f3664cad9f95a58cedc285471190153d79a5148eab9601baed8fbb888da82ef")
    assert_vec("x a256 n=144", rep("a", 256), 144, "lpA0pilEgm5lzCl1osAB26gDx1gDGBFw3gBGnAFFvcCfuroDfswqd0D5BltCbLd4tDCEEem9a7mg97d9AeBdbpfyG4HqCf64qufqctk7pyy2j4fGn7Gj0BBrkJidhvAbkd8hdniu6sypIAr7", "8047d767cdf1e90659c89dd2d18b6c56dee9f1e1d326f0a5d3dc86214f4fd5bec47812a3763599778239c59c3fab2ea0c5c8006edd0bc133585e4b5d7c68fca8922fd89d26404172bdd83880de6144ac01cf4ad3c0672439d3d8ad6b55595177ff5c4fe2")

    // 非法位长/非法进制 → 空串
    check("x badlen 5",       tsha.tsha1x("abc", 5, 48), "")
    check("x badlen 5.b16",   tsha.tsha1x("abc", 5, 16), "")
    check("x badlen 7",       tsha.tsha1x("abc", 7, 48), "")
    check("x badlen 100",     tsha.tsha1x("abc", 100, 48), "")
    check("x badlen 13.b16",  tsha.tsha1x("abc", 13, 16), "")
    check("x badbase 7",      tsha.tsha1x("abc", 48, 7), "")
    check("x badbase 15",     tsha.tsha1x("abc", 64, 15), "")
    println("tsha1x 探针全部通过")
}
