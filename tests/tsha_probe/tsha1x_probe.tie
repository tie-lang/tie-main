type tie<logic>
// tsha1x-256 探针（v2，state-per-n）：tsha1x(msg, n, base) 对任意位长 n 断言
//   base48 输出 == 生成器 b48 值、base16 输出 == 生成器 b16 值。
// 消息集：空串/abc/1000x'a'/55/56/63/64/65/127/128/129/256 字节（同 gen_tsha1x.py）。
// 位长抽检：{2,8,16,48,64,69,88,92,96,128,144}，含 W≥16 档 88/92/96/128/144 以覆盖
//   海绵率/LFSR 常量路径。非法位长一律返回空串。
// 语义源：tests/tsha_probe/gen_tsha1_core.py（逐式镜像；无 _hex，无 XOF）。
import "../../std/tsha1.tie"
using tsha;

func check(name: string, got: string, want: string) {
    if got == want {
        println("PASS " + name)
    } else {
        println("FAIL " + name + " got=" + got)
        println("     want=" + want)
        exit(1)
    }
}

func rep(c: string, n: i64) -> string {
    var out: string = ""
    var i: i64 = 0
    while i < n {
        out = out + c
        i = i + 1
    }
    return out
}

func assert_vec(name: string, msg: string, n: i64, b48exp: string, b16exp: string) {
    check(name + ".b48", tsha.tsha1x(msg, n, 48), b48exp)
    check(name + ".b16", tsha.tsha1x(msg, n, 16), b16exp)
}

func main() {
    assert_vec("x empty n=2", "", 2, "6q", "63")
    assert_vec("x empty n=8", "", 8, "31br0hvo", "82dd493d47")
    assert_vec("x empty n=16", "", 16, "vHz9xLvgbB0Ay7H2", "51e08582e8aed7ae9d8f53")
    assert_vec("x empty n=48", "", 48, "x4KCu7mLpuyaCEDgmIpIEAGuFJgaeuftudxbhiJ0gBAr1f5v", "13a871850b0e89abf5664c2714e4d2c7c831f3f118ebd7146a7667f8dedd06024e")
    assert_vec("x empty n=64", "", 64, "9g4pIxF6BhL4HKjvwDxuD1eemBlqBIfx2uFLvp3otncFEDIK5mADA5pbdztplEdA", "80035704dfb6a0e34ba23deecf3c78f37af0f792e64211fcb41102e103c76f654d2b48d9100051ed519d8767")
    assert_vec("x empty n=69", "", 69, "1DgHbl0dbLC5g71FyjdvIj2JEkjck8LH4fGp7gu7j5Fassos2slkDym2Jly9k5sDpb8Cl", "4710353f22326c5ed3de5d85b34a4e20efb164dc0bc2db27b9455bb34ec45de6c37fb08f79ee1f0b16e8401791bc0ea0")
    assert_vec("x empty n=88", "", 88, "8usbdwBzEimF2bDfv5go6zL9l1wgkdpzukLHLBk5EJqfdjbEaHgii7aI1uJnp4z3ew7gcu2Ccin7E1eD9GBxjDBj", "a24278092b785841b373abf42f21f2536aea6ebd8925536235a60293a92ec8a845e6f237464199552c87b928fe52df765687d7516fbb4aa53f210f4757")
    assert_vec("x empty n=92", "", 92, "1qzuC2dte6JEAivLy1t9ogsmtsjipC2h3lj6p98vblmfIjAg95JJnAtb8EEdqdy9JIkDt4bDky48jG4CkpzkpibGt8xA", "534cfe004b95ed06628be6322fd634891565d6e7fb44c095ddf48703fd0ebfec9664c92856a666c811d70a79088d1db2069a2f177b58dbad50129b9f76c2847f")
