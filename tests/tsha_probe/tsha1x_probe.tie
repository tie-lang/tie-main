type tie<logic>
// tsha1x-256 探针（v2，state-per-n）：tsha1x(msg, n, base) 对任意位长 n 断言
//   base48 输出 == 生成器 b48 值、base16 输出 == 生成器 b16 值。
// 消息集：空串/abc/1000x'a'/55/56/63/64/65/127/128/129/256 字节（同 gen_tsha1x.py）。
// 位长抽检：{2,8,16,48,64,69,88,92,96,128,144}，含 W≥16 档 88/92/96/128/144 以覆盖
//   海绵率/LFSR 常量路径。非法位长一律返回空串。
// 语义源：tests/tsha_probe/gen_tsha1_core.py（逐式镜像；无 _hex，无 XOF）。
import "../../std/tsha1.tie"
using tsha;

func check(name: string, got: string, want: string) {
    if got == want {
        println("PASS " + name)
    } else {
        println("FAIL " + name + " got=" + got)
        println("     want=" + want)
        exit(1)
    }
}

func rep(c: string, n: i64) -> string {
    var out: string = ""
    var i: i64 = 0
    while i < n {
        out = out + c
        i = i + 1
    }
    return out
}

func assert_vec(name: string, msg: string, n: i64, b48exp: string, b16exp: string) {
    check(name + ".b48", tsha.tsha1x(msg, n, 48), b48exp)
    check(name + ".b16", tsha.tsha1x(msg, n, 16), b16exp)
}

func main() {
    assert_vec("x empty n=2", "", 2, "fm", "ea")
    assert_vec("x empty n=8", "", 8, "2uEtryrh", "724a5b8a01")
    assert_vec("x empty n=16", "", 16, "iKb80kd3vK20Gp2b", "30a7ca812941f2a45f7444")
    assert_vec("x empty n=48", "", 48, "6pib5wnGh7Gr33v86B239JC2g0BIehGaDseJlqJlst88Hf9e", "ba18416e02323978f0265249f6e71eaceb4b7ee625059f638da5b9de9b74baa8d4")
    assert_vec("x empty n=64", "", 64, "fcH0esJkKC7t6JmA1l0Dca1vzlGmF4320FoyubAgmc1eiao73seDiaz26947jKls", "d160407c84d9f1c516b9416700b51d9a4653f864ca71dbdde454e0cf8082f6c64c767055af9c410316017710")
    assert_vec("x empty n=69", "", 69, "12L65eAIdmi9u0i9g5HjwED8us5G3vcgeuuJgajfgwEaHum5uyGdm5flJkIq4Jc26c54D", "2979a008dccf157bf58e95a50698987a6f0a1baa0a5a17bedc8f18e9469bcfb5d525bfe2b8593aa68d79aa9530dd82f6")
