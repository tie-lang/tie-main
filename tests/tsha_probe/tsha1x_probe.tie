type tie<logic>
// tsha1x-256 探针：默认输出 base48（46 字符）+ `_hex` 保留 64 位十六进制 +
//   b48↔hex 往返一致性（decode(tsha1x(msg)) == tsha1x_hex(msg) 字节一致）。
// 正向向量：空串/abc/1000x'a'/55/56/63/64/65/127/128/129/256 字节（同 gen_tsha1bx.py）。
// 说明：tsha1x 内部哈希字节不变（x=256 位），仅输出层编码在 base48 与 hex 间切换。
// 向量与 f/b 档完全独立（确定性自检，f+b 排列组合表见 gen_tsha1bx.py PATT）。
import "../../std/tsha1.tie"
using tsha;
import "../../std/base48.tie"
using b48;

func check(name: string, got: string, want: string) {
    if got == want {
        println("PASS " + name)
    } else {
        println("FAIL " + name + " got=" + got)
        println("     want=" + want)
        exit(1)
    }
}

func rep(c: string, n: i64) -> string {
    var out: string = ""
    var i: i64 = 0
    while i < n {
        out = out + c
        i = i + 1
    }
    return out
}

func prefix(s: string, k: i64) -> string {
    var out: string = ""
    var i: i64 = 0
    while i < k {
        out = out + str_char(s, i)
        i = i + 1
    }
    return out
}

func assert_vec(name: string, msg: string, hex: string) {
    check(name + " hex", tsha.tsha1x_hex(msg), hex)
    check(name + " b48p", prefix(tsha.tsha1x(msg, 64), 46), b48.encode(hex))
}

func main() {
    assert_vec("x empty", "",
        "9477eb60ebe3330f1616c0d338c32c0329da51226d275c4436eaca515d581e7c")
    assert_vec("x abc", "abc",
        "537a393ecb57557679cedd3149d185ec60392fc04cdf598f2304997c1b306060")
    assert_vec("x a1000", rep("a", 1000),
        "f0ac5011c871914546d985add6970aa29bcad713d0b4b9ca2fc649d4f5cefa44")
    assert_vec("x b55", rep("a", 55),
        "e74795814d20149fc6c9e14d66aba2eba7fdddd3c9f6ead704a403c2ac5d358e")
    assert_vec("x b56", rep("a", 56),
        "244a771050cf2831602c8acfeea756db861cba3e093827e0690431aa888c8392")
    assert_vec("x b63", rep("a", 63),
        "77d36e9530b9806e4d0f318f8b9763733ff208d6cb1f72b73a3ae9f47b962924")
    assert_vec("x b64", rep("a", 64),
        "f18cbe999e2e16013326d4f64cb4d721d6664e9267ce61bc12e2a2fa64053e03")
    assert_vec("x b65", rep("a", 65),
        "8b0df4faac8e5a265ba15f98da2a21ce7108270a7323b4a22d1a8e38400d3da1")
    assert_vec("x b127", rep("a", 127),
        "f174ee60f5e80f315d96b3ab74efac58cdff237485743894e9ffda5f0cf4ced2")
    assert_vec("x b128", rep("a", 128),
        "ec023fdc28eacc2ea540641ac10b57dc24b9cf59a54ff09eaa72d983ea90b5e8")
    assert_vec("x b129", rep("a", 129),
        "f6172229bf27b6015e0288b7ce421d7f2927d37a9a76d9c03d7d34aa417ca53a")
    assert_vec("x b256", rep("a", 256),
        "d352d1d1cce004378908e0fe0e4843a9a6f62d6d2e13b2591d0c73f3624e47df")
    println("tsha1x 探针全部通过")
}