type tie<logic>
// tsha1 位长（state-per-n）输出探针 v2 —— 定长 base48 语义强化版。
// 覆盖（唯一语义源 tests/tsha_probe/gen_tsha1_core.py）：
//   ① 位长集合 {2,3,4,6,8,12,16,24,32,48,64,69,88,92,96,128,144} 各模型 (f/b/x/r)、
//      各消息（空 / "abc" / "a"×1000）base48 输出**恰好 n 符号**——v2 encode 为定长
//      左补零语义，len==n 恒成立，故直接全部断言。
//   ② 非法位长 0/46/23/-1 → 返回空串。
//   ③ 非法 base 5/10 → 返回空串（base=0 现为「省略 base」的默认兜底→48，见 ⑦，
//      不再判非法）。
//   ④ base16 输出长度 = ⌊n·698121/1000000⌋·2 字符（f 全集合 + b/r/x 抽样）。
//   ⑤ 前缀一致性：f/b/x 的 n=92 与 n=96 同 W=17 即同一状态 → 状态全宽摘要恒相等
//      （任意消息），故在摘要层断言；再于池长≥96 的消息（a1000）上断言实际符号前缀
//      n=96 前 92 == n=92。注：定长补零下若池长<96（如 f("abc") 池长 95），n=96
//      会补前导'0'破坏符号前缀，故符号级用例须选池长≥96 的消息；r 于 92(W=21)/
//      96(W=22) 换字宽，状态不同无前缀关系，不查。
//   ⑥ f/b/x/r 同一消息摘要互异（多档分别断言）。
//   ⑦ 新增默认参数通路：省略 base 的 tsha1f(msg,n) == 显式 base=48 的 tsha1f(msg,n,48)；
//      显式 base=0 亦经 encode 兜底后 == base=48。
import "../../std/tsha1.tie"
using tsha;

var N_SET: table<i64>;      // 合法 bit48 位长集合（main 里 init_globals 填充）
var PASS_COUNT: table<i64>; // 通过的断言累计数（表全局变量持久）

// 全局表只能以空表声明，需在运行期填充。
func init_globals() {
    table_push(N_SET, 2)
    table_push(N_SET, 3)
    table_push(N_SET, 4)
    table_push(N_SET, 6)
    table_push(N_SET, 8)
    table_push(N_SET, 12)
    table_push(N_SET, 16)
    table_push(N_SET, 24)
    table_push(N_SET, 32)
    table_push(N_SET, 48)
    table_push(N_SET, 64)
    table_push(N_SET, 69)
    table_push(N_SET, 88)
    table_push(N_SET, 92)
    table_push(N_SET, 96)
    table_push(N_SET, 128)
    table_push(N_SET, 144)
    table_push(PASS_COUNT, 0)
}

func radix10(v: i64) -> string {
    if v == 0 {
        return "0"
    }
    var digits = "0123456789"
    var out: string = ""
    var x = v
    while x > 0 {
        out = str_char(digits, x % 10) + out
        x = x / 10
    }
    return out
}

func prefix(s: string, k: i64) -> string {
    var out: string = ""
    var i: i64 = 0
    while i < k {
        out = out + str_char(s, i)
        i = i + 1
    }
    return out
}

func repeat_char(c: string, k: i64) -> string {
    var out: string = ""
    var i: i64 = 0
    while i < k {
        out = out + c
        i = i + 1
    }
    return out
}

// 长度断言；通过累计一次。
func chk_len(name: string, got: string, want: i64) {
    var L: i64 = len(got)
    if L == want {
        PASS_COUNT[0] = PASS_COUNT[0] + 1
        println("PASS " + name + " len=" + radix10(L))
    } else {
        println("FAIL " + name + " len=" + radix10(L) + " want=" + radix10(want))
        exit(1)
    }
}

// 内容断言；通过累计一次。
func chk_eq(name: string, got: string, want: string) {
    if got == want {
        PASS_COUNT[0] = PASS_COUNT[0] + 1
        println("PASS " + name)
    } else {
        println("FAIL " + name)
        println("  got : " + got)
        println("  want: " + want)
        exit(1)
    }
}

// 四模型互异断言：a/b/c/d 两两不等；通过累计一次。
func chk_mutdist(name: string, a: string, b: string, c: string, d: string) {
    if a != b && a != c && a != d && b != c && b != d && c != d {
        PASS_COUNT[0] = PASS_COUNT[0] + 1
        println("PASS " + name)
    } else {
        println("FAIL " + name)
        exit(1)
    }
}

// 按模型名分派到 tsha 公开四函数（避免嵌套重复调用）。
func model_hash(m: string, msg: string, n: i64, base: i64) -> string {
    if m == "f" {
        return tsha.tsha1f(msg, n, base)
    }
    if m == "r" {
        return tsha.tsha1r(msg, n, base)
    }
    if m == "b" {
        return tsha.tsha1b(msg, n, base)
    }
    return tsha.tsha1x(msg, n, base)
}

func main() {
    init_globals()
    var msg = "abc"
    var m1000 = repeat_char("a", 1000)
    var n: i64 = 0
    var mn: string = ""
    var models: table<string> = ["f", "r", "b", "x"]

    // ① 各模型 × 各消息（空/abc/a1000）：base48 输出恰好 n 符号（定长语义恒成立）
    for mn in models {
        for n in N_SET {
            chk_len("v2 b48 " + mn + " n=" + radix10(n) + " empty",
                    model_hash(mn, "", n, 48), n)
            chk_len("v2 b48 " + mn + " n=" + radix10(n) + " abc",
                    model_hash(mn, msg, n, 48), n)
            chk_len("v2 b48 " + mn + " n=" + radix10(n) + " a1000",
                    model_hash(mn, m1000, n, 48), n)
        }
    }

    // ② 非法位长 → 空串
    chk_len("v2 f n=0  reject", tsha.tsha1f(msg, 0, 48), 0)
    chk_len("v2 f n=46 reject", tsha.tsha1f(msg, 46, 48), 0)
    chk_len("v2 r n=23 reject", tsha.tsha1r(msg, 23, 48), 0)
    chk_len("v2 b n=-1 reject", tsha.tsha1b(msg, -1, 48), 0)
    chk_len("v2 x n=0  reject", tsha.tsha1x(msg, 0, 48), 0)

    // ③ 非法 base 5/10 → 空串（base=0 已是默认兜底→48，见 ⑦）
    chk_len("v2 f n=8 b5  reject", tsha.tsha1f(msg, 8, 5), 0)
    chk_len("v2 f n=8 b10 reject", tsha.tsha1f(msg, 8, 10), 0)
    chk_len("v2 r n=8 b5  reject", tsha.tsha1r(msg, 8, 5), 0)
    chk_len("v2 b n=8 b10 reject", tsha.tsha1b(msg, 8, 10), 0)
    chk_len("v2 x n=8 b5  reject", tsha.tsha1x(msg, 8, 5), 0)

    // ④ base16 长度 = ⌊n·698121/1000000⌋·2（f 全集合 + b/r/x 抽样）
    for n in N_SET {
        var b0 = (n * 698121) / 1000000
        chk_len("v2 f b16 n=" + radix10(n), tsha.tsha1f(msg, n, 16), b0 * 2)
    }
    var b0b = (8 * 698121) / 1000000
    chk_len("v2 b b16 n=8  ", tsha.tsha1b(msg, 8, 16), b0b * 2)
    var b0b2 = (144 * 698121) / 1000000
    chk_len("v2 b b16 n=144", tsha.tsha1b(msg, 144, 16), b0b2 * 2)
    var b0r = (96 * 698121) / 1000000
    chk_len("v2 r b16 n=96 ", tsha.tsha1r(msg, 96, 16), b0r * 2)
    var b0r2 = (48 * 698121) / 1000000
    chk_len("v2 r b16 n=48 ", tsha.tsha1r(msg, 48, 16), b0r2 * 2)
    var b0x = (64 * 698121) / 1000000
    chk_len("v2 x b16 n=64 ", tsha.tsha1x(msg, 64, 16), b0x * 2)
    var b0x2 = (16 * 698121) / 1000000
    chk_len("v2 x b16 n=16 ", tsha.tsha1x(msg, 16, 16), b0x2 * 2)

    // ⑤ 前缀一致性：f/b/x 的 n=92 与 n=96 同 W=17（同一状态）→ 状态全宽摘要恒相等；
    //   再于池长≥96 的消息（a1000）上断言实际符号前缀 n=96 前 92 == n=92。
    //   定长补零下池长<96（如 f("abc") 池长 95）会让 n=96 补前导'0'破坏符号前缀，
    //   故符号级用例选池长足够的消息；r 于 92(W=21)/96(W=22) 换字宽，不查。
    var pref_models: table<string> = ["f", "b", "x"]
    var dmsg: table<string> = ["", "abc", "a1000"]
    var dm: string = ""
    for mn in pref_models {
        for dm in dmsg {
            chk_eq("v2 " + mn + " digest-92==96 " + dm,
                   tsha.tsha1_digest(mn, dm, 92), tsha.tsha1_digest(mn, dm, 96))
        }
        chk_eq("v2 " + mn + " prefix96-92 a1000",
               prefix(model_hash(mn, m1000, 96, 48), 92),
               model_hash(mn, m1000, 92, 48))
    }

    // ⑥ 同一消息 f/b/x/r 摘要两两互异（base48 n=48 / n=8、base16 n=48 三档）
    chk_mutdist("v2 4-model differ b48 n=48",
                tsha.tsha1f(msg, 48, 48), tsha.tsha1r(msg, 48, 48),
                tsha.tsha1b(msg, 48, 48), tsha.tsha1x(msg, 48, 48))
    chk_mutdist("v2 4-model differ b48 n=8 ",
                tsha.tsha1f(msg, 8, 48), tsha.tsha1r(msg, 8, 48),
                tsha.tsha1b(msg, 8, 48), tsha.tsha1x(msg, 8, 48))
    chk_mutdist("v2 4-model differ b16 n=48",
                tsha.tsha1f(msg, 48, 16), tsha.tsha1r(msg, 48, 16),
                tsha.tsha1b(msg, 48, 16), tsha.tsha1x(msg, 48, 16))

    // ⑦ 默认参数通路：省略 base == 显式 base=48；显式 base=0 亦兜底为 48
    for n in N_SET {
        chk_eq("v2 f defaultbase n=" + radix10(n),
               tsha.tsha1f(msg, n), tsha.tsha1f(msg, n, 48))
    }
    chk_eq("v2 r defaultbase n=48", tsha.tsha1r(msg, 48), tsha.tsha1r(msg, 48, 48))
    chk_eq("v2 b defaultbase n=8 ", tsha.tsha1b(msg, 8), tsha.tsha1b(msg, 8, 48))
    chk_eq("v2 x defaultbase n=96", tsha.tsha1x(msg, 96), tsha.tsha1x(msg, 96, 48))
    chk_eq("v2 f base0 fallback n=48", tsha.tsha1f(msg, 48, 0), tsha.tsha1f(msg, 48, 48))
    chk_eq("v2 x base0 fallback n=8 ", tsha.tsha1x(msg, 8, 0), tsha.tsha1x(msg, 8, 48))

    println("位长（state-per-n）输出探针 v2 全部通过，PASS 总数=" + radix10(PASS_COUNT[0]))
}