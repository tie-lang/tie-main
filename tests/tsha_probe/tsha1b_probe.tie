type tie<logic>
// tsha1b-256 探针（v2，state-per-n）：tsha1b(msg, n, base) 对任意位长 n 断言
//   base48 输出 == 生成器 b48 值、base16 输出 == 生成器 b16 值。
// 消息集：空串/abc/1000x'a'/55/56/63/64/65/127/128/129/256 字节（同 gen_tsha1bx.py）。
// 位长抽检：{2,8,16,48,64,69,88,92,96,128,144}，含 W≥16 档 88/92/96/128/144 以覆盖
//   海绵率/LFSR 常量路径。非法位长一律返回空串。
// 语义源：tests/tsha_probe/gen_tsha1_core.py（逐式镜像；无 _hex，无 XOF）。
import "../../std/tsha1.tie"
using tsha;

func check(name: string, got: string, want: string) {
    if got == want {
        println("PASS " + name)
    } else {
        println("FAIL " + name + " got=" + got)
        println("     want=" + want)
        exit(1)
    }
}

func rep(c: string, n: i64) -> string {
    var out: string = ""
    var i: i64 = 0
    while i < n {
        out = out + c
        i = i + 1
    }
    return out
}

func assert_vec(name: string, msg: string, n: i64, b48exp: string, b16exp: string) {
    check(name + ".b48", tsha.tsha1b(msg, n, 48), b48exp)
    check(name + ".b16", tsha.tsha1b(msg, n, 16), b16exp)
}

func main() {
    assert_vec("b empty n=2", "", 2, "fs", "ec")
    assert_vec("b empty n=8", "", 8, "4rehK4IF", "c597a5eead")
    assert_vec("b empty n=16", "", 16, "150wgxkzLw6v15HF", "8805c9470e78ed7c780f09")
    assert_vec("b empty n=48", "", 48, "7m6hFxsyrmtzp6mltggCKohxGhm5d25dBKuo8qr1Ddt8rxvc", "d4aba1e06c5a2017a77e2bc7ec0899032a6ab7a102fca539c9169593fcf79c4263")
    assert_vec("b empty n=64", "", 64, "eLaI6i5whc5iltCwmauEgez1LvBvlqgx94jk7g5frcwzc1r7owBIxppzB5x1cyfs", "cd789c0dd6eda57277d47c058036dda57f023a44191e810179c3c14a64722539cbbb640b6796965b5e654d0f")
    assert_vec("b empty n=69", "", 69, "k6G31ho7Fr3aJuw3J5x04qkL10jpGt6awwgdz8uzmmkfmCbkrgaj6FD5d0aFe5L74Cnhr", "106318303f1343e9be9e60d442d1dd6a616331e1d9a320ea819005b9ceb74fa05d6082e48e6205a6363688b31c6c021f")
    assert_vec("b empty n=88", "", 88, "3BoCkwqC1pi5Asl8mH3edivo2hqjq6Eovn16kxqEj4bbh8ADFnDKaqu2v2hCJLD58pmE3gvzttdxllmmipH7q2LH", "470a89f0832a2e676383afebc796165df4cd5475ef7b26a08f8427e937fcb36dbcc1ce998b6681477fae5646ee6038b61875ca6c07f31fc727a6446169")
