    assert_vec("b a129 n=128", rep("a", 129), 128, "4uceEF4Afor1E4m2cF2zhcJrm9j98tm4oA4cEEmtvgvFx0wysCJyoa8l9HGHEb64k6sgJzg4z182H3GlGFhkpvytzw3svaGpIsy6BcaGCBAs92zd9J0gLxvjbl66jgIx", "39545c123ffa1b8cfab26aaafa6709f20e5b7b28ff0fa8895bd02695a52ed1d58c4fb1d536e58270ac94215c8026f2c7ac881c5813cc7d4c5d070cfbbae9d6fe03aa42fb092384e6e76eb47e8727d9b7c53c39535378e63b46")
    assert_vec("b a129 n=144", rep("a", 129), 144, "mI8oFL9rl9z1iw0eIDB2488Fnqu93s51zpj65j68sCcDL0ikBHDd1FHAkDu2E3a53jGu61Bvzzo60GmfjD4spKnKa4H9JD9dyvwiwseKAnpyGLHy9mdJbpwCxIlnaarBebwnx219psGDHei5", "88861487c9fd7fba12e7c9a688eef13d04ac24a66bc9106bebac8fd678f01ee06a35c0f006a4ae02c70e24eae2d4e63e222dbb78b5bb72ab7777459ea80f5f1ecc12d9bb10c56d647ce539b82e6c6489f1c4999c6d148f7ef53ce71b36156d789bc7b908")
    assert_vec("b a256 n=2", rep("a", 256), 2, "c8", "b8")
    assert_vec("b a256 n=8", rep("a", 256), 8, "4fkr28nt", "bae577e48e")
    assert_vec("b a256 n=16", rep("a", 256), 16, "mtv7uk9obratvzBq", "3a083906f3182df3cc7b61")
    assert_vec("b a256 n=48", rep("a", 256), 48, "4L7fhtJt76DiJEAxKLunix6tdFlmAz75hElJek834rtHkbnw", "8e042861543e3f04911992355e94536b9c5269f988e5c5a43f7bd263173547497a")
    assert_vec("b a256 n=64", rep("a", 256), 64, "1JFhGahcwvc0Js1h4pDJs62owFvfeg1mtvFv1CCidor4cmLmDIE50Kng1EoLn0x4", "1ad0947550756ff21c5542ae9cce735dfb5c6befcce6fe20c3332823946828c7015a15a227ca94de466880a5")
    assert_vec("b a256 n=69", rep("a", 256), 69, "1r7rs5KIBiqzhLIgBqbi2JGmfxGj7B5kc98zg7H2j3rwgHuDtpLxfsmK03tftvtKKBA2l", "3d24969251429886072dc8d3a7cf83ee2ff7e6a52ba7febe1353eea0209c576c3ce9bb78b3ee1b9b4082cec387b666e3")
    assert_vec("b a256 n=88", rep("a", 256), 88, "3kCDaI6kLwxo4ccovJuwBJaiz7FCbjAIiEs6KD2b3bCk81ribbna68ECyb8mEa502eI0I0LwgsF6A8Fpg6a2LKhs", "408087c3d42a3ac75918e965ef045441121fe45504717f9a52c18f466c5f203d8c6753593afb3c7e2a736efa6b6ba638c6621ca5b279f3a6c8cc50be59")
    assert_vec("b a256 n=92", rep("a", 256), 92, "GvdamK4Bl2Ff8C3FclohEGtGDJFECDouk6y0AE5HD1AndpJrGJs16DLao8Bb7dcx7Ciiy4xv2ob2n6079uKdD9jCdvG5", "2f8908b37b9c7ce92af473d0109418e45a58cbd23417a1e1d666e1730034deca4c7b28e6be63ad0dde5c5dd97cd0fc3c942df4967b47ef425db2ef53523ab452")
    assert_vec("b a256 n=96", rep("a", 256), 96, "GvdamK4Bl2Ff8C3FclohEGtGDJFECDouk6y0AE5HD1AndpJrGJs16DLao8Bb7dcx7Ciiy4xv2ob2n6079uKdD9jCdvG58hfE", "2f8908b37b9c7ce92af473d0109418e45a58cbd23417a1e1d666e1730034deca4c7b28e6be63ad0dde5c5dd97cd0fc3c942df4967b47ef425db2ef53523ab45238953e")
    assert_vec("b a256 n=128", rep("a", 256), 128, "35tDn1B1IFG1JIcjq1sEim9v1j1lv7h3k6q4IAADbgckHcqf1II1oF15svpep89nmew1irqygE409w9Ez9DxFgHyt3xxI4uztAyelik1rznB7s5qwIKl3nzlDEIragzc", "269802b6ba48be655549398c09517101f923da3ca1e33abaa6815a8655d1cba4f520e87e1bdbd9b5be42bb2a6097182a46a0427231e7e496a4206e07b96739e036b25f12934990b31c24b7ed76643f98fcaa96e952e961c187")
    assert_vec("b a256 n=144", rep("a", 256), 144, "lx7honi2imyqLicEgez9p9J9wnf6kHo593FLIrfpDAfAtCGlkedDxJ2lDIEou5bv05u113K8rtmqFiGuf8lDFazmgjtF9xE96Frwx3lk0hwAsvKq3qgsH6ojuHhlhL5Kktkhc5Io9r99epyf", "81330624ae9b320e5de15d1dbd36e360046b47035bf10084345f6aaea3760a45ee46f09e5dba6d8dde5ed950fe237fba18729b0fcab56601944e142214460e44deac2927b491ca2f831021504f21637570597848b9accea694139a7c0113f6018bf93538")

    // 非法位长/非法进制 → 空串
    check("b badlen 5",     tsha.tsha1b("abc", 5, 48), "")
    check("b badlen 5.b16",  tsha.tsha1b("abc", 5, 16), "")
    check("b badlen 7",     tsha.tsha1b("abc", 7, 48), "")
    check("b badlen 100",  tsha.tsha1b("abc", 100, 48), "")
    check("b badlen 13.b16",  tsha.tsha1b("abc", 13, 16), "")
    check("b badbase 7",     tsha.tsha1b("abc", 48, 7), "")
    check("b badbase 15",  tsha.tsha1b("abc", 64, 15), "")
    println("tsha1b 探针全部通过")
}
