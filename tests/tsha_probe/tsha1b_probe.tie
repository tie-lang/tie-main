    assert_vec("b a129 n=128", rep("a", 129), 128, "5hEuvgIe40sbcGAi2ylzblnz0ihj6bhblpoqjyrgKlu3v7Dh9B8Aux6oweqEH5jDqm2BvId1wc3z4AGhyqLqty823qBzme3fchvwrAxvvo3Eti1ryqFfKgBfyjk5vIgt", "428280b559de83ac8591051591dd6899114347894592e51a7d085c5a494399d232b18a89b22a8e4bfd623e439618ca9a1820d4c69aaadd3c0d1ed21894c5312bae614be9f85d7a1411082bb18099c0f84adb6beb7b0397f098")
    assert_vec("b a129 n=144", rep("a", 129), 144, "gAllc0Etb2ewpgz3Ka4e6pfu7KfdnnoiddgggriG8zdgatvJIqKwwKrhFEr4KFGpiypHob68Iw5H4rmbqk34y6hknjoujE12FvC0Je0vpiCHxFLiD0m9vKDbsfBJC1gi5ranI1E5EJxKCoDh", "63d366f2aded913e2f07605df561b49aa745ebcd38043085c8c71e673a5c8c0e7d9ee71308eb9139a10bc75b9a60ebd216b459515e667ac2f67b60db8da957ea552902c898cd6582b57d90df9f0224bede9046cd9ff0cf5beaa287b79001d0d3e066a0c6")
    assert_vec("b a256 n=2", rep("a", 256), 2, "8n", "80")
    assert_vec("b a256 n=8", rep("a", 256), 8, "5plCCmKj", "ef2dbd6186")
    assert_vec("b a256 n=16", rep("a", 256), 16, "1bkIsl6G82yauucj", "98800177b1819107ab32f3")
    assert_vec("b a256 n=48", rep("a", 256), 48, "4Gex6ihirG50FIm4513rllLvkx8Ceiz5tD0r1dLDh0cLa4od", "8b236545281ab451dd43e7fa811bbc4a402e4c5b480e40c7d5dc6f7c32001432b4")
    assert_vec("b a256 n=64", rep("a", 256), 64, "bD3cpe4gb8xLmeFauJ75j5EiLcstAEwmBE394GrIwbI0of3b4kgt5vFkCfvIebHx", "a20070c06b236c188bcddd70aff6a09148395e464db0af72abe814345cde9e420a2286a7c054fb4a4404a469")
    assert_vec("b a256 n=69", rep("a", 256), 69, "zzy01xgwbKqviaE4148Ktxc1eJnDg4oExm8CfAhtxzEzBx6Ft0jy9D84DbdICLEmFBpts", "1d1422c6f9273a2f723d767ce9edf6337f7082559e716ae5facfe32a2fd4043f97176c91483b778db2179a95c8edcda2")
    assert_vec("b a256 n=88", rep("a", 256), 88, "1g5G94CAtAKIdbHJr9Akqe6L7GvJ9hlshInq3DpjKk9btxqFf8x9IsJdf7hFHiBIvubf132zhLGjzLdvBpfocfDd", "191890f6555da9c02a9f8131a02e42d0bfaac442b181f24e71cefe4be6b6a0d0942163c90068745a2a0fabc1625b2b4ed4cbb822f0439dee1ba4737d4b")
    assert_vec("b a256 n=92", rep("a", 256), 92, "4x6KgKiJoBz2IfHyxiBtF3LaiHl0qBdsGhq7aEuIeDDvecvCgtGjCLszCHD7KjhlLowhAiABFegEj7nhzyIg9HvAiHyw", "faecc20176a908612db5588f50880aa933e7c13c342738234887457bae4ecdb86987d99bc5841beed42ed258590196098a4196b5edfe71ab40d793a105abf3ef")
    assert_vec("b a256 n=96", rep("a", 256), 96, "4x6KgKiJoBz2IfHyxiBtF3LaiHl0qBdsGhq7aEuIeDDvecvCgtGjCLszCHD7KjhlLowhAiABFegEj7nhzyIg9HvAiHywzcmu", "faecc20176a908612db5588f50880aa933e7c13c342738234887457bae4ecdb86987d99bc5841beed42ed258590196098a4196b5edfe71ab40d793a105abf3ef97822e")
    assert_vec("b a256 n=128", rep("a", 256), 128, "g5ex4dI85aL5nDtCBr4qsvpJF9I56k1nzEkav803wGga6eyyssjp26I3nE70bt95ibLkih3Ivu4nLKaf9iesguKFFCd8c64Elc1tlF1gga0gapi8k6jnbipy7G8mtyal", "c778106870a492293037c759897394fc60883db0e3de4e9f51aef4a7c0ca27075600c1b18f7107a09d661ae8fb8940f47e1c24b9739a9fe59aeea25047ad598fdf8b519933e7065dc5c4b28b044ea72384bf73d716703f3360")
    assert_vec("b a256 n=144", rep("a", 256), 144, "putyxmIelBz27ji0twDgE25pfrCCEA7k7m6aHxwj1begGjjLJH7olud9nwy0C2Kydtk1uw343kzaAl5njdDxF27BuhIAqdJzF6oLEqAb7hyuq13vlJgHkImBv61Jt5HqBGqwgqH0FKdJwapk", "98b5e968cab448c9d3b265d7d33e134490914ff22791f8643e9cf42845ac8449f05aa4159518acaaa0b7bc19d822d41eede2567234b6d688545eba88a4ef1972a55fca4866591345efbbf16d489348476b982a9b2a744fccaaad1f208e3e518f7e9cad2f")

    // 非法位长/非法进制 → 空串
    check("b badlen 5",       tsha.tsha1b("abc", 5, 48), "")
    check("b badlen 5.b16",   tsha.tsha1b("abc", 5, 16), "")
    check("b badlen 7",       tsha.tsha1b("abc", 7, 48), "")
    check("b badlen 100",     tsha.tsha1b("abc", 100, 48), "")
    check("b badlen 13.b16",  tsha.tsha1b("abc", 13, 16), "")
    check("b badbase 7",      tsha.tsha1b("abc", 48, 7), "")
    check("b badbase 15",     tsha.tsha1b("abc", 64, 15), "")
    println("tsha1b 探针全部通过")
}
