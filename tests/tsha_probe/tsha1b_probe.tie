type tie<logic>
// tsha1b-256 探针：默认输出 base48（46 字符）+ `_hex` 保留 64 位十六进制 +
//   b48↔hex 往返一致性（decode(tsha1b(msg)) == tsha1b_hex(msg) 字节一致）。
// 正向向量：空串/abc/1000x'a'/55/56/63/64/65/127/128/129/256 字节（同 gen_tsha1bx.py）。
// 说明：tsha1b 内部哈希字节不变（b=256 位），仅输出层编码在 base48 与 hex 间切换。
// 向量与 f 档完全独立（独立常量 SEED_B = "TSHA1-2026-b-256-v1"）。
import "../../std/tsha1.tie"
using tsha;
import "../../std/base48.tie"
using b48;

func check(name: string, got: string, want: string) {
    if got == want {
        println("PASS " + name)
    } else {
        println("FAIL " + name + " got=" + got)
        println("     want=" + want)
        exit(1)
    }
}

func rep(c: string, n: i64) -> string {
    var out: string = ""
    var i: i64 = 0
    while i < n {
        out = out + c
        i = i + 1
    }
    return out
}

func prefix(s: string, k: i64) -> string {
    var out: string = ""
    var i: i64 = 0
    while i < k {
        out = out + str_char(s, i)
        i = i + 1
    }
    return out
}

func assert_vec(name: string, msg: string, hex: string) {
    check(name + " hex", tsha.tsha1b_hex(msg), hex)
    check(name + " b48p", prefix(tsha.tsha1b(msg, 64), 46), b48.encode(hex))
}

func main() {
    assert_vec("b empty", "",
        "afd3b3fcbb903a5a55f7ce0e79b83bf15edfefbc495eaec082ce9dce71afe1f8")
    assert_vec("b abc", "abc",
        "4bbaea174cd4475b2b17e052fa3f9f523c2cd7c8100258372311bd7288aa770a")
    assert_vec("b a1000", rep("a", 1000),
        "1e9e08417fce2c02189d439d7ef25aafd81465d87c18ce44411840caee8d45d5")
    assert_vec("b b55", rep("a", 55),
        "2a2ec356a7198db04ef0084c6cdae25d93f4f8db9f65186363b26391c0d00c91")
    assert_vec("b b56", rep("a", 56),
        "746a71bde603b604f08f2cb5e394d9d51157372a3c869560959bb85fcc1fc442")
    assert_vec("b b63", rep("a", 63),
        "257d6e18d5dc9ed6a1aa9d106e49db368955745d57d81e5cf8496dd676d9f1e6")
    assert_vec("b b64", rep("a", 64),
        "b4ac50ea09f29c5ae3bfc6ead31dc48e9efe315aa929953beb3ed34e12773129")
    assert_vec("b b65", rep("a", 65),
        "5a248746f64dab2e5ff2a308c4f0ad587a81086e6165ece70eb9adeba64676e0")
    assert_vec("b b127", rep("a", 127),
        "32eee3696d5f0b8adca516b809b598e641b15d1f17a19d16d4dd407857da7762")
    assert_vec("b b128", rep("a", 128),
        "903353ceb22d927ff12713eaf434b451d31a2b167d83c67483f2983fc5759bb8")
    assert_vec("b b129", rep("a", 129),
        "9b61ecf2d72d22d1450a33333f7e37187b039c2b0a3ddae48f5d13c04d6d55bc")
    assert_vec("b b256", rep("a", 256),
        "616cfff019ac89c57fe5e32bb6ce2cfc634dffbc138702c30b6429bac606f063")
    println("tsha1b 探针全部通过")
}