type tie<logic>
// tsha1b-256 探针（v2，state-per-n）：tsha1b(msg, n, base) 对任意位长 n 断言
//   base48 输出 == 生成器 b48 值、base16 输出 == 生成器 b16 值。
// 消息集：空串/abc/1000x'a'/55/56/63/64/65/127/128/129/256 字节（同 gen_tsha1bx.py）。
// 位长抽检：{2,8,16,48,64,69,88,92,96,128,144}，含 W≥16 档 88/92/96/128/144 以覆盖
//   海绵率/LFSR 常量路径。非法位长一律返回空串。
// 语义源：tests/tsha_probe/gen_tsha1_core.py（逐式镜像；无 _hex，无 XOF）。
import "../../std/tsha1.tie"
using tsha;

func check(name: string, got: string, want: string) {
    if got == want {
        println("PASS " + name)
    } else {
        println("FAIL " + name + " got=" + got)
        println("     want=" + want)
        exit(1)
    }
}

func rep(c: string, n: i64) -> string {
    var out: string = ""
    var i: i64 = 0
    while i < n {
        out = out + c
        i = i + 1
    }
    return out
}

func assert_vec(name: string, msg: string, n: i64, b48exp: string, b16exp: string) {
    check(name + ".b48", tsha.tsha1b(msg, n, 48), b48exp)
    check(name + ".b16", tsha.tsha1b(msg, n, 16), b16exp)
}

func main() {
    assert_vec("b empty n=2", "", 2, "du", "ce")
    assert_vec("b empty n=8", "", 8, "1w5qJ57c", "482f895f9b")
    assert_vec("b empty n=16", "", 16, "s8J5ob16qcJm76IB", "4851e0e4724aaf63b562b3")
    assert_vec("b empty n=48", "", 48, "J3F6zGEJgsmiA3u0v4Ialb243ypFzlKs09iua0sj30rxzqex", "1ac5270083fe8075914daeb13375978e3957a056e1fe790e58f50183a0ccd0feea")
    assert_vec("b empty n=64", "", 64, "2h5yLrGp1DCw2dca50GxsldqkjDDIc5eFdv3a0JeKb4BhwG244bL0dsiAvwAv3qm", "2050f8279290ca8c0882f8fbc9908ee8811322b5e9ac88db78ec6c131fc1c02a0757566c2bfbcccfc17f8b24")
    assert_vec("b empty n=69", "", 69, "3gcKEx0ysD3zjupfIJg2HIDz2ua1sKvsp9puCjit2x9okHDjHGzq5CB2dtd8cd1mx6HKA", "82626041ae8ec26d00ff2e542b5092d2035b32fb7bf72e9302c31609823fbbc56351705b17b7c2c4e04f6d8c38b72521")
    assert_vec("b empty n=88", "", 88, "2xwogGEevb98op9KGd5Atxb39IkBJxy89j8h0gpFL0jesukIdeeJaj4a9fziEI32e7nB4aAz7DqCgqahqdaEI6Dm", "32c0a2ba3af2f58f18252a7f706544e97f7271f7b89c2eba236620e4ff6c314d2b4c4454aa9dfd3e6e582133deb311696ab8b132fbe0ab3df9439b99ad")
    assert_vec("b empty n=92", "", 92, "1808q10Fc3FGdK6J8E7fr7JzgAHrdKlJdiJGJy26Lg10oIF1meE7K302ltJdtvvlgq0E4I11FlDo5h32Gv4At5awzgmE", "3e6a916ae5716c9814ced02206a990f05293e1ddcc084e6b7d818c0be8bde6a9bee4b42bb750765ebf4b3e724b880e50d9c40b36eab303cdc9d6fef90c20d6d3")
