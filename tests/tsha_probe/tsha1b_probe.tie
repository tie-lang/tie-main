type tie<logic>
// tsha1b-256 探针：默认输出 base48（46 字符）+ `_hex` 保留 64 位十六进制 +
//   b48↔hex 往返一致性（decode(tsha1b(msg)) == tsha1b_hex(msg) 字节一致）。
// 正向向量：空串/abc/1000x'a'/55/56/63/64/65/127/128/129/256 字节（同 gen_tsha1bx.py）。
// 说明：tsha1b 内部哈希字节不变（b=256 位），仅输出层编码在 base48 与 hex 间切换。
// 向量与 f 档完全独立（独立常量 SEED_B = "TSHA1-2026-b-256-v1"）。
import "../../std/tsha1.tie"
using tsha;
import "../../std/base48.tie"
using b48;

func check(name: string, got: string, want: string) {
    if got == want {
        println("PASS " + name)
    } else {
        println("FAIL " + name + " got=" + got)
        println("     want=" + want)
        exit(1)
    }
}

func rep(c: string, n: i64) -> string {
    var out: string = ""
    var i: i64 = 0
    while i < n {
        out = out + c
        i = i + 1
    }
    return out
}

func prefix(s: string, k: i64) -> string {
    var out: string = ""
    var i: i64 = 0
    while i < k {
        out = out + str_char(s, i)
        i = i + 1
    }
    return out
}

func assert_vec(name: string, msg: string, hex: string) {
    check(name + " hex", tsha.tsha1b_hex(msg), hex)
    check(name + " b48p", prefix(tsha.tsha1b(msg, 64), 46), b48.encode(hex))
}

func main() {
    assert_vec("b empty", "",
        "2f9d8eda98c5eb60aefbda6f53651c3470afe366b056ac882e1c36c80eeee244")
    assert_vec("b abc", "abc",
        "72ecd6a49318633b3a8ffe8a80920a67f1434ec00fbb4e138fa2cb6bdefaa324")
    assert_vec("b a1000", rep("a", 1000),
        "f29105d9baa59da088f0bba06a3cd88f4d0f4a2073b54ac6223686c44e805cd0")
    assert_vec("b b55", rep("a", 55),
        "1e3dbe1449b7375b3b1b6f7d031b70934f968c96113233af84af2a2fa0630311")
    assert_vec("b b56", rep("a", 56),
        "c530e575969686d6a03acae740c24bc9855cc80272dfe83787faab6bdd65db56")
    assert_vec("b b63", rep("a", 63),
        "0646011725973df056a442c4cfa1b8de6e3c4b4b27e7aa910f15871e601f4332")
    assert_vec("b b64", rep("a", 64),
        "3072de987ec8aacdeae13d4e652d316ca1d7ff76707189623e72e38082389d1e")
    assert_vec("b b65", rep("a", 65),
        "669b73a20552cb34a366f98a46ca6ca8108adc5ed9051fc7644cd54e861d84a8")
    assert_vec("b b127", rep("a", 127),
        "d1ac1dcafab588098effafe710746c94fd35b34d71fd2f508cd08548e98f1416")
    assert_vec("b b128", rep("a", 128),
        "2f8c217f2260576adb22f20ddd462e6bf98cc44d2816a6ea878caf2ffe74b67f")
    assert_vec("b b129", rep("a", 129),
        "74ae0b73e7b45017bb55c013d9283d7d35de7f2aaddbeb7de6dc859fc0a4f794")
    assert_vec("b b256", rep("a", 256),
        "73b76b318d141dd686609385550d4abcf9f2c089e3e2cbbba6cd7572e4ddd04d")
    println("tsha1b 探针全部通过")
}