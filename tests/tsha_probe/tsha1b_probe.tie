type tie<logic>
// tsha1b-256 探针：默认输出 base48（46 字符）+ `_hex` 保留 64 位十六进制 +
//   b48↔hex 往返一致性（decode(tsha1b(msg)) == tsha1b_hex(msg) 字节一致）。
// 正向向量：空串/abc/1000x'a'/55/56/63/64/65/127/128/129/256 字节（同 gen_tsha1bx.py）。
// 说明：tsha1b 内部哈希字节不变（b=256 位），仅输出层编码在 base48 与 hex 间切换。
// 向量与 f 档完全独立（独立常量 SEED_B = "TSHA1-2026-b-256-v1"）。
import "../../std/tsha1.tie"
using tsha;
import "../../std/base48.tie"
using b48;

func check(name: string, got: string, want: string) {
    if got == want {
        println("PASS " + name)
    } else {
        println("FAIL " + name + " got=" + got)
        println("     want=" + want)
        exit(1)
    }
}

func rep(c: string, n: i64) -> string {
    var out: string = ""
    var i: i64 = 0
    while i < n {
        out = out + c
        i = i + 1
    }
    return out
}

func assert_vec(name: string, msg: string, hex: string, b48str: string) {
    check(name + " b48", tsha.tsha1b(msg), b48str)
    check(name + " hex", tsha.tsha1b_hex(msg), hex)
    check(name + " dec", b48.decode(b48str), hex)
    check(name + " rt ", b48.decode(tsha.tsha1b(msg)), hex)
}

func main() {
    assert_vec("b empty", "",
        "f4564d606304f76c7de5e2578d6afeb3e7178f54866373a53169e59cbfa7c514",
        "ojxdbzcfcBrroygG6E1uKCa3fbo71K7somFneGlwjLxuBA")
    assert_vec("b abc", "abc",
        "90769d04e106469ca28f577fd911a8fd17a4f277a76eb39db192543bcd10f8b9",
        "ekAknHvpxdpJK15nad8I7l5cEi6uBsb29Dy9w2iwCBzpF9")
    assert_vec("b a1000", rep("a", 1000),
        "0fbb990a8b709e108f032c6e2b47804cd31d9cc3bc78e7b4c9dcc832495c2624",
        "1rlhgeewIvGoDIlxnv5gGgBnnFzJDj1bswDAir1rsFkDC4")
    assert_vec("b b55", rep("a", 55),
        "9e8c14f92457570128416c1806971f15a384ead1ab9f6f86a137f6400c5ed7b8",
        "fEebgrEIr31F81eGmGm8eA2EueDd6DGwhrlkju77lJtpzE")
    assert_vec("b b56", rep("a", 56),
        "3cfcfdd36e2a99e0e592f8769821fe735d1814a158368285a0efd8782cf15b8f",
        "64maefHAjzKwKhmc5D0iFesjubzapCf4E5jv3CKEaFekEf")
    assert_vec("b b63", rep("a", 63),
        "a0d15d675c04a0ebd123982377e50464d14dcc7bd616f4cde33165b710c39c77",
        "g38GwzFCi7KycAHj6kEfI0CDasJ00yGqLpJJ5raF7hb1in")
    assert_vec("b b64", rep("a", 64),
        "d0d403851d237ee6ef19f8487e7481ab8f7450326718ef36a6ee065a4d1cd211",
        "kFjFldbujIFf4JoerFox9ge7xoxKDc5Ltqj5FAgHehgngh")
    assert_vec("b b65", rep("a", 65),
        "398b96968baf0942938d74aaa2193cdd60dc047cd56129ff7b7e1b4070367d78",
        "5zJy9pDIwbLgpqmw5G9GfBe7qkfDtfIg1rexzz1cHmszd8")
    assert_vec("b b127", rep("a", 127),
        "7f7931836e681c958e53cde9e0c8b2f0779e6f5a0f7277d8ebf830109f9a9367",
        "czdxBfsGIkqxDGmIehnHFcukqrn2dboF7xE2Itcfb4FDnn")
    assert_vec("b b128", rep("a", 128),
        "90fa307037bcd151678846ea9e697edff87d3fdc1aec8372e835716f4bd196ed",
        "enaz5HDw6oLILC6i4he3cKiD4q7npAIFcJCmh117sbdiqd")
    assert_vec("b b129", rep("a", 129),
        "7cf3d922734310b96488d4dd7ece9244acc9e066c96b04f753d21b9f35360ae5",
        "cn9lsLrhEGfKg1wB3Koyal4kB7ff99gjHgBkp3f3mC9ofl")
    assert_vec("b b256", rep("a", 256),
        "863a550c8742063eb82e5941e2f1f2a86ce46997039ffb865ca97baa17714976",
        "djwkIm15A2glxDGIbExtxzcqdBpAxCk3q5I075Jg9KuiDC")
    println("tsha1b 探针全部通过")
}