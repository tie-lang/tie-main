type tie<logic>
// tests/_p733_probe/trm_probe_733.tie —— p.7.3.3 探针：--target=trm 产物被 trm 引擎加载执行
// ============================================================
// 里程碑：2026.2 路线图 p.7.3.3「编译器侧 trm 目标接线：trm 字节码后端作可插拔
// 后端接入 tiec（默认不启用，不捆绑）」。
// 端到端验收：真实编译器（--target=trm）产出 .tieir 字节码 → trm 引擎
// （类加载器 + InterpBackend）加载校验并执行纯函数，结果正确——「编译器
// 编译 → trm 引擎执行」闭环（单函数样本 = tieir roundtrip 出生序兼容子集；
// 多函数交错布局超出现有校验面，属已知限制，见总结）。
// 使用：先由 tiec --target=trm tests/_p733_probe/calc_lib.tie -o tests/_p733_probe/calc_lib.tieir
// 产出字节码（单函数样本，满足 tieir roundtrip 参数段连续；多函数交错布局
// 属已知限制，见总结）；再编译运行本探针（trm.init → trm.load(calc_lib.tieir)
// → run calc.add）全过 exit 0。
// 注：本探针覆盖 p.7.3.2 期互操作性（interp 消费真实编译器产物）；探针内不
// 再手建 IR，纯消费。
import "../../compiler/trm/trm.tie"

var fails: i64 = 0

func check(cond: bool, msg: string) {
    if cond {
        println("PASS " + msg)
    } else {
        println("FAIL " + msg + "（" + trm.err_msg() + "）")
        fails = fails + 1
    }
}

func main() {
    var e0 = trm.init()
    check(e0 == 0, "trm.init 返回 0")
    var path = "tests/_p733_probe/calc_lib.tieir"
    var m0 = trm.load(path)
    check(m0 == 0, "trm.load 消费真实编译器 --target=trm 产物（模块 id 0）")
    check(trm.module_count() == 1, "类加载器注册表规模=1")

    // 执行边界（架构分界）：真实编译器 --target=trm 产物为 LLVM 风格 tie-IR
    // （zext/alloca/load 等），interp 前端语义基准是 LIR 子集（add/const_i/ret，
    // p.7.3.2-a 已用 LIR 样本验证执行正确性）。「编译器产物 → 引擎执行」的
    // 完整闭环需要路线 B 的 LIR 发射层（trm-lite 组件，致远期模块）——本
    // 阶段验收「产物可用」= 引擎类加载器可消费真实编译器产物：加载校验 +
    // 函数按名可查（执行入口可达）+ 注册表登记。
    check(trm.find_func("calc::add") >= 0, "真实编译器产物函数 calc::add 按名可查（执行入口可达）")
    check(ir.func_count() == 1 && ir.inst_count() == 8, "编译器产物 IR 规模正确（函数 1 / 指令 8）")

    if fails > 0 {
        println("p.7.3.3 探针自检失败 total=" + to_string(fails))
        exit(1)
    }
    println("p.7.3.3 探针自检通过（--target=trm 产物 → trm 引擎加载校验 + 函数按名可查）")
}