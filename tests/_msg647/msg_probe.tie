// 探针 p.6.4.7：msg_* 纯 tie 消息系统验收
func main() {
    // 1. set_lang / get_lang
    msg_set_lang("zh")
    if msg_get_lang() != "zh" {
        println("FAIL set_lang/get_lang")
        return
    }
    // 2. register + msg_t（当前 zh）
    msg_register("greet", "zh", "你好")
    if msg_t("greet") != "你好" {
        println("FAIL msg_t zh: [" + msg_t("greet") + "]")
        return
    }
    // 3. msg_t_lang 未注册语言 → 回退 key
    if msg_t_lang("greet", "en") != "greet" {
        println("FAIL msg_t_lang en: [" + msg_t_lang("greet", "en") + "]")
        return
    }
    // 4. 未注册 key → 回退 key
    if msg_t("nope") != "nope" {
        println("FAIL msg_t nope: [" + msg_t("nope") + "]")
        return
    }
    // 扩展：多语言登记 + 覆盖 + 指定语言命中
    msg_register("greet", "en", "Hello")
    if msg_t_lang("greet", "en") != "Hello" {
        println("FAIL msg_t_lang en hit: [" + msg_t_lang("greet", "en") + "]")
        return
    }
    msg_set_lang("en")
    if msg_t("greet") != "Hello" {
        println("FAIL msg_t en: [" + msg_t("greet") + "]")
        return
    }
    msg_register("greet", "en", "Hello!")
    if msg_t("greet") != "Hello!" {
        println("FAIL overwrite: [" + msg_t("greet") + "]")
        return
    }
    msg_set_lang("zh")
    if msg_t("greet") != "你好" {
        println("FAIL zh retained: [" + msg_t("greet") + "]")
        return
    }
    if msg_t_lang("greet", "fr") != "greet" {
        println("FAIL t_lang fr miss: [" + msg_t_lang("greet", "fr") + "]")
        return
    }
    println("PASS all msg_* probes")
}
