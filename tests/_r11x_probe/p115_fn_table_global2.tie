type tie<logic>
// r.1.1.5 最小复现：全局 table<fn() -> i64> 惰性 = [] 重赋值（fn 元素路径）。
// 期望：不崩溃，输出 7。
func f() -> i64 {
    return 7
}

var t: table<fn() -> i64> = []

func main() {
    table_push(t, f)
    println(to_string(t[0]()))
    // 惰性重赋值：运行时重置全局表
    t = []
    table_push(t, f)
    println(to_string(t[0]()))
}
