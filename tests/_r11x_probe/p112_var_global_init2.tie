type tie<logic>
// r.1.1.2 扩展复现：var 标量全局各形态初值。
// 期望输出：4 / -4 / 7 / 0 / 1 / 0 / 3.5 / hi
var g: i64 = 4
var gn: i64 = -4
var gc: i64 = 2 + 5
var gb: bool = false
var gt: bool = true
var gu: u32 = 0
var gf: f64 = 3.5
var gs: string = "hi"

func main() {
    println(to_string(g))
    println(to_string(gn))
    println(to_string(gc))
    println(to_string(gb))
    println(to_string(gt))
    println(to_string(gu))
    println(to_string(gf))
    println(gs)
}
