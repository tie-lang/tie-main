type tie<logic>
// r.1.1.3 扩展：全局表字面量初始化——嵌套/空表/字符串元素形态。
// 期望输出：
//   gs len=2 gs[1]=b
//   gn len=0
//   gn2 len=2 gn2[1]=2
//   g2d len=2 g2d[1][0]=3
var gs: table<string> = ["a", "b"]
var gn: table<i64> = []
var gn2: table<table<i64>> = [[1], [2]]
var g2d: table<table<i64>> = [[1, 2], [3, 4]]

func main() {
    println("gs len=" + to_string(len(gs)) + " gs[1]=" + gs[1])
    println("gn len=" + to_string(len(gn)))
    println("gn2 len=" + to_string(len(gn2)) + " gn2[1]=" + to_string(gn2[1][0]))
    println("g2d len=" + to_string(len(g2d)) + " g2d[1][0]=" + to_string(g2d[1][0]))
}
