type tie<logic>
// r.1.3 探针：std/json（r.1.3.1）+ std/yaml、std/markdown（r.1.3.2）字节化
// 扫描的性能与多字节等价验证。
//   - 性能：S / 2S 两种规模大输入（数 MB），断言耗时随规模近似线性
//     （t2x < 3*t1x + 30ms 容差，绝非二次方；旧实现逐码点 str_char O(i)/次，
//     同等输入耗时以分钟计甚至爆内存），全程无崩溃（节点表线性、内存有界）。
//   - 等价：多字节（中文/é/😀）键与值的解析/序列化/行内解析逐字节一致；
//     \uXXXX 代理对 / \b \f 转义（r.1.5.3 语义）不得回归。
// 编译运行：compiler\tiec.exe tests\_r13_probe\r13_perf_probe.tie -o <exe> && <exe>
import "../../std/json.tie" as json
import "../../std/yaml.tie" as yaml
import "../../std/markdown.tie" as md
import "../../std/string.tie" as str
import "../../std/time.tie" as time
import "../../std/utf.tie" as utf

func chk(name: string, got: string, want: string) {
    if got == want {
        println("PASS " + name)
    } else {
        println("FAIL " + name + " got=[" + got + "] want=[" + want + "]")
        exit(1)
    }
}

func chk_i64(name: string, got: i64, want: i64) {
    if got == want {
        println("PASS " + name)
    } else {
        println("FAIL " + name + " got=" + to_string(got) + " want=" + to_string(want))
        exit(1)
    }
}

func chk_true(name: string, cond: bool) {
    if cond {
        println("PASS " + name)
    } else {
        println("FAIL " + name + " expected true")
        exit(1)
    }
}

// 线性缩放断言（time_now 秒级分辨率）：S 尺寸 × iter 次 vs 2S 尺寸 × iter/2 次
// ——总字节相同：线性 ≈ 等时；二次方 → 约 4 倍耗时（2x 输入 2x 元素 × 每元素
// O(位置)）。容忍 GC/分配器噪声与 +1s 粒度误差，取 3x 为界（线性+噪声 < 3x，
// 二次方 ≥ 4x，可分离）。关键证据在绝对耗时（MB 级输入单次仅几十 ms，旧实现
// 同输入以分钟计/爆内存）。
func chk_linear(name: string, sec1: i64, sec2: i64) {
    if sec2 <= 3 * sec1 + 1 {
        println("PASS " + name + " (S×iter=" + to_string(sec1) + "s  2S×iter/2=" + to_string(sec2) + "s)")
    } else {
        println("FAIL " + name + " S=" + to_string(sec1) + "s 2S=" + to_string(sec2) + "s（疑似二次方）")
        exit(1)
    }
}

// ---------- json 性能：长字符串值（含多字节）+ 大数组 + 大对象 ----------
func tst_json_perf() {
    var unit = "中é😀abc"
    var t1 = str.repeat(unit, 50000)
    var doc1 = "[\"" + t1 + "\"]"
    var t0 = time.now()
    var i1: i64 = 0
    while i1 < 60 {
        var r = json.parse(doc1)
        i1 = i1 + 1
    }
    var p1 = time.now() - t0
    // 正确性（单次）
    var rc = json.parse(doc1)
    chk_true("json_big_str_byte_exact", json.str_val(json.arr_at(rc, 0)) == t1)
    var t2 = str.repeat(unit, 100000)
    var doc2 = "[\"" + t2 + "\"]"
    t0 = time.now()
    var i2: i64 = 0
    while i2 < 30 {
        var r2 = json.parse(doc2)
        i2 = i2 + 1
    }
    var p2 = time.now() - t0
    chk_linear("json_str_parse_linear", p1, p2)
    // to_str（escape_json_str 输出侧）
    var rc2 = json.parse(doc1)
    t0 = time.now()
    var s1: i64 = 0
    while s1 < 60 {
        var s = json.to_str(rc2)
        s1 = s1 + 1
    }
    var st1 = time.now() - t0
    var rc3 = json.parse(doc2)
    t0 = time.now()
    var s2n: i64 = 0
    while s2n < 30 {
        var s2 = json.to_str(rc3)
        s2n = s2n + 1
    }
    var st2 = time.now() - t0
    chk_linear("json_str_to_str_linear", st1, st2)
    println("INFO json_str bytes=" + to_string(len(doc1)) + "/" + to_string(len(doc2)) + " parse60x=" + to_string(p1) + "s parse30x2x=" + to_string(p2) + "s tostr60x=" + to_string(st1) + "s tostr30x2x=" + to_string(st2) + "s")

    // 大数组（parse_value/parse_number 热路径 + arr_to_str builder）
    var chunk = "123,"
    var ad1 = "[" + str.repeat(chunk, 60000) + "123]"
    t0 = time.now()
    var a1: i64 = 0
    while a1 < 200 {
        var r = json.parse(ad1)
        a1 = a1 + 1
    }
    var ap1 = time.now() - t0
    var ar1 = json.parse(ad1)
    chk_i64("json_big_arr_len", json.arr_len(ar1), 60001)
    var ad2 = "[" + str.repeat(chunk, 120000) + "123]"
    t0 = time.now()
    var a2: i64 = 0
    while a2 < 100 {
        var r2 = json.parse(ad2)
        a2 = a2 + 1
    }
    var ap2 = time.now() - t0
    chk_i64("json_big_arr2_len", json.arr_len(json.parse(ad2)), 120001)
    chk_linear("json_arr_parse_linear", ap1, ap2)
    t0 = time.now()
    var at1: i64 = 0
    while at1 < 200 {
        var s = json.to_str(ar1)
        at1 = at1 + 1
    }
    var astr1 = time.now() - t0
    var ar2 = json.parse(ad2)
    t0 = time.now()
    var at2: i64 = 0
    while at2 < 100 {
        var s2 = json.to_str(ar2)
        at2 = at2 + 1
    }
    var astr2 = time.now() - t0
    chk_linear("json_arr_to_str_linear", astr1, astr2)
    println("INFO json_arr bytes=" + to_string(len(ad1)) + "/" + to_string(len(ad2)) + " parse200x=" + to_string(ap1) + "s parse100x2x=" + to_string(ap2) + "s tostr200x=" + to_string(astr1) + "s tostr100x2x=" + to_string(astr2) + "s")

    // 大对象（obj_to_str builder 路径）
    var ob = string_builder()
    sb_append(ob, "{")
    var k: i64 = 0
    while k < 30000 {
        if k > 0 {
            sb_append(ob, ",")
        }
        sb_append(ob, "\"k")
        sb_append(ob, to_string(k))
        sb_append(ob, "\":1")
        k = k + 1
    }
    sb_append(ob, "}")
    var od1 = sb_build(ob)
    t0 = time.now()
    var o1: i64 = 0
    while o1 < 60 {
        var r = json.parse(od1)
        o1 = o1 + 1
    }
    var op1 = time.now() - t0
    var oo1 = json.parse(od1)
    chk_i64("json_big_obj_kv", json.int_val(json.obj_get(oo1, "k29999")), 1)
    chk_i64("json_big_obj_missing", json.obj_get(oo1, "nope"), -1)
    var ob2 = string_builder()
    sb_append(ob2, "{")
    var k2: i64 = 0
    while k2 < 60000 {
        if k2 > 0 {
            sb_append(ob2, ",")
        }
        sb_append(ob2, "\"k")
        sb_append(ob2, to_string(k2))
        sb_append(ob2, "\":1")
        k2 = k2 + 1
    }
    sb_append(ob2, "}")
    var od2 = sb_build(ob2)
    t0 = time.now()
    var o2: i64 = 0
    while o2 < 30 {
        var r2 = json.parse(od2)
        o2 = o2 + 1
    }
    var op2 = time.now() - t0
    chk_linear("json_obj_parse_linear", op1, op2)
    t0 = time.now()
    var ot1: i64 = 0
    while ot1 < 60 {
        var s = json.to_str(oo1)
        ot1 = ot1 + 1
    }
    var ostr1 = time.now() - t0
    var oo2 = json.parse(od2)
    t0 = time.now()
    var ot2: i64 = 0
    while ot2 < 30 {
        var s2 = json.to_str(oo2)
        ot2 = ot2 + 1
    }
    var ostr2 = time.now() - t0
    chk_linear("json_obj_to_str_linear", ostr1, ostr2)
    println("INFO json_obj bytes=" + to_string(len(od1)) + "/" + to_string(len(od2)) + " parse60x=" + to_string(op1) + "s parse30x2x=" + to_string(op2) + "s tostr60x=" + to_string(ostr1) + "s tostr30x2x=" + to_string(ostr2) + "s")
}

// ---------- json 等价：多字节 + r.1.5.3 转义语义 ----------
func tst_json_eq() {
    chk("json_mb_str", json.str_val(json.parse("\"中é😀\\u4E2D\\uD83D\\uDE00\"")), "中é😀中😀")
    // 原始 UTF-8 多字节 + \u 转义混排的往返（解析 → 序列化 → 解析，逐字节一致）
    // 注：txt 中 \b\f 位于 é😀 之前，v 须按同序构造
    var v = "中\"\\\n\t" + utf.from_code(8) + utf.from_code(12) + "é😀"
    var txt = "\"" + "中" + utf.from_code(92) + utf.from_code(34) + utf.from_code(92) + utf.from_code(92) + utf.from_code(92) + "n" + utf.from_code(92) + "t" + utf.from_code(92) + "b" + utf.from_code(92) + "f" + "é😀" + "\""
    // txt = "中\"\\\n\t\b\fé😀" 的 JSON 编码文本
    var nd = json.parse(txt)
    chk("json_mb_esc_parse", json.str_val(nd), v)
    chk("json_mb_esc_to_str_exact", json.to_str(nd), txt)
    var rt = json.parse(txt)
    chk("json_mb_esc_rt", json.str_val(rt), v)
    // 多字节键 + 转义键（JSON 文本经 from_code 构造，避免 tie 字面量双重转义）
    var q = utf.from_code(34)
    var bs = utf.from_code(92)
    var o = json.parse("{\"键\":\"值\"," + q + "a" + bs + q + "b" + q + ":1}")
    chk("json_mb_key", json.str_val(json.obj_get(o, "键")), "值")
    chk_i64("json_esc_key", json.int_val(json.obj_get(o, "a\"b")), 1)
    // 多字节数组元素
    var a = json.parse("[\"中\",\"é\",\"😀\"]")
    chk_i64("json_mb_arr_len", json.arr_len(a), 3)
    chk("json_mb_arr_0", json.str_val(json.arr_at(a, 0)), "中")
    chk("json_mb_arr_2", json.str_val(json.arr_at(a, 2)), "😀")
    // 大数（parse_number 全程字节化；18 位整数 + 长小数）
    chk_i64("json_num_big", json.int_val(json.parse("123456789012345678")), 123456789012345678)
    var f = json.parse("3.141592653589793238462643")
    chk_true("json_num_float_ok", json.is_float(f))
}

// ---------- yaml 性能：多字节键值 + 流式，双规模 ----------
func tst_yaml_perf() {
    var sb1 = string_builder()
    var i: i64 = 0
    while i < 30000 {
        sb_append(sb1, "键")
        sb_append(sb1, to_string(i))
        sb_append(sb1, ": \"值")
        sb_append(sb1, to_string(i))
        sb_append(sb1, "中é😀\"\n")
        i = i + 1
    }
    var yd1 = sb_build(sb1)
    var t0 = time.now()
    var y1: i64 = 0
    while y1 < 40 {
        var r = yaml.parse(yd1)
        y1 = y1 + 1
    }
    var yp1 = time.now() - t0
    var yr1 = yaml.parse(yd1)
    chk_i64("yaml_big_map_len", len(yaml.obj_keys(yr1)), 30000)
    chk("yaml_big_map_val", yaml.str_val(yaml.obj_get(yr1, "键29999")), "值29999中é😀")
    var sb2 = string_builder()
    var j: i64 = 0
    while j < 60000 {
        sb_append(sb2, "键")
        sb_append(sb2, to_string(j))
        sb_append(sb2, ": \"值")
        sb_append(sb2, to_string(j))
        sb_append(sb2, "中é😀\"\n")
        j = j + 1
    }
    var yd2 = sb_build(sb2)
    t0 = time.now()
    var y2: i64 = 0
    while y2 < 20 {
        var r2 = yaml.parse(yd2)
        y2 = y2 + 1
    }
    var yp2 = time.now() - t0
    var yr2 = yaml.parse(yd2)
    chk_i64("yaml_big_map2_len", len(yaml.obj_keys(yr2)), 60000)
    chk("yaml_big_map2_val", yaml.str_val(yaml.obj_get(yr2, "键59999")), "值59999中é😀")
    chk_linear("yaml_map_parse_linear", yp1, yp2)
    println("INFO yaml_map bytes=" + to_string(len(yd1)) + "/" + to_string(len(yd2)) + " parse40x=" + to_string(yp1) + "s parse20x2x=" + to_string(yp2) + "s")

    // 大流式序列（flow 路径）
    var fs1 = str.repeat("- [1, 2, \"中é\"]\n", 20000)
    t0 = time.now()
    var f1: i64 = 0
    while f1 < 60 {
        var r = yaml.parse(fs1)
        f1 = f1 + 1
    }
    var fp1 = time.now() - t0
    chk_i64("yaml_big_flow_len", yaml.arr_len(yaml.parse(fs1)), 20000)
    var fs2 = str.repeat("- [1, 2, \"中é\"]\n", 40000)
    t0 = time.now()
    var f2: i64 = 0
    while f2 < 30 {
        var r2 = yaml.parse(fs2)
        f2 = f2 + 1
    }
    var fp2 = time.now() - t0
    chk_i64("yaml_big_flow2_len", yaml.arr_len(yaml.parse(fs2)), 40000)
    chk_linear("yaml_flow_parse_linear", fp1, fp2)
    println("INFO yaml_flow bytes=" + to_string(len(fs1)) + "/" + to_string(len(fs2)) + " parse60x=" + to_string(fp1) + "s parse30x2x=" + to_string(fp2) + "s")
}

// ---------- yaml 等价：多字节键/值/注释/流式/块折叠 ----------
func tst_yaml_eq() {
    // 多字节键（bslice/colon_sep 字节边界）
    var r1 = yaml.parse("键: 值\n")
    chk("yaml_mb_key", yaml.str_val(yaml.obj_get(r1, "键")), "值")
    // 原始 UTF-8 多字节流式值（旧实现码点/字节混用在此路径错位）
    var r2 = yaml.parse("k: [\"中\", é]\n")
    var arr = yaml.obj_get(r2, "k")
    chk_i64("yaml_mb_flow_len", yaml.arr_len(arr), 2)
    chk("yaml_mb_flow_0", yaml.str_val(yaml.arr_at(arr, 0)), "中")
    chk("yaml_mb_flow_1", yaml.str_val(yaml.arr_at(arr, 1)), "é")
    // 行内注释：多字节后 # 非注释起始；空白后 # 为注释
    var r3 = yaml.parse("a: 中#not comment\nb: 值 # comment\n")
    chk("yaml_mb_comment_keep", yaml.str_val(yaml.obj_get(r3, "a")), "中#not comment")
    chk("yaml_mb_comment_strip", yaml.str_val(yaml.obj_get(r3, "b")), "值")
    // 单引号串多字节 + '' 转义
    var r4 = yaml.parse("c: '中文''引号'\n")
    chk("yaml_mb_single_quote", yaml.str_val(yaml.obj_get(r4, "c")), "中文'引号")
    // \uXXXX 任意码点 + 代理对（r.1.5.3 语义）
    var r5 = yaml.parse("k: \"\\u4E2D\\u00E9\\uD83D\\uDE00\\b\\f\"\n")
    chk("yaml_esc_mb", yaml.str_val(yaml.obj_get(r5, "k")), "中é😀" + utf.from_code(8) + utf.from_code(12))
    // 多行折叠含多字节
    var r6 = yaml.parse("lit: |\n  第一行\n  第二行\nfold: >\n  折 a\n  折 b\n")
    chk("yaml_mb_block_lit", yaml.str_val(yaml.obj_get(r6, "lit")), "第一行\n第二行\n")
    chk("yaml_mb_block_fold", yaml.str_val(yaml.obj_get(r6, "fold")), "折 a 折 b\n")
    // 内联映射（序列项）含多字节键
    var r7 = yaml.parse("- 键1: 值1\n- 键2: 值2\n")
    chk_i64("yaml_mb_inline_map_len", yaml.arr_len(r7), 2)
    chk("yaml_mb_inline_map_0", yaml.str_val(yaml.obj_get(yaml.arr_at(r7, 0), "键1")), "值1")
}

// ---------- markdown 性能：标题/表格/段落/行内，双规模 ----------
func tst_md_perf() {
    var blk = "# 标题中\n\n| 列1 | 列2 |\n|---|---|\n| 中é | 😀 |\n\n段落 with **粗体** and `码` and [链接](url)\n\n"
    var d1 = str.repeat(blk, 4000)
    var t0 = time.now()
    var m1: i64 = 0
    while m1 < 60 {
        var hs = md.parse(d1)
        m1 = m1 + 1
    }
    var mp1 = time.now() - t0
    var mh1 = md.parse(d1)
    chk_true("md_big_blocks_ok", len(mh1) == 12000)
    var d2 = str.repeat(blk, 8000)
    t0 = time.now()
    var m2: i64 = 0
    while m2 < 30 {
        var hs2 = md.parse(d2)
        m2 = m2 + 1
    }
    var mp2 = time.now() - t0
    var mh2 = md.parse(d2)
    chk_true("md_big2_blocks_ok", len(mh2) == 24000)
    chk_linear("md_parse_linear", mp1, mp2)
    // 行内（scan_inline + find_char/find_sub 字节化）
    var it1s = "**粗体** and `码` and [链接](url) " + str.repeat("x", 1000)
    t0 = time.now()
    var n1: i64 = 0
    while n1 < 1500 {
        var tk = md.inline_tokens(it1s)
        n1 = n1 + 1
    }
    var ip1 = time.now() - t0
    var it2s = "**粗体** and `码` and [链接](url) " + str.repeat("x", 2000)
    t0 = time.now()
    var n2: i64 = 0
    while n2 < 750 {
        var tk2 = md.inline_tokens(it2s)
        n2 = n2 + 1
    }
    var ip2 = time.now() - t0
    chk_linear("md_inline_linear", ip1, ip2)
    println("INFO md_block bytes=" + to_string(len(d1)) + "/" + to_string(len(d2)) + " parse60x=" + to_string(mp1) + "s parse30x2x=" + to_string(mp2) + "s | inline1500x=" + to_string(ip1) + "s inline750x2x=" + to_string(ip2) + "s")
}

// ---------- markdown 等价：多字节标题/表格/行内 ----------
func tst_md_eq() {
    var h1 = md.parse("# 标题中\n")
    chk("md_mb_heading", md.btext(md.block_at(0)), "标题中")
    var t1 = md.parse("| 列1 | 列2 |\n|---|---|\n| 中é | 😀 |\n")
    var tb = md.block_at(0)
    chk_i64("md_mb_table_cols", md.table_cols(tb), 2)
    chk_i64("md_mb_table_rows", md.table_rows(tb), 2)
    chk("md_mb_cell_hdr", md.cell(tb, 0, 0), "列1")
    chk("md_mb_cell_data", md.cell(tb, 1, 0), "中é")
    chk("md_mb_cell_emoji", md.cell(tb, 1, 1), "😀")
    var tk = md.inline_tokens("**粗体** and `码` and [链接](url)")
    chk_i64("md_mb_tok_len", len(tk), 11)
    chk("md_mb_tok_bold", tk[0], "1")
    chk("md_mb_tok_bold_txt", tk[1], "粗体")
    chk("md_mb_tok_code", tk[4], "4")
    chk("md_mb_tok_code_txt", tk[5], "码")
    chk("md_mb_tok_link", tk[8], "3")
    chk("md_mb_tok_link_txt", tk[9], "链接")
    chk("md_mb_tok_link_url", tk[10], "url")
}

func main() {
    tst_json_perf()
    tst_json_eq()
    tst_yaml_perf()
    tst_yaml_eq()
    tst_md_perf()
    tst_md_eq()
    println("done")
    exit(0)
}
