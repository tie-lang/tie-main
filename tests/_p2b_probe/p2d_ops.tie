type tie<logic>
// P2d 探针：coll 表操作（reverse/to_string/join/sum/product/max/min）

import "../../std/collection.tie"

func main() {
    var t: table<i64> = [3, 1, 4, 1, 5]
    // reverse
    var rv = coll.reverse_i64(t)
    var i: i64 = 0
    while i < len(rv) {
        println(rv[i])
        i = i + 1
    }
    // to_string（表打印）
    println(coll.to_string_i64(t))
    var st: table<string> = ["a", "b", "c"]
    println(coll.to_string_string(st))
    // 空表
    var e: table<i64> = table_new_i64()
    println(coll.to_string_i64(e))
    // join
    println(coll.join(st, ", "))
    println(coll.join(st, "-"))
    // sum / product
    println(coll.sum_i64(t))
    println(coll.product_i64(t))
    // max / min
    println(coll.max_i64(t))
    println(coll.min_i64(t))
    // 管道组合：反转 + 打印
    println(t -> coll.reverse_i64() -> coll.to_string_i64())
}
