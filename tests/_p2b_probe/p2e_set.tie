type tie<logic>
// P2e-T1 探针：coll set 集合（add/contains/remove/union/intersect/diff，i64+string）

import "../../std/collection.tie"

func main() {
    // i64 set：添加去重 + 有序
    var s = coll.set_new_i64()
    coll.set_add_i64(s, 5)
    coll.set_add_i64(s, 1)
    coll.set_add_i64(s, 3)
    coll.set_add_i64(s, 5) // 重复 → 不变
    coll.set_add_i64(s, 3) // 重复 → 不变
    println(coll.set_size_i64(s)) // 4
    println(coll.set_contains_i64(s, 3)) // true
    println(coll.set_contains_i64(s, 9)) // false
    // 有序输出：1,3,5,(5? no) → 实际 1,3,5,? 
    var i: i64 = 0
    while i < len(s) {
        println(s[i])
        i = i + 1
    }
    // 移除
    println(coll.set_remove_i64(s, 3)) // true
    println(coll.set_remove_i64(s, 3)) // false（已移除）
    println(coll.set_size_i64(s)) // 3
    // 集合运算
    var a = coll.set_new_i64()
    coll.set_add_i64(a, 1)
    coll.set_add_i64(a, 2)
    coll.set_add_i64(a, 3)
    var b = coll.set_new_i64()
    coll.set_add_i64(b, 2)
    coll.set_add_i64(b, 3)
    coll.set_add_i64(b, 4)
    var u = coll.set_union_i64(a, b)      // [1,2,3,4]
    var it = coll.set_intersect_i64(a, b) // [2,3]
    var d = coll.set_diff_i64(a, b)       // [1]
    println(len(u))
    println(len(it))
    println(len(d))
    println(u[0])
    println(it[0])
    println(d[0])
    // string set
    var ss = coll.set_new_string()
    coll.set_add_string(ss, "pear")
    coll.set_add_string(ss, "apple")
    coll.set_add_string(ss, "apple")
    coll.set_add_string(ss, "grape")
    println(coll.set_size_string(ss)) // 3
    println(coll.set_contains_string(ss, "apple")) // true
    println(coll.set_contains_string(ss, "kiwi")) // false
    println(coll.set_remove_string(ss, "grape")) // true
    println(coll.set_size_string(ss)) // 2
    // string 集合运算
    var sa = coll.set_new_string()
    coll.set_add_string(sa, "x")
    coll.set_add_string(sa, "y")
    var sb = coll.set_new_string()
    coll.set_add_string(sb, "y")
    coll.set_add_string(sb, "z")
    var su = coll.set_union_string(sa, sb)       // [x,y,z]
    var si = coll.set_intersect_string(sa, sb)   // [y]
    var sd = coll.set_diff_string(sa, sb)        // [x]
    println(len(su))
    println(len(si))
    println(len(sd))
    println(su[1])
    println(si[0])
    println(sd[0])
}
