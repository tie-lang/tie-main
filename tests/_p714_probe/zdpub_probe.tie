type tie<logic>
// tests/_p714_probe/zdpub_probe.tie —— Keel 龙骨 p.7.1.4 data→zd 发布 + 指纹核验探针
// ============================================================
// 验收：zd 包加载运行与 data 等价 + 指纹可核验。
//   1) publish(cfg.data.tie → out.zd) 返回 0（压缩 + 写 .zd.fp 指纹）。
//   2) load(out.zd) 返回 0 —— 指纹一致，zd 与 data 等价可加载。
//   3) 篡改 out.zd 一个字节后 load 返回 -1（指纹不符拒绝）。
//   4) 重新 publish（重做恢复）返回 0，再 load 一致。
// 全过打印自检通过并 exit 0。
//
// # import 说明（语言边界）
// import 文本内联 + 归一化路径去重：探针只 import zdpub（其内部链式引
// tdzd/config/zdwrite + std/tsha1）。探针不单独 re-import tsha1，避免依赖
// 顺序歧义；指纹逻辑封装在 zdpub.publish/load 内。
import "../../compiler/zdpub.tie"

var fails: i64 = 0

func check(cond: bool, msg: string) {
    if cond {
        println("PASS " + msg)
    } else {
        println("FAIL " + msg + "（" + zdpub.err_msg() + "）")
        fails = fails + 1
    }
}

func main() {
    var data = "tests/_p714_probe/cfg.data.tie"
    var zd = "tests/_p714_probe/out.zd"

    // 1) publish：压缩 + 指纹清单
    var r1 = zdpub.publish(data, zd)
    check(r1 == 0, "publish 返回 0")

    // 2) load：指纹一致 → zd 与 data 等价可加载
    var r2 = zdpub.load(zd)
    check(r2 == 0, "load 指纹一致返回 0")

    // 3) 篡改一个字节（改头字节）→ 指纹不符拒绝
    if file_exists(zd) {
        var b = byte_read(zd)
        if len(b) > 4 {
            b[0] = b[0] ^ 0x20
            byte_write(zd, b)
        }
    }
    var r3 = zdpub.load(zd)
    check(r3 == -1, "篡改后 load 拒绝返回 -1")

    // 4) 重新 publish（合法路径重做）→ 0，再 load 一致
    var r4 = zdpub.publish(data, zd)
    check(r4 == 0, "重新 publish 返回 0")
    var r5 = zdpub.load(zd)
    check(r5 == 0, "恢复后 load 指纹一致返回 0")

    if fails > 0 {
        println("zdpub p.7.1.4 自检失败 total=" + to_string(fails))
        exit(1)
    }
    println("zdpub p.7.1.4 自检通过（publish+load+篡改拒绝）")
}