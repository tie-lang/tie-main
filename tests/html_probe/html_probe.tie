type tie<logic>
// ============================================================================
// html_probe.tie：ext/html HTML 解析探针（p.6.6.4）。
// HTML parsing probe (p.6.6.4).
//
// 覆盖（Coverage）：
//   - 样本① 嵌套元素 + 属性 + 注释 + doctype + 大小写混写 + UTF-8 中文：
//     tag/attr 解析、大小写折叠、中文保真、注释与 doctype 不入树、节点访问器、
//     选择器（tag/.class/#id/[attr]/[attr=value]/后代组合）、纯文本换行；
//   - 样本② raw text（script/style 含 "<" ">" "&" 伪标签）+ 各类链接：
//     raw 原样保留、实体解码、links 绝对化（相对/绝对/根路径/协议相对/
//     query+fragment）；
//   - 样本③ 畸形输入（未闭合、错位、孤立 "<"、"<3"、连续 li 隐式闭合）：
//     不崩溃、解析出预期子集、无标签泄漏；
//   - 大样本 >200KB：单遍解析 + 选择器 + 链接 + 纯文本，秒级完成（防 O(n^2)）。
// 数据平面：全 string（UTF-8）；无字节表。夹具全部内联（不入库）。
// 编译运行：compiler\tiec.exe tests\html_probe\html_probe.tie（勿用根旧 tiec3.exe）
// ============================================================================
import "../../ext/html/html.tie" as html
import "../../std/string.tie" as str
import "../../std/time.tie" as time

// ---- 断言工具 ----
func chk(name: string, got: string, want: string) {
    if got == want {
        println("PASS " + name)
    } else {
        println("FAIL " + name + " got=[" + got + "] want=[" + want + "]")
        exit(1)
    }
}

func chk_i64(name: string, got: i64, want: i64) {
    if got == want {
        println("PASS " + name)
    } else {
        println("FAIL " + name + " got=" + to_string(got) + " want=" + to_string(want))
        exit(1)
    }
}

// 字节级 contains（中文安全）
func chk_contains(name: string, hay: string, needle: string) {
    var n = len(hay)
    var m = len(needle)
    var found = false
    var i: i64 = 0
    while i + m <= n {
        var j: i64 = 0
        var ok = true
        while j < m {
            if str_byte(hay, i + j) != str_byte(needle, j) {
                ok = false
                break
            }
            j = j + 1
        }
        if ok {
            found = true
            break
        }
        i = i + 1
    }
    if found {
        println("PASS " + name)
    } else {
        println("FAIL " + name + " needle=[" + needle + "] hay=[" + hay + "]")
        exit(1)
    }
}

func chk_not_contains(name: string, hay: string, needle: string) {
    var n = len(hay)
    var m = len(needle)
    var found = false
    var i: i64 = 0
    while i + m <= n {
        var j: i64 = 0
        var ok = true
        while j < m {
            if str_byte(hay, i + j) != str_byte(needle, j) {
                ok = false
                break
            }
            j = j + 1
        }
        if ok {
            found = true
            break
        }
        i = i + 1
    }
    if found {
        println("FAIL " + name + " 不应包含 [" + needle + "] 却包含于 [" + hay + "]")
        exit(1)
    }
    println("PASS " + name)
}

func fail(msg: string) {
    println("FAIL " + msg)
    exit(1)
}

// ---- 样本①：嵌套 + 属性 + 注释/doctype + 大小写混写 + 中文 ----
func sample1() -> string {
    return "<!DOCTYPE html>\n" +
        "<html>\n" +
        "<body>\n" +
        "<div id=\"main\" CLASS=\"container\" data-x=\"42\">\n" +
        "  <p>你好，世界</p>\n" +
        "  <p class=\"cls1 cls2\">Second</p>\n" +
        "  <!-- hidden comment -->\n" +
        "  <a href=\"page.html\" title=\"Page\">Link</a>\n" +
        "</div>\n" +
        "</body>\n" +
        "</html>"
}

// ---- 样本②：raw text + 伪标签 + 各类链接 + 实体 ----
func sample2() -> string {
    return "<html>\n" +
        "<head>\n" +
        "<link rel=\"stylesheet\" href=\"/css/main.css\">\n" +
        "<script src=\"app.js\"></script>\n" +
        "</head>\n" +
        "<body>\n" +
        "<script> if (a < b && c > d) { x = \"&amp;\"; } </script>\n" +
        "<style> p > a { color: red; } </style>\n" +
        "<h1>Title &amp; <b>bold</b></h1>\n" +
        "<a href=\"../up/page.html?q=1#sec\" data-q=\"1&amp;2\">a1</a>\n" +
        "<a href=\"/abs/path\">a2</a>\n" +
        "<a href=\"//cdn.example.com/x.js\">a3</a>\n" +
        "<a href=\"#tip\">a4</a>\n" +
        "<img src=\"img/logo.png\">\n" +
        "</body>\n" +
        "</html>"
}

// ---- 样本③：畸形输入 ----
func sample3() -> string {
    return "<p>unclosed<div>xyz</p>tail<span class=\"t\"><b>bold<i>both</b>after</span> <3 love &amp; more&nbsp;x<div><li>one<li>two</div>"
}

func tst_sample1() -> HtmlDoc {
    var d = html.parse(sample1())
    chk_i64("s1_node_count_gt1", html.node_count(d) > 1 ? 1 : 0, 1)
    // 标签/属性解析 + 大小写折叠断言
    var divs = html.query(d, "div")
    chk_i64("s1_query_div", len(divs), 1)
    chk("s1_div_tag", html.tag(d, divs[0]), "div")
    chk_i64("s1_query_DIV_upper", len(html.query(d, "DIV")), 1)
    chk("s1_attr_id", html.attr(d, divs[0], "id"), "main")
    chk("s1_attr_CLASS_fold", html.attr(d, divs[0], "CLASS"), "container")
    chk("s1_attr_data_x", html.attr(d, divs[0], "data-x"), "42")
    chk("s1_attr_missing", html.attr(d, divs[0], "nope"), "")
    // 中文文本保真（文本节点）
    var ps = html.query(d, "p")
    chk_i64("s1_query_p", len(ps), 2)
    var p1 = ps[0]
    var kids1 = html.children(d, p1)
    chk_i64("s1_p1_children", len(kids1), 1)
    chk("s1_cn_text", html.content(d, kids1[0]), "你好，世界")
    // 元素节点 content 返回空
    chk("s1_el_content_empty", html.content(d, p1), "")
    // 树关系
    chk_i64("s1_parent_p", html.parent(d, p1), divs[0])
    var bodys = html.query(d, "body")
    chk_i64("s1_query_body", len(bodys), 1)
    chk_i64("s1_parent_div", html.parent(d, divs[0]), bodys[0])
    chk_i64("s1_body_children", len(html.children(d, bodys[0])), 3)
    var bkids = html.children(d, bodys[0])
    chk("s1_child1_tag", html.tag(d, bkids[1]), "div")
    // 注释/doctype 不入树
    chk_i64("s1_no_comment_tag", len(html.query(d, "!--")), 0)
    chk_i64("s1_html_count", len(html.query(d, "html")), 1)
    var pt1 = html.plain(d)
    chk_not_contains("s1_plain_no_comment", pt1, "hidden comment")
    chk_not_contains("s1_plain_no_doctype", pt1, "DOCTYPE")
    chk_not_contains("s1_plain_no_tag_leak", pt1, "<div")
    // 纯文本：中文完整、块级换行合理
    chk_contains("s1_plain_cn", pt1, "你好，世界")
    chk_contains("s1_plain_lb", pt1, "\nSecond")
    chk_contains("s1_plain_link", pt1, "Link")
    // 选择器：class / id / 属性 / 后代 / 复合
    chk_i64("s1_sel_class", len(html.query(d, ".cls1")), 1)
    chk_i64("s1_sel_class2", len(html.query(d, ".cls2")), 1)
    chk_i64("s1_sel_id", len(html.query(d, "#main")), 1)
    chk_i64("s1_sel_attr_pres", len(html.query(d, "[data-x]")), 1)
    chk_i64("s1_sel_attr_eq", len(html.query(d, "[data-x=42]")), 1)
    chk_i64("s1_sel_attr_eq_upper", len(html.query(d, "[DATA-X=42]")), 1)
    chk_i64("s1_sel_desc", len(html.query(d, "div p")), 2)
    chk_i64("s1_sel_desc2", len(html.query(d, "body #main")), 1)
    chk_i64("s1_sel_desc3", len(html.query(d, "html #main")), 1)
    chk_i64("s1_sel_complex", len(html.query(d, "div .cls1")), 1)
    chk_i64("s1_sel_p_cls", len(html.query(d, "p.cls2")), 1)
    chk_i64("s1_sel_a_href", len(html.query(d, "a[href]")), 1)
    chk_i64("s1_sel_star", len(html.query(d, "*")), 6)
    return d
}

func tst_sample2() {
    var d = html.parse(sample2())
    // raw text（script/style）原样保留含 "<" ">" "&" 伪标签
    var scrs = html.query(d, "script")
    chk_i64("s2_script_count", len(scrs), 2)
    var sc_k = html.children(d, scrs[1])   // [1]=body 的内联 script（raw 内容所在）
    chk_i64("s2_script_kids", len(sc_k), 1)
    chk_contains("s2_raw_pseudo", html.content(d, sc_k[0]), "a < b && c > d")
    chk_contains("s2_raw_amp", html.content(d, sc_k[0]), "&amp;")
    // 实体解码（正文与属性值）
    var h1s = html.query(d, "h1")
    chk_i64("s2_h1_count", len(h1s), 1)
    chk_contains("s2_plain_entity", html.plain(d), "Title & ")
    var a1 = html.query(d, "a")[0]
    chk("s2_attr_entity", html.attr(d, a1, "data-q"), "1&2")
    // 纯文本：去 script/style；无标签泄漏
    var pt = html.plain(d)
    chk_not_contains("s2_plain_no_script", pt, "if (a < b")
    chk_not_contains("s2_plain_no_style", pt, "color")
    chk_not_contains("s2_plain_no_script_tag", pt, "<script>")
    chk_not_contains("s2_plain_no_style_tag", pt, "<style>")
    chk_not_contains("s2_plain_no_b_tag", pt, "<b>")
    chk_contains("s2_plain_bold", pt, "bold")
    // 选择器
    chk_i64("s2_sel_a_href", len(html.query(d, "a[href]")), 4)
    chk_i64("s2_sel_href", len(html.query(d, "[href]")), 5)
    chk_i64("s2_sel_link", len(html.query(d, "link[href]")), 1)
    chk_i64("s2_sel_script_src", len(html.query(d, "script[src]")), 1)
    chk_i64("s2_sel_head_script", len(html.query(d, "head script")), 1)
    chk_i64("s2_sel_html_script", len(html.query(d, "html script")), 2)
    chk_i64("s2_sel_rel", len(html.query(d, "[rel]")), 1)
    // links 绝对化（相对/绝对/根路径/协议相对/query+fragment）
    var ls = html.links(d, "http://example.com/a/b/index.html")
    chk_i64("s2_links_count", len(ls), 7)
    chk("s2_links0", ls[0], "http://example.com/css/main.css")
    chk("s2_links1", ls[1], "http://example.com/a/b/app.js")
    chk("s2_links2", ls[2], "http://example.com/a/up/page.html?q=1#sec")
    chk("s2_links3", ls[3], "http://example.com/abs/path")
    chk("s2_links4", ls[4], "http://cdn.example.com/x.js")
    chk("s2_links5", ls[5], "http://example.com/a/b/index.html#tip")
    chk("s2_links6", ls[6], "http://example.com/a/b/img/logo.png")
}

func tst_sample3() {
    var d = html.parse(sample3())
    // 畸形输入：不崩溃且解析出预期子集
    chk_i64("s3_sel_p", len(html.query(d, "p")), 1)
    chk_i64("s3_sel_div", len(html.query(d, "div")), 2)
    chk_i64("s3_sel_li", len(html.query(d, "li")), 2)
    chk_i64("s3_sel_span", len(html.query(d, "span")), 1)
    chk_i64("s3_sel_t_class", len(html.query(d, ".t")), 1)
    chk_i64("s3_sel_b", len(html.query(d, "b")), 1)
    chk_i64("s3_sel_i", len(html.query(d, "i")), 1)
    chk_i64("s3_sel_gt_child", len(html.query(d, "div > li")), 2)   // '>' 子组合器
    // 连续 li 隐式闭合：两 li 内容独立
    var lis = html.query(d, "li")
    chk("s3_li0_text", html.content(d, html.children(d, lis[0])[0]), "one")
    chk("s3_li1_text", html.content(d, html.children(d, lis[1])[0]), "two")
    // 文本保真 + 无标签泄漏（"<3" 与孤立 '<' 按文本）
    var pt = html.plain(d)
    chk_contains("s3_plain_unclosed", pt, "unclosed")
    chk_contains("s3_plain_xyz", pt, "xyz")
    chk_contains("s3_plain_tail", pt, "tail")
    chk_contains("s3_plain_bold", pt, "bold")
    chk_contains("s3_plain_both", pt, "both")
    chk_contains("s3_plain_after", pt, "after")
    chk_contains("s3_plain_lt3", pt, "<3 love")
    chk_contains("s3_plain_entity_amp", pt, "& more")
    var nbsp = str_from_code(160)
    chk_contains("s3_plain_nbsp", pt, "more" + nbsp + "x")
    chk_not_contains("s3_plain_no_div", pt, "<div>")
    chk_not_contains("s3_plain_no_b", pt, "<b>")
    chk_not_contains("s3_plain_no_p", pt, "</p>")
    // 数字实体
    var d2 = html.parse("<p>&#65;&#x42;&amp;</p>")
    var pk = html.children(d2, html.query(d2, "p")[0])
    chk("s3_num_entity", html.content(d2, pk[0]), "AB&")
    // 空输入 → 空文档（仅根节点）
    var d3 = html.parse("")
    chk_i64("s3_empty_doc", html.node_count(d3), 1)
}

func tst_big() {
    // 大样本 >200KB：单遍解析 + 查询 + 链接 + 纯文本，秒级完成（防 O(n^2)）
    var chunk = "<li>item 你好 <b>bold</b> <a href=\"sub/page.html\">x</a></li>\n"
    var big = str.repeat(chunk, 3300)
    var byte_len = len(big)
    chk_i64("big_size_gt_200k", byte_len > 200000 ? 1 : 0, 1)
    time.tick_start()
    var d = html.parse(big)
    var parse_ms = time.tick_ms()
    chk_i64("big_node_count", html.node_count(d) > 10000 ? 1 : 0, 1)
    chk_i64("big_query_li", len(html.query(d, "li")), 3300)
    chk_i64("big_query_a", len(html.query(d, "a[href]")), 3300)
    chk_i64("big_query_desc", len(html.query(d, "li a")), 3300)
    var ls = html.links(d, "http://e.com/x/index.html")
    chk_i64("big_links_count", len(ls), 3300)
    chk("big_links0", ls[0], "http://e.com/x/sub/page.html")
    var pt = html.plain(d)
    chk_i64("big_plain_size", len(pt) > 50000 ? 1 : 0, 1)
    chk_contains("big_plain_cn", pt, "你好")
    chk_i64("big_parse_sub_3s", parse_ms < 3000 ? 1 : 0, 1)
    println("INFO big_bytes=" + to_string(byte_len) + " parse_ms=" + to_string(parse_ms))
}

func tst_selectx() {
    // 注意：dom 一次一文档——各 doc 的断言按 parse 顺序紧邻执行
    // ---- 组合器（子 / 相邻 / 后续兄弟 / 混合链）----
    var d1 = html.parse(sample1())
    chk_i64("sx_gt_body_div", len(html.query(d1, "body > div")), 1)
    chk_i64("sx_gt_div_p", len(html.query(d1, "div > p")), 2)
    chk_i64("sx_gt_html_body", len(html.query(d1, "html > body")), 1)
    chk_i64("sx_gt_wrong", len(html.query(d1, "body > p")), 0)
    chk_i64("sx_gt_id_p", len(html.query(d1, "#main > p")), 2)
    chk_i64("sx_chain", len(html.query(d1, "html > body > div > p")), 2)
    chk_i64("sx_desc_chain", len(html.query(d1, "body div a")), 1)
    chk_i64("sx_desc_chain0", len(html.query(d1, "body p a")), 0)   // a 的祖先无 p（a 与 p 是兄弟）
    // ---- 属性部分匹配 ^= $= *= ----
    chk_i64("sx_attr_caret", len(html.query(d1, "[data-x^=4]")), 1)
    chk_i64("sx_attr_cls_caret", len(html.query(d1, "[class^=cls]")), 1)
    chk_i64("sx_attr_cls_dollar", len(html.query(d1, "[class$=2]")), 1)
    chk_i64("sx_attr_cls_star", len(html.query(d1, "[class*=s1]")), 1)
    // ---- d1 伪类 ----
    chk_i64("sx_not_id", len(html.query(d1, "div:not(#main)")), 0)
    chk_i64("sx_not_tag", len(html.query(d1, "p:not(.cls1)")), 1)
    // ---- d2：属性部分匹配 + :not([attr]) ----
    var d2 = html.parse(sample2())
    chk_i64("sx_attr_slash", len(html.query(d2, "[href^=\"/\"]")), 3)   // link + /abs/path + //cdn（协议相对亦以 / 开头）
    chk_i64("sx_attr_js", len(html.query(d2, "[href$=\"js\"]")), 1)
    chk_i64("sx_attr_src", len(html.query(d2, "[src*=app]")), 1)
    chk_i64("sx_attr_page", len(html.query(d2, "[href*=page.html]")), 1)
    chk_i64("sx_not_attr", len(html.query(d2, "script:not([src])")), 1)
    // ---- d3：兄弟组合器 ----
    var d3 = html.parse(sample3())
    chk_i64("sx_plus_li", len(html.query(d3, "li + li")), 1)
    chk_i64("sx_plus_p_div", len(html.query(d3, "p + div")), 1)   // p 遇 div 自动闭合后 p 与 div 相邻
    chk_i64("sx_tilde_div_span", len(html.query(d3, "div ~ span")), 0)   // span 在 div 内（p 关闭后进入 div 子树）
    chk_i64("sx_tilde_div_b", len(html.query(d3, "div ~ b")), 0)   // b 也在 div 内
    // ---- d4：伪类（结构 + :not + 未知伪类）----
    var d4 = html.parse("<ul><li>a</li><li>b</li><li>c</li></ul>")
    chk_i64("sx_nth_ul_li", len(html.query(d4, "ul > li")), 3)
    chk_i64("sx_first_child", len(html.query(d4, "li:first-child")), 1)
    chk_i64("sx_last_child", len(html.query(d4, "li:last-child")), 1)
    chk_i64("sx_nth2", len(html.query(d4, "li:nth-child(2)")), 1)
    chk_i64("sx_nth_odd", len(html.query(d4, "li:nth-child(odd)")), 2)
    chk_i64("sx_nth_even", len(html.query(d4, "li:nth-child(even)")), 1)
    chk_i64("sx_not_class", len(html.query(d4, "li:not(.x)")), 3)
    chk_i64("sx_combo_pseudo", len(html.query(d4, "ul > li:first-child")), 1)
    chk_i64("sx_unknown_pseudo", len(html.query(d4, ":hover")), 0)   // 未知伪类 → 空表不崩
    chk_i64("sx_unknown_pseudo2", len(html.query(d4, "a:visited")), 0)
    // ---- d5：+ 与 ~ 干净样本 ----
    var d5 = html.parse("<a></a><b></b><c></c>")
    chk_i64("sx_plus_ab", len(html.query(d5, "a + b")), 1)
    chk_i64("sx_plus_bc", len(html.query(d5, "b + c")), 1)
    chk_i64("sx_plus_wrong2", len(html.query(d5, "a + c")), 0)
    chk_i64("sx_tilde_ac", len(html.query(d5, "a ~ c")), 1)
    chk_i64("sx_tilde_ba", len(html.query(d5, "b ~ a")), 0)
}

func tst_plaintext() {
    // ---- 空白折叠 + 块级换行 + pre 原样 ----
    var d1 = html.parse("<div><p>a   b</p><p>c</p><span> x   y </span><p>z</p></div>")
    var p1 = html.plain(d1)
    chk_contains("pt_collapse_multi", p1, "a b")              // 连续多空格 → 单空格
    chk_contains("pt_collapse_inline", p1, "c x y")            // span 行内折叠（与 c 同段）
    chk_contains("pt_span_tail_nl", p1, "y\nz")               // span 尾空格丢弃 + p 块级换行
    chk_not_contains("pt_no_double_space", p1, "a  b")
    var d2 = html.parse("<pre>  keep  \n  these    spaces  </pre><p>x</p>")
    var p2 = html.plain(d2)
    chk_contains("pt_pre_raw", p2, "  keep  \n  these    spaces  ")   // pre 原样保留
    chk_not_contains("pt_pre_no_fold", p2, "keep these")
    chk_contains("pt_pre_block_nl", p2, "spaces  \nx")        // pre 后 p 块级换行
    // 中英文混排 + 首尾折叠
    var d3 = html.parse("<h1>  Title  你好 </h1><p>ok</p>")
    var p3 = html.plain(d3)
    chk_contains("pt_cn_mix", p3, "Title 你好")
    chk( "pt_lead_collapse", p3, "Title 你好\nok")             // 首部空格折叠 + 块级换行
}

func tst_base() {
    // ---- <base href> 支持 + %xx 规范化 ----
    var d1 = html.parse("<html><head><base href=\"/sub/\"></head><body><a href=\"x.html\">x</a><a href=\"../up.html\">u</a></body></html>")
    var l1 = html.links(d1, "http://e.com/a/b/index.html")
    chk("b1_root", l1[0], "http://e.com/sub/x.html")
    chk("b1_dotdot", l1[1], "http://e.com/up.html")
    var d2 = html.parse("<html><head><base href=\"docs/\"></head><body><a href=\"page.html\">p</a></body></html>")
    var l2 = html.links(d2, "http://e.com/a/b/index.html")
    chk("b2_rel", l2[0], "http://e.com/a/b/docs/page.html")
    var d3 = html.parse("<html><head><base href=\"https://cdn.e.com/root/\"></head><body><img src=\"a.png\"></body></html>")
    var l3 = html.links(d3, "")
    chk("b3_abs_noarg", l3[0], "https://cdn.e.com/root/a.png")
    // 无 <base> 时不改原有行为
    var d4 = html.parse("<a href=\"p.html\">x</a>")
    var l4 = html.links(d4, "http://e.com/x/")
    chk("b4_no_base", l4[0], "http://e.com/x/p.html")
    // %XX 十六进制统一小写 + 多余斜杠归并
    var d5 = html.parse("<a href=\"img/A%2DB.png\">y</a><a href=\"a//b/c.png\">z</a>")
    var l5 = html.links(d5, "http://e.com/x/index.html")
    chk("b5_hex_lower", l5[0], "http://e.com/x/img/A%2dB.png")   // %XX 十六进制字母小写（普通字符 B 不动）
    chk("b5_slash", l5[1], "http://e.com/x/a/b/c.png")
}

func tst_closure() {
    // 同标签自动闭合：表格 td/tr、dl dt/dd、列表 li（li 已在 s3 覆盖）
    var d1 = html.parse("<table><tr><td>a<td>b</tr><tr><td>c</td></tr></table>")
    chk_i64("cl_tr", len(html.query(d1, "tr")), 2)
    chk_i64("cl_td", len(html.query(d1, "td")), 3)
    chk_i64("cl_tr_td", len(html.query(d1, "tr > td")), 3)
    var d2 = html.parse("<dl><dt>a<dt>b<dd>c<dd>d</dl>")
    chk_i64("cl_dt", len(html.query(d2, "dt")), 2)
    chk_i64("cl_dd", len(html.query(d2, "dd")), 2)
    // p 遇块级自动闭合：<p>a<div>b</div>c → p 与 div 相邻
    var d3 = html.parse("<p>a<div>b</div>c")
    chk_i64("cl_p_div", len(html.query(d3, "p + div")), 1)
    chk_i64("cl_p_blocks_h1", len(html.query(html.parse("<p>x<h1>t</h1>"), "p + h1")), 1)
    // body 收掉未闭合 head；重复 html/head/body 忽略
    var d4 = html.parse("<html><head><title>t</title><body><p>x</p></body></html>")
    chk_i64("cl_head1", len(html.query(d4, "head")), 1)
    chk_i64("cl_body1", len(html.query(d4, "body")), 1)
    var d5 = html.parse("<html><body><p>a</p><head><title>b</title></head><body>c</body><html>tail")
    chk_i64("cl_dup_body", len(html.query(d5, "body")), 1)   // 重复 body 忽略
    chk_i64("cl_dup_head", len(html.query(d5, "head")), 0)   // body 后 head 忽略
    chk_i64("cl_dup_html", len(html.query(d5, "html")), 1)   // 尾部重复 html 忽略（首 html 保留）
    chk_contains("cl_dup_text", html.plain(d5), "c")
    // 未闭合标签尾部收口（既有语义保持）
    var d6 = html.parse("<ul><li>1<li>2<li>3</ul>")
    chk_i64("cl_li3", len(html.query(d6, "li")), 3)
    chk_i64("cl_li3_desc", len(html.query(d6, "ul > li")), 3)
}

func main() {
    tst_sample1()
    tst_sample2()
    tst_sample3()
    tst_selectx()
    tst_plaintext()
    tst_base()
    tst_closure()
    tst_big()
    println("html 探针全部通过 / html probe all PASS")
    exit(0)
}