type tie<logic>
// tsha1 家族 p.7.1.8 —— 四档 f/b/x/r × 位长 {16,24,32} KAT 固化 + 同构性验证。
// ---------------------------------------------------------------------------
// (a) KAT 固化：f/b/x/r × n∈{16,24,32} × 消息集{空串/abc/a1000(长)/a64(边界长度)}
//      的 base48 与 base16 摘要，与 canonical core（tests/tsha_probe/gen_tsha1_core.py）
//      逐字一致；向量由 gen_tsha1_p718.py 导出。既有 f/b/x/r probe 仅抽检
//      {2,8,16,48,64,69,88,92,96,128,144}，缺 24/32 —— 本探针补齐里程碑所需的
//      「f/b/x 至少 16/24/32，r 对齐 16/24/32」已知答案回归向量。
// (b) 同构性测试(f vs b 差异仅限参数层)：对同一 (msg,n)，f/b/x/r 输出两两不同，
//      且不同消息同参数输出不同 —— 印证四档为同一 base 结构、仅参数层(IV/RCON/
//      S-盒/SPN 强化度)不同而区分（不逐字比对 BLAKE2，因 tsha1 经 trit 位平面扰
//      动重排，输出基/长不同，属异构换形而非同构等价）。
import "../../std/tsha1.tie"
using tsha;

var PASS_COUNT: table<i64>

func radix10(v: i64) -> string {
    if v == 0 {
        return "0"
    }
    var digits = "0123456789"
    var out: string = ""
    var x = v
    while x > 0 {
        out = str_char(digits, x % 10) + out
        x = x / 10
    }
    return out
}

func check(name: string, got: string, want: string) {
    if got == want {
        PASS_COUNT[0] = PASS_COUNT[0] + 1
        println("PASS " + name)
    } else {
        println("FAIL " + name)
        println("  got : " + got)
        println("  want: " + want)
        exit(1)
    }
}

// 模型分派到公开四函数。
func model_hash(m: string, msg: string, n: i64, base: i64) -> string {
    if m == "f" {
        return tsha.tsha1f(msg, n, base)
    }
    if m == "r" {
        return tsha.tsha1r(msg, n, base)
    }
    if m == "b" {
        return tsha.tsha1b(msg, n, base)
    }
    return tsha.tsha1x(msg, n, base)
}

func rep(c: string, n: i64) -> string {
    var out: string = ""
    var i: i64 = 0
    while i < n {
        out = out + c
        i = i + 1
    }
    return out
}

// 单模型全部位长的 KAT：b48 + b16，消息按 (名,内容,48×3向量,16×3向量) 排列。
// 一个 msg 的 48 向量组按 n∈{16,24,32} 顺排。来源 gen_tsha1_p718.py。
func assert_model(m: string,
                  e48: table<string>, e16: table<string>,
                  a48: table<string>, a16: table<string>,
                  k48: table<string>, k16: table<string>,
                  b48: table<string>, b16: table<string>) {
    var empty = ""
    var abc = "abc"
    var a1000 = rep("a", 1000)
    var a64 = rep("a", 64)
    var ns: table<i64> = [16, 24, 32]
    var i: i64 = 0
    for i in 0..3 {
        var n = ns[i]
        check("KAT " + m + " n16/24/32 empty b48", model_hash(m, empty, n, 48), e48[i])
        check("KAT " + m + " n16/24/32 empty b16", model_hash(m, empty, n, 16), e16[i])
        check("KAT " + m + " n16/24/32 abc b48", model_hash(m, abc, n, 48), a48[i])
        check("KAT " + m + " n16/24/32 abc b16", model_hash(m, abc, n, 16), a16[i])
        check("KAT " + m + " n16/24/32 a1000 b48", model_hash(m, a1000, n, 48), k48[i])
        check("KAT " + m + " n16/24/32 a1000 b16", model_hash(m, a1000, n, 16), k16[i])
        check("KAT " + m + " n16/24/32 a64 b48", model_hash(m, a64, n, 48), b48[i])
        check("KAT " + m + " n16/24/32 a64 b16", model_hash(m, a64, n, 16), b16[i])
    }
}

// (b) 同构性：同 (msg,n) 下四档两两不同；同模型不同消息不同。
func isofiber() {
    var msgs: table<string> = ["", "abc", rep("a", 1000), rep("a", 64)]
    var ns: table<i64> = [16, 24, 32]
    var ms: string = ""
    var n: i64 = 0
    var mm: string = ""
    for ms in msgs {
        for n in ns {
            var hf = model_hash("f", ms, n, 16)
            var hb = model_hash("b", ms, n, 16)
            var hx = model_hash("x", ms, n, 16)
            var hr = model_hash("r", ms, n, 16)
            if hf != hb && hf != hx && hf != hr && hb != hx && hb != hr && hx != hr {
                PASS_COUNT[0] = PASS_COUNT[0] + 1
                println("PASS isofiber 4 models pairwise-distinct")
            } else {
                println("FAIL isofiber 4 models not pairwise distinct")
                exit(1)
            }
        }
    }
    var h16 = model_hash("f", "", 16, 16)
    var h24 = model_hash("f", "", 24, 16)
    var h32 = model_hash("f", "", 32, 16)
    if h16 != h24 && h24 != h32 && h16 != h32 {
        PASS_COUNT[0] = PASS_COUNT[0] + 1
        println("PASS isofiber f n16!=24!=32 (diff param layer)")
    } else {
        println("FAIL isofiber f n16/24/32 not distinct")
        exit(1)
    }
}

func main() {
    table_push(PASS_COUNT, 0)
    // f
    assert_model("f",
        ["2Bj5usI4DKgC7iHw", "37gu569Fj563cHbne3KyCJly", "299A3CAwet7G2oBcBKiIbwygFe4Dame7"],
        ["07217255c5e185067376e9", "419a769c19e5d35e2fa203547556b68a", "81dbc7478f23932694aa9ad1db25ef64a831d3149c9a"],
        ["tEw0d2qFn4eGjfjp", "6j9wiHi4oy6zn1ufxb9otvih", "12bzapyEpL9xtoz120C9HoctKg4ahzzJ"],
        ["4c94e04179f0df7421fcff", "85294012b870bf56718f5be1f22fcd7e", "3e050beb15f03c7bdf3da7ed52bac5239ec29d0d67f0"],
        ["7K6kDlq3k5sivDts", "7oIvFJ3DcwDydnt3A7BJKGlx", "14wiHfdzd3EKmviaitdtAyEwmyJk7sHG"],
        ["146d3148232e08204771da", "9c73646b47581b3196ee52587b652d08", "41050c868daa48fc590f7aa5e026b177ee7874706623"],
