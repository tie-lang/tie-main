type tie<logic>
// _r162_probe 交叉冒烟：最小 file 内置用例。
// ============================================================
// 用途：Windows 上执行 `tiec probe_cross_r162.tie --target linux-x64 -o out`
// 应走到 clang --target=linux 链接阶段（预期缺 crtn.o/CRT 报错——Windows 宿主
// 无 Linux libc/CRT 的已知环境限制），证明 Linux POSIX 代码生成路径被选中且
// IR 生成无错（declare open/read/write/close/access/stat 等推导成功）。
// 同一源码 Windows 目标编译运行正常（验证分支隔离）。
// Linux CI（.github/workflows/linux-r16.yml）上直接编译运行验证行为。
func main() {
    var f = "r162_cross.txt"
    if !file_write(f, "cross") {
        println("FAIL write")
        exit(1)
    }
    if !file_exists(f) {
        println("FAIL exists")
        exit(1)
    }
    var content = file_read(f)
    if content != "cross" {
        println("FAIL read got=" + content)
        exit(1)
    }
    if file_size(f) != 5 {
        println("FAIL size")
        exit(1)
    }
    if !file_delete(f) {
        println("FAIL delete")
        exit(1)
    }
    println("PASS cross fs")
}
