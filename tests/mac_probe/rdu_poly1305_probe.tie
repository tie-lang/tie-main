type tie<logic>
// rdu_poly1305 交叉一致性探针：rdu_poly 版与 std poly 版输出一致，并复核 RFC 向量。
// key 以 64 位 hex 传；msg 为原始字符串。
// 期望输出：全部 PASS + "rdu_poly1305 交叉一致性探针全部通过"。
import "../../std/poly1305.tie"
import "../../rdu/rdu_poly1305.tie"

func check(name: string, got: string, want: string) {
    if got == want {
        println("PASS " + name)
    } else {
        println("FAIL " + name + " got=" + got + " want=" + want)
        exit(1)
    }
}

func reps(c: string, n: i64) -> string {
    var out: string = ""
    var i: i64 = 0
    while i < n {
        out = out + c
        i = i + 1
    }
    return out
}

func main() {
    // 每组：检查 rdu 与 std 一致，且 std 复核权威向量（RFC 8439 §2.5.2）
    check("v1_rdu_std", rdu_poly.poly1305(
        "85d6be7857556d337f4452fe42d506a80103808afb0db2fd4abff6af4149f51b",
        "Cryptographic Forum Research Group"),
        poly.poly1305("85d6be7857556d337f4452fe42d506a80103808afb0db2fd4abff6af4149f51b",
            "Cryptographic Forum Research Group"))
    check("v1_rfc", poly.poly1305(
        "85d6be7857556d337f4452fe42d506a80103808afb0db2fd4abff6af4149f51b",
        "Cryptographic Forum Research Group"), "a8061dc1305136c6c22b8baf0c0127a9")

    var k0 = reps("00", 32)
    check("v2_rdu_std", rdu_poly.poly1305(k0, "Cryptographic Forum Research Group"),
        poly.poly1305(k0, "Cryptographic Forum Research Group"))

    var k3 = "0f0e0d0c0b0a09080706050403020100d8d9dadbdcdddedfe0e1e2e3e4e5e6e7"
    check("v3_rdu_std", rdu_poly.poly1305(k3, ""), poly.poly1305(k3, ""))
    check("v3_empty", rdu_poly.poly1305(k3, ""), "d8d9dadbdcdddedfe0e1e2e3e4e5e6e7")

    var k4 = "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"
    check("v4_rdu_std", rdu_poly.poly1305(k4, reps("a", 48)), poly.poly1305(k4, reps("a", 48)))
    check("v4_multiblock", rdu_poly.poly1305(k4, reps("a", 48)), "386631259d5059b43d26e49d0febb10a")

    println("rdu_poly1305 交叉一致性探针全部通过")
}