type tie<logic>
// tests/diff_probe/diff_probe.tie —— p.6.6.17 验收：std/diff 文本行级 diff。
// 全离线确定性探针：9 组用例覆盖相等/纯增/纯删/尾部插入/修改/空白保形/
// unified 精确串/2K 行性能/前后缀剥离。期望全部 PASS / exit 0。
import "../../std/diff.tie" as diff
import "../../std/time.tie" as time

var fails: i64 = 0

func check(cond: bool, msg: string) {
    if cond {
        println("PASS " + msg)
    } else {
        println("FAIL " + msg)
        fails = fails + 1
    }
}

func mk_lines(count: i64, prefix: string) -> table<string> {
    var t = table_new_string()
    var i: i64 = 0
    while i < count {
        table_push(t, prefix + to_string(i))
        i = i + 1
    }
    return t
}

// ==================== 1 相等 ====================
func case_equal() {
    var a = table_new_string()
    table_push(a, "alpha")
    table_push(a, "beta")
    table_push(a, "gamma")
    var r = diff.line_diff(a, a)
    check(len(r.ops) == 3 && len(r.a_ln) == 3 && len(r.b_ln) == 3, "1a equal: three parallel ops")
    var all_keep: i64 = 1
    var i: i64 = 0
    while i < 3 {
        if r.ops[i] != 0 {
            all_keep = 0
        }
        if r.a_ln[i] != r.b_ln[i] || r.a_ln[i] != i + 1 {
            all_keep = 0
        }
        i = i + 1
    }
    check(all_keep == 1, "1b equal: all keep, a_ln==b_ln")
    check(diff.unified(a, a) == "--- a\n+++ b\n alpha\n beta\n gamma", "1c equal: unified all space lines")
}

// ==================== 2 纯增 ====================
func case_add() {
    var a = table_new_string()
    var b = table_new_string()
    table_push(b, "l1")
    table_push(b, "l2")
    table_push(b, "l3")
    var r = diff.line_diff(a, b)
    check(len(r.ops) == 3, "2a pure add: 3 ops")
    var all_add: i64 = 1
    var i: i64 = 0
    while i < 3 {
        if r.ops[i] != 2 || r.a_ln[i] != 0 || r.b_ln[i] != i + 1 {
            all_add = 0
        }
        i = i + 1
    }
    check(all_add == 1, "2b pure add: kind 2, b_ln 1..3, a_ln 0")
    check(diff.unified(a, b) == "--- a\n+++ b\n+l1\n+l2\n+l3", "2c pure add unified")
}

// ==================== 3 纯删 ====================
func case_del() {
    var a = table_new_string()
    table_push(a, "l1")
    table_push(a, "l2")
    table_push(a, "l3")
    var b = table_new_string()
    var r = diff.line_diff(a, b)
    check(len(r.ops) == 3, "3a pure del: 3 ops")
    var all_del: i64 = 1
    var i: i64 = 0
    while i < 3 {
        if r.ops[i] != 1 || r.b_ln[i] != 0 || r.a_ln[i] != i + 1 {
            all_del = 0
        }
        i = i + 1
    }
    check(all_del == 1, "3b pure del: kind 1, a_ln 1..3, b_ln 0")
    check(diff.unified(a, b) == "--- a\n+++ b\n-l1\n-l2\n-l3", "3c pure del unified")
}

// ==================== 4 尾部插入 ====================
func case_tail_insert() {
    var a = table_new_string()
    table_push(a, "x")
    table_push(a, "y")
    var b = table_new_string()
    table_push(b, "x")
    table_push(b, "y")
    table_push(b, "z")
    var r = diff.line_diff(a, b)
    check(len(r.ops) == 3, "4a tail insert: 2 keep + 1 add")
    check(r.ops[0] == 0 && r.a_ln[0] == 1 && r.b_ln[0] == 1, "4b keep x")
    check(r.ops[1] == 0 && r.a_ln[1] == 2 && r.b_ln[1] == 2, "4c keep y")
    check(r.ops[2] == 2 && r.a_ln[2] == 0 && r.b_ln[2] == 3, "4d add z b_ln 3")
    check(diff.unified(a, b) == "--- a\n+++ b\n x\n y\n+z", "4e tail insert unified")
}

// ==================== 5 修改（del + add 相邻） ====================
func case_modify() {
    var a = table_new_string()
    table_push(a, "x")
    table_push(a, "y")
    table_push(a, "z")
    var b = table_new_string()
    table_push(b, "x")
    table_push(b, "J")
    table_push(b, "z")
    var r = diff.line_diff(a, b)
    check(len(r.ops) == 4, "5a modify: 4 ops")
    check(r.ops[0] == 0 && r.a_ln[0] == 1 && r.b_ln[0] == 1, "5b keep x")
    // y del 与 J add 相邻
    check(r.ops[1] == 1 && r.a_ln[1] == 2 && r.b_ln[1] == 0, "5c del y a_ln 2")
    check(r.ops[2] == 2 && r.a_ln[2] == 0 && r.b_ln[2] == 2, "5d add J b_ln 2")
    check(r.ops[3] == 0 && r.a_ln[3] == 3 && r.b_ln[3] == 3, "5e keep z")
    check(diff.unified(a, b) == "--- a\n+++ b\n x\n-y\n+J\n z", "5f modify unified")
}

// ==================== 6 空白/空行保形 ====================
func case_blank() {
    var a = table_new_string()
    table_push(a, "a")
    table_push(a, "")
    table_push(a, "b")
    var b = table_new_string()
    table_push(b, "a")
    table_push(b, "")
    table_push(b, "b")
    table_push(b, "c")
    var r = diff.line_diff(a, b)
    // 3 keep + 1 add；空行是 keep，须保留
    check(len(r.ops) == 4, "6a blank: 4 ops")
    check(r.ops[0] == 0 && r.ops[1] == 0 && r.ops[2] == 0, "6b blank line kept")
    check(r.ops[3] == 2 && r.b_ln[3] == 4, "6c tail add c")
    // 空行 keep 行在 unified 中保形成单独空格行（" " + "" = 单空格）
    check(diff.unified(a, b) == "--- a\n+++ b\n a\n \n b\n+c", "6d blank line as lone space")
}

// ==================== 7 unified 精确串 ====================
func case_exact() {
    var a = table_new_string()
    table_push(a, "aaa")
    table_push(a, "bbb")
    table_push(a, "ccc")
    var b = table_new_string()
    table_push(b, "aaa")
    table_push(b, "XXX")
    table_push(b, "ccc")
    // 手工期望：头 + 空格上下文 + -/+/ 相邻 + 空格上下文，末行无末尾换行
    var want = "--- a\n+++ b\n aaa\n-bbb\n+XXX\n ccc"
    check(diff.unified(a, b) == want, "7 exact unified string")
}

// ==================== 8 2K 行性能 ====================
func case_perf() {
    var a = mk_lines(2000, "line ")
    var b = table_new_string()
    var i: i64 = 0
    while i < len(a) {
        table_push(b, a[i])
        i = i + 1
    }
    // 仅改中段 3 行；头尾与 a 相同
    b[1000] = "CHANGED 1000"
    b[1001] = "CHANGED 1001"
    b[1002] = "CHANGED 1002"
    time.tick_start()
    var r = diff.line_diff(a, b)
    var ms = time.tick_ms()
    println("perf 2K tick_ms=" + to_string(ms))
    // 1000 前缀 keep + 997 后缀 keep + 3 del + 3 add = 2003
    check(len(r.ops) == 2003, "8a perf: total ops 2003")
    var keep_n: i64 = 0
    var del_n: i64 = 0
    var add_n: i64 = 0
    i = 0
    while i < len(r.ops) {
        if r.ops[i] == 0 {
            keep_n = keep_n + 1
        } else if r.ops[i] == 1 {
            del_n = del_n + 1
        } else {
            add_n = add_n + 1
        }
        i = i + 1
    }
    check(keep_n == 1997 && del_n == 3 && add_n == 3, "8b perf: 1997 keep + 3 del + 3 add")
    // del 的 a_ln 应为 1001/1002/1003（1-based）
    var del_ok: i64 = 1
    i = 0
    while i < len(r.ops) {
        if r.ops[i] == 1 {
            if r.a_ln[i] < 1001 || r.a_ln[i] > 1003 {
                del_ok = 0
            }
        }
        i = i + 1
    }
    check(del_ok == 1, "8c perf: del line numbers in 1001..1003")
}

// ==================== 9 前后缀剥离正确性 ====================
func case_prefix_suffix() {
    var a = table_new_string()
    var b = table_new_string()
    var i: i64 = 0
    // 公共前缀 500
    while i < 500 {
        table_push(a, "P" + to_string(i))
        table_push(b, "P" + to_string(i))
        i = i + 1
    }
    // 中段差异：a 3 行，b 2 行（无公共）
    table_push(a, "D0")
    table_push(a, "D1")
    table_push(a, "D2")
    table_push(b, "E0")
    table_push(b, "E1")
    // 公共后缀 497
    i = 0
    while i < 497 {
        table_push(a, "S" + to_string(i))
        table_push(b, "S" + to_string(i))
        i = i + 1
    }
    var r = diff.line_diff(a, b)
    // 头部 500 个 keep：a_ln/b_ln == i+1
    var head_ok: i64 = 1
    i = 0
    while i < 500 {
        if r.ops[i] != 0 || r.a_ln[i] != i + 1 || r.b_ln[i] != i + 1 {
            head_ok = 0
        }
        i = i + 1
    }
    check(head_ok == 1, "9a prefix 500 keep line numbers")
    // 中部：3 del + 2 add，行号范围正确
    var del_ok: i64 = 1
    var add_ok: i64 = 1
    var dcount: i64 = 0
    var acount: i64 = 0
    i = 0
    while i < len(r.ops) {
        if r.ops[i] == 1 {
            dcount = dcount + 1
            if r.a_ln[i] < 501 || r.a_ln[i] > 503 || r.b_ln[i] != 0 {
                del_ok = 0
            }
        } else if r.ops[i] == 2 {
            acount = acount + 1
            if r.b_ln[i] < 501 || r.b_ln[i] > 502 || r.a_ln[i] != 0 {
                add_ok = 0
            }
        }
        i = i + 1
    }
    check(dcount == 3 && acount == 2 && del_ok == 1 && add_ok == 1, "9b middle 3 del + 2 add correct lines")
    // 尾部 497 个 keep：a_ln 504..1000，b_ln 503..999
    var tail_ok: i64 = 1
    var tlen: i64 = len(r.ops)
    i = 0
    while i < 497 {
        var idx: i64 = tlen - 497 + i
        if r.ops[idx] != 0 || r.a_ln[idx] != 504 + i || r.b_ln[idx] != 503 + i {
            tail_ok = 0
        }
        i = i + 1
    }
    check(tail_ok == 1, "9c suffix 497 keep line numbers")
}

// ==================== 入口 ====================
func main() {
    println("start")
    case_equal()
    case_add()
    case_del()
    case_tail_insert()
    case_modify()
    case_blank()
    case_exact()
    case_perf()
    case_prefix_suffix()
    if fails == 0 {
        println("PASS")
    } else {
        println("FAIL count=" + to_string(fails))
    }
    println("done")
}