type tie<logic>

// ============================================================
// 数据流箭头验收（P1）：-> / <- 传参与赋值
//
// 覆盖场景：
//   1. 传参（数据作末参）：a -> f(x) = f(x, a)
//   2. 链式传参：a -> f() -> g() = g(f(a))
//   3. 字符串/方法调用传参
//   4. 函数值传参：a -> f = f(a)
//   5. 双向赋值：x <- a 与 a -> x
//   6. 字段/下标赋值
//
// 期望输出（全部 PASS）：
//   PASS pipe_last / PASS pipe_chain / PASS pipe_str / PASS pipe_fn /
//   PASS assign_both / PASS assign_field / PASS assign_index
// ============================================================

func add2(a: i64, b: i64) -> i64 {
    return a + b
}
func inc(x: i64) -> i64 {
    return x + 1
}
func shout(s: string) -> string {
    return s + "!"
}

struct Box {
    var val: i64 = 0
}

func main() {
    // 1. 传参（末参）
    var r = 10 -> add2(5)
    if r == 15 {
        println("PASS pipe_last")
    } else {
        println("FAIL pipe_last r=" + to_string(r))
        exit(1)
    }
    // 2. 链式传参
    var c = 5 -> inc() -> inc()
    if c == 7 {
        println("PASS pipe_chain")
    } else {
        println("FAIL pipe_chain c=" + to_string(c))
        exit(1)
    }
    // 3. 字符串传参
    var s = "hi" -> shout()
    if s == "hi!" {
        println("PASS pipe_str")
    } else {
        println("FAIL pipe_str s=" + s)
        exit(1)
    }
    // 4. 函数值传参
    var f: fn(i64) -> i64 = inc
    var z = 9 -> f
    if z == 10 {
        println("PASS pipe_fn")
    } else {
        println("FAIL pipe_fn z=" + to_string(z))
        exit(1)
    }
    // 5. 双向赋值
    var x: i64 = 0
    x <- 42
    var y: i64 = 0
    100 -> y
    if x == 42 && y == 100 {
        println("PASS assign_both")
    } else {
        println("FAIL assign_both x=" + to_string(x) + " y=" + to_string(y))
        exit(1)
    }
    // 6. 字段赋值
    var b: Box = Box(0)
    b.val <- 7
    if b.val == 7 {
        println("PASS assign_field")
    } else {
        println("FAIL assign_field val=" + to_string(b.val))
        exit(1)
    }
    // 7. 下标赋值
    var arr: table<i64> = [1, 2, 3]
    arr[0] <- 9
    if arr[0] == 9 {
        println("PASS assign_index")
    } else {
        println("FAIL assign_index v=" + to_string(arr[0]))
        exit(1)
    }
}
