type tie<logic>
// r.1.1.8 正例：字符串字面量 \0 转义保留 NUL 字节（二进制安全往返验证）。
// 管线：lexer 存原文 → irgen.str_unescape_quoted 字节级反转义 → intern 池
// 字节级比较 → llvmgen c"A\00B" 转义 + 长度头。修复前 "A\0B" 变 "AB"。
// 覆盖：
//   1) 内嵌 NUL（"A\0B"）：len=3、字节 1 == 0
//   2) 连续 NUL（"\0\0"）：len=2
//   3) 尾随 NUL（"ab\0"）：len=3
//   4) 与运行时 sb_append_byte(0) 构建的串逐字节一致（往返等价）
//   5) 字符字面量 '\0' 可编译且不崩溃（tig_char_lit 同源修复；码点断言
//      走 char_code("\0") 字符串路径——char_code(<char> 值) 是既有独立缺陷）
//   6) 既有转义 \n \t \\ \" 不回归
// 期望：PASS nul_literal / exit 0。
func main() {
    var ok: i64 = 1
    var s = "A\0B"
    if str_len(s) != 3 {
        ok = 0
        println("FAIL len1=" + to_string(str_len(s)))
    }
    if str_byte(s, 1) != 0 {
        ok = 0
        println("FAIL byte1=" + to_string(str_byte(s, 1)))
    }
    var s2 = "\0\0"
    if str_len(s2) != 2 || str_byte(s2, 0) != 0 || str_byte(s2, 1) != 0 {
        ok = 0
        println("FAIL zeros")
    }
    var s3 = "ab\0"
    if str_len(s3) != 3 || str_byte(s3, 2) != 0 {
        ok = 0
        println("FAIL trailing")
    }
    // 往返等价：运行时用 sb_append_byte(0) 构建同串，逐字节比对
    var rt = string_builder()
    sb_append_byte(rt, char_code("A"))
    sb_append_byte(rt, 0)
    sb_append_byte(rt, char_code("B"))
    var rts = sb_build(rt)
    var eq: i64 = 1
    if str_len(rts) != str_len(s) {
        eq = 0
    }
    var i: i64 = 0
    while i < str_len(s) && eq == 1 {
        if str_byte(rts, i) != str_byte(s, i) {
            eq = 0
        }
        i = i + 1
    }
    if eq != 1 {
        ok = 0
        println("FAIL roundtrip")
    }
    // 字符字面量 '\0' 编译不崩溃；码点走字符串路径断言
    var c: char = '\0'
    if char_code("\0") != 0 {
        ok = 0
        println("FAIL char0=" + to_string(char_code("\0")))
    }
    // 既有转义不回归
    var e = "a\nb\tc\\d\"e"
    if str_len(e) != 9 {
        ok = 0
        println("FAIL esc len=" + to_string(str_len(e)))
    }
    if ok == 1 {
        println("PASS nul_literal")
    } else {
        println("FAIL nul_literal")
        exit(1)
    }
}
