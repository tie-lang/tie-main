    chk("rand1_tamper_sig", to_string(ed25519.verify(pub_rand1, msg_rand1, "f9009a21d7d70d13e9842119b18532d4f5b7b24df1d6df4e1e6b5beb8cfd50fc32e075728e1af63866fc04e4e43341ceefdfa2c4cd95d6e3d76182fe15c52d06")), "0")
