    chk("rfc1abc_tamper_pub", to_string(ed25519.verify("e75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a", msg_rfc1abc, sig_rfc1abc)), "0")
    chk("rfc1abc_tamper_sig", to_string(ed25519.verify(pub_rfc1abc, msg_rfc1abc, "90d724b01e7ca260f4cc7f8de7c95f73cfac615bab1f762b6435b6ec26c8cf6d2c758dae2f87399a8eeda1cbcd2835ac5ba66d6ecaa3aba5e567a751053dc207")), "0")
    var seed_long = "c5aa8df43f9f837bedb7442f31dcb7b166d38535076f094b85ce3a2e0b4458f7"
