type tie<logic>
// ed25519_probe.tie：纯 tie Ed25519 探针（RFC 8032 + PyNaCl 交叉向量）。
// 覆盖：RFC 8032 §7.1 向量 1~3（空串/1 字节/2 字节消息）+ abc/长消息向量 + 随机
//   （seed,msg）宜；keygen→sign→verify 往返、签名/公钥篡改拒绝、verify 对篡改
//   签名的 0 判定。向量由 gen_vectors.py（PyNaCl, libsodium, RFC 8032 独立实现）生成。
import "../../std/ed25519.tie"
using ed25519;

func chk(name: string, got: string, want: string) {
    if got == want {
        println("PASS " + name)
    } else {
        println("FAIL " + name + " got=" + got)
        println("      want=" + want)
        exit(1)
    }
}

func main() {
    var seed_rfc1 = "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"
    var pub_rfc1  = "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"
    var msg_rfc1  = ""
    var sig_rfc1  = "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b"
    chk("rfc1_keygen", ed25519.keygen(seed_rfc1), pub_rfc1)
    chk("rfc1_sign", ed25519.sign(msg_rfc1, pub_rfc1, seed_rfc1), sig_rfc1)
    chk("rfc1_verify", to_string(ed25519.verify(pub_rfc1, msg_rfc1, sig_rfc1)), "1")
    chk("rfc1_verify_roundtrip", to_string(ed25519.verify(pub_rfc1, msg_rfc1, ed25519.sign(msg_rfc1, pub_rfc1, seed_rfc1))), "1")
    chk("rfc1_tamper_pub", to_string(ed25519.verify("e75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a", msg_rfc1, sig_rfc1)), "0")
    chk("rfc1_tamper_sig", to_string(ed25519.verify(pub_rfc1, msg_rfc1, "f5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b")), "0")
    var seed_rfc2 = "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb"
    var pub_rfc2  = "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c"
