    chk("rand2_tamper_sig", to_string(ed25519.verify(pub_rand2, msg_rand2, "860e2fb8cc63591e76bce30de8cf6ab9c1fe165e3a3853cdcb0475b3e3ac06d6ea4303584b59f1f445c8cf022748849022574cc48efec7b4b7c70dd1f34a9e08")), "0")
