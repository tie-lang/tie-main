    var msg_long  = "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f"
    var sig_long  = "5c6aa93acb60ec275b14f3bb03ac8a36327eb380cf75b7d5085f23de0aeee583e2a33c938adff02b8e773f1ac70d2ff639aa951c34e2809dd8b6e4728d15b10d"
    chk("long_keygen", ed25519.keygen(seed_long), pub_long)
    chk("long_sign", ed25519.sign(msg_long, pub_long, seed_long), sig_long)
    chk("long_verify", to_string(ed25519.verify(pub_long, msg_long, sig_long)), "1")
    chk("long_verify_roundtrip", to_string(ed25519.verify(pub_long, msg_long, ed25519.sign(msg_long, pub_long, seed_long))), "1")
    chk("long_tamper_pub", to_string(ed25519.verify("0c51cd8e6218a1a38da47ed00230f0580816ed13ba3303ac5deb911548908025", msg_long, sig_long)), "0")
    chk("long_tamper_sig", to_string(ed25519.verify(pub_long, msg_long, "6c6aa93acb60ec275b14f3bb03ac8a36327eb380cf75b7d5085f23de0aeee583e2a33c938adff02b8e773f1ac70d2ff639aa951c34e2809dd8b6e4728d15b10d")), "0")
    var seed_rand0 = "8d5c2179f092d40a34e416cc1c2fbd0f2a7a203b478e16e4d5cdea14c05f1d2d"
    var pub_rand0  = "ae0d731afe2842e206c0b229bed02c6270b82e3daeed914b6400754bb58ee32c"
    var msg_rand0  = ""
    var sig_rand0  = "a682271e854f1e1e61ce1d6e96982ba9888aae1b1dfae7a5a05c43442d8c4870ab2eb2ee6f72545323fc40cd92f6c82e62b7260d04fbfee0208fe2ee6184c603"
    chk("rand0_keygen", ed25519.keygen(seed_rand0), pub_rand0)
    chk("rand0_sign", ed25519.sign(msg_rand0, pub_rand0, seed_rand0), sig_rand0)
    chk("rand0_verify", to_string(ed25519.verify(pub_rand0, msg_rand0, sig_rand0)), "1")
    chk("rand0_verify_roundtrip", to_string(ed25519.verify(pub_rand0, msg_rand0, ed25519.sign(msg_rand0, pub_rand0, seed_rand0))), "1")
    chk("rand0_tamper_pub", to_string(ed25519.verify("be0d731afe2842e206c0b229bed02c6270b82e3daeed914b6400754bb58ee32c", msg_rand0, sig_rand0)), "0")
    chk("rand0_tamper_sig", to_string(ed25519.verify(pub_rand0, msg_rand0, "b682271e854f1e1e61ce1d6e96982ba9888aae1b1dfae7a5a05c43442d8c4870ab2eb2ee6f72545323fc40cd92f6c82e62b7260d04fbfee0208fe2ee6184c603")), "0")
