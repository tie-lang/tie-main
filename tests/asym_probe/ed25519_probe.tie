    var sig_rfc2  = "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00"
    chk("rfc2_keygen", ed25519.keygen(seed_rfc2), pub_rfc2)
    chk("rfc2_sign", ed25519.sign(msg_rfc2, pub_rfc2, seed_rfc2), sig_rfc2)
    chk("rfc2_verify", to_string(ed25519.verify(pub_rfc2, msg_rfc2, sig_rfc2)), "1")
    chk("rfc2_verify_roundtrip", to_string(ed25519.verify(pub_rfc2, msg_rfc2, ed25519.sign(msg_rfc2, pub_rfc2, seed_rfc2))), "1")
    chk("rfc2_tamper_pub", to_string(ed25519.verify("4d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c", msg_rfc2, sig_rfc2)), "0")
    chk("rfc2_tamper_sig", to_string(ed25519.verify(pub_rfc2, msg_rfc2, "a2a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00")), "0")
    var seed_rfc3 = "c5aa8df43f9f837bedb7442f31dcb7b166d38535076f094b85ce3a2e0b4458f7"
