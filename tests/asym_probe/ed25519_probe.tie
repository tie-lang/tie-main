    chk("rfc3_tamper_pub", to_string(ed25519.verify("0c51cd8e6218a1a38da47ed00230f0580816ed13ba3303ac5deb911548908025", msg_rfc3, sig_rfc3)), "0")
    chk("rfc3_tamper_sig", to_string(ed25519.verify(pub_rfc3, msg_rfc3, "7291d657deec24024827e69c3abe01a30ce548a284743a445e3680d7db5ac3ac18ff9b538d16f290ae67f760984dc6594a7c15e9716ed28dc027beceea1ec40a")), "0")
    var seed_rfc1abc = "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"
    var pub_rfc1abc  = "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"
