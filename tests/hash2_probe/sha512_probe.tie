type tie<logic>
// sha512（FIPS 180-4）探针：向量断言（空串/abc/块边界/长消息）+ sha512_bytes 原始字节路径。
// 向量来源：FIPS 180-4 标准向量与 Python hashlib.sha512（NIST 参考实现）交叉核对。
// 覆盖 128 字节块 rate 与 pad10*1 的 0x80 / 128 位长度区边界（100/111/112/113/127/128）。
import "../../std/sha512.tie"
using sha512;

func check(name: string, got: string, want: string) {
    if got == want {
        println("PASS " + name)
    } else {
        println("FAIL " + name + " got=" + got)
        println("     want=" + want)
        exit(1)
    }
}

func rep(c: string, n: i64) -> string {
    var out: string = ""
    var i: i64 = 0
    while i < n {
        out = out + c
        i = i + 1
    }
    return out
}

func main() {
    // 强调任务指定向量
    check("sha512 empty", sha512.sha512(""),
        "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e")
    check("sha512 abc", sha512.sha512("abc"),
        "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")
    check("sha512 a100", sha512.sha512(rep("a", 100)),
        "70ff99fd241905992cc3fff2f6e3f562c8719d689bfe0e53cbc75e53286d82d8767aed0959b8c63aadf55b5730babee75ea082e88414700d7507b988c44c47bc")
    check("sha512 a111", sha512.sha512(rep("a", 111)),
        "fa9121c7b32b9e01733d034cfc78cbf67f926c7ed83e82200ef86818196921760b4beff48404df811b953828274461673c68d04e297b0eb7b2b4d60fc6b566a2")
    check("sha512 a112", sha512.sha512(rep("a", 112)),
        "c01d080efd492776a1c43bd23dd99d0a2e626d481e16782e75d54c2503b5dc32bd05f0f1ba33e568b88fd2d970929b719ecbb152f58f130a407c8830604b70ca")
    check("sha512 a113", sha512.sha512(rep("a", 113)),
        "55ddd8ac210a6e18ba1ee055af84c966e0dbff091c43580ae1be703bdb85da31acf6948cf5bd90c55a20e5450f22fb89bd8d0085e39f85a86cc46abbca75e24d")
    check("sha512 a127", sha512.sha512(rep("a", 127)),
        "828613968b501dc00a97e08c73b118aa8876c26b8aac93df128502ab360f91bab50a51e088769a5c1eff4782ace147dce3642554199876374291f5d921629502")
    check("sha512 a128", sha512.sha512(rep("a", 128)),
        "b73d1929aa615934e61a871596b3f3b33359f42b8175602e89f7e06e5f658a243667807ed300314b95cacdd579f3e33abdfbe351909519a846d465c59582f321")
    // sha512_bytes 原始字节路径：输入字节含 ≥0x80 无法用字符串承载（如 0x80,0xff）
    var bt = table_new_i64()
    table_push(bt, 0x80)
    table_push(bt, 0xff)
    table_push(bt, 0x00)
    check("sha512_bytes 80ff00",
        sha512.sha512_bytes(bt),
        "f6e3bb87fcdc0c86e282f3c9622de6c3d0b1d25d8ca3bce057b8525f4f928cbdb43bbc2da56759c7f95a3111b6bcb75bf488a5de4faa06483c26d3505f4cfe06")
    println("sha512 探针全部通过")
}
