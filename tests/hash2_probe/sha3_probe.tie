type tie<logic>
// sha3（Keccak-256/512）探针：正例多向量 + 块边界（空串/abc/55/56/64/65/128/
// 129/256 字节，触及 pad10*1 的 0x06/0x80 分支与 136/72 字节速率边界）。
// 向量来源：Python 标准库 hashlib.sha3_256/_512（NIST 参考实现）。
import "../../std/sha3.tie"
using sha3;

func check(name: string, got: string, want: string) {
    if got == want {
        println("PASS " + name)
    } else {
        println("FAIL " + name + " got=" + got)
        println("     want=" + want)
        exit(1)
    }
}

func rep(c: string, n: i64) -> string {
    var out: string = ""
    var i: i64 = 0
    while i < n {
        out = out + c
        i = i + 1
    }
    return out
}

func main() {
    // 强调任务指定向量（空串 / abc）
    check("s3-256 empty", sha3.sha3_256(""),
        "a7ffc6f8bf1ed76651c14756a061d662f580ff4de43b49fa82d80a4b80f8434a")
    check("s3-256 abc", sha3.sha3_256("abc"),
        "3a985da74fe225b2045c172d6bd390bd855f086e3e9d525b46bfe24511431532")
    check("s3-512 empty", sha3.sha3_512(""),
        "a69f73cca23a9ac5c8b567dc185a756e97c982164fe25859e0d1dcc1475c80a61" +
        "5b2123af1f5f94c11e3e9402c3ac558f500199d95b6d3e301758586281dcd26")
    check("s3-512 abc", sha3.sha3_512("abc"),
        "b751850b1a57168a5693cd924b6b096e08f621827444f70d884f5d0240d2712e" +
        "10e116e9192af3c91a7ec57647e3934057340b4cf408d5a56592f8274eec53f0")
    // 块边界（rate=136 与 72，55/56/64/65/128/129/256）
    check("s3-256 a55", sha3.sha3_256(rep("a", 55)),
        "78c2a04624b9328ae0e40cb8cdd29980f6ff55abf2dca68e3412d09eed4b9d03")
    check("s3-256 a56", sha3.sha3_256(rep("a", 56)),
        "f6fe8de5c8f5014786f07e9f7b08130f920dd55e587d47021686b26cf2323deb")
    check("s3-256 a64", sha3.sha3_256(rep("a", 64)),
        "043d104b5480439c7acff8831ee195183928d9b7f8fcb0c655a086a87923ffee")
    check("s3-256 a65", sha3.sha3_256(rep("a", 65)),
        "ac95a2d33713281e64db879a478235f492e80f584df4acd2466462bce4110154")
    check("s3-256 a128", sha3.sha3_256(rep("a", 128)),
        "6ea6efe1dbf991d7f6d442dfe3d6036003071fa55fd438149fb845cb13f15906")
    check("s3-256 a129", sha3.sha3_256(rep("a", 129)),
        "84ee1a04bcce09fb1f4507fbdfb81655d71a95e7b546f6859859ccf86d175ae8")
    check("s3-256 a256", sha3.sha3_256(rep("a", 256)),
        "a7e8e217fb86e40af8e2467e12d8533cb842773013525b0bab3dc4c93bc9b407")
    check("s3-512 a55", sha3.sha3_512(rep("a", 55)),
        "2d81683ca5558b428c414aa1cbfaf8bbda166041746a17f976adf1252499efd82bcf1234153c1b6b9d8c44244e53c76a4fad9e445b87f74951b3b45c22f0438a")
    check("s3-512 a56", sha3.sha3_512(rep("a", 56)),
        "302d75b7947aa354a54872df954dc0dfe673cf60faedebdea7e9b22263a3bdf39e346a4f2868639836955396f186a67b02ec8e3365bdf59867070f81849c2c35")
    check("s3-512 a128", sha3.sha3_512(rep("a", 128)),
        "dfbfc2fde7f2a68e1b56b4d72c41e8643556646847a002a86c89efe119fd4715d0104ef557b44f46cb4db17e942549b6444d774b8dcb75921a908c3e143bb6a7")
    println("sha3 探针全部通过")
}
