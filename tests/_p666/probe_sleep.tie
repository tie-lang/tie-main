type tie<logic>
// 一次性探针：验证 unsafe extern fn Sleep（kernel32）可用（p.6.6.6 前置）。
// 说明：tie 无毫秒级时钟，time_now 秒级 → 只断言 sleep 后耗时 > 0 秒。
import "../../std/time.tie" as time

unsafe extern fn Sleep(ms: u32) -> i32;

func main() {
    var t0 = time.now()
    unsafe {
        Sleep(2500)
    }
    var t1 = time.now()
    var el = t1 - t0
    println("sleep2500_elapsed_s=" + to_string(el))
    if el >= 2 {
        println("extern Sleep PASS")
    } else {
        println("extern Sleep FAIL el=" + to_string(el))
        exit(1)
    }
    exit(0)
}