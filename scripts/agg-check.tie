type tie<logic>
// scripts/agg-check.tie —— 主仓聚合发行校验（p.7.2.3）
// ============================================================
// 职责：按 scripts/tie-versions.data.tie 的组件=版本约束，校验整套工具链
// 聚合发行物的版本约束、产物齐全与指纹一致（复用 std/tsha1 tsha1f）。
// tie 语言自写（0-PowerShell），作为正式发行前的聚合门禁脚本。
//
// 用法（tiec 不支持在源码后直传脚本参数，须先编译再运行）：
//   compiler/tiec.exe scripts/agg-check.tie -o dist/agg-check.exe
//   dist/agg-check.exe                    # 门禁：默认聚合版本 2026.2，清单 scripts/tie-versions.data.tie
//   dist/agg-check.exe 2026.2             # 指定聚合版本
//   dist/agg-check.exe 2026.2 scripts/tie-versions.data.tie
//   dist/agg-check.exe --self-test        # 内置自检（临时目录断言，不依赖真实产物）
//
// 校验内容（gate 模式）：
//   1. 聚合发行目录 dist/tie-{版本}/ 存在且含 bin/（布局见 release.md §4.3）
//   2. 每个组件产物存在：dist/tie-{组件}-{版本}-win-x64.zip
//   3. 若产物旁有 .fp 指纹清单（tsha1f:<值>\n），校验与产物字节指纹一致
//   任一失败退出 1（打印 FAIL 明细）；全部通过退出 0。
//
// 自检模式（--self-test）：在 dist/_agg_selftest/ 造假产物 + .fp 清单，
// 断言「良性通过 / 篡改拦截 / 缺失检出」三个场景后清理，退出 0/1。

import "../compiler/config.tie"
import "../std/tsha1.tie"

// ---------- 全局 ----------
var c_names: table<string>;   // 组件名（平行表，来自版本清单 map 键）
var c_vers: table<string>;    // 组件版本约束（并行值）
var c_count: i64 = 0;         // 组件数
var g_version: string = "";   // 聚合版本号（arg0，默认 2026.2）
var g_versions_path: string = ""; // 版本清单路径（arg1，默认 scripts/tie-versions.data.tie）
var g_self_test: bool = false;    // --self-test 标志

func arg(i: i64) -> string {
    return arg_string(i)
}

func parse_args() {
    var vset: i64 = 0
    var i: i64 = 0
    while i < 8 {
        var a = arg(i)
        if str_len(a) == 0 {
            break
        }
        if a == "--self-test" {
            g_self_test = true
        } else if vset == 0 {
            g_version = a
            vset = 1
        } else if vset == 1 {
            g_versions_path = a
            vset = 2
        }
        i = i + 1
    }
}

// ---------- 版本清单加载（config.parse_data 解析 td 表） ----------

func load_versions() -> i64 {
    if !file_exists(g_versions_path) {
        println("FAIL 版本清单缺失: " + g_versions_path)
        return -1
    }
    var root = config.parse_data(g_versions_path)
    if root < 0 {
        println("FAIL 版本清单解析失败: " + config.err_msg())
        return -1
    }
    var n = config.map_len(root)
    if n == 0 {
        println("FAIL 版本清单为空")
        return -1
    }
    c_names = table_new_string()
    c_vers = table_new_string()
    var i: i64 = 0
    while i < n {
        var k = config.map_key(root, i)
        var vn = config.map_val(root, i)
        if config.type_of(vn) != 4 && config.type_of(vn) != 2 {
            println("FAIL 版本清单项非字符串: " + k)
            return -1
        }
        table_push(c_names, k)
        table_push(c_vers, config.str_val(vn))
        println("  约束: " + k + "=" + config.str_val(vn))
        i = i + 1
    }
    c_count = n
    return 0
}

// ---------- 指纹（tsha1f n=48，与 zdpub/keelaud 同款） ----------

func bytes_to_str(t: table<i64>) -> string {
    var sb = string_builder()
    var i: i64 = 0
    while i < len(t) {
        sb_append_byte(sb, t[i])
        i = i + 1
    }
    return sb_build(sb)
}

func fingerprint(path: string) -> string {
    if !file_exists(path) {
        return ""
    }
    var t = byte_read(path)
    return tsha.tsha1f(bytes_to_str(t), 48)
}

// 从 .fp 清单文本提取 tsha1f 值（`tsha1f:<值>\n`，':' 之后到行尾/空白前）。
func parse_fp(m: string) -> string {
    var n: i64 = str_len(m)
    var i: i64 = 0
    var seen: bool = false
    var sb = string_builder()
    while i < n {
        var c = str_char(m, i)
        if c == ":" {
            seen = true
        } else if seen {
            if c == "\n" || c == "\r" {
                break
            }
            sb_append_byte(sb, str_byte(m, i))
        }
        i = i + 1
    }
    return sb_build(sb)
}

// ---------- 单组件校验 ----------

// 校验 base 下组件产物：tie-{name}-{version}-win-x64.zip。返回 0 通过 /
// 1 缺失 / 2 指纹不符。有 .fp 清单才做指纹校验（无 .fp 视为通过）。
func check_artifact(base: string, name: string, ver: string) -> i64 {
    var zip = base + "\\tie-" + name + "-" + ver + "-win-x64.zip"
    if !file_exists(zip) {
        println("FAIL 产物缺失: " + zip)
        return 1
    }
    var fp_path = zip + ".fp"
    if file_exists(fp_path) {
        var want = parse_fp(file_read(fp_path))
        var got = fingerprint(zip)
        if str_len(want) == 0 || got != want {
            println("FAIL 指纹不符: " + zip)
            return 2
        }
        println("PASS " + name + "=" + ver + "（指纹一致）")
    } else {
        println("PASS " + name + "=" + ver)
    }
    return 0
}

// ---------- gate 模式 ----------

func run_gate() -> i64 {
    var fails: i64 = 0
    var base = "dist"
    println("[agg-check] 聚合版本 " + g_version + " 校验（清单 " + g_versions_path + "）")
    if load_versions() != 0 {
        return 1
    }
    // 1) 聚合发行目录（布局：dist/tie-{版本}/ 含 bin/）
    var aggdir = base + "\\tie-" + g_version
    if !file_exists(aggdir) {
        println("FAIL 聚合目录缺失: " + aggdir)
        fails = fails + 1
    } else if !file_is_dir(aggdir) {
        println("FAIL 聚合路径非目录: " + aggdir)
        fails = fails + 1
    } else if !file_is_dir(aggdir + "\\bin") {
        println("FAIL 聚合目录缺 bin/: " + aggdir)
        fails = fails + 1
    } else {
        println("PASS 聚合目录 " + aggdir + "（bin/ 就位）")
    }
    // 2) 各组件产物
    var i: i64 = 0
    while i < c_count {
        if check_artifact(base, c_names[i], c_vers[i]) != 0 {
            fails = fails + 1
        }
        i = i + 1
    }
    if fails > 0 {
        println("[agg-check] FAIL total=" + to_string(fails))
        return 1
    }
    println("[agg-check] ALL PASS（" + to_string(c_count) + " 组件）")
    return 0
}

// ---------- 自检模式 ----------

func run_self_test() -> i64 {
    var fails: i64 = 0
    var base = "dist\\_agg_selftest"
    println("[agg-check] 自检（临时目录 " + base + "）")
    if file_exists(base) {
        var _r = remove_dir_all(base)
    }
    var _r = mkdir_all(base)
    // 假产物：64 字节序列
    var fake = table_new_i64()
    var b: i64 = 0
    while b < 64 {
        table_push(fake, b % 251)
        b = b + 1
    }
    var zip = base + "\\tie-demo-1.0.0-win-x64.zip"
    if !byte_write(zip, fake) {
        println("FAIL 自检准备失败: 写假产物")
        return 1
    }
    var fpv = fingerprint(zip)
    if !file_write(zip + ".fp", "tsha1f:" + fpv + "\n") {
        println("FAIL 自检准备失败: 写 .fp")
        return 1
    }
    // 1) 良性：产物 + 指纹一致 → 0
    if check_artifact(base, "demo", "1.0.0") == 0 {
        println("SELF PASS 良性通过")
    } else {
        println("SELF FAIL 良性未过")
        fails = fails + 1
    }
    // 2) 篡改一个字节 → 指纹不符（返回 2）
    var tz = byte_read(zip)
    if len(tz) > 0 {
        tz[0] = tz[0] ^ 0x01
        byte_write(zip, tz)
    }
    if check_artifact(base, "demo", "1.0.0") == 2 {
        println("SELF PASS 篡改拦截")
    } else {
        println("SELF FAIL 篡改未拦截")
        fails = fails + 1
    }
    // 3) 缺失产物 → 返回 1
    if check_artifact(base, "missing", "9.9.9") == 1 {
        println("SELF PASS 缺失检出")
    } else {
        println("SELF FAIL 缺失未检出")
        fails = fails + 1
    }
    // 清理
    if file_exists(base) {
        var _r = remove_dir_all(base)
    }
    if fails > 0 {
        println("[agg-check] 自检 FAIL total=" + to_string(fails))
        return 1
    }
    println("[agg-check] 自检 ALL PASS")
    return 0
}

// ---------- main ----------

func main() -> i64 {
    parse_args()
    if str_len(g_version) == 0 {
        g_version = "2026.2"
    }
    if str_len(g_versions_path) == 0 {
        g_versions_path = "scripts/tie-versions.data.tie"
    }
    if g_self_test {
        return run_self_test()
    }
    return run_gate()
}