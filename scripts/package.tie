type tie<logic>
// scripts/package.tie —— tie 正式发行版打包器（0-PowerShell，tie 语言自写）
// ============================================================
// 职责：构建 release 工具链（自举）→ 组装发行目录 → 生成 zip 压缩包 + 源码包。
// 产物：dist/tie-{发行版号}-win-x64.zip + dist/tie-{发行版号}-src.zip
//      （如 tie-Harbor-2026.1-preview.5-win-x64.zip）
//
// 用法（tiec 不支持在源码后直传脚本参数，须先编译再运行）：
//   compiler/tiec.exe scripts/package.tie -o dist/package.exe   # 先编译打包器
//   dist/package.exe 2026.1                                     # 指定版本（默认 2026.1）
//   dist/package.exe Harbor-2026.1-preview.6
//   dist/package.exe 2026.1 skip-repl   # 跳过 repl 自举
//   dist/package.exe 2026.1 skip-llvm   # 跳过 LLVM 捆绑
//
// 流程与 scripts/package.ps1 一一对应（0-Rust，参考编译器已归档 tiec_rust）：
//   1. 自举验证：tiec.exe 编译 driver.tie → tiec2.exe（编译零错误）
//   2. repl.exe 自举（tiec 编译 repl/repl.tie；-skip-repl 可跳过）
//   3. 组装 dist/tie-{版本}/（bin/examples/editor + bin/llvm/ 精简工具链
//      + std/ext/rdu + skills + docs + compiler 源码 + 包根发行文档；
//      p.7.2.4：源码 compiler/std/ext/rdu/examples/skills/editor 收拢到 src/ 下）
//   4. tar 打包为 zip（Windows 自带 bsdtar：tar -a -c -f）
//   5. 另打 tie-{版本}-src.zip（只含 src/，p.7.2.4）

// ---------- 命令行参数 ----------
// 内置 version/args 原语见 tiec 环境；此处用 arg_string 读取（pkg 同款约定）。
func arg(i: i64) -> string {
    return arg_string(i)
}

var g_skip_repl: bool = false
var g_llvm_mode: string = "lite"   // "full" 完整 LLVM / "lite" 精简 LLVM（默认）/ "none" 不带 LLVM
var g_zip_suffix: string = ""      // zip 名后缀：lite=""（默认不减）/ full="-llvm-full" / none="-nollvm"

func parse_args() {
    var i: i64 = 0
    while i < 8 {
        var a = arg(i)
        if a == "skip-repl" {
            g_skip_repl = true
        }
        if a == "llvm-full" {
            g_llvm_mode = "full"
            g_zip_suffix = "-llvm-full"
        }
        if a == "llvm-lite" {
            g_llvm_mode = "lite"
            g_zip_suffix = ""
        }
        if a == "llvm-none" {
            g_llvm_mode = "none"
            g_zip_suffix = "-nollvm"
        }
        i = i + 1
    }
}

// ---------- 小工具 ----------

// shell 转义：仅当路径含空格时才包双引号（cmd 的 system() 对以引号开头的
// 整条命令有吞首引号解析问题；无空格路径直接裸传最稳）。
func shell_q(s: string) -> string {
    if has_sub(s, " ") {
        return "\"" + s + "\""
    }
    return s
}

// bool → "true"/"false"（调试打印用）。
func bool_s(b: bool) -> string {
    if b {
        return "true"
    }
    return "false"
}

// 判断 s 是否包含 sub（朴素逐位比对，O(n·m)）。
func has_sub(s: string, sub: string) -> bool {
    var n = str_len(s)
    var m = str_len(sub)
    if m == 0 {
        return true
    }
    var i: i64 = 0
    while i <= n - m {
        var j: i64 = 0
        while j < m {
            if str_char(s, i + j) != str_char(sub, j) {
                break
            }
            j = j + 1
        }
        if j == m {
            return true
        }
        i = i + 1
    }
    return false
}

// ---------- 第 1 步：自举验证 ----------

func step1_bootstrap(root: string) -> i64 {
    println("[1/5] 自举验证: tiec 编译 driver.tie -> tiec2.exe ...")
    // 先删旧 tiec2（避免陈旧产物误判成功）
    if fs_exists(root + "\\compiler\\tiec2.exe") {
        var _r = fs_remove(root + "\\compiler\\tiec2.exe")
    }
    var cmd = shell_q(root + "\\compiler\\tiec.exe") + " " +
              shell_q(root + "\\compiler\\driver.tie") + " -o " + shell_q(root + "\\compiler\\tiec2.exe")
    var rc = exec_code(cmd)
    // tiec 是 GUI 子系统程序，system() 退出码语义不可靠；以产物生成判定成功
    if !fs_exists(root + "\\compiler\\tiec2.exe") {
        println("[package] 自举编译失败（退出码 " + to_string(rc) + "，tiec2.exe 未生成）")
        return 1
    }
    println("[1/5] 自举验证完成")
    return 0
}

// ---------- 第 2 步：repl.exe 自举 ----------

func step2_repl(root: string) -> i64 {
    if g_skip_repl {
        println("[2/5] 已跳过 repl 自举（skip-repl）")
        return 0
    }
    println("[2/5] repl.exe 自举 ...")
    var cmd = shell_q(root + "\\compiler\\tiec.exe") + " " + shell_q(root + "\\repl\\repl.tie")
    var rc = exec_code(cmd)
    if !fs_exists(root + "\\repl\\repl.exe") {
        println("[package] repl.exe 编译失败（退出码 " + to_string(rc) + "，repl.exe 未生成）")
        return 1
    }
    println("[2/5] repl.exe 自举完成")
    return 0
}

// ---------- 第 3 步：组装发行目录 ----------
// 注：拆成多个小函数规避 tiec 大函数跨模块访问器 + 交错表操作损坏值的问题。

func s3_bin(root: string, dist: string) -> i64 {
    var _r = fs_create_dir_all(dist + "\\bin")
    if fs_exists(root + "\\repl\\repl.exe") {
        var _r = fs_copy(root + "\\repl\\repl.exe", dist + "\\bin\\repl.exe")
        println("  bin/repl.exe ok")
    }
    if fs_exists(root + "\\pkg\\pkg.exe") {
        var _r = fs_copy(root + "\\pkg\\pkg.exe", dist + "\\bin\\pkg.exe")
        println("  bin/pkg.exe ok")
    }
    if fs_exists(root + "\\compiler\\tiec.exe") {
        var _r = fs_copy(root + "\\compiler\\tiec.exe", dist + "\\bin\\tiec.exe")
        println("  bin/tiec.exe ok")
    }
    return 0
}

func s3_llvm(dist: string) -> i64 {
    var llvm = "D:\\LLVM"
    if !fs_exists(llvm + "\\bin\\clang.exe") {
        println("  LLVM 工具链打包跳过（未找到 " + llvm + "\\bin\\clang.exe）")
        return 0
    }
    if g_llvm_mode == "none" {
        // 不带 LLVM：不装配任何 LLVM 文件；包根 LLVM.md 说明如何自装/复用 LLVM
        var note = "# 未捆绑 LLVM（llvm-none 包）\n\n此发行包不含 LLVM 工具链。\n请在系统安装 LLVM（clang/opt/lld、llvm-ar），并把编译器指向其安装位置：\n  tiec --backend win32（TIE_LLVM_HOME 环境变量或 PATH 中的 clang/opt/llvm-ar/lld-link）。\n当前官方捆绑版本：LLVM 22（clang 22.1.8）。\nEN: This package does not bundle LLVM. Install LLVM and point tiec at it via TIE_LLVM_HOME or PATH.\nRecommended bundled version: LLVM 22 (clang 22.1.8).\n"
        var _r = file_write(dist + "\\LLVM.md", note)
        println("[3.5] 未捆绑 LLVM（llvm-none；自装说明见包根 LLVM.md）")
        return 0
    }
    if g_llvm_mode == "full" {
        // 完整 LLVM：整个 LLVM 安装树（bin/lib/include/libexec/share）
        var dst = dist + "\\bin\\llvm"
        var _r = fs_create_dir_all(dst)
        var rcp = exec_code("robocopy " + shell_q(llvm) + " " + shell_q(dst) + " /E /NFL /NDL /NJH /NJS /NC /NS /NP /R:1 /W:1 >nul 2>&1")
        if !(rcp == 0 || rcp == 1) {
            println("  LLVM 完整工具链复制失败（robocopy 退出码 " + to_string(rcp) + "）")
            return 1
        }
        var _r = file_write(dist + "\\bin\\llvm\\VERSION.txt", llvm_version_note())
        println("[3.5] LLVM 完整工具链完成（TIE_LLVM_HOME=" + dst + "）")
        return 0
    }
    // 精简 LLVM（默认 lite）：仅编译所需四件套 + lib/clang 头
    var _r = fs_create_dir_all(dist + "\\bin\\llvm\\bin")
    var _r = fs_create_dir_all(dist + "\\bin\\llvm\\lib")
    var tools = ["clang.exe", "opt.exe", "llvm-ar.exe", "lld-link.exe"]
    var i: i64 = 0
    while i < 4 {
        var t = tools[i]
        if fs_exists(llvm + "\\bin\\" + t) {
            var _r = fs_copy(llvm + "\\bin\\" + t, dist + "\\bin\\llvm\\bin\\" + t)
            println("  bin/llvm/bin/" + t + " ok")
        }
        i = i + 1
    }
    var clang_dir = llvm + "\\lib\\clang"
    if fs_exists(clang_dir) {
        var _r = fs_copy_dir(clang_dir, dist + "\\bin\\llvm\\lib\\clang")
        println("  bin/llvm/lib/clang ok")
    }
    if fs_exists(llvm + "\\LICENSE.txt") {
        var _r = fs_copy(llvm + "\\LICENSE.txt", dist + "\\bin\\llvm\\LICENSE.txt")
    }
    var _r = file_write(dist + "\\bin\\llvm\\VERSION.txt", llvm_version_note())
    println("[3.5] LLVM 精简工具链完成（TIE_LLVM_HOME=" + dist + "\\bin\\llvm）")
    return 0
}

// LLVM 版本标注（包内 bin/llvm/VERSION.txt + llvm-none 包根 LLVM.md 共用说明）。
func llvm_version_note() -> string {
    var v = "22.1.8"
    // 从 lib/clang/<major> 子目录读取主版本（若存在）；仅作校验提示
    var major_dir = "D:\\LLVM\\lib\\clang"
    if fs_exists(major_dir) {
        v = v + "（捆绑精简/完整工具链：clang/opt/llvm-ar/lld-link）"
    }
    return "LLVM " + v + "\nEN: Bundled LLVM version " + v + ".\n"
}

func s3_doc(root: string, dist: string) -> i64 {
    // 发行文档 + 许可证置于包根；docs/ 文档目录整体置于包根（不再有 doc/ 套层）
    foreach_doc(root, dist, "README.md")
    foreach_doc(root, dist, "NEW.md")
    foreach_doc(root, dist, "CHANGELOG.md")
    foreach_doc(root, dist, "LICENSE")
    if fs_exists(root + "\\docs") {
        var _r = fs_copy_dir(root + "\\docs", dist + "\\docs")
    }
    println("  docs/ ok")
    return 0
}

func s3_examples(root: string, dist: string) -> i64 {
    if fs_exists(root + "\\examples") {
        var ok1 = fs_copy_dir(root + "\\examples", dist + "\\src\\examples")
        println("  src/examples/ ok (" + bool_s(ok1) + ")")
    }
    return 0
}

func s3_libs(root: string, dist: string) -> i64 {
    var libs = ["std", "ext", "rdu"]
    var j: i64 = 0
    while j < 3 {
        var l = libs[j]
        if fs_exists(root + "\\" + l) {
            var _r = fs_copy_dir(root + "\\" + l, dist + "\\src\\" + l)
            println("  src/" + l + "/ ok")
        }
        j = j + 1
    }
    if fs_exists(root + "\\skills") {
        var _r = fs_copy_dir(root + "\\skills", dist + "\\src\\skills")
        println("  src/skills/ ok")
    }
    if fs_exists(root + "\\editor") {
        var _r = fs_copy_dir(root + "\\editor", dist + "\\src\\editor")
        println("  src/editor/ ok")
    }
    return 0
}

func s3_compiler(root: string, dist: string) -> i64 {
    if fs_exists(root + "\\compiler") {
        var _r = fs_copy_dir(root + "\\compiler", dist + "\\src\\compiler")
        prune_artifacts(dist + "\\src\\compiler")
        println("  src/compiler/ ok")
    }
    return 0
}

// 清理目录下的编译产物（.exe/.ll/.bc），递归；用系统命令避免 tie 表遍历。
func prune_artifacts(dir: string) {
    var _r = exec_code("del /s /q " + shell_q(dir + "\\*.exe") + " " + shell_q(dir + "\\*.ll") + " " + shell_q(dir + "\\*.bc") + " >nul 2>&1")
    var _r = exec_code("for /d /r " + shell_q(dir) + " %d in (*) do @del /s /q \"%d\\*.exe\" \"%d\\*.ll\" \"%d\\*.bc\" >nul 2>&1")
}

func step3_assemble(root: string, version: string, dist: string) -> i64 {
    println("[3/5] 组装发行目录 " + dist + " ...")
    if fs_exists(dist) {
        var _r = fs_remove_all(dist)
    }
    var _r = fs_create_dir_all(dist + "\\bin")
    // p.7.2.4：源码收拢到 src/（composer 复制进 src/ 子目录）
    var _r = fs_create_dir_all(dist + "\\src")

    var r1 = s3_bin(root, dist)
    var r2 = s3_llvm(dist)
    var r3 = s3_doc(root, dist)
    var r4 = s3_examples(root, dist)
    var r5 = s3_libs(root, dist)
    var r6 = s3_compiler(root, dist)
    var r7 = s3_components(dist)

    println("[3/5] 发行目录组装完成")
    return 0
}

// p.7.2.2/7.2.3 组件聚合：把 tie-repo 下各组件源码仓收拢进发行包 src/components/。
// 组件仓与 tie-main 同级（位于本仓的上两级目录，如 F:\Projects\tie-repo\trm）；
// 只收录源码（剔除全部构建产物），使聚合发行包成为「全套工具链源码 + 编译器」
// 的一体形态（组件独立发行物各自在组件仓出仓，聚合包为源码级完整快照）。
// 收敛清单 = tie-repo 下既有组件仓（trm/trm-lite/tofflib/tiedb/tie-diag/lib_v1/tink）。
func s3_components(dist: string) -> i64 {
    var comps = table_new_string()
    table_push(comps, "trm")
    table_push(comps, "trm-lite")
    table_push(comps, "tofflib")
    table_push(comps, "tiedb")
    table_push(comps, "tie-diag")
    table_push(comps, "lib_v1")
    table_push(comps, "tink")
    var base = comp_root()
    var k: i64 = 0
    while k < len(comps) {
        var cn = comps[k]
        var src = base + cn
        var dst = dist + "\\src\\components\\" + cn
        if fs_exists(src) {
            // copy_dir 内建不适用于含 .git 子目录的仓库（返回 -1）；改用系统
            // robocopy 批量复制（/E 含子目录，退出码 1 = 成功复制）
            var _r = fs_create_dir_all(dst)
            var rcp = exec_code("robocopy " + shell_q(src) + " " + shell_q(dst) + " /E /NFL /NDL /NJH /NJS /NC /NS /NP /R:1 /W:1 >nul 2>&1")
            var ok = false
            if rcp == 0 || rcp == 1 {
                ok = true
            }
            if ok {
                prune_comp_artifacts(dst)
                println("  src/components/" + cn + "/ ok")
            } else {
                println("  src/components/" + cn + " 复制失败（robocopy 退出码 " + to_string(rcp) + "）")
            }
        } else {
            println("  src/components/" + cn + " 跳过（组件仓不存在 " + src + "）")
        }
        k = k + 1
    }
    return 0
}

// 组件复制后清理构建产物（.exe/.ll/.bc/.obj/.o/.a/.lib/.pdb + 常见构建目录）。
// 用系统命令批量删除（文件级 del /s；目录级 for /d /r 递归）。
func prune_comp_artifacts(dir: string) {
    var _r = exec_code("del /s /q " + shell_q(dir + "\\*.exe") + " " + shell_q(dir + "\\*.ll") + " " + shell_q(dir + "\\*.bc") + " " + shell_q(dir + "\\*.obj") + " " + shell_q(dir + "\\*.o") + " " + shell_q(dir + "\\*.a") + " " + shell_q(dir + "\\*.lib") + " " + shell_q(dir + "\\*.pdb") + " >nul 2>&1")
    var _r = exec_code("for /d /r " + shell_q(dir) + " %d in (target obj bin Debug Release build dist .gradle .cargo .zig-cache out) do @rd /s /q \"%d\" >nul 2>&1")
}

// 组件仓根目录 = 本仓上一级（tie-repo），如 F:\Projects\tie-repo\ 尾随反斜杠。
func comp_root() -> string {
    var p = io_cwd()
    var last: i64 = -1
    var i: i64 = 0
    while i < str_len(p) {
        if str_char(p, i) == "\\" || str_char(p, i) == "/" {
            last = i
        }
        i = i + 1
    }
    if last < 0 {
        return ""
    }
    return sub_str(p, 0, last + 1)
}

// 取字符串 [start, end) 字符子串（码点级；str_char 风格）。
func sub_str(s: string, start: i64, end: i64) -> string {
    var out: string = ""
    var i: i64 = start
    while i < end {
        out = out + str_char(s, i)
        i = i + 1
    }
    return out
}

// 文档复制辅助：存在才复制到包根
func foreach_doc(root: string, dist: string, name: string) {
    if fs_exists(root + "\\" + name) {
        var _r = fs_copy(root + "\\" + name, dist + "\\" + name)
    }
}

func ends_with(s: string, suffix: string) -> bool {
    var n = str_len(s)
    var m = str_len(suffix)
    if m > n {
        return false
    }
    var i: i64 = 0
    while i < m {
        if str_char(s, n - m + i) != str_char(suffix, i) {
            return false
        }
        i = i + 1
    }
    return true
}

// ---------- 第 4 步：打包 zip ----------

func step4_zip(root: string, version: string, dist: string) -> i64 {
    println("[4/5] 打包 zip ...")
    var dir_name = "tie-" + version
    var zip_path = root + "\\dist\\" + dir_name + g_zip_suffix + "-win-x64.zip"
    if fs_exists(zip_path) {
        var _r = fs_remove(zip_path)
    }
    var _r = fs_create_dir_all(root + "\\dist")

    // Windows 自带 bsdtar：-a 按扩展名自动选格式，-c 建档，-f 输出
    // 在 dist/ 目录内打包 dist/tie-{version} 子树 → zip 内含 tie-{version}/ 顶层目录
    var old = exec_code("cd /d " + shell_q(root + "\\dist") + " && tar -a -c -f " + shell_q(zip_path) + " " + dir_name)
    if old != 0 {
        println("[package] zip 打包失败（退出码 " + to_string(old) + "）")
        return 1
    }
    if !fs_exists(zip_path) {
        println("[package] zip 文件未生成")
        return 1
    }
    println("[4/5] 打包完成: " + zip_path)
    return 0
}

// ---------- 第 5 步：源码包（只含 src/） ----------

func step5_src_zip(root: string, version: string, dist: string) -> i64 {
    println("[5/5] 打包源码包 src.zip ...")
    var src_zip = root + "\\dist\\tie-" + version + "-src.zip"
    if fs_exists(src_zip) {
        var _r = fs_remove(src_zip)
    }
    // p.7.2.4：只含 src/——在 dist/tie-{version}/ 内打包 src 子树
    var old = exec_code("cd /d " + shell_q(dist) + " && tar -a -c -f " + shell_q(src_zip) + " src")
    if old != 0 || !fs_exists(src_zip) {
        println("[package] src.zip 打包失败（退出码 " + to_string(old) + "）")
        return 1
    }
    println("[5/5] 源码包完成: " + src_zip)
    return 0
}

// ---------- main ----------

// fs 库命名空间函数别名（经 import 后按 fs.xxx 调用；此处应用全局内置
// 的 file_* 族，避免依赖 import 顺序问题——与 package.ps1 行为对齐）。
func fs_exists(path: string) -> bool {
    if file_exists(path) {
        return true
    }
    return file_is_dir(path)
}
func fs_copy(src: string, dst: string) -> bool { return file_copy(src, dst) }
func fs_remove(path: string) -> bool { return file_delete(path) }
func fs_remove_all(path: string) -> bool { return remove_dir_all(path) }
func fs_create_dir_all(path: string) -> bool { return mkdir_all(path) }
func fs_copy_dir(src: string, dst: string) -> bool { return copy_dir(src, dst) }

func main() -> i64 {
    parse_args()
    var version = arg(0)
    if version == "" {
        version = "2026.1"
    }
    println("[package] 发行版号: " + version)
    var root = io_cwd()
    println("[package] 仓库根目录: " + root)
    var dist = root + "\\dist\\tie-" + version

    if step1_bootstrap(root) != 0 { return 1 }
    if step2_repl(root) != 0 { return 1 }
    if step3_assemble(root, version, dist) != 0 { return 1 }
    if step4_zip(root, version, dist) != 0 { return 1 }
    if step5_src_zip(root, version, dist) != 0 { return 1 }

    println("打包完成: " + dist + "\\tie-" + version + "-win-x64.zip (+ .src.zip)")
    return 0
}

func io_cwd() -> string {
    // cwd 内建返回当前工作目录绝对路径（p.6.4.1 内联 Win32/CRT）。
    // 不能用 exec_output("cd")：p.6.4.6 内联 exec_output 以 CreateProcess 直跑
    // 命令，cmd 内建 cd 无输出 → 空串 → 回退 "." 会让 zip 步骤路径错乱。
    var out = cwd()
    if out == "" {
        return "."
    }
    return string_trim(out)
}

func string_trim(s: string) -> string {
    // 去除首尾空白
    var n = str_len(s)
    var start: i64 = 0
    while start < n && (str_char(s, start) == " " || str_char(s, start) == "\r" || str_char(s, start) == "\n") {
        start = start + 1
    }
    var end = n
    while end > start && (str_char(s, end - 1) == " " || str_char(s, end - 1) == "\r" || str_char(s, end - 1) == "\n") {
        end = end - 1
    }
    var out: string = ""
    var i: i64 = start
    while i < end {
        out = out + str_char(s, i)
        i = i + 1
    }
    return out
}